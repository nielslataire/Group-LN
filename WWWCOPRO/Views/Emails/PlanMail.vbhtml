
<!DOCTYPE html>
<html>
<body>
    <div style="font-family: Verdana, Arial, Helvetica, sans-serif; font-size: 10pt; color: #000000">
        <div>
            <style>
                #outlook a {
                    padding: 0;
                }

                body {
                    width: 100% !important;
                    -webkit-text-size-adjust: 100%;
                    -ms-text-size-adjust: 100%;
                    margin: 0;
                    padding: 0;
                }

                .ExternalClass {
                    width: 100%;
                }

                    .ExternalClass, .ExternalClass p, .ExternalClass span, .ExternalClass font, .ExternalClass td, .ExternalClass div {
                        line-height: 100%;
                    }

                #backgroundTable {
                    margin: 0;
                    padding: 0;
                    width: 100% !important;
                    line-height: 100% !important;
                }

                img {
                    outline: none;
                    text-decoration: none;
                    border: none;
                    -ms-interpolation-mode: bicubic;
                }

                a img {
                    border: none;
                }

                .image_fix {
                    display: block;
                }

                p {
                    margin: 0px 0px !important;
                }

                table td {
                    border-collapse: collapse;
                }

                table {
                    border-collapse: collapse;
                    mso-table-lspace: -1pt;
                    mso-table-rspace: -1pt;
                }

                .mobilelink a {
                    text-decoration: none;
                    color: #445566;
                }

                @@media only screen and (max-width: 480px) {
                    .emailImage {
                        height: auto !important;
                        max-width: 640px !important;
                        width: 100% !important;
                    }
                }

                @@media only screen and (max-width: 480px) {
                    table[class=devicewidth] {
                        width: 310px !important;
                        text-align: center !important;
                    }

                    td[class=devicewidth] {
                        width: 310px !important;
                        text-align: center !important;
                        display: block !important;
                    }

                    td[class=devicewidth2] {
                        width: 310px !important;
                        text-align: center !important;
                        padding-left: 25px !important;
                        padding-right: 25px !important;
                    }

                    td[class=devicewidth3] {
                        width: 310px !important;
                        text-align: center !important;
                        padding-left: 20px !important;
                        padding-right: 20px !important;
                    }

                    img[class=devicewidth] {
                        width: 310px !important;
                        text-align: center !important;
                    }

                    td[class=devicewidthtext] {
                        width: 310px !important;
                        line-height: 22px !important;
                        padding-left: 35px !important;
                        padding-right: 35px !important;
                    }

                    td[class=social] {
                        padding-left: 0px !important;
                        padding-right: 0px !important;
                        padding-bottom: 20px !important;
                        padding-top: 0px !important;
                    }

                    td[class=tdhide] {
                        display: none !important;
                    }

                    td[class=nopad] {
                        padding-left: 0px !important;
                        padding-right: 0px !important;
                        padding-top: 0px !important;
                        padding-bottom: 0px !important;
                    }

                    img[class=colorlogo] {
                        width: 310px !important;
                        height: 10px !important;
                    }

                    img[class=hero] {
                        width: 120px !important;
                        height: 178px !important;
                        padding-bottom: 8px !important;
                    }

                    td[class=herotd] {
                        text-align: center !important;
                        padding-top: 10px !important;
                    }

                    td[class=logo] {
                        width: 310px !important;
                        text-align: center !important;
                        padding-left: 0px !important;
                    }

                    img[class=icon] {
                        width: 110px !important;
                        height: 110px !important;
                    }

                    img[class=logocenter] {
                        text-align: center !important;
                    }

                    td[class=buttonpad] {
                        padding-left: 55px !important;
                        padding-right: 55px !important;
                    }

                    td[class=protext] {
                        padding-left: 0px !important;
                        text-align: center !important;
                    }

                    td[class=protext2] {
                        padding-left: 35px !important;
                        padding-right: 32px !important;
                        text-align: center !important;
                    }

                    td[class=bottomhead] {
                        padding-left: 35px !important;
                        padding-right: 35px !important;
                        text-align: center !important;
                    }

                    td[class=midtext] {
                        padding-left: 35px !important;
                        padding-right: 35px !important;
                        padding-top: 5px !important;
                        padding-bottom: 20px !important;
                        text-align: center !important;
                    }

                    td[class=arrowpad] {
                        padding-left: 150px !important;
                    }

                    table[class=devicewidthsocial] {
                        width: 210px !important;
                        text-align: center !important;
                        padding-left: 60px !important;
                    }
                }
            </style>

            <!-- HEADER -->
            <table width="100%" bgcolor="#fff" cellpadding="0" cellspacing="0" border="0" id="backgroundTable">
                <tbody>
                    <tr>
                        <td>
                            <table width="640" cellpadding="0" cellspacing="0" border="0" align="center" class="devicewidth">
                                <tbody>
                                    <tr>
                                        <td width="100%">
                                            <table width="640" cellpadding="0" cellspacing="0" border="0" align="center" class="devicewidth">
                                                <tbody>
                                                    <tr>
                                                        <td class="logo" width="254" height="100" align="left" style="padding-left: 4px; padding-bottom: 5px;">
                                                            <a href="https://www.groupln.be">
                                                                <img alt="Group LN - Projectontwikkeling"
                                                                     height="70"
                                                                     src="https://www.groupln.be/content/img/logo-default.png">
                                                            </a>
                                                        </td>
                                                        <td class="tdhide">&nbsp;</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </tbody>
            </table>


            <!-- HEADER BANNER -->
            <table width="100%" bgcolor="#f0f1f4" cellpadding="0" cellspacing="0" border="0">
                <tbody>
                    <tr>
                        <td>
                            <table width="640" align="center" class="devicewidth" bgcolor="#056daf">
                                <tbody>
                                    <tr>
                                        <td>
                                            <table width="640" class="devicewidth">
                                                <tbody>
                                                    <tr>
                                                        <td>
                                                            <table width="640" class="devicewidth" style="background-color:#009336;">
                                                                <tbody>
                                                                    <tr><td height="35"></td></tr>
                                                                    <tr>
                                                                        <td align="center" style="padding-bottom:12px; color:#fff; font-size:27px; line-height:36px;">
                                                                            <b>TE KOOP</b>
                                                                        </td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td align="center" style="color:#fff; font-size:19px; line-height:22px;">
                                                                            @Model.Projectname
                                                                        </td>
                                                                    </tr>
                                                                    <tr><td height="25"></td></tr>
                                                                </tbody>
                                                            </table>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </tbody>
            </table>


            <!-- TEXT BLOCK -->
            <table width="640" bgcolor="#fff" align="center" class="devicewidth">
                <tbody>
                    <tr>
                        <td align="left" style="padding:25px 35px; color:#5a5a5a; font-size:13px; line-height:22px;">
                            <b style="font-size:15px;">@Model.Title</b><br><br>
                            @Model.Text
                        </td>
                    </tr>
                </tbody>
            </table>

            <!-- IMAGE -->
            <table width="640" bgcolor="#fff" align="center" class="devicewidth">
                <tbody>
                    <tr>
                        <td>
                            <img class="emailImage"
                                 width="640"
                                 src="https://cpm.groupln.be/assets/pictures/@Model.Image"
                                 alt="@(If(Not String.IsNullOrWhiteSpace(Model.Imagecaption), Model.Imagecaption, Model.Projectname))">
                        </td>
                    </tr>
                </tbody>
            </table>
          

            <!-- CONTACT + BUTTON -->
            <table width="640" bgcolor="#fff" align="center" class="devicewidth">
                <tbody>
                    <tr><td>&nbsp;</td></tr>
                    <tr>
                        <td align="center" style="padding: 0 34px; color:#464646; font-size:13px;">
                            Indien u nog vragen heeft contacteer ons via
                            <a href="tel:+32 (0)9 216 49 50" style="color:#009336;">+32 (0)9 216 49 50</a>
                            of via
                            <a href="mailto:info@groupln.be" style="color:#009336;">info@groupln.be</a>.
                        </td>
                    </tr>

                    <tr>
                        <td align="center" style="padding-top:25px;">
                            <table width="200" cellpadding="0" cellspacing="0" bgcolor="#009336" style="border-radius:3px;">
                                <tr>
                                    <td align="center" style="padding:12px;">
                                        <a href="https://www.groupln.be/woonprojecten/@Model.Slug.ToLowerInvariant()"
                                           style="color:#fff; text-decoration:none; font-size:18px;">
                                            Project bekijken
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <tr><td height="30"></td></tr>
                </tbody>
            </table>


            <!-- FOOTER -->
            <table width="640" align="center" bgcolor="#fff" class="devicewidth">
                <tbody>
                    <tr>
                        <td align="center" style="padding:20px 12px; font-size:12px; color:#555;">
                            Uw mail: @Model.To<br>
                            Copyright 2026 - Group LN
                        </td>
                    </tr>
                </tbody>
            </table>

        </div>
    </div>
</body>
</html>
