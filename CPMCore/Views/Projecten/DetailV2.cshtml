@model CPMCore.Models.Projecten.ShowProjectDetail
@using System.Globalization
@using BOCore
@using DALCore.Models
@using FacadeCore
@inject IPermissionService PermissionService
@inject IProjecttrajectService TrajectService
@inject IConfiguration Configuration
@*
    gl-v2 layout-pilot (design-handoff/CRM Menu Wireframes.dc.html, punt 9 "Inner menu van het
    projectdossier" + punt 12a "Projectdetail — de ingang 'Project' uit 9a, in onze kaartstandaard").
    Content area is a straight rebuild of 12a plus its own commentary ("WAT ER ANDERS IS DAN IN JOUW
    HUIDIGE SCHERM") — every section/field below already existed somewhere on the legacy
    Detail.cshtml (attention panel, _TrajectSummaryCard, Algemene gegevens, Eenheden, Voortgang &
    budget, Facturatie, Documenten, Foto's), just re-laid-out per 12a and re-queried directly here
    instead of via the legacy partial (needed 12a's own bar/next-milestone shape, not the partial's).

    Deliberately NOT ported from 12a/12b this pass: the project-photo-as-thumbnail treatment (12b
    option A, topbar/inner-menu/list/search) — that's a cross-page, shell-level change (topbar icon
    slot, list thumbnails, search results) well beyond this one page, left for its own pass. The
    "Foto's & media" card below still shows the real project photos, just not swapped into the topbar
    icon.

    One knowing deviation from 12a's KPI strip: 12a swaps "Werkdagen" for "Weerverlet" (bad-weather
    days on this project). That count isn't cheaply available yet — GetBadWeatherDays returns a whole
    weather station's history with no project-scoped total, so computing a correct "weerverlet"
    number here would mean building the same station/date-range logic Projecten/Weather already owns,
    not just reading a field. Kept "Werkdagen" (already correctly computed by this same controller
    action) rather than risk a fabricated or wrong weather count.
*@
@{
    ViewData["Title"] = Model.Project.Name;
    ViewData["PageIcon"] = "ph ph-buildings";
    // Project-wide: .gl-v2-body/-rail zijn minstens schermhoog (.gl-v2-app's min-height:100vh +
    // align-items:stretch) — GlV2FullHeightBody laat de kaart daarin meestretchen i.p.v. te krimpen
    // tot haar eigen inhoud, exact zoals .gl-v2-project-menu-slot ernaast.
    ViewData["GlV2FullHeightBody"] = true;
    ViewData["BackUrl"] = Url.Action("Index", "Projecten");

    var canWriteProject = ViewBag.CanWriteProject as bool? ?? false;
    var editUrl = Url.Action("Edit", "Projecten", new { projectid = Model.Project.Id });
    var projectId = Model.Project.Id;

    var be = CultureInfo.GetCultureInfo("nl-BE");
    var today = DateOnly.FromDateTime(DateTime.Today);

    await PermissionService.EnsureLoadedAsync();

    var menuVm = new CPMCore.Models.GlV2.GlV2ProjectMenuVm
    {
        ProjectId = projectId,
        ProjectName = Model.Project.Name,
        ProjectSubtitle = $"project · {Model.UnitRows.Count} eenhe" + (Model.UnitRows.Count == 1 ? "id" : "den"),
        IsCoordinationProject = Model.Project.IsOnlyCoordinationProject
    };

    // ── Statistiekenrij: 6 tegels, elke tegel een echte waarde, percentages als balkje (12a §1) ──
    bool KpiIsSold(CPMCore.Models.Projecten.ProjectDetailUnitRowVM r) =>
        r.Status == "Verkocht" || r.Status == "Akte verleden";
    var kpiOmzetVerkocht = Model.UnitRows.Where(KpiIsSold).Sum(r => r.Vraagprijs);
    var kpiOmzetPotentieel = Model.UnitRows.Sum(r =>
        r.Vraagprijs + (r.Afwerkingen.Count > 0 ? r.Afwerkingen.Max(a => a.Cost) : 0m));
    var werkdagenLaat = Model.WorkingDaysLeft != -9999 && Model.WorkingDaysLeft < 0;
    var fysPct = Model.Voortgang?.FysiekeVoortgangPct ?? 0m;
    var finPct = Model.Voortgang?.FinancieleVoortgangPct ?? 0m;
    string BarW(decimal pct) => Math.Clamp(pct, 0m, 100m).ToString("0.##", CultureInfo.InvariantCulture);
    // Geen budget ingesteld (TotaalBegroot) én nog niets gefactureerd (TotaalGefactureerd) — dan
    // hebben de balkjes/kaders hieronder niets zinvols te tonen (alles staat op 0%), dus toon in de
    // plaats een aanzet om te starten via nacalculatie i.p.v. een kaart vol nul-waarden.
    var voortgangIsEmpty = (Model.Voortgang?.TotaalBegroot ?? 0m) == 0m && (Model.Voortgang?.TotaalGefactureerd ?? 0m) == 0m;

    // ── "Vraagt actie" — zelfde opbouw als de legacy Detail.cshtml se aandachtspaneel, hier 1-op-1
    // hergebruikt (BOCore/DALCore-data was al op deze pagina geladen). ────────────────────────────
    var urgentItems = new List<(string Type, string? Entiteit, string? Extra, string? BekijkUrl, string Icon, string Categorie, string? Meta)>();
    var normalItems = new List<(string Type, string? Entiteit, string? Extra, string? BekijkUrl, string Icon, string Categorie, string? Meta)>();

    foreach (var c in Model.UnsignedContracts)
    {
        string? meta = c.ContractSentDate.HasValue ? $"{(DateTime.Today - c.ContractSentDate.Value).Days} dagen open" : null;
        urgentItems.Add(("Contract niet getekend", c.Company?.Display ?? "onbekende leverancier", c.ContractName,
            Url.Action("EditContract", "Projecten", new { projectid = projectId, contractid = c.Id }), "ph-file-text", "Contracten", meta));
    }
    foreach (var c in Model.GuaranteeMissingContracts)
    {
        urgentItems.Add(("Bankwaarborg ontbreekt", c.Company?.Display ?? "onbekende leverancier", c.ContractName,
            Url.Action("EditContract", "Projecten", new { projectid = projectId, contractid = c.Id }), "ph-shield-warning", "Contracten", null));
    }
    if (Model.Project.Status?.Id == (int)ProjectStatusType.Uitvoering)
    {
        var werfmeldingEditUrl = Url.Action("Edit", "Projecten", new { projectid = projectId });
        if (!Model.Project.WerfmeldingDate.HasValue)
        {
            urgentItems.Add(("Werfmelding ontbreekt", null, "Project is in uitvoering maar er is nog geen werfmelding ingediend",
                werfmeldingEditUrl, "ph-file-text", "Werf", null));
        }
        else if (Model.Project.WerfmeldingEndDate.HasValue && Model.Project.WerfmeldingEndDate.Value < today)
        {
            var werfEinde = Model.Project.WerfmeldingEndDate.Value;
            var dagenVerlopen = (today.ToDateTime(TimeOnly.MinValue) - werfEinde.ToDateTime(TimeOnly.MinValue)).Days;
            urgentItems.Add(("Werfmelding verlopen", null, $"Einddatum {werfEinde.ToString("dd/MM/yyyy", be)} is verstreken — werfmelding verlengen",
                werfmeldingEditUrl, "ph-calendar-x", "Werf", $"{dagenVerlopen} dagen verlopen"));
        }

        var insurancesEditUrl = Url.Action("DetailInsurances", "Projecten", new { projectid = projectId });
        var abrPolicies = Model.Insurances.Where(i => i.Type == InsuranceType.ABR).ToList();
        if (abrPolicies.Count == 0)
        {
            urgentItems.Add(("ABR-verzekering ontbreekt", null, "Project is in uitvoering maar er is geen ABR-polis geregistreerd",
                insurancesEditUrl, "ph-shield-warning", "Financieel", null));
        }
        else if (abrPolicies.All(i => i.Enddate.HasValue && i.Enddate.Value < today))
        {
            var abrEinde = abrPolicies.Max(i => i.Enddate!.Value);
            var dagenVervallen = (today.ToDateTime(TimeOnly.MinValue) - abrEinde.ToDateTime(TimeOnly.MinValue)).Days;
            urgentItems.Add(("ABR-verzekering vervallen", null, $"ABR-polis vervallen sinds {abrEinde.ToString("dd/MM/yyyy", be)} — verlengen",
                insurancesEditUrl, "ph-shield-warning", "Financieel", $"{dagenVervallen} dagen vervallen"));
        }
    }
    if (Model.Voortgang is not null)
    {
        foreach (var code in Model.Voortgang.WarningList)
        {
            string vType; string vExtra;
            switch (code)
            {
                case "OVERFACTURATIE":
                    vType = "Overfacturatie";
                    vExtra = $"Financiële voortgang ({finPct.ToString("0.#")}%) loopt voor op fysieke voortgang ({fysPct.ToString("0.#")}%)";
                    break;
                case "ONDERFACTURATIE":
                    vType = "Onderfacturatie";
                    vExtra = $"Fysieke voortgang ({fysPct.ToString("0.#")}%) loopt voor op financiële voortgang ({finPct.ToString("0.#")}%)";
                    break;
                case "KOSTENOVERSCHRIJDING":
                    vType = "Kostenoverschrijding";
                    vExtra = "Gefactureerd bedrag ligt meer dan 110% boven het gecontracteerde bedrag";
                    break;
                case "GROTE_AFWIJKING":
                    vType = "Grote afwijking";
                    vExtra = $"Fysieke ({fysPct.ToString("0.#")}%) en financiële voortgang ({finPct.ToString("0.#")}%) wijken sterk van elkaar af";
                    break;
                default:
                    vType = "Voortgangswaarschuwing";
                    vExtra = code;
                    break;
            }
            urgentItems.Add((vType, null, vExtra, null, "ph-trend-down", "Financieel", null));
        }
    }
    foreach (var w in Model.ProjectInsuranceWarnings.Where(x => x.Type == "danger"))
    {
        var insExtra = w.Display?.Replace($" van project {Model.Project.Name}", "");
        urgentItems.Add(("Verzekering", null, insExtra, Url.Action("DetailInsurances", "Projecten", new { projectid = projectId }), "ph-shield-warning", "Financieel", null));
    }
    var mijlpaalTrajectUrl = Url.Action("Index", "ProjectTraject", new { projectId = projectId });
    foreach (var m in Model.AttentionMijlpalen)
    {
        var datum = (m.Doeldatum ?? m.DoeldatumBerekend)!.Value;
        var entiteit = m.Unit?.Name;
        if (datum < today)
        {
            var dagenTeLaat = (today.ToDateTime(TimeOnly.MinValue) - datum.ToDateTime(TimeOnly.MinValue)).Days;
            urgentItems.Add(("Mijlpaal achterstallig", entiteit, m.Naam, mijlpaalTrajectUrl, "ph-flag", "Traject", $"{dagenTeLaat} dagen te laat"));
        }
        else if (datum <= today.AddDays(14))
        {
            var dagenNog = (datum.ToDateTime(TimeOnly.MinValue) - today.ToDateTime(TimeOnly.MinValue)).Days;
            normalItems.Add(("Mijlpaal nadert", entiteit, m.Naam, mijlpaalTrajectUrl, "ph-flag", "Traject", $"Nog {dagenNog} dagen"));
        }
    }
    foreach (var i in Model.OpenIssues.Where(x => x.Priority >= (int)ConstructionIssuePriority.High))
    {
        string? meta = i.DueDate.HasValue
            ? (i.DueDate.Value < today ? $"{(today.ToDateTime(TimeOnly.MinValue) - i.DueDate.Value.ToDateTime(TimeOnly.MinValue)).Days} dagen te laat" : $"Nog {(i.DueDate.Value.ToDateTime(TimeOnly.MinValue) - today.ToDateTime(TimeOnly.MinValue)).Days} dagen")
            : null;
        urgentItems.Add((i.Category?.Name ?? "Werfpunt", i.Unit?.Name, i.Title,
            Url.Action("Details", "ProjectsIssues", new { projectId = projectId, id = i.Id }), "ph-warning-circle", "Werf", meta));
    }
    foreach (var i in Model.OpenIssues.Where(x => x.Priority < (int)ConstructionIssuePriority.High))
    {
        string? meta = i.DueDate.HasValue
            ? (i.DueDate.Value < today ? $"{(today.ToDateTime(TimeOnly.MinValue) - i.DueDate.Value.ToDateTime(TimeOnly.MinValue)).Days} dagen te laat" : $"Nog {(i.DueDate.Value.ToDateTime(TimeOnly.MinValue) - today.ToDateTime(TimeOnly.MinValue)).Days} dagen")
            : null;
        normalItems.Add((i.Category?.Name ?? "Werfpunt", i.Unit?.Name, i.Title,
            Url.Action("Details", "ProjectsIssues", new { projectId = projectId, id = i.Id }), "ph-check-square", "Werf", meta));
    }
    foreach (var w in Model.ProjectInsuranceWarnings.Where(x => x.Type != "danger"))
    {
        var insExtra = w.Display?.Replace($" van project {Model.Project.Name}", "");
        normalItems.Add(("Verzekering", null, insExtra, Url.Action("DetailInsurances", "Projecten", new { projectid = projectId }), "ph-shield", "Financieel", null));
    }
    // ── Topbar-chip (12a: status + "N acties vereist" i.p.v. een KPI-tegel voor Status) — telt de
    // ZELFDE lijst als de "ACTIE VEREIST"-groep in de Vraagt-actie-kaart hieronder. Dit was voorheen
    // een eigen, kortere optelsom (enkel UnsignedContracts + GuaranteeMissingContracts + hoge-prio
    // OpenIssues) die stil uit de pas liep zodra een van de andere urgentItems-bronnen (Werfmelding,
    // ABR-verzekering, Voortgang-waarschuwingen, ProjectInsuranceWarnings) iets toevoegde — de badge
    // toonde dan een lager aantal dan wat de kaart eronder echt liet zien. Nu is er nog maar één bron
    // van waarheid voor "hoeveel urgente punten heeft dit project". ────────────────────────────────
    var actionsRequiredCount = urgentItems.Count;
    var allAttentionItems = urgentItems.Concat(normalItems).ToList();
    var attentionCategories = new[] { "Contracten", "Werf", "Financieel", "Traject" }
        .Select(cat => (Naam: cat, Aantal: allAttentionItems.Count(i => i.Categorie == cat)))
        .Where(c => c.Aantal > 0)
        .ToList();

    // ── Traject-kaart (12a: fase/mijlpalen/achterstallig + eerstvolgende mijlpaal) ───────────────
    var canSeeTraject = PermissionService.HasRead(PermissionCodes.ProjectsTraject);
    DALCore.Models.Projecttraject? traject = canSeeTraject ? await TrajectService.GetByProject(projectId, includeDetails: true) : null;
    DALCore.Models.ProjecttrajectFase? huidigeFase = null;
    int mijlpalenBereikt = 0, mijlpalenTotal = 0, mijlpalenAchterstallig = 0;
    (string Naam, string? Unit, DateOnly Datum, bool TeLaat)? volgendeMijlpaal = null;
    if (traject is not null)
    {
        mijlpalenTotal = traject.Mijlpalen.Count;
        mijlpalenBereikt = traject.Mijlpalen.Count(m => m.Status == (int)MijlpaalStatus.Bereikt);
        mijlpalenAchterstallig = traject.Mijlpalen.Count(m =>
            m.IsVerplicht && m.Status != (int)MijlpaalStatus.Bereikt && m.Status != (int)MijlpaalStatus.NietVanToepassing
            && (m.Doeldatum ?? m.DoeldatumBerekend) is DateOnly d && d < today);
        huidigeFase = traject.Fases.OrderBy(f => f.Volgorde).FirstOrDefault(f => f.Status == (int)FaseStatus.Actief)
            ?? traject.Fases.OrderBy(f => f.Volgorde).FirstOrDefault(f => f.Status != (int)FaseStatus.Afgerond);
        var volgende = traject.Mijlpalen
            .Where(m => m.Status != (int)MijlpaalStatus.Bereikt && m.Status != (int)MijlpaalStatus.NietVanToepassing && (m.Doeldatum ?? m.DoeldatumBerekend) != null)
            .OrderBy(m => m.Doeldatum ?? m.DoeldatumBerekend)
            .FirstOrDefault();
        if (volgende is not null)
        {
            var d = (volgende.Doeldatum ?? volgende.DoeldatumBerekend)!.Value;
            volgendeMijlpaal = (volgende.Naam, volgende.Unit?.Name, d, d < today);
        }
    }

    // ── Algemene gegevens (12a: 2 kolommen) ───────────────────────────────────────────────────
    var projectLeaderName = Model.Users?.FirstOrDefault(x => x.Id == Model.Project.AspNetUserID)?.DisplayName;
    var salesResponsibleName = Model.Users?.FirstOrDefault(x => x.Id == Model.Project.SalesResponsibleUserID)?.DisplayName;
    var countryName = Model.Project.Postalcode?.Country?.Name;

    // ── Facturatie/Documenten: max 4 rijen — beide kaarten delen nu een vaste (50/50) hoogte i.p.v.
    // mee te groeien met het aantal regels, dus de lijst zelf capt op wat daar normaal in past. ────
    var facturenRows = Model.RecentInvoices.Take(4).ToList();
    var documentRows = Model.LatestDocs.Take(4).ToList();
    // Som van wat getoond wordt, niet van alle (tot 5) opgehaalde facturen — geen volledige-periode-totaal.
    var facturenGetoondTotaal = facturenRows.Sum(inv => inv.GrossTotal ?? 0m);

    string StatusBadgeTone(string variant) => variant switch
    {
        "primary" => "is-positive",
        "warning" => "is-attention",
        "dark" => "is-neutral",
        _ => "is-neutral"
    };

    var mediaBase = Configuration["URL:ImageWebURL"];
}
@section PageStyle
{
    <link rel="stylesheet" href="~/css/gl-v2-project-inner-menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-projecten-detail.css" asp-append-version="true" />
}
@section PageTitleBadges
{
    @if (Model.Project.Status is not null && !string.IsNullOrWhiteSpace(Model.Project.Status.Name))
    {
        <span class="gl-v2-badge is-positive">@Model.Project.Status.Name.ToUpperInvariant()</span>
    }
    @if (actionsRequiredCount > 0)
    {
        <span class="gl-v2-badge is-attention">@actionsRequiredCount ACTIE@(actionsRequiredCount == 1 ? "" : "S") VEREIST</span>
    }
}
@section PageActions
{
    @if (canWriteProject)
    {
        <a href="@editUrl" class="gl-v2-btn gl-v2-btn-primary"><i class="ph ph-pencil-simple" aria-hidden="true"></i>Bewerken</a>
    }
}
@section ProjectMenu
{
    @{ menuVm.Mode = CPMCore.Models.GlV2.GlV2ProjectMenuMode.Outer; }
    @await Html.PartialAsync("GlV2/_ProjectInnerMenuV2", menuVm)
}

@{ menuVm.Mode = CPMCore.Models.GlV2.GlV2ProjectMenuMode.Phone; }
@await Html.PartialAsync("GlV2/_ProjectInnerMenuV2", menuVm)

<span class="gl-v2-pd-meta">
    Projectcode @(string.IsNullOrWhiteSpace(Model.Project.ProjectCode) ? "—" : Model.Project.ProjectCode)
    @if (!string.IsNullOrWhiteSpace(projectLeaderName))
    {
        <text> · projectleider @projectLeaderName</text>
    }
</span>

@* ── Statistiekenrij (12a §1) ──────────────────────────────────────────────────────────────── *@
<div class="gl-v2-pd-stats">
    <div class="gl-v2-pd-stat">
        <span class="gl-v2-pd-stat-label">VERKOCHT</span>
        <span class="gl-v2-pd-stat-value">@(Model.SalesData?.LivingUnitsSold ?? 0) / @(Model.SalesData?.LivingUnits ?? 0)</span>
        <span class="gl-v2-pd-stat-sub">eenheden@(Model.SalesData is not null ? " · " + Model.SalesData.PercentageLivingUnitsSold.ToString("0.#", be) + "%" : "")</span>
    </div>
    <div class="gl-v2-pd-stat">
        <span class="gl-v2-pd-stat-label">OMZET</span>
        <span class="gl-v2-pd-stat-value">@kpiOmzetVerkocht.ToString("C0", be)</span>
        <span class="gl-v2-pd-stat-sub">@(kpiOmzetPotentieel > 0 ? "van " + kpiOmzetPotentieel.ToString("C0", be) + " potentieel" : "geen potentieel")</span>
    </div>
    <div class="gl-v2-pd-stat">
        <span class="gl-v2-pd-stat-label">FYSIEKE VOORTGANG</span>
        <span class="gl-v2-pd-stat-value">@fysPct.ToString("0.#", be)%</span>
        <span class="gl-v2-pd-stat-track"><span class="gl-v2-pd-stat-fill" style="width:@(BarW(fysPct))%"></span></span>
    </div>
    <div class="gl-v2-pd-stat">
        <span class="gl-v2-pd-stat-label">FINANCIEEL</span>
        <span class="gl-v2-pd-stat-value">@finPct.ToString("0.#", be)%</span>
        <span class="gl-v2-pd-stat-track"><span class="gl-v2-pd-stat-fill is-finance" style="width:@(BarW(finPct))%"></span></span>
    </div>
    <div class="gl-v2-pd-stat">
        <span class="gl-v2-pd-stat-label">WERKDAGEN</span>
        <span class="gl-v2-pd-stat-value @(werkdagenLaat ? "is-danger" : "")">@(Model.WorkingDaysLeft == -9999 ? "—" : (werkdagenLaat ? $"{-Model.WorkingDaysLeft} te laat" : Model.WorkingDaysLeft.ToString()))</span>
        <span class="gl-v2-pd-stat-sub">@(Model.FinalConstructionDate != DateOnly.MinValue ? "tot " + Model.FinalConstructionDate.ToString("dd/MM/yy") : "geen einddatum")</span>
    </div>
    <div class="gl-v2-pd-stat">
        <span class="gl-v2-pd-stat-label">OPEN PUNTEN</span>
        <span class="gl-v2-pd-stat-value @(Model.OpenIssuesCount > 0 ? "is-danger" : "is-muted")">@Model.OpenIssuesCount</span>
        <span class="gl-v2-pd-stat-sub">@(Model.OpenIssuesCount > 0 ? "vraagt opvolging" : "niets openstaand")</span>
    </div>
</div>

@* ── "Vraagt actie" (12a §3) ──────────────────────────────────────────────────────────────── *@
@* De hele kaart rendert enkel wanneer er iets aan te tonen is — geen "Niets dat aandacht vraagt"-
   staat meer: een project zonder openstaande actiepunten hoeft geen kaart te tonen die alleen maar
   bevestigt dat er niets is, dat is gewoon ruimte die de rest van de pagina niet krijgt.
   gl-v2-pd-attention-card krijgt daarnaast een warning/danger-getinte bovenrand — de rest van de
   pagina gebruikt hetzelfde neutrale .gl-v2-section-card-register, dus zonder dit las de ene kaart
   die juist moet opvallen als nog maar een kaart in de stapel. *@
@if (allAttentionItems.Any())
{
    <div class="gl-v2-section-card gl-v2-pd-attention-card has-items @(urgentItems.Any() ? "has-urgent" : "")">
        <div class="gl-v2-pd-attention-head">
            <span class="gl-v2-pd-attention-icon"><i class="ph ph-warning" aria-hidden="true"></i></span>
            <span class="gl-v2-pd-attention-title">Vraagt actie</span>
            <span class="gl-v2-field-divider"></span>
            <span class="gl-v2-pd-attention-desc">Alles wat dit project tegenhoudt, op één plek — urgent bovenaan.</span>
            <span class="gl-v2-pd-attention-spacer"></span>
            <div class="gl-v2-pd-chips" role="group" aria-label="Filter op categorie">
                <button type="button" class="gl-v2-pd-chip is-active js-gl-v2-pd-chip" data-cat="alle" aria-pressed="true">Alles @allAttentionItems.Count</button>
                @foreach (var cat in attentionCategories)
                {
                    <button type="button" class="gl-v2-pd-chip js-gl-v2-pd-chip" data-cat="@cat.Naam" aria-pressed="false">@cat.Naam @cat.Aantal</button>
                }
            </div>
            <div id="gl-v2-pd-filter-status" class="visually-hidden" aria-live="polite"></div>
        </div>
        <div class="gl-v2-pd-attention-body js-gl-v2-pd-attention-body">
            @if (urgentItems.Any())
            {
                <div class="js-gl-v2-pd-attention-group">
                    <div class="gl-v2-pd-attention-group-hdr is-urgent"><i class="ph ph-warning-circle" aria-hidden="true"></i>ACTIE VEREIST<span class="gl-v2-pd-attention-group-cnt">(@urgentItems.Count)</span></div>
                    @foreach (var item in urgentItems)
                    {
                        @* Razor omits the href attribute entirely when BekijkUrl is null — no "#" fallback,
                           so an item with no real destination renders as plain, non-clickable text
                           instead of a link that looks live but goes nowhere (there's already no hover
                           style on this class either way, see gl-v2-projecten-detail.css). *@
                        <a class="gl-v2-pd-attention-item js-gl-v2-pd-attention-item" data-cat="@item.Categorie" href="@item.BekijkUrl">
                            <i class="ph @item.Icon gl-v2-pd-attention-item-icon" aria-hidden="true"></i>
                            <span class="gl-v2-pd-attention-item-text"><b>@item.Type</b>@(item.Entiteit is not null ? " — " + item.Entiteit : "")@(item.Extra is not null ? " · " + item.Extra : "")</span>
                            @if (item.Meta is not null)
                            {
                                <span class="gl-v2-pd-attention-meta">@item.Meta</span>
                            }
                            @if (item.BekijkUrl is not null)
                            {
                                <span class="gl-v2-pd-attention-view">Bekijk <i class="ph ph-caret-right" aria-hidden="true"></i></span>
                            }
                        </a>
                    }
                </div>
            }
            @if (normalItems.Any())
            {
                <div class="js-gl-v2-pd-attention-group">
                    <div class="gl-v2-pd-attention-group-hdr"><i class="ph ph-clock" aria-hidden="true"></i>OP TE LOSSEN<span class="gl-v2-pd-attention-group-cnt">(@normalItems.Count)</span></div>
                    @foreach (var item in normalItems)
                    {
                        <a class="gl-v2-pd-attention-item is-normal js-gl-v2-pd-attention-item" data-cat="@item.Categorie" href="@item.BekijkUrl">
                            <i class="ph @item.Icon gl-v2-pd-attention-item-icon" aria-hidden="true"></i>
                            <span class="gl-v2-pd-attention-item-text"><b>@item.Type</b>@(item.Entiteit is not null ? " — " + item.Entiteit : "")@(item.Extra is not null ? " · " + item.Extra : "")</span>
                            @if (item.Meta is not null)
                            {
                                <span class="gl-v2-pd-attention-meta">@item.Meta</span>
                            }
                            @if (item.BekijkUrl is not null)
                            {
                                <span class="gl-v2-pd-attention-view">Bekijk <i class="ph ph-caret-right" aria-hidden="true"></i></span>
                            }
                        </a>
                    }
                </div>
            }
        </div>
    </div>
}

@* ── Traject + Eenheden (12a §4/§7) ───────────────────────────────────────────────────────── *@
<div class="gl-v2-pd-grid">
    @if (canSeeTraject)
    {
        <div class="gl-v2-pd-col-5 gl-v2-section-card">
            <div class="gl-v2-section-card-header">
                <span class="gl-v2-section-card-icon"><i class="ph ph-flow-arrow" aria-hidden="true"></i></span>
                <h2 class="gl-v2-section-card-title">Traject</h2>
                <span class="gl-v2-field-divider"></span>
                <span class="gl-v2-section-card-desc">@(mijlpalenTotal > 0 ? $"{mijlpalenBereikt} van {mijlpalenTotal} mijlpalen bereikt" : "Nog geen traject")</span>
                <span class="gl-v2-section-card-spacer"></span>
                <a href="@mijlpaalTrajectUrl" class="gl-v2-card-header-action">Openen</a>
            </div>
            @if (traject is null)
            {
                <div class="gl-v2-empty-state gl-v2-empty-state-inline">
                    <span class="gl-v2-empty-state-icon"><i class="ph ph-flow-arrow" aria-hidden="true"></i></span>
                    <h3 class="gl-v2-empty-state-title">Nog geen traject</h3>
                    <p class="gl-v2-empty-state-desc">Stel het traject in om fases en mijlpalen voor dit project op te volgen.</p>
                    <div class="gl-v2-empty-state-actions">
                        <a href="@mijlpaalTrajectUrl" class="gl-v2-btn gl-v2-btn-primary">Traject instellen</a>
                    </div>
                </div>
            }
            else
            {
                <div class="gl-v2-pd-traject-stats">
                    <div><span class="gl-v2-pd-traject-stat-label">HUIDIGE FASE</span><span class="gl-v2-pd-traject-stat-value">@(huidigeFase?.Naam ?? "—")</span></div>
                    <div><span class="gl-v2-pd-traject-stat-label">MIJLPALEN</span><span class="gl-v2-pd-traject-stat-value">@mijlpalenBereikt / @mijlpalenTotal</span></div>
                    <div><span class="gl-v2-pd-traject-stat-label">ACHTERSTALLIG</span><span class="gl-v2-pd-traject-stat-value @(mijlpalenAchterstallig > 0 ? "is-danger" : "")">@mijlpalenAchterstallig</span></div>
                </div>
                var doneFrac = mijlpalenTotal > 0 ? (decimal)mijlpalenBereikt / mijlpalenTotal : 0m;
                var doneFlex = Math.Max(doneFrac, 0.02m).ToString("0.###", CultureInfo.InvariantCulture);
                var restFlex = Math.Max(1 - doneFrac, 0.02m).ToString("0.###", CultureInfo.InvariantCulture);
                <div class="gl-v2-pd-traject-bar">
                    <span class="is-done" style="flex:@doneFlex"></span>
                    <span class="is-overdue" style="flex:@restFlex"></span>
                </div>
                @if (volgendeMijlpaal is { } vm)
                {
                    <div class="gl-v2-pd-traject-next">
                        <span class="gl-v2-pd-traject-stat-label">VOLGENDE MIJLPAAL</span>
                        <div class="gl-v2-pd-traject-next-row">
                            <span class="gl-v2-pd-traject-next-name">@vm.Naam@(vm.Unit is not null ? " · " + vm.Unit : "")</span>
                            <span class="gl-v2-pd-traject-next-date @(vm.TeLaat ? "is-danger" : "")">@vm.Datum.ToString("dd/MM/yyyy")</span>
                        </div>
                        @if (vm.TeLaat)
                        {
                            <span class="gl-v2-pd-traject-next-sub">@((today.ToDateTime(TimeOnly.MinValue) - vm.Datum.ToDateTime(TimeOnly.MinValue)).Days) dagen te laat</span>
                        }
                    </div>
                }
            }
        </div>
    }
    <div class="gl-v2-pd-col-7 gl-v2-section-card">
        <div class="gl-v2-section-card-header">
            <span class="gl-v2-section-card-icon"><i class="ph ph-buildings" aria-hidden="true"></i></span>
            <h2 class="gl-v2-section-card-title">Eenheden &amp; verkoopstatus</h2>
            <span class="gl-v2-section-card-meta">@Model.UnitRows.Count</span>
            <span class="gl-v2-section-card-spacer"></span>
            <a href="@Url.Action("DetailSales", "Projecten", new { projectid = projectId })" class="gl-v2-card-header-action">Alle eenheden</a>
        </div>
        @if (Model.UnitRows.Any())
        {
            <div class="gl-v2-pd-units-search">
                <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                <input type="search" id="gl-v2-pd-units-filter" placeholder="Zoek een eenheid of klant…" autocomplete="off" aria-label="Eenheden filteren op eenheid of klant" />
            </div>
            @* Zelfde patroon als #gl-v2-pd-filter-status hierboven bij de attention-chips — zonder dit
               kreeg een screenreader-gebruiker die hier typt geen enkele terugkoppeling dat de tabel
               net van bv. 40 naar 2 rijen ging. *@
            <div id="gl-v2-pd-units-filter-status" class="visually-hidden" aria-live="polite"></div>
            <div class="gl-v2-pd-units-scroll">
                <table class="gl-v2-pd-units-table">
                    <thead>
                        <tr>
                            <th>Eenheid</th><th class="gl-v2-pd-units-col-collapsible">Type</th><th class="text-end gl-v2-pd-units-col-collapsible">Opp.</th><th class="text-end">Prijs</th><th>Status</th><th class="gl-v2-pd-units-col-collapsible">Klant</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.UnitRows)
                        {
                            var effectiefVerkocht = u.Status == "Verkocht" || u.Status == "Akte verleden";
                            <tr data-unit-row data-search="@($"{u.Naam} {u.KlantNaam}".ToLowerInvariant())">
                                <td>
                                    <a href="@Url.Action("EditUnit", "Projecten", new { projectid = projectId, unitid = u.UnitId })">@u.Naam</a>
                                    @* Enkel zichtbaar <768px (gl-v2-projecten-detail.css) — herhaalt Type/Opp./Klant hier
                                       zodat die drie kolommen op de telefoon verborgen kunnen worden zonder de info te
                                       verliezen, i.p.v. een tabel met 6 kolommen op 360px te persen. *@
                                    <div class="gl-v2-pd-units-meta">
                                        @u.TypeName
                                        @if (u.Oppervlakte.HasValue)
                                        {
                                            @:· @(u.Oppervlakte.Value.ToString("0")) m²
                                        }
                                        @if (u.ClientId.HasValue)
                                        {
                                            @:· @u.KlantNaam
                                        }
                                    </div>
                                </td>
                                <td class="gl-v2-pd-units-col-collapsible">@u.TypeName</td>
                                <td class="text-end gl-v2-pd-units-col-collapsible">@(u.Oppervlakte.HasValue ? u.Oppervlakte.Value.ToString("0") + " m²" : "—")</td>
                                <td class="text-end">
                                    @if (effectiefVerkocht)
                                    {
                                        @u.Vraagprijs.ToString("C0", be)
                                    }
                                    else if (u.Afwerkingen.Count > 1)
                                    {
                                        <div>vanaf @((u.Vraagprijs + u.Afwerkingen.Min(a => a.Cost)).ToString("C0", be))</div>
                                        <div class="gl-v2-pd-units-sub">bouwwaarde @((u.Vraagprijs + u.Afwerkingen.Max(a => a.Cost)).ToString("C0", be))</div>
                                    }
                                    else
                                    {
                                        @u.Vraagprijs.ToString("C0", be)
                                        @if (u.Afwerkingen.Any())
                                        {
                                            <div class="gl-v2-pd-units-sub">+ @u.Afwerkingen[0].Description (@u.Afwerkingen[0].Cost.ToString("C0", be))</div>
                                        }
                                    }
                                </td>
                                <td><span class="gl-v2-badge @StatusBadgeTone(u.StatusVariant)">@u.Status.ToUpperInvariant()</span></td>
                                <td class="gl-v2-pd-units-col-collapsible">
                                    @if (u.ClientId.HasValue)
                                    {
                                        <a href="@Url.Action("Detail", "Klanten", new { clientid = u.ClientId, projectid = projectId })">@u.KlantNaam</a>
                                    }
                                    else
                                    {
                                        @:—
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div id="gl-v2-pd-units-empty" class="gl-v2-pd-units-empty" hidden>Geen eenheid of klant gevonden.</div>
            </div>
        }
        else
        {
            <div class="gl-v2-empty-state gl-v2-empty-state-inline">
                <span class="gl-v2-empty-state-icon"><i class="ph ph-buildings" aria-hidden="true"></i></span>
                <h3 class="gl-v2-empty-state-title">Nog geen eenheden</h3>
                <p class="gl-v2-empty-state-desc">Er zijn nog geen eenheden ingesteld voor dit project.</p>
                <div class="gl-v2-empty-state-actions">
                    <a href="@Url.Action("DetailUnits", "Projecten", new { projectid = projectId })" class="gl-v2-btn gl-v2-btn-primary">Eenheden beheren</a>
                </div>
            </div>
        }
    </div>
</div>

@* ── Algemene gegevens + Voortgang &amp; budget + Facturatie/Documenten (12a §5/§6) ──────────── *@
<div class="gl-v2-pd-grid">
    <div class="gl-v2-pd-col-5 gl-v2-section-card">
        <div class="gl-v2-section-card-header">
            <span class="gl-v2-section-card-icon"><i class="ph ph-info" aria-hidden="true"></i></span>
            <h2 class="gl-v2-section-card-title">Algemene gegevens</h2>
            <span class="gl-v2-field-divider"></span>
            <span class="gl-v2-section-card-desc">Adres, codes en alle partijen op het project.</span>
            <span class="gl-v2-section-card-spacer"></span>
            @if (canWriteProject)
            {
                <a href="@editUrl" class="gl-v2-card-header-action">Bewerken</a>
            }
        </div>
        <div class="gl-v2-detail-grid gl-v2-pd-2col" style="padding:16px 18px">
            <div class="gl-v2-detail-field is-wide">
                <span class="gl-v2-detail-label">Adres</span>
                <span class="gl-v2-detail-value">
                    @Model.Project.Street @Model.Project.HouseNumber<br />
                    @Model.Project.Postalcode?.Postcode @Model.Project.Postalcode?.Gemeente@(string.IsNullOrWhiteSpace(countryName) ? "" : ", " + countryName)
                </span>
            </div>
            @Html.DisplayFor(m => m.Project.ProjectCode, "GlV2DetailField", new { Label = "Projectcode" })
            @Html.DisplayFor(m => m.Project.WheaterStation.Name, "GlV2DetailField", new { Label = "Weerstation" })
            @Html.DisplayFor(m => m.Project.Developer.Display, "GlV2DetailField", new { Label = "Ontwikkelaar" })
            @Html.DisplayFor(m => m.Project.Builder.Display, "GlV2DetailField", new { Label = "Aannemer" })
            <div class="gl-v2-detail-field"><span class="gl-v2-detail-label">Projectleider</span><span class="gl-v2-detail-value@(string.IsNullOrWhiteSpace(projectLeaderName) ? " is-empty" : "")">@(string.IsNullOrWhiteSpace(projectLeaderName) ? "—" : projectLeaderName)</span></div>
            <div class="gl-v2-detail-field"><span class="gl-v2-detail-label">Verkoopverantw.</span><span class="gl-v2-detail-value@(string.IsNullOrWhiteSpace(salesResponsibleName) ? " is-empty" : "")">@(string.IsNullOrWhiteSpace(salesResponsibleName) ? "—" : salesResponsibleName)</span></div>
            @Html.DisplayFor(m => m.Project.Notary.Display, "GlV2DetailField", new { Label = "Notaris" })
            @Html.DisplayFor(m => m.Project.Architect.Display, "GlV2DetailField", new { Label = "Architect" })
            @Html.DisplayFor(m => m.Project.Engineer.Display, "GlV2DetailField", new { Label = "Ingenieur stab." })
            @Html.DisplayFor(m => m.Project.SecurityCoordinator.Display, "GlV2DetailField", new { Label = "Veiligheidscoörd." })
            @Html.DisplayFor(m => m.Project.EpbReporter.Display, "GlV2DetailField", new { Label = "EPB-verslaggever" })
        </div>
    </div>

    <div class="gl-v2-pd-col-4 gl-v2-section-card">
        <div class="gl-v2-section-card-header">
            <span class="gl-v2-section-card-icon"><i class="ph ph-chart-bar" aria-hidden="true"></i></span>
            <h2 class="gl-v2-section-card-title">Voortgang &amp; budget</h2>
            <span class="gl-v2-section-card-spacer"></span>
            <a href="@Url.Action("Recalculation", "Projecten", new { projectid = projectId })" class="gl-v2-card-header-action">Nacalculatie</a>
        </div>
        @if (voortgangIsEmpty)
        {
            <div class="gl-v2-empty-state gl-v2-empty-state-inline">
                <span class="gl-v2-empty-state-icon"><i class="ph ph-calculator" aria-hidden="true"></i></span>
                <h3 class="gl-v2-empty-state-title">Beginnen met nacalculatie?</h3>
                <p class="gl-v2-empty-state-desc">Er is nog geen budget ingesteld en er zijn nog geen facturen voor dit project.</p>
                <div class="gl-v2-empty-state-actions">
                    <a href="@Url.Action("Recalculation", "Projecten", new { projectid = projectId })" class="gl-v2-btn gl-v2-btn-primary">Naar nacalculatie</a>
                </div>
            </div>
        }
        else
        {
            <div class="gl-v2-pd-vb-bars">
                <div>
                    <div class="gl-v2-pd-vb-bar-head"><span class="gl-v2-pd-vb-bar-label">Fysieke voortgang</span><span class="gl-v2-pd-vb-bar-pct">@fysPct.ToString("0.#", be)%</span></div>
                    <span class="gl-v2-pd-vb-track"><span class="gl-v2-pd-vb-fill" style="width:@(BarW(fysPct))%"></span></span>
                </div>
                <div>
                    <div class="gl-v2-pd-vb-bar-head"><span class="gl-v2-pd-vb-bar-label">Financiële voortgang</span><span class="gl-v2-pd-vb-bar-pct">@finPct.ToString("0.#", be)%</span></div>
                    <span class="gl-v2-pd-vb-track"><span class="gl-v2-pd-vb-fill is-finance" style="width:@(BarW(finPct))%"></span></span>
                </div>
            </div>
            <div class="gl-v2-pd-vb-stats">
                <div class="gl-v2-pd-vb-stat">
                    <span class="gl-v2-pd-vb-stat-label">BUDGET</span>
                    <span class="gl-v2-pd-vb-stat-value">@((Model.Voortgang?.TotaalBegroot ?? 0m).ToString("C0", be))</span>
                    <span class="gl-v2-pd-vb-stat-sub">besteed @((Model.Voortgang?.TotaalGefactureerd ?? 0m).ToString("C0", be))</span>
                </div>
                <div class="gl-v2-pd-vb-stat">
                    <span class="gl-v2-pd-vb-stat-label">GECONTRACTEERD</span>
                    <span class="gl-v2-pd-vb-stat-value">@((Model.Voortgang?.TotaalGecontracteerd ?? 0m).ToString("C0", be))</span>
                    <span class="gl-v2-pd-vb-stat-sub">@((Model.Voortgang?.ContractueleVolwassenheidPct ?? 0m).ToString("0.#", be))% van budget</span>
                </div>
            </div>
        }
    </div>

    <div class="gl-v2-pd-col-3 gl-v2-pd-col-stack">
        <div class="gl-v2-section-card">
            <div class="gl-v2-section-card-header">
                <span class="gl-v2-section-card-icon"><i class="ph ph-invoice" aria-hidden="true"></i></span>
                <h2 class="gl-v2-section-card-title">Facturatie</h2>
                <span class="gl-v2-section-card-spacer"></span>
                <a href="@Url.Action("Invoicing", "Projecten", new { projectid = projectId })" class="gl-v2-card-header-action">Blad</a>
            </div>
            @if (facturenRows.Any())
            {
                <div class="gl-v2-pd-rows">
                    @foreach (var inv in facturenRows)
                    {
                        <a class="gl-v2-pd-row" href="@Url.Action("Detail", "Invoices", new { id = inv.Id })">
                            <div class="gl-v2-pd-row-main">
                                <span class="gl-v2-pd-row-title">@(string.IsNullOrWhiteSpace(inv.PublicId) ? "Proforma" : inv.PublicId)</span>
                                <span class="gl-v2-pd-row-sub">@inv.ClientName · @inv.StatusName</span>
                            </div>
                            <span class="gl-v2-pd-row-value">@((inv.GrossTotal ?? 0m).ToString("C0", be))</span>
                        </a>
                    }
                </div>
                <div class="gl-v2-pd-rows-total">
                    <span class="gl-v2-pd-rows-total-label">Getoond</span>
                    <span class="gl-v2-pd-rows-total-value">@facturenGetoondTotaal.ToString("C0", be)</span>
                </div>
            }
            else
            {
                <div class="gl-v2-empty-state gl-v2-empty-state-inline">
                    <span class="gl-v2-empty-state-icon"><i class="ph ph-invoice" aria-hidden="true"></i></span>
                    <h3 class="gl-v2-empty-state-title">Nog geen facturen</h3>
                    <p class="gl-v2-empty-state-desc">Er zijn nog geen facturen voor dit project.</p>
                    <div class="gl-v2-empty-state-actions">
                        <a href="@Url.Action("Invoicing", "Projecten", new { projectid = projectId })" class="gl-v2-btn gl-v2-btn-primary">Factuur opmaken</a>
                    </div>
                </div>
            }
        </div>

        <div class="gl-v2-section-card">
            <div class="gl-v2-section-card-header">
                <span class="gl-v2-section-card-icon"><i class="ph ph-folder" aria-hidden="true"></i></span>
                <h2 class="gl-v2-section-card-title">Documenten</h2>
                <span class="gl-v2-section-card-meta">@Model.LatestDocs.Count</span>
                <span class="gl-v2-section-card-spacer"></span>
            </div>
            @if (documentRows.Any())
            {
                <div class="gl-v2-pd-rows">
                    @foreach (var doc in documentRows)
                    {
                        var docTitle = string.IsNullOrWhiteSpace(doc.Name) ? doc.Type.GetDisplayName() : doc.Name;
                        <a class="gl-v2-pd-row" href="@Url.Action("ViewDoc", "Projecten", new { id = doc.Docid })" target="_blank" rel="noopener">
                            <span class="gl-v2-pd-row-badge"><i class="ph ph-file-text" aria-hidden="true"></i></span>
                            <div class="gl-v2-pd-row-main">
                                <span class="gl-v2-pd-row-title">@docTitle</span>
                                <span class="gl-v2-pd-row-sub">@doc.Type.GetDisplayName()@(doc.DocDate.HasValue ? " · " + doc.DocDate.Value.ToString("dd/MM/yyyy") : "")</span>
                            </div>
                        </a>
                    }
                </div>
                <a class="gl-v2-pd-add-row" href="@Url.Action("DetailDocs", "Projecten", new { projectid = projectId })"><i class="ph ph-plus" aria-hidden="true"></i>Document toevoegen</a>
            }
            else
            {
                <div class="gl-v2-empty-state gl-v2-empty-state-inline">
                    <span class="gl-v2-empty-state-icon"><i class="ph ph-folder" aria-hidden="true"></i></span>
                    <h3 class="gl-v2-empty-state-title">Nog geen documenten</h3>
                    <p class="gl-v2-empty-state-desc">Er zijn nog geen documenten voor dit project.</p>
                    <div class="gl-v2-empty-state-actions">
                        <a href="@Url.Action("DetailDocs", "Projecten", new { projectid = projectId })" class="gl-v2-btn gl-v2-btn-primary">Document toevoegen</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* ── Foto's & media (12a §2/§7 — nog geen thumbnail-overname naar topbar/inner menu, zie bovenaan) ── *@
<div class="gl-v2-section-card">
    <div class="gl-v2-section-card-header">
        <span class="gl-v2-section-card-icon"><i class="ph ph-image" aria-hidden="true"></i></span>
        <h2 class="gl-v2-section-card-title">Foto's &amp; media</h2>
        <span class="gl-v2-field-divider"></span>
        <span class="gl-v2-section-card-desc">@Model.TotalPictureCount van de foto's van dit project.</span>
        <span class="gl-v2-section-card-spacer"></span>
        <a href="@Url.Action("DetailPhotos", "Projecten", new { projectid = projectId })" class="gl-v2-card-header-action">Alle foto's</a>
    </div>
    <div class="gl-v2-pd-media-grid">
        @foreach (var pic in Model.LatestPictures)
        {
            var isVideo = pic.MediaType == 1;
            <a class="gl-v2-pd-media-thumb@(isVideo ? " is-video" : "")" href="@Url.Action("DetailPhotos", "Projecten", new { projectid = projectId })">
                @if (isVideo)
                {
                    <video src="@Url.Content(mediaBase + "videos/" + pic.Name)" preload="metadata" muted playsinline></video>
                    <span class="gl-v2-pd-media-play"><i class="ph ph-play-circle" aria-hidden="true"></i></span>
                }
                else
                {
                    <img src="@Url.Content(mediaBase + "pictures/447/" + pic.Name)" alt="" loading="lazy" />
                }
            </a>
        }
        @if (Model.TotalPictureCount > Model.LatestPictures.Count)
        {
            <a class="gl-v2-pd-media-empty" style="display:flex;align-items:center;justify-content:center;font:500 11px var(--gl-v2-font-sans);color:var(--gl-v2-muted);text-decoration:none" href="@Url.Action("DetailPhotos", "Projecten", new { projectid = projectId })">+ @(Model.TotalPictureCount - Model.LatestPictures.Count) meer</a>
        }
        <a class="gl-v2-pd-media-add" href="@Url.Action("DetailPhotos", "Projecten", new { projectid = projectId })"><i class="ph ph-plus" aria-hidden="true"></i>Toevoegen</a>
    </div>
</div>

@section PageScripts
{
    <script src="~/js/gl-v2-project-inner-menu.js" asp-append-version="true"></script>
    <script src="~/js/gl-v2-projecten-detail.js" asp-append-version="true"></script>
}
