@using CPMCore.Controllers
@using CPMCore.Helpers
@using BOCore
@inject IConfiguration Configuration
@model CPMCore.Models.Projecten.ProjectAddContractModel;

@section PageStyle
{
	<link rel="stylesheet" href="~/lib/bootstrap-fileupload/bootstrap-fileupload.min.css" />
	<link rel="stylesheet" href="~/lib/select2/css/select2.css" />
 	<link rel="stylesheet" href="~/lib/select2-bootstrap-theme/select2-bootstrap.css" />
	<link rel="stylesheet" href="~/css/admin/theme-admin-extension.css" />
	<link rel="stylesheet" href="~/css/admin/skins/extension.css" />
	<link rel="stylesheet" href="~/lib/bootstrap-tagsinput/bootstrap-tagsinput.css" />
	<link rel="stylesheet" href="~/lib/bootstrap-multiselect/css/bootstrap-multiselect.css">
	<link rel="stylesheet" href="~/lib/dropzone/basic.css" />
	<link rel="stylesheet" href="~/lib/dropzone/dropzone.css" />
	<script src="https://cdnjs.cloudflare.com/ajax/libs/inputmask/5.0.8/jquery.inputmask.min.js"></script>
	</style>

}


<div class="row">
	<div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
		<div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
			<div class="row align-items-center">
				<div class="col-sm-auto d-flex align-items-center">
					<a href="@Url.Action("DetailContracts", "Projecten",new {projectid = Model.ProjectId})" class="text-decoration-none text-reset d-flex align-items-center">
						<i class="bx bx-chevron-left fs-1"></i>
					</a>
				</div>
				<div class="col-sm-auto">
					<h1 class="fw-bold mb-0">Leverancier bewerken</h1>
					<h5 class="mb-4 mt-0">Bewerk het contract van een leverancier van het project</h5>
				</div>
			</div>
		</div>
	</div>
</div>
@using (Html.BeginForm("AddContract", "Projecten", FormMethod.Post, new { @class = "ecommerce-form action-buttons-fixed", @action = "#", enctype = "multipart/form-data" }))
{
	@Html.AntiForgeryToken()
	@Html.HiddenFor(m => m.ProjectId, new { id = "projectid" })
	@Html.HiddenFor(m => m.Contract.ProjectId, new { id = "contractprojectid" })
	@Html.HiddenFor(m => m.Contract.Id, new { id = "contractid" })
	@Html.HiddenFor(m => m.ProjectName, new { id = "projectname" })
	<input type="hidden" id="txtCompanyDisplay" value="@Model.Contract.Company.Display" />
	<div class="row mt-2">
		<div class="col">
			<section class="card card-modern card-big-info">
				<div class="card-body">
					<div class="row">
						<div class="col-lg-2-5 col-xl-1-5">
							<i class="card-big-info-icon bx bx-box"></i>
							<h2 class="card-big-info-title">Algemene info</h2>
							<p class="card-big-info-desc">Voeg hier de algemene info van het contract in.</p>
						</div>
						<div class="col-lg-3-5 col-xl-4-5">

							<div class="form-group row align-items-center pb-3">
								<label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0">
									@Html.LabelFor(m => m.Contract.ContractName)
								</label>
								<div class="col-lg-8 col-xl-6">
									@Html.TextBoxFor(m => m.Contract.ContractName, new { @class = "form-control form-control-modern", placeholder = "Optionele naam voor dit contract" })
								</div>
							</div>
							<div class="form-group row align-items-center pb-3">
								<label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0">
									@Html.LabelFor(m => m.Companies)
								</label>
								<div class="col-lg-8 col-xl-6">
									@if (Model.Contract.Company.ID > 0)
									{
										<p class="form-control-static mb-0">
											<strong>
												@Model.Contract.Company.Display
												@Html.HiddenFor(m => m.Contract.Company.ID, new { id = "txtCompanyID", @class = "form-control" })
											</strong>
										</p>
									}
									else
									{
										<select id="ddlCompany" class="form-control w-100">
											<!-- Voeg hier de opties toe -->
										</select>
										@Html.HiddenFor(m => m.Contract.Company.ID, new { id = "txtCompanyID", @class = "form-control" })
									}
								</div>
							</div>
							<div class="form-group row align-items-center pb-3">
								<div class="form-group row align-items-center pb-3">
									<label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="ddlSiteManager">@Html.LabelFor(m => m.Contract.SiteManagerContactId)</label>
									<div class="col-lg-8 col-xl-6">
										<div class="input-group">
											@Html.DropDownListFor(m => m.Contract.SiteManagerContactId, new SelectList(Model.SiteManagers, "ID", "Display", Model.Contract.SiteManagerContactId), "Geen", new { @class = "form-control form-control-modern", id = "ddlSiteManager" })
											<button type="button" class="btn btn-outline-secondary" id="btnNewSiteManager" title="Nieuwe werfleider toevoegen" aria-label="Nieuwe werfleider toevoegen">
												<i class="bx bx-user-plus" aria-hidden="true"></i>
											</button>
										</div>
									</div>
								</div>
								<label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0">@Html.LabelFor(m => m.Contract.VatPercentage)</label>
								<div class="col-lg-3 col-xl-2">
									@Html.EditorFor(m => m.Contract.VatPercentage, new { id = "txtVatPercentage", @class = "form-control form-control-modern", placeholder = "0,00", autocomplete = "off" })
								</div>
								<label class="col-lg-2 col-xl-23 control-label text-lg-end mb-0">@Html.LabelFor(m => m.Contract.PaymentTerm)</label>
								<div class="col-lg-3 col-xl-2">
									@Html.TextBoxFor(m => m.Contract.PaymentTerm, new { id = "txtPaymentTerm", @class = "form-control form-control-modern", placeholder = "Aantal dagen" })
								</div>
							</div>

							<div class="form-group row align-items-center pb-3">
								<label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0">@Html.LabelFor(m => m.Contract.CashDiscountPaymentTerm)</label>
								<div class="col-lg-3 col-xl-2">
									<div class="input-group mb-3">
										<span class="input-group-text">
											@Html.CheckBoxFor(m => m.Contract.CashDiscount, new  {id = "chkCashDiscount"})
										</span>
										@Html.TextBoxFor(m => m.Contract.CashDiscountPaymentTerm, new { id = "txtCashDiscountPaymentTerm", @class = "form-control form-control-modern", type = "text", placeholder = "Aantal dagen" }).DisableIf(() => !Model.Contract.CashDiscount)
									</div>
									
								</div>
								<label class="col-lg-2 col-xl-2 control-label text-lg-end mb-0">@Html.LabelFor(m => m.Contract.CashDiscountPercentage)</label>
								<div class="col-lg-3 col-xl-2">
									@Html.EditorFor(m => m.Contract.CashDiscountPercentage, new { id = "txtCashDiscountPercentage", @class = "form-control form-control-modern", placeholder = "Aantal dagen" }).DisableIf(() => !Model.Contract.CashDiscount)
								</div>
							</div>
							<div class="form-group row align-items-center pb-3">
								<label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0">@Html.LabelFor(m => m.Contract.GuaranteeType)</label>
								<div class="col-lg-3 col-xl-2">
									@Html.DropDownListFor(m => m.Contract.GuaranteeType, Html.GetEnumSelectList(Model.Contract.GuaranteeType.GetType()), new { @class = "form-control form-control-modern", id = "lstGuaranteeType" })
								</div>
								<label class="col-lg-2 col-xl-2 control-label text-lg-end mb-0">@Html.LabelFor(m => m.Contract.GuaranteePercentage)</label>
								<div class="col-lg-3 col-xl-2">
									@Html.EditorFor(m => m.Contract.GuaranteePercentage, new { id = "txtGuaranteePercentage", @class = "form-control form-control-modern", placeholder = "Aantal dagen" }).DisableIf(() => Model.Contract.GuaranteeType != ContractGuaranteeType.FinancialGuarantee)
								</div>
							</div>
							<div class="form-group row align-items-center pb-3" id="guaranteeDocRow" style="@(Model.Contract.GuaranteeType == ContractGuaranteeType.BankGuarantee ? "" : "display:none")">
								<label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="fileGuaranteeDoc">Waarborgdocument <span class="text-muted">(pdf/jpg)</span></label>
								<div class="col-lg-8 col-xl-6">
									@if (!string.IsNullOrWhiteSpace(Model.Contract.GuaranteeDocFilename))
									{
										<div class="d-flex align-items-center gap-2 mb-2">
											<a href="@Url.Action("GuaranteeDoc", "Projecten", new { contractid = Model.Contract.Id })" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary"><i class="bx bx-file" aria-hidden="true"></i> Bekijken</a>
											<button type="submit" formnovalidate formaction="@Url.Action("RemoveGuaranteeDoc", "Projecten", new { contractid = Model.Contract.Id, projectid = Model.ProjectId })" class="btn btn-sm btn-outline-danger"><i class="bx bx-trash" aria-hidden="true"></i> Verwijderen</button>
											@if (Model.Contract.GuaranteeDocUploadedAt.HasValue)
											{
												<span class="text-muted small">toegevoegd op @Model.Contract.GuaranteeDocUploadedAt.Value.ToString("dd/MM/yyyy")</span>
											}
										</div>
									}
									<input type="file" name="guaranteeDoc" id="fileGuaranteeDoc" class="form-control form-control-modern" accept=".pdf,.jpg,.jpeg,image/jpeg,application/pdf" />
								</div>
							</div>
							<div class="form-group row pb-3" id="guaranteeDocWarningRow" style="@(Model.Contract.GuaranteeDocumentMissing ? "" : "display:none")">
								<div class="col-lg-8 col-xl-6 offset-lg-4 offset-xl-3">
									<div class="alert alert-warning mb-0 py-2"><i class="bx bx-error-circle me-1" aria-hidden="true"></i> De bankwaarborg is nog niet ontvangen &mdash; voeg het document toe (pdf of jpg).</div>
								</div>
							</div>
							<div class="form-group row align-items-center pb-3">
								<label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0">@Html.LabelFor(m => m.Contract.ContractSigned)</label>
								<div class="col-lg-8 col-xl-6">
									<div class="checkbox-custom checkbox-default">
										@Html.CheckBoxFor(m => m.Contract.ContractSigned, new {id = "chkContractSigned"})
										<label></label>
									</div>
								</div>
							</div>
							<div class="form-group row align-items-center pb-3">
								<label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0">@Html.LabelFor(m => m.Contract.ContractSentDate)</label>
								<div class="col-lg-3 col-xl-2">
									@Html.TextBoxFor(m => m.Contract.ContractSentDate, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control form-control-modern", id = "txtContractSentDate" })
								</div>
								<label class="col-lg-2 col-xl-2 control-label text-lg-end mb-0">@Html.LabelFor(m => m.Contract.ContractSentNote)</label>
								<div class="col-lg-3 col-xl-3">
									@Html.TextBoxFor(m => m.Contract.ContractSentNote, new { @class = "form-control form-control-modern", placeholder = "bv. Bestelbon, per e-mail", maxlength = "200" })
								</div>
							</div>
							<div class="form-group row align-items-center pb-3">
								<label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0">@Html.LabelFor(m => m.Contract.SiteNotification)</label>
								<div class="col-lg-4 col-xl-3">
									<div class="checkbox-custom checkbox-default">
										@Html.CheckBoxFor(m => m.Contract.SiteNotification, new {id = "chkSiteNotification"})
										<label></label>
									</div>
								</div>
								<label class="col-lg-2 col-xl-2 control-label text-lg-end mb-0">@Html.LabelFor(m => m.Contract.VgmCharter)</label>
								<div class="col-lg-2 col-xl-2">
									<div class="checkbox-custom checkbox-default">
										@Html.CheckBoxFor(m => m.Contract.VgmCharter, new {id = "chkVgmCharter"})
										<label></label>
									</div>
								</div>
							</div>
							<div class="form-group row align-items-center pb-3">
								<label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0">@Html.LabelFor(m => m.Contract.PidAttest)</label>
								<div class="col-lg-8 col-xl-6">
									<div class="checkbox-custom checkbox-default">
										@Html.CheckBoxFor(m => m.Contract.PidAttest, new {id = "chkPidAttest"})
										<label></label>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div>
			</section>
		</div>
	</div>
	<div class="row mt-4">
		<div class="col">
			<section class="card card-modern card-big-info">
				<div class="card-body">
					<div class="row">
						<div class="col-lg-2-5 col-xl-1-5">
							<i class="card-big-info-icon bx bx-building-house"></i>
							<h2 class="card-big-info-title">Loten</h2>
							<p class="card-big-info-desc">Selecteer de loten van het contract en voeg deze toe en vul per lot het bedrag van het lot in</p>
						</div>
						<div class="col-lg-3-5 col-xl-4-5">
							<div class="form-group row align-items-center pb-3">
								<label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0">
									Lot toevoegen
								</label>
								<div class="col-lg-8 col-xl-6">
									<div class="d-flex align-items-start gap-2">

										<select id="lstActivities" name="SelectedActivities" multiple
												class="form-control populate select2" data-plugin-selectTwo
												class="gl-flex-input">
												@foreach (var activity in Model.Activities)
												{
													var isDisabled = Model.Contract.Activities.Any(ca => ca.Activity.ID == activity.ID);
													var optionTag = $"<option value=\"{activity.ID}\" {(isDisabled ? "disabled" : "")}>{activity.Display}</option>";
													@Html.Raw(optionTag)
												}
										</select>
										<button type="button" class="btn btn-outline-secondary" id="btnAddActivities">
											Toevoegen
										</button>
									</div>
								</div>
							</div>
							<div class="form-group row align-items-center pb-3">
								<div id="ActivityRows">

								</div>
							
										@foreach (var item in Model.Contract.Activities)
									{
											@await Html.PartialAsync("_ActivityRow", item, new ViewDataDictionary(ViewData) {{ "mode", "add" }})
									}
								
							</div>

						</div>
					</div>
				</div>
			</section>
		</div>
	</div>
	<div class="row action-buttons">
		<div class="col-12 col-md-auto">
			<button type="submit" class="submit-button btn btn-primary btn-px-4 py-3 d-flex align-items-center font-weight-semibold line-height-1" data-loading-text="Laden...">
				<i class="bx bx-save text-4 me-2"></i> Leverancier opslaan
			</button>
		</div>
		<div class="col-12 col-md-auto px-md-0 mt-3 mt-md-0">
			<a href="@TempData.Peek("Referrer")" class="cancel-button btn btn-light btn-px-4 py-3 border font-weight-semibold text-color-dark text-3">Annuleren</a>
		</div>

	</div>
}


@section PageScripts
{
	<script src="~/lib/select2/js/select2.js"></script>
	<script src="~/js/theme.admin.extension.js"></script>
	<script src="~/lib/select2/js/i18n/nl.js"></script>
	<script src="~/lib/dropzone/dropzone.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/autonumeric@4.6.0/dist/autoNumeric.min.js"></script>
	<script src="~/js/currency.js"></script>
	<script>
		// ==============================
		// CurrencyMask helper (ipv AutoNumeric)
		// ==============================
		function initCurrencyMasks(target) {
			// target optioneel: selector, element, NodeList
			if (target) {
				CurrencyMask.init(target);
			} else {
				CurrencyMask.init('.Currencymask');
			}
		}

		$(function () {

			// ==============================
			// ACTIVITEITENLIJST VAN GESELECTEERD BEDRIJF
			// ==============================
			$("#lstActivities").select2({
				theme: 'bootstrap',
				placeholder: 'Selecteer het lot',
				width: '100%',
				dropdownAutoWidth: true,
				data: []
			});

			// ==============================
			// GARANTIE TYPE
			// ==============================
			$('#lstGuaranteeType').on('change', function () {
				var val = $(this).val();
				if (val == 2) {
					$("#Contract_GuaranteePercentage").removeAttr("disabled");
				} else {
					$("#Contract_GuaranteePercentage").attr("disabled", "disabled");
				}
				// Bankwaarborg (3): document-upload tonen; waarschuwing enkel als er nog geen document is
				var isBank = val == 3;
				$('#guaranteeDocRow').toggle(isBank);
				var hasDoc = $('#guaranteeDocRow').find('a[href*="GuaranteeDoc"]').length > 0;
				$('#guaranteeDocWarningRow').toggle(isBank && !hasDoc);
			}).trigger('change');

			// ==============================
			// KORTING CONTANT
			// ==============================
			$('#chkCashDiscount').on('change', function () {
				const isChecked = $(this).prop('checked');
				$('#Contract_CashDiscountPercentage, #txtCashDiscountPaymentTerm')
					.prop('disabled', !isChecked);
			});

			// ==============================
			// INITIËLE CHECK CASH DISCOUNT
			// ==============================
			$('#chkCashDiscount').trigger('change');
		});


				function LoadSiteManagers(companyId, selectSelector) {
					$.ajax({
						type: 'POST',
						url: '@Url.Action("GetCompanyContacts", "Projecten")',
						data: { companyid: companyId },
						dataType: 'json',
						success: function (data) {
							let $select = $(selectSelector);
							const selectedValue = $select.val();
							$select.empty();
							$select.append(new Option('Geen', '', false, false));
							$.each(data, function (i, item) {
								$select.append(new Option(item.text, item.id, false, false));
							});
							if (selectedValue) {
								$select.val(selectedValue);
							}
						},
						error: function (xhr, status, error) {
							console.error('Fout bij ophalen contactpersonen:', error);
						}
					});
				}
		// ==============================
		// ACTIVITEITEN TOEVOEGEN AAN CONTRACT
		// ==============================
		$('#btnAddActivities').click(function () {
			const data = $('#lstActivities').select2('data');

			if (data && data.length > 0) {
				data.forEach(function (item) {
					$.ajax({
						url: '@Url.Action("AddSelectedActivities", "Projecten")',
						data: {
							ActivityId: item.id,
							ActivityName: item.text
						},
						cache: false,
						traditional: true,
						type: 'POST',
						success: function (result) {
							const $row = $(result);
							$('#ActivityRows').append($row);

							// 🔑 CurrencyMask toepassen op nieuwe inputs
							initCurrencyMasks($row.find('.Currencymask'));
						}
					});

					// Optioneel: disable toegevoegde optie
					$("#lstActivities option[value='" + item.id + "']")
						.attr('disabled', 'disabled');
				});

				// Selectie wissen
				$("#lstActivities").val(null).trigger("change");
			}

			return false;
		});

		// ==============================
		// ACTIVITEIT VERWIJDEREN
		// ==============================
		$(document).on('click', 'button.deleterow', function () {
			$(this).closest('div').parent('div').parent('div').remove();
			const activiteitId = $(this).data('id');
			$("#lstActivities option[value='" + activiteitId + "']")
				.removeAttr('disabled');
			return false;
		});

		// ==============================
		// DOCUMENT READY
		// ==============================
		$(document).ready(function () {
			// 🔑 init bestaande bedragen
			initCurrencyMasks();
			LoadSiteManagers($('#txtCompanyID').val(), '#ddlSiteManager');
		});
	</script>

	@await Html.PartialAsync("Partials/_SiteManagerNewModal")
}