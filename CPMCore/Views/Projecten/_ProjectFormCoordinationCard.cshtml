@using BOCore
@using CPMCore.Models.Projecten
@model IProjectFormModel

<section class="gl-form-section">
    <div class="gl-form-section__body">
        <div class="gl-form-section__head">
            <i class="bx bx-briefcase" aria-hidden="true"></i>
            <div>
                <h2 class="gl-form-section__title">Type project</h2>
                <p class="gl-form-section__hint">Eigen ontwikkeling of coördinatie met contract.</p>
            </div>
        </div>

        <div class="gl-switch-row mb-2">
            <div class="switch switch-sm switch-primary">
                @Html.CheckBoxFor(m => m.Project.IsOnlyCoordinationProject, new { data_plugin_ios_switch = "", id = "IsOnlyCoordinationProject" })
            </div>
            <label for="IsOnlyCoordinationProject">Puur coördinatieproject <small class="text-muted">— enkel coördinatie, geen eigen ontwikkeling</small></label>
        </div>
        <div class="gl-switch-row mb-3">
            <div class="switch switch-sm switch-primary">
                @Html.CheckBoxFor(m => m.Project.IsCoordinationProject, new { data_plugin_ios_switch = "", id = "IsCoordinationProject" })
            </div>
            <label for="IsCoordinationProject">Heeft coördinatie <small class="text-muted">— toont de contractgegevens hieronder</small></label>
        </div>

        <div id="coordinationCard" class="gl-coord-grid">
            <div class="gl-coord-card">
                <div class="gl-coord-card__head">
                    <div class="gl-coord-card__head-left">
                        <span class="gl-coord-card__icon"><i class="bx bx-briefcase" aria-hidden="true"></i></span>
                        <div>
                            <h3 class="gl-coord-card__title">Type &amp; vergoeding</h3>
                            <p class="gl-coord-card__subtitle">Coördinatiecontract</p>
                        </div>
                    </div>
                </div>

                <div class="gl-field mb-3">
                    <label for="Project_CoordinationIssuerCompanyId">@Html.DisplayNameFor(m => m.Project.CoordinationIssuerCompanyId)</label>
                    @Html.DropDownListFor(m => m.Project.CoordinationIssuerCompanyId,
                        new SelectList(Model.IssuerCompanies, nameof(ProjectIssuerCompanyOptionVM.Id), nameof(ProjectIssuerCompanyOptionVM.Name), Model.Project.CoordinationIssuerCompanyId),
                        "-- Selecteer facturatiebedrijf --",
                        new { @class = "form-control form-control-modern", id = "Project_CoordinationIssuerCompanyId" })
                </div>
                <div class="gl-field @(Model.Project.ProjectDistanceKm.HasValue ? "mb-3" : "")">
                    <label for="Project_ContractType">@Html.DisplayNameFor(m => m.Project.ContractType)</label>
                    <select asp-for="Project.ContractType"
                            asp-items="Html.GetEnumSelectList<BOCore.CoordinationContractType>()"
                            class="form-control form-control-modern">
                        <option value="">-- Selecteer type --</option>
                    </select>
                </div>
                @if (Model.Project.ProjectDistanceKm.HasValue)
                {
                    <div class="gl-field">
                        <label>Berekende afstand</label>
                        <span class="form-control-plaintext fw-bold">@Model.Project.ProjectDistanceKm?.ToString("0.##") km</span>
                    </div>
                }
            </div>

            <div class="gl-coord-card" id="slicesSection">
                <div class="gl-coord-card__head">
                    <div class="gl-coord-card__head-left">
                        <span class="gl-coord-card__icon"><i class="bx bx-list-ul" aria-hidden="true"></i></span>
                        <div>
                            <h3 class="gl-coord-card__title">Contractschijven</h3>
                            <p class="gl-coord-card__subtitle">Totaal moet exact 100% zijn</p>
                        </div>
                    </div>
                    <button type="button" id="addSlice" class="btn btn-outline-secondary btn-sm">
                        <i class="bx bx-plus" aria-hidden="true"></i> Schijf
                    </button>
                </div>

                <div id="slicesContainer">
                    @for (int i = 0; i < Model.ContractSlices.Count; i++)
                    {
                        <div class="gl-coord-row slice-row">
                            <div class="gl-coord-row__desc">
                                <input type="text" name="ContractSlices[@i].Description"
                                       value="@Model.ContractSlices[i].Description"
                                       class="form-control form-control-modern" placeholder="Omschrijving" aria-label="Omschrijving schijf" />
                            </div>
                            <div class="gl-coord-row__pct">
                                <div class="input-group">
                                    <input type="number" name="ContractSlices[@i].Percentage"
                                           value="@Model.ContractSlices[i].Percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                           class="form-control form-control-modern slice-pct" step="0.01" min="0.01" max="100" placeholder="%" aria-label="Percentage schijf" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                            <button type="button" class="btn btn-outline-danger gl-coord-row__del remove-slice" aria-label="Schijf verwijderen"><i class="bx bx-trash" aria-hidden="true"></i></button>
                        </div>
                    }
                </div>

                <div class="gl-coord-total">
                    <span class="gl-coord-total__label">Totaal</span>
                    <span class="gl-coord-progress"><span class="gl-coord-progress__fill" id="slicesProgressFill"></span></span>
                    <span class="gl-coord-total__pct" aria-live="polite"><span id="slicesTotal">0</span>%</span>
                </div>
                <span id="slicesTotalError" class="text-danger" role="alert" hidden>De schijven moeten samen 100% zijn.</span>
            </div>

            <div class="gl-coord-card" id="regieSection">
                <div class="gl-coord-card__head">
                    <div class="gl-coord-card__head-left">
                        <span class="gl-coord-card__icon"><i class="bx bx-time-five" aria-hidden="true"></i></span>
                        <div>
                            <h3 class="gl-coord-card__title">Uurtarieven (regie)</h3>
                            <p class="gl-coord-card__subtitle">Vergoeding per gepresteerd uur</p>
                        </div>
                    </div>
                    <button type="button" id="addRate" class="btn btn-outline-secondary btn-sm">
                        <i class="bx bx-plus" aria-hidden="true"></i> Tarief
                    </button>
                </div>

                <div id="ratesContainer">
                    @for (int i = 0; i < Model.HourlyRates.Count; i++)
                    {
                        <div class="gl-coord-row rate-row">
                            <div class="gl-coord-row__desc">
                                <select name="HourlyRates[@i].UserId" class="form-control form-control-modern rate-user" aria-label="Persoon">
                                    <option value="">-- Selecteer persoon --</option>
                                    @foreach (var u in Model.AvailableUsers)
                                    {
                                        if (Model.HourlyRates[i].UserId == u.Group)
                                        {
                                            <option value="@u.Group" selected>@u.Display</option>
                                        }
                                        else
                                        {
                                            <option value="@u.Group">@u.Display</option>
                                        }
                                    }
                                </select>
                                <input type="hidden" name="HourlyRates[@i].UserFullName" value="@Model.HourlyRates[i].UserFullName" />
                            </div>
                            <div class="gl-coord-row__pct">
                                <div class="input-group">
                                    <span class="input-group-text">€</span>
                                    <input type="number" name="HourlyRates[@i].HourlyRate"
                                           value="@Model.HourlyRates[i].HourlyRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                           class="form-control form-control-modern" step="0.01" min="0" placeholder="0,00" aria-label="Uurtarief" />
                                </div>
                            </div>
                            <button type="button" class="btn btn-outline-danger gl-coord-row__del remove-rate" aria-label="Tarief verwijderen"><i class="bx bx-trash" aria-hidden="true"></i></button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
