@using CPMCore.Controllers
@using CPMCore.Models.Budget
@using CPMCore.Models.Projecten
@model BudgetResultaatModel
@{
    var ic = System.Globalization.CultureInfo.InvariantCulture;
    decimal totaal = Model.Resultaat.TotaalKosten;
    string Perc(decimal bedrag) => totaal > 0 ? (bedrag / totaal * 100m).ToString("F1", ic) : "0.0";
}

@section PageStyle {
    <link rel="stylesheet" href="~/css/budget-wizard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/projecten-custom.css" asp-append-version="true" />
<style>
    .kosten-tabel td.bedrag { text-align: right; font-weight: 600; min-width: 140px; font-variant-numeric: tabular-nums; }
    .kosten-tabel td.perc   { text-align: right; color: var(--muted, #8590a5); font-size: .85rem; min-width: 70px; font-variant-numeric: tabular-nums; }
    .kosten-groep th {
        background: var(--lightgray, #f8f9fc);
        color: var(--primary, #0a5a3b);
        font-size: .8rem; font-weight: 700;
    }
    .kosten-totaal td {
        background: var(--lightgreen, #e8f0eb);
        color: var(--primary, #0a5a3b);
        font-weight: 700; font-size: 1.05rem;
        border-top: 2px solid var(--border, #e7e7e7);
    }
    .alt-nacalc-balk { height: 10px; border-radius: 999px; }
    .versie-chip { cursor: pointer; transition: background .15s, color .15s; text-decoration: none; }
    .versie-chip:hover { background: var(--primary, #0a5a3b) !important; color: #fff !important; }
</style>
}

<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", Model.ProjectId)
        <div class="inner-body bw-inner-body">

            @* ── Wizard tabbladen ── *@
            @await Html.PartialAsync("Partials/_BudgetWizardTabs", new BudgetWizardTabsModel { VersieId = Model.BudgetVersieId, ActiveStep = 9, ShowCalcToggle = false })

            <div class="bw-scroll">

            <div class="gl-form-section__head bw-step-head">
                <i class="fa-solid fa-chart-column" aria-hidden="true"></i>
                <div>
                    <h2 class="gl-form-section__title">Resultaat</h2>
                    <p class="gl-form-section__hint">Volledige kostprijsberekening voor dit budget.</p>
                </div>
                @await Html.PartialAsync("Partials/_BudgetPageHeader", new BudgetPageHeaderModel
                {
                    StepNum      = 9,
                    MasterNaam   = Model.BudgetNaam,
                    VersieLabel  = Model.VersieLabel,
                    VersieStatus = Model.VersieStatus
                })
            </div>

            @* ── Acties ── *@
            <div class="d-flex gap-2 mb-4 flex-wrap">
                <a href="@Url.Action("BudgetVergelijken", "Projecten", new { masterId = Model.BudgetMasterId })"
                   class="btn btn-outline-primary btn-sm">
                    <i class="fa-solid fa-code-compare me-1"></i> Versies vergelijken
                </a>
                <a href="@Url.Action("DownloadBudgetPDF", "Projecten", new { versieId = Model.BudgetVersieId })"
                   class="btn btn-light border btn-sm" target="_blank">
                    <i class="fa-solid fa-file-pdf me-1"></i> PDF
                </a>
                <a href="@Url.Action("DownloadBudgetExcel", "Projecten", new { versieId = Model.BudgetVersieId })"
                   class="btn btn-light border btn-sm">
                    <i class="fa-solid fa-file-excel me-1"></i> Excel
                </a>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnHerstelVersie"
                        data-versie-id="@Model.BudgetVersieId">
                    <i class="fa-solid fa-copy me-1"></i> Herstel als nieuwe versie
                </button>
            </div>

            @* ── Cijferstrip (gl-kpi2) ── *@
            @{
                var resKpis = new (string Icon, string Lbl, string Val)[]
                {
                    ("fa-euro-sign",       "Totale kostprijs",                          "€ " + Model.Resultaat.TotaalKosten.ToString("N0")),
                    ("fa-house",       $"Per eenheid — {Model.Resultaat.AantalEenheden} eenh.", "€ " + Model.Resultaat.TotaalPerEenheid.ToString("N0")),
                    ("fa-vector-square",       $"Per m² GBA — {Model.Resultaat.TotaalGBA.ToString("N0")} m²", "€ " + Model.Resultaat.TotaalPerM2GBA.ToString("N0")),
                    ("fa-right-left",   "Alt. vs nacalc (bouwkost)",                 "€ " + (Model.TotaalBouwAlternatief - Model.TotaalBouwNacalc).ToString("N0")),
                };
            }
            <div class="gl-kpi2-strip bw-kpi-row mb-4">
                @foreach (var (icon, lbl, val) in resKpis)
                {
                    <div class="gl-kpi2-tile-col">
                        <div class="gl-kpi2-tile" style="--kpi-color: var(--primary);">
                            <div class="gl-kpi2-icon"><i class="fa-solid @icon" aria-hidden="true"></i></div>
                            <div class="gl-kpi2-body">
                                <div class="gl-kpi2-label">@lbl</div>
                                <div class="gl-kpi2-value">@val</div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* ── Alternatief vs Nacalc balk ── *@
            <div class="bw-panel mb-4">
                <div class="row align-items-center g-3">
                        <div class="col-md-auto">
                            <span class="badge bg-primary me-1">Alternatief</span>
                            <strong>€ @Model.TotaalBouwAlternatief.ToString("N0")</strong>
                        </div>
                        <div class="col-md">
                            @{
                                var maxBouw = Math.Max(Model.TotaalBouwAlternatief, Model.TotaalBouwNacalc);
                                var percAlt = maxBouw > 0 ? (Model.TotaalBouwAlternatief / maxBouw * 100m) : 0m;
                                var percNac = maxBouw > 0 ? (Model.TotaalBouwNacalc      / maxBouw * 100m) : 0m;
                            }
                            <div class="mb-1">
                                <div class="alt-nacalc-balk bg-primary"
                                     style="width:@percAlt.ToString("F1", ic)%"></div>
                            </div>
                            <div>
                                <div class="alt-nacalc-balk"
                                     style="width:@percNac.ToString("F1", ic)%;background:var(--custom-accent,#8B6B4A)"></div>
                            </div>
                        </div>
                        <div class="col-md-auto">
                            <span class="badge bg-accent me-1">Nacalc (geïnd.)</span>
                            <strong>€ @Model.TotaalBouwNacalc.ToString("N0")</strong>
                            <span class="text-muted small ms-1">(factor @Model.GewogenFactor.ToString("F4", ic))</span>
                        </div>
                    </div>
            </div>

            @* ── Kostenoverzicht + zijpaneel ── *@
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="bw-section-card">
                        <div class="bw-section-card__header"><span>Kostenoverzicht</span></div>
                        <div class="bw-section-card__body" style="padding:0">
                            <table class="bw-table kosten-tabel mb-0">
                                <thead>
                                    <tr>
                                        <th>Kostenpost</th>
                                        <th class="text-end">Bedrag</th>
                                        <th class="text-end">% v. totaal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @* Bouwkost *@
                                    <tr><th colspan="3" class="kosten-groep"><i class="fa-solid fa-city me-1"></i>Bouwkost (activiteiten)</th></tr>
                                    <tr>
                                        <td class="ps-3">Totaal bouwkost alternatief</td>
                                        <td class="bedrag">€ @Model.Resultaat.TotaalBouw.ToString("N0")</td>
                                        <td class="perc">@Perc(Model.Resultaat.TotaalBouw)%</td>
                                    </tr>

                                    @* Erelonen *@
                                    @if (Model.Resultaat.KostenOpBouw.Any())
                                    {
                                        <tr><th colspan="3" class="kosten-groep"><i class="fa-solid fa-user-check me-1"></i>Erelonen & Studies</th></tr>
                                        @foreach (var k in Model.Resultaat.KostenOpBouw)
                                        {
                                            <tr>
                                                <td class="ps-3">
                                                    @k.Omschrijving
                                                    @if (k.IsPerc)
                                                    {
                                                        <span class="text-muted small ms-1">(@(k.Percentage * 100m).ToString("F2", ic)% van € @k.BasisBedrag.ToString("N0"))</span>
                                                    }
                                                </td>
                                                <td class="bedrag">€ @k.Bedrag.ToString("N0")</td>
                                                <td class="perc">@Perc(k.Bedrag)%</td>
                                            </tr>
                                        }
                                    }

                                    @* Forfaits *@
                                    @if (Model.Resultaat.Forfaits.Any(f => f.Bedrag > 0))
                                    {
                                        <tr><th colspan="3" class="kosten-groep"><i class="fa-solid fa-list-check me-1"></i>Forfaits</th></tr>
                                        @foreach (var k in Model.Resultaat.Forfaits.Where(f => f.Bedrag > 0))
                                        {
                                            <tr>
                                                <td class="ps-3">@k.Omschrijving</td>
                                                <td class="bedrag">€ @k.Bedrag.ToString("N0")</td>
                                                <td class="perc">@Perc(k.Bedrag)%</td>
                                            </tr>
                                        }
                                    }

                                    @* Financiering *@
                                    @if (Model.Resultaat.Financiering.Any(f => f.Bedrag > 0))
                                    {
                                        <tr><th colspan="3" class="kosten-groep"><i class="fa-solid fa-euro-sign me-1"></i>Financiering</th></tr>
                                        @foreach (var k in Model.Resultaat.Financiering.Where(f => f.Bedrag > 0))
                                        {
                                            <tr>
                                                <td class="ps-3">@k.Omschrijving</td>
                                                <td class="bedrag">€ @k.Bedrag.ToString("N0")</td>
                                                <td class="perc">@Perc(k.Bedrag)%</td>
                                            </tr>
                                        }
                                    }

                                    @* Onvoorzien *@
                                    @if (Model.Resultaat.Onvoorzien > 0)
                                    {
                                        <tr><th colspan="3" class="kosten-groep"><i class="fa-solid fa-question me-1"></i>Onvoorzien</th></tr>
                                        <tr>
                                            <td class="ps-3">Onvoorzien</td>
                                            <td class="bedrag">€ @Model.Resultaat.Onvoorzien.ToString("N0")</td>
                                            <td class="perc">@Perc(Model.Resultaat.Onvoorzien)%</td>
                                        </tr>
                                    }

                                    @* Totaal *@
                                    <tr class="kosten-totaal">
                                        <td class="ps-3">TOTALE KOSTPRIJS</td>
                                        <td class="bedrag">€ @Model.Resultaat.TotaalKosten.ToString("N0")</td>
                                        <td class="perc">100%</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                @* Zijpaneel *@
                <div class="col-lg-4">
                    <div class="bw-section-card mb-3">
                        <div class="bw-section-card__header"><span>Per eenheid</span></div>
                        <div class="bw-section-card__body">
                            @{
                                int n = Model.Resultaat.AantalEenheden;
                                string PerE(decimal v) => n > 0 ? "€ " + (v / n).ToString("N0") : "—";
                            }
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="text-muted">Bouwkost</span>
                                <strong>@PerE(Model.Resultaat.TotaalBouw)</strong>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="text-muted">Erelonen & studies</span>
                                <strong>@PerE(Model.Resultaat.KostenOpBouw.Sum(k => k.Bedrag))</strong>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="text-muted">Financiering</span>
                                <strong>@PerE(Model.Resultaat.Financiering.Sum(k => k.Bedrag))</strong>
                            </div>
                            <div class="d-flex justify-content-between py-2 fw-bold fs-5">
                                <span>Totaal / eenheid</span>
                                <span class="text-primary">€ @Model.Resultaat.TotaalPerEenheid.ToString("N0")</span>
                            </div>
                        </div>
                    </div>

                    @if (Model.AndereVersies.Any())
                    {
                        <div class="bw-section-card">
                            <div class="bw-section-card__header"><span>Andere versies</span></div>
                            <div class="bw-section-card__body">
                                @foreach (var v in Model.AndereVersies)
                                {
                                    <a href="@Url.Action("BudgetResultaat", "Projecten", new { versieId = v.Id })"
                                       class="bw-chip bw-chip--other versie-chip me-1 mb-1">
                                        v@v.Versienummer — @v.VersieNaam
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* ── Onderaan navigeren ── *@
            </div>
            <div class="bw-bottom-nav">
                <a href="@Url.Action("BudgetVerkoop", "Projecten", new { versieId = Model.BudgetVersieId })"
                   class="bw-bottom-nav__back">
                    <i class="fas fa-chevron-left me-1"></i>Vorige: Verkoop
                </a>
                <span class="bw-bottom-nav__indicator">Stap 9 van 9 — Resultaat · afgerond</span>
                <a href="@Url.Action("BudgetIndex", "Projecten", new { projectId = Model.ProjectId })" class="bw-bottom-nav__next">
                    Naar het overzicht <i class="fas fa-chevron-right ms-1"></i>
                </a>
            </div>

            @await Html.PartialAsync("Partials/_BudgetConfirmModal")

        </div>
    </div>
</section>

@section PageScripts {
<script src="~/js/budget-wizard.js" asp-append-version="true"></script>
<script>
    $('#btnHerstelVersie').on('click', async function () {
        const versieId = $(this).data('versie-id');
        if (!await BudgetWizard.confirmModal({
            title: 'Nieuwe versie aanmaken',
            body: 'Een nieuwe budgetversie aanmaken op basis van versie @Model.Versienummer?',
            okLabel: 'Nieuwe versie',
            okClass: 'btn-primary'
        })) return;
        const btn = $(this).prop('disabled', true).html('<i class="fa-solid fa-circle-notch fa-spin me-1"></i> Bezig...');
        $.post('@Url.Action("HerstelVersie", "Projecten")',
            {
                versieId: versieId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            function (res) {
                if (res.success) {
                    if (typeof toastr !== 'undefined') toastr.success('Versie ' + res.versienummer + ' aangemaakt.');
                    setTimeout(function () {
                        window.location.href = '@Url.Action("BudgetResultaat", "Projecten")?versieId=' + res.nieuweVersieId;
                    }, 800);
                } else {
                    if (typeof toastr !== 'undefined') toastr.error(res.message);
                    else alert(res.message);
                    $('#btnHerstelVersie').prop('disabled', false).html('<i class="fa-solid fa-copy me-1"></i> Herstel als nieuwe versie');
                }
            }
        );
    });
</script>
}
