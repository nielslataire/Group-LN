@model BOCore.Budget.BudgetActivityLijnBO
@*
    gl-v2 — Budgetflow stap 6, één activiteit (design-handoff 39g): € basis · referentie (nacalc) · verschil · correctie-% · gecorrigeerd.
    Grote afwijkingen (> 25 %) kleuren; de knop "referentie overnemen" zet de correctie zo dat gecorrigeerd = referentie.
    data-ref = geïndexeerde referentieprijs per eenheid (wordt als nacalc bewaard), data-ref-totaal = × aantal eenheden.
*@
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var nl = new System.Globalization.CultureInfo("nl-BE");
    string Eur(decimal v) => "€ " + v.ToString("N2", nl);
    var basis = Model.TotaalAlternatief;
    var corr = Model.Correctiefactor < 0 ? 1m : Model.Correctiefactor;
    var refTotaal = Model.ReferentieTotaal;
    var toonRef = ViewData["HeeftReferenties"] is true;
    var afw = Model.ReferentieVerschilPerc;
    var groot = afw.HasValue && Math.Abs(afw.Value) > 0.25m;
    var chrome = ViewData["Chrome"] as CPMCore.Models.Budget.BudgetWizardChromeVm;   // 39k
    var rijMld = chrome?.Voor(6).FirstOrDefault(m => m.Sleutel == Model.ActivityId.ToString() && m.Plaats == "rij" && !m.Genegeerd);
    var corrMld = chrome?.Voor(6).FirstOrDefault(m => m.Sleutel == Model.ActivityId.ToString() && m.Plaats == "veld" && !m.Genegeerd);
    var corrAlle = chrome?.Voor(6).FirstOrDefault(m => m.Sleutel == Model.ActivityId.ToString() && m.Plaats == "veld");   // ook een genegeerde: dan geen waarschuwingsstaat
    var nulRij = rijMld?.Type == ServiceCore.Budget.MeldingType.Info;
    var toonOpm = corrMld != null || !string.IsNullOrWhiteSpace(Model.Opmerking) || corr != 1m;
    var refTitel = Model.HeeftReferentie
        ? $"{Model.ReferentieAantalProjecten} referentieproject(en) · € {Model.ReferentiePrijsPerEenheid!.Value.ToString("N0", nl)}/eenheid"
          + (Model.ReferentieMinPerEenheid.HasValue && Model.ReferentieAantalProjecten > 1 ? $" (van € {Model.ReferentieMinPerEenheid.Value.ToString("N0", nl)} tot € {(Model.ReferentieMaxPerEenheid ?? 0m).ToString("N0", nl)})" : "")
          + (Model.ReferentiePrijsPerM2.HasValue ? $" · € {Model.ReferentiePrijsPerM2.Value.ToString("N0", nl)}/m² GBA" : "")
        : "Geen referentieproject met een bedrag voor deze activiteit";
}
<tr class="bw-act-rij @(groot ? "is-groot" : "") @(rijMld?.Type == ServiceCore.Budget.MeldingType.Waarschuwing ? "is-warn" : nulRij ? "is-info-rij" : "")" data-activity-id="@Model.ActivityId" data-basis="@basis.ToString(inv)" data-prijs="@Model.AlternatievePrijsPerEenheid.ToString(inv)"
    data-nacalc="@Model.NacalcPrijsPerEenheid.ToString(inv)" data-ref="@((Model.ReferentiePrijsPerEenheid ?? 0m).ToString(inv))" data-ref-totaal="@((refTotaal ?? 0m).ToString(inv))" data-manueel="@Model.IsManueel.ToString().ToLowerInvariant()">
    <td class="bw-act-naam">
        @Model.ActivityOmschrijving @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwRijIcoon.cshtml", rijMld)
        @if (Model.HeeftVoorstel)
        {
            <span class="gl-v2-bw-calc gl-v2-bw-hint is-inline" title="Voorstel: € @((Model.VoorgesteldePrijsPerEenheid ?? 0m).ToString("N2", nl))/eenheid">· voorstel € @((Model.VoorgesteldePrijsPerEenheid ?? 0m).ToString("N0", nl))/eenh.</span>
        }
    </td>
    <td class="is-num is-muted">@Eur(basis)</td>
    @if (toonRef)
    {
        <td class="is-num bw-act-ref" title="@refTitel">
            @if (Model.HeeftReferentie) { <span>@Eur(refTotaal!.Value)</span><span class="bw-act-n">@Model.ReferentieAantalProjecten</span> } else { <span class="is-muted">—</span> }
        </td>
        <td class="is-num bw-act-verschil">
            @if (Model.HeeftReferentie)
            {
                <span class="bw-act-delta"></span>
                <button type="button" class="gl-v2-row-action bw-act-overnemen" data-bw-edit title="Correctie zetten zodat het gecorrigeerde bedrag gelijk is aan de referentie" aria-label="Referentie overnemen"><i class="ph ph-arrow-line-right" aria-hidden="true"></i><span class="gl-v2-row-action-label">Referentie overnemen</span></button>
            }
        </td>
    }
    <td class="is-num">
        <div class="gl-v2-field gl-v2-field-bare"><div class="gl-v2-field-box@(corr != 1m ? " is-gecorrigeerd" : "")" style="width:96px;margin-left:auto"><input type="text" inputmode="decimal" class="gl-v2-field-input is-num is-tabular corr-pct" value="@((corr * 100m).ToString("0.####", nl))" placeholder="100" autocomplete="off" aria-label="Correctie in procent" /><span class="gl-v2-field-unit">%</span></div></div>
    </td>
    <td class="is-num is-strong bw-act-gecorrigeerd">@Eur(basis * corr)</td>
</tr>
@if (Model.FormuleDelen is { Count: > 0 })
{
    @* 39g "Toon berekeningen": de berekening van het voorstel als strook onder de activiteit (chips + operatoren, bron, link naar de formule) *@
    <tr class="bw-act-formule">
        <td colspan="@(toonRef ? 6 : 4)">
            <div class="bw-fm">
                <div class="bw-fm-delen">
                    @foreach (var d in Model.FormuleDelen)
                    {
                        if (d.Soort == "op") { <span class="bw-fm-op">@d.Tekst</span> }
                        else if (d.Soort == "totaal") { <span class="bw-fm-tot">@d.Tekst</span> }
                        else { <span class="bw-fm-chip" title="@d.Titel">@if (!string.IsNullOrEmpty(d.Label)) { <span class="l">@d.Label</span> }<span class="v">@d.Tekst@(string.IsNullOrEmpty(d.Eenheid) ? "" : " " + d.Eenheid)</span></span> }
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.FormuleBron)) { <span class="bw-fm-bron">bron: @Model.FormuleBron</span> }
                @if (Model.FormuleViaDb) { <a class="bw-fm-link" href="@Url.Action("BudgetFormules", "Instellingen")" target="_blank" rel="noopener" data-bw-plain>Formule <i class="ph ph-caret-right" aria-hidden="true"></i></a> }
            </div>
        </td>
    </tr>
}
@* Reden van de correctie (design-handoff 39g): bij een correctie ≠ 100 % een goudkleurig kader met de reden (door wie en wanneer), of — zolang er geen reden is — een invoerveld.
   Het script (BudgetActivityLijnenV2.cshtml) toont/verbergt de twee toestanden; de reden staat in het interne budget (PDF intern). *@
<tr class="bw-act-reden-rij" data-for="@Model.ActivityId" data-genegeerd="@(corrAlle?.Genegeerd == true ? "1" : "0")" data-melding="@(corrMld?.Tekst ?? "Correctie ≠ 100 % zonder reden.")" data-orig="@Model.Opmerking" data-door="@Model.OpmerkingDoor" data-op="@(Model.OpmerkingOp.HasValue ? DateTime.SpecifyKind(Model.OpmerkingOp.Value, DateTimeKind.Utc).ToString("o") : "")" @(corr != 1m ? "" : "hidden")>
    <td colspan="@(toonRef ? 6 : 4)">
        <div class="bw-reden-kader" hidden>
            <span class="bw-reden-badge">Correctie</span>
            <div class="bw-reden-tekst"><span class="bw-reden-t"></span><span class="bw-reden-m"></span></div>
            <button type="button" class="bw-reden-edit" data-bw-edit title="Reden aanpassen" aria-label="Reden aanpassen"><i class="ph ph-pencil-simple" aria-hidden="true"></i></button>
        </div>
        <div class="bw-reden-editor" hidden>
            <div class="bw-reden-veld"><span class="bw-reden-pill">Correctie</span><input type="text" class="act-opm" maxlength="200" value="@Model.Opmerking" placeholder="Reden (optioneel) — bv. meer door vergelijking, prijsstijging leverancier…" aria-label="Reden van de correctie" /></div>
            <span class="bw-reden-hint"><i class="ph ph-warning" aria-hidden="true"></i><span class="bw-reden-hint-t">Optioneel — leeg laten mag; een ingevulde reden verschijnt als goudkleurig kader en staat in het interne budget</span></span>
        </div>
    </td>
</tr>
