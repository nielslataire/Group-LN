@model CPMCore.Models.Budget.BudgetVerkoopModel
@using CPMCore.Models.Budget
@using CPMCore.Models.GlV2
@using DALCore.Models
@*
    gl-v2 — Budgetflow stap 8 · Verkoop (design-handoff 39o, vereenvoudigd t.o.v. 39i): één samenvattingsbalk (kostprijs · minimum · vraagprijzen · marktwaarde · eenheden onder het
    minimum), de prijscodes als chips (groen = in gebruik; Code toevoegen, Beheren = de algemene codes in Instellingen), per eenheid een tabel met de code-keuze inline
    (grondcode · bouwcode), min. prijs, markt en vraagprijs met zijn bron (voorstel · markt · code · eigen); details enkel in de open rij (grond, bouw, uitzonderingen,
    vraagprijs volgt) en een bulkbalk bij selectie. Rekenregels en opslaan zoals voorheen (VerkoopLijnRekenregel in JS én C#, SaveBudgetVerkoop, autosave).
    Een vraagprijs onder het minimum is een WAARSCHUWING (goud, mag verder): "Op minimum zetten" of "Zo laten" (onthouden via Negeren, code onder-minimum-<eenheid>).
*@
@{
    var ch = (BudgetWizardChromeVm)ViewData["Chrome"];
    ViewData["Title"] = ch.StepTitle;
    ViewData["PageIcon"] = "ph ph-tag";
    ViewData["GlV2FullHeightBody"] = true;
    ViewData["BackUrl"] = ch.OverviewUrl;
    var nl = new System.Globalization.CultureInfo("nl-BE");
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var nlp = (System.Globalization.CultureInfo)nl.Clone(); nlp.NumberFormat.NumberGroupSeparator = ".";   // € 1.139.292 zoals het script en het design
    string Eur0(decimal v) => "€ " + v.ToString("N0", nlp);
    string Pct(decimal f) => (f * 100m).ToString("0.#", nl) + " %";
    string PctS(decimal f) => (f >= 0 ? "+" : "−") + Math.Abs(f * 100m).ToString("0.#", nl) + " %";
    string F0(decimal? v) => v.HasValue ? Math.Round(v.Value, 0).ToString("F0", nl) : "";
    var vs = Model.Voorstel;
    var markt = vs?.Markt;
    var lijnenOpNaam = Model.Lijnen.GroupBy(l => (l.EenheidNaam ?? "").Trim(), StringComparer.OrdinalIgnoreCase).ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
    var eenheden = (vs?.Eenheden ?? new List<BOCore.Budget.BudgetVerkoopVoorstelEenheidBO>()).ToList();
    var losseLijnen = Model.Lijnen.Where(l => !eenheden.Any(e => string.Equals(e.EenheidNaam?.Trim(), (l.EenheidNaam ?? "").Trim(), StringComparison.OrdinalIgnoreCase))).ToList();
    string OnderSleutel(string naam) => "onder-minimum-" + (naam ?? "").Trim().Replace("~", "-");
    bool Genegeerd(string naam) => ch.Voor(8).Any(m => m.Code == OnderSleutel(naam) && m.Genegeerd);
    var onderMin = eenheden.Where(e => lijnenOpNaam.TryGetValue(e.EenheidNaam?.Trim() ?? "", out var l) && l.Vraagprijs is > 0m && l.Vraagprijs < Math.Round(e.MinimumVerkoopprijs, 0) && !Genegeerd(e.EenheidNaam)).ToList();
    string RefTitel(BudgetPrijsReferentie r) => string.Join(" · ", new[] { r.Omschrijving, r.Datum?.ToString("dd/MM/yyyy"), r.Bron, r.ProjectId.HasValue ? "projectcode" : null }.Where(s => !string.IsNullOrWhiteSpace(s)));
    List<GlV2SelectItem> RefItems(List<BudgetPrijsReferentie> refs) => refs.Select(r => new GlV2SelectItem { Value = r.Code.ToString(), Text = $"{(r.PrijsType == "Grond" ? "G" : "B")}-{r.Code:00} € {r.PrijsPerM2.ToString("N0", nlp)}/m²" + (r.ProjectId.HasValue ? " ·P" : ""), Sub = RefTitel(r) }).ToList();
    var refBouwItems = RefItems(Model.PrijsReferentiesBouw); var refGrondItems = RefItems(Model.PrijsReferentiesGrond);
    var unitItems = Model.UnitOptions.Where(o => !string.IsNullOrEmpty(o.Value)).Select(o => new GlV2SelectItem { Value = o.Value, Text = o.Text }).ToList();
    var refPrijzen = System.Text.Json.JsonSerializer.Serialize(new { bouw = Model.PrijsReferentiesBouw.ToDictionary(r => r.Code.ToString(), r => r.PrijsPerM2), grond = Model.PrijsReferentiesGrond.ToDictionary(r => r.Code.ToString(), r => r.PrijsPerM2) });
    var gebruiktBouw = Model.Lijnen.Where(l => l.CodeBouw.HasValue).Select(l => l.CodeBouw.Value).ToHashSet();
    var gebruiktGrond = Model.Lijnen.Where(l => l.CodeGrond.HasValue).Select(l => l.CodeGrond.Value).ToHashSet();
    var heeftMarkt = vs?.MarktTotaal.HasValue == true;
    var negeerUrl = Url.Action("BudgetWaarschuwingBevestigen", "Projecten");
    int rij = 0;
}
@section PageStyle
{
    <link rel="stylesheet" href="~/css/gl-v2-project-inner-menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-budget.css" asp-append-version="true" />
}
@section ProjectMenu
{
    @await Html.PartialAsync("GlV2/_ProjectInnerMenuV2", ch.Menu)
}
@{ var menuPhone = new GlV2ProjectMenuVm { ProjectId = ch.Menu.ProjectId, ProjectName = ch.Menu.ProjectName, ProjectSubtitle = ch.Menu.ProjectSubtitle, Mode = GlV2ProjectMenuMode.Phone }; }
@await Html.PartialAsync("GlV2/_ProjectInnerMenuV2", menuPhone)
@section PageTitleBadges
{
    <span class="gl-v2-badge @(ch.IsLocked ? "is-blocked" : "is-neutral")">@ch.BadgeTekst</span>
}

<div class="gl-v2-bw bw-vp @(ch.IsLocked ? "is-locked" : "")" id="bw-vk" data-versie="@Model.BudgetVersieId" data-url-save="@Url.Action("SaveBudgetVerkoop", "Projecten")" data-url-doorzetten="@Url.Action("DoorzettenVerkoopNaarUnits", "Projecten")" data-url-negeer="@negeerUrl">
    @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwStappen.cshtml", ch)

    <div class="gl-v2-bw-scroll">
        @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwKaders.cshtml", ch)

        @* ── Verkoopvoorstel: één samenvattingsbalk ── *@
        @if (vs is not null)
        {
            <section class="gl-v2-section-card bw-vp-voorstel">
                <div class="gl-v2-section-card-header">
                    <span class="gl-v2-section-card-icon"><i class="ph ph-tag" aria-hidden="true"></i></span>
                    <h2 class="gl-v2-section-card-title">Verkoopvoorstel</h2>
                    <span class="gl-v2-field-divider"></span>
                    <span class="gl-v2-section-card-desc">kostprijs + marge = minimum · vergeleken met de vraagprijzen hieronder</span>
                    <span class="gl-v2-section-card-meta" style="margin-left:auto">
                        <a href="@Url.Action("BudgetParams", "Projecten", new { versieId = Model.BudgetVersieId })" class="gl-v2-btn gl-v2-btn-text" data-bw-nav="back"><i class="ph ph-sliders-horizontal" aria-hidden="true"></i>Marges</a>
                    </span>
                </div>
                <div class="bw-vp-kpis">
                    <div class="bw-vp-kpi"><span class="l">Kostprijs incl. grond</span><span class="v">@Eur0(vs.TotaalKostprijs)</span><span class="s">@vs.AantalEenheden eenhe@(vs.AantalEenheden == 1 ? "id" : "den")</span></div>
                    <div class="bw-vp-kpi"><span class="l">Min. verkoopwaarde</span><span class="v">@Eur0(vs.TotaalVerkoopwaarde)</span><span class="s">marge @Pct(vs.MargePerc) · @Eur0(vs.MargeBedrag)</span></div>
                    <div class="bw-vp-kpi" id="bw-vp-kpi-vraag" data-minimum="@vs.TotaalVerkoopwaarde.ToString("F0", inv)"><span class="l">Vraagprijzen</span><span class="v" id="bw-vp-sum">—</span><span class="s" id="bw-vp-sum-sub">nog geen vraagprijzen</span></div>
                    @if (heeftMarkt)
                    {
                        var d = vs.MinimumTotaalMetMarkt is > 0 ? (vs.MarktTotaal.Value - vs.MinimumTotaalMetMarkt.Value) / vs.MinimumTotaalMetMarkt.Value : (decimal?)null;
                        <div class="bw-vp-kpi"><span class="l">Marktwaarde</span><span class="v">@Eur0(vs.MarktTotaal.Value)</span><span class="s">@(d.HasValue ? PctS(d.Value) + " · " : "")mediaan @vs.AantalEenhedenMetMarkt/@vs.AantalEenheden eenh.</span></div>
                    }
                    <div class="bw-vp-kpi bw-vp-kpi--alert" id="bw-vp-alert" @(onderMin.Any() ? "" : "hidden")><i class="ph ph-warning" aria-hidden="true"></i><span class="v" id="bw-vp-alert-t">@onderMin.Count eenhe@(onderMin.Count == 1 ? "id" : "den") onder minimum</span><span class="s" id="bw-vp-alert-s"></span></div>
                </div>
                @foreach (var w in vs.Waarschuwingen)
                {
                    <div class="gl-v2-notice gl-v2-notice-compact is-warning bw-vp-notice"><i class="ph ph-warning" aria-hidden="true"></i><span>@w @if (w.Contains("grond", StringComparison.OrdinalIgnoreCase)) { <a href="@Url.Action("BudgetParams", "Projecten", new { versieId = Model.BudgetVersieId })" data-bw-nav="back" style="color:inherit;font-weight:600">Naar stap 7</a> }</span></div>
                }
                @if (markt is not null && markt.HeeftData)
                {
                    <div class="bw-vp-markt"><i class="ph ph-map-pin" aria-hidden="true"></i><span><strong>Markt @markt.GemeenteNaam</strong> · @markt.PeriodeMaanden m.: @markt.AantalTeKoop te koop, @markt.VerkochtInPeriode verkocht · mediaan @(markt.MediaanPrijsPerM2TeKoop.HasValue ? Eur0(markt.MediaanPrijsPerM2TeKoop.Value) : "—")/m² te koop, @(markt.MediaanPrijsPerM2Verkocht.HasValue ? Eur0(markt.MediaanPrijsPerM2Verkocht.Value) : "—") verkocht · @(markt.MediaanDoorlooptijdDagen?.ToString() ?? "—") dagen@(markt.EigenVerkopen > 0 ? $" · eigen verkopen in {markt.Postcode}: {markt.EigenVerkopen}, mediaan {(markt.MediaanPrijsPerM2EigenVerkoop.HasValue ? Eur0(markt.MediaanPrijsPerM2EigenVerkoop.Value) : "—")}/m²" : "")</span><a href="@Url.Action("Gemeenteanalyse", "Marktanalyse", new { geoMunicipalityId = markt.GeoMunicipalityId, aanbod = "Alles" })" target="_blank" data-bw-plain>Gemeenteanalyse</a></div>
                }
            </section>
        }

        @* ── Prijscodes als chips ── *@
        <section class="gl-v2-section-card bw-vp-codes">
            <div class="bw-vp-codes-rij">
                <span class="bw-vp-codes-lbl">PRIJSCODES</span>
                @foreach (var (type, titel, refs, letter, gebruikt) in new[] { ("Bouw", "Bouw €/m² gered.", Model.PrijsReferentiesBouw, "B", gebruiktBouw), ("Grond", "Grond €/m²", Model.PrijsReferentiesGrond, "G", gebruiktGrond) })
                {
                    <span class="bw-vp-codes-groep">
                        <span class="bw-vp-codes-t">@titel</span>
                        @if (!refs.Any()) { <span class="bw-vp-hint">nog geen codes</span> }
                        @foreach (var r in refs)
                        {
                            <span class="bw-vp-code @(gebruikt.Contains(r.Code) ? "is-gebruik" : "")" title="@RefTitel(r)@(gebruikt.Contains(r.Code) ? " · in gebruik" : "")">
                                <b>@letter-@r.Code.ToString("00")</b> € @r.PrijsPerM2.ToString("N0", nlp)@(r.ProjectId.HasValue ? " ·P" : "")
                                @if (r.ProjectId.HasValue)
                                {
                                    <form method="post" asp-action="BudgetPrijsReferentieVerwijderen" asp-controller="Projecten" data-bw-bevestig="Projectcode @($"{letter}-{r.Code:00}") verwijderen?" data-bw-desc="De code verdwijnt uit de lijst van dit project. Een code die in een verkooplijn gebruikt wordt, kan je enkel archiveren." data-bw-ok="Verwijderen">
                                        @Html.AntiForgeryToken()<input type="hidden" name="versieId" value="@Model.BudgetVersieId" /><input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="bw-vp-code-x" data-bw-edit title="Projectcode verwijderen" aria-label="Projectcode @letter-@r.Code.ToString("00") verwijderen"><i class="ph ph-x" aria-hidden="true"></i></button>
                                    </form>
                                }
                            </span>
                        }
                    </span>
                    @if (type == "Bouw") { <span class="bw-vp-codes-sep" aria-hidden="true"></span> }
                }
                <span class="bw-vp-hint">groen = in gebruik · ·P = projectcode</span>
                <span class="bw-vp-codes-acties">
                    <button type="button" class="gl-v2-btn gl-v2-btn-secondary" data-bs-toggle="modal" data-bs-target="#bw-vp-code-modal" data-bw-edit><i class="ph ph-plus" aria-hidden="true"></i>Code toevoegen</button>
                    <a href="@Url.Action("BudgetPrijsReferenties", "Instellingen", new { tab = "Bouw" })" class="gl-v2-btn gl-v2-btn-text" target="_blank" rel="noopener" data-bw-plain title="De algemene prijscodes beheer je in Instellingen"><i class="ph ph-pencil-simple" aria-hidden="true"></i>Beheren</a>
                </span>
            </div>
        </section>

        @* ── Per eenheid ── *@
        <section class="gl-v2-section-card bw-vp-eenheden">
            <div class="gl-v2-section-card-header">
                <span class="gl-v2-section-card-icon"><i class="ph ph-house" aria-hidden="true"></i></span>
                <h2 class="gl-v2-section-card-title">Per eenheid</h2>
                <span class="gl-v2-field-divider"></span>
                <span class="gl-v2-section-card-desc" id="bw-vp-desc">per eenheid een code kiezen óf zelf €/m² of bedrag invullen; open een rij voor de berekening</span>
                <span class="gl-v2-section-card-meta" style="margin-left:auto;gap:8px">
                    @if (vs?.HeeftEenheden == true)
                    {
                        <button type="button" class="gl-v2-btn gl-v2-btn-secondary" id="bw-vp-alles-voorstel" data-bw-edit title="Zet grond- en bouwwaarde uit het voorstel in elke eenheid"><i class="ph ph-check" aria-hidden="true"></i>Alles: vraagprijs = voorstel</button>
                    }
                    <button type="button" class="gl-v2-btn gl-v2-btn-text" id="bw-vp-doorzetten" data-bw-edit title="Slaat op en schrijft grond-/bouwwaarde naar de gekoppelde Units (verkochte units worden overgeslagen)"><i class="ph ph-caret-right" aria-hidden="true"></i>Doorzetten naar units</button>
                </span>
            </div>

            @* Bulkbalk: verschijnt zodra er eenheden geselecteerd zijn *@
            <div class="bw-vp-bulk" id="bw-vp-bulk" hidden>
                <b id="bw-vp-bulk-n">0 geselecteerd</b>
                <span class="bw-vp-bulk-sep" aria-hidden="true"></span>
                @await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm { Name = "bulk-grond", Id = "bw-vp-bulk-grond", Bare = true, Placeholder = "Grondcode", Value = "", Items = refGrondItems })
                @await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm { Name = "bulk-bouw", Id = "bw-vp-bulk-bouw", Bare = true, Placeholder = "Bouwcode", Value = "", Items = refBouwItems })
                <button type="button" class="bw-vp-bulk-knop" id="bw-vp-bulk-voorstel" data-bw-edit>Vraagprijs = voorstel</button>
                @if (heeftMarkt) { <button type="button" class="bw-vp-bulk-knop" id="bw-vp-bulk-markt" data-bw-edit>Vraagprijs = markt</button> }
                <span class="bw-vp-bulk-uitleg">past alleen de selectie aan</span>
                <button type="button" class="bw-vp-bulk-x" id="bw-vp-bulk-sluit" aria-label="Selectie wissen"><i class="ph ph-x" aria-hidden="true"></i></button>
            </div>

            <div class="gl-v2-bw-table-wrap">
                <table class="bw-vp-tabel" id="bw-vp-tabel" data-agr-ratio="@((vs?.AgrarischGewicht ?? 0.20m).ToString(inv))" data-refprijzen='@Html.Raw(refPrijzen)'>
                    <colgroup><col style="width:44px" /><col /><col style="width:21%" /><col style="width:21%" /><col style="width:118px" /><col style="width:118px" /><col style="width:170px" /></colgroup>
                    <thead>
                        <tr>
                            <th><input type="checkbox" id="bw-vp-selall" class="bw-vp-check" aria-label="Alle eenheden selecteren" data-bw-edit /></th>
                            <th>Eenheid</th><th>Grondcode · waarde</th><th>Bouwcode · waarde</th>
                            <th class="is-num" title="Kostprijs + marge (grond- en bouwwaarde)">Min. prijs</th>
                            <th class="is-num" title="Mediaan €/m² van vergelijkbare units × bewoonbare oppervlakte">Markt</th>
                            <th class="is-num">Vraagprijs</th>
                        </tr>
                    </thead>
                    <tbody id="bw-vp-body">
                        @foreach (var e in eenheden)
                        {
                            lijnenOpNaam.TryGetValue(e.EenheidNaam?.Trim() ?? "", out var l);
                            var naam = e.EenheidNaam ?? "";
                            var min = Math.Round(e.MinimumVerkoopprijs, 0);
                            rij++;
                            var rijMld = l == null ? null : ch.Voor(8).Where(m => m.Sleutel == l.Id.ToString() && !m.Genegeerd && m.Plaats == "rij").OrderByDescending(m => (int)m.Type).FirstOrDefault();
                            var labels = l == null ? new List<ServiceCore.Budget.BudgetMelding>() : ch.Voor(8).Where(m => m.Sleutel == l.Id.ToString() && m.Plaats == "label" && !m.Genegeerd).ToList();
                            var grondTxt = (e.Grondopp > 0 ? e.Grondopp.ToString("N0", nl) : "0") + (e.GrondoppAgrarisch > 0 ? " + " + e.GrondoppAgrarisch.ToString("N0", nl) : "");
                            <tr class="bw-vp-rij @(rijMld != null ? "is-warn" : "")" data-naam="@naam" data-sleutel="@OnderSleutel(naam)" data-genegeerd="@(Genegeerd(naam) ? "1" : "0")" data-info="1" data-gered="@e.OppGereduceerd.ToString(inv)" data-grondopp="@e.Grondopp.ToString(inv)" data-grondopp2="@e.GrondoppAgrarisch.ToString(inv)" data-min="@min.ToString(inv)" data-kost="@Math.Round(e.Kostprijs, 0).ToString(inv)" data-marge="@vs.DoelMargePerc.ToString(inv)" data-vgrond="@Math.Round(e.Grondwaarde, 0).ToString(inv)" data-vbouw="@Math.Round(e.Bouwwaarde, 0).ToString(inv)" data-markt="@(e.MarktPrijs?.ToString(inv) ?? "")" data-marktaantal="@e.MarktAantal" data-markt-m2="@(e.MarktMediaanPerM2?.ToString(inv) ?? "")" data-bron="@(l?.PrijsBron?.ToString() ?? "")">
                                <td><input type="checkbox" class="bw-vp-check bw-vp-sel" aria-label="@naam selecteren" data-bw-edit /></td>
                                <td class="bw-vp-naam">
                                    <button type="button" class="bw-vp-toggle" aria-expanded="false" title="Berekening openen" aria-label="Details @naam"><i class="ph ph-caret-right" aria-hidden="true"></i></button>
                                    <span class="bw-vp-naamtekst">
                                        <b>@naam</b> @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwRijIcoon.cshtml", rijMld)@foreach (var lb in labels) { <span class="bw-vk-label" title="@lb.Tekst"><i class="ph ph-clock-counter-clockwise" aria-hidden="true"></i>@lb.Tekst</span> }
                                        <span class="bw-vp-sub">@e.BewoonbareOpp.ToString("N0", nlp) m² bew. · @(e.OppGereduceerd > 0 ? e.OppGereduceerd.ToString("N1", nl) + " m² gered." : "geen gered. opp.") · grond @grondTxt</span>
                                    </span>
                                </td>
                                @foreach (var (kant, items, code) in new[] { ("grond", refGrondItems, l?.CodeGrond), ("bouw", refBouwItems, l?.CodeBouw) })
                                {
                                    <td class="bw-vp-zijde" data-zijde="@kant">
                                        <div class="bw-vp-codevak">@await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm { Name = "code-" + kant + "-" + rij, Id = "bw-vp-c" + kant[0] + "-" + rij, Bare = true, Placeholder = "Kies code", EmptyText = "Eigen waarde", Value = code?.ToString() ?? "", Items = items })</div>
                                        <div class="bw-vp-eigenvak"><button type="button" class="bw-vp-chip" data-bw-edit title="Terug naar een prijscode">EIGEN</button><span class="gl-v2-field-prefix">€</span><input type="text" inputmode="numeric" class="bw-vp-bedrag" data-veld="@(kant == "grond" ? "grondwaarde" : "bouwwaarde")" value="@(kant == "grond" ? F0(l?.Grondwaarde) : F0(l?.Bouwwaarde))" placeholder="0" aria-label="@(kant == "grond" ? "Grondwaarde" : "Bouwwaarde") @naam" data-bw-edit /></div>
                                        <span class="bw-vp-subw"></span>
                                    </td>
                                }
                                <td class="is-num bw-vp-min"><b>@Eur0(min)</b><small>kost @Eur0(e.Kostprijs)</small></td>
                                <td class="is-num bw-vp-mk" title="@(e.MarktAantal > 0 ? e.MarktVergelijking + ", basis: " + e.MarktBasis : "Te weinig vergelijkbare units")">@(e.MarktPrijs.HasValue ? Eur0(e.MarktPrijs.Value) : "—")@if (e.MarktVerschilPerc.HasValue) { <small class="@(e.MarktVerschilPerc.Value >= 0 ? "is-hoger" : "is-lager")">@PctS(e.MarktVerschilPerc.Value)</small> }</td>
                                <td class="is-num bw-vp-vp">
                                    <div class="bw-vp-vp-rij">
                                        <div class="gl-v2-field gl-v2-field-bare"><div class="gl-v2-field-box"><span class="gl-v2-field-prefix">€</span><input type="text" inputmode="numeric" class="gl-v2-field-input is-num is-tabular vraagprijs" data-veld="vraagprijs" value="@F0(l?.Vraagprijs)" placeholder="@min.ToString("N0", nl)" aria-label="Vraagprijs @naam" /></div></div>
                                        <i class="ph bw-vp-status" aria-hidden="true"></i>
                                    </div>
                                    <span class="bw-vp-bron"></span>
                                </td>
                            </tr>
                            @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwVerkoopDetail.cshtml", new BwVerkoopDetailVm { Naam = naam, GrondoppAgrarisch = e.GrondoppAgrarisch, Lijn = l, RefBouw = refBouwItems, RefGrond = refGrondItems, Units = unitItems, Rij = rij })
                            <tr class="bw-vp-waarsch" hidden><td colspan="7"><span class="bw-vp-waarsch-t"></span><span class="bw-vp-waarsch-acties"><button type="button" class="gl-v2-btn gl-v2-btn-secondary bw-vp-opmin" data-bw-edit>Op minimum zetten</button><button type="button" class="gl-v2-btn gl-v2-btn-text bw-vp-zolaten" data-bw-edit>Zo laten</button></span></td></tr>
                        }
                        @foreach (var l in losseLijnen)
                        {
                            rij++;
                            <tr class="bw-vp-rij" data-naam="@l.EenheidNaam" data-sleutel="@OnderSleutel(l.EenheidNaam)" data-genegeerd="0" data-info="0" data-gered="0" data-grondopp="0" data-grondopp2="0" data-min="0" data-kost="0" data-vgrond="" data-vbouw="" data-markt="" data-bron="@(l.PrijsBron?.ToString() ?? "")">
                                <td><input type="checkbox" class="bw-vp-check bw-vp-sel" aria-label="@l.EenheidNaam selecteren" data-bw-edit /></td>
                                <td class="bw-vp-naam"><button type="button" class="bw-vp-toggle" aria-expanded="false" title="Details" aria-label="Details @l.EenheidNaam"><i class="ph ph-caret-right" aria-hidden="true"></i></button><span class="bw-vp-naamtekst"><b>@l.EenheidNaam</b> <span class="bw-vp-sub">niet op stap 2 · vrije lijn, geen voorstel</span></span></td>
                                @foreach (var kant in new[] { "grond", "bouw" })
                                {
                                    <td class="bw-vp-zijde is-eigen" data-zijde="@kant">
                                        <div class="bw-vp-codevak">@await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm { Name = "code-" + kant + "-" + rij, Id = "bw-vp-c" + kant[0] + "-" + rij, Bare = true, Placeholder = "Kies code", EmptyText = "Eigen waarde", Value = (kant == "grond" ? l.CodeGrond : l.CodeBouw)?.ToString() ?? "", Items = kant == "grond" ? refGrondItems : refBouwItems })</div>
                                        <div class="bw-vp-eigenvak"><button type="button" class="bw-vp-chip" data-bw-edit>EIGEN</button><span class="gl-v2-field-prefix">€</span><input type="text" inputmode="numeric" class="bw-vp-bedrag" data-veld="@(kant == "grond" ? "grondwaarde" : "bouwwaarde")" value="@(kant == "grond" ? F0(l.Grondwaarde) : F0(l.Bouwwaarde))" placeholder="0" data-bw-edit /></div>
                                        <span class="bw-vp-subw"></span>
                                    </td>
                                }
                                <td class="is-num bw-vp-min is-muted">—</td><td class="is-num bw-vp-mk is-muted">—</td>
                                <td class="is-num bw-vp-vp"><div class="bw-vp-vp-rij"><div class="gl-v2-field gl-v2-field-bare"><div class="gl-v2-field-box"><span class="gl-v2-field-prefix">€</span><input type="text" inputmode="numeric" class="gl-v2-field-input is-num is-tabular vraagprijs" data-veld="vraagprijs" value="@F0(l.Vraagprijs)" aria-label="Vraagprijs" /></div></div><i class="ph bw-vp-status" aria-hidden="true"></i></div><span class="bw-vp-bron"></span></td>
                            </tr>
                            @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwVerkoopDetail.cshtml", new BwVerkoopDetailVm { Naam = l.EenheidNaam, Lijn = l, RefBouw = refBouwItems, RefGrond = refGrondItems, Units = unitItems, Rij = rij })
                            <tr class="bw-vp-waarsch" hidden><td colspan="7"></td></tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="bw-vp-tot-lbl">Totaal · @(eenheden.Count + losseLijnen.Count) eenhe@(eenheden.Count + losseLijnen.Count == 1 ? "id" : "den")</td>
                            <td class="is-num">@Eur0(vs?.TotaalVerkoopwaarde ?? 0m)</td>
                            <td class="is-num">@(vs?.MarktTotaal.HasValue == true ? Eur0(vs.MarktTotaal.Value) : "—")</td>
                            <td class="is-num" id="bw-vp-tot">—</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            @if (!eenheden.Any() && !losseLijnen.Any())
            {
                <div class="gl-v2-bw-empty"><span class="t">Nog geen eenheden</span><span class="s">Vul eerst de eenheden in op stap 2 — het voorstel en de verkooplijnen volgen daaruit.</span></div>
            }
        </section>
    </div>

    <div class="gl-v2-form-actionbar">
        <a href="@ch.PrevUrl" class="gl-v2-btn gl-v2-btn-text" data-bw-nav="back"><i class="ph ph-caret-left" aria-hidden="true"></i>@ch.PrevLabel</a>
        <span class="gl-v2-bw-status" data-bw-status data-state="@(ch.IsLocked ? "locked" : "saved")" aria-live="polite">@(ch.IsLocked ? "Definitief — alleen-lezen" : "Alle wijzigingen opgeslagen")</span>
        <span class="gl-v2-form-actionbar-spacer"></span>
        <div class="gl-v2-form-actionbar-actions">
            <a href="@ch.NextUrl" class="gl-v2-btn gl-v2-btn-primary" data-bw-nav="next" data-bw-keep>@(ch.IsLocked ? "Volgende: Resultaat" : "Opslaan & volgende: Resultaat")<i class="ph ph-caret-right" aria-hidden="true"></i></a>
        </div>
    </div>
</div>

@* Code toevoegen: een projectcode (enkel voor dit project); de algemene codes staan in Instellingen *@
<div class="modal fade gl-v2-modal-form bw-modal" id="bw-vp-code-modal" tabindex="-1" aria-hidden="true" aria-labelledby="bw-vp-code-titel" style="--bw-modal-w:560px">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
        <form method="post" asp-action="BudgetPrijsReferentieToevoegen" asp-controller="Projecten" class="modal-content" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" name="versieId" value="@Model.BudgetVersieId" />
            <div class="modal-header bw-mod-kop">
                <span class="bw-mod-icoon"><i class="ph ph-tag" aria-hidden="true"></i></span>
                <div class="gl-v2-stack bw-mod-titels"><h2 class="modal-title" id="bw-vp-code-titel">Projectcode toevoegen</h2><span class="bw-mod-sub">enkel voor dit project · de algemene codes beheer je in Instellingen</span></div>
                <button type="button" class="btn-close gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
            </div>
            <div class="modal-body bw-mod-body">
                <div class="bw-mod-twee">
                    <div class="bw-mod-veld"><span class="bw-mod-lbl">Soort</span>@await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm { Name = "prijsType", Id = "bw-vp-cm-type", Bare = true, Value = "Bouw", Items = new List<GlV2SelectItem> { new() { Value = "Bouw", Text = "Bouw (€/m² gereduceerd)" }, new() { Value = "Grond", Text = "Grond (€/m² grond)" } } })</div>
                    <div class="bw-mod-veld"><span class="bw-mod-lbl">Code</span><div class="gl-v2-field-box"><input type="text" inputmode="numeric" name="code" class="gl-v2-field-input is-tabular" placeholder="nummer, bv. 4" required /></div></div>
                </div>
                <div class="bw-mod-veld"><span class="bw-mod-lbl">Omschrijving</span><div class="gl-v2-field-box"><input type="text" name="omschrijving" class="gl-v2-field-input" placeholder="bv. afwerking luxe" maxlength="200" /></div></div>
                <div class="bw-mod-twee">
                    <div class="bw-mod-veld"><span class="bw-mod-lbl">€ per m²</span><div class="gl-v2-field-box"><span class="gl-v2-field-prefix">€</span><input type="text" inputmode="decimal" name="prijsPerM2" class="gl-v2-field-input is-num is-tabular" placeholder="0,00" required /></div></div>
                    <div class="bw-mod-veld">@await Html.PartialAsync("GlV2/_DateField", new GlV2DateFieldVm { Name = "datum", Id = "bw-vp-cm-datum", Label = "Datum", IsoValue = DateTime.Today.ToString("yyyy-MM-dd"), DisplayValue = DateTime.Today.ToString("dd/MM/yyyy") })</div>
                </div>
                <div class="bw-mod-veld"><span class="bw-mod-lbl">Bron</span><div class="gl-v2-field-box"><input type="text" name="bron" class="gl-v2-field-input" placeholder="bv. offerte, nacalculatie" maxlength="200" /></div></div>
            </div>
            <div class="modal-footer bw-mod-voet">
                <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
                <span class="gl-v2-form-actionbar-spacer"></span>
                <button type="submit" class="gl-v2-btn gl-v2-btn-primary">Code toevoegen</button>
            </div>
        </form>
    </div>
</div>

@section PageScripts
{
<script src="~/js/gl-v2-budget.js" asp-append-version="true"></script>
<script src="~/js/gl-v2-budget-verkoop.js" asp-append-version="true"></script>
}
