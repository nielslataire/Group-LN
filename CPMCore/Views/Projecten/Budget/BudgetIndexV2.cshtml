@model CPMCore.Models.Projecten.BudgetIndexModel
@using CPMCore.Models.GlV2
@using BOCore
@inject FacadeCore.IPermissionService PermissionService
@*
    gl-v2 — Budgetten, overzicht (design-handoff 39a): bovenaan het definitieve budget (één per project — vastgezet op/door, alleen-lezen,
    basis voor facturen & contracten; de tegels Gecontracteerd/Gefactureerd/Verwacht verschil zijn placeholders tot de koppeling met
    contracten en facturen, zoals afgesproken), daaronder één kaart per budget met zijn versies (versie · naam · datum · status · totaal ·
    Open), "Nieuwe versie op basis van de huidige" en "Nieuw budget — leeg of als kopie". Status: Concept · stap x van 9 / Afgerond / Definitief.
*@
@{
    ViewData["Title"] = "Budgetten";
    var kanVerwijderen = PermissionService.HasDelete(PermissionCodes.ProjectsDetail);
    ViewData["PageIcon"] = "ph ph-table";
    ViewData["GlV2FullHeightBody"] = true; // bodycard vult het scherm als de inhoud korter is (DESIGN.md: GlV2FullHeightBody)
    ViewData["BackUrl"] = Url.Action("Detail", "Projecten", new { projectid = Model.ProjectId });
    var nl = new System.Globalization.CultureInfo("nl-BE");
    string Eur0(decimal v) => "€ " + v.ToString("N0", nl);
    var menu = new GlV2ProjectMenuVm { ProjectId = Model.ProjectId, ProjectName = Model.ProjectName ?? "", ProjectSubtitle = "project · budgetten", Mode = GlV2ProjectMenuMode.Outer };
    var def = Model.DefinitiefVersie;
    var defMaster = def == null ? null : Model.BudgetMasters.FirstOrDefault(m => m.Id == def.BudgetMasterId);
    string StatusLabel(BudgetVersieBO v) => v.Status == "Definitief" ? "Definitief" : v.Status == "Afgerond" ? "Afgerond" : (v.IsHuidig ? "Huidig · " : "") + "concept";
    bool Compleet(BudgetVersieBO v) => v.Status == "Definitief" || v.Status == "Afgerond" || v.LaatsteStap >= 9;
    string Pct1(decimal f) => (f * 100m).ToString("0.0", nl) + " %";
    string StatusKlasse(BudgetVersieBO v) => v.Status == "Definitief" ? "is-positive" : v.Status == "Afgerond" ? "is-neutral" : v.IsHuidig ? "is-attention" : "is-inactive";
    var alleVersies = Model.BudgetMasters.SelectMany(m => m.Versies.Select(v => (Master: m, Versie: v))).ToList();
    if (ViewData["VergelijkVoorselectie"] is int voorId && voorId > 0) { ViewData["VergelijkSelectie"] = new List<int> { voorId }; ViewData["VergelijkAuto"] = voorId.ToString(); }
}
@section PageStyle
{
    <link rel="stylesheet" href="~/css/gl-v2-project-inner-menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-budget.css" asp-append-version="true" />
    <style>
        /* Definitief budget (39a): volle breedte bovenaan — slotje, titel/totaal/marge, vastzet-regel en drie kengetallen; rechts de twee knoppen onder elkaar */
        .bw-ix-def { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 18px; padding: 16px 20px; background: var(--gl-v2-surface, #fff); border-radius: 12px; box-shadow: 0 1px 2px rgba(0,83,45,.05), 0 18px 40px -28px rgba(44,59,42,.4); }
        .bw-ix-def-icon { width: 40px; height: 40px; border-radius: 10px; background: var(--gl-v2-primary); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 18px; }
        .bw-ix-def-main { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
        .bw-ix-def-kop { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .bw-ix-def-lbl { font: 600 9.5px var(--gl-v2-font-sans); letter-spacing: .1em; color: var(--gl-v2-muted); }
        .bw-ix-def-naam { font: 700 14px var(--gl-v2-font-sans); color: var(--gl-v2-ink); }
        .bw-ix-def-tot { font: 700 14px var(--gl-v2-font-sans); color: var(--gl-v2-primary); font-variant-numeric: tabular-nums; }
        .bw-ix-def-marge { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; line-height: 1.2; }
        .bw-ix-def-marge b { font: 600 12.5px var(--gl-v2-font-sans); color: var(--gl-v2-primary); font-variant-numeric: tabular-nums; }
        .bw-ix-def-marge span { font: 450 11px var(--gl-v2-font-sans); color: var(--gl-v2-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
        .bw-ix-def-sub { font: 450 12px var(--gl-v2-font-sans); color: var(--gl-v2-muted); }
        .bw-ix-def-kpis { display: grid; grid-template-columns: repeat(3, minmax(0, 200px)); gap: 18px; margin-top: 6px; }
        .bw-ix-def-kpis > div { display: flex; flex-direction: column; gap: 2px; }
        .bw-ix-def-kpis .l { font: 600 9px var(--gl-v2-font-sans); letter-spacing: .1em; color: var(--gl-v2-muted); }
        .bw-ix-def-kpis .v { font: 600 14px var(--gl-v2-font-sans); color: var(--gl-v2-ink); font-variant-numeric: tabular-nums; }
        .bw-ix-def-kpis > a.bw-ix-kpi { display: flex; flex-direction: column; gap: 2px; text-decoration: none; border-radius: 8px; margin: -4px -6px; padding: 4px 6px; }
        .bw-ix-def-kpis > a.bw-ix-kpi:hover { background: #F2F5EF; }
        .bw-ix-def-kpis > a.bw-ix-kpi.is-over .v { color: #8A3B2A; }
        .bw-ix-def-kpis .s { font: 450 11px var(--gl-v2-font-sans); color: var(--gl-v2-muted-light); }
        .bw-ix-def-acties { display: flex; flex-direction: column; gap: 8px; align-items: stretch; }
        /* Lege kaart "Nieuw budget" (39a): gestreepte rand naast de budgetkaarten */
        .bw-ix-nieuw-kaart { border: 1.5px dashed rgba(44,59,42,.2); border-radius: 12px; min-height: 180px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; background: transparent; cursor: pointer; padding: 16px; }
        .bw-ix-nieuw-kaart:hover { background: rgba(0,83,45,.03); border-color: rgba(0,83,45,.4); }
        .bw-ix-nieuw-kaart .plus { width: 36px; height: 36px; border-radius: 10px; background: var(--gl-v2-primary-tint); color: var(--gl-v2-primary); display: inline-flex; align-items: center; justify-content: center; font-size: 16px; }
        .bw-ix-nieuw-kaart .t { font: 600 13px var(--gl-v2-font-sans); color: var(--gl-v2-ink); }
        .bw-ix-nieuw-kaart .s { font: 450 12px var(--gl-v2-font-sans); color: var(--gl-v2-muted); }
        .bw-ix-stap { font: 500 12px var(--gl-v2-font-sans); color: var(--gl-v2-muted); white-space: nowrap; }
        .bw-ix-marge { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.25; }
        .bw-ix-marge b { font-weight: 600; color: var(--gl-v2-primary); }
        .bw-ix-marge span { font: 450 11px var(--gl-v2-font-sans); color: var(--gl-v2-muted); }
        /* De versietabel heeft zes kolommen en heeft zeker 640px nodig. Twee kaarten naast elkaar (vroeger vanaf 1200px) knipten de laatste
           kolom af op een gewoon scherm; nu gaan ze pas naast elkaar als elke kaart minstens 660px breed kan zijn. */
        .bw-ix-kaarten { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 660px), 1fr)); gap: 16px; }
        .bw-ix-kaart { min-width: 0; }
        .bw-ix-kaart .gl-v2-bw-table-wrap { overflow-x: auto; }
        .bw-ix-kaart .gl-v2-section-card-header { flex-wrap: wrap; row-gap: 6px; }
        .bw-ix-kaart .gl-v2-section-card-title { font-family: var(--gl-v2-font-serif); font-weight: 500; font-size: 16px; text-transform: none; letter-spacing: 0; }
        .bw-ix-versie { cursor: pointer; }
        .bw-ix-kaarten .gl-v2-bw-table .col-actions { width: 140px; padding-top: 0; padding-bottom: 0; }
        .bw-ix-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 20px 14px; border-top: 1px solid var(--gl-v2-hairline-soft); flex-wrap: wrap; }
        .bw-ix-ph { color: var(--gl-v2-muted-light); font-weight: 450; }
        @@media (max-width: 991.98px) { .bw-ix-def { grid-template-columns: auto minmax(0, 1fr); } .bw-ix-def-acties { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; } .bw-ix-def-kpis { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); } }
    </style>
}
@section ProjectMenu
{
    @await Html.PartialAsync("GlV2/_ProjectInnerMenuV2", menu)
}
@{ var menuPhone = new GlV2ProjectMenuVm { ProjectId = menu.ProjectId, ProjectName = menu.ProjectName, ProjectSubtitle = menu.ProjectSubtitle, Mode = GlV2ProjectMenuMode.Phone }; }
@await Html.PartialAsync("GlV2/_ProjectInnerMenuV2", menuPhone)
@section PageActions
{
    <button type="button" class="gl-v2-btn gl-v2-btn-secondary" id="bw-ix-vergelijk" data-bw-vergelijk=""@(Model.BudgetMasters.Sum(m => m.Versies.Count) < 2 ? " disabled title=\"Je hebt minstens twee versies nodig om te vergelijken.\"" : "")><i class="ph ph-git-diff" aria-hidden="true"></i>Vergelijken</button>
    <button type="button" class="gl-v2-btn gl-v2-btn-primary" id="bw-ix-nieuw"><i class="ph ph-plus" aria-hidden="true"></i>Nieuw budget</button>
}

<p class="gl-v2-bw-intro">Meerdere budgetten per project, elk met genummerde versies. <strong>Huidig</strong> is de versie waaraan je werkt; <strong>definitief</strong> is per project één vastgezette versie — die wordt gebruikt voor de vergelijking met facturen en contracten.</p>

@if (def != null)
{
    Model.Marges.TryGetValue(def.Id, out var defMarge);
    <section class="bw-ix-def">
        <span class="bw-ix-def-icon"><i class="ph ph-lock-key" aria-hidden="true"></i></span>
        <div class="bw-ix-def-main">
            <div class="bw-ix-def-kop">
                <span class="bw-ix-def-lbl">DEFINITIEF BUDGET</span>
                <span class="bw-ix-def-naam">@defMaster?.Naam · v@(def.Versienummer)@(string.IsNullOrWhiteSpace(def.VersieNaam) ? "" : " · " + def.VersieNaam)</span>
                <span class="bw-ix-def-tot">@(Model.Totalen.TryGetValue(def.Id, out var dt) && dt.HasValue ? Eur0(dt.Value) : "—")</span>
                @if (defMarge != null) { <span class="bw-ix-def-marge"><b>@Pct1(defMarge.Percentage)</b><span>@Eur0(defMarge.Bedrag)</span></span> }
            </div>
            <span class="bw-ix-def-sub">Vastgezet op @(def.VastgezetOp?.ToString("dd/MM/yyyy") ?? "—")@(string.IsNullOrWhiteSpace(def.VastgezetDoor) ? "" : " door " + def.VastgezetDoor) · alleen-lezen · basis voor facturen &amp; contracten</span>
            @{
                var kp = Model.Koppeling;
                var nlk = new System.Globalization.CultureInfo("nl-BE");
                string Eur(decimal x) => (x < 0m ? "– € " : "€ ") + Math.Abs(x).ToString("N0", nlk);
                var nacalc = Url.Action("Recalculation", "Projecten", new { projectid = Model.ProjectId });
            }
            @if (kp != null)
            {
                <div class="bw-ix-def-kpis">
                    <a class="bw-ix-kpi" href="@nacalc" data-bw-plain><span class="l">GECONTRACTEERD</span><span class="v">@Eur(kp.Gecontracteerd)</span><span class="s">@(kp.Begroot > 0m ? (kp.Gecontracteerd / kp.Begroot * 100m).ToString("0", nlk) + " % van het budget" : "contracten en bijbestellingen")</span></a>
                    <a class="bw-ix-kpi" href="@nacalc" data-bw-plain><span class="l">GEFACTUREERD</span><span class="v">@Eur(kp.Gefactureerd)</span><span class="s">@(kp.Gecontracteerd > 0m ? (kp.Gefactureerd / kp.Gecontracteerd * 100m).ToString("0", nlk) + " % van het contract" : "incl. meerwerk, excl. meerwerk voor klanten")</span></a>
                    <a class="bw-ix-kpi @(kp.VerwachtVerschil < 0m ? "is-over" : "")" href="@nacalc" data-bw-plain><span class="l">VERWACHT VERSCHIL</span><span class="v">@(kp.VerwachtVerschil > 0m ? "+ " : "")@Eur(kp.VerwachtVerschil)</span><span class="s">@(kp.VerwachtVerschil < 0m ? "boven budget" : "onder budget") · @(kp.AantalOverBudget == 0 ? "geen activiteit boven budget" : kp.AantalOverBudget + (kp.AantalOverBudget == 1 ? " activiteit" : " activiteiten") + " boven budget")</span></a>
                </div>
            }
            else
            {
                <div class="bw-ix-def-kpis">
                    <div><span class="l">GECONTRACTEERD</span><span class="v bw-ix-ph">—</span><span class="s">niet te berekenen</span></div>
                    <div><span class="l">GEFACTUREERD</span><span class="v bw-ix-ph">—</span><span class="s">niet te berekenen</span></div>
                    <div><span class="l">VERWACHT VERSCHIL</span><span class="v bw-ix-ph">—</span><span class="s">niet te berekenen</span></div>
                </div>
            }
        </div>
        <div class="bw-ix-def-acties">
            <button type="button" class="gl-v2-btn gl-v2-btn-primary" data-bw-vergelijk="@def.Id" data-bw-basis="@def.Id"@(Model.BudgetMasters.Sum(m => m.Versies.Count) < 2 ? " disabled" : "")><i class="ph ph-git-diff" aria-hidden="true"></i>Vergelijking openen</button>
            <button type="button" class="gl-v2-btn gl-v2-btn-secondary" id="bw-ix-ander-def"><i class="ph ph-arrows-left-right" aria-hidden="true"></i>Andere versie definitief maken…</button>
        </div>
    </section>
}
else
{
    <div class="gl-v2-notice gl-v2-notice-compact is-info"><i class="ph ph-info" aria-hidden="true"></i><span>Nog geen definitief budget. Rond een versie af op stap 9 en kies "Afronden &amp; definitief maken"; die versie wordt dan de basis voor de vergelijking met facturen en contracten.</span></div>
}

<div class="bw-ix-kaarten">
    @foreach (var m in Model.BudgetMasters)
    {
        var eenh = Model.EenhedenPerMaster.TryGetValue(m.Id, out var e) ? e : 0;
        var laatst = m.Versies.Any() ? m.Versies.Max(v => v.GewijzigdOp ?? v.CreatedAt) : m.CreatedAt;
        var huidig = m.Versies.FirstOrDefault(v => v.IsHuidig) ?? m.Versies.OrderByDescending(v => v.Versienummer).FirstOrDefault();
        <section class="gl-v2-section-card bw-ix-kaart">
            <div class="gl-v2-section-card-header">
                <span class="gl-v2-section-card-icon"><i class="ph ph-table" aria-hidden="true"></i></span>
                <h2 class="gl-v2-section-card-title">@m.Naam</h2>
                <button type="button" class="gl-v2-row-action gl-v2-row-action-primary bw-ix-hernoem" data-master="@m.Id" data-naam="@m.Naam" data-oms="@m.Omschrijving"><i class="ph ph-pencil-simple" aria-hidden="true"></i><span class="gl-v2-row-action-label">Budget hernoemen</span></button>
                <span class="gl-v2-field-divider"></span>
                <span class="gl-v2-section-card-desc">@eenh eenhe@(eenh == 1 ? "id" : "den") · laatst gewijzigd @laatst.ToString("dd/MM/yyyy HH:mm")</span>
                <span class="gl-v2-section-card-meta" style="margin-left:auto">
                    @if (m.IsActief) { <span class="gl-v2-badge is-positive">Actief budget</span> }
                    else
                    {
                        <form method="post" asp-action="BudgetMasterActiveren" asp-controller="Projecten" style="display:contents">@Html.AntiForgeryToken()<input type="hidden" name="masterId" value="@m.Id" /><input type="hidden" name="projectId" value="@Model.ProjectId" /><button type="submit" class="gl-v2-btn gl-v2-btn-text" style="height:30px">Maak actief</button></form>
                    }
                </span>
            </div>
            <div class="gl-v2-bw-table-wrap">
                <table class="gl-v2-bw-table">
                    <thead><tr><th>Versie</th><th>Naam</th><th>Datum</th><th>Status</th><th class="is-num">Totaal</th><th class="is-num">Marge</th><th class="col-actions"></th></tr></thead>
                    <tbody>
                        @foreach (var v in m.Versies.OrderByDescending(x => x.Versienummer))
                        {
                            var url = Url.Action(v.Status == "Definitief" || v.Status == "Afgerond" || v.LaatsteStap >= 9 ? "BudgetResultaat" : "BudgetGegevens", "Projecten", new { versieId = v.Id });
                            <tr class="bw-ix-versie" data-detail-url="@url">
                                <td class="is-strong">v@(v.Versienummer)</td>
                                <td>@(string.IsNullOrWhiteSpace(v.VersieNaam) ? "—" : v.VersieNaam)</td>
                                <td class="is-muted">@((v.GewijzigdOp ?? v.CreatedAt).ToString("dd/MM/yyyy"))</td>
                                <td><span class="gl-v2-badge @StatusKlasse(v)">@StatusLabel(v)</span></td>
                                <td class="is-num is-strong">@if (!Compleet(v)) { <span class="bw-ix-stap">stap @(Math.Max(1, v.LaatsteStap ?? 1)) van 9</span> } else { @(Model.Totalen.TryGetValue(v.Id, out var t) && t.HasValue ? Eur0(t.Value) : "—") }</td>
                                <td class="is-num">@if (Compleet(v) && Model.Marges.TryGetValue(v.Id, out var mg)) { <span class="bw-ix-marge"><b>@Pct1(mg.Percentage)</b><span>@Eur0(mg.Bedrag)</span></span> } else { <span class="bw-ix-ph">—</span> }</td>
                                <td class="col-actions"><span class="gl-v2-rowact"><i class="ph ph-caret-right gl-v2-rowact-chev" aria-hidden="true"></i><span class="gl-v2-rowact-btns"><button type="button" class="gl-v2-icon-btn bw-ix-versie-hernoem" title="Versie hernoemen" aria-label="Versie hernoemen" data-versie="@v.Id" data-naam="@v.VersieNaam" data-notitie="@v.Notitie"><i class="ph ph-pencil-simple" aria-hidden="true"></i></button>@if (kanVerwijderen && v.Status != "Definitief") { <button type="button" class="gl-v2-icon-btn is-danger bw-ix-versie-del" title="Versie verwijderen" aria-label="Versie verwijderen" data-versie="@v.Id" data-budget="@m.Naam" data-vnr="v@(v.Versienummer)" data-laatste="@(m.Versies.Count == 1 ? "1" : "0")"><i class="ph ph-trash" aria-hidden="true"></i></button> }<a href="@url" class="gl-v2-icon-btn" title="Open versie" aria-label="Open versie"><i class="ph ph-arrow-square-out" aria-hidden="true"></i></a></span></span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="bw-ix-foot">
                <button type="button" class="gl-v2-btn gl-v2-btn-text bw-ix-nieuwe-versie" data-master="@m.Id" data-van="@(huidig?.Versienummer ?? 0)"><i class="ph ph-git-branch" aria-hidden="true"></i>Nieuwe versie op basis van de huidige</button>
                <span class="gl-v2-bw-hint">@m.Versies.Count versie@(m.Versies.Count == 1 ? "" : "s")</span>
            </div>
        </section>
    }
    <button type="button" class="bw-ix-nieuw-kaart" id="bw-ix-nieuw-kaart">
        <span class="plus"><i class="ph ph-plus" aria-hidden="true"></i></span>
        <span class="t">Nieuw budget</span>
        <span class="s">leeg of als kopie van een bestaand budget</span>
    </button>
</div>

@* Nieuw budget (design-handoff 39l) *@
@{
    var bronnenJson = System.Text.Json.JsonSerializer.Serialize(Model.KopieBronnen.Select(b => new
    {
        id = b.MasterId, naam = b.Naam, groep = b.EigenProject ? "Dit project" : b.ProjectNaam,
        versies = b.Versies.Select(v => new { value = v.ID.ToString(), text = v.Display })
    }));
    var stapKeuzes = new[] { ("gegevens", "Gegevens", true), ("oppervlaktes", "Oppervlaktes", true), ("sanitair", "Sanitair", true), ("gevels", "Gevels", true), ("dak", "Dak & afbraak", true),
        ("activiteiten", "Activiteiten", true), ("parameters", "Parameters", true), ("verkoop", "Verkoop", false), ("opmerkingen", "Opmerkingen", false) };
}
<div class="modal fade gl-v2-modal-form bw-modal" id="bw-ix-modal" tabindex="-1" aria-hidden="true" aria-labelledby="bw-ix-modal-title"
     data-bronnen="@bronnenJson" data-aantal="@Model.AantalProjectEenheden" data-index="@Model.ActieveIndexTekst">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down" style="--bw-modal-w:600px">
        <form method="post" asp-action="BudgetMasterAanmaken" asp-controller="Projecten" class="modal-content" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ProjectId" value="@Model.ProjectId" /><input type="hidden" name="ProjectName" value="@Model.ProjectName" /><input type="hidden" name="OvernemenIngevuld" value="true" />
            <div class="modal-header bw-mod-kop">
                <span class="bw-mod-icoon"><i class="ph ph-plus" aria-hidden="true"></i></span>
                <div class="gl-v2-stack bw-mod-titels"><h2 class="modal-title" id="bw-ix-modal-title">Nieuw budget</h2><span class="bw-mod-sub">@Model.ProjectName</span></div>
                <button type="button" class="gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button>
            </div>
            <div class="modal-body bw-mod-body">
                <div class="gl-v2-field">
                    <label class="gl-v2-field-label" for="bw-ix-naam">Naam <span style="color:#8B2A2A">*</span></label>
                    <div class="gl-v2-field-box"><input type="text" id="bw-ix-naam" name="Naam" class="gl-v2-field-input" maxlength="200" required placeholder="bv. Variant met kelder" /></div>
                    <span class="gl-v2-field-help">zichtbaar in de lijst; versies krijgen v1, v2…</span>
                </div>

                <div class="bw-mod-groep">
                    <span class="bw-mod-lbl">Startpunt</span>
                    <div class="bw-start is-aan">
                        <label class="bw-start-kop"><input type="radio" name="startpunt" value="leeg" checked /><span class="bw-radio" aria-hidden="true"></span>
                            <span class="bw-start-tekst"><strong>Leeg budget</strong><small>alle stappen leeg, eenheden en oppervlaktes uit het project</small></span></label>
                    </div>
                    @* De keuzelijsten en vinkjes staan buiten het label van de radio: in een label opent een klik op de lijst tegelijk de radio, waardoor de lijst meteen weer sluit. *@
                    <div class="bw-start">
                        <label class="bw-start-kop"><input type="radio" name="startpunt" value="kopie" /><span class="bw-radio" aria-hidden="true"></span>
                            <span class="bw-start-tekst"><strong>Kopie van een bestaand budget</strong><small>kies budget en versie; aangevinkte stappen worden overgenomen, de rest begint leeg</small></span></label>
                        <span class="bw-start-kopie" hidden>
                            <span class="bw-mod-twee bw-mod-twee--kopie">
                                @await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm { Name = "KopieBudgetId", Id = "bw-nb-budget", Bare = true, Placeholder = "Kies een budget…", Value = "", Items = new List<GlV2SelectItem>() })
                                @await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm { Name = "KopieVanVersieId", Id = "bw-nb-versie", Bare = true, Placeholder = "Kies een versie…", Value = "", Items = new List<GlV2SelectItem>() })
                            </span>
                            <span class="bw-mod-groep bw-mod-groep--klein">
                                <span class="bw-mod-lbl">Overnemen</span>
                                <span class="bw-overnemen-raster">
                                    @foreach (var (sleutel, label, aan) in stapKeuzes)
                                    {
                                        <label class="bw-overnemen"><input type="checkbox" name="Overnemen" value="@sleutel" @(aan ? "checked" : "") /><span class="bw-check" aria-hidden="true"><i class="ph ph-check"></i></span><span>@label</span></label>
                                    }
                                </span>
                            </span>
                        </span>
                    </div>
                </div>

                <div class="bw-mod-twee">
                    <div class="bw-mod-veld">
                        <span class="bw-mod-lbl">Eenheden</span>
                        @await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm { Name = "EenhedenBron", Id = "bw-nb-eenheden", Bare = true, Value = "project", Items = new List<GlV2SelectItem> { new() { Value = "project", Text = $"{Model.AantalProjectEenheden} eenhe{(Model.AantalProjectEenheden == 1 ? "id" : "den")} uit het project" }, new() { Value = "leeg", Text = "Geen eenheden, zelf toevoegen in stap 2" } } })
                        <span class="gl-v2-field-help" id="bw-nb-eenheden-help">aanpasbaar in stap 2</span>
                    </div>
                    <div class="bw-mod-veld">
                        <span class="bw-mod-lbl">Index</span>
                        @await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm { Name = "IndexBron", Id = "bw-nb-index", Bare = true, Value = "actueel", Items = new List<GlV2SelectItem> { new() { Value = "actueel", Text = Model.ActieveIndexTekst } } })
                        <span class="gl-v2-field-help">peildatum voor de prijzen</span>
                    </div>
                </div>

                <label class="bw-toggle-rij">
                    <input type="checkbox" name="ActiefMaken" value="true" class="gl-v2-toggle-switch" />
                    <span class="bw-toggle-tekst">Meteen actief budget maken</span>
                    <span class="bw-mod-flex"></span>
                    <span class="bw-toggle-sub">het definitief budget blijft ongewijzigd</span>
                </label>
            </div>
            <div class="modal-footer bw-mod-voet">
                <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
                <span class="bw-mod-flex"></span>
                <button type="submit" class="gl-v2-btn gl-v2-btn-primary"><i class="ph ph-arrow-right" aria-hidden="true"></i>Aanmaken &amp; naar stap 1</button>
            </div>
        </form>
    </div>
</div>

