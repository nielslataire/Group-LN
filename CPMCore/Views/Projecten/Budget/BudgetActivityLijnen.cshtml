@using CPMCore.Controllers
@model CPMCore.Models.Budget.BudgetActivityLijnenModel
@{
    var ic   = System.Globalization.CultureInfo.InvariantCulture;
    var nlBE = new System.Globalization.CultureInfo("nl-BE");
    string Fmt(decimal v, int d = 2) => v.ToString("F" + d, ic);
    string Eur0(decimal v) => v.ToString("N0", nlBE);
    string Eur2(decimal v) => v.ToString("N2", nlBE);

    decimal Corr(BOCore.Budget.BudgetActivityLijnBO l) => l.Correctiefactor <= 0 ? 1m : l.Correctiefactor;
    decimal LotGecorrigeerd(BOCore.Budget.BudgetLotGroepBO g) =>
        g.Lijnen.Where(l => l.TotaalAlternatief > 0).Sum(l => l.TotaalAlternatief * Corr(l));

    var lotenMetBedrag  = Model.LotGroepen.Where(g => g.Lijnen.Any(l => l.TotaalAlternatief > 0)).ToList();
    var totaalGecorrigeerd = lotenMetBedrag.Sum(LotGecorrigeerd);
    var prijsPerM2      = Model.OppervlakteGBA == 0 ? 0m : totaalGecorrigeerd / Model.OppervlakteGBA;

    // Nacalc: referentieprojecten (werkelijke kost van afgewerkte projecten, geïndexeerd) naast het budget
    var toonRef = Model.HeeftReferenties;
    ViewData["HeeftReferenties"] = toonRef;
    decimal LotReferentie(BOCore.Budget.BudgetLotGroepBO g) =>
        g.Lijnen.Where(l => l.TotaalAlternatief > 0 && l.HeeftReferentie).Sum(l => l.ReferentieTotaal ?? 0m);
    var totaalReferentie = Model.TotaalReferentie;
    var gekozenRefs = Model.Referenties.Where(r => Model.GeselecteerdeReferentieIds.Contains(r.Id)).ToList();
}

@section PageStyle {
    <link rel="stylesheet" href="~/css/budget-wizard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/projecten-custom.css" asp-append-version="true" />
<style>
    /* ── Activiteiten-overzicht: één compacte tabel, loten als hoofdrijen ──
       Alle rij-scheidingen zijn inset-box-shadows (géén echte randen), dus
       ze nemen geen ruimte in en border-collapse kan geen enkele rij korter
       renderen dan de andere. Rijhoogte staat vast. */
    .bw-actlijn { font-size: .82rem; border-collapse: collapse; }
    .bw-actlijn td, .bw-actlijn th { padding: .18rem .55rem; border: 0; }
    .bw-actlijn thead th {
        padding-top: .4rem; padding-bottom: .4rem;
        box-shadow: inset 0 -1px 0 var(--border, #e7e7e7);
    }
    .bw-actlijn .act-row td {
        height: 28px;
        line-height: 1.2;
        box-shadow: inset 0 -1px 0 var(--border, #e7e7e7);
    }
    .bw-actlijn tbody tr:nth-of-type(even) td { background: var(--lightgray, #f8f9fc); }
    .bw-actlijn tbody tr:hover td { background: var(--lightgreen, #e8f0eb); }

    .bw-actlijn .act-row__naam { white-space: nowrap; }
    .bw-actlijn .act-row__basis { color: var(--muted, #8590a5); font-variant-numeric: tabular-nums; }
    .bw-actlijn .act-row__gecorrigeerd { font-variant-numeric: tabular-nums; }

    .act-row__info {
        vertical-align: middle;
        width: 18px; height: 18px;
        display: inline-flex; align-items: center; justify-content: center;
        margin-left: .3rem;
        padding: 0; border: 0; border-radius: 999px;
        background: transparent; color: var(--muted, #8590a5);
        font-size: .72rem; cursor: help;
    }
    .act-row__info:hover { color: var(--primary, #0a5a3b); background: var(--lightgreen, #e8f0eb); }

    .act-row__pct { display: inline-flex; align-items: center; gap: .25rem; justify-content: flex-end; }
    .act-row__pct > input.bw-cell-input { width: 58px; height: 24px; padding: 1px 6px; font-size: .8rem; }
    .act-row__pct > span { color: var(--muted, #8590a5); font-size: .78rem; }

    /* Hoofdrij = lot */
    .bw-actlijn .actlijn-lot__head th {
        height: 30px;
        background: var(--lightgreen, #e8f0eb);
        box-shadow: inset 0 2px 0 var(--primary, #0a5a3b), inset 0 -1px 0 var(--border, #e7e7e7);
        white-space: nowrap;
    }
    .bw-actlijn tbody.actlijn-lot:first-of-type .actlijn-lot__head th {
        box-shadow: inset 0 -1px 0 var(--border, #e7e7e7);
    }
    .actlijn-lot__toggle {
        display: inline-flex; align-items: center; gap: .45rem;
        border: 0; background: transparent; padding: 0;
        font: inherit; font-weight: 700; color: var(--primary, #0a5a3b);
        cursor: pointer;
    }
    .actlijn-lot__toggle > .fa-chevron-down { font-size: .62rem; transition: transform .15s ease; }
    .actlijn-lot--collapsed .actlijn-lot__toggle > .fa-chevron-down { transform: rotate(-90deg); }
    .actlijn-lot--collapsed .act-row { display: none; }
    .actlijn-lot__sum { color: var(--primary, #0a5a3b); font-weight: 700; font-variant-numeric: tabular-nums; }

    .bw-actlijn tfoot td {
        height: 34px;
        box-shadow: inset 0 2px 0 var(--border, #e7e7e7);
        font-weight: 700;
    }
    .bw-actlijn tfoot strong { color: var(--primary, #0a5a3b); font-variant-numeric: tabular-nums; }

    /* Nacalc-kolommen */
    .bw-actlijn .act-row__ref { color: var(--dark, #222); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .act-row__ref-n {
        display: inline-block; min-width: 16px; margin-left: .3rem; padding: 0 4px;
        border-radius: 999px; background: var(--lightgray, #f1f3f7); color: var(--muted, #8590a5);
        font-size: .66rem; line-height: 16px; text-align: center; vertical-align: middle;
    }
    .act-row__verschil { white-space: nowrap; font-variant-numeric: tabular-nums; }
    .act-row__delta { display: inline-block; min-width: 58px; text-align: right; font-size: .8rem; font-weight: 600; }
    .is-hoger { color: var(--danger, #b3452f); }
    .is-lager { color: var(--primary, #0a5a3b); }
    .is-gelijk { color: var(--muted, #8590a5); font-weight: 400; }
    .act-row__overnemen {
        vertical-align: middle; width: 22px; height: 22px; margin-left: .35rem;
        display: inline-flex; align-items: center; justify-content: center;
        padding: 0; border: 1px solid var(--border, #e7e7e7); border-radius: 6px;
        background: var(--white, #fff); color: var(--muted, #8590a5); font-size: .7rem; cursor: pointer;
    }
    .act-row__overnemen:hover { color: var(--primary, #0a5a3b); border-color: var(--primary, #0a5a3b); background: var(--lightgreen, #e8f0eb); }
    .actlijn-lot__ref { color: var(--muted, #8590a5); font-weight: 600; font-variant-numeric: tabular-nums; }
    .lot-delta { font-size: .8rem; font-weight: 600; font-variant-numeric: tabular-nums; }
    .bw-nacalc-keuze { display: flex; flex-wrap: wrap; gap: .5rem .75rem; }
    .bw-nacalc-keuze label {
        display: inline-flex; align-items: center; gap: .45rem; margin: 0; padding: .3rem .65rem;
        border: 1px solid var(--border, #e7e7e7); border-radius: 999px; background: var(--white, #fff);
        font-size: .82rem; cursor: pointer;
    }
    .bw-nacalc-keuze label:has(input:checked) { border-color: var(--primary, #0a5a3b); background: var(--lightgreen, #e8f0eb); }
    .bw-nacalc-keuze label input { margin: 0; }
    .bw-nacalc-keuze .meta { color: var(--muted, #8590a5); font-size: .74rem; }

    .popover-ruwbouw           { max-width: 560px; }
    .popover-ruwbouw table     { width: auto !important; }
    .popover-ruwbouw td        { white-space: nowrap; }
</style>
}

<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", Model.ProjectId)
        <div class="inner-body bw-inner-body">

            @* ── Wizard tabbladen ── *@
            @await Html.PartialAsync("Partials/_BudgetWizardTabs", new BudgetWizardTabsModel { VersieId = Model.BudgetVersieId, ActiveStep = 6, ShowCalcToggle = false })

            @* ── Pagina-koptekst ── *@
            <div class="bw-scroll">

            <div class="gl-form-section__head bw-step-head">
                <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                <div>
                    <h2 class="gl-form-section__title">Activiteiten</h2>
                    <p class="gl-form-section__hint">Overzicht per lot van de activiteiten met een bedrag. Stuur elk bedrag bij met een correctie in procent.</p>
                </div>
                @await Html.PartialAsync("Partials/_BudgetPageHeader", new BudgetPageHeaderModel
                {
                    StepNum      = 6,
                    MasterNaam   = Model.BudgetNaam,
                    VersieLabel  = Model.VersieLabel,
                    VersieStatus = Model.VersieStatus
                })
            </div>

            @* ── Cijferstrip (gl-kpi2) ── *@
            <div class="gl-kpi2-strip bw-kpi-row mb-4">
                <div class="gl-kpi2-tile-col">
                    <div class="gl-kpi2-tile" style="--kpi-color: var(--primary);">
                        <div class="gl-kpi2-icon"><i class="fa-solid fa-list-check" aria-hidden="true"></i></div>
                        <div class="gl-kpi2-body">
                            <div class="gl-kpi2-label">Totaal activiteiten (gecorrigeerd)</div>
                            <div class="gl-kpi2-value" id="kpiTotaal">€ @Eur0(totaalGecorrigeerd)</div>
                        </div>
                    </div>
                </div>
                <div class="gl-kpi2-tile-col">
                    <div class="gl-kpi2-tile" style="--kpi-color: var(--primary);">
                        <div class="gl-kpi2-icon"><i class="fa-solid fa-vector-square" aria-hidden="true"></i></div>
                        <div class="gl-kpi2-body">
                            <div class="gl-kpi2-label">€/m² GBA — @Fmt(Model.OppervlakteGBA) m² · @Model.AantalEenheden eenh.</div>
                            <div class="gl-kpi2-value" id="kpiM2">€ @Eur2(prijsPerM2)</div>
                        </div>
                    </div>
                </div>
                @if (toonRef)
                {
                    <div class="gl-kpi2-tile-col">
                        <div class="gl-kpi2-tile" style="--kpi-color: var(--primary);">
                            <div class="gl-kpi2-icon"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i></div>
                            <div class="gl-kpi2-body">
                                <div class="gl-kpi2-label">Referentie nacalc — @gekozenRefs.Count project@(gekozenRefs.Count == 1 ? "" : "en"), geïndexeerd</div>
                                <div class="gl-kpi2-value">€ @Eur0(totaalReferentie) <span class="small fw-normal" id="kpiRefDelta"></span></div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* ── Nacalc: referentieprojecten kiezen ── *@
            @if (TempData["Message"] != null) { <div class="alert alert-success py-2 px-3 small mb-3">@TempData["Message"]</div> }
            @if (TempData["Error"] != null)   { <div class="alert alert-danger py-2 px-3 small mb-3">@TempData["Error"]</div> }
            <div class="bw-dt mb-4">
                <div class="bw-dt__head">
                    <div class="bw-dt__title">
                        <i class="fa-solid fa-clock-rotate-left me-1"></i>Nacalculatie — vergelijken met afgewerkte projecten
                        @if (toonRef && Model.AantalZonderReferentie > 0)
                        {
                            <span class="text-muted small ms-2 fw-normal">@Model.AantalZonderReferentie activiteit@(Model.AantalZonderReferentie == 1 ? "" : "en") zonder referentiebedrag</span>
                        }
                    </div>
                    <div class="bw-dt__actions">
                        <a href="@Url.Action("BudgetReferentieProjecten", "Instellingen")" class="btn btn-sm btn-light border" target="_blank" title="Referentieprojecten beheren: uit Excel inladen of een snapshot van een project maken">
                            <i class="fa-solid fa-cog me-1"></i> Referentieprojecten beheren
                        </a>
                    </div>
                </div>
                <div class="p-3">
                    @if (!Model.Referenties.Any())
                    {
                        <p class="text-muted small mb-0">Nog geen referentieprojecten. Laad in <strong>Instellingen › Budget › Referentieprojecten</strong> een afgewerkt project in (Excel of snapshot uit de app) en kies het hier; de werkelijke kost per activiteit verschijnt dan naast het budget, geïndexeerd naar vandaag.</p>
                    }
                    else
                    {
                        <form method="post" asp-action="SetNacalcReferenties" asp-controller="Projecten" class="d-flex flex-wrap align-items-center gap-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="versieId" value="@Model.BudgetVersieId" />
                            <div class="bw-nacalc-keuze">
                                @foreach (var r in Model.Referenties)
                                {
                                    <label title="@(r.Opmerking ?? "")">
                                        <input type="checkbox" name="referentieIds" value="@r.Id" @(Model.GeselecteerdeReferentieIds.Contains(r.Id) ? "checked" : "") />
                                        <span>@r.Naam</span>
                                        <span class="meta">@(r.Datum?.Year.ToString() ?? "—") · @r.AantalEenheden eenh. · € @Eur0(r.TotaalBedrag)@(r.Bron == "Project" ? " · app" : " · excel")</span>
                                    </label>
                                }
                            </div>
                            <button type="submit" class="btn btn-sm btn-primary"><i class="fa-solid fa-check me-1"></i>Toepassen</button>
                            @if (toonRef)
                            {
                                <span class="text-muted small">Referentie = Σ werkelijke kost × indexfactor (peildatum → nu) ÷ Σ eenheden van de gekozen projecten, × @Model.AantalEenheden eenh. van dit budget. Verschil = gecorrigeerd budget t.o.v. referentie.</span>
                            }
                        </form>
                    }
                </div>
            </div>

            @* ── Overzicht: één tabel, loten als in-/uitklapbare hoofdrijen ── *@
            <form id="frmActivityLijnen">
                <input type="hidden" id="hdnVersieId" value="@Model.BudgetVersieId" />

                @if (!lotenMetBedrag.Any())
                {
                    <p class="bw-dt__empty" style="border:1px dashed var(--border);border-radius:var(--radius);background:var(--white);">
                        Nog geen activiteiten met een bedrag in dit budget.
                    </p>
                }
                else
                {
                    <div class="bw-dt">
                        <div class="bw-dt__scroll">
                            <table class="bw-table bw-actlijn mb-0">
                                <thead>
                                    <tr>
                                        <th>Activiteit</th>
                                        <th class="bw-num" style="width:150px;">€ basis</th>
                                        @if (toonRef)
                                        {
                                            <th class="bw-num" style="width:170px;" title="Werkelijke kost in de gekozen referentieprojecten, geïndexeerd en omgerekend naar dit aantal eenheden">Referentie (nacalc)</th>
                                            <th class="bw-num" style="width:120px;" title="Gecorrigeerd budget t.o.v. de referentie">Verschil</th>
                                        }
                                        <th class="bw-num" style="width:116px;">Correctie</th>
                                        <th class="bw-num" style="width:150px;">Gecorrigeerd</th>
                                    </tr>
                                </thead>
                                @foreach (var lot in lotenMetBedrag)
                                {
                                    var lijnenMetBedrag = lot.Lijnen.Where(l => l.TotaalAlternatief > 0).ToList();
                                    <tbody class="actlijn-lot" data-lot="@lot.LotNummer.ToString("G", ic)">
                                        <tr class="actlijn-lot__head">
                                            <th colspan="2">
                                                <button type="button" class="actlijn-lot__toggle" aria-expanded="true">
                                                    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                                                    <span class="badge bg-primary">Lot @lot.LotNummer.ToString("G", ic)</span>
                                                    @lot.LotNaam
                                                    <span class="text-muted fw-normal ms-1">· @lijnenMetBedrag.Count</span>
                                                </button>
                                            </th>
                                            @if (toonRef)
                                            {
                                                var lotRef = LotReferentie(lot);
                                                <th class="bw-num actlijn-lot__ref">@(lotRef > 0 ? "€ " + Eur2(lotRef) : "")</th>
                                                <th class="bw-num lot-delta"></th>
                                            }
                                            <th></th>
                                            <th class="bw-num actlijn-lot__sum lot-gecorrigeerd">€ @Eur2(LotGecorrigeerd(lot))</th>
                                        </tr>
                                        @foreach (var lijn in lijnenMetBedrag)
                                        {
                                            @await Html.PartialAsync("Partials/_ActivityLijnRow", lijn)
                                        }
                                    </tbody>
                                }
                                <tfoot>
                                    <tr>
                                        <td colspan="2">Totaal activiteiten</td>
                                        @if (toonRef)
                                        {
                                            <td class="bw-num actlijn-lot__ref">€ @Eur2(totaalReferentie)</td>
                                            <td class="bw-num lot-delta" id="actGrandDelta"></td>
                                        }
                                        <td></td>
                                        <td class="bw-num"><strong id="actGrand">€ @Eur2(totaalGecorrigeerd)</strong></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                }
            </form>
            </div>@* /bw-scroll *@

            @* ── Onderaan: opslaan + navigeren ── *@
            <div class="bw-bottom-nav">
                <a href="@Url.Action("BudgetDakAfbraak", "Projecten", new { versieId = Model.BudgetVersieId })" class="bw-bottom-nav__back">
                    <i class="fas fa-chevron-left me-1"></i>Vorige: Dak &amp; Afbraak
                </a>
                <span class="bw-bottom-nav__indicator">Stap 6 van 9 — Activiteiten</span>
                <div class="d-flex gap-2 align-items-center">
                    <button type="button" id="btnSaveActivity" form="frmActivityLijnen" class="btn btn-light border">
                        <i class="fa-solid fa-floppy-disk me-1"></i>Opslaan
                    </button>
                    <a href="@Url.Action("BudgetParams", "Projecten", new { versieId = Model.BudgetVersieId })" class="bw-bottom-nav__next">
                        Volgende: Parameters <i class="fas fa-chevron-right ms-1"></i>
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>

@section PageScripts {
<script src="~/js/budget-wizard.js" asp-append-version="true"></script>
<script>
    // Voorstel-popovers (rekendetail per activiteit)
    document.querySelectorAll('[data-bs-toggle="popover"]').forEach(el => new bootstrap.Popover(el, { sanitize: false }));

    const versieId    = @Model.BudgetVersieId;
    const oppGBA      = @Fmt(Model.OppervlakteGBA);
    const antiForgery = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    const nf2 = { minimumFractionDigits: 2, maximumFractionDigits: 2 };
    const eur2 = v => '€ ' + (v || 0).toLocaleString('nl-BE', nf2);
    const eur0 = v => '€ ' + Math.round(v || 0).toLocaleString('nl-BE');

    function rowGecorrigeerd(tr) {
        const basis = parseFloat(tr.dataset.basis) || 0;
        const pct   = parseFloat(tr.querySelector('.corr-pct').value);
        return basis * (isNaN(pct) ? 1 : pct / 100);
    }

    // Verschil gecorrigeerd t.o.v. referentie, als "+8,2 %" met kleur (hoger = rood, lager = groen)
    function zetDelta(el, bedrag, ref) {
        if (!el) return;
        el.classList.remove('is-hoger', 'is-lager', 'is-gelijk');
        if (!(ref > 0)) { el.textContent = ''; return; }
        const d = (bedrag - ref) / ref * 100;
        el.classList.add(Math.abs(d) < 0.5 ? 'is-gelijk' : (d > 0 ? 'is-hoger' : 'is-lager'));
        el.textContent = (d > 0 ? '+' : (d < 0 ? '\u2212' : '')) + Math.abs(d).toLocaleString('nl-BE', { maximumFractionDigits: 1 }) + ' %';
    }

    // ── Herbereken: rij-bedrag → lot-subtotaal → eindtotaal + KPI ─────────
    function recalc() {
        let grand = 0, grandRef = 0;
        document.querySelectorAll('.actlijn-lot').forEach(lot => {
            let lotSum = 0, lotRef = 0;
            lot.querySelectorAll('.act-row').forEach(tr => {
                const g = rowGecorrigeerd(tr);
                lotSum += g;
                tr.querySelector('.act-row__gecorrigeerd').textContent = eur2(g);
                const ref = parseFloat(tr.dataset.refTotaal) || 0;
                if (ref > 0) lotRef += ref;
                zetDelta(tr.querySelector('.act-row__delta'), g, ref);
            });
            grand += lotSum; grandRef += lotRef;
            const lotEl = lot.querySelector('.lot-gecorrigeerd');
            if (lotEl) lotEl.textContent = eur2(lotSum);
            zetDelta(lot.querySelector('.lot-delta'), lotSum, lotRef);
        });
        const grandEl = document.getElementById('actGrand');
        if (grandEl) grandEl.textContent = eur2(grand);
        zetDelta(document.getElementById('actGrandDelta'), grand, grandRef);
        zetDelta(document.getElementById('kpiRefDelta'), grand, grandRef);
        document.getElementById('kpiTotaal').textContent = eur0(grand);
        document.getElementById('kpiM2').textContent =
            '€ ' + (oppGBA > 0 ? grand / oppGBA : 0).toLocaleString('nl-BE', nf2);
    }

    document.addEventListener('input', e => {
        if (e.target.classList.contains('corr-pct')) recalc();
    });
    // Referentie overnemen: correctie-% zo dat gecorrigeerd = referentie
    document.addEventListener('click', e => {
        const btn = e.target.closest('.act-row__overnemen');
        if (!btn) return;
        const tr = btn.closest('.act-row');
        const basis = parseFloat(tr.dataset.basis) || 0, ref = parseFloat(tr.dataset.refTotaal) || 0;
        if (!(basis > 0) || !(ref > 0)) return;
        tr.querySelector('.corr-pct').value = Math.round(ref / basis * 1000) / 10;
        recalc();
    });
    recalc();

    // ── Lot in-/uitklappen ────────────────────────────────────────────────
    document.querySelectorAll('.actlijn-lot__toggle').forEach(btn => {
        btn.addEventListener('click', () => {
            const lot = btn.closest('.actlijn-lot');
            const collapsed = lot.classList.toggle('actlijn-lot--collapsed');
            btn.setAttribute('aria-expanded', String(!collapsed));
        });
    });

    // ── Opslaan ────────────────────────────────────────────────────────────
    $('#btnSaveActivity').on('click', function () {
        const lijnen = [];
        document.querySelectorAll('.act-row').forEach(tr => {
            const pct = parseFloat(tr.querySelector('.corr-pct').value);
            lijnen.push({
                activityId:                  parseInt(tr.dataset.activityId),
                alternatievePrijsPerEenheid: parseFloat(tr.dataset.prijs)  || 0,
                // nacalc = referentieprijs per eenheid (geïndexeerd) als er referenties zijn, anders de bewaarde waarde
                nacalcPrijsPerEenheid:       parseFloat(tr.dataset.ref) || parseFloat(tr.dataset.nacalc) || 0,
                correctiefactor:             isNaN(pct) ? 1 : pct / 100,
                isManueel:                   tr.dataset.manueel === 'true'
            });
        });

        $.ajax({
            url:         '@Url.Action("SaveActivityLijnen", "Projecten")',
            method:      'POST',
            contentType: 'application/json',
            data:        JSON.stringify({ budgetVersieId: versieId, lijnen: lijnen }),
            success: function (result) {
                if (result.success) {
                    if (typeof toastr !== 'undefined') toastr.success('Activiteiten opgeslagen.');
                    else alert('Opgeslagen.');
                } else {
                    if (typeof toastr !== 'undefined') toastr.error(result.message || 'Fout bij opslaan.');
                    else alert('Fout: ' + (result.message || 'onbekend'));
                }
            },
            error: function () {
                if (typeof toastr !== 'undefined') toastr.error('Verbindingsfout.');
                else alert('Verbindingsfout.');
            }
        });
    });
</script>
}
