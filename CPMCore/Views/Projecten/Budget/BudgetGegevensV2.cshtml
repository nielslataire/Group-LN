@model CPMCore.Models.Projecten.BudgetGegevensModel
@using CPMCore.Models.Budget
@using CPMCore.Models.GlV2
@using ServiceCore.Budget
@*
    gl-v2 — Budgetflow stap 1 · Gegevens (design-handoff 39b): aantallen, dimensies en indexering in sectiekaarten met velden met eenheid,
    rechts de live berekening van de geïndexeerde materiaalprijzen. Opslaan gebeurt automatisch (gl-v2-budget.js: debounce + flush bij
    navigeren) via dezelfde actie als de klassieke pagina (BudgetGegevensOpslaan); de basisprijzen komen nog steeds uit de gekoppelde
    kostprijsmaterialen (BudgetActivityFormuleService). Wat nieuw is t.o.v. de klassieke pagina: Grondwerk heeft eenheid m³ (was m²),
    peildatum + bron onder de S- en I-index, "leeg — grondwerken worden niet berekend" als hint.
*@
@{
    var ch = (BudgetWizardChromeVm)ViewData["Chrome"];
    ViewData["Title"] = ch.StepTitle;
    ViewData["PageIcon"] = "ph ph-info";
    ViewData["GlV2FullHeightBody"] = true;
    ViewData["BackUrl"] = ch.OverviewUrl;
    var g = Model.Gegevens;
    var nl = new System.Globalization.CultureInfo("nl-BE");
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var poortMld = ch.Op("Gegevens.TypePoorten", "veld");
    var dakMld = ch.Op("Gegevens.TypeDak", "veld");
    var sMld = ch.Op("Gegevens.SIndexHuidig", "veld");
    var iMld = ch.Op("Gegevens.IIndexHuidig", "veld");

    Model.FormulaVoorstellingen.TryGetValue(FormulaSleutels.NacalcRuwbouwBasis, out var fRuwbouw);
    Model.FormulaVoorstellingen.TryGetValue(FormulaSleutels.BovenbouwGevelmetselwerk, out var fGevel);
    Model.FormulaVoorstellingen.TryGetValue(FormulaSleutels.BovenbouwGipsblokken, out var fGips);
    Model.FormulaVoorstellingen.TryGetValue(FormulaSleutels.BovenbouwTerras, out var fTerras);
    var materialen = new[]
    {
        (Key: "ruwbouw", Label: "Ruwbouw",          Name: "Gegevens.NacalcBasisprijs",          Value: g.NacalcBasisprijs,          Unit: "/m²", F: fRuwbouw),
        (Key: "gevel",   Label: "Gevelmetselwerk",  Name: "Gegevens.GevelMetselwerkPrijsPerM2", Value: g.GevelMetselwerkPrijsPerM2, Unit: "/m²", F: fGevel),
        (Key: "gips",    Label: "Gipsblokken",      Name: "Gegevens.GipswerkenPrijsPerM2",      Value: g.GipswerkenPrijsPerM2,      Unit: "/st", F: fGips),
        (Key: "terras",  Label: "Terras",           Name: "Gegevens.TerrasPrijsPerM2",          Value: g.TerrasPrijsPerM2,          Unit: "/m²", F: fTerras),
    };
    string Dec(decimal? v) => v.HasValue ? v.Value.ToString("F4", inv) : "null";
    var dakItems = Model.TypeDakOptions.Select(o => new GlV2SelectItem { Value = o.Value, Text = o.Text }).ToList();
    var poortItems = Model.TypePoortenOptions.Select(o => new GlV2SelectItem { Value = o.Value, Text = o.Text }).ToList();
}
@section PageStyle
{
    <link rel="stylesheet" href="~/css/gl-v2-project-inner-menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-budget.css" asp-append-version="true" />
}
@section ProjectMenu
{
    @await Html.PartialAsync("GlV2/_ProjectInnerMenuV2", ch.Menu)
}
@{ var menuPhone = new GlV2ProjectMenuVm { ProjectId = ch.Menu.ProjectId, ProjectName = ch.Menu.ProjectName, ProjectSubtitle = ch.Menu.ProjectSubtitle, Mode = GlV2ProjectMenuMode.Phone }; }
@await Html.PartialAsync("GlV2/_ProjectInnerMenuV2", menuPhone)
@section PageTitleBadges
{
    <span class="gl-v2-badge @(ch.IsLocked ? "is-blocked" : "is-neutral")">@ch.BadgeTekst</span>
}

<div class="gl-v2-bw @(ch.IsLocked ? "is-locked" : "")">
    @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwStappen.cshtml", ch)

    <form id="bw-form" method="post" asp-action="BudgetGegevens" asp-controller="Projecten" class="gl-v2-bw-form" autocomplete="off"
          data-save-url="@Url.Action("BudgetGegevensOpslaan", "Projecten")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="VersieId" value="@Model.VersieId" />
        <input type="hidden" name="MasterId" value="@Model.MasterId" />
        <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
        <input type="hidden" name="ProjectName" value="@Model.ProjectName" />
        <input type="hidden" name="MasterNaam" value="@Model.MasterNaam" />
        <input type="hidden" name="VersieLabel" value="@Model.VersieLabel" />
        <input type="hidden" name="VersieStatus" value="@Model.VersieStatus" />

        <div class="gl-v2-bw-scroll">
        @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwKaders.cshtml", ch)
            <div class="gl-v2-bw-cols">
                <div style="display:flex;flex-direction:column;gap:16px;min-width:0">
                    <section class="gl-v2-section-card">
                        <div class="gl-v2-section-card-header">
                            <span class="gl-v2-section-card-icon"><i class="ph ph-info" aria-hidden="true"></i></span>
                            <h2 class="gl-v2-section-card-title">Projectgegevens</h2>
                            <span class="gl-v2-field-divider"></span>
                            <span class="gl-v2-section-card-desc">deze waarden voeden alle volgende stappen</span>
                        </div>
                        <div class="gl-v2-bw-grid gl-v2-bw-grid--4">
                            <span class="gl-v2-bw-subhead">Aantallen</span>
                            <div class="gl-v2-notice gl-v2-notice-compact is-info" style="grid-column:1/-1"><i class="ph ph-info" aria-hidden="true"></i><span>Aantal en samenstelling van de eenheden komen uit stap 2 — Oppervlaktes. <a href="@Url.Action("BudgetOppervlaktes", "Projecten", new { versieId = Model.VersieId })" data-bw-nav="next">Naar stap 2</a></span></div>
                            @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwNum.cshtml", BwNumVm.Maak("Gegevens.AantalLiften", "Liften", g.AantalLiften, "st", 0))
                            @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwNum.cshtml", BwNumVm.Maak("Gegevens.AantalBinnentrappen", "Binnentrappen", g.AantalBinnentrappen, "st", 0))
                            @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwNum.cshtml", BwNumVm.Maak("Gegevens.AantalTrapzalen", "Trapzalen", g.AantalTrapzalen, "st", 0))
                            @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwNum.cshtml", BwNumVm.Maak("Gegevens.AantalToegangspoorten", "Toegangspoorten", g.AantalToegangspoorten, "st", 0))
                            @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwNum.cshtml", BwNumVm.Maak("Gegevens.AantalAanTeBouwenBuren", "Aan te bouwen buren", g.AantalAanTeBouwenBuren, "st", 0))
                            @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwNum.cshtml", BwNumVm.Maak("Gegevens.AantalBovengrondseVerdiepingen", "Bovengrondse verdiepingen", g.AantalBovengrondseVerdiepingen, "st", 0))
                            @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwNum.cshtml", BwNumVm.Maak("Gegevens.AantalVerdiepingenOndergronds", "Ondergrondse verdiepingen", g.AantalVerdiepingenOndergronds, "st", 0))
                            @await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm
                            {
                                Name = "Gegevens.TypePoorten", Id = "bw-typepoorten", Label = "Type poorten", Value = g.TypePoorten ?? "", Items = poortItems, Placeholder = "Kies type poorten…",
                                Warning = poortMld?.Type == ServiceCore.Budget.MeldingType.Waarschuwing ? poortMld.Tekst : null, Error = poortMld?.Type == ServiceCore.Budget.MeldingType.Fout ? poortMld.Tekst : null
                            })

                            <span class="gl-v2-bw-subhead">Dimensies</span>
                            @{
                                // Herleidbare oppervlaktes (lijnen) en automatisch grondwerk — migratie 089
                                var fundLijnen = ServiceCore.Budget.GrondwerkRekenregel.Lees(g.FunderingLijnenJson);
                                var onderLijnen = ServiceCore.Budget.GrondwerkRekenregel.Lees(g.OndergrondsLijnenJson);
                                var fundWaarde = g.OppFunderingen; var onderWaarde = g.OppOndergronds;
                                var fundMld = ch.Op("Gegevens.OppFunderingen", "veld"); var onderMld = ch.Op("Gegevens.OppOndergronds", "veld");
                                var dF = g.DiepteFunderingCm ?? ServiceCore.Budget.GrondwerkRekenregel.StandaardDiepteFunderingCm;
                                var dV = g.DiepteOndergrondsCm ?? ServiceCore.Budget.GrondwerkRekenregel.StandaardDiepteOndergrondsCm;
                                string LijnJson(List<ServiceCore.Budget.GrondwerkRekenregel.Lijn> l) => System.Text.Json.JsonSerializer.Serialize(l.Select(x => new { omschrijving = x.Omschrijving, aantal = x.Aantal, oppervlakte = x.Oppervlakte }));
                                var fundJson = LijnJson(fundLijnen); var onderJson = LijnJson(onderLijnen);
                            }
                            <div class="gl-v2-field@(fundMld?.Type == ServiceCore.Budget.MeldingType.Fout ? " is-error" : fundMld != null ? " is-warning" : "")">
                                <label class="gl-v2-field-label" for="bw-oppfund">Oppervlakte funderingen</label>
                                <div class="gl-v2-field-attached">
                                    <div class="gl-v2-field-box">
                                        <input type="text" inputmode="decimal" id="bw-oppfund" name="Gegevens.OppFunderingen" value="@(fundWaarde.HasValue ? fundWaarde.Value.ToString("F2", nl) : "")" placeholder="0,00" autocomplete="off" class="gl-v2-field-input is-num is-tabular" @(fundLijnen.Count > 0 ? "readonly" : "") />
                                        <i class="ph ph-warning gl-v2-field-state-icon is-w" aria-hidden="true"></i><i class="ph ph-warning-circle gl-v2-field-state-icon is-e" aria-hidden="true"></i>
                                        <span class="gl-v2-field-unit">m²</span>
                                    </div>
                                    <button type="button" class="gl-v2-field-attach-btn" id="bw-fund-toggle" aria-expanded="false" aria-controls="bw-fund-panel" data-bw-keep><i class="ph ph-calculator" aria-hidden="true"></i><span>Berekening</span></button>
                                </div>
                                <span class="gl-v2-field-help" id="bw-fund-help">@(fundMld != null ? fundMld.Tekst : fundLijnen.Count > 0 ? $"som van {fundLijnen.Count} regel{(fundLijnen.Count == 1 ? "" : "s")}" : "rechtstreeks ingevuld — open de berekening om per type op te tellen")</span>
                            </div>
                            @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwNum.cshtml", new BwNumVm { Name = "Gegevens.DiepteFunderingCm", Label = "Diepte fundering", Value = dF, Unit = "cm", Decimals = 0, Help = "standaard 40 cm" })
                            <div class="gl-v2-field@(onderMld?.Type == ServiceCore.Budget.MeldingType.Fout ? " is-error" : onderMld != null ? " is-warning" : "")">
                                <label class="gl-v2-field-label" for="bw-opponder">Oppervlakte ondergrondse verdiepingen</label>
                                <div class="gl-v2-field-attached">
                                    <div class="gl-v2-field-box">
                                        <input type="text" inputmode="decimal" id="bw-opponder" name="Gegevens.OppOndergronds" value="@(onderWaarde.HasValue ? onderWaarde.Value.ToString("F2", nl) : "")" placeholder="0,00" autocomplete="off" class="gl-v2-field-input is-num is-tabular" @(onderLijnen.Count > 0 ? "readonly" : "") />
                                        <i class="ph ph-warning gl-v2-field-state-icon is-w" aria-hidden="true"></i><i class="ph ph-warning-circle gl-v2-field-state-icon is-e" aria-hidden="true"></i>
                                        <span class="gl-v2-field-unit">m²</span>
                                    </div>
                                    <button type="button" class="gl-v2-field-attach-btn" id="bw-onder-toggle" aria-expanded="false" aria-controls="bw-onder-panel" data-bw-keep><i class="ph ph-calculator" aria-hidden="true"></i><span>Berekening</span></button>
                                </div>
                                <span class="gl-v2-field-help" id="bw-onder-help">@(onderMld != null ? onderMld.Tekst : onderLijnen.Count > 0 ? $"som van {onderLijnen.Count} regel{(onderLijnen.Count == 1 ? "" : "s")}" : "totaal van alle ondergrondse verdiepingen — leeg = aantal × oppervlakte funderingen")</span>
                            </div>
                            @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwNum.cshtml", new BwNumVm { Name = "Gegevens.DiepteOndergrondsCm", Label = "Diepte per ondergrondse verdieping", Value = dV, Unit = "cm", Decimals = 0, Help = "standaard 300 cm" })
                            @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwNum.cshtml", new BwNumVm { Name = "Gegevens.M3Grondwerk", Id = "bw-grondwerk", Label = "Grondwerk (automatisch)", Value = g.M3Grondwerk, Unit = "m³", Attrs = "readonly tabindex=\"-1\"", Help = "oppervlakte × diepte" })
                            <div class="bw-fund-panel" id="bw-fund-panel" hidden>
                                <div class="bw-fund-head"><i class="ph ph-calculator" aria-hidden="true"></i><strong>Berekening oppervlakte funderingen</strong><span class="gl-v2-bw-hint">per type: aantal × oppervlakte per stuk; de som is de oppervlakte funderingen</span></div>
                                <div class="gl-v2-bw-table-wrap">
                                    <table class="gl-v2-bw-table">
                                        <thead><tr><th>Omschrijving</th><th class="is-num">Aantal</th><th class="is-num">m² per stuk</th><th class="is-num">Totaal m²</th><th class="col-actions"></th></tr></thead>
                                        <tbody id="bw-fund-body"></tbody>
                                        <tfoot><tr><td colspan="3">Totaal</td><td class="is-num" id="bw-fund-tot">0,00</td><td></td></tr></tfoot>
                                    </table>
                                </div>
                                <div class="bw-fund-foot"><button type="button" class="gl-v2-btn gl-v2-btn-secondary" id="bw-fund-add" data-bw-edit><i class="ph ph-plus" aria-hidden="true"></i>Regel toevoegen</button></div>
                            </div>
                            <div class="bw-fund-panel" id="bw-onder-panel" hidden>
                                <div class="bw-fund-head"><i class="ph ph-calculator" aria-hidden="true"></i><strong>Berekening oppervlakte ondergrondse verdiepingen</strong><span class="gl-v2-bw-hint">per verdieping of type: aantal × oppervlakte; de som is het totaal van alle ondergrondse verdiepingen</span></div>
                                <div class="gl-v2-bw-table-wrap">
                                    <table class="gl-v2-bw-table">
                                        <thead><tr><th>Omschrijving</th><th class="is-num">Aantal</th><th class="is-num">m² per stuk</th><th class="is-num">Totaal m²</th><th class="col-actions"></th></tr></thead>
                                        <tbody id="bw-onder-body"></tbody>
                                        <tfoot><tr><td colspan="3">Totaal</td><td class="is-num" id="bw-onder-tot">0,00</td><td></td></tr></tfoot>
                                    </table>
                                </div>
                                <div class="bw-fund-foot"><button type="button" class="gl-v2-btn gl-v2-btn-secondary" id="bw-onder-add" data-bw-edit><i class="ph ph-plus" aria-hidden="true"></i>Regel toevoegen</button></div>
                            </div>
                            <input type="hidden" name="Gegevens.FunderingLijnenJson" id="bw-fund-json" value="@fundJson" />
                            <input type="hidden" name="Gegevens.OndergrondsLijnenJson" id="bw-onder-json" value="@onderJson" />
                            <script type="application/json" id="bw-fund-data">@Html.Raw(fundJson)</script>
                            <script type="application/json" id="bw-onder-data">@Html.Raw(onderJson)</script>
                            @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwNum.cshtml", BwNumVm.Maak("Gegevens.LmBerlinerwanden", "Berlinerwanden", g.LmBerlinerwanden, "lm"))
                            @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwNum.cshtml", BwNumVm.Maak("Gegevens.LmSecanpalen", "Secanspalen", g.LmSecanpalen, "lm"))
                            @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwNum.cshtml", BwNumVm.Maak("Gegevens.M3Onderschoeiingen", "Onderschoeiingen", g.M3Onderschoeiingen, "m³"))
                            @await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm { Name = "Gegevens.TypeDak", Id = "bw-typedak", Label = "Type dak", Value = g.TypeDak ?? "", Items = dakItems, Placeholder = "Kies type dak…", Error = dakMld?.Type == ServiceCore.Budget.MeldingType.Fout ? dakMld.Tekst : null })
                        </div>
                    </section>

                    <section class="gl-v2-section-card">
                        <div class="gl-v2-section-card-header">
                            <span class="gl-v2-section-card-icon"><i class="ph ph-chart-line-up" aria-hidden="true"></i></span>
                            <h2 class="gl-v2-section-card-title">Bouwkostindexering (S/I)</h2>
                            <span class="gl-v2-field-divider"></span>
                            <span class="gl-v2-section-card-desc">nacalc-basisprijs per materiaal, gekoppeld aan een activiteit</span>
                        </div>
                        <div class="gl-v2-bw-grid gl-v2-bw-grid--4">
                            @foreach (var m in materialen)
                            {
                                var basis = m.F?.MateriaalPrijs;
                                var koppelHelp = basis.HasValue
                                    ? $"basisprijs {m.Label}: € {basis.Value.ToString("N2", nl)}{m.Unit}" + (m.F!.MNaam != null ? " · " + m.F.MNaam : "")
                                    : (m.F != null ? "geen materiaal gekoppeld — stel in via Instellingen › Kostprijzen materialen" : null);
                                <div class="gl-v2-field">
                                    <label class="gl-v2-field-label" for="inp-@m.Key">@m.Label</label>
                                    <div class="gl-v2-field-box">
                                        <span class="gl-v2-field-prefix">€</span>
                                        <input type="text" inputmode="decimal" id="inp-@m.Key" name="@m.Name" value="@(m.Value.HasValue ? m.Value.Value.ToString("F2", nl) : "")" placeholder="0,00" autocomplete="off"
                                               class="gl-v2-field-input is-num is-tabular" data-bw-live data-base="@(basis.HasValue ? basis.Value.ToString("F2", nl) : "")" />
                                        <span class="gl-v2-field-unit">@m.Unit</span>
                                    </div>
                                    <span class="gl-v2-field-help">
                                        @koppelHelp
                                        @if (basis.HasValue)
                                        {
                                            <button type="button" class="gl-v2-btn gl-v2-btn-text" style="height:24px;padding:0 6px;margin-left:4px" data-bw-edit data-bw-take="inp-@m.Key" title="Basisprijs overnemen uit de gekoppelde kostprijsmaterialen">Overnemen</button>
                                        }
                                    </span>
                                </div>
                            }
                            <span class="gl-v2-bw-subhead">S-index (lonen) &amp; I-index (materialen)</span>
                            <div class="gl-v2-field gl-v2-bw-span2@(sMld != null ? " is-warning" : "")">
                                <label class="gl-v2-field-label" for="bw-sindex">S-index (lonen)</label>
                                <div class="gl-v2-field-attached">
                                    <div class="gl-v2-field-box">
                                        <input type="text" inputmode="decimal" id="bw-sindex" name="Gegevens.SIndexHuidig" value="@(g.SIndexHuidig.HasValue ? g.SIndexHuidig.Value.ToString("F4", nl) : "")" placeholder="bv. 119,1000" autocomplete="off" class="gl-v2-field-input is-num is-tabular" data-bw-live />
                                    </div>
                                    <button type="button" class="gl-v2-field-attach-btn" data-bw-edit data-bw-pick="S" aria-label="Kies S-index uit historiek"><i class="ph ph-clock-counter-clockwise" aria-hidden="true"></i><span>Historiek</span></button>
                                </div>
                                <span class="gl-v2-field-help">@(sMld != null ? sMld.Tekst : ViewData["SIndexInfo"])</span>
                            </div>
                            <div class="gl-v2-field gl-v2-bw-span2@(iMld != null ? " is-warning" : "")">
                                <label class="gl-v2-field-label" for="bw-iindex">I2021-index (materialen)</label>
                                <div class="gl-v2-field-attached">
                                    <div class="gl-v2-field-box">
                                        <input type="text" inputmode="decimal" id="bw-iindex" name="Gegevens.IIndexHuidig" value="@(g.IIndexHuidig.HasValue ? g.IIndexHuidig.Value.ToString("F4", nl) : "")" placeholder="bv. 123,5000" autocomplete="off" class="gl-v2-field-input is-num is-tabular" data-bw-live />
                                    </div>
                                    <button type="button" class="gl-v2-field-attach-btn" data-bw-edit data-bw-pick="I2021" aria-label="Kies I2021-index uit historiek"><i class="ph ph-clock-counter-clockwise" aria-hidden="true"></i><span>Historiek</span></button>
                                </div>
                                <span class="gl-v2-field-help">@(iMld != null ? iMld.Tekst : ViewData["IIndexInfo"])</span>
                            </div>
                        </div>
                    </section>
                </div>

                <aside>
                    <section class="gl-v2-section-card">
                        <div class="gl-v2-section-card-header">
                            <span class="gl-v2-section-card-icon"><i class="ph ph-calculator" aria-hidden="true"></i></span>
                            <h2 class="gl-v2-section-card-title">Live berekening</h2>
                            <span class="gl-v2-section-card-meta" style="margin-left:auto"><span class="gl-v2-badge is-positive">LIVE</span></span>
                        </div>
                        <div style="padding:16px 20px 20px;display:flex;flex-direction:column;gap:12px">
                            <div class="gl-v2-bw-live">
                                @foreach (var m in materialen)
                                {
                                    <div class="gl-v2-bw-live-row"><span>@m.Label @m.Unit geïnd.</span><strong id="live-@m.Key">—</strong></div>
                                }
                            </div>
                            <span class="gl-v2-bw-live-formula">(I/I₀)×0,40 + (S/S₀)×0,40 + 0,20</span>
                        </div>
                    </section>
                </aside>
            </div>
        </div>
    </form>

    @await Html.PartialAsync("~/Views/Projecten/Budget/V2/_BwActiebalk.cshtml", ch)
</div>

@* Indexwaarde kiezen uit de historiek *@
<div class="modal fade gl-v2-modal-form" id="bw-index-modal" tabindex="-1" aria-hidden="true" aria-labelledby="bw-index-title">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
        <div class="modal-content">
            <div class="modal-header"><h2 class="modal-title" id="bw-index-title">Kies indexwaarde</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button></div>
            <div class="modal-body">@await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm { Name = "bw-index-pick", Id = "bw-index-pick", Label = "Indexwaarde", Placeholder = "Kies een indexwaarde…", Items = new List<GlV2SelectItem>() })</div>
            <div class="modal-footer">
                <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
                <button type="button" class="gl-v2-btn gl-v2-btn-primary" id="bw-index-ok">Overnemen</button>
            </div>
        </div>
    </div>
</div>

@section PageScripts
{
<script src="~/js/gl-v2-budget.js" asp-append-version="true"></script>
<script>
(function () {
    var form = document.getElementById('bw-form');
    var refs = {
        ruwbouw: { i: @(Dec(fRuwbouw?.MateriaalIRef ?? 100m)), s: @(Dec(fRuwbouw?.MateriaalSRef ?? 100m)) },
        gevel:   { i: @(Dec(fGevel?.MateriaalIRef ?? 100m)),   s: @(Dec(fGevel?.MateriaalSRef ?? 100m)) },
        gips:    { i: @(Dec(fGips?.MateriaalIRef ?? 100m)),    s: @(Dec(fGips?.MateriaalSRef ?? 100m)) },
        terras:  { i: @(Dec(fTerras?.MateriaalIRef ?? 100m)),  s: @(Dec(fTerras?.MateriaalSRef ?? 100m)) }
    };
    var nf = new Intl.NumberFormat('nl-BE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    function num(el) { if (!el) return 0; var v = String(el.value || '').replace(/\s/g, '').replace(/\.(?=\d{3}(\D|$))/g, '').replace(',', '.'); var n = parseFloat(v); return isNaN(n) ? 0 : n; }

    function live() {
        var s = num(document.getElementById('bw-sindex')), i = num(document.getElementById('bw-iindex')), ok = s > 0 && i > 0;
        Object.keys(refs).forEach(function (k) {
            var p = num(document.getElementById('inp-' + k));
            var f = ok ? (i / refs[k].i) * 0.40 + (s / refs[k].s) * 0.40 + 0.20 : 1;
            document.getElementById('live-' + k).textContent = p > 0 ? '€ ' + nf.format(p * f) : '—';
        });
    }
    form.addEventListener('input', function (e) { if (e.target.matches('[data-bw-live]')) live(); });

    // ── Herleidbare oppervlaktes (lijnen) en grondwerk (automatisch) ─────────────────────────────────────────
    (function () {
        var nfm = new Intl.NumberFormat('nl-BE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        function getal(v) { v = String(v == null ? '' : v).replace(/\s/g, '').replace(/\.(?=\d{3}(\D|$))/g, '').replace(',', '.'); var n = parseFloat(v); return isNaN(n) ? 0 : n; }
        function rond(n) { return Math.round(n * 100) / 100; }
        function veld(cls, val, ph, breed) { return '<div class="gl-v2-field gl-v2-field-bare"><div class="gl-v2-field-box"' + (breed ? ' style="width:' + breed + 'px;margin-left:auto"' : '') + '><input type="text" class="gl-v2-field-input ' + (breed ? 'is-num is-tabular ' : '') + cls + '" value="' + val + '" placeholder="' + ph + '" autocomplete="off"' + (breed ? ' inputmode="decimal"' : ' maxlength="80"') + ' /></div></div>'; }
        var g3 = document.getElementById('bw-grondwerk'), lijsten = [];
        function maak(pf, leegTekst) {
            var panel = document.getElementById('bw-' + pf + '-panel'), body = document.getElementById('bw-' + pf + '-body'), toggle = document.getElementById('bw-' + pf + '-toggle'), json = document.getElementById('bw-' + pf + '-json');
            var opp = document.getElementById('bw-opp' + pf), help = document.getElementById('bw-' + pf + '-help'), tot = document.getElementById('bw-' + pf + '-tot');
            if (!panel || !opp) return null;
            function rij(l) {
                var tr = document.createElement('tr');
                tr.innerHTML = '<td style="min-width:200px">' + veld('lj-o', (l.omschrijving || '').replace(/"/g, '&quot;'), 'bv. Woningen type A') + '</td><td class="is-num">' + veld('lj-a', l.aantal ? String(l.aantal).replace('.', ',') : '', '1', 90) + '</td><td class="is-num">' + veld('lj-m', l.oppervlakte ? nfm.format(l.oppervlakte) : '', '0,00', 110) + '</td><td class="is-num is-strong lj-t">0,00</td><td class="col-actions"><button type="button" class="gl-v2-row-action gl-v2-row-action-danger lj-del" data-bw-edit title="Regel verwijderen" aria-label="Regel verwijderen"><i class="ph ph-trash" aria-hidden="true"></i><span class="gl-v2-row-action-label">Verwijderen</span></button></td>';
                body.appendChild(tr); return tr;
            }
            function lees() {
                var l = [];
                body.querySelectorAll('tr').forEach(function (tr) {
                    var o = tr.querySelector('.lj-o').value.trim(), a = getal(tr.querySelector('.lj-a').value), m = getal(tr.querySelector('.lj-m').value);
                    tr.querySelector('.lj-t').textContent = nfm.format(rond(a * m));
                    if (o || a || m) l.push({ omschrijving: o, aantal: a, oppervlakte: m });
                });
                return l;
            }
            function herreken() {
                var l = lees(), heeft = l.length > 0, som = rond(l.reduce(function (t, x) { return t + x.aantal * x.oppervlakte; }, 0));
                json.value = JSON.stringify(l); tot.textContent = nfm.format(som);
                if (heeft) { opp.value = nfm.format(som); opp.readOnly = true; help.textContent = 'som van ' + l.length + ' regel' + (l.length === 1 ? '' : 's'); }
                else { opp.readOnly = false; help.textContent = leegTekst; }
            }
            function wijzig() { herreken(); grond(); json.dispatchEvent(new Event('input', { bubbles: true })); }
            var data = []; try { data = JSON.parse(document.getElementById('bw-' + pf + '-data').textContent || '[]'); } catch (e) { }
            data.forEach(rij); herreken();
            if (data.length) { panel.hidden = false; toggle.setAttribute('aria-expanded', 'true'); }
            toggle.addEventListener('click', function () { var open = panel.hidden; panel.hidden = !open; toggle.setAttribute('aria-expanded', open ? 'true' : 'false'); });
            document.getElementById('bw-' + pf + '-add').addEventListener('click', function () {
                // Het eerste regeltje neemt een eerder rechtstreeks ingevuld getal over, zodat het niet verloren gaat
                if (!body.children.length && getal(opp.value) > 0) rij({ omschrijving: 'Eerder ingevuld', aantal: 1, oppervlakte: getal(opp.value) });
                var tr = rij({ aantal: 1 }); wijzig(); tr.querySelector('.lj-o').focus();
            });
            body.addEventListener('click', function (e) { var b = e.target.closest('.lj-del'); if (!b) return; b.closest('tr').remove(); wijzig(); });
            return { herreken: herreken, opp: opp };
        }
        function grond() {
            var fund = document.getElementById('bw-oppfund'), onder = document.getElementById('bw-opponder');
            var f = form.elements['Gegevens.DiepteFunderingCm'].value, v = form.elements['Gegevens.DiepteOndergrondsCm'].value, n = parseInt(form.elements['Gegevens.AantalVerdiepingenOndergronds'].value, 10) || 0;
            var dF = String(f).trim() === '' ? 40 : getal(f), dV = String(v).trim() === '' ? 300 : getal(v), a1 = getal(fund.value);
            var leegOnder = String(onder.value).trim() === '', a2 = leegOnder ? n * a1 : getal(onder.value);
            g3.value = nfm.format(rond((a1 * dF + a2 * dV) / 100));
            var gw = g3.closest('.gl-v2-field'); if (gw) gw.classList.remove('is-warning', 'is-error');   // automatisch veld: nooit zelf in waarschuwing
            if (a1 > 0) { var fw = fund.closest('.gl-v2-field'); if (fw) fw.classList.remove('is-warning'); }   // de waarschuwing 'funderingen leeg' verdwijnt meteen
            var gh = g3.closest('.gl-v2-field').querySelector('.gl-v2-field-help');
            if (gh) gh.textContent = '= ' + nfm.format(a1) + ' m² × ' + nfm.format(dF / 100) + ' m' + (a2 > 0 ? ' + ' + nfm.format(a2) + ' m² × ' + nfm.format(dV / 100) + ' m' : '');
        }
        if (g3) {
            lijsten.push(maak('fund', 'rechtstreeks ingevuld — open de berekening om per type op te tellen'));
            lijsten.push(maak('onder', 'totaal van alle ondergrondse verdiepingen — leeg = aantal × oppervlakte funderingen'));
            grond();
            form.addEventListener('input', function () { lijsten.forEach(function (l) { if (l) l.herreken(); }); grond(); });
        }
    })();

    live();

    // Basisprijs overnemen uit het gekoppelde materiaal
    document.addEventListener('click', function (e) {
        var b = e.target.closest('[data-bw-take]'); if (!b) return;
        var inp = document.getElementById(b.getAttribute('data-bw-take')); if (!inp) return;
        inp.value = inp.getAttribute('data-base'); live(); inp.dispatchEvent(new Event('input', { bubbles: true }));
    });
    // Leeg veld → de gekoppelde basisprijs als startwaarde (zoals de klassieke pagina)
    ['ruwbouw', 'gevel', 'gips', 'terras'].forEach(function (k) {
        var inp = document.getElementById('inp-' + k);
        if (inp && num(inp) === 0 && inp.getAttribute('data-base')) { inp.value = inp.getAttribute('data-base'); }
    });
    live();

    // Opslaan: automatisch (debounce) en vóór elke navigatie
    GlV2Budget.autosave(form, async function () {
        var r = await GlV2Budget.post(form.getAttribute('data-save-url'), new FormData(form), false);
        return !!r.success;
    }, 900);

    // Indexwaarde uit de historiek
    var modalEl = document.getElementById('bw-index-modal'), target = null, modal = null;
    document.addEventListener('click', async function (e) {
        var b = e.target.closest('[data-bw-pick]'); if (!b) return;
        target = b.getAttribute('data-bw-pick');
        var data = await (await fetch('@Url.Action("GetBouwIndexen", "Projecten")?type=' + encodeURIComponent(target), { credentials: 'same-origin' })).json();
        var items = data.map(function (d) { return { value: String(d.indexWaarde), text: d.jaar + (d.maand ? '/' + String(d.maand).padStart(2, '0') : '') + ' — ' + String(d.indexWaarde).replace('.', ',') }; });
        GlV2Select.setItems(document.getElementById('bw-index-pick_select'), items, items.length ? items[0].value : '', null);
        modal = modal || bootstrap.Modal.getOrCreateInstance(modalEl); modal.show();
    });
    document.getElementById('bw-index-ok').addEventListener('click', function () {
        var v = document.getElementById('bw-index-pick'); if (!v || !v.value) return;
        var inp = document.getElementById(target === 'S' ? 'bw-sindex' : 'bw-iindex');
        inp.value = String(v.value).replace('.', ','); live(); inp.dispatchEvent(new Event('input', { bubbles: true })); modal.hide();
    });
})();
</script>
}
