                                                    <tr>
                                                        <th style="min-width:90px;">Eenheid</th>
                                                        <th style="min-width:110px;">Beschrijving</th>
                                                        <th style="min-width:65px;">Aantal</th>
                                                        <th style="min-width:75px;">Breedte (m)</th>
                                                        <th style="min-width:75px;">Hoogte (m)</th>
                                                        <th style="min-width:75px;">—</th>
                                                        <th style="min-width:80px;" class="text-primary">m²</th>
                                                        <th style="width:44px;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody class="gevel-tbody" data-element-type="@etype">
                                                    @foreach (var rij in rijen)
                                                    {
                                                        @await Html.PartialAsync("Partials/_BudgetGevelRij", rij)
                                                    }
                                                </tbody>
                                                <tfoot class="table-secondary small fw-semibold">
                                                    <tr>
                                                        <td colspan="6" class="text-end">Totaal</td>
                                                        <td class="text-end text-primary gevel-totaal-cel" data-type="@etype">@Fmt(totaalType)</td>
                                                        <td></td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* ── TAB: RAMEN ── *@
                <div class="tab-pane fade" id="pane-ramen" role="tabpanel">
                    <div class="row g-3">
                        @foreach (var (etype, label) in new[] { ("RaamNieuwbouw","Ramen Nieuwbouw"), ("RaamBestaand","Ramen Bestaand") })
                        {
                            var rijen = Rijen(etype);
                            var totaalType = rijen.Sum(r => r.ResultaatM2);
                            <div class="col-lg-6">
                                <div class="card h-100">
                                    <div class="card-header d-flex justify-content-between align-items-center py-2">
                                        <strong>@label</strong>
                                        <span class="badge bg-primary gevel-badge" data-type="@etype">@Fmt(totaalType) m²</span>
                                    </div>
                                    <div class="card-body p-2">
                                        @await Html.PartialAsync("Partials/_GevelAddForm", (object)new ViewDataDictionary(ViewData) { { "ElementType", etype }, { "VersieId", Model.VersieId } })
                                        <div class="table-responsive mt-2">
                                            <table class="table table-hover table-sm table-bordered align-middle mb-0" style="min-width:500px;">
                                                <thead class="table-light small text-center">
                                                    <tr>
                                                        <th style="min-width:90px;">Eenheid</th>
                                                        <th style="min-width:110px;">Beschrijving</th>
                                                        <th style="min-width:65px;">Aantal</th>
                                                        <th style="min-width:75px;">Breedte (m)</th>
                                                        <th style="min-width:75px;">Hoogte (m)</th>
                                                        <th style="min-width:75px;">—</th>
                                                        <th style="min-width:80px;" class="text-primary">m²</th>
                                                        <th style="width:44px;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody class="gevel-tbody" data-element-type="@etype">
                                                    @foreach (var rij in rijen)
                                                    {
                                                        @await Html.PartialAsync("Partials/_BudgetGevelRij", rij)
                                                    }
                                                </tbody>
                                                <tfoot class="table-secondary small fw-semibold">
                                                    <tr>
                                                        <td colspan="6" class="text-end">Totaal</td>
                                                        <td class="text-end text-primary gevel-totaal-cel" data-type="@etype">@Fmt(totaalType)</td>
                                                        <td></td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* ── TAB: BALLUSTRADES & ZICHTSCHERMEN ── *@
                <div class="tab-pane fade" id="pane-ballust" role="tabpanel">
                    <div class="row g-3">
                        @foreach (var (etype, label, eenheid) in new[] {
                            ("Ballustrade","Balustrades","lm"), ("Zichtscherm","Zichtschermen","lm") })
                        {
                            var rijen = Rijen(etype);
                            var totaalType = rijen.Sum(r => r.ResultaatLm);
                            <div class="col-lg-6">
                                <div class="card h-100">
                                    <div class="card-header d-flex justify-content-between align-items-center py-2">
                                        <strong>@label</strong>
                                        <span class="badge bg-primary gevel-badge" data-type="@etype">@Fmt(totaalType) @eenheid</span>
                                    </div>
                                    <div class="card-body p-2">
                                        @await Html.PartialAsync("Partials/_GevelAddForm", (object)new ViewDataDictionary(ViewData) { { "ElementType", etype }, { "VersieId", Model.VersieId } })
                                        <div class="table-responsive mt-2">
                                            <table class="table table-hover table-sm table-bordered align-middle mb-0" style="min-width:450px;">
                                                <thead class="table-light small text-center">
                                                    <tr>
                                                        <th style="min-width:90px;">Locatie</th>
                                                        <th style="min-width:110px;">Beschrijving</th>
                                                        <th style="min-width:65px;">Aantal</th>
                                                        <th style="min-width:75px;">—</th>
                                                        <th style="min-width:75px;">—</th>
                                                        <th style="min-width:75px;">Lengte (m)</th>
                                                        <th style="min-width:80px;" class="text-primary">lm</th>
                                                        <th style="width:44px;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody class="gevel-tbody" data-element-type="@etype">
                                                    @foreach (var rij in rijen)
                                                    {
                                                        @await Html.PartialAsync("Partials/_BudgetGevelRij", rij)
                                                    }
                                                </tbody>
                                                <tfoot class="table-secondary small fw-semibold">
                                                    <tr>
                                                        <td colspan="6" class="text-end">Totaal</td>
                                                        <td class="text-end text-primary gevel-totaal-cel" data-type="@etype">@Fmt(totaalType)</td>
                                                        <td></td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @* ── TAB: DAK ── *@
                <div class="tab-pane fade" id="pane-dak" role="tabpanel">
                    <div class="accordion" id="accordionDak">
                        @{
                            var dakSections = new[]
                            {
                                ("PlatDak",         "Plat dak",           Model.Totaal.TotaalPlatDak,         "m²", true),
                                ("HellendDak",      "Hellend dak",        Model.Totaal.TotaalHellendDak,      "m²", false),
                                ("GroenDak",        "Groen dak",          Model.Totaal.TotaalGroenDak,        "m²", false),
                                ("Dakoversteken",   "Dakoversteken",      Model.Totaal.TotaalDakoversteken,   "m²", false),
                                ("OnderkantDoorrit","Onderkant doorrit",  Model.Totaal.TotaalOnderkantDoorrit,"m²", false),
                            };
