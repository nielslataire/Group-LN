                        @foreach (var (etype, label, totaalVal, eenheid, openDefault) in dakSections)
                        {
                            var rijen = Rijen(etype);
                            var collapseId = "acc-" + etype.ToLower();
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button @(openDefault ? "" : "collapsed")"
                                            type="button" data-bs-toggle="collapse"
                                            data-bs-target="#@collapseId" aria-expanded="@(openDefault ? "true" : "false")">
                                        <span class="me-2">@label</span>
                                        <span class="badge bg-secondary gevel-badge" data-type="@etype">
                                            @Fmt(totaalVal) @eenheid
                                        </span>
                                    </button>
                                </h2>
                                <div id="@collapseId" class="accordion-collapse collapse @(openDefault ? "show" : "")">
                                    <div class="accordion-body p-2">
                                        @await Html.PartialAsync("Partials/_GevelAddForm", (object)new ViewDataDictionary(ViewData) { { "ElementType", etype }, { "VersieId", Model.VersieId } })
                                        <div class="table-responsive mt-2">
                                            <table class="table table-hover table-sm table-bordered align-middle mb-0" style="min-width:500px;">
                                                <thead class="table-light small text-center">
                                                    <tr>
                                                        <th style="min-width:90px;">Locatie</th>
                                                        <th style="min-width:110px;">Beschrijving</th>
                                                        <th style="min-width:65px;">Aantal</th>
                                                        <th style="min-width:75px;">Breedte (m)</th>
                                                        <th style="min-width:75px;">—</th>
                                                        <th style="min-width:75px;">Lengte (m)</th>
                                                        <th style="min-width:80px;" class="text-primary">m²</th>
                                                        <th style="width:44px;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody class="gevel-tbody" data-element-type="@etype">
