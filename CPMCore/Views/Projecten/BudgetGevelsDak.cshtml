            </div>@* /tab-content *@

            @* ── Bottom actions ── *@
            <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
                <a href="@Url.Action("BudgetOppervlaktes", "Projecten", new { versieId = Model.VersieId })"
                   class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Vorige stap
                </a>
                <button class="btn btn-secondary" disabled title="Volgende stap nog niet beschikbaar">
                    Volgende stap <i class="fas fa-arrow-right ms-1"></i>
                </button>
            </div>

        </div>
    </div>
</section>

@section PageScripts {
<script src="~/js/budget-wizard.js"></script>
<script>
    BudgetWizard.initCalcToggle('toggleBerek3');

    const ANTI = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const versieId = @Model.VersieId;

    const TYPES_HOOGTE       = ['GevelNieuwbouw','GevelBestaand','RaamNieuwbouw','RaamBestaand'];
    const TYPES_LENGTE_ALLEEN = ['Ballustrade','Zichtscherm'];

    const fmtNL = BudgetWizard.fmtNL;

    // ── Sectietab-state in sessionStorage ────────────────────────────────────
    const TAB_KEY = 'bwGevelTab_' + versieId;
    const savedTab = sessionStorage.getItem(TAB_KEY);
    if (savedTab) {
        const tabEl = document.querySelector('#gevelTabs button[data-bs-target="' + savedTab + '"]');
        if (tabEl) bootstrap.Tab.getOrCreateInstance(tabEl).show();
    }
    document.querySelectorAll('#gevelTabs button').forEach(btn => {
        btn.addEventListener('shown.bs.tab', () => sessionStorage.setItem(TAB_KEY, btn.dataset.bsTarget));
    });

    // ── Client-side berekening ────────────────────────────────────────────────
    function calcRij(row) {
        const type   = row.dataset.elementType;
        const aantal = parseFloat(row.querySelector('[data-field="aantal"]')?.value) || 0;
        const br     = parseFloat(row.querySelector('[data-field="breedte"]')?.value) || 0;
        const hg     = parseFloat(row.querySelector('[data-field="hoogte"]')?.value) || 0;
        const ln     = parseFloat(row.querySelector('[data-field="lengte"]')?.value) || 0;

        let val = 0, unit = 'm²', formula = '';
        if (TYPES_HOOGTE.includes(type)) {
            val = aantal * br * hg;
            formula = `${aantal} × ${br.toFixed(3)} × ${hg.toFixed(3)} = ${val.toFixed(2)} m²`;
        } else if (TYPES_LENGTE_ALLEEN.includes(type)) {
            val = aantal * ln;
            unit = 'lm';
            formula = `${aantal} × ${ln.toFixed(3)} = ${val.toFixed(2)} lm`;
        } else {
            val = aantal * br * ln;
            formula = `${aantal} × ${br.toFixed(3)} × ${ln.toFixed(3)} = ${val.toFixed(2)} m²`;
        }
        return { val, unit, formula };
    }

    // ── Debounced save ────────────────────────────────────────────────────────
    const saveTimers = {};

    function queueSave(row) {
        const id = row.dataset.elementId;
        const { val, formula } = calcRij(row);

        row.querySelector('.resultaat-value').textContent = fmtNL(val);
        row.querySelector('.calc-detail').textContent     = formula;

        clearTimeout(saveTimers[id]);
        saveTimers[id] = setTimeout(() => saveRij(row), 400);
    }

    async function saveRij(row) {
        const type = row.dataset.elementType;
        const payload = {
            elementId:   parseInt(row.dataset.elementId),
            versieId:    versieId,
            elementType: type,
            eenheidNaam: row.querySelector('[data-field="eenheidNaam"]')?.value ?? '',
            beschrijving: row.querySelector('[data-field="beschrijving"]')?.value ?? '',
            aantal:   parseFloat(row.querySelector('[data-field="aantal"]')?.value) || 0,
            breedte:  parseFloat(row.querySelector('[data-field="breedte"]')?.value) || null,
            hoogte:   parseFloat(row.querySelector('[data-field="hoogte"]')?.value) || null,
            lengte:   parseFloat(row.querySelector('[data-field="lengte"]')?.value) || null
        };
        try {
            const resp = await fetch('/Projecten/BudgetGevelElementOpslaan', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': ANTI },
                body: JSON.stringify(payload)
            });
            const result = await resp.json();
            if (result.success) {
                updateGevelCards(result.totaal);
                updateBadgesAndFooters(result.totaal);
            }
        } catch (e) { console.error('Gevel save fout:', e); }
    }

    // ── Input event ──────────────────────────────────────────────────────────
    document.addEventListener('change', function (e) {
        const row = e.target.closest('tr[data-element-id]');
        if (!row) return;
        if (e.target.classList.contains('gevel-input')) queueSave(row);
    });

    // ── KPI cards ────────────────────────────────────────────────────────────
    function updateGevelCards(t) {
        const set = (id, v, u) => {
            const el = document.getElementById(id);
            if (el) el.innerHTML = fmtNL(v) + ' <span class="small fw-normal text-muted">' + u + '</span>';
        };
        set('kpi-gevel-nb',  t.totaalGevelNieuwbouw,   'm²');
        set('kpi-gevel-best',t.totaalGevelBestaand,     'm²');
        set('kpi-raam-nb',   t.totaalRaamNieuwbouw,     'm²');
        set('kpi-raam-best', t.totaalRaamBestaand,      'm²');
        set('kpi-ballust',   t.totaalBallustrade,       'lm');
        set('kpi-platdak',   t.totaalPlatDak,           'm²');
        set('kpi-helldak',   t.totaalHellendDak,        'm²');
        set('kpi-afbraak',   t.totaalAfbraak,           'm²');
    }

    const TYPE_TOTAAL_MAP = {
        GevelNieuwbouw:    t => t.totaalGevelNieuwbouw,
        GevelBestaand:     t => t.totaalGevelBestaand,
        RaamNieuwbouw:     t => t.totaalRaamNieuwbouw,
        RaamBestaand:      t => t.totaalRaamBestaand,
        Ballustrade:       t => t.totaalBallustrade,
        Zichtscherm:       t => t.totaalZichtscherm,
        PlatDak:           t => t.totaalPlatDak,
        HellendDak:        t => t.totaalHellendDak,
        GroenDak:          t => t.totaalGroenDak,
        Dakoversteken:     t => t.totaalDakoversteken,
        OnderkantDoorrit:  t => t.totaalOnderkantDoorrit,
        Afbraak:           t => t.totaalAfbraak,
    };

    function updateBadgesAndFooters(t) {
        document.querySelectorAll('.gevel-badge[data-type]').forEach(el => {
            const type = el.dataset.type;
            const fn = TYPE_TOTAAL_MAP[type];
            if (fn) el.textContent = fmtNL(fn(t)) + ' ' + (TYPES_LENGTE_ALLEEN.includes(type) ? 'lm' : 'm²');
        });
        document.querySelectorAll('.gevel-totaal-cel[data-type]').forEach(el => {
            const type = el.dataset.type;
            const fn = TYPE_TOTAAL_MAP[type];
            if (fn) el.textContent = fmtNL(fn(t));
        });
    }

    // ── Toevoegen ────────────────────────────────────────────────────────────
    document.addEventListener('click', async function (e) {
        const btn = e.target.closest('.btn-gevel-toevoegen');
        if (!btn) return;

        const section = btn.closest('[data-element-type-section]');
        const etype   = section?.dataset.elementTypeSection;
        if (!etype) return;

        const eenheidInput = section.querySelector('.add-eenheid');
        const beschrInput  = section.querySelector('.add-beschrijving');

        const params = new URLSearchParams({
            versieId,
            elementType:  etype,
            eenheidNaam:  eenheidInput?.value ?? '',
            beschrijving: beschrInput?.value ?? ''
        });

        const resp = await fetch('/Projecten/BudgetGevelElementToevoegen', {
            method: 'POST',
            headers: { 'RequestVerificationToken': ANTI, 'Content-Type': 'application/x-www-form-urlencoded' },
            body: params.toString()
        });
        if (!resp.ok) return;

        const html  = await resp.text();
        const temp  = document.createElement('tbody');
        temp.innerHTML = html;
        const newRow = temp.querySelector('tr');
        if (newRow) {
            const tbody = section.closest('.card, .accordion-item')
                .querySelector('.gevel-tbody[data-element-type="' + etype + '"]');
            if (tbody) tbody.appendChild(newRow);
        }

        if (eenheidInput) eenheidInput.value = '';
        if (beschrInput)  beschrInput.value  = '';
    });

    // ── Verwijderen & dupliceren ─────────────────────────────────────────────
    document.addEventListener('click', async function (e) {
        const row = e.target.closest('tr[data-element-id]');
        if (!row) return;

        if (e.target.closest('.btn-delete-gevel')) {
            if (!confirm('Element verwijderen?')) return;
            const params = new URLSearchParams({
                elementId: row.dataset.elementId, versieId
            });
            const resp = await fetch('/Projecten/BudgetGevelElementVerwijderen', {
                method: 'POST',
                headers: { 'RequestVerificationToken': ANTI, 'Content-Type': 'application/x-www-form-urlencoded' },
                body: params.toString()
            });
            const result = await resp.json();
            if (result.success) {
                row.remove();
                updateGevelCards(result.totaal);
                updateBadgesAndFooters(result.totaal);
            }
        }

        if (e.target.closest('.btn-duplicate-gevel')) {
            const params = new URLSearchParams({
                versieId,
                elementType:  row.dataset.elementType,
                eenheidNaam:  (row.querySelector('[data-field="eenheidNaam"]')?.value ?? '') + ' (kopie)',
                beschrijving: row.querySelector('[data-field="beschrijving"]')?.value ?? ''
            });
            const resp = await fetch('/Projecten/BudgetGevelElementToevoegen', {
                method: 'POST',
                headers: { 'RequestVerificationToken': ANTI, 'Content-Type': 'application/x-www-form-urlencoded' },
                body: params.toString()
            });
            if (!resp.ok) return;
            const html   = await resp.text();
            const temp   = document.createElement('tbody');
            temp.innerHTML = html;
            const newRow = temp.querySelector('tr');
            if (newRow) row.parentElement.appendChild(newRow);
        }
    });

    // ── Bootstrap tooltips ───────────────────────────────────────────────────
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));
</script>
}
