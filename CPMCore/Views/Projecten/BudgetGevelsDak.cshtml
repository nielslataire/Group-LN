@using CPMCore.Controllers
@using BOCore
@model CPMCore.Models.Projecten.BudgetGevelsDakModel
@{
    ViewData["Title"] = "Gevels & Dak — " + Model.MasterNaam;

    // Helper: haal rijen op voor een bepaald elementType
    List<BudgetGevelElementBO> Rijen(string type) =>
        Model.Elementen.TryGetValue(type, out var lst) ? lst : new List<BudgetGevelElementBO>();

    string Fmt(decimal v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
}
@section PageStyle {
    <link rel="stylesheet" href="~/css/budget-wizard.css" />
}
@{
    ViewBag.Breadcrumbs = new List<Breadcrumb>()
    {
        new Breadcrumb("Home",         nameof(HomeController.Index),       "Home",       true),
        new Breadcrumb("Projecten",    nameof(ProjectenController.Index),  "Projecten",  true),
        new Breadcrumb("Detail",       nameof(ProjectenController.Detail), "Projecten",  true),
        new Breadcrumb("Budgetten",    nameof(ProjectenController.BudgetIndex), "Projecten", true),
        new Breadcrumb("Gevels & Dak", nameof(ProjectenController.BudgetGevelsDak), "Projecten", false),
    };
}
@Html.AntiForgeryToken()

<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", Model.ProjectId)
        <div class="inner-body">

            @* ── Wizard tabbladen ── *@
            <div class="bw-tab-bar">
                <div class="bw-steps">
                    @{
                        var steps = new[]
                        {
                            (1,  "Gegevens",         Url.Action("BudgetGegevens",     "Projecten", new { versieId = Model.VersieId })),
                            (2,  "Oppervlaktes",     Url.Action("BudgetOppervlaktes", "Projecten", new { versieId = Model.VersieId })),
                            (3,  "Gevels / Ramen",   (string)null),
                            (4,  "Sanitair",         (string)null),
                            (5,  "Dak / Afbraak",    (string)null),
                            (6,  "Bouwkost (VMSW)",  (string)null),
                            (7,  "Parameters",       (string)null),
                            (8,  "Berekening",       (string)null),
                            (9,  "Verkoop",          (string)null),
                            (10, "Resultaat",        (string)null),
                        };
                        int activeStep = 3;
                    }
                    @foreach (var (num, label, url) in steps)
                    {
                        bool isActive = num == activeStep;
                        bool isDone   = num < activeStep;
                        string cls    = isActive ? "bw-step--active" : (isDone ? "bw-step--done" : "");

                        if (isDone && url != null)
                        {
                            <a href="@url" class="bw-step @cls">
                                <span class="bw-step__circle"><i class="fas fa-check" style="font-size:9px;"></i></span>
                                <span class="bw-step__label">@label</span>
                            </a>
                        }
                        else
                        {
                            <div class="bw-step @cls">
                                <span class="bw-step__circle">@num</span>
                                <span class="bw-step__label">@label</span>
                            </div>
                        }

                        @if (num < steps.Length)
                        {
                            <div class="bw-step__connector" aria-hidden="true"></div>
                        }
                    }
                </div>
                <div class="bw-tab-actions">
                    <label class="small text-muted me-2 mb-0 user-select-none" for="toggleBerek3">
                        Toon berekeningen
                    </label>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="toggleBerek3" />
                    </div>
                </div>
            </div>

            @* ── Versie-header ── *@
            <div class="d-flex align-items-center justify-content-between bg-light border rounded px-3 py-2 mb-3">
                <div>
                    <span class="text-muted small me-2">Budget:</span><strong>@Model.MasterNaam</strong>
                    <span class="text-muted mx-2">|</span>
                    <span class="text-muted small me-2">Versie:</span><strong>@Model.VersieLabel</strong>
                </div>
                <div class="d-flex gap-2">
                    <a href="@Url.Action("BudgetOppervlaktes", "Projecten", new { versieId = Model.VersieId })"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Vorige stap
                    </a>
                    <button class="btn btn-sm btn-secondary" disabled title="Volgende stap nog niet beschikbaar">
                        Volgende stap <i class="fas fa-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>

            @* ── Samenvatting KPI cards ── *@
            <div class="row g-2 mb-3">
                @{
                    var kpi1 = new[]
                    {
                        ("kpi-gevel-nb",  "Gevels nieuwbouw",  Fmt(Model.Totaal.TotaalGevelNieuwbouw),  "m²"),
                        ("kpi-gevel-best","Gevels bestaand",   Fmt(Model.Totaal.TotaalGevelBestaand),   "m²"),
                        ("kpi-raam-nb",   "Ramen nieuwbouw",   Fmt(Model.Totaal.TotaalRaamNieuwbouw),   "m²"),
                        ("kpi-raam-best", "Ramen bestaand",    Fmt(Model.Totaal.TotaalRaamBestaand),    "m²"),
                    };
                    var kpi2 = new[]
                    {
                        ("kpi-ballust",   "Balustrades",       Fmt(Model.Totaal.TotaalBallustrade),     "lm"),
                        ("kpi-platdak",   "Plat dak",          Fmt(Model.Totaal.TotaalPlatDak),         "m²"),
                        ("kpi-helldak",   "Hellend dak",       Fmt(Model.Totaal.TotaalHellendDak),      "m²"),
                        ("kpi-afbraak",   "Afbraak",           Fmt(Model.Totaal.TotaalAfbraak),         "m²"),
                    };
                }
                @foreach (var (id, lbl, val, eenheid) in kpi1)
                {
                    <div class="col-6 col-md-3">
                        <div class="card text-center py-2">
                            <div class="card-body p-1">
                                <div class="fw-semibold text-primary" id="@id">@val <span class="small fw-normal text-muted">@eenheid</span></div>
                                <div class="small text-muted">@lbl</div>
                            </div>
                        </div>
                    </div>
                }
                @foreach (var (id, lbl, val, eenheid) in kpi2)
                {
                    <div class="col-6 col-md-3">
                        <div class="card text-center py-2">
                            <div class="card-body p-1">
                                <div class="fw-semibold text-primary" id="@id">@val <span class="small fw-normal text-muted">@eenheid</span></div>
                                <div class="small text-muted">@lbl</div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* ── Sectietabs ── *@
            <ul class="nav nav-tabs mb-3" id="gevelTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tab-gevels" data-bs-toggle="tab"
                            data-bs-target="#pane-gevels" type="button">Gevels</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-ramen" data-bs-toggle="tab"
                            data-bs-target="#pane-ramen" type="button">Ramen</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-ballust" data-bs-toggle="tab"
                            data-bs-target="#pane-ballust" type="button">Balustrades &amp; Zichtschermen</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-dak" data-bs-toggle="tab"
                            data-bs-target="#pane-dak" type="button">Dak</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-afbraak" data-bs-toggle="tab"
