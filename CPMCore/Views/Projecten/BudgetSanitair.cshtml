@using CPMCore.Controllers
@using BOCore
@model CPMCore.Models.Projecten.BudgetSanitairModel
@section PageStyle {
    <link rel="stylesheet" href="~/css/budget-wizard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/projecten-custom.css" asp-append-version="true" />
}
@{
    ViewBag.Breadcrumbs = new List<Breadcrumb>()
    {
        new Breadcrumb("Home",       nameof(HomeController.Index),        "Home",       true),
        new Breadcrumb("Projecten",  nameof(ProjectenController.Index),   "Projecten",  true),
        new Breadcrumb("Detail",     nameof(ProjectenController.Detail),  "Projecten",  true),
        new Breadcrumb("Budgetten",  nameof(ProjectenController.BudgetIndex), "Projecten", true),
        new Breadcrumb("Sanitair",   nameof(ProjectenController.BudgetSanitair), "Projecten", false),
    };
}
@Html.AntiForgeryToken()

<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", Model.ProjectId)
        <div class="inner-body bw-inner-body">

            @* ── Wizard tabbladen ── *@
            @await Html.PartialAsync("Partials/_BudgetWizardTabs", new BudgetWizardTabsModel { VersieId = Model.VersieId, ActiveStep = 3 })

            <div class="bw-scroll">

            <section class="gl-form-section">
                <div class="gl-form-section__body">
                    <div class="gl-form-section__head">
                        <i class="fa-solid fa-bath" aria-hidden="true"></i>
                        <div>
                            <h2 class="gl-form-section__title">Sanitair</h2>
                            <p class="gl-form-section__hint">
                                Sanitaire elementen per eenheid — synchroniseert automatisch vanuit
                                <a href="@Url.Action("BudgetOppervlaktes", new { versieId = Model.VersieId })">Oppervlaktes</a>.
                            </p>
                        </div>
                        @await Html.PartialAsync("Partials/_BudgetPageHeader", new BudgetPageHeaderModel
                        {
                            StepNum      = 3,
                            MasterNaam   = Model.MasterNaam,
                            VersieLabel  = Model.VersieLabel
                        })
                    </div>

                    @* ── Cijferstrip (gl-kpi2, één lijn) ── *@
                    @{
                        var sanKpis = new (string Id, string Icon, string Lbl, int Val)[]
                        {
                            ("kpi-badkamer",   "fa-bath",     "Badkamers",       Model.Totaal.TotaalBadkamers),
                            ("kpi-toilet-bk",  "fa-toilet","Toiletten in BK", Model.Totaal.TotaalToilettenInBadkamer),
                            ("kpi-toilet-afz", "fa-toilet","Afz. toiletten",  Model.Totaal.TotaalAfzonderlijkeToiletten),
                            ("kpi-douche-bk",  "fa-droplet",  "Douches in BK",   Model.Totaal.TotaalDouchesInBadkamer),
                            ("kpi-douchekamer","fa-shower",   "Douchekamers",    Model.Totaal.TotaalDouchekamers),
                        };
                    }
                    <div class="gl-kpi2-strip bw-kpi-row mb-3">
                        @foreach (var (id, icon, lbl, val) in sanKpis)
                        {
                            <div class="gl-kpi2-tile-col">
                                <div class="gl-kpi2-tile" style="--kpi-color: var(--primary);">
                                    <div class="gl-kpi2-icon"><i class="fa-solid @icon" aria-hidden="true"></i></div>
                                    <div class="gl-kpi2-body">
                                        <div class="gl-kpi2-label">@lbl</div>
                                        <div class="gl-kpi2-value" id="@id">@val</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="bw-dt">
                        <div class="bw-dt__toolbar">
                            <div class="bw-dt__field">
                                <label for="sanitairNaam">Eenheid naam</label>
                                <input type="text" id="sanitairNaam" class="bw-cell-input" placeholder="bv. Lot 1" style="width:150px;" />
                            </div>
                            <button id="btnSanitairToevoegen" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus me-1"></i> Rij toevoegen
                            </button>
                        </div>
                        <div class="bw-dt__scroll">
                            <table class="bw-table" id="sanitairTable">
                                <thead>
                                    <tr>
                                        <th style="width:36px;">#</th>
                                        <th>Eenheid</th>
                                        <th class="text-center">Badkamer</th>
                                        <th class="text-center">Toilet in BK</th>
                                        <th class="text-center">Afz. toilet</th>
                                        <th class="text-center">Douche in BK</th>
                                        <th class="text-center">Douchekamer</th>
                                        <th class="text-center">Totaal</th>
                                        <th style="width:56px;"></th>
                                    </tr>
                                </thead>
                                <tbody id="sanitairTableBody">
                                    @foreach (var rij in Model.Rijen)
                                    {
                                        @await Html.PartialAsync("Partials/_BudgetSanitairRij", rij)
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="2">Totaal</td>
                                        <td class="text-center"><span class="bw-cell-input bw-cell-input--num bw-cell-input--total" id="tot-badkamer" style="width:60px;">@Model.Totaal.TotaalBadkamers</span></td>
                                        <td class="text-center"><span class="bw-cell-input bw-cell-input--num bw-cell-input--total" id="tot-toilet-bk" style="width:60px;">@Model.Totaal.TotaalToilettenInBadkamer</span></td>
                                        <td class="text-center"><span class="bw-cell-input bw-cell-input--num bw-cell-input--total" id="tot-toilet-afz" style="width:60px;">@Model.Totaal.TotaalAfzonderlijkeToiletten</span></td>
                                        <td class="text-center"><span class="bw-cell-input bw-cell-input--num bw-cell-input--total" id="tot-douche-bk" style="width:60px;">@Model.Totaal.TotaalDouchesInBadkamer</span></td>
                                        <td class="text-center"><span class="bw-cell-input bw-cell-input--num bw-cell-input--total" id="tot-douchekamer" style="width:60px;">@Model.Totaal.TotaalDouchekamers</span></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </section>

            </div>@* /bw-scroll *@
            <div class="bw-bottom-nav">
                <a href="@Url.Action("BudgetOppervlaktes", "Projecten", new { versieId = Model.VersieId })" class="bw-bottom-nav__back">
                    <i class="fas fa-chevron-left me-1"></i>Vorige: Oppervlaktes
                </a>
                <span class="bw-bottom-nav__indicator">Stap 3 van 9 — Sanitair</span>
                <a href="@Url.Action("BudgetGevels", "Projecten", new { versieId = Model.VersieId })" class="bw-bottom-nav__next">
                    Volgende: Gevels <i class="fas fa-chevron-right ms-1"></i>
                </a>
            </div>

            @await Html.PartialAsync("Partials/_BudgetConfirmModal")

        </div>
    </div>
</section>

@section PageScripts {
<script src="~/js/budget-wizard.js"></script>
<script>
    const antiForgery = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const versieId    = @Model.VersieId;
    let saveTimer;

    // ── Rij-nummering ─────────────────────────────────────────────────────────
    function renumberRows() {
        document.querySelectorAll('#sanitairTableBody tr').forEach((row, i) => {
            const cell = row.querySelector('.row-number');
            if (cell) cell.textContent = i + 1;
        });
    }

    renumberRows();

    // ── KPI updater ───────────────────────────────────────────────────────────
    function updateSanitairKpi(totaal) {
        document.getElementById('kpi-badkamer').textContent        = totaal.totaalBadkamers;
        document.getElementById('kpi-toilet-bk').textContent       = totaal.totaalToilettenInBadkamer;
        document.getElementById('kpi-toilet-afz').textContent      = totaal.totaalAfzonderlijkeToiletten;
        document.getElementById('kpi-douche-bk').textContent       = totaal.totaalDouchesInBadkamer;
        document.getElementById('kpi-douchekamer').textContent     = totaal.totaalDouchekamers;
        document.getElementById('tot-badkamer').textContent        = totaal.totaalBadkamers;
        document.getElementById('tot-toilet-bk').textContent       = totaal.totaalToilettenInBadkamer;
        document.getElementById('tot-toilet-afz').textContent      = totaal.totaalAfzonderlijkeToiletten;
        document.getElementById('tot-douche-bk').textContent       = totaal.totaalDouchesInBadkamer;
        document.getElementById('tot-douchekamer').textContent     = totaal.totaalDouchekamers;
    }

    // ── Inline save on change (debounced 400ms) ───────────────────────────────
    document.getElementById('sanitairTableBody').addEventListener('change', function (e) {
        if (!e.target.classList.contains('san-input')) return;

        const row = e.target.closest('tr');
        if (!row) return;

        // Update row total immediately
        let tot = 0;
        row.querySelectorAll('.san-input').forEach(inp => {
            tot += parseInt(inp.value) || 0;
        });
        const badge = row.querySelector('.row-totaal');
        if (badge) badge.textContent = tot;

        clearTimeout(saveTimer);
        saveTimer = setTimeout(function () {
            const payload = {
                rijId:               parseInt(row.dataset.rijId),
                versieId:            parseInt(row.dataset.versieId),
                eenheidNaam:         row.dataset.eenheidNaam || '',
                unitTypeId:          parseInt(row.dataset.unitTypeId) || 0,
                badkamer:            parseInt(row.querySelector('[data-field="badkamer"]').value) || 0,
                toiletInBadkamer:    parseInt(row.querySelector('[data-field="toiletInBadkamer"]').value) || 0,
                afzonderlijkToilet:  parseInt(row.querySelector('[data-field="afzonderlijkToilet"]').value) || 0,
                doucheInBadkamer:    parseInt(row.querySelector('[data-field="doucheInBadkamer"]').value) || 0,
                douchekamer:         parseInt(row.querySelector('[data-field="douchekamer"]').value) || 0
            };

            fetch('/Projecten/BudgetSanitairRijOpslaan', {
                method:  'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': antiForgery
                },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(result => {
                if (result.success) updateSanitairKpi(result.totaal);
            })
            .catch(err => console.error('Save fout:', err));
        }, 400);
    });

    // ── Rij toevoegen ─────────────────────────────────────────────────────────
    document.getElementById('btnSanitairToevoegen').addEventListener('click', async function () {
        const naam = document.getElementById('sanitairNaam').value.trim();
        if (!naam) return;

        const params = new URLSearchParams({ versieId, eenheidNaam: naam });
        const resp = await fetch('/Projecten/BudgetSanitairRijToevoegen', {
            method:  'POST',
            headers: { 'RequestVerificationToken': antiForgery, 'Content-Type': 'application/x-www-form-urlencoded' },
            body:    params.toString()
        });

        if (!resp.ok) { alert('Fout bij toevoegen.'); return; }

        const html   = await resp.text();
        const tbody  = document.getElementById('sanitairTableBody');
        const temp   = document.createElement('tbody');
        temp.innerHTML = html;
        const newRow = temp.querySelector('tr');
        if (newRow) {
            tbody.appendChild(newRow);
            renumberRows();
        }

        document.getElementById('sanitairNaam').value = '';
    });

    // ── Rij verwijderen ───────────────────────────────────────────────────────
    document.getElementById('sanitairTableBody').addEventListener('click', async function (e) {
        const btn = e.target.closest('.btn-delete-sanitair');
        if (!btn) return;

        if (!await BudgetWizard.confirmModal({
            title: 'Rij verwijderen',
            body: 'Ben je zeker dat je deze eenheid uit de sanitairtabel wil verwijderen?'
        })) return;

        const row    = btn.closest('tr');
        const rijId  = row.dataset.rijId;
        const params = new URLSearchParams({ rijId, versieId });

        const resp = await fetch('/Projecten/BudgetSanitairRijVerwijderen', {
            method:  'POST',
            headers: { 'RequestVerificationToken': antiForgery, 'Content-Type': 'application/x-www-form-urlencoded' },
            body:    params.toString()
        });

        const result = await resp.json();
        if (result.success) {
            row.remove();
            renumberRows();
            updateSanitairKpi(result.totaal);
        }
    });

    // ── Bootstrap tooltips ────────────────────────────────────────────────────
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));
</script>
}
