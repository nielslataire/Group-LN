@using CPMCore.Controllers
@using CPMCore.Helpers
@using BOCore
@using System.Linq
@inject IConfiguration Configuration
@model CPMCore.Models.Projecten.ProjectAddContractModel;

@{
	var groupedActivities = Model.AllActivities
		.GroupBy(a => string.IsNullOrWhiteSpace(a.GroupName) ? "Overige" : a.GroupName!)
		.OrderBy(g => g.Key)
		.ToList();
}

@section PageStyle
{
	<link rel="stylesheet" href="~/lib/bootstrap-fileupload/bootstrap-fileupload.min.css" />
	<link rel="stylesheet" href="~/lib/select2/css/select2.css" />
 	<link rel="stylesheet" href="~/lib/select2-bootstrap-theme/select2-bootstrap.css" />
	<link rel="stylesheet" href="~/css/admin/theme-admin-extension.css" />
	<link rel="stylesheet" href="~/css/admin/skins/extension.css" />
	<link rel="stylesheet" href="~/lib/bootstrap-tagsinput/bootstrap-tagsinput.css" />
	<link rel="stylesheet" href="~/lib/bootstrap-multiselect/css/bootstrap-multiselect.css">
	<link rel="stylesheet" href="~/lib/dropzone/basic.css" />
	<link rel="stylesheet" href="~/lib/dropzone/dropzone.css" />
	<script src="https://cdnjs.cloudflare.com/ajax/libs/inputmask/5.0.8/jquery.inputmask.min.js"></script>
	<style>
		/* Kleuren komen uit het tokenpalet in wwwroot/css/custom.css (:root):
		   --muted, --primary, --green-light, --border, --white. Geen losse hex hier. */
		.company-picker-result {
			display: flex;
			flex-direction: column;
			line-height: 1.3;
			padding: 2px 0;
		}
		.company-picker-result .name { font-weight: 400; }
		.company-picker-result .vat { font-size: .7rem; color: var(--muted); }
		.company-picker-result.company-picker-new {
			flex-direction: row;
			align-items: center;
			color: var(--primary);
			font-weight: 600;
		}
		.company-picker-result.company-picker-new i { font-size: 1rem; }
		#select2-ddlCompany-results .select2-results__option {
			border-radius: .25rem;
			margin-bottom: 2px;
		}
		/* Enkel bij hover/toetsenbord-highlight een green-light achtergrond, niet standaard */
		#select2-ddlCompany-results .select2-results__option--highlighted {
			background: var(--green-light) !important;
			color: inherit !important;
		}
		/* "Nieuwe leverancier toevoegen" blijft onderaan zichtbaar, los van de scrollbare
		   resultatenlijst, met een duidelijke scheidingslijn t.o.v. de zoekresultaten. */
		#select2-ddlCompany-results .select2-results__option:has(.company-picker-new) {
			position: sticky;
			bottom: 0;
			background: var(--white);
			border-top: 1px solid var(--border);
			border-radius: 0;
			margin-top: 4px;
			margin-bottom: 0;
		}
		#select2-ddlCompany-results .select2-results__option:has(.company-picker-new).select2-results__option--highlighted {
			background: var(--green-light) !important;
			color: var(--primary) !important;
		}
		.company-picker-selected {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: .75rem;
			border: 1px solid var(--border);
			background: var(--green-light);
			border-radius: .375rem;
			padding: .6rem .9rem;
		}
		.company-picker-selected .name { font-weight: 600; }
		.company-picker-selected .vat { font-size: .8rem; color: var(--muted); }
		#companyContractDefaultsNote { color: var(--primary); }
		.activity-rows-header { font-size: .75rem; letter-spacing: .03em; }
		.empty-state-box {
			border: 1px dashed var(--border);
			border-radius: .375rem;
			padding: 1rem 1.25rem;
			color: var(--muted);
			text-align: center;
		}
		.form-control-h {
			min-height: calc(1.5em + 1.4rem + 2px);
		}
		/* Sectiescheiding binnen de kaart: subtiel kopje boven de opvolgvelden */
		.form-section-caption {
			font-size: .7rem;
			letter-spacing: .04em;
		}
		/* Contrast: var(--muted) haalt 4.5:1 niet op wit / green-light — lokaal donkerder */
		.company-picker-result .vat,
		.company-picker-selected .vat,
		.empty-state-box { color: #5c6b7a; }
		/* Lange bedrijfsnaam in het geselecteerde-vak mag niet uitbreken */
		.company-picker-selected > div { min-width: 0; }
		.company-picker-selected .name,
		.company-picker-selected .vat {
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		/* Bedragen onder elkaar vergelijkbaar uitlijnen */
		#activitiesTotal,
		#ActivityRows .Currencymask { font-variant-numeric: tabular-nums; }
		/* Native <select> expliciete kleuren (Windows / geforceerde thema's) */
		select.form-control-modern { background-color: #fff; color: #212529; }
		/* Modals: scroll niet doorgeven aan de pagina */
		.modal .modal-body { overscroll-behavior: contain; }
		/* Dubbelklik-zoom op touch vermijden */
		.ecommerce-form .btn,
		.ecommerce-form .form-control,
		.action-buttons .btn { touch-action: manipulation; }
		/* Datumveld nooit onbruikbaar smal laten worden in een krappe kolom */
		#txtContractSentDate { min-width: 8rem; }
		@@media (prefers-reduced-motion: reduce) {
			.switch, .switch * { transition: none !important; }
		}
	</style>
}

<div class="row">
<div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
	<div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
			<div class="row align-items-center">
				<div class="col-sm-auto d-flex align-items-center">
					<a href="@Url.Action("DetailContracts", "Projecten",new {projectid = Model.ProjectId})" class="text-decoration-none text-reset d-flex align-items-center" aria-label="Terug naar leveranciers">
						<i class="bx bx-chevron-left fs-1" aria-hidden="true"></i>
					</a>
				</div>
				<div class="col-sm-auto">
					<h1 class="fw-bold mb-0 mt-0">Contract toevoegen</h1>
					<h5 class="mb-4 mt-0">Voeg een nieuw leverancierscontract toe aan project @Model.ProjectName</h5>
				</div>
			</div>
	</div>
</div>
</div>

<div class="row mt-0 pt-0">
	<div class="col">
		<div class="alert alert-info d-flex align-items-start gap-2 mb-0">
			<i class="bx bx-info-circle mt-1" aria-hidden="true"></i>
			<div>Elk contract koppelt &eacute;&eacute;n leverancier aan dit project. Kies eerst de leverancier. BTW% en betaaltermijn worden automatisch ingevuld op basis van het vorige contract. Gebruik Enter om snel toe te voegen.</div>
		</div>
	</div>
</div>

@using (Html.BeginForm("AddContract", "Projecten", FormMethod.Post, new { @class = "ecommerce-form action-buttons-fixed", id = "addContractForm", enctype = "multipart/form-data" }))
{
	@Html.AntiForgeryToken()
	@if (!ViewData.ModelState.IsValid)
	{
		<div class="alert alert-danger" role="alert">
			@Html.ValidationSummary(false, "", new { @class = "mb-0" })
		</div>
	}

	@Html.HiddenFor(m => m.ProjectId, new { id = "projectid" })
	@Html.HiddenFor(m => m.Contract.ProjectId, new { id = "contractprojectid" })
	@Html.HiddenFor(m => m.Contract.Id, new { id = "contractid" })
	@Html.HiddenFor(m => m.ProjectName, new { id = "projectname" })
	<div class="row mt-2 g-4">
		<div class="col-12 col-xxl-6">
			<section class="card card-modern card-big-info h-100">
				<div class="card-body">
					<div class="row">
						<div class="col-xl-1-5">
							<i class="card-big-info-icon bx bx-box" aria-hidden="true"></i>
							<h2 class="card-big-info-title">Algemene info</h2>
							<p class="card-big-info-desc">Voeg hier de algemene info van het contract in.</p>
						</div>
						<div class="col-xl-4-5">

							<div class="row align-items-center pb-3">
								<label class="col-12 col-md-4 control-label text-md-end mb-0">
									@Html.LabelFor(m => m.Contract.ContractName)
								</label>
								<div class="col-12 col-md-8">
									@Html.TextBoxFor(m => m.Contract.ContractName, new { @class = "form-control form-control-modern", placeholder = "Optionele naam voor dit contract…" })
								</div>
							</div>
							<div class="row align-items-center pb-3">
								<label class="col-12 col-md-4 control-label text-md-end mb-0" for="ddlCompany">
									@Html.DisplayNameFor(m => m.Companies) <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (verplicht)</span>
								</label>
								<div class="col-12 col-md-8">
									@Html.HiddenFor(m => m.Contract.Company.ID, new { id = "txtCompanyID" })
									@Html.HiddenFor(m => m.Contract.Company.Display, new { id = "txtCompanyDisplay" })
									<div id="companySelected" class="company-picker-selected @(Model.Contract.Company.ID > 0 ? "" : "d-none")">
										<div>
											<div class="name" id="companySelectedName">@Model.Contract.Company.Display</div>
											<div class="vat" id="companySelectedVat"></div>
										</div>
										<button type="button" class="btn btn-sm btn-link text-muted p-0" id="btnClearCompany" title="Andere leverancier kiezen" aria-label="Andere leverancier kiezen">
											<i class="bx bx-x fs-3" aria-hidden="true"></i>
										</button>
									</div>
									<div id="ddlCompanyWrapper" class="@(Model.Contract.Company.ID > 0 ? "d-none" : "")">
										<select id="ddlCompany" class="form-control form-control-modern w-100" aria-label="Leverancier zoeken" aria-required="true">
											<!-- Voeg hier de opties toe -->
										</select>
									</div>
									<div id="companyContractDefaultsNote" class="small mt-2 d-none">
										<i class="bx bx-check-circle me-1" aria-hidden="true"></i>BTW%, betaaltermijn en waarborg ingevuld op basis van vorig contract met deze leverancier.
									</div>
									@Html.ValidationMessageFor(m => m.Contract.Company.ID, "", new { @class = "text-danger small d-block mt-1" })
								</div>
							</div>
							<div class="row align-items-center pb-3">
								<label class="col-12 col-md-4 control-label text-md-end mb-0" for="ddlSiteManager">@Html.DisplayNameFor(m => m.Contract.SiteManagerContactId)</label>
								<div class="col-12 col-md-8">
									<div class="input-group">
										@Html.DropDownListFor(m => m.Contract.SiteManagerContactId, new SelectList(Model.SiteManagers, "ID", "Display", Model.Contract.SiteManagerContactId), "Geen", new { @class = "form-control form-control-modern", id = "ddlSiteManager" })
										<button type="button" class="btn btn-outline-secondary" id="btnNewSiteManager" disabled title="Eerst een leverancier kiezen" aria-label="Nieuwe werfleider toevoegen">
											<i class="bx bx-user-plus" aria-hidden="true"></i>
										</button>
									</div>
								</div>
							</div>

							<div class="row align-items-center pb-3">
								<label class="col-12 col-md-4 control-label text-md-end mb-0" for="Contract_VatPercentage">@Html.DisplayNameFor(m => m.Contract.VatPercentage)</label>
								<div class="col-12 col-md-3">
									@Html.EditorFor(m => m.Contract.VatPercentage, new { id = "txtVatPercentage", @class = "form-control form-control-modern", placeholder = "0,00", autocomplete = "off" })
								</div>
								<label class="col-12 col-md-2 control-label text-md-end mb-0" for="txtPaymentTerm">@Html.DisplayNameFor(m => m.Contract.PaymentTerm)</label>
								<div class="col-12 col-md-3">
									@Html.TextBoxFor(m => m.Contract.PaymentTerm, new { id = "txtPaymentTerm", @class = "form-control form-control-modern", placeholder = "Aantal dagen…", inputmode = "numeric" })
								</div>
							</div>

							<div class="row align-items-center pb-3">
								<label class="col-12 col-md-4 control-label text-md-end mb-0" for="txtCashDiscountPaymentTerm">@Html.DisplayNameFor(m => m.Contract.CashDiscountPaymentTerm)</label>
								<div class="col-12 col-md-3">
									<div class="input-group mb-3">
										<span class="input-group-text">
											@Html.CheckBoxFor(m => m.Contract.CashDiscount, new  {id = "chkCashDiscount", aria_label = "Korting contant toepassen"})
										</span>
										@Html.TextBoxFor(m => m.Contract.CashDiscountPaymentTerm, new { id = "txtCashDiscountPaymentTerm", @class = "form-control form-control-modern", type = "text", placeholder = "Aantal dagen…", inputmode = "numeric" }).DisableIf(() => !Model.Contract.CashDiscount)
									</div>

								</div>
								<label class="col-12 col-md-2 control-label text-md-end mb-0" for="Contract_CashDiscountPercentage">@Html.DisplayNameFor(m => m.Contract.CashDiscountPercentage)</label>
								<div class="col-12 col-md-3">
									@Html.EditorFor(m => m.Contract.CashDiscountPercentage, new { id = "txtCashDiscountPercentage", @class = "form-control form-control-modern", placeholder = "0,00" }).DisableIf(() => !Model.Contract.CashDiscount)
								</div>
							</div>
							<div class="row align-items-center pb-3">
								<label class="col-12 col-md-4 control-label text-md-end mb-0" for="lstGuaranteeType">@Html.DisplayNameFor(m => m.Contract.GuaranteeType)</label>
								<div class="col-12 col-md-3">
									@Html.DropDownListFor(m => m.Contract.GuaranteeType, Html.GetEnumSelectList(Model.Contract.GuaranteeType.GetType()), new { @class = "form-control form-control-modern", id = "lstGuaranteeType" })
								</div>
								<label class="col-12 col-md-2 control-label text-md-end mb-0" for="Contract_GuaranteePercentage">@Html.DisplayNameFor(m => m.Contract.GuaranteePercentage)</label>
								<div class="col-12 col-md-3">
									@Html.EditorFor(m => m.Contract.GuaranteePercentage, new { id = "txtGuaranteePercentage", @class = "form-control form-control-modern", placeholder = "0,00" }).DisableIf(() => Model.Contract.GuaranteeType != ContractGuaranteeType.FinancialGuarantee)
								</div>
							</div>
							<div class="row align-items-center pb-3" id="guaranteeDocRow" style="@(Model.Contract.GuaranteeType == ContractGuaranteeType.BankGuarantee ? "" : "display:none")">
								<label class="col-12 col-md-4 control-label text-md-end mb-0" for="fileGuaranteeDoc">Waarborgdocument <span class="text-muted">(pdf/jpg)</span></label>
								<div class="col-12 col-md-8">
									<input type="file" name="guaranteeDoc" id="fileGuaranteeDoc" class="form-control form-control-modern" accept=".pdf,.jpg,.jpeg,image/jpeg,application/pdf" />
									<small class="text-muted d-block mt-1">De bankwaarborg blijft als “nog te ontvangen” gemarkeerd zolang je hier geen document toevoegt.</small>
								</div>
							</div>
							<div class="row pb-2 pt-3 mt-1 border-top">
								<div class="col-12">
									<span class="text-muted text-uppercase fw-semibold form-section-caption">Opvolging</span>
								</div>
							</div>
							<div class="row align-items-center pb-3">
								<label class="col-12 col-md-4 control-label text-md-end mb-0">
									@Html.DisplayNameFor(m => m.Contract.ContractSigned)
								</label>
								<div class="col-12 col-md-8">
									<div class="switch switch-sm switch-primary">
										@Html.CheckBoxFor(m => m.Contract.ContractSigned, new { id = "chkContractSigned", data_plugin_ios_switch = "" })
									</div>
									<label class="form-check-label mb-0" for="chkContractSigned"></label>
								</div>
							</div>
							<div class="row align-items-center pb-3">
								<label class="col-12 col-md-3 control-label text-md-end mb-0" for="txtContractSentDate">@Html.DisplayNameFor(m => m.Contract.ContractSentDate)</label>
								<div class="col-12 col-md-4">
									<div class="input-group">
										<span class="input-group-text"><i class="fas fa-calendar-alt" aria-hidden="true"></i></span>
										@Html.TextBoxFor(m => m.Contract.ContractSentDate, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control form-control-modern", id = "txtContractSentDate" })
									</div>
								</div>
								<label class="col-12 col-md-2 control-label text-md-end mb-0" for="txtContractSentNote">@Html.DisplayNameFor(m => m.Contract.ContractSentNote)</label>
								<div class="col-12 col-md-3">
									@Html.TextBoxFor(m => m.Contract.ContractSentNote, new { @class = "form-control form-control-modern", placeholder = "bv. Bestelbon, per e-mail…", maxlength = "200", id = "txtContractSentNote" })
									<small class="text-muted d-block mt-1 text-md-end"><span id="contractSentNoteCount">0</span>/200</small>
								</div>
							</div>
							<div class="row align-items-center pb-3">
								<label class="col-12 col-md-4 control-label text-md-end mb-0">@Html.DisplayNameFor(m => m.Contract.SiteNotification)</label>
								<div class="col-12 col-md-3">
									<div class="switch switch-sm switch-primary">
										@Html.CheckBoxFor(m => m.Contract.SiteNotification, new { id = "chkSiteNotification", data_plugin_ios_switch = "" })
									</div>
									<label class="form-check-label mb-0" for="chkSiteNotification"></label>
								</div>
								<label class="col-12 col-md-2 control-label text-md-end mb-0">@Html.DisplayNameFor(m => m.Contract.VgmCharter)</label>
								<div class="col-12 col-md-3">
									<div class="switch switch-sm switch-primary">
										@Html.CheckBoxFor(m => m.Contract.VgmCharter, new { id = "chkVgmCharter", data_plugin_ios_switch = "" })
									</div>
									<label class="form-check-label mb-0" for="chkVgmCharter"></label>
								</div>
							</div>
							<div class="row align-items-center pb-3">
								<label class="col-12 col-md-4 control-label text-md-end mb-0">@Html.DisplayNameFor(m => m.Contract.PidAttest)</label>
								<div class="col-12 col-md-8">
									<div class="switch switch-sm switch-primary">
										@Html.CheckBoxFor(m => m.Contract.PidAttest, new { id = "chkPidAttest", data_plugin_ios_switch = "" })
									</div>
									<label class="form-check-label mb-0" for="chkPidAttest"></label>
								</div>
							</div>

						</div>
					</div>
				</div>
			</section>
		</div>
		<div class="col-12 col-xxl-6">
			<section class="card card-modern card-big-info h-100">
				<div class="card-body">
					<div class="row">
						<div class="col-xl-1-5">
							<i class="card-big-info-icon bx bx-checklist" aria-hidden="true"></i>
							<h2 class="card-big-info-title">Activiteiten</h2>
							<p class="card-big-info-desc">Kies de activiteiten van deze leverancier en vul per activiteit het bedrag in. Niet gevonden? Voeg een bestaande activiteit uit de catalogus toe.</p>
						</div>
						<div class="col-xl-4-5">
							<div class="d-flex justify-content-between align-items-center flex-nowrap gap-2 mb-4">
								<h3 class="text-color-dark font-weight-bold text-4 mb-0 text-uppercase text-truncate" id="companyActivitiesTitle" style="min-width:0;">Kies eerst een leverancier</h3>
								<div class="d-flex gap-2 flex-shrink-0">
									<button type="button" class="btn btn-outline-success btn-sm" id="btnNewActivity" disabled>
										<i class="bx bx-plus me-1"></i>Nieuwe activiteit
									</button>
									<button type="button" class="btn btn-outline-success btn-sm" id="btnAddActivities" disabled>
										<i class="bx bx-plus me-1"></i>Toevoegen
									</button>
								</div>
							</div>
							<div id="availableActivitiesList" class="empty-state-box mb-4">Kies eerst een leverancier hierboven.</div>

							<div id="activityRowsHead" class="activity-rows-header row align-items-center pb-2 border-bottom mb-2 text-muted text-uppercase d-none">
								<div class="col-12 col-md-4 text-md-end">Activiteit</div>
								<div class="col-12 col-md-8">Bedrag</div>
							</div>
							<div id="ActivityRows">
								@foreach (var item in Model.Contract.Activities)
								{
									@await Html.PartialAsync("_ActivityRow", item, new ViewDataDictionary(ViewData) {{ "mode", "add" }})
								}
							</div>
							<div id="noActivitiesHint" class="empty-state-box">Nog geen activiteiten toegevoegd aan dit contract.</div>
							<div id="activityRowsTotal" class="row align-items-center pt-2 border-top mt-2 d-none">
								<div class="col-12 col-md-4 fw-bold text-md-end">Totaal</div>
								<div class="col-12 col-md-8 fw-bold text-start" id="activitiesTotal">&euro; 0,00</div>
							</div>
						</div>
					</div>
				</div>
			</section>
		</div>
	</div>
	<div class="row action-buttons align-items-center">
		<div class="col-12 col-md-auto">
			<button type="submit" name="saveAction" value="save" class="submit-button btn btn-primary btn-px-4 py-3 d-flex align-items-center font-weight-semibold line-height-1" data-loading-text="Laden…">
				<i class="bx bx-save text-4 me-2" aria-hidden="true"></i> Contract opslaan
			</button>
		</div>
		<div class="col-12 col-md-auto px-md-0 mt-3 mt-md-0">
			<button type="submit" name="saveAction" value="addAnother" class="submit-button btn btn-light border btn-px-4 py-3 d-flex align-items-center font-weight-semibold line-height-1 text-color-dark" data-loading-text="Laden…">
				<i class="bx bx-plus-circle text-4 me-2" aria-hidden="true"></i> Opslaan &amp; nog een contract toevoegen
			</button>
		</div>
		<div class="col-12 col-md-auto">
			<a href="@TempData.Peek("Referrer")" class="cancel-button btn btn-light btn-px-4 py-3 border font-weight-semibold text-color-dark text-3">Annuleren</a>
		</div>
		<div class="col-12 col-md px-md-0 mt-3 mt-md-0 text-muted text-3">
			Tip: gebruik <strong>Opslaan &amp; nog een contract toevoegen</strong> als je meerdere leveranciers na elkaar invoert.
		</div>

	</div>
}

<!-- Modal: nieuwe leverancier -->
<div class="modal fade" id="modalNewSupplier" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Nieuwe leverancier</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<div id="nsErrors" class="alert alert-danger d-none" role="alert"></div>
				<div class="row g-3">
					<div class="col-md-8">
						<label class="control-label mb-1" for="nsName">Bedrijfsnaam <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (verplicht)</span></label>
						<input type="text" id="nsName" class="form-control form-control-modern" required aria-required="true" />
					</div>
					<div class="col-md-4">
						<label class="control-label mb-1" for="nsLegalForm">Bedrijfsvorm</label>
						<select id="nsLegalForm" class="form-control form-control-modern">
							<option value="">Geen</option>
							@foreach (var lf in Model.LegalForms)
							{
								<option value="@lf.ID">@lf.Display</option>
							}
						</select>
					</div>
					<div class="col-md-6">
						<label class="control-label mb-1" for="nsEnterpriseNumber">Ondernemingsnummer</label>
						<input type="text" id="nsEnterpriseNumber" class="form-control form-control-modern" placeholder="BE0123456789" inputmode="numeric" spellcheck="false" autocomplete="off" />
					</div>
					<div class="col-md-6">
						<label class="control-label mb-1" for="nsVat">BTW nummer</label>
						<div class="input-group">
							<input type="text" id="nsVat" class="form-control form-control-modern" placeholder="BE0123456789" spellcheck="false" autocomplete="off" />
							<button type="button" class="btn btn-outline-primary" id="nsBtnValidateVat">
								<i class="bx bx-check" aria-hidden="true"></i> Controleren
							</button>
						</div>
						<small class="text-muted d-block mt-1">Vult bij een geldig nummer meteen naam en adres aan.</small>
					</div>
					<div class="col-md-6">
						<label class="control-label mb-1" for="nsStreet">Straat</label>
						<input type="text" id="nsStreet" class="form-control form-control-modern" autocomplete="address-line1" />
					</div>
					<div class="col-md-3">
						<label class="control-label mb-1" for="nsHouseNumber">Nr</label>
						<input type="text" id="nsHouseNumber" class="form-control form-control-modern" />
					</div>
					<div class="col-md-3">
						<label class="control-label mb-1" for="nsBusNumber">Bus</label>
						<input type="text" id="nsBusNumber" class="form-control form-control-modern" />
					</div>
					<div class="col-md-4">
						<label class="control-label mb-1" for="nsPostalCode">Postcode</label>
						<input type="text" id="nsPostalCode" class="form-control form-control-modern" inputmode="numeric" autocomplete="postal-code" />
					</div>
					<div class="col-md-4">
						<label class="control-label mb-1" for="nsCity">Gemeente</label>
						<input type="text" id="nsCity" class="form-control form-control-modern" autocomplete="address-level2" />
					</div>
					<div class="col-md-4">
						<label class="control-label mb-1" for="nsCountryId">Land</label>
						<select id="nsCountryId" class="form-control form-control-modern">
							@foreach (var c in Model.Countries)
							{
								<option value="@c.ID" selected="@(c.Display != null && c.Display.Contains("Belg", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@c.Display</option>
							}
						</select>
					</div>
					<div class="col-md-12">
						<label class="control-label mb-1" for="nsEmail">Email</label>
						<input type="email" id="nsEmail" class="form-control form-control-modern" inputmode="email" spellcheck="false" autocomplete="email" />
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-light border" data-bs-dismiss="modal">Annuleren</button>
				<button type="button" class="btn btn-primary" id="btnCreateSupplier">Leverancier aanmaken &amp; selecteren</button>
			</div>
		</div>
	</div>
</div>

@* Modal "nieuwe werfleider": zie Partials/_SiteManagerNewModal.cshtml, gerenderd onderaan de scriptsectie *@

<!-- Modal: activiteit toevoegen -->
<div class="modal fade" id="modalNewActivity" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Activiteit toevoegen</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<p class="text-muted" id="naForLabel">Voor: </p>
				<div id="naErrors" class="alert alert-danger d-none" role="alert"></div>
				<div class="mb-3">
					<label class="control-label mb-1" for="naActivity">Activiteit <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (verplicht)</span></label>
					<select id="naActivity" class="form-control form-control-modern" aria-required="true">
						<option value=""></option>
						@foreach (var group in groupedActivities)
						{
							<optgroup label="@group.Key">
								@foreach (var activity in group.OrderBy(a => a.Name))
								{
									<option value="@activity.Id">@activity.Name</option>
								}
							</optgroup>
						}
					</select>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-light border" data-bs-dismiss="modal">Annuleren</button>
				<button type="button" class="btn btn-primary" id="btnCreateActivity">Activiteit toevoegen</button>
			</div>
		</div>
	</div>
</div>

@section PageScripts
{
	<script src="~/lib/select2/js/select2.js"></script>
	<script src="~/js/theme.admin.extension.js"></script>
	<script src="~/lib/select2/js/i18n/nl.js"></script>
	<script src="~/lib/dropzone/dropzone.js"></script>
	<script src="~/lib/ios7-switch/ios7-switch.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/autonumeric@4.6.0/dist/autoNumeric.min.js"></script>
	<script src="~/js/currency.js"></script>

	<script>
		// ==============================
		// CurrencyMask helper (ipv AutoNumeric)
		// ==============================
		function initEuroInput(target) {
			CurrencyMask.init(target);
		}

		function setCurrencyValue(selector, value) {
			const el = document.querySelector(selector);
			if (!el || value === null || value === undefined) return;
			const an = AutoNumeric.getAutoNumericElement(el);
			if (an) {
				an.set(value);
			} else {
				el.value = value;
			}
		}

		function notify(title, text, type) {
			if (typeof PNotify !== 'undefined') {
				new PNotify({
					title: title || '',
					text: text || '',
					type: type || 'info',
					addclass: 'stack-bar-top',
					stack: { dir1: 'down', dir2: 'right', push: 'top', spacing1: 5 }
				});
			} else {
				window.alert((title ? title + '\n' : '') + (text || ''));
			}
		}

		function formatVat(raw) {
			if (!raw) return '';
			const digits = raw.toString().replace(/\D/g, '');
			if (digits.length === 10) {
				return 'BE' + digits.slice(0, 4) + '.' + digits.slice(4, 7) + '.' + digits.slice(7, 10);
			}
			return raw;
		}

		function antiforgeryToken() {
			const el = document.querySelector('input[name="__RequestVerificationToken"]');
			return el ? el.value : '';
		}

		function initSwitches($scope) {
			if (typeof ios7Switch === 'undefined') return;
			($scope || $(document)).find('[data-plugin-ios-switch]').each(function () {
				if (!$(this).data('ios7-switch-init')) {
					new ios7Switch(this);
					$(this).data('ios7-switch-init', true);
				}
			});
		}

		let addedActivityIds = new Set();

		$(function () {

			initSwitches($(document));

			// ==============================
			// GARANTIE TYPE
			// ==============================
			$('#lstGuaranteeType').on('change', function () {
				var val = $(this).val();
				if (val == 2) {
					$("#Contract_GuaranteePercentage").removeAttr("disabled");
				} else {
					$("#Contract_GuaranteePercentage").attr("disabled", "disabled");
				}
				// Bankwaarborg (3): document-upload tonen
				$('#guaranteeDocRow').toggle(val == 3);
			}).trigger('change');

			// ==============================
			// KORTING CONTANT
			// ==============================
			$('#chkCashDiscount').on('change', function () {
				const isChecked = $(this).prop('checked');
				$('#Contract_CashDiscountPercentage, #txtCashDiscountPaymentTerm')
					.prop('disabled', !isChecked);
			});

			// ==============================
			// BEDRIJFSNAAM AUTOCOMPLETE
			// ==============================
			$('#ddlCompany').select2({
				theme: 'bootstrap',
				minimumInputLength: 3,
				width: '100%',
				placeholder: "Typ om een leverancier te zoeken...",
				allowClear: true,
				language: "nl",
				ajax: {
					url: '@Url.Action("GetCompanys", "Projecten")',
					type: 'POST',
					dataType: 'json',
					delay: 250,
					data: params => ({ term: params.term }),
					processResults: data => {
						const results = $.map(data, item => ({ id: item.id, text: item.text, vat: item.extra }));
						results.push({ id: '__new__', text: 'Nieuwe leverancier toevoegen' });
						return { results };
					},
					cache: true
				},
				templateResult: function (data) {
					if (!data.id) return data.text;
					if (data.id === '__new__') {
						return $('<div class="company-picker-result company-picker-new"><i class="bx bx-plus-circle me-1"></i>' + data.text + '</div>');
					}
					const $r = $('<div class="company-picker-result"><span class="name"></span><span class="vat"></span></div>');
					$r.find('.name').text(data.text);
					$r.find('.vat').text(formatVat(data.vat));
					return $r;
				}
			});

			$('#ddlCompany').on('select2:select', function (e) {
				const selectedData = e.params && e.params.data;
				if (!selectedData || !selectedData.id) return;

				if (selectedData.id === '__new__') {
					$('#ddlCompany').val(null).trigger('change');
					new bootstrap.Modal(document.getElementById('modalNewSupplier')).show();
					return;
				}

				selectCompany(selectedData.id, selectedData.text, selectedData.vat, true);
			});

			$('#btnClearCompany').on('click', function () {
				if ($('#ActivityRows').children().length &&
					!window.confirm('De activiteiten die je aan dit contract koppelde, gaan verloren als je van leverancier wisselt. Doorgaan?')) {
					return;
				}
				$('#txtCompanyID').val('0');
				$('#txtCompanyDisplay').val('');
				$('#companySelected').addClass('d-none');
				$('#ddlCompany').val(null).trigger('change');
				$('#ddlCompanyWrapper').removeClass('d-none');
				$('#companyContractDefaultsNote').addClass('d-none');
				setActivitiesCompanyState(false, '');
				clearActivityRows();
				$('#btnNewSiteManager').prop('disabled', true).attr('title', 'Eerst een leverancier kiezen');
				$('#ddlSiteManager').empty().append(new Option('Geen', '', false, false));
			});

			// ==============================
			// ACTIVITEIT-KIEZER IN MODAL (bestaande catalogus, gegroepeerd per lot)
			// ==============================
			$('#naActivity').select2({
				theme: 'bootstrap',
				width: '100%',
				placeholder: 'Selecteer een activiteit...',
				dropdownParent: $('#modalNewActivity')
			});

			// ==============================
			// INITIËLE STAAT
			// ==============================
			const initialCompanyId = $('#txtCompanyID').val();
			if (initialCompanyId && initialCompanyId !== "0") {
				setActivitiesCompanyState(true, $('#txtCompanyDisplay').val());
				LoadActivities(initialCompanyId);
				LoadSiteManagers(initialCompanyId, '#ddlSiteManager');
				$('#btnNewSiteManager').prop('disabled', false).attr('title', 'Nieuwe werfleider toevoegen');
			}

			$('#chkCashDiscount').trigger('change');
			$('#ActivityRows').children().each(function () {
				const id = $(this).find('input[name$=".Activity.ID"]').val();
				if (id) addedActivityIds.add(String(id));
			});
			toggleEmptyActivitiesHint();
			recomputeActivitiesTotal();

			// Tekenteller voor "opmerking verzending" (max 200)
			const $sentNote = $('#txtContractSentNote');
			if ($sentNote.length) {
				const updateSentNoteCount = () => $('#contractSentNoteCount').text(($sentNote.val() || '').length);
				$sentNote.on('input', updateSentNoteCount);
				updateSentNoteCount();
			}

			// Waarschuwen bij onopgeslagen wijzigingen
			let formDirty = false, formSubmitting = false;
			const $form = $('#addContractForm');
			$form.on('input change', ':input', function () { formDirty = true; });
			$(window).on('beforeunload', function () {
				if (formDirty && !formSubmitting) return '';
			});

			// Submit: knop met spinner, dubbele submit blokkeren (label blijft staan)
			$form.find('button[type="submit"]').on('click', function () { $form.data('submitter', this); });
			$form.on('submit', function () {
				formSubmitting = true;
				const $clicked = $($form.data('submitter'));
				if ($clicked.length) {
					$clicked.find('i.bx').addClass('d-none');
					$clicked.prepend('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>');
				}
				const $btns = $form.find('button[type="submit"]');
				setTimeout(function () { $btns.prop('disabled', true); }, 0);
			});

			// Server-validatie: focus naar het eerste veld met een fout
			const firstInvalid = document.querySelector('.input-validation-error');
			if (firstInvalid) { firstInvalid.focus(); }

			// Desktop: het zoekveld voor de leverancier meteen openen
			if ((!initialCompanyId || initialCompanyId === '0') &&
				window.matchMedia('(min-width: 992px)').matches) {
				setTimeout(function () { $('#ddlCompany').select2('open'); }, 150);
			}

			initEuroInput('.Currencymask');
		});

		// ==============================
		// LEVERANCIER SELECTEREN (zoekresultaat of net aangemaakt)
		// ==============================
		function selectCompany(id, text, vat, fetchDefaults) {
			$('#txtCompanyID').val(id);
			$('#txtCompanyDisplay').val(text);

			$('#companySelectedName').text(text);
			$('#companySelectedVat').text(formatVat(vat));
			$('#companySelected').removeClass('d-none');
			$('#ddlCompanyWrapper').addClass('d-none');

			setActivitiesCompanyState(true, text);
			$('#btnNewSiteManager').prop('disabled', false).attr('title', 'Nieuwe werfleider toevoegen');

			LoadActivities(id);
			LoadSiteManagers(id, '#ddlSiteManager');

			if (fetchDefaults) {
				$.ajax({
					type: 'POST',
					url: '@Url.Action("GetCompanyContractDefaults", "Projecten")',
					data: { companyid: id },
					dataType: 'json',
					success: function (data) {
						if (!data || !data.found) {
							$('#companyContractDefaultsNote').addClass('d-none');
							return;
						}
						if (data.vatPercentage !== null) setCurrencyValue('#Contract_VatPercentage', data.vatPercentage);
						if (data.paymentTerm !== null) $('#txtPaymentTerm').val(data.paymentTerm);
						if (data.guaranteeType !== null) {
							$('#lstGuaranteeType').val(data.guaranteeType).trigger('change');
						}
						if (data.guaranteePercentage !== null) setCurrencyValue('#Contract_GuaranteePercentage', data.guaranteePercentage);
						$('#companyContractDefaultsNote').removeClass('d-none');
					},
					error: function () {
						$('#companyContractDefaultsNote').addClass('d-none');
					}
				});
			} else {
				$('#companyContractDefaultsNote').addClass('d-none');
			}
		}

		function setActivitiesCompanyState(hasCompany, companyName) {
			$('#btnNewActivity, #btnAddActivities').prop('disabled', !hasCompany);
			if (hasCompany) {
				// Tekst in gewone naamval laten; .text-uppercase (CSS) zorgt voor de visuele hoofdletters
				$('#companyActivitiesTitle').text('Activiteiten van ' + (companyName || ''));
				$('#activityRowsHead').toggleClass('d-none', $('#ActivityRows').children().length === 0);
				$('#activityRowsTotal').removeClass('d-none');
			} else {
				$('#companyActivitiesTitle').text('Kies eerst een leverancier');
				$('#availableActivitiesList').removeClass().addClass('empty-state-box mb-4').text('Kies eerst een leverancier hierboven.');
				$('#activityRowsHead').addClass('d-none');
				$('#activityRowsTotal').addClass('d-none');
			}
		}

		// ==============================
		// ACTIVITEITEN VAN LEVERANCIER OPHALEN (checkbox-lijst)
		// ==============================
		function LoadActivities(companyId) {
			$.ajax({
				type: 'POST',
				url: '@Url.Action("GetCompanyActivities", "Projecten")',
				data: { companyid: companyId },
				dataType: 'json',
				success: function (data) {
					const $list = $('#availableActivitiesList');
					const remaining = (data || []).filter(item => !addedActivityIds.has(String(item.id)));

					if (remaining.length === 0) {
						$list.removeClass().addClass('empty-state-box mb-4').text('Geen activiteiten meer beschikbaar. Voeg een bestaande activiteit uit de catalogus toe.');
						return;
					}

					$list.removeClass('empty-state-box').addClass('border rounded p-3 mb-4').empty();
					remaining.forEach(function (item) {
						const id = 'actchk-' + item.id;
						const $row = $('<div class="form-check"></div>');
						$row.append($('<input type="checkbox" class="form-check-input avail-activity-checkbox">').attr('id', id).val(item.id).data('text', item.text));
						$row.append($('<label class="form-check-label"></label>').attr('for', id).text(item.text));
						$list.append($row);
					});
				},
				error: function (xhr, status, error) {
					console.error('Fout bij ophalen activiteiten:', error);
				}
			});
		}

		function LoadSiteManagers(companyId, selectSelector) {
			$.ajax({
				type: 'POST',
				url: '@Url.Action("GetCompanyContacts", "Projecten")',
				data: { companyid: companyId },
				dataType: 'json',
				success: function (data) {
					let $select = $(selectSelector);
					const selectedValue = $select.val();
					$select.empty();
					$select.append(new Option('Geen', '', false, false));
					$.each(data, function (i, item) {
						$select.append(new Option(item.text, item.id, false, false));
					});
					if (selectedValue) {
						$select.val(selectedValue);
					}
				},
				error: function (xhr, status, error) {
					console.error('Fout bij ophalen contactpersonen:', error);
				}
			});
		}

		// ==============================
		// ACTIVITEITEN TOEVOEGEN AAN CONTRACT
		// ==============================
		$('#btnAddActivities').on('click', function () {
			const $checked = $('.avail-activity-checkbox:checked');
			if ($checked.length === 0) return false;

			$checked.each(function () {
				addActivityRow($(this).val(), $(this).data('text'));
			});

			return false;
		});

		function addActivityRow(activityId, activityName) {
			const companyId = $('#txtCompanyID').val();
			$.ajax({
				url: '@Url.Action("AddContractActivitySelection", "Projecten")',
				data: { companyId: companyId, activityId: activityId, activityName: activityName },
				cache: false,
				traditional: true,
				type: 'POST',
				success: function (result) {
					const $row = $(result);
					$('#ActivityRows').append($row);
					initEuroInput($row.find('.Currencymask'));
					addedActivityIds.add(String(activityId));
					$('#activityRowsHead').removeClass('d-none');
					toggleEmptyActivitiesHint();
					recomputeActivitiesTotal();

					if (companyId && companyId !== "0") {
						LoadActivities(companyId);
					}
				}
			});
		}

		// ==============================
		// ACTIVITEIT VERWIJDEREN
		// ==============================
		$(document).on('click', 'button.deleterow', function () {
			if (!window.confirm('Deze activiteit van het contract verwijderen?')) { return false; }
			$(this).closest('div').parent('div').parent('div').remove();
			const activiteitId = $(this).data('id');
			addedActivityIds.delete(String(activiteitId));
			toggleEmptyActivitiesHint();
			recomputeActivitiesTotal();

			const companyId = $('#txtCompanyID').val();
			if (companyId && companyId !== "0") {
				LoadActivities(companyId);
			}
			return false;
		});

		function clearActivityRows() {
			$('#ActivityRows').empty();
			addedActivityIds.clear();
			toggleEmptyActivitiesHint();
			recomputeActivitiesTotal();
		}

		function toggleEmptyActivitiesHint() {
			const hasRows = $('#ActivityRows').children().length > 0;
			$('#noActivitiesHint').toggleClass('d-none', hasRows);
			if (($('#txtCompanyID').val() || '0') !== '0') {
				$('#activityRowsHead').toggleClass('d-none', !hasRows);
			}
		}

		function recomputeActivitiesTotal() {
			let total = 0;
			$('#ActivityRows .Currencymask').each(function () {
				const an = AutoNumeric.getAutoNumericElement(this);
				const val = an ? an.getNumber() : parseFloat(($(this).val() || '0').replace(/\./g, '').replace(',', '.'));
				if (!isNaN(val)) total += val;
			});
			const formatted = total.toLocaleString('nl-BE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
			$('#activitiesTotal').text('€ ' + formatted);
		}

		$(document).on('input change', '#ActivityRows .Currencymask', function () {
			recomputeActivitiesTotal();
		});

		// ==============================
		// MODAL: NIEUWE LEVERANCIER
		// ==============================
		$('#nsBtnValidateVat').on('click', function () {
			const vatNumber = ($('#nsVat').val() || $('#nsEnterpriseNumber').val() || '').toString().trim();
			if (!vatNumber) {
				notify('Ongeldig btw-nummer', 'Vul eerst een btw- of ondernemingsnummer in.', 'warning');
				return;
			}

			const button = $(this);
			const $icon = button.find('i');
			const iconCls = $icon.attr('class');
			button.prop('disabled', true);
			$icon.attr('class', 'spinner-border spinner-border-sm me-1');

			$.getJSON('@Url.Action("ValidateVat", "Leveranciers")', { vatCountryCode: 'BE', vatNumber: vatNumber })
				.done(function (data) {
					if (!data || data.valid === false) {
						notify('Ongeldig btw-nummer', 'Dit btw-nummer werd niet gevonden.', 'error');
						return;
					}

					const address = data.address || {};
					if (data.name) $('#nsName').val(data.name);
					if (address.street) $('#nsStreet').val(address.street);
					if (address.number) $('#nsHouseNumber').val(address.number);
					const postal = address.zip || address.zip_code || address.postcode;
					if (postal) $('#nsPostalCode').val(postal);
					if (address.city) $('#nsCity').val(address.city);

					notify('Btw-nummer gevonden', 'De gegevens werden overgenomen.', 'success');
				})
				.fail(function (xhr) {
					const message = xhr.responseJSON && xhr.responseJSON.error
						? xhr.responseJSON.error
						: 'De validatie van het btw-nummer is mislukt.';
					notify('Fout bij controle', message, 'error');
				})
				.always(function () {
					button.prop('disabled', false);
					$icon.attr('class', iconCls);
				});
		});

		$('#btnCreateSupplier').on('click', function () {
			const $errors = $('#nsErrors').addClass('d-none').empty();
			const button = $(this);
			button.prop('disabled', true);

			$.ajax({
				type: 'POST',
				url: '@Url.Action("CreateQuick", "Leveranciers")',
				data: {
					Name: $('#nsName').val(),
					SelectedLegalFormId: $('#nsLegalForm').val(),
					EnterpriseNumber: $('#nsEnterpriseNumber').val(),
					VatNumber: $('#nsVat').val(),
					Street: $('#nsStreet').val(),
					HouseNumber: $('#nsHouseNumber').val(),
					BusNumber: $('#nsBusNumber').val(),
					PostalCode: $('#nsPostalCode').val(),
					City: $('#nsCity').val(),
					SelectedCountryId: $('#nsCountryId').val(),
					Email: $('#nsEmail').val(),
					__RequestVerificationToken: antiforgeryToken()
				},
				dataType: 'json'
			}).done(function (data) {
				if (!data || !data.success) {
					const messages = (data && data.errors && data.errors.length) ? data.errors : ['De leverancier kon niet worden aangemaakt.'];
					$errors.removeClass('d-none').html(messages.map(m => '<div>' + m + '</div>').join(''));
					return;
				}

				bootstrap.Modal.getOrCreateInstance(document.getElementById('modalNewSupplier')).hide();
				document.getElementById('modalNewSupplier').querySelectorAll('input').forEach(i => i.value = '');
				selectCompany(data.id, data.text, data.vat, true);
			}).fail(function (xhr) {
				const messages = (xhr.responseJSON && xhr.responseJSON.errors && xhr.responseJSON.errors.length)
					? xhr.responseJSON.errors
					: ['De leverancier kon niet worden aangemaakt.'];
				$errors.removeClass('d-none').html(messages.map(m => '<div>' + m + '</div>').join(''));
			}).always(function () {
				button.prop('disabled', false);
			});
		});

		// MODAL: NIEUWE WERFLEIDER → zie Partials/_SiteManagerNewModal.cshtml (onderaan deze sectie)

		// ==============================
		// MODAL: ACTIVITEIT TOEVOEGEN (bestaande activiteit uit de catalogus)
		// ==============================
		$('#btnNewActivity').on('click', function () {
			const companyId = $('#txtCompanyID').val();
			if (!companyId || companyId === "0") return;
			$('#naForLabel').text('Voor: ' + $('#txtCompanyDisplay').val());
			$('#naErrors').addClass('d-none').empty();
			$('#naActivity').val(null).trigger('change');
			new bootstrap.Modal(document.getElementById('modalNewActivity')).show();
		});

		$('#btnCreateActivity').on('click', function () {
			const activityId = $('#naActivity').val();
			const activityName = $('#naActivity option:selected').text();
			const $errors = $('#naErrors').addClass('d-none').empty();

			if (!activityId) {
				$errors.removeClass('d-none').text('Kies een activiteit.');
				return;
			}

			addActivityRow(activityId, activityName);
			bootstrap.Modal.getOrCreateInstance(document.getElementById('modalNewActivity')).hide();
			$('#naActivity').val(null).trigger('change');
		});
	</script>

	@await Html.PartialAsync("Partials/_SiteManagerNewModal")
}
