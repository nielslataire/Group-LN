@using CPMCore.Controllers
@using BOCore
@model CPMCore.Models.Projecten.BudgetGevelsDakModel
@{
    var t = Model.Totaal;
    string Fmt(decimal v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    List<BudgetGevelElementBO> Rows(string key) =>
        Model.Elementen.GetValueOrDefault(key) ?? new List<BudgetGevelElementBO>();

    // Eén definitie voor de zes types — voedt zowel de type-rail als de accordion.
    var dakTypes = new (string Key, string Label, string Icon, List<BudgetGevelElementBO> Rijen, decimal Sub)[]
    {
        ("PlatDak",          "Plat dak",          "fa-square",          Rows("PlatDak"),          t.TotaalPlatDak),
        ("HellendDak",       "Hellend dak",       "fa-caret-up",        Rows("HellendDak"),       t.TotaalHellendDak),
        ("GroenDak",         "Groen dak",         "fa-leaf",            Rows("GroenDak"),         t.TotaalGroenDak),
        ("Dakoversteken",    "Dakoversteken",     "fa-arrows-up-down",  Rows("Dakoversteken"),    t.TotaalDakoversteken),
        ("OnderkantDoorrit", "Onderkant doorrit", "fa-door-open",       Rows("OnderkantDoorrit"), t.TotaalOnderkantDoorrit),
        ("Afbraak",          "Afbraak",           "fa-hammer",          Rows("Afbraak"),          t.TotaalAfbraak),
    };
    var anyRows = dakTypes.Any(x => x.Rijen.Count > 0);
}
@section PageStyle {
    <link rel="stylesheet" href="~/css/budget-wizard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/projecten-custom.css" asp-append-version="true" />
    <style>
        /* Hide Hoogte column (5th) — Dak/Afbraak use Breedte × Lengte */
        .table-hide-hoogte th:nth-child(5),
        .table-hide-hoogte td:nth-child(5) { display: none; }

        .bw-table.dak-table td, .bw-table.dak-table th { padding: .35rem .6rem; }
        .bw-table.dak-table th.bw-th-cell { padding-left: calc(.6rem + 11px); padding-right: calc(.6rem + 11px); }

        /* ── Elke sectie = een losstaande kaart, met lucht ertussen ── */
        #dakAccordion { display: flex; flex-direction: column; gap: .85rem; }
        #dakAccordion .accordion-item {
            border: 1px solid var(--border, #e7e7e7);
            border-radius: var(--radius, 7px);
            box-shadow: 0 1px 4px rgba(0, 0, 0, .08);
            background: var(--white, #fff);
            overflow: hidden;
        }
        #dakAccordion .accordion-header { margin: 0; }
        #dakAccordion .accordion-button {
            padding: .7rem 1rem;
            font-weight: 700;
            font-size: .95rem;
            color: var(--dark, #222);
            background: var(--white, #fff);
        }
        #dakAccordion .accordion-button:not(.collapsed) {
            background: var(--lightgreen, #e8f0eb);
            color: var(--primary, #0a5a3b);
            box-shadow: inset 0 -1px 0 var(--border, #e7e7e7);
        }
        #dakAccordion .accordion-button.collapsed { box-shadow: none; }
        #dakAccordion .accordion-button:focus {
            border-color: var(--primary, #0a5a3b);
            box-shadow: 0 0 0 .2rem rgba(10, 90, 59, .2);
        }
        #dakAccordion .accordion-button::after {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='none' stroke='%230a5a3b' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3e%3cpath d='M4 6l4 4 4-4'/%3e%3c/svg%3e");
            background-size: 1rem;
        }
        #dakAccordion .accordion-body { padding: 0; }

        /* Veluxen — losse teller, eigen kaartje onder de type-rail */
        .dak-velux {
            display: flex;
            align-items: center;
            gap: .75rem;
            margin-bottom: 1rem;
            padding: .6rem .9rem;
            border: 1px solid var(--border, #e7e7e7);
            border-radius: var(--radius, 7px);
            background: var(--white, #fff);
        }
        .dak-velux__badge {
            flex: none;
            width: 34px;
            height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius, 7px);
            background: var(--lightgreen, #e8f0eb);
            color: var(--primary, #0a5a3b);
        }
        .dak-velux__text { display: flex; flex-direction: column; line-height: 1.25; }
        .dak-velux__title { font-size: .85rem; font-weight: 700; color: var(--dark, #222); }
        .dak-velux__hint { font-size: .75rem; color: var(--muted, #8590a5); }
        .dak-velux > input { margin-left: auto; width: 88px; flex: none; }

        #dak-empty {
            margin: 0;
            padding: 2rem 1rem;
            text-align: center;
            color: var(--muted, #8590a5);
            font-size: .85rem;
            border: 1px dashed var(--border, #e7e7e7);
            border-radius: var(--radius, 7px);
            background: var(--white, #fff);
        }
    </style>
}
@{
    ViewBag.Breadcrumbs = new List<Breadcrumb>()
    {
        new Breadcrumb("Home",         nameof(HomeController.Index),              "Home",       true),
        new Breadcrumb("Projecten",    nameof(ProjectenController.Index),         "Projecten",  true),
        new Breadcrumb("Detail",       nameof(ProjectenController.Detail),        "Projecten",  true),
        new Breadcrumb("Budgetten",    nameof(ProjectenController.BudgetIndex),   "Projecten",  true),
        new Breadcrumb("Dak & Afbraak",nameof(ProjectenController.BudgetDakAfbraak),"Projecten",false),
    };
}
@Html.AntiForgeryToken()

<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", Model.ProjectId)
        <div class="inner-body bw-inner-body">

            @* ── Wizard tabbladen ── *@
            @await Html.PartialAsync("Partials/_BudgetWizardTabs", new BudgetWizardTabsModel { VersieId = Model.VersieId, ActiveStep = 5 })

            <div class="bw-scroll">

            <div class="gl-form-section__head bw-step-head">
                <i class="fa-solid fa-house" aria-hidden="true"></i>
                <div>
                    <h2 class="gl-form-section__title">Dak &amp; afbraak</h2>
                    <p class="gl-form-section__hint">Dakoppervlaktes per type (plat, hellend, groen), dakoversteken, doorritten en afbraakwerken.</p>
                </div>
                @await Html.PartialAsync("Partials/_BudgetPageHeader", new BudgetPageHeaderModel
                {
                    StepNum     = 5,
                    MasterNaam  = Model.MasterNaam,
                    VersieLabel = Model.VersieLabel
                })
            </div>

            @* ── Type-rail: subtotaal + sprong/toevoegen per type ── *@
            <div class="dak-rail" id="dakRail">
                @foreach (var dt in dakTypes)
                {
                    var has = dt.Rijen.Count > 0;
                    <button type="button"
                            class="dak-rail__chip@(has ? "" : " dak-rail__chip--empty")"
                            data-type="@dt.Key"
                            aria-label="@(has ? $"Ga naar {dt.Label}" : $"{dt.Label} toevoegen")">
                        <i class="fa-solid @dt.Icon" aria-hidden="true"></i>
                        <span class="dak-rail__name">@dt.Label</span>
                        <span class="dak-rail__val" id="rail-@dt.Key">
                            @if (has)
                            {
                                @($"{Fmt(dt.Sub)} m²")
                            }
                            else
                            {
                                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                            }
                        </span>
                    </button>
                }
            </div>

            @* ── Veluxen: losse teller, geen tabel ── *@
            <div class="dak-velux">
                <span class="dak-velux__badge"><i class="fa-solid fa-window-maximize" aria-hidden="true"></i></span>
                <div class="dak-velux__text">
                    <span class="dak-velux__title">Veluxen</span>
                    <span class="dak-velux__hint">Aantal dakvensters in dit budget</span>
                </div>
                <input type="number" min="0" id="input-veluxen"
                       class="bw-cell-input bw-cell-input--num" value="@(Model.AantalVeluxen ?? 0)" />
            </div>

            @* ── Secties: enkel de types die rijen hebben (of net toegevoegd zijn) ── *@
            <div class="accordion accordion-flush" id="dakAccordion">
                @foreach (var dt in dakTypes)
                {
                    var has = dt.Rijen.Count > 0;
                    <div class="accordion-item" data-type="@dt.Key" @(has ? "" : "hidden")>
                        <h2 class="accordion-header">
                            <button class="accordion-button@(has ? "" : " collapsed")" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#dak-@dt.Key"
                                    aria-expanded="@(has ? "true" : "false")" aria-controls="dak-@dt.Key">
                                <i class="fa-solid @dt.Icon me-2 text-primary" aria-hidden="true"></i>@dt.Label
                                <span class="badge bg-primary ms-auto" id="sub-@dt.Key">@Fmt(dt.Sub) m²</span>
                            </button>
                        </h2>
                        <div id="dak-@dt.Key" class="accordion-collapse collapse@(has ? " show" : "")">
                            <div class="accordion-body">
                                @await Html.PartialAsync("Partials/_DakAfbraakSectie", new CPMCore.Models.Projecten.DakSectieVM {
                                    ElementType = dt.Key,
                                    Rijen       = dt.Rijen,
                                    VersieId    = Model.VersieId,
                                    Subtotaal   = dt.Sub
                                })
                            </div>
                        </div>
                    </div>
                }
            </div>

            <p id="dak-empty" @(anyRows ? "hidden" : "")>
                Nog geen dak- of afbraakwerken. Kies hierboven een type om te beginnen.
            </p>

            @* ── Onderaan navigeren ── *@
            </div>
            <div class="bw-bottom-nav">
                <a href="@Url.Action("BudgetGevels", "Projecten", new { versieId = Model.VersieId })" class="bw-bottom-nav__back">
                    <i class="fas fa-chevron-left me-1"></i>Vorige: Gevels
                </a>
                <span class="bw-bottom-nav__indicator">Stap 5 van 9 — Dak &amp; Afbraak</span>
                <a href="@Url.Action("BudgetActivityLijnen", "Projecten", new { versieId = Model.VersieId })" class="bw-bottom-nav__next">
                    Volgende: Activiteiten <i class="fas fa-chevron-right ms-1"></i>
                </a>
            </div>

            @await Html.PartialAsync("Partials/_BudgetConfirmModal")

        </div>
    </div>
</section>

@section PageScripts {
<script src="~/js/budget-wizard.js"></script>
<script>
    const antiForgery = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const versieId    = @Model.VersieId;

    const DAK_TYPES = ['PlatDak', 'HellendDak', 'GroenDak', 'Dakoversteken', 'OnderkantDoorrit', 'Afbraak'];

    // ── Type-rail: sectie openen / aanmaken ─────────────────────────────────
    function sectionItem(type) { return document.querySelector(`.accordion-item[data-type="${type}"]`); }
    function railChip(type)    { return document.querySelector(`.dak-rail__chip[data-type="${type}"]`); }

    function openSection(type, focusAdd) {
        const item = sectionItem(type);
        if (!item) return;
        const wasHidden = item.hidden;
        item.hidden = false;
        document.getElementById('dak-empty')?.setAttribute('hidden', '');

        const chip = railChip(type);
        if (chip && chip.classList.contains('dak-rail__chip--empty')) {
            chip.classList.remove('dak-rail__chip--empty');
            const val = document.getElementById('rail-' + type);
            if (val) val.textContent = '0,00 m²';
        }

        const collapseEl = item.querySelector('.accordion-collapse');
        if (collapseEl) bootstrap.Collapse.getOrCreateInstance(collapseEl).show();

        if (wasHidden || focusAdd) {
            item.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            if (focusAdd) setTimeout(() => item.querySelector('.add-eenheid')?.focus(), 350);
        }
    }

    function syncEmptyState() {
        const anyVisible = DAK_TYPES.some(tp => sectionItem(tp) && !sectionItem(tp).hidden);
        const empty = document.getElementById('dak-empty');
        if (empty) empty.hidden = anyVisible;
    }

    document.getElementById('dakRail').addEventListener('click', e => {
        const chip = e.target.closest('.dak-rail__chip');
        if (!chip) return;
        openSection(chip.dataset.type, chip.classList.contains('dak-rail__chip--empty'));
    });

    // ── Client-side calculation (Breedte × Lengte voor dak/afbraak) ───────────
    function calcRow(row) {
        const n = parseFloat(row.querySelector('[data-field="aantal"]')?.value)  || 0;
        const b = parseFloat(row.querySelector('[data-field="breedte"]')?.value) || 0;
        const l = parseFloat(row.querySelector('[data-field="lengte"]')?.value)  || 0;
        return n * b * l;
    }

    function updateRowResultaat(row) {
        const val  = calcRow(row);
        const span = row.querySelector('.resultaat-value');
        if (span) span.textContent = val.toFixed(2).replace('.', ',');
    }

    // ── Debounced save ────────────────────────────────────────────────────────
    const saveTimers = {};

    function queueSave(row) {
        updateRowResultaat(row);
        const id = row.dataset.elementId;
        clearTimeout(saveTimers[id]);
        saveTimers[id] = setTimeout(() => saveRow(row), 400);
    }

    async function saveRow(row) {
        const bVal = parseFloat(row.querySelector('[data-field="breedte"]')?.value) || 0;
        const lVal = parseFloat(row.querySelector('[data-field="lengte"]')?.value)  || 0;

        const payload = {
            elementId:    parseInt(row.dataset.elementId),
            versieId:     versieId,
            elementType:  row.dataset.elementType,
            eenheidNaam:  row.querySelector('[data-field="eenheidNaam"]')?.value ?? '',
            beschrijving: row.querySelector('[data-field="beschrijving"]')?.value ?? '',
            aantal:       parseFloat(row.querySelector('[data-field="aantal"]')?.value) || 0,
            breedte:      bVal === 0 ? null : bVal,
            hoogte:       null,
            lengte:       lVal === 0 ? null : lVal
        };

        try {
            const resp   = await fetch('/Projecten/BudgetGevelElementOpslaan', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgery },
                body:    JSON.stringify(payload)
            });
            const result = await resp.json();
            if (result.success) {
                updateTotals(result.totaal);
                const detail = row.querySelector('.calc-detail');
                if (detail) detail.textContent = result.formula;
                const cell = row.querySelector('.gevel-resultaat-cell');
                if (cell) cell.title = result.formula;
            }
        } catch (e) { console.error('Save fout:', e); }
    }

    // ── Event listeners voor inputs ───────────────────────────────────────────
    document.querySelector('.inner-body').addEventListener('change', e => {
        if (e.target.classList.contains('gevel-input')) {
            const row = e.target.closest('tr');
            if (row) queueSave(row);
        }
    });

    // ── Totalen bijwerken: rail-chip, sectiekop-badge, tabel-subtotaal ──────
    function fmt(v) { return parseFloat(v || 0).toFixed(2).replace('.', ','); }

    const TOTAL_KEY = {
        PlatDak: 'totaalPlatDak', HellendDak: 'totaalHellendDak', GroenDak: 'totaalGroenDak',
        Dakoversteken: 'totaalDakoversteken', OnderkantDoorrit: 'totaalOnderkantDoorrit', Afbraak: 'totaalAfbraak'
    };

    function updateTotals(totaal) {
        DAK_TYPES.forEach(key => {
            const txt = fmt(totaal[TOTAL_KEY[key]] ?? 0) + ' m²';

            const subEl   = document.getElementById('sub-' + key);
            const tfootEl = document.getElementById('tfoot-' + key);
            const railEl  = document.getElementById('rail-' + key);
            if (subEl)   subEl.textContent   = txt;
            if (tfootEl) tfootEl.textContent = txt;

            // rail toont het cijfer zodra het type een sectie heeft
            const chip = railChip(key);
            if (railEl && chip && !chip.classList.contains('dak-rail__chip--empty')) {
                railEl.textContent = txt;
            }
        });
    }

    // ── Rij toevoegen ─────────────────────────────────────────────────────────
    document.querySelector('.inner-body').addEventListener('click', async function (e) {
        const addBtn = e.target.closest('.btn-add-element');
        if (addBtn) {
            const type       = addBtn.dataset.type;
            const eenheidInp = document.querySelector(`.add-eenheid[data-type="${type}"]`);
            const beschrInp  = document.querySelector(`.add-beschrijving[data-type="${type}"]`);

            const params = new URLSearchParams({
                versieId,
                elementType:  type,
                eenheidNaam:  eenheidInp?.value ?? '',
                beschrijving: beschrInp?.value  ?? ''
            });

            const resp = await fetch('/Projecten/BudgetGevelElementToevoegen', {
                method:  'POST',
                headers: { 'RequestVerificationToken': antiForgery, 'Content-Type': 'application/x-www-form-urlencoded' },
                body:    params.toString()
            });
            if (!resp.ok) { alert('Fout bij toevoegen.'); return; }

            const html   = await resp.text();
            const tbody  = document.getElementById('tbody-' + type);
            const temp   = document.createElement('tbody');
            temp.innerHTML = html;
            const newRow = temp.querySelector('tr');
            if (newRow && tbody) tbody.appendChild(newRow);

            if (eenheidInp) eenheidInp.value = '';
            if (beschrInp)  beschrInp.value  = '';
            syncEmptyState();
        }

        // ── Verwijderen ───────────────────────────────────────────────────
        const delBtn = e.target.closest('.btn-delete-gevel');
        if (delBtn) {
            const row = delBtn.closest('tr');
            if (!row) return;
            if (!await BudgetWizard.confirmModal({
                title: 'Element verwijderen',
                body: 'Ben je zeker dat je dit dak-/afbraakelement wil verwijderen?'
            })) return;

            const params = new URLSearchParams({ elementId: row.dataset.elementId, versieId });
            const resp   = await fetch('/Projecten/BudgetGevelElementVerwijderen', {
                method:  'POST',
                headers: { 'RequestVerificationToken': antiForgery, 'Content-Type': 'application/x-www-form-urlencoded' },
                body:    params.toString()
            });
            const result = await resp.json();
            if (result.success) {
                const type  = row.dataset.elementType;
                const tbody = document.getElementById('tbody-' + type);
                row.remove();
                updateTotals(result.totaal);

                // laatste rij weg → sectie verdwijnt, type keert terug als lege chip
                if (tbody && tbody.querySelectorAll('tr').length === 0) {
                    const item = sectionItem(type);
                    if (item) item.hidden = true;
                    const chip = railChip(type);
                    if (chip) chip.classList.add('dak-rail__chip--empty');
                    const val = document.getElementById('rail-' + type);
                    if (val) val.innerHTML = '<i class="fa-solid fa-plus" aria-hidden="true"></i>';
                    syncEmptyState();
                }
            }
        }

        // ── Dupliceren ────────────────────────────────────────────────────
        const dupBtn = e.target.closest('.btn-duplicate-gevel');
        if (dupBtn) {
            const row  = dupBtn.closest('tr');
            const type = row?.dataset.elementType;
            if (!row || !type) return;

            const params = new URLSearchParams({
                versieId,
                elementType:  type,
                eenheidNaam:  (row.querySelector('[data-field="eenheidNaam"]')?.value ?? '') + ' (kopie)',
                beschrijving: row.querySelector('[data-field="beschrijving"]')?.value ?? ''
            });
            const resp = await fetch('/Projecten/BudgetGevelElementToevoegen', {
                method:  'POST',
                headers: { 'RequestVerificationToken': antiForgery, 'Content-Type': 'application/x-www-form-urlencoded' },
                body:    params.toString()
            });
            if (!resp.ok) return;
            const html  = await resp.text();
            const tbody = document.getElementById('tbody-' + type);
            const temp  = document.createElement('tbody');
            temp.innerHTML = html;
            const newRow = temp.querySelector('tr');
            if (newRow && tbody) tbody.appendChild(newRow);
        }
    });

    // ── Veluxen auto-save ─────────────────────────────────────────────────────
    let veluxTimer;
    document.getElementById('input-veluxen')?.addEventListener('change', function () {
        clearTimeout(veluxTimer);
        const val = parseInt(this.value) || 0;
        veluxTimer = setTimeout(async () => {
            const params = new URLSearchParams({ versieId, aantalVeluxen: val });
            await fetch('/Projecten/BudgetAantalVeluxenOpslaan', {
                method:  'POST',
                headers: { 'RequestVerificationToken': antiForgery, 'Content-Type': 'application/x-www-form-urlencoded' },
                body:    params.toString()
            });
        }, 400);
    });

    // ── Bootstrap tooltips ────────────────────────────────────────────────────
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));
</script>
}
