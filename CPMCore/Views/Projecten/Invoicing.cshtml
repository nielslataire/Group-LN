@model CPMCore.Models.Projecten.ProjectInvoicingModel
@using BOCore
@using System.Globalization

@{
    ViewData["Title"] = "Project – " + Model.ProjectName;
    var canWriteProjectInvoicing = ViewBag.CanWriteProjectInvoicing as bool? ?? false;
}

@section PageStyle {
    <link rel="stylesheet" href="~/css/projecten-custom.css" />
}

@functions {
    string FormatStageName(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return name;
        }

        name = name.Trim();
        return $"{char.ToUpper(name[0], CultureInfo.CurrentCulture)}{(name.Length > 1 ? name.Substring(1).ToLower(CultureInfo.CurrentCulture) : string.Empty)}";
    }
}

<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", Model.ProjectId)
        @Html.AntiForgeryToken()
        <div class="inner-body">
            <div class="row">
                <div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
                    <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
                        <h1 class="font-weight-bold mb-0 mt-0">Facturatie</h1>
                        <h5 class="mb-4 mt-0">Overzicht van alle factureerbare onderdelen</h5>
                    </div>
                    <div class="col-sm-auto px-0">
                        <div class="btn-group" role="group" aria-label="Project acties">
                        <a class="btn btn-default btn-md px-3 me-1" data-bs-toggle="modal" data-bs-target="#modalprintinvoicelist"
                           id="btnPrintInvoiceList" title="Facturatie overzicht" data-id="@Model.ProjectId">
                            <i class="fa fa-bars me-2"></i>Facturatieoverzicht
                        </a>
                        <a class="btn btn-default btn-md px-3 me-1"
                           href="@Url.Action("PaymentStages", "Projecten", new { projectid = Model.ProjectId })"
                           title="Betalingsschijven">
                            <i class="fa fa-chart-pie me-2"></i>Betalingsschijven
                        </a>
                        @if (canWriteProjectInvoicing)
                        {
                            <button type="button" class="btn btn-primary btn-md px-3" id="btnInvoicing" data-bs-toggle="tooltip" title="Facturen opmaken" disabled>
                                <i class="fa fa-euro-sign me-2"></i>Facturen opmaken
                            </button>
                        }
                        </div>
                    </div>
                </div>
            </div>

            <div class="coord-tabs" role="tablist">
                <button class="coord-tab active" type="button" data-invoice-section="schijven">Schijven</button>
                <button class="coord-tab" type="button" data-invoice-section="meerwerken">Meerwerken</button>
                <button class="coord-tab" type="button" data-invoice-section="nutsaansluitingen">Nutsaansluitingen</button>
            </div>

            <div id="invoice-stages-section" class="invoice-section">
                <div class="card card-modern mb-4">
                    <div class="card-header border-0 pb-0">
                        <h2 class="card-title mb-0">Schijven vordering der werken</h2>
                    </div>
                    <div class="card-body pt-2">
                        <div class="table-responsive pt-3">
                            <table class="table align-middle">
                                <thead>
                                    <tr class="table-secondary">
                                        <th>Schijf</th>
                                        <th class="text-end text-nowrap">Percentage</th>
                                        <th class="text-end text-nowrap">Selectie</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ClientAccounts)
                                    {
                                        <tr class="bg-secondary align-middle">
                                            <td class="fw-bold pt-4">
                                                @(item.Client.Name != null
                                                                                            ? $"{item.Client.Salutation.GetDisplayName()} {item.Client.DisplayName}"
                                                                                            : item.Client.DisplayName)
                                        </td>
                                        <td></td>
                                        <td class="text-end">
                                            @if (canWriteProjectInvoicing)
                                                {
                                                    <div class="checkbox-custom checkbox-default d-inline-block">
                                                        <input type="checkbox" class="chkClient"
                                                               id="@($"client-{item.Client.Id}")"
                                                               data-clientaccountid="@item.Client.Id" />
                                                        <label for="@($"client-{item.Client.Id}")"></label>
                                                    </div>
                                                }
                                            </td>
                                        </tr>

                                        foreach (var iu in item.Units)
                                        {
                                            var stageGroups = iu.PaymentStages.GroupBy(x => x.GroupId).ToList();
                                            var isFirstGroupForUnit = true;

                                            foreach (var stageGroup in stageGroups)
                                            {
                                            var groupName = stageGroup.First().GroupName;

                                            <tr class="table-light">
                                                <td>
                                                    <div class="d-flex flex-wrap justify-content-between align-items-center">
                                                            <span>@iu.Unit.Type.Name @(" ") @iu.Unit.Name - @groupName</span>
                                                    </div>
                                                </td>
                                                <td></td>
                                                    <td class="text-end">
                                                        @if ((canWriteProjectInvoicing) && isFirstGroupForUnit)
                                                        {
                                                            <div class="checkbox-custom checkbox-default d-inline-block">
                                                                <input type="checkbox" class="chkUnit"
                                                                       id="@($"client-{item.Client.Id}-unit-{iu.Unit.Id}")"
                                                                       data-unitid="@iu.Unit.Id"
                                                                       data-clientaccountid="@item.Client.Id" />
                                                                <label for="@($"client-{item.Client.Id}-unit-{iu.Unit.Id}")"></label>
                                                            </div>
                                                        }
                                                    </td>
                                            </tr>

                                                foreach (var stage in stageGroup)
                                                {
                                                    <tr>
                                                        <td>
                                                            <i class="fa fa-level-down-alt me-2"></i>@FormatStageName(stage.Name)
                                                        </td>
                                                        <td class="text-end">@stage.Percentage.ToString("0.00") @Html.Raw("%")</td>
                                                        <td class="text-end">
                                                            @if (canWriteProjectInvoicing)
                                                            {
                                                                <div class="checkbox-custom checkbox-default d-inline-block">
                                                                    <input type="checkbox" class="chkInvoice"
                                                                           id="@($"client-{item.Client.Id}-unit-{iu.Unit.Id}-stage-{stage.Id}")"
                                                                           data-id="@stage.Id"
                                                                           data-unitid="@iu.Unit.Id"
                                                                           data-clientaccountid="@item.Client.Id" />
                                                                    <label for="@($"client-{item.Client.Id}-unit-{iu.Unit.Id}-stage-{stage.Id}")"></label>
                                                                </div>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                                isFirstGroupForUnit = false;
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div id="invoice-change-orders-section" class="invoice-section d-none">
                <div class="card card-modern mb-4">
                    <div class="card-header border-0 pb-0">
                        <h2 class="card-title mb-0">Meerwerken / Minwerken</h2>
                    </div>
                    <div class="card-body pt-2">
                        <div class="table-responsive pt-3">
                            <table class="table align-middle">
                                <thead>
                                    <tr class="table-secondary">
                                        <th colspan="2">Wijzigingsopdracht</th>
                                        <th class="text-end text-nowrap">Bedrag</th>
                                        <th class="text-end text-nowrap">Openstaand bedrag</th>
                                        <th class="text-end text-nowrap">Percentage</th>
                                        <th class="text-end text-nowrap">Selectie</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model.ChangeOrderInvoicingClients)
                                    {
                                        var clientLabel = item.Client.Name != null
                                        ? $"{item.Client.Salutation.GetDisplayName()} {item.Client.DisplayName}"
                                        : item.Client.DisplayName;

                                        <tr class="bg-secondary align-middle">
                                            <td colspan="2" class="fw-bold pt-4"> @clientLabel</td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td class="text-end">
                                                @if (canWriteProjectInvoicing)
                                                {
                                                    <div class="checkbox-custom checkbox-default d-inline-block">
                                                        <input type="checkbox" class="chkClientCO" data-clientaccountid="@item.Client.Id" />
                                                    </div>
                                                }
                                            </td>
                                        </tr>

                                        var groupedOrders = item.Rows.GroupBy(r => new { r.ChangeOrderId, r.ChangeOrderDescription });
                                        foreach (var orderGroup in groupedOrders)
                                        {
                                            var detailIds = orderGroup.Select(r => r.ChangeOrderDetailId).Distinct().ToList();
                                            var orderTotal = orderGroup.Sum(r => r.TotalAmount);
                                            var orderRemaining = orderGroup.Sum(r => r.RemainingAmount);

                                            var maxPercentage = orderTotal == 0m
                                            ? 0m
                                            : Math.Round((orderRemaining / orderTotal) * 100m, 2, MidpointRounding.AwayFromZero);

                                            if (maxPercentage < 0m) maxPercentage = 0m;
                                            if (maxPercentage > 100m) maxPercentage = 100m;

                                            var detailIdsCsv = string.Join(",", detailIds);

                                            <tr class="table-light">
                                                <td class="details-control text-center">
                                                    <button type="button"
                                                            class="btn btn-link p-0 co-toggle"
                                                            data-target="co-details-@item.Client.Id-@orderGroup.Key.ChangeOrderId"
                                                            aria-expanded="false"
                                                            title="Toon details">
                                                        <i class="fa fa-plus"></i>
                                                    </button>
                                                </td>

                                                <td>@orderGroup.Key.ChangeOrderDescription</td>

                                                <td class="text-end">@orderTotal.ToString("C")</td>
                                                <td class="text-end">@orderRemaining.ToString("C")</td>

                                                <!-- Percentage (ALTIJD rechts) -->
                                                <td class="text-nowrap">
                                                    <div class="d-flex justify-content-end">
                                                        <div class="input-group input-group-sm w-auto">
                                                            <input type="number"
                                                                   class="form-control text-end co-order-percentage gl-pct-input"
                                                                   data-coid="@orderGroup.Key.ChangeOrderId"
                                                                   data-clientaccountid="@item.Client.Id"
                                                                   data-max="@maxPercentage.ToString(CultureInfo.InvariantCulture)"
                                                                   title="Maximum @maxPercentage.ToString("N2")%"
                                                                   min="0"
                                                                   max="@maxPercentage.ToString(CultureInfo.InvariantCulture)"
                                                                   step="0.01"
                                                                   value="@maxPercentage.ToString(CultureInfo.InvariantCulture)" />
                                                            <span class="input-group-text">
                                                                <i class="fa fa-percentage"></i>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td class="text-end">
                                                    @if (canWriteProjectInvoicing)
                                                    {
                                                        <div class="checkbox-custom checkbox-default d-inline-block">
                                                            <input type="checkbox" class="chkOrderCO"
                                                                   id="@($"client-{item.Client.Id}-co-{orderGroup.Key.ChangeOrderId}")"
                                                                   data-clientaccountid="@item.Client.Id"
                                                                   data-coid="@orderGroup.Key.ChangeOrderId"
                                                                   data-detailids="@detailIdsCsv"
                                                                   data-max="@maxPercentage.ToString(CultureInfo.InvariantCulture)" />
                                                            <label for="@($"client-{item.Client.Id}-co-{orderGroup.Key.ChangeOrderId}")"></label>
                                                        </div>
                                                    }
                                                </td>
                                            </tr>

                                            <tr id="co-details-@item.Client.Id-@orderGroup.Key.ChangeOrderId" class="d-none">
                                                <td></td>
                                                <td colspan="5" class="bg-white">
                                                    <div class="ps-2 pe-2 pb-2">
                                                        <table class="table table-sm mb-0">
                                                            <thead>
                                                                <tr>
                                                                    <th>Detaillijn</th>
                                                                    <th class="text-end">Bedrag</th>
                                                                    <th class="text-end">Openstaand bedrag</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var row in orderGroup)
                                                                {
                                                                    <tr>
                                                                        <td>@row.DetailDescription</td>
                                                                        <td class="text-end">@row.TotalAmount.ToString("C")</td>
                                                                        <td class="text-end">@row.RemainingAmount.ToString("C")</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div id="invoice-utilities-section" class="invoice-section d-none">
                <div class="card card-modern mb-4">
                    <div class="card-header border-0 pb-0">
                        <h2 class="card-title mb-0">Nutsaansluitingen</h2>
                    </div>
                    <div class="card-body pt-2">
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Klant</th>
                                        <th class="text-end text-nowrap">Bedrag</th>
                                        <th class="text-end text-nowrap">Factuur opmaken</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ClientUtilityCosts)
                                    {
                                        <tr class="table-active">
                                            <td class="text-capitalize">@item.Clientname</td>
                                            <td class="text-end">
                                                @string.Format("{0:C}", item.UtilityCost.Sum(s => s.Price / 100m * s.Percentage))
                                            </td>
                                            <td class="text-end"></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal Facturatie-overzicht -->
<div class="modal fade" id="modalprintinvoicelist" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-body" id="invoice-list-container"></div>
        </div>
    </div>
</div>

@section PageScripts
{
    <script>
        // Anti-forgery token voor fetch/jQuery
        function getRequestVerificationToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        }

        (function () {
            const sectionButtons = document.querySelectorAll('[data-invoice-section]');
            const sections = {
                schijven: document.getElementById('invoice-stages-section'),
                meerwerken: document.getElementById('invoice-change-orders-section'),
                nutsaansluitingen: document.getElementById('invoice-utilities-section')
            };

            sectionButtons.forEach((button) => {
                button.addEventListener('click', (event) => {
                    const target = button.getAttribute('data-invoice-section');

                    sectionButtons.forEach((btn) => btn.classList.remove('active'));
                    button.classList.add('active');

                    Object.values(sections).forEach((section) => section?.classList.add('d-none'));
                    sections[target]?.classList.remove('d-none');
                });
            });
        })();

        const stageCheckboxes = document.querySelectorAll('.chkInvoice');
         const changeOrderCheckboxes = document.querySelectorAll('.chkInvoiceCO');

        (function () {
            const clientCheckboxes = document.querySelectorAll('.chkClient');
            const unitCheckboxes = document.querySelectorAll('.chkUnit');


            function updateUnitCheckbox(unitId, clientId) {
                const unitCheckbox = document.querySelector(`.chkUnit[data-unitid="${unitId}"][data-clientaccountid="${clientId}"]`);
                const relatedStages = document.querySelectorAll(`.chkInvoice[data-unitid="${unitId}"][data-clientaccountid="${clientId}"]`);

                if (!unitCheckbox || relatedStages.length === 0) return;

                const allChecked = Array.from(relatedStages).every(cb => cb.checked);
                const anyChecked = Array.from(relatedStages).some(cb => cb.checked);

                unitCheckbox.checked = allChecked;
                unitCheckbox.indeterminate = !allChecked && anyChecked;
            }

            function updateClientCheckbox(clientId) {
                const clientCheckbox = document.querySelector(`.chkClient[data-clientaccountid="${clientId}"]`);
                const relatedStages = document.querySelectorAll(`.chkInvoice[data-clientaccountid="${clientId}"]`);

                if (!clientCheckbox || relatedStages.length === 0) return;

                const allChecked = Array.from(relatedStages).every(cb => cb.checked);
                const anyChecked = Array.from(relatedStages).some(cb => cb.checked);

                clientCheckbox.checked = allChecked;
                clientCheckbox.indeterminate = !allChecked && anyChecked;
            }

            function syncClient(clientId) {
                document.querySelectorAll(`.chkUnit[data-clientaccountid="${clientId}"]`).forEach(unitCb => {
                    const unitId = unitCb.getAttribute('data-unitid');
                    updateUnitCheckbox(unitId, clientId);
                });
                updateClientCheckbox(clientId);
            }

            clientCheckboxes.forEach(cb => {
                cb.addEventListener('change', () => {
                    const clientId = cb.getAttribute('data-clientaccountid');
                    const checked = cb.checked;
                    cb.indeterminate = false;

                    document.querySelectorAll(`.chkUnit[data-clientaccountid="${clientId}"]`).forEach(unitCb => {
                        unitCb.checked = checked;
                        unitCb.indeterminate = false;
                    });

                    document.querySelectorAll(`.chkInvoice[data-clientaccountid="${clientId}"]`).forEach(stageCb => {
                        stageCb.checked = checked;
                    });

                    syncClient(clientId);
                });
            });

            unitCheckboxes.forEach(cb => {
                cb.addEventListener('change', () => {
                    const unitId = cb.getAttribute('data-unitid');
                    const clientId = cb.getAttribute('data-clientaccountid');
                    const checked = cb.checked;
                    cb.indeterminate = false;

                    document.querySelectorAll(`.chkInvoice[data-unitid="${unitId}"][data-clientaccountid="${clientId}"]`).forEach(stageCb => {
                        stageCb.checked = checked;
                    });

                    updateUnitCheckbox(unitId, clientId);
                    updateClientCheckbox(clientId);
                });
            });

            stageCheckboxes.forEach(cb => {
                cb.addEventListener('change', () => {
                    const unitId = cb.getAttribute('data-unitid');
                    const clientId = cb.getAttribute('data-clientaccountid');
                    updateUnitCheckbox(unitId, clientId);
                    updateClientCheckbox(clientId);
                });
            });

            document.querySelectorAll('.chkClient').forEach(cb => {
                const clientId = cb.getAttribute('data-clientaccountid');
                syncClient(clientId);
            });
        })();

          (function () {
            const clientCheckboxes = document.querySelectorAll('.chkClientCO');
            const orderCheckboxes = document.querySelectorAll('.chkOrderCO');

            function updateClientCheckbox(clientId) {
                const clientCb = document.querySelector(`.chkClientCO[data-clientaccountid="${clientId}"]`);
                const orders = document.querySelectorAll(`.chkOrderCO[data-clientaccountid="${clientId}"]`);
                if (!clientCb || orders.length === 0) return;

                const allChecked = Array.from(orders).every(cb => cb.checked);
                const anyChecked = Array.from(orders).some(cb => cb.checked);
                clientCb.checked = allChecked;
                clientCb.indeterminate = !allChecked && anyChecked;
            }

            clientCheckboxes.forEach(cb => {
                cb.addEventListener('change', () => {
                    const clientId = cb.getAttribute('data-clientaccountid');
                    const checked = cb.checked;
                    cb.indeterminate = false;

                    document.querySelectorAll(`.chkOrderCO[data-clientaccountid="${clientId}"]`).forEach(orderCb => {
                        orderCb.checked = checked;
                        orderCb.indeterminate = false;
                    });

                    updateClientCheckbox(clientId);
                });
            });

            orderCheckboxes.forEach(cb => {
                cb.addEventListener('change', () => {
                    const clientId = cb.getAttribute('data-clientaccountid');
                    cb.indeterminate = false;
                    updateClientCheckbox(clientId);
                });
            });

            document.querySelectorAll('.co-order-percentage').forEach(input => {
                input.addEventListener('input', () => {
                    const max = parseFloat(input.getAttribute('data-max') || '0');
                    let value = parseFloat(input.value || '0');
                    if (Number.isNaN(value)) value = 0;
                    if (value < 0) value = 0;
                    if (value > max) value = max;
                    input.value = value.toFixed(2);
                });
            });

            document.querySelectorAll('.chkClientCO').forEach(cb => {
                const clientId = cb.getAttribute('data-clientaccountid');
                updateClientCheckbox(clientId);
            });

            document.querySelectorAll('.co-toggle').forEach(btn => {
                btn.addEventListener('click', () => {
                    const targetId = btn.getAttribute('data-target');
                    const row = targetId ? document.getElementById(targetId) : null;
                    if (!row) return;
                    const icon = btn.querySelector('i');
                    const isHidden = row.classList.contains('d-none');
                    row.classList.toggle('d-none', !isHidden);
                    btn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
                    if (icon) {
                        icon.classList.toggle('fa-plus', !isHidden);
                        icon.classList.toggle('fa-minus', isHidden);
                    }
                });
            });
        })();


        const issuerCompanyId = @(Model.IssuerCompanyIdBuilder ?? 0);

        const invoiceButton = document.getElementById('btnInvoicing');

              const updateInvoiceButtonState = () => {
                 if (!invoiceButton) return;
                    const hasSelected = document.querySelector('.chkInvoice:checked, .chkOrderCO:checked') !== null;
                 invoiceButton.disabled = !hasSelected;
                 };

             updateInvoiceButtonState();

             stageCheckboxes.forEach(cb => cb.addEventListener('change', updateInvoiceButtonState));
             changeOrderCheckboxes.forEach(cb => cb.addEventListener('change', updateInvoiceButtonState));

             document.querySelectorAll('.chkClient, .chkUnit, .chkClientCO, .chkOrderCO').forEach(cb => cb.addEventListener('change', updateInvoiceButtonState));

             invoiceButton?.addEventListener('click', function (e) {
            e.preventDefault();

            const list = [];
            document.querySelectorAll('.chkInvoice:checked').forEach(chk => {
                list.push({
                    clientAccountId: parseInt(chk.getAttribute('data-clientaccountid')),
                    unitId: parseInt(chk.getAttribute('data-unitid')),
                    stageId: parseInt(chk.getAttribute('data-id')),
                    companyId: issuerCompanyId
                });
            });

            const listCO = [];
           document.querySelectorAll('.chkOrderCO:checked').forEach(chk => {
                const clientId = parseInt(chk.getAttribute('data-clientaccountid'));
                const coId = parseInt(chk.getAttribute('data-coid'));
                const detailIds = (chk.getAttribute('data-detailids') || '')
                    .split(',')
                    .map(x => parseInt(x))
                    .filter(x => !Number.isNaN(x) && x > 0);
                const pctInput = document.querySelector(`.co-order-percentage[data-coid="${coId}"][data-clientaccountid="${clientId}"]`);
                const max = parseFloat(chk.getAttribute('data-max') || '0');
                let percentage = parseFloat(pctInput?.value || '0');
                if (Number.isNaN(percentage)) percentage = 0;
                if (percentage < 0) percentage = 0;
                if (percentage > max) percentage = max;
                detailIds.forEach(detailId => {
                    listCO.push({
                        clientAccountId: clientId,
                        changeOrderId: coId,
                        changeOrderDetailId: detailId,
                        companyId: issuerCompanyId,
                        percentage: percentage
                    });
                });
            });

            const token = getRequestVerificationToken();
            const headers = { 'Content-Type': 'application/json; charset=utf-8' };
            if (token) headers['RequestVerificationToken'] = token;

            Promise.all([
                fetch('@Url.Action("MakeInvoices", "Projecten")', {
                    method: 'POST', headers, body: JSON.stringify({ invoices: list })
                }).then(r => r.json()),
                fetch('@Url.Action("MakeInvoicesCO", "Projecten")', {
                    method: 'POST', headers, body: JSON.stringify({ invoices: listCO })
                }).then(r => r.json())
            ]).then(([r1, r2]) => {
                const pid = (r1?.projectid ?? 0) || (r2?.projectid ?? 0);
                if (pid && pid !== 0) {
                    window.location.href = '@Url.Action("Invoicing", "Projecten")' + '?projectid=' + pid;
                }
            });
        });

        document.getElementById('btnPrintInvoiceList')?.addEventListener('click', function () {
            const id = this.getAttribute('data-id');
            fetch('/Projecten/ModalPrintInvoiceList?projectid=' + id)
                .then(r => r.text())
                .then(html => document.getElementById('invoice-list-container').innerHTML = html);
        });
    </script>
}