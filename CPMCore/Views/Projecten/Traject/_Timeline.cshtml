@using BOCore
@using DALCore.Models
@model CPMCore.Models.Traject.TrajectIndexVm
@{
    var today = DateOnly.FromDateTime(DateTime.Today);
    var mijlpalenPerFase = Model.ProjectMijlpalen
        .GroupBy(m => m.ProjecttrajectFaseId)
        .ToDictionary(g => g.Key ?? 0, g => g.OrderBy(x => x.Volgorde).ToList());

    // Zelfde mapping als Index.cshtml — zie de toelichting daar (.gl-mijlpaal-status-icon in
    // traject.css, geen gedeelde helper voor deze 5 cases). Phosphor (DESIGN.md "Icons").
    string StatusIcon(int status) => status switch
    {
        0 => "ph-circle",
        1 => "ph-clock",
        2 => "ph-check-circle",
        3 => "ph-minus-circle",
        4 => "ph-prohibit",
        _ => "ph-circle"
    };
}

<div class="gl-traject-timeline">
    @foreach (var fase in Model.Fases)
    {
        mijlpalenPerFase.TryGetValue(fase.Id, out var items);
        items ??= new List<Mijlpaal>();
        var bereikt = items.Count(m => m.Status == (int)MijlpaalStatus.Bereikt);
        <div class="gl-traject-fase fase-status-@fase.Status">
            <div class="gl-traject-fase-head">
                <span class="gl-traject-fase-naam">@fase.Naam</span>
                <span class="gl-traject-fase-meta">
                    <span class="badge bg-light text-dark">@(((FaseStatus)fase.Status).GetDisplayName())</span>
                    <span class="text-muted">@bereikt / @items.Count mijlpalen</span>
                    @if (fase.StartGepland != null || fase.EindGepland != null)
                    {
                        <span class="text-muted">· @(fase.StartGepland?.ToString("MM/yyyy") ?? "?") – @(fase.EindGepland?.ToString("MM/yyyy") ?? "?")</span>
                    }
                </span>
            </div>
            <ul class="gl-traject-mijlpalen">
                @foreach (var m in items)
                {
                    var eff = m.Doeldatum ?? m.DoeldatumBerekend;
                    var overdue = eff is DateOnly d && d < today
                                  && m.Status != (int)MijlpaalStatus.Bereikt && m.Status != (int)MijlpaalStatus.NietVanToepassing;
                    <li class="gl-traject-mijlpaal m-status-@m.Status @(overdue ? "is-overdue" : "")">
                        @{ var mStatusLabel = ((MijlpaalStatus)m.Status).GetDisplayName(); }
                        <span class="gl-mijlpaal-status-icon s-@m.Status" title="@mStatusLabel"><i class="ph @StatusIcon(m.Status)" aria-hidden="true"></i></span>
                        <span class="visually-hidden">@mStatusLabel</span>
                        <span class="gl-tm-naam">@m.Naam</span>
                        <span class="gl-tm-datum @(overdue ? "gl-traject-overdue-text" : "text-muted")">
                            @(m.WerkelijkeDatum?.ToString("dd/MM/yyyy") ?? eff?.ToString("dd/MM/yyyy") ?? "—")
                        </span>
                        <button type="button" class="gl-row-action-btn js-mijlpaal-status" data-id="@m.Id" data-naam="@m.Naam" data-status="@m.Status" title="Status wijzigen" aria-label="Status wijzigen van @m.Naam">
                            <i class="ph ph-repeat" aria-hidden="true"></i>
                        </button>
                    </li>
                }
                @if (items.Count == 0)
                {
                    <li class="text-muted ps-3"><em>Geen mijlpalen in deze fase.</em></li>
                }
            </ul>
        </div>
    }
</div>
