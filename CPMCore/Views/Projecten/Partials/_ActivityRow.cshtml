@using BOCore
@using HtmlHelpers.BeginCollectionItemCore
@using System.Globalization
@model ContractActivityBO

<div class="row align-items-center pb-3">
    @using (Html.BeginCollectionItem("activities")) {

        @Html.HiddenFor(m => m.ContractActivityId)
        @Html.HiddenFor(m => m.ContractId)
        @Html.HiddenFor(m => m.Activity.ID)
        @Html.HiddenFor(m => m.Activity.Name)
        <label class="col-12 col-md-4 control-label text-md-end mb-0">@Model.Activity.Name</label>
        <div class="col-12 col-md-8">
          @Html.EditorFor(
                m => m.Price,
                "CurrencyWithActions",
                null,
                new {
                    ShowDelete = ViewData["mode"]?.ToString() != "view",
                    DeleteId = Model.Activity.ID
                }
            )
            
        </div>

       
}
</div>


          
