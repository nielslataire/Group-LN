@using BOCore
@model CPMCore.Models.Projecten.DakSectieVM
@{
    string Fmt(decimal v) => v.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
}

@* ── Rij toevoegen ── *@
<div class="bw-dt__toolbar">
    <div class="bw-dt__field">
        <label>Locatie</label>
        <input type="text" class="bw-cell-input add-eenheid"
               data-type="@Model.ElementType" placeholder="bv. W2" style="width:100px;" />
    </div>
    <div class="bw-dt__field">
        <label>Beschrijving</label>
        <input type="text" class="bw-cell-input add-beschrijving"
               data-type="@Model.ElementType" placeholder="optioneel" style="width:120px;" />
    </div>
    <button type="button" class="btn btn-sm btn-primary btn-add-element" data-type="@Model.ElementType">
        <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Toevoegen
    </button>
</div>

@* ── Tabel ── *@
<div class="bw-dt__scroll">
    <table class="bw-table dak-table table-hide-hoogte">
        <thead class="small">
            <tr>
                <th class="bw-th-cell" style="width:16%;">Locatie</th>
                <th class="bw-th-cell" style="width:24%;">Beschrijving</th>
                <th class="bw-num bw-th-cell" style="width:92px;">Aantal</th>
                <th class="bw-num bw-th-cell" style="width:120px;">Breedte (m)</th>
                <th class="bw-num bw-th-cell">Hoogte (m)</th>@* hidden *@
                <th class="bw-num bw-th-cell" style="width:120px;">Lengte (m)</th>
                <th class="bw-num" style="width:104px;">m²</th>
                <th style="width:76px;"></th>
            </tr>
        </thead>
        <tbody id="tbody-@Model.ElementType">
            @foreach (var rij in Model.Rijen)
            {
                @await Html.PartialAsync("Partials/_BudgetGevelRij", rij)
            }
        </tbody>
        <tfoot class="small">
            <tr>
                <td colspan="4" class="text-muted fw-semibold">Subtotaal</td>
                <td></td>@* Hoogte (hidden) *@
                <td></td>@* Lengte *@
                <td class="bw-num fw-bold" id="tfoot-@Model.ElementType">
                    @Fmt(Model.Subtotaal) m²
                </td>
                <td></td>
            </tr>
        </tfoot>
    </table>
</div>
