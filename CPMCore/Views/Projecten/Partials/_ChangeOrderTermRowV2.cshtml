@model CPMCore.Models.Projecten.ChangeOrderTermV2
@*
    Wijzigingsopdracht V2 (20d) — één rij van het facturatieplan. Saldo (Kind=3) is niet-verwijderbaar
    en de trigger staat vast op "bij de laatste schijf, verplicht" (§5) — geen dropdown voor die rij.
*@
@using BOCore
@using CPMCore.Models.Projecten
@{
    var index = ViewData["Index"] as int? ?? 0;
    var stages = ViewData["Stages"] as List<IdNameBO> ?? new();
    var isLocked = ViewData["IsLocked"] as bool? ?? false;
    var prefix = $"terms[{index}]";
}
<tr class="gl-v2-co-term-row js-co-term-row" data-index="@index" data-kind="@Model.Kind">
    <td>
        <input type="hidden" name="@(prefix).id" value="@Model.Id" />
        <input type="hidden" name="@(prefix).kind" class="js-co-term-kind" value="@Model.Kind" />
        <span class="gl-v2-co-term-kind-label">@Model.KindLabel</span>
    </td>
    <td class="is-right">
        <div class="gl-v2-field-box gl-v2-co-numbox"><input type="number" step="0.01" class="gl-v2-field-input js-co-term-pct" name="@(prefix).percentage" value="@(Model.Percentage?.ToString(System.Globalization.CultureInfo.InvariantCulture))" @(isLocked || Model.Kind == 3 ? "readonly" : "") /></div>
    </td>
    <td class="is-right gl-v2-co-tabular js-co-term-amount">—</td>
    <td>
        @if (Model.Kind == 3)
        {
            <span class="gl-v2-co-readout gl-v2-co-locked-field"><i class="ph ph-lock-simple" aria-hidden="true"></i>Bij laatste schijf — verplicht</span>
            <input type="hidden" name="@(prefix).triggerType" value="2" />
        }
        else
        {
            <div class="gl-v2-field-box"><select class="gl-v2-field-input js-co-term-trigger" name="@(prefix).triggerType" @(isLocked ? "disabled" : "")>
                <option value="1" selected="@(Model.TriggerType == 1)">Na ondertekening</option>
                <option value="2" selected="@(Model.TriggerType == 2)">Bij een schijf</option>
                <option value="3" selected="@(Model.TriggerType == 3)">Manueel vrijgeven</option>
            </select></div>
            <div class="gl-v2-field-box js-co-term-stagebox @(Model.TriggerType == 2 ? "" : "is-hidden")"><select class="gl-v2-field-input js-co-term-stage" name="@(prefix).triggerStageId">
                @foreach (var s in stages)
                {
                    <option value="@s.ID" selected="@(s.ID == Model.TriggerStageId)">@s.Display</option>
                }
            </select></div>
        }
    </td>
    <td class="is-right">
        @if (!isLocked && Model.IsDeletable)
        {
            <button type="button" class="gl-v2-co-row-delete js-co-delete-term" title="Termijn verwijderen"><i class="ph ph-trash" aria-hidden="true"></i></button>
        }
    </td>
</tr>
