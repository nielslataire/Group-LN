@model CPMCore.Models.Projecten.ProjectCoordinatieModel
@{
    var canInvoice = Model.CoordinationIssuerCompanyId.HasValue && Model.ContractPrice.HasValue && Model.ContractPrice > 0;
    var showPercentage = Model.ContractPrice.HasValue && Model.ContractPrice > 0;
}

@* ── Groene selectiekaart (verborgen; zichtbaar via JS wanneer checkboxes geselecteerd zijn) ── *@
@if (canInvoice)
{
    <div id="sliceSelectionCard" class="d-none rounded px-3 py-2 mb-3 flex-wrap align-items-center gap-2"
         style="background-color:#d1f0dc; border:1px solid #a3d9b5;">
        <span class="fw-semibold text-success">Geselecteerde schijven</span>
        <span class="badge bg-success rounded-pill" id="selectionCount">0</span>
        <span class="text-success fw-semibold">—</span>
        <span class="text-success fw-semibold" id="selectionTotal">€ 0</span>
        <div class="ms-auto d-flex gap-2">
            <button type="button" id="btnWisSelectie" class="btn btn-sm btn-outline-secondary">Wis selectie</button>
            <button type="submit" form="coordInvoiceForm"
                    class="btn btn-sm btn-success"
                    id="btnCoordInvoiceCard">
                <i class="fa fa-euro-sign me-1"></i>Factureer geselecteerde
            </button>
        </div>
    </div>
}

@* ── Tabel ── *@
<div class="card card-modern">
    <div class="card-body pt-2">
        @if (!Model.ContractSlices.Any())
        {
            <p class="text-muted p-3 mb-0">Geen schijven geconfigureerd. Stel ze in via de instellingen.</p>
        }
        else
        {
            <div class="pt-3">
                <table id="dt-schijven" class="table table-hover align-middle mb-0 w-100">
                    <thead>
                        <tr>
                            @if (canInvoice)
                            {
                                <th style="width:40px;">
                                    <div class="checkbox-custom checkbox-default d-inline-block">
                                        <input type="checkbox" id="chkSelectAll" title="Selecteer alles" />
                                        <label for="chkSelectAll"></label>
                                    </div>
                                </th>
                            }
                            <th>Omschrijving</th>
                            <th class="text-end text-nowrap">%</th>
                            <th class="text-end text-nowrap">Bedrag</th>
                            <th class="text-end text-nowrap">Actie</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.ContractSlices.Count; i++)
                        {
                            var slice = Model.ContractSlices[i];
                            <tr>
                                @if (canInvoice)
                                {
                                    <td>
                                        <div class="checkbox-custom checkbox-default d-inline-block">
                                            <input type="checkbox"
                                                   class="chkCoordSlice"
                                                   id="coord-slice-@slice.Id"
                                                   name="sliceIds"
                                                   value="@slice.Id"
                                                   data-amount="@slice.Amount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                                   form="coordInvoiceForm" />
                                            <label for="coord-slice-@slice.Id"></label>
                                        </div>
                                    </td>
                                }
                                <td class="align-middle">@slice.Description</td>
                                <td class="align-middle text-end text-nowrap">
                                    @if (showPercentage)
                                    {
                                        @((slice.Amount / Model.ContractPrice!.Value * 100).ToString("N2"))@:&nbsp;%
                                    }
                                    else
                                    {
                                        <text>-</text>
                                    }
                                </td>
                                <td class="align-middle text-end text-nowrap">€ @slice.Amount.ToString("N2")</td>
                                <td class="actions align-middle text-end text-nowrap">
                                    @if (canInvoice)
                                    {
                                        <a class="ms-1 me-1 btn-factureer-slice"
                                           href="#"
                                           title="Factureer"
                                           data-slice-id="@slice.Id">
                                            <i class="bx bx-receipt fs-5"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
