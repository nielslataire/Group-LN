@model CPMCore.Models.Projecten.ProjectCoordinatieModel
@{
    var totalPct = Model.ContractSlices.Sum(s => s.Percentage);
    var canInvoice = Model.CoordinationIssuerCompanyId.HasValue && Model.ContractPrice.HasValue && Model.ContractPrice > 0;
}
<div class="card card-modern">
    <div class="card-header">
        <h5 class="card-title mb-0">Contractschijven</h5>
    </div>
    <div class="card-body p-0">
        @if (!Model.ContractSlices.Any())
        {
            <p class="text-muted p-3 mb-0">Geen schijven geconfigureerd. Stel ze in via de instellingen.</p>
        }
        else
        {
            <table id="dt-schijven" class="table table-bordered table-striped mb-0 w-100">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Omschrijving</th>
                        <th class="text-end">Percentage</th>
                        @if (canInvoice)
                        {
                            <th class="text-end text-nowrap">Selectie</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.ContractSlices.Count; i++)
                    {
                        var slice = Model.ContractSlices[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@slice.Description</td>
                            <td class="text-end">@slice.Percentage.ToString("0.##") %</td>
                            @if (canInvoice)
                            {
                                <td class="text-end">
                                    <div class="checkbox-custom checkbox-default d-inline-block">
                                        <input type="checkbox" class="chkCoordSlice"
                                               id="coord-slice-@slice.Id"
                                               name="sliceIds"
                                               value="@slice.Id"
                                               form="coordInvoiceForm" />
                                        <label for="coord-slice-@slice.Id"></label>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="@(canInvoice ? 3 : 2)" class="text-end">Totaal</td>
                        <td class="text-end @(totalPct != 100 ? "text-danger" : "")">@totalPct.ToString("0.##") %</td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>
</div>
