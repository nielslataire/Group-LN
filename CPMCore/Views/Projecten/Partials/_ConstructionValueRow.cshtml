@using BOCore
@using HtmlHelpers.BeginCollectionItemCore
@model UnitConstructionValueBO

<tr>
    @using (Html.BeginCollectionItem("ConstructionValues"))
    {
        @Html.HiddenFor(m => m.Id)
        @Html.HiddenFor(m => m.UnitId)
        @* ValueSold is niet editbaar? dan hidden ok *@
        @Html.HiddenFor(m => m.ValueSold)

        <td style="width:30%">
            @Html.EditorFor(m => m.Value, new { htmlAttributes = new { @class = "form-control form-control-modern", placeholder = "Bouwwaarde" } })
        </td>

        <td style="width:30%">
            @Html.TextBoxFor(m => m.Description, new { @class = "form-control form-control-modern", placeholder = "Omschrijving" })
        </td>

        <td style="width:35%">
            @Html.DropDownListFor(
            m => m.PaymentGroupId,
                (IEnumerable<SelectListItem>)ViewBag.PaymentGroups,   // let op de naam
                "Selecteer betalingsgroep ...",
                new { @class = "form-control form-control-modern" }   // GEEN custom id nodig in een collectie
                )
    </td>

    <td style="width:5%">
        <a href="#" class="deleteConstructionRow ms-2" data-toggle="tooltip" title="Verwijderen">
            <i class="fa fa-trash"></i>
        </a>
    </td>
        }
</tr>
