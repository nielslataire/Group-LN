@using BOCore
@using HtmlHelpers.BeginCollectionItemCore
@model UnitConstructionValueBO
@{
    var paymentGroups = ViewBag.PaymentGroups as IEnumerable<SelectListItem>;
    if (paymentGroups == null && ViewBag.PaymentGroups is IEnumerable<IdNameBO> paymentGroupBos)
    {
        paymentGroups = paymentGroupBos.Select(pg => new SelectListItem { Value = pg.ID.ToString(), Text = pg.Display });
    }
    if (paymentGroups == null && ViewBag.paymentgroups is IEnumerable<IdNameBO> legacyPaymentGroups)
    {
        paymentGroups = legacyPaymentGroups.Select(pg => new SelectListItem { Value = pg.ID.ToString(), Text = pg.Display });
    }
    paymentGroups ??= Enumerable.Empty<SelectListItem>();
}
<tr>
    @using (Html.BeginCollectionItem("ConstructionValues"))
    {
        @Html.HiddenFor(m => m.Id)
        @Html.HiddenFor(m => m.UnitId)
        @* ValueSold is niet editbaar? dan hidden ok *@
        @Html.HiddenFor(m => m.ValueSold)

        <td style="width:30%">
            @Html.EditorFor(m => m.Value, new { htmlAttributes = new { @class = "form-control form-control-modern", placeholder = "Bouwwaarde" } })
        </td>

        <td style="width:30%">
            @Html.TextBoxFor(m => m.Description, new { @class = "form-control form-control-modern", placeholder = "Omschrijving" })
        </td>

        <td style="width:35%">
            @Html.DropDownListFor(
            m => m.PaymentGroupId,
                paymentGroups,
                "Selecteer betalingsgroep ...",
                new { @class = "form-control form-control-modern" }   // GEEN custom id nodig in een collectie
                )
    </td>

    <td style="width:5%">
        <a href="#" class="deleteConstructionRow ms-2" data-toggle="tooltip" title="Verwijderen">
            <i class="fa fa-trash"></i>
        </a>
    </td>
        }
</tr>
