@model CPMCore.Models.Projecten.ProjectGridRenderModel
@using CPMCore.Models.Projecten
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@*
    Rendert een reeks project-werfkaarten. Gebruikt zowel voor de eerste
    lading (Projecten/Index) als voor de "Laad meer"-AJAX (LoadMoreProjects).
    Eén kaart-uiterlijk via Shared/_ProjectWerfCard.
*@
@{
    var imgBase = Configuration["URL:ImageWebUrl"] ?? string.Empty;
}
@if (Model?.Projects != null)
{
    foreach (var project in Model.Projects)
    {
        BOCore.ProjectVoortgangBO vg = null;
        Model.Voortgang?.TryGetValue(project.Id, out vg);

        @await Html.PartialAsync("_ProjectWerfCard", new ProjectWerfCardVM
        {
            Project = project,
            Voortgang = vg,
            ImageBaseUrl = imgBase,
            ColumnClasses = string.Empty
        })
    }
}
