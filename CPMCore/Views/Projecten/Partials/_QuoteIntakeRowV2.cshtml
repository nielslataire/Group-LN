@model CPMCore.Models.Projecten.ChangeOrderDetailRowV2
@*
    Offerte inlezen V2 (20c) — een vereenvoudigde regel-rij (geen commissie/btw-klant, dat komt pas bij
    Omzetten op 20d aan bod). Zelfde name="rows[i]." prefix als _ChangeOrderDetailRowV2.cshtml, zodat
    beide rechtstreeks naar ChangeOrderDetailV2Save posten — velden die hier niet getoond worden
    (meetmethode/commissie/btw) gaan gewoon als verborgen input mee met een neutrale standaardwaarde.
*@
@using BOCore
@{
    var index = ViewData["Index"] as int? ?? 0;
    var prefix = $"rows[{index}]";
}
<tr class="gl-v2-co-row js-qi-row @(Model.NeedsReview ? "is-needs-review" : "")" data-index="@index">
    <td class="is-center">
        <input type="hidden" name="@(prefix).id" value="@Model.Id" />
        <input type="hidden" name="@(prefix).measurementType" value="1" />
        <input type="hidden" name="@(prefix).commission" value="0" />
        <input type="hidden" name="@(prefix).vatPercentage" value="21" />
        <input type="hidden" name="@(prefix).sourceImagePath" class="js-qi-sourceimage" value="@Model.SourceImagePath" />
        @if (!string.IsNullOrWhiteSpace(Model.SourceImagePath))
        {
            <span class="gl-v2-qi-row-thumb is-photo" title="Foto uit de offerte hangt aan deze regel"><i class="ph ph-image" aria-hidden="true"></i></span>
        }
        else
        {
            <span class="gl-v2-qi-row-thumb"><i class="ph ph-text-align-left" aria-hidden="true"></i></span>
        }
    </td>
    <td>
        <div class="gl-v2-field-box gl-v2-field-box-textarea gl-v2-co-descbox"><textarea class="gl-v2-field-input js-qi-description" name="@(prefix).description" rows="2" maxlength="1000">@Model.Description</textarea></div>
        <input type="hidden" name="@(prefix).needsReview" class="js-qi-needsreview" value="@Model.NeedsReview.ToString().ToLowerInvariant()" />
        @if (Model.NeedsReview)
        {
            <button type="button" class="gl-v2-co-review-flag js-qi-confirm-row" title="Klikken om te bevestigen"><i class="ph ph-warning" aria-hidden="true"></i>controleer</button>
        }
    </td>
    <td class="is-center">
        <div class="gl-v2-field-box"><select class="gl-v2-field-input js-qi-munit" name="@(prefix).measurementUnit">
            @foreach (BOCore.MeasurementUnit mu in Enum.GetValues(typeof(BOCore.MeasurementUnit)))
            {
                <option value="@((int)mu)" selected="@((int)mu == Model.MeasurementUnit)">@mu.GetDisplayName()</option>
            }
        </select></div>
    </td>
    <td class="is-right"><div class="gl-v2-field-box gl-v2-co-numbox"><input type="number" step="1" class="gl-v2-field-input js-qi-number" name="@(prefix).number" value="@Model.Number" /></div></td>
    <td class="is-right"><div class="gl-v2-field-box gl-v2-co-numbox"><input type="number" step="0.01" class="gl-v2-field-input js-qi-price" name="@(prefix).price" value="@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></div></td>
    <td class="is-right"><button type="button" class="gl-v2-co-row-delete js-qi-delete-row" title="Regel verwijderen"><i class="ph ph-trash" aria-hidden="true"></i></button></td>
</tr>
