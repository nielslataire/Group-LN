@model DALCore.Models.BudgetVerkoopLijn
@{
    var ic = System.Globalization.CultureInfo.InvariantCulture;
    string FmtDec(decimal? v) => v.HasValue ? v.Value.ToString("F2", ic) : string.Empty;
}
<tr class="verkoop-row">
    <td>
        <input type="text" class="bw-cell-input eenheid-naam"
               value="@Model.EenheidNaam" placeholder="naam eenheid" />
    </td>
    <td>
        <input type="number" class="bw-cell-input bw-cell-input--num code-bouw"
               value="@Model.CodeBouw" placeholder="code" />
    </td>
    <td>
        <input type="number" class="bw-cell-input bw-cell-input--num code-grond"
               value="@Model.CodeGrond" placeholder="code" />
    </td>
    <td>
        <input type="number" class="bw-cell-input bw-cell-input--num opp-tuin"
               value="@FmtDec(Model.OppTuin)" step="0.01" placeholder="0.00" />
    </td>
    <td>
        <input type="number" class="bw-cell-input bw-cell-input--num opp-terras"
               value="@FmtDec(Model.OppTerras)" step="0.01" placeholder="0.00" />
    </td>
    <td>
        <input type="number" class="bw-cell-input bw-cell-input--num opp-dakterras"
               value="@FmtDec(Model.OppDakterras)" step="0.01" placeholder="0.00" />
    </td>
    <td class="text-center">
        <div class="form-check d-flex justify-content-center">
            <input type="checkbox" class="form-check-input is-ruil" @(Model.IsRuil ? "checked" : "") />
        </div>
    </td>
    <td>
        <input type="number" class="bw-cell-input bw-cell-input--num extra-forfait"
               value="@FmtDec(Model.ExtraForfait)" step="0.01" placeholder="0.00" />
    </td>
    <td class="text-end" style="width:56px;">
        <div class="bw-row-actions">
            <button type="button" class="bw-row-btn bw-row-btn--danger delete-verkoop-row"
                    title="Rij verwijderen" aria-label="Rij verwijderen">
                <i class="fa-solid fa-trash-alt" aria-hidden="true"></i>
            </button>
        </div>
    </td>
</tr>
