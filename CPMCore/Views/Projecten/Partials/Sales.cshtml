@using BOCore
@using System.IO
@using System.Text.RegularExpressions
@model CPMCore.Models.Projecten.ProjectSalesModel
@using System.Globalization
@{
	var be = CultureInfo.GetCultureInfo("nl-BE");
}


@section PageStyle
{
<link rel="stylesheet" href="~/lib/magnific-popup/magnific-popup.css" />
<link rel="stylesheet" href="~/lib/datatables/media/css/dataTables.bootstrap5.css" />

}

@Html.HiddenFor(m => m.ProjectId, new {id = "txtProjectId"})
@if (Model.ProjectUnits.Any())
{


	<div class="card card-modern">
		<div class="card-body">
			<div class="datatables-header-footer-wrapper mt-2">

                <table class="table table-responsive-md table-hover mb-0 gl-table-min-w" id="datatable-units-list"
                       data-toggle="table" data-show-columns="true" data-toolbar-align="right">

                    <thead>
                        <tr>
                            <th class="noVis text-center align-middle gl-th-44" data-sortable="false">
                                <div class="checkbox-custom checkbox-default">
                                    <input type="checkbox" id="check-all-enabled">
                                    <label for="check-all-enabled"> </label>
                                </div>
                            </th>
                            <th class="noVis gl-th-40" data-sortable="false"></th>
                            <th>Naam</th>
                            <th>Type</th>
                            <th>Verdieping</th>
                            <th>Totaalprijs</th>
                            <th>Grondwaarde</th>
                            <th>Bouwwaarde</th>
                            <th data-sortable="false">Tienduizendsten</th>
                            <th>Prekad</th>
                            <th>Oppervlakte</th>
                            <th>Woonoppervlakte</th>
                            <th class="text-end">Status</th>
                            @if (ViewBag.CanWriteProjectSales == true)
                            {
                                <th class="noVis text-end" data-sortable="false">Acties</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var unit in Model.ProjectUnits)
                        {
                            var land = unit.Unit.LandValue ?? 0m;
                            var bouw = (unit.Unit.ConstructionValues?.Sum(m => m.Value) ?? 0m);
                            var totaal = land + bouw;

                            bool isVerkocht = unit.Unit.ClientAccountId != null;
                            bool isInOptie = !isVerkocht && unit.Unit.IsOption;
                            bool isTeKoop = !isVerkocht && !isInOptie;

                            <tr>
                                <td class="text-center align-middle">
                                    @{
                                        var chkId = $"check-unit-{unit.Unit.Id}";
                                    }
                                    <div class="checkbox-custom checkbox-default">
                                        <input type="checkbox"
                                               class="unit-check"
                                               id="@chkId"
                                               data-id="@unit.Unit.Id"
                                               value="@unit.Unit.Id"
                                               @(isTeKoop ? null : @Html.Raw("disabled"))>
                                        <label for="@chkId"></label>
                                    </div>
                                </td>

                                <td class="text-center align-middle">
                                    @if (unit.Unit.IsLink)
                                    {
                                        <a data-toggle="collapse" data-target=".row@(unit.Unit.Id)" title="Uitklappen">
                                            <i class="fa fa-plus"></i>
                                        </a>
                                    }
                                </td>

                                <td>@unit.Unit.Name</td>

                                <td>@unit.Unit.Type?.Name</td>

                                <td>
                                    @if ((unit.Unit.Level ?? 0) == 0)
                                    {
                                        <text>Gelijkvloers</text>
                                    }
                                    else
                                    {
                                        <text>Verdieping </text>
                                        @unit.Unit.Level
                                    }
                                </td>

                                <td>
                                    <span data-order="@(totaal)">
                                        @totaal.ToString("C", be)
                                    </span>
                                </td>

                                <td>
                                    <span data-order="@(land)">
                                        @land.ToString("C", be)
                                    </span>
                                </td>

                                <td>
                                    <span data-order="@(bouw)">
                                        @bouw.ToString("C", be)
                                    </span>
                                </td>

                                <td>@unit.Unit.Landshare</td>
                                <td>@unit.Unit.PreKad</td>
                                <td>@unit.Unit.GroundSurface</td>
                                <td>@unit.Unit.Surface</td>

                                <td class="text-end">
                                    @if (isVerkocht)
                                    {
                                        <span class="badge badge-danger">Verkocht</span>
                                    }
                                    else if (isInOptie)
                                    {
                                        <span class="badge badge-warning">In optie</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success">Beschikbaar</span>
                                    }
                                </td>
                                @if (ViewBag.CanWriteProjectSales == true)
                                {
                                    <td class="text-end">
                                        @if (!isVerkocht)
                                        {
                                            <div class="gl-unit-actions" style="position:relative; display:inline-block;">
                                                <i class="bx bx-dots-vertical-rounded gl-unit-actions-trigger" style="font-size:1.4rem; cursor:pointer;" data-unit-id="@unit.Unit.Id"></i>
                                                <div class="gl-unit-actions-menu" data-unit-id="@unit.Unit.Id" style="display:none; position:fixed; z-index:9999; background:#fff; border:1px solid #ddd; border-radius:4px; box-shadow:0 2px 8px rgba(0,0,0,.15); min-width:180px; padding:4px 0;">
                                                    <a class="gl-unit-action-item unit-set-option"
                                                       href="#"
                                                       data-unit-id="@unit.Unit.Id"
                                                       data-is-option="@(isInOptie ? "false" : "true")"
                                                       style="display:block; padding:8px 16px; color:#333; text-decoration:none; white-space:nowrap;">
                                                        @(isInOptie ? "Beschikbaar plaatsen" : "In optie plaatsen")
                                                    </a>
                                                    <a class="gl-unit-action-item"
                                                       href="@Url.Action("AddClientAccount", "Klanten", new { id = Model.ProjectId, unitId = unit.Unit.Id })"
                                                       style="display:block; padding:8px 16px; color:#333; text-decoration:none; white-space:nowrap;">
                                                        Verkocht
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>

                </table>

			</div>
		</div>

	</div>
}
else
{
	<div class="card card-modern mb-4">
		<div class="card-body align-items-center text-center card-big-info">
			<div class="col-12 mb-3 gl-empty-state-icon">
				<i class="bx bx-file"></i>

			</div>
			<div class="col-12 text-muted mb-3">
				<h4>Er zijn geen eenheden te koop in dit project</h4>
			</div>
		</div>
	</div>
}