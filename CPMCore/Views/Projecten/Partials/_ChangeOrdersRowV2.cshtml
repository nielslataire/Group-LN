@model CPMCore.Models.Projecten.ChangeOrderRowV2
@*
    Offertes & wijzigingen V2 (20b/29a) — één rij van de Offertes- of Wijzigingsopdrachten-tabel. De hele
    rij (op de actiekolom na) opent het scherm van haar stap: een offerte gaat naar 20c (QuoteIntakeV2),
    wijzigingsopdracht openen hetzelfde scherm (ChangeOrderDetailV2, 28). Actiekolom: een offerte krijgt
    "Omzetten" in het "···"-menu (21c-modal), een omgezette offerte linkt naar haar WO, elke rij krijgt een "···"-menu (Openen · Kopie maken · PDF).
*@
@using System.Globalization
@{
    var projectId = (int)ViewData["ProjectId"]!;
    var canWrite = (bool)(ViewData["CanWrite2"] ?? false);
    var be = CultureInfo.GetCultureInfo("nl-BE");
    string Eur(decimal v) => (v < 0 ? "− € " : "€ ") + Math.Abs(v).ToString("N2", be);
    // Offerte aan de klant en wijzigingsopdracht zijn hetzelfde scherm (ChangeOrderDetailV2).
    var detailUrl = Url.Action("ChangeOrderDetailV2", "Projecten", new { projectid = projectId, coid = Model.Id });
    var searchText = string.Join(" ", new[] { Model.Number, Model.ClientName, Model.UnitName, Model.Description, Model.SupplierName }.Where(s => !string.IsNullOrWhiteSpace(s))).ToLowerInvariant();
    var subParts = new[] { Model.SupplierName, Model.SourceReference, Model.SubText }.Where(s => !string.IsNullOrWhiteSpace(s)).ToList();
    var menuId = $"gl-v2-co2-rowmenu-{Model.Id}";
}
<tr class="gl-v2-co2-row" data-co2-type="@(Model.IsQuote ? "offerte" : "wo")" data-co2-status="@Model.Status" data-co2-open="@(Model.IsOpen ? "true" : "false")" data-co2-search="@searchText" data-href="@detailUrl">
    <td class="gl-v2-co2-tabular gl-v2-co2-nr"><a href="@detailUrl">@Model.Number</a></td>
    <td class="gl-v2-co2-desc">
        <span class="gl-v2-co2-desc-title">@Model.Description</span>
        @if (subParts.Count > 0)
        {
            <span class="gl-v2-co2-desc-sub @(Model.SubTextIsWarning ? "is-warning" : "")">@string.Join(" · ", subParts)</span>
        }
    </td>
    <td>
        <span class="gl-v2-co2-desc-title">@(string.IsNullOrWhiteSpace(Model.UnitName) ? "—" : Model.UnitName)</span>
        <span class="gl-v2-co2-desc-sub">@Model.ClientName</span>
    </td>
    <td class="is-right gl-v2-co2-tabular @(Model.Amount < 0 ? "is-negative" : "")">@Eur(Model.Amount)</td>
    <td><span class="gl-v2-badge @Model.PillTone">@Model.PillLabel.ToUpperInvariant()</span></td>
    <td>
        @await Html.PartialAsync("GlV2/_Steps", Model.Steps)
        @if (!string.IsNullOrWhiteSpace(Model.Hint))
        {
            <span class="gl-v2-co2-hint">@Model.Hint</span>
        }
    </td>
    <td class="is-right gl-v2-co2-actions">
        @if (Model.IsQuote)
        {
            @if (Model.ConvertedToId.HasValue)
            {
                <a href="@Url.Action("ChangeOrderDetailV2", "Projecten", new { projectid = projectId, coid = Model.ConvertedToId })" class="gl-v2-co2-action">WO-@(Model.ConvertedToId.Value.ToString("000")) →</a>
            }
        }
        @* "···"-menu voor offerte én wijzigingsopdracht (Openen · Kopie maken · PDF) *@
            <button type="button" class="gl-v2-icon-btn js-gl-v2-menu-trigger" aria-haspopup="true" aria-expanded="false" aria-controls="@menuId" aria-label="Meer acties voor @Model.Number">
                <i class="ph ph-dots-three" aria-hidden="true"></i>
            </button>
            <div class="gl-v2-menu gl-v2-co2-row-menu" id="@menuId">
                <a href="@detailUrl" class="gl-v2-menu-item"><i class="ph ph-arrow-square-out" aria-hidden="true"></i>Openen</a>
                @if (canWrite && Model.IsQuote && Model.ConvertedToId == null)
                {
                    <button type="button" class="gl-v2-menu-item js-co2-convert" data-co-id="@Model.Id"><i class="ph ph-arrow-right" aria-hidden="true"></i>Omzetten naar wijzigingsopdracht</button>
                }
                @if (canWrite)
                {
                    <button type="button" class="gl-v2-menu-item js-co2-copy" data-co-id="@Model.Id"><i class="ph ph-copy" aria-hidden="true"></i>Kopie maken</button>
                }
                <a href="@Url.Action("ChangeOrderPDF", "Projecten", new { changeorderid = Model.Id })" target="_blank" rel="noopener" class="gl-v2-menu-item"><i class="ph ph-file-pdf" aria-hidden="true"></i>PDF</a>
            </div>
        <i class="ph ph-caret-right gl-v2-co2-chevron" aria-hidden="true"></i>
    </td>
</tr>
