@model CPMCore.Models.Projecten.ChangeOrderRowV2
@*
    Offertes & wijzigingen V2 (20b) — één rij van de Offertes- of Wijzigingsopdrachten-tabel. De hele
    rij (op de actiekolom na) linkt naar ChangeOrderDetailV2 (20d) — zowel offertes als WO's, want het
    is dezelfde pagina/rij, enkel de fase verschilt (Model.IsQuote).
*@
@using System.Globalization
@{
    var projectId = (int)ViewData["ProjectId"]!;
    var canWrite = (bool)(ViewData["CanWrite2"] ?? false);
    var be = CultureInfo.GetCultureInfo("nl-BE");
    string Eur(decimal v) => (v < 0 ? "− € " : "€ ") + Math.Abs(v).ToString("N2", be);
    var detailUrl = Url.Action("ChangeOrderDetailV2", "Projecten", new { projectid = projectId, coid = Model.Id });
    var statusTone = Model.Status switch
    {
        ServiceCore.Helpers.ChangeOrderStatus.Betaald or ServiceCore.Helpers.ChangeOrderStatus.Gefactureerd => "is-info",
        ServiceCore.Helpers.ChangeOrderStatus.Ondertekend or ServiceCore.Helpers.ChangeOrderStatus.Factureerbaar => "is-positive",
        ServiceCore.Helpers.ChangeOrderStatus.Verzonden => "is-attention",
        ServiceCore.Helpers.ChangeOrderStatus.Geweigerd or ServiceCore.Helpers.ChangeOrderStatus.Geannuleerd or ServiceCore.Helpers.ChangeOrderStatus.Verlopen => "is-blocked",
        _ => "is-neutral",
    };
    var searchText = string.Join(" ", new[] { Model.Number, Model.ClientName, Model.UnitName, Model.Description, Model.SupplierName }.Where(s => !string.IsNullOrWhiteSpace(s))).ToLowerInvariant();
}
<tr class="gl-v2-co2-row" data-co2-type="@(Model.IsQuote ? "offerte" : "wo")" data-co2-status="@Model.Status" data-co2-search="@searchText" onclick="location.href='@detailUrl'">
    <td class="gl-v2-co2-tabular">@Model.Number</td>
    <td>
        <span class="gl-v2-co2-desc-title">@Model.ClientName</span>
        @if (!string.IsNullOrWhiteSpace(Model.UnitName))
        {
            <span class="gl-v2-co2-desc-sub">@Model.UnitName</span>
        }
    </td>
    <td class="gl-v2-co2-desc">
        <span class="gl-v2-co2-desc-title">@Model.Description</span>
        @if (!string.IsNullOrWhiteSpace(Model.SubText))
        {
            <span class="gl-v2-co2-desc-sub @(Model.SubTextIsWarning ? "is-warning" : "")">@Model.SubText</span>
        }
    </td>
    <td>@Model.SupplierName</td>
    <td class="is-right gl-v2-co2-tabular @(Model.Amount < 0 ? "is-negative" : "")">@Eur(Model.Amount)</td>
    <td><span class="gl-v2-badge @statusTone">@Model.StatusLabel.ToUpperInvariant()</span></td>
    <td>
        @await Html.PartialAsync("GlV2/_Steps", Model.Steps)
    </td>
    <td class="is-right" onclick="event.stopPropagation()">
        @if (canWrite && Model.IsQuote)
        {
            <a href="@detailUrl" class="gl-v2-co2-action">Omzetten →</a>
        }
        else if (canWrite && Model.CanRemind && Model.SigningCaseId.HasValue)
        {
            <a href="@Url.Action("Dossier", "SigningAdmin", new { id = Model.SigningCaseId })" class="gl-v2-co2-action">Herinneren →</a>
        }
    </td>
</tr>
