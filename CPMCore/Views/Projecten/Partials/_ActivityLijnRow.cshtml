@model BOCore.Budget.BudgetActivityLijnBO
@{
    var ic = System.Globalization.CultureInfo.InvariantCulture;
    string FmtDec(decimal v, int d = 2) => v.ToString("F" + d, ic);

    string verschilClass = Model.Verschil > 0 ? "bg-warning text-dark"
                         : Model.Verschil < 0 ? "bg-primary"
                                              : "bg-success";
}
<tr class="activity-row" data-activity-id="@Model.ActivityId">
    <td>
        @Model.ActivityOmschrijving
        <input type="hidden" class="hdn-activity-id" value="@Model.ActivityId" />
    </td>
    <td>
        <div class="d-flex align-items-center gap-1">
            <input type="number" step="0.01" min="0"
                   class="form-control form-control-sm alt-prijs"
                   value="@FmtDec(Model.AlternatievePrijsPerEenheid)" />
            @if (Model.HeeftVoorstel)
            {
                var nlBE    = new System.Globalization.CultureInfo("nl-BE");
                string N2(decimal v) => v.ToString("N2", nlBE);
                string N0(decimal v) => v.ToString("N0", nlBE);

                var rPrijs  = Model.VoorstelRuwbouwPrijs  ?? 0m;
                var rOpp    = Model.VoorstelRuwbouwOpp    ?? 0m;
                var tPrijs  = Model.VoorstelTerrasPrijs   ?? 0m;
                var tOpp    = Model.VoorstelTerrasOpp     ?? 0m;
                var gPrijs  = Model.VoorstelGevelPrijs    ?? 0m;
                var gOpp    = Model.VoorstelGevelOpp      ?? 0m;
                var nEenh   = Model.VoorstelAantalEenheden ?? 0;
                var rTot    = rPrijs * rOpp;
                var tTot    = tPrijs * tOpp;
                var gTot    = gPrijs * gOpp;
                var totaal  = rTot + tTot + gTot;

                var popContent = $@"<table style='font-size:.8rem;border-collapse:collapse;min-width:320px;'>
<tr><td>Ruwbouwprijs</td><td style='padding:0 6px;text-align:right'>€ {N2(rPrijs)}/m²</td><td style='text-align:right'>× {N2(rOpp)} m²</td><td style='padding-left:8px;text-align:right;font-weight:600'>= € {N0(rTot)}</td></tr>
<tr><td>Terrasprijs</td><td style='padding:0 6px;text-align:right'>€ {N2(tPrijs)}/m²</td><td style='text-align:right'>× {N2(tOpp)} m²</td><td style='padding-left:8px;text-align:right;font-weight:600'>= € {N0(tTot)}</td></tr>
<tr><td>Gevelprijs</td><td style='padding:0 6px;text-align:right'>€ {N2(gPrijs)}/m²</td><td style='text-align:right'>× {N2(gOpp)} m²</td><td style='padding-left:8px;text-align:right;font-weight:600'>= € {N0(gTot)}</td></tr>
<tr style='border-top:1px solid #dee2e6'><td colspan='3'><strong>Totaal project</strong></td><td style='padding-left:8px;text-align:right;font-weight:700'>€ {N0(totaal)}</td></tr>
<tr><td colspan='3'>÷ {nEenh} wooneenheden</td><td style='padding-left:8px;text-align:right;color:#0d6efd;font-weight:700'>= € {N2(Model.VoorgesteldePrijsPerEenheid ?? 0m)}/eenh.</td></tr>
</table>";

                <span class="badge bg-info text-dark flex-shrink-0 voorstel-calc-badge"
                      data-bs-toggle="popover"
                      data-bs-trigger="hover focus"
                      data-bs-placement="bottom"
                      data-bs-html="true"
                      data-bs-title="Ruwbouw berekening"
                      data-bs-content="@popContent"
                      style="cursor:pointer;">
                    <i class="bx bx-calculator"></i>
                </span>
            }
        </div>
    </td>
    <td class="text-end alt-totaal">€ @FmtDec(Model.TotaalAlternatief)</td>
    <td>
        <input type="number" step="0.01" min="0"
               class="form-control form-control-sm nacalc-prijs"
               value="@FmtDec(Model.NacalcPrijsPerEenheid)" />
    </td>
    <td>
        <input type="number" step="0.0001" min="0"
               class="form-control form-control-sm corr-factor"
               value="@FmtDec(Model.Correctiefactor, 4)" />
    </td>
    <td class="text-end nacalc-geind">€ @FmtDec(Model.NacalcGeindexeerd)</td>
    <td class="text-end verschil-cel">
        <span class="badge @verschilClass">
            € @FmtDec(Model.Verschil)
        </span>
    </td>
    <td>
        <div class="calc-detail small font-monospace text-muted ps-2" style="border-left:3px solid #0d6efd">
            Nacalc: @Model.NacalcPrijsPerEenheid.ToString("N2") €/eenh.
            × @Model.Correctiefactor.ToString("F4") (corr.)
            × @Model.GewogenIndexFactor.ToString("F4") (gew.factor)
            = @Model.NacalcGeindexeerd.ToString("N2") €/eenh.
            × @Model.AantalEenheden eenheden
            = € @Model.TotaalNacalc.ToString("N2")
        </div>
    </td>
</tr>
