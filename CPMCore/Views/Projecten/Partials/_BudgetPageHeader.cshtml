@model CPMCore.Models.Projecten.BudgetPageHeaderModel
@*
    Meta-rij voor de wizardstap: stap-teller + budget + versie + status
    (+ autosave-status). Wordt rechts in de gl-form-section__head van de
    stap geplaatst — de stap-titel zelf komt uit die section-head, niet
    meer uit deze partial (geen dubbele titel).
*@
<div class="bw-head-meta">
    <span class="bw-chip bw-chip--step">Stap @Model.StepNum / @Model.TotalSteps</span>
    <span class="bw-chip bw-chip--budget">
        <i class="fa-solid fa-folder" aria-hidden="true"></i>@Model.MasterNaam
    </span>
    <span class="bw-chip bw-chip--versie">Versie @Model.VersieLabel</span>
    @if (!string.IsNullOrEmpty(Model.VersieStatus))
    {
        if (Model.VersieStatus == "Concept")
        {
            <span class="bw-chip bw-chip--concept">Concept</span>
        }
        else if (Model.VersieStatus == "Goedgekeurd")
        {
            <span class="bw-chip bw-chip--goedgekeurd">Goedgekeurd</span>
        }
        else
        {
            <span class="bw-chip bw-chip--other">@Model.VersieStatus</span>
        }
    }
    @if (Model.ShowSaveButton)
    {
        <span class="bw-autosave" id="autosave-label" data-bw-save="saved" role="status" aria-live="polite">
            Alle wijzigingen opgeslagen
        </span>
    }
</div>
