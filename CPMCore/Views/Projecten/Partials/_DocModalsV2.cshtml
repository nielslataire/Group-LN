                    </div>
                    <div class="gl-v2-field gl-v2-field-full">
                        <label class="gl-v2-field-label" for="gl-v2-dd-ed-author">OPGESTELD DOOR</label>
                        <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" name="authoredBy" id="gl-v2-dd-ed-author" maxlength="150" /></div>
                    </div>
                    <div>
                        @await Html.PartialAsync("GlV2/_DateField", DateVm("gl-v2-dd-ed-date", "docDate", "DOCUMENTDATUM", null))
                    </div>
                    <div>
                        @await Html.PartialAsync("GlV2/_DateField", DateVm("gl-v2-dd-ed-expires", "expiresOn", "VERVALT OP", null))
                    </div>
                    <div class="gl-v2-field gl-v2-field-full">
                        <label class="gl-v2-field-label" for="gl-v2-dd-ed-perceel">PERCEEL</label>
                        <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" name="perceel" id="gl-v2-dd-ed-perceel" maxlength="100" /></div>
                    </div>
                    <p class="gl-v2-dd-formerror gl-v2-field-full" id="gl-v2-dd-ed-error" role="alert" hidden></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-dd-ed-submit">Opslaan</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Koppelen ──────────────────────────────────────────────────────────────────────────────────── *@
<div class="modal fade gl-v2-modal-form" id="gl-v2-dd-link-modal" tabindex="-1" aria-hidden="true" aria-labelledby="gl-v2-dd-link-title">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="gl-v2-dd-link-title">Document koppelen</h2>
                <button type="button" class="gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button>
            </div>
            <form id="gl-v2-dd-link-form" autocomplete="off">
                <input type="hidden" id="gl-v2-dd-lk-doc" value="" />
                <div class="modal-body">
                    <div class="gl-v2-field gl-v2-field-full">
                        <label class="gl-v2-field-label" for="gl-v2-dd-lk-target">KOPPELEN AAN <span style="color:#8B2A2A">*</span></label>
                        <div class="gl-v2-field-box">
                            <select class="gl-v2-field-input" id="gl-v2-dd-lk-target">
                                <option value="">Kies een eenheid, klant of leverancier …</option>
                                @if (ov.Units.Count > 0)
                                {
                                    <optgroup label="Eenheden">
                                        @foreach (var u in ov.Units) { <option value="unit:@u.Id" data-buyer="@u.Ref" data-buyer-name="@u.Sub">@u.Name</option> }
                                    </optgroup>
                                }
                                @if (ov.Clients.Count > 0)
                                {
                                    <optgroup label="Klanten">
                                        @foreach (var c in ov.Clients) { <option value="client:@c.Id">@c.Name</option> }
                                    </optgroup>
                                }
                                @if (ov.Companies.Count > 0)
                                {
                                    <optgroup label="Leveranciers">
                                        @foreach (var c in ov.Companies) { <option value="company:@c.Id">@c.Name</option> }
                                    </optgroup>
                                }
                            </select>
                        </div>
                        <span class="gl-v2-field-help">Het document blijft één bestand: het verschijnt ook bij deze koppeling, er komt geen kopie.</span>
                    </div>
                    <div class="gl-v2-field gl-v2-field-full">
                        <label class="gl-v2-toggle-row">
                            <input type="checkbox" class="gl-v2-toggle-switch" id="gl-v2-dd-lk-share" />
                            <span class="gl-v2-toggle-text"><span class="gl-v2-toggle-label">Ook delen in het portaal</span><span class="gl-v2-toggle-hint">zichtbaar voor deze koppeling (koper of leverancier)</span></span>
                        </label>
                    </div>
                    <div class="gl-v2-dd-suggest gl-v2-field-full" id="gl-v2-dd-lk-suggest" hidden>
                        <i class="ph ph-lightbulb" aria-hidden="true"></i>
                        <span id="gl-v2-dd-lk-suggest-text"></span>
                    </div>
                    <p class="gl-v2-dd-formerror gl-v2-field-full" id="gl-v2-dd-lk-error" role="alert" hidden></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-dd-lk-submit"><i class="ph ph-link" aria-hidden="true"></i>Koppelen</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Ter ondertekening sturen (17d) ─────────────────────────────────────────────────────────────── *@
<div class="modal fade gl-v2-modal-form" id="gl-v2-dd-sign-modal" tabindex="-1" aria-hidden="true" aria-labelledby="gl-v2-dd-sign-title">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="gl-v2-dd-sign-title">Ter ondertekening sturen</h2>
                <button type="button" class="gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button>
            </div>
            <form id="gl-v2-dd-sign-form" autocomplete="off">
                <input type="hidden" id="gl-v2-dd-sg-doc" value="" />
                <div class="modal-body">
                    <div class="gl-v2-field gl-v2-field-full">
                        <span class="gl-v2-field-label">ONDERTEKENAARS</span>
                        <div class="gl-v2-dd-sign-rows" id="gl-v2-dd-sg-rows"></div>
                        <div><button type="button" class="gl-v2-btn gl-v2-btn-secondary" id="gl-v2-dd-sg-add"><i class="ph ph-plus" aria-hidden="true"></i>Ondertekenaar toevoegen</button></div>
                    </div>
                    <div class="gl-v2-dd-notice is-info gl-v2-field-full">
                        <i class="ph ph-info" aria-hidden="true"></i>
                        <span>De handtekeningen worden voorlopig handmatig geregistreerd zodra een partij getekend heeft. Een itsme-koppeling is er nog niet. Na de eerste handtekening kan het document niet meer gewijzigd worden.</span>
                    </div>
                    <p class="gl-v2-dd-formerror gl-v2-field-full" id="gl-v2-dd-sg-error" role="alert" hidden></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-dd-sg-submit"><i class="ph ph-signature" aria-hidden="true"></i>Ter ondertekening sturen</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Generieke bevestiging (verwijderen, gunnen, afwijzen met reden) ────────────────────────────── *@
<div class="modal fade gl-v2-modal-confirm" id="gl-v2-dd-confirm-modal" tabindex="-1" aria-hidden="true" aria-labelledby="gl-v2-dd-confirm-title">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content is-danger" id="gl-v2-dd-confirm-content">
            <div class="modal-body">
                <span class="gl-v2-modal-icon is-danger" id="gl-v2-dd-confirm-icon"><i class="ph ph-trash" aria-hidden="true"></i></span>
                <div class="gl-v2-modal-text">
                    <h2 class="gl-v2-modal-title" id="gl-v2-dd-confirm-title">Verwijderen?</h2>
                    <p class="gl-v2-modal-desc" id="gl-v2-dd-confirm-desc"></p>
                    <div class="gl-v2-field" id="gl-v2-dd-confirm-note-field" hidden style="margin-top:10px">
                        <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" id="gl-v2-dd-confirm-note" maxlength="300" placeholder="Reden (optioneel)" /></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
                <button type="button" class="gl-v2-btn gl-v2-btn-danger" id="gl-v2-dd-confirm-ok">Verwijderen</button>
            </div>
        </div>
    </div>
</div>
