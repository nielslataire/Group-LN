                    </div>
                    <div>
                        @await Html.PartialAsync("GlV2/_DateField", DateVm("gl-v2-dd-ed-date", "docDate", "DOCUMENTDATUM", null))
                    </div>
                    <div>
                        @await Html.PartialAsync("GlV2/_DateField", DateVm("gl-v2-dd-ed-expires", "expiresOn", "VERVALT OP", null))
                    </div>
                    <div class="gl-v2-field gl-v2-field-full">
                        <label class="gl-v2-field-label" for="gl-v2-dd-ed-perceel">PERCEEL</label>
                        <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" name="perceel" id="gl-v2-dd-ed-perceel" maxlength="100" /></div>
                    </div>
                    <p class="gl-v2-dd-formerror gl-v2-field-full" id="gl-v2-dd-ed-error" role="alert" hidden></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-dd-ed-submit">Opslaan</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Koppelen ──────────────────────────────────────────────────────────────────────────────────── *@
<div class="modal fade gl-v2-modal-form" id="gl-v2-dd-link-modal" tabindex="-1" aria-hidden="true" aria-labelledby="gl-v2-dd-link-title">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="gl-v2-dd-link-title">Document koppelen</h2>
                <button type="button" class="gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button>
            </div>
            <form id="gl-v2-dd-link-form" autocomplete="off">
                <input type="hidden" id="gl-v2-dd-lk-doc" value="" />
                <div class="modal-body">
                    <div class="gl-v2-field gl-v2-field-full">
                        <label class="gl-v2-field-label" for="gl-v2-dd-lk-target">KOPPELEN AAN <span style="color:#8B2A2A">*</span></label>
                        @await Html.PartialAsync("GlV2/_SelectList", Sel("gl-v2-dd-lk-target", "linkTarget", null, "", linkItems, "Kies een eenheid, klant of leverancier …", "Kies een eenheid, klant of leverancier …", bare: true))
                        <span class="gl-v2-field-help">Het document blijft één bestand: het verschijnt ook bij deze koppeling, er komt geen kopie.</span>
                    </div>
                    <div class="gl-v2-field gl-v2-field-full">
                        <label class="gl-v2-toggle-row">
                            <input type="checkbox" class="gl-v2-toggle-switch" id="gl-v2-dd-lk-share" />
                            <span class="gl-v2-toggle-text"><span class="gl-v2-toggle-label">Ook delen in het portaal</span><span class="gl-v2-toggle-hint">zichtbaar voor deze koppeling (koper of leverancier)</span></span>
                        </label>
                    </div>
                    <div class="gl-v2-dd-suggest gl-v2-field-full" id="gl-v2-dd-lk-suggest" hidden>
                        <i class="ph ph-lightbulb" aria-hidden="true"></i>
                        <span id="gl-v2-dd-lk-suggest-text"></span>
                    </div>
                    <p class="gl-v2-dd-formerror gl-v2-field-full" id="gl-v2-dd-lk-error" role="alert" hidden></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-dd-lk-submit"><i class="ph ph-link" aria-hidden="true"></i>Koppelen</button>
                </div>
            </form>
        </div>
    </div>
</div>

