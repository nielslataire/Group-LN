@model CPMCore.Models.Projecten.DocsV2PageVm
@*
    Dialogen van Projecten/DetailDocsV2 (design-handoff 17b/17c). Staan in de BODY van de pagina, niet in
    @@section PageScripts: elk --gl-v2-*-token hangt aan .gl-v2 en PageScripts rendert daarbuiten.
    Alle formulieren worden door gl-v2-projecten-detaildocs.js via fetch verstuurd (multipart voor de upload).
*@
@using System.Globalization
@using CPMCore.Models.GlV2
@{
    var ov = Model.Overview;
    var today = DateTime.Today;
    GlV2DateFieldVm DateVm(string id, string name, string label, DateTime? value) => new()
    {
        Id = id,
        Name = name,
        Label = label,
        IsoValue = value?.ToString("yyyy-MM-dd") ?? "",
        DisplayValue = value?.ToString("dd/MM/yyyy") ?? ""
    };
    var activeFolderId = ov.ActiveFolderNav?.Id ?? 0;

    // Aangepaste keuzelijsten (GlV2/_SelectList, DESIGN.md "Select / Dropdown") — vervangen de gewone <select>s van deze dialogen.
    // De verborgen input behoudt het oorspronkelijke id en de naam, dus lezen en insturen blijft ongewijzigd.
    GlV2SelectListVm Sel(string id, string name, string? label, string? value, IEnumerable<GlV2SelectItem> items, string placeholder = "Kies …", string? emptyText = null, bool required = false, bool bare = false) => new()
    {
        Id = id, Name = name, Label = label, Value = value, Items = items.ToList(), Placeholder = placeholder, EmptyText = emptyText, Required = required, Bare = bare
    };
    var folderItems = ov.Folders.Select(f => new GlV2SelectItem { Value = f.Id.ToString(), Text = f.Name }).ToList();
    var unitItems = ov.Units.Select(u => new GlV2SelectItem { Value = u.Id.ToString(), Text = u.Name }).ToList();
    var companyItems = ov.Companies.Select(c => new GlV2SelectItem { Value = c.Id.ToString(), Text = c.Name }).ToList();
    var clientItems = ov.Clients.Select(c => new GlV2SelectItem { Value = c.Id.ToString(), Text = c.Name }).ToList();
    var linkItems = ov.Units.Select(u => new GlV2SelectItem { Value = "unit:" + u.Id, Text = u.Name, Group = "Eenheden" })
        .Concat(ov.Clients.Select(c => new GlV2SelectItem { Value = "client:" + c.Id, Text = c.Name, Group = "Klanten" }))
        .Concat(ov.Companies.Select(c => new GlV2SelectItem { Value = "company:" + c.Id, Text = c.Name, Group = "Leveranciers" })).ToList();
}

@* ── Uploaden (17b): eerst nieuw of revisie ─────────────────────────────────────────────────────── *@
<div class="modal fade gl-v2-modal-form gl-v2-dd-upload-modal" id="gl-v2-dd-upload-modal" tabindex="-1" aria-hidden="true" aria-labelledby="gl-v2-dd-upload-title">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="gl-v2-dd-upload-title">Document uploaden</h2>
                <button type="button" class="gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button>
            </div>
            <form id="gl-v2-dd-upload-form" enctype="multipart/form-data" autocomplete="off">
                <input type="hidden" name="projectid" value="@ov.ProjectId" />
                <input type="hidden" name="requestId" id="gl-v2-dd-up-request" value="" />
                <input type="hidden" name="documentId" id="gl-v2-dd-up-document" value="" />
                <input type="hidden" name="mode" id="gl-v2-dd-up-mode" value="new" />
                <div class="modal-body">
                    <div class="gl-v2-field-full">
                        @await Html.PartialAsync("GlV2/_Dropzone", new GlV2DropzoneVm { Name = "file", Id = "gl-v2-dd-up-file", Layout = "box", Mode = "inline", Icon = "ph-upload-simple", Title = "Sleep een bestand hierheen of klik om te kiezen", LinkText = null, Sub = "PDF, DWG, Word, Excel, afbeeldingen …", ChangeText = "klik om een ander bestand te kiezen", AriaLabel = "Bestand kiezen" })
                    </div>

                    <div class="gl-v2-field gl-v2-field-full" id="gl-v2-dd-up-what-field">
                        <span class="gl-v2-field-label">WAT IS DIT?</span>
                        @await Html.PartialAsync("GlV2/_Segmented", new GlV2SegmentedVm { Id = "gl-v2-dd-up-what", Fill = false, AriaLabel = "Nieuw document of nieuwe revisie", Items = new List<GlV2SegmentedItem> {
                            new() { Text = "Nieuw document", Active = true, Data = new() { ["mode"] = "new" } },
                            new() { Text = "Nieuwe revisie van …", Data = new() { ["mode"] = "revision" } } } })
                    </div>

                    <div class="gl-v2-field gl-v2-field-full" id="gl-v2-dd-up-replaces-field" hidden>
                        @await Html.PartialAsync("GlV2/_SelectList", Sel("gl-v2-dd-up-replaces", "replaces", "VERVANGT", "", new List<GlV2SelectItem>(), "Kies een document …", "Kies een document …", required: true))
                        <span class="gl-v2-field-help">Nummer, koppelingen en delen worden overgenomen — je hoeft enkel te bevestigen.</span>
                    </div>

                    <div id="gl-v2-dd-up-meta" class="gl-v2-field-full" style="display:contents">
                        <div class="gl-v2-field gl-v2-field-full" data-dd-new-only>
                            <label class="gl-v2-field-label" for="gl-v2-dd-up-name">NAAM <span style="color:#8B2A2A">*</span></label>
                            <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" name="name" id="gl-v2-dd-up-name" maxlength="200" /></div>
                        </div>
                        <div data-dd-new-only>
                            @await Html.PartialAsync("GlV2/_SelectList", Sel("gl-v2-dd-up-folder", "folderId", "MAP", activeFolderId > 0 ? activeFolderId.ToString() : null, folderItems, "Kies een map …", required: true))
                        </div>
                        <div>
                            @await Html.PartialAsync("GlV2/_DateField", DateVm("gl-v2-dd-up-date", "docDate", "DOCUMENTDATUM", today))
                        </div>
                        <div>
                            @await Html.PartialAsync("GlV2/_DateField", DateVm("gl-v2-dd-up-expires", "expiresOn", "VERVALT OP", null))
                        </div>
                        <div class="gl-v2-field" data-dd-new-only>
                            <label class="gl-v2-field-label" for="gl-v2-dd-up-number">DOCUMENTNR.</label>
                            <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" name="number" id="gl-v2-dd-up-number" maxlength="50" /></div>
                        </div>
                        <div class="gl-v2-field gl-v2-field-full" data-dd-new-only>
                            <label class="gl-v2-field-label" for="gl-v2-dd-up-author">OPGESTELD DOOR</label>
                            <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" name="authoredBy" id="gl-v2-dd-up-author" maxlength="150" placeholder="bv. Studiebureau Arcade" /></div>
                        </div>
                        <div id="gl-v2-dd-up-offer" style="display:none">
                            <div class="gl-v2-field">
                                <label class="gl-v2-field-label" for="gl-v2-dd-up-perceel">PERCEEL</label>
                                <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" name="perceel" id="gl-v2-dd-up-perceel" maxlength="100" list="gl-v2-dd-up-perceel-list" placeholder="bv. Sanitair" /></div>
                                <datalist id="gl-v2-dd-up-perceel-list">
                                    @foreach (var p in ov.Percelen) { <option value="@p"></option> }
                                </datalist>
                            </div>
                            <div class="gl-v2-field">
                                <label class="gl-v2-field-label" for="gl-v2-dd-up-amount">BEDRAG (EXCL. BTW)</label>
                                <div class="gl-v2-field-box"><span class="gl-v2-field-prefix">€</span><input type="text" class="gl-v2-field-input" name="amount" id="gl-v2-dd-up-amount" inputmode="decimal" placeholder="0,00" /></div>
                            </div>
                        </div>
                        <div class="gl-v2-field gl-v2-field-full">
                            <label class="gl-v2-field-label" for="gl-v2-dd-up-note">OMSCHRIJVING VAN DE WIJZIGING</label>
                            <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" name="note" id="gl-v2-dd-up-note" maxlength="500" placeholder="bv. Wapening aangepast na grondsondering" /></div>
                        </div>
                    </div>

                    <div class="gl-v2-field gl-v2-field-full" id="gl-v2-dd-up-links-field">
                        <span class="gl-v2-field-label">GEKOPPELD AAN</span>
                        <div class="gl-v2-dd-linkpicker" id="gl-v2-dd-up-links">
                            <span class="gl-v2-dd-linkchip is-project"><i class="ph ph-buildings" aria-hidden="true"></i>&nbsp;Project</span>
                            <div id="gl-v2-dd-up-linkchips" style="display:contents"></div>
                            <div style="min-width:210px">
                                @await Html.PartialAsync("GlV2/_SelectList", Sel("gl-v2-dd-up-linkadd", "linkadd", null, "", linkItems, "+ eenheid, klant of leverancier …", bare: true))
                            </div>
                        </div>
                        <div class="gl-v2-dd-suggest" id="gl-v2-dd-up-suggest" hidden>
                            <i class="ph ph-lightbulb" aria-hidden="true"></i>
                            <span id="gl-v2-dd-up-suggest-text"></span>
                            <button type="button" id="gl-v2-dd-up-suggest-yes">Ja, koppelen</button>
                        </div>
                    </div>

                    <div class="gl-v2-field gl-v2-field-full">
                        <span class="gl-v2-field-label">DELEN</span>
                        <div class="gl-v2-toggle-grid">
                            <label class="gl-v2-toggle-row">
                                <input type="checkbox" class="gl-v2-toggle-switch" name="shareClients" value="true" id="gl-v2-dd-up-share-clients" />
                                <span class="gl-v2-toggle-text"><span class="gl-v2-toggle-label">Klantportaal</span><span class="gl-v2-toggle-hint" id="gl-v2-dd-up-share-clients-hint">zichtbaar voor de koper van de gekoppelde eenheid, of alle kopers zonder koppeling</span></span>
                            </label>
                            <label class="gl-v2-toggle-row">
                                <input type="checkbox" class="gl-v2-toggle-switch" name="shareSuppliers" value="true" id="gl-v2-dd-up-share-suppliers" />
                                <span class="gl-v2-toggle-text"><span class="gl-v2-toggle-label">Leveranciersportaal</span><span class="gl-v2-toggle-hint" id="gl-v2-dd-up-share-suppliers-hint">zichtbaar voor de gekoppelde leverancier(s)</span></span>
                            </label>
                        </div>
                    </div>

                    <div class="gl-v2-field-full">
                        @await Html.PartialAsync("GlV2/_SelectList", Sel("gl-v2-dd-up-status", "status", "STATUS NA OPSLAAN", "2", new[]
                        {
                            new GlV2SelectItem { Value = "2", Text = "Goedgekeurd" },
                            new GlV2SelectItem { Value = "1", Text = "Ter goedkeuring" },
                            new GlV2SelectItem { Value = "0", Text = "Concept" }
                        }))
                    </div>
                    <p class="gl-v2-dd-formerror gl-v2-field-full" id="gl-v2-dd-up-error" role="alert" hidden></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-dd-up-submit"><i class="ph ph-upload-simple" aria-hidden="true"></i>Opslaan</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Document aanvragen / verwacht document (17c) ───────────────────────────────────────────────── *@
<div class="modal fade gl-v2-modal-form" id="gl-v2-dd-request-modal" tabindex="-1" aria-hidden="true" aria-labelledby="gl-v2-dd-request-title">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="gl-v2-dd-request-title">Document aanvragen</h2>
                <button type="button" class="gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button>
            </div>
            <form id="gl-v2-dd-request-form" autocomplete="off">
                <input type="hidden" name="projectid" value="@ov.ProjectId" />
                <input type="hidden" name="id" id="gl-v2-dd-rq-id" value="" />
                <div class="modal-body">
                    <div class="gl-v2-field gl-v2-field-full">
                        <label class="gl-v2-field-label" for="gl-v2-dd-rq-name">DOCUMENT <span style="color:#8B2A2A">*</span></label>
                        <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" name="name" id="gl-v2-dd-rq-name" maxlength="200" placeholder="bv. Keuringsverslag elektriciteit" /></div>
                    </div>
                    <div>
                        @await Html.PartialAsync("GlV2/_SelectList", Sel("gl-v2-dd-rq-folder", "folderId", "MAP", activeFolderId > 0 ? activeFolderId.ToString() : null, folderItems, "Kies een map …", required: true))
                    </div>
                    <div>
                        @await Html.PartialAsync("GlV2/_SelectList", Sel("gl-v2-dd-rq-unit", "unitId", "EENHEID", Model.FilterUnitId?.ToString() ?? "", unitItems, "Heel het project", "Heel het project"))
                    </div>
                    <div>
                        @await Html.PartialAsync("GlV2/_SelectList", Sel("gl-v2-dd-rq-kind", "kind", "GEVRAAGD AAN", "leverancier", new[]
                        {
                            new GlV2SelectItem { Value = "leverancier", Text = "Leverancier" },
                            new GlV2SelectItem { Value = "klant", Text = "Klant" },
                            new GlV2SelectItem { Value = "extern", Text = "Andere (extern)" },
                            new GlV2SelectItem { Value = "intern", Text = "Intern" }
                        }))
                    </div>
                    <div data-rq-who="leverancier">
                        @await Html.PartialAsync("GlV2/_SelectList", Sel("gl-v2-dd-rq-company", "companyId", "LEVERANCIER", Model.FilterCompanyId?.ToString() ?? "", companyItems, "Kies een leverancier …", "Kies een leverancier …"))
                    </div>
                    <div data-rq-who="klant" hidden>
                        @await Html.PartialAsync("GlV2/_SelectList", Sel("gl-v2-dd-rq-client", "clientAccountId", "KLANT", Model.FilterClientId?.ToString() ?? "", clientItems, "Kies een klant …", "Kies een klant …"))
                    </div>
                    <div class="gl-v2-field" data-rq-who="extern intern" hidden>
                        <label class="gl-v2-field-label" for="gl-v2-dd-rq-who">VERANTWOORDELIJKE</label>
                        <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" name="responsibleName" id="gl-v2-dd-rq-who" maxlength="150" placeholder="bv. EPB-verslaggever De Wit" /></div>
                    </div>
                    <div>
                        @await Html.PartialAsync("GlV2/_DateField", DateVm("gl-v2-dd-rq-due", "dueDate", "TEGEN", null))
                    </div>
                    <div class="gl-v2-field">
                        <label class="gl-v2-field-label" for="gl-v2-dd-rq-duelabel">OF: MOMENT</label>
                        <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" name="dueLabel" id="gl-v2-dd-rq-duelabel" maxlength="100" placeholder="bv. bij oplevering" /></div>
                    </div>
                    <div class="gl-v2-field">
                        <label class="gl-v2-field-label" for="gl-v2-dd-rq-remind">HERINNERING (DAGEN VOOR DEADLINE)</label>
                        <div class="gl-v2-field-box"><input type="number" min="0" max="365" class="gl-v2-field-input" name="reminderDays" id="gl-v2-dd-rq-remind" placeholder="30" /></div>
                    </div>
                    <div class="gl-v2-field">
                        <label class="gl-v2-field-label" for="gl-v2-dd-rq-expiry">GELDIG (JAREN)</label>
                        <div class="gl-v2-field-box"><input type="number" min="0" max="99" class="gl-v2-field-input" name="expiryYears" id="gl-v2-dd-rq-expiry" placeholder="bv. 25" /></div>
                    </div>
                    <div class="gl-v2-field gl-v2-field-full">
                        <label class="gl-v2-field-label" for="gl-v2-dd-rq-perceel">PERCEEL (OFFERTES)</label>
                        <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" name="perceel" id="gl-v2-dd-rq-perceel" maxlength="100" /></div>
                    </div>
                    <div class="gl-v2-field gl-v2-field-full">
                        <div class="gl-v2-toggle-grid">
                            <label class="gl-v2-toggle-row">
                                <input type="checkbox" class="gl-v2-toggle-switch" name="shareAfter" value="true" id="gl-v2-dd-rq-shareafter" checked />
                                <span class="gl-v2-toggle-text"><span class="gl-v2-toggle-label">Na goedkeuring delen met de koper</span><span class="gl-v2-toggle-hint">zichtbaar in het klantportaal van de eenheid</span></span>
                            </label>
                            <label class="gl-v2-toggle-row">
                                <input type="checkbox" class="gl-v2-toggle-switch" name="sendNow" value="true" id="gl-v2-dd-rq-sendnow" />
                                <span class="gl-v2-toggle-text"><span class="gl-v2-toggle-label">Meteen aanvragen</span><span class="gl-v2-toggle-hint">e-mail naar de verantwoordelijke</span></span>
                            </label>
                        </div>
                    </div>
                    <div class="gl-v2-field gl-v2-field-full">
                        <label class="gl-v2-field-label" for="gl-v2-dd-rq-note">OPMERKING</label>
                        <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" name="note" id="gl-v2-dd-rq-note" maxlength="500" /></div>
                    </div>
                    <p class="gl-v2-dd-formerror gl-v2-field-full" id="gl-v2-dd-rq-error" role="alert" hidden></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-dd-rq-submit"><i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>Opslaan</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Gegevens bewerken ─────────────────────────────────────────────────────────────────────────── *@
<div class="modal fade gl-v2-modal-form" id="gl-v2-dd-edit-modal" tabindex="-1" aria-hidden="true" aria-labelledby="gl-v2-dd-edit-title">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="gl-v2-dd-edit-title">Gegevens bewerken</h2>
