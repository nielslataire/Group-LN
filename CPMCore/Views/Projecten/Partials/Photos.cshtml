@using BOCore
@model CPMCore.Models.Projecten.DetailPhotosModel


@section PageStyle
{

}

@using (Html.BeginForm("Detail", "Projecten", FormMethod.Post, new { id = "FormGeneralData", @class = "form-horizontal" }))
{
    <section class="media-gallery">
        <div class="mg-main">
            <div class="row mg-files" data-sort-destination data-sort-id="media-gallery">
                @foreach (var picture in Model.Photos)
                {
                    if (picture.Type != BOCore.PictureType.Nieuws)
                    {
                        <div class="isotope-item image col-sm-6 col-md-4 col-lg-3">
                            <div class="thumbnail">
						<div class="thumb-preview">
                                    <a class="thumb-image" href="@Url.Content($"{(string)ViewBag.ImageWebURL}pictures/{picture.Name}")">
                                        <img src="@Url.Content($"{(string)ViewBag.ImageWebURL}pictures/447/{picture.Name}")" class="img-fluid" alt="@picture.Caption">
							</a>
							<div class="mg-thumb-options">
								<div class="mg-zoom"><i class="bx bx-search"></i></div>
								<div class="mg-toolbar">
									<div class="mg-option checkbox-custom checkbox-inline">
										<input type="checkbox" id="file_1" value="1">
										<label for="file_1">SELECT</label>
									</div>
									<div class="mg-group float-end">
                                                <a class="deletePhoto" data-id="@picture.Id" href="#ModalDeletePhoto">DELETE</a>
										<button class="dropdown-toggle mg-toggle" data-bs-toggle="dropdown"><span class="caret"></span></button>
										<div class="dropdown-menu mg-dropdown" role="menu">
                                                    @if (picture.Type == BOCore.PictureType.Hoofdfoto)
                                                    {
                                                        <a class="dropdown-item text-1" href="@Url.Action("UpdatePhotoType", "Projecten", new { id = picture.Id, type = BOCore.PictureType.Nevenfoto })">
                                                                <i class="fa fa-check-square"></i> Project
                                                            </a>
                                                        <a class ="dropdown-item text-1" href="@Url.Action("UpdatePhotoType", "Projecten", new { id = picture.Id, type = BOCore.PictureType.Werffoto })">
                                                                <i class="fa fa-check-square"></i> Uitvoering
                                                            </a>
                                                    }
                                                    else if (picture.Type == BOCore.PictureType.Nevenfoto)
                                                    {
                                                        <a class="dropdown-item text-1"  href="@Url.Action("UpdatePhotoType", "Projecten", new { id = picture.Id, type = BOCore.PictureType.Hoofdfoto })">
                                                                <i class="fa fa-check-square"></i> Hoofd
                                                            </a>
                                                        <a class="dropdown-item text-1"  href="@Url.Action("UpdatePhotoType", "Projecten", new { id = picture.Id, type = BOCore.PictureType.Werffoto })">
                                                                <i class="fa fa-check-square"></i> Uitvoering
                                                            </a>
                                                    }
                                                    else if (picture.Type == BOCore.PictureType.Werffoto)
                                                    {

                                                        <a class="dropdown-item text-1"  href="@Url.Action("UpdatePhotoType", "Projecten", new { id = picture.Id, type = BOCore.PictureType.Hoofdfoto })">
                                                                <i class="fa fa-check-square"></i> Hoofd
                                                            </a>
                                                        <a class="dropdown-item text-1"  href="@Url.Action("UpdatePhotoType", "Projecten", new { id = picture.Id, type = BOCore.PictureType.Nevenfoto })">
                                                                <i class="fa fa-check-square"></i> Project
                                                            </a>
                                                    }
										</div>
									</div>
								</div>
							</div>
						</div>
                                <h5 class="mg-title font-weight-semibold">@picture.Caption</h5>
						<div class="mg-description">
                                    <small class="float-start text-muted">@picture.Type</small>
                                    <small class="float-end text-muted">@picture.DateTimeUploaded</small>
						</div>
					</div>
				</div>
                }
                }
			</div>

	</div>
</section>
}