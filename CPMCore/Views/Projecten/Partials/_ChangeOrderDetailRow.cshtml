@using BOCore
@using HtmlHelpers.BeginCollectionItemCore
@using System.Globalization
@model ChangeOrderDetailBO

@using (Html.BeginCollectionItem("Details"))
{
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.ChangeOrderID)

    <div class="row align-items-center pb-3">
        <div class="col-lg-3">
            @Html.TextBoxFor(m => m.Description, new { @class = "form-control form-control-modern", @placeholder = "Omschrijving" })
        </div>
        <div class="col-lg-1">
            @Html.DropDownListFor(m => m.MeasurementType, Html.GetEnumSelectList(Model.MeasurementType.GetType()), new { @class = "form-control form-control-modern" })
        </div>
        <div class="col-lg-1">
            @Html.DropDownListFor(m => m.MeasurementUnit, Html.GetEnumSelectList(Model.MeasurementUnit.GetType()), new { @class = "form-control form-control-modern" })
        </div>
        <div class="col-lg-1">
            @Html.TextBoxFor(m => m.Number, new { @class = "form-control form-control-modern number-field", @type = "number", step = "1" })
        </div>
        @{
            var priceIncl = Model.Price * (1 + (Model.Commision / 100m));
        }
        <div class="col-lg-1">
            <div class="input-group">
                <input type="text"
                       class="form-control form-control-modern currency-input price-incl-field"
                       value="@priceIncl.ToString("N2", new CultureInfo("nl-BE"))"
                       placeholder="0,00" />
                <span class="input-group-text">€</span>
            </div>
        </div>
        <div class="col-lg-1">
            <div class="input-group">
                @Html.TextBoxFor(m => m.Commision, new { @class = "form-control form-control-modern commission-field" })
                <span class="input-group-text">%</span>
            </div>
        </div>
        <div class="col-lg-1">
            <div class="input-group">
                @Html.TextBoxFor(m => m.Price, new { @class = "form-control form-control-modern currency-input price-field", placeholder = "0,00" })
                <span class="input-group-text">€</span>
            </div>
        </div>

        <!-- Nieuw: totaalprijs -->
        @{
            var number = Model.Number;
            var price = Model.Price;
            var commission = Model.Commision; // bv. 21 = 21%
            var total = number * price * (1 + (commission / 100m));
        }
        <div class="col-lg-1">
            <input type="text"
                   class="form-control form-control-modern total-field"
                   value="@total.ToString("N2", new CultureInfo("nl-BE"))"
                   disabled />
        </div>
        <div class="col-lg-1">
            <div class="input-group">
            <input disabled="" class="form-control form-control-modern vat-field" value="21" />
                <span class="input-group-text">%</span>
            </div>
        </div>

        <div class="col-lg-1 text-end">
            <button type="button" 
                    class="btn btn-link text-primary p-0 delete-row" 
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    title="Verwijderen">
                <i class="fa fa-trash"></i>
            </button>
        </div>

    </div>

}
          
