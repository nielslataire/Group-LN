@model BOCore.BudgetGevelElementBO
@{
    bool heeftHoogte     = Model.HeeftHoogte;
    bool heeftLengte     = Model.HeeftLengteAlleen;
    bool heeftBreedteLengte = !heeftHoogte && !heeftLengte;
    var resultaat = heeftLengte ? Model.ResultaatLm : Model.ResultaatM2;
}
<tr data-element-id="@Model.Id"
    data-versie-id="@Model.BudgetVersieId"
    data-element-type="@Model.ElementType">

    <td style="min-width:90px;">
        <input type="text" class="form-control form-control-sm gevel-input"
               data-field="eenheidNaam" value="@Model.EenheidNaam" placeholder="bv. L1" />
    </td>

    <td style="min-width:110px;">
        <input type="text" class="form-control form-control-sm gevel-input"
               data-field="beschrijving" value="@Model.Beschrijving" placeholder="bv. VG" />
    </td>

    <td style="min-width:65px;">
        <input type="number" step="0.01"
               class="form-control form-control-sm text-end gevel-input"
               data-field="aantal"
               value="@Model.Aantal.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" />
    </td>

    @* Breedte — alleen voor gevel/raam/dak/afbraak *@
    <td style="min-width:75px;">
        @if (!heeftLengte)
        {
            <input type="number" min="0" step="0.001"
                   class="form-control form-control-sm text-end gevel-input"
                   data-field="breedte"
                   value="@(Model.Breedte.HasValue ? Model.Breedte.Value.ToString("F3", System.Globalization.CultureInfo.InvariantCulture) : "")" />
        }
        else
        {
            <span class="text-muted">—</span>
        }
    </td>

    @* Hoogte — alleen voor gevel/raam *@
    <td style="min-width:75px;">
        @if (heeftHoogte)
        {
            <input type="number" step="0.001"
                   class="form-control form-control-sm text-end gevel-input"
                   data-field="hoogte"
                   value="@(Model.Hoogte.HasValue ? Model.Hoogte.Value.ToString("F3", System.Globalization.CultureInfo.InvariantCulture) : "")" />
        }
        else
        {
            <span class="text-muted">—</span>
        }
    </td>

    @* Lengte — voor dak/afbraak en ballustrade/zichtscherm *@
    <td style="min-width:75px;">
        @if (heeftLengte || heeftBreedteLengte)
        {
            <input type="number" min="0" step="0.001"
                   class="form-control form-control-sm text-end gevel-input"
                   data-field="lengte"
                   value="@(Model.Lengte.HasValue ? Model.Lengte.Value.ToString("F3", System.Globalization.CultureInfo.InvariantCulture) : "")" />
        }
        else
        {
            <span class="text-muted">—</span>
        }
    </td>

    <td class="gevel-resultaat-cell text-end fw-semibold text-primary"
        style="min-width:80px;"
        data-bs-toggle="tooltip"
        data-bs-placement="top"
        title="@Model.FormulaResultaat">
        <span class="resultaat-value">@resultaat.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)</span>
        <span class="text-muted fw-normal"> @Model.EenheidLabel</span>
        <br />
        <small class="calc-detail text-muted fw-normal" style="display:none; font-size:0.65rem;">
            @Model.FormulaResultaat
        </small>
    </td>

    <td class="text-center" style="width:44px;">
        <div class="dropdown">
            <button class="btn btn-sm btn-light dropdown-toggle" type="button"
                    data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-ellipsis-v"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <button type="button" class="dropdown-item text-danger btn-delete-gevel">
                        <i class="fas fa-trash-alt me-1"></i>Verwijderen
                    </button>
                </li>
                <li>
                    <button type="button" class="dropdown-item btn-duplicate-gevel">
                        <i class="fas fa-copy me-1"></i>Dupliceren
                    </button>
                </li>
            </ul>
        </div>
    </td>
</tr>
