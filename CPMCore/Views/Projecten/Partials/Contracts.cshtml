@using BOCore
@model CPMCore.Models.Projecten.DetailContractsModel
@{
    var canWriteProjectSuppliers = ViewBag.CanWriteProjectSuppliers as bool? ?? false;
    var canDeleteProjectSuppliers = ViewBag.CanDeleteProjectSuppliers as bool? ?? false;
}

@section PageStyle
{
<link rel="stylesheet" href="~/lib/magnific-popup/magnific-popup.css" />
<link rel="stylesheet" href="~/lib/datatables/media/css/dataTables.bootstrap5.css" />


}
@if (Model.SupplierRows.Any())
{
@Html.HiddenFor(m => m.ProjectId, new {id = "txtProjectId"})
<div class="card card-modern">
	<div class="card-body">
		<div class="input-group">
			<span class="input-group-text">
				<i class="bx bx-search"></i>
			</span>
			<input type="text" class="form-control me-2" name="search-term" id="search-term" placeholder="Zoeken ..."><div id="colvis-container"></div>
		</div>
	</div>
</div>
<div class="card card-modern">
	<div class="card-body">
		<div class="datatables-header-footer-wrapper mt-2">
			<table class="table table-responsive-md table-hover mb-0" id="datatable-contracts-list" style="min-width: 550px;" data-toggle="table" data-show-columns="true" data-toolbar-align="right">

					<thead>
						<tr>
							<th data-sortable="false">Status</th>
							<th data-sortable="true">Bedrijf</th>
							<th data-sortable="true" class="text-right">Contractprijs</th>
							<th data-sortable="true" class="text-right">Totaal gefactureerd</th>
							<th data-sortable="false" class="hidden-xs text-right">BTW %</th>
							<th data-sortable="false" class="hidden-xs text-right">Betaaltermijn</th>
							<th data-sortable="false" class="hidden-xs text-right">Korting contant</th>
							<th data-sortable="false" class="hidden-xs text-right">Borg</th>
							<th class="hidden-xs noVis" data-sortable="false">Acties</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var row in Model.SupplierRows)
						{
							<tr>
								<td>
									@if (!row.HasContract)
									{
										<span class="ecommerce-status canceled" data-toggle="tooltip" data-placement="top" title="Geen contract"></span>
									}
									else if (row.Contract?.ContractSigned == true)
									{
										<span class="ecommerce-status completed" data-toggle="tooltip" data-placement="top" title="Contract getekend"></span>
									}
									else
									{
										<span class="ecommerce-status failed" data-toggle="tooltip" data-placement="top" title="Contract niet getekend"></span>
									}
								</td>
								<td>
									@row.Company?.Display
								</td>
								<td>
									@if (row.HasContract)
									{
										@String.Format("{0:C}", row.Contract.Activities.Sum(m => m.Price))
									}
									else
									{
										@Html.Raw("-")
									}
								</td>
								<td>
									@String.Format("{0:C}", row.TotalInvoiced)
								</td>
								<td>
									@if (row.Contract?.VatPercentage != null)
									{
										@Html.DisplayFor(m => row.Contract.VatPercentage)
									}
									else
									{
										@Html.Raw("-")
									}
								</td>
								<td>
									@if (row.Contract?.PaymentTerm != null)
									{
										@Html.DisplayFor(m => row.Contract.PaymentTerm) @Html.Raw(" dagen")
									}
									else
									{
										@Html.Raw("-")
									}
								</td>
								<td>
									@if (row.Contract?.CashDiscount != false)
									{
										@Html.DisplayFor(m => row.Contract.CashDiscountPercentage) @Html.Raw(" binnen de ") @Html.DisplayFor(m => row.Contract.CashDiscountPaymentTerm) @Html.Raw(" dagen")
									}
									else
									{
										@Html.Raw("-")
									}
								</td>
								<td>
									@if (row.Contract?.GuaranteeType == ContractGuaranteeType.FinancialGuarantee)
									{
										@Html.DisplayFor(m => row.Contract.GuaranteePercentage) @Html.Raw(" ") @row.Contract.GuaranteeType.GetDisplayName()
									}
									else if (row.HasContract)
									{
										@row.Contract.GuaranteeType.GetDisplayName()
									}
									else
									{
										@Html.Raw("-")
									}
								</td>
								<td class="actions">
									@if (row.HasContract)
									{
										<a class="ms-1 me-1" data-toggle="tooltip" data-placement="top" title="Detail" data-original-title="Detail" href="@Url.Action("DetailContract", "Projecten", new { projectid = Model.ProjectId, contractid = row.Contract.Id })"><i class="bx bx-eye fs-5"></i></a>
										
										@if (canWriteProjectSuppliers)
										{
											<a class="ms-1 me-1" data-toggle="tooltip" data-placement="top" title="Bewerken" data-original-title="Bewerken" id="editContract" href="@Url.Action("EditContract", "Projecten", new { projectid = Model.ProjectId, contractid = row.Contract.Id })"><i class="bx bx-edit fs-5"></i></a>
										}
										@if (canDeleteProjectSuppliers)
										{
											<a class="ms-1 me-1 deleteContract" href="#modaldeletecontract" data-toggle="tooltip" id="deleteContract" data-placement="top" title="Verwijderen" data-original-title="Verwijderen" data-id="@row.Contract.Id"><i class="bx bx-trash fs-5"></i></a>
										}
									}
									else if (row.Company != null)
									{
										<a class="ms-1 me-1" data-toggle="tooltip" data-placement="top" title="Detail" data-original-title="Detail" href="@Url.Action("DetailSupplier", "Projecten", new { projectid = Model.ProjectId, companyid = row.Company.ID })"><i class="bx bx-eye fs-5"></i></a>
									}
									else
									{
										@Html.Raw("-")
									}

								</td>
							</tr>

						}
					</tbody>
			</table>
		</div>
	</div>

</div>
}
else
{
	<div class="card card-modern mb-4">
		<div class="card-body align-items-center text-center card-big-info">
			<div class="col-12 mb-3" style="font-size:83.2px; font-weight:400;color:#e7e7e7;">
				<i class="bx bx-file"></i>

			</div>
			<div class="col-12 text-muted mb-3">
				<h4>Nog geen leveranciers toegevoegd</h4>
			</div>
			<div class="col-12 text-muted">
				<a href="@Url.Action("AddContract", "Projecten", new { projectid = Model.ProjectId })" class="btn btn-default btn-md">+ Een eerste leverancier toevoegenn</a>
			</div>
		</div>
	</div>
}