@model BOCore.BudgetOppervlaktesBO
@{
    var versieId = ViewBag.VersieId as int? ?? Model.BudgetVersieId;
}
<tr data-rij-id="@Model.Id"
    data-versie-id="@Model.BudgetVersieId"
    data-group-type="@Model.UnitGroupTypeId"
    data-unit-type="@Model.UnitTypeId">

    <td class="text-center text-muted rij-nummer" style="width:36px;"></td>

    <td style="min-width:120px;">
        <input type="text"
               class="bw-cell-input opp-naam"
               value="@Model.EenheidNaam"
               data-field="eenheidNaam" />
    </td>

    <td style="min-width:130px;">
        <select class="bw-cell-input opp-group-type" data-field="unitGroupTypeId">
            <option value="">—</option>
            @* Ingevuld via JavaScript vanuit window.budgetGroupTypes *@
        </select>
    </td>

    <td style="min-width:120px;">
        <select class="bw-cell-input opp-unit-type" data-field="unitTypeId">
            <option value="">—</option>
        </select>
    </td>

    @{
        var fields = new[]
        {
            ("bewoonbareOpp",          Model.BewoonbareOpp),
            ("tuin",                   Model.Tuin),
            ("terrasPrefab",           Model.TerrasPrefab),
            ("terrasGelijkvloers",     Model.TerrasGelijkvloers),
            ("dakterras",              Model.Dakterras),
            ("garagesParkingsBovenGr", Model.GaragesParkingsBovenGr),
            ("garBergOndergronds",     Model.GarBergOndergronds),
            ("bergGelijkvloers",       Model.BergGelijkvloers),
            ("carports",               Model.Carports),
            ("doorritGVL",             Model.DoorritGVL),
            ("zolder",                 Model.Zolder),
            ("gemeenschappelijkeDelen",Model.GemeenschappelijkeDelen),
            ("wegenis",                Model.Wegenis),
            ("grondopp",               Model.Grondopp),
        };
    }

    @foreach (var (field, val) in fields)
    {
        <td style="min-width:70px;">
            <input type="number" min="0" step="0.01"
                   class="bw-cell-input bw-cell-input--num opp-input"
                   data-field="@field"
                   value="@val.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" />
        </td>
    }

    <td class="opp-gereduceerd-cell bw-num fw-semibold text-primary"
        style="min-width:90px;"
        data-bs-toggle="tooltip"
        data-bs-placement="top"
        title="@Model.FormulaOppGereduceerd">
        <span class="opp-gered-value">@Model.OppGereduceerd.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)</span>
        <br />
        <small class="calc-detail text-muted fw-normal" style="display:none;font-size:0.65rem;">
            @Model.FormulaOppGereduceerd
        </small>
    </td>

    <td class="text-end" style="width:76px;">
        <div class="bw-row-actions">
            <button type="button" class="bw-row-btn btn-duplicate-rij"
                    title="Rij dupliceren" aria-label="Rij dupliceren">
                <i class="fas fa-copy" aria-hidden="true"></i>
            </button>
            <button type="button" class="bw-row-btn bw-row-btn--danger btn-delete-rij"
                    title="Rij verwijderen" aria-label="Rij verwijderen">
                <i class="fas fa-trash-alt" aria-hidden="true"></i>
            </button>
        </div>
    </td>
</tr>

<script>
    // Initialiseer de dropdowns voor deze net-toegevoegde rij
    (function () {
        const row   = document.querySelector('tr[data-rij-id="@Model.Id"]');
        if (!row || !window.budgetGroupTypes) return;

        const grpSel  = row.querySelector('.opp-group-type');
        const typeSel = row.querySelector('.opp-unit-type');

        window.budgetGroupTypes.forEach(g => {
            const opt = document.createElement('option');
            opt.value = g.id;
            opt.text  = g.name;
            if (g.id == @(Model.UnitGroupTypeId?.ToString() ?? "null")) opt.selected = true;
            grpSel.appendChild(opt);
        });

        if (@(Model.UnitGroupTypeId.HasValue ? "true" : "false")) {
            const filtered = (window.budgetAllTypes || [])
                .filter(t => t.groupId == @(Model.UnitGroupTypeId?.ToString() ?? "0"));
            filtered.forEach(t => {
                const opt = document.createElement('option');
                opt.value = t.id;
                opt.text  = t.name;
                if (t.id == @(Model.UnitTypeId?.ToString() ?? "null")) opt.selected = true;
                typeSel.appendChild(opt);
            });
        }

        // Tooltips
        new bootstrap.Tooltip(row.querySelector('.opp-gereduceerd-cell'));
    })();
</script>
