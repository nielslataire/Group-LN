@model CPMCore.Models.Projecten.ChangeOrderDetailRowV2
@*
    Wijzigingsopdracht V2 (28a/28b, bewerkbaar) — één regel van de "Regels"-tabel. Ook gebruikt door
    ChangeOrderDetailV2AddRow (AJAX "+ Regel", zelfde patroon als de legacy AddChangeOrderDetailRow) —
    Index moet dan altijd de huidige rijtelling zijn zodat de name="rows[i]." vernummering klopt.
*@
@using BOCore
@{
    var index = ViewData["Index"] as int? ?? 0;
    var vatKlant = ViewData["VatKlant"] as decimal? ?? 21m;
    var isLocked = ViewData["IsLocked"] as bool? ?? false;
    var vat = Model.VatPercentage > 0 ? Model.VatPercentage : vatKlant;
    // Btw-codes van het facturatiebedrijf (migratie 073): gekozen code, anders de eerste code met hetzelfde percentage.
    var vatTypes = ViewData["VatTypes"] as List<CPMCore.Models.Projecten.VatTypeOptionV2> ?? new List<CPMCore.Models.Projecten.VatTypeOptionV2>();
    var selectedVatTypeId = vatTypes.Any(t => t.Id == Model.VatTypeId) ? Model.VatTypeId
        : vatTypes.FirstOrDefault(t => t.Percentage == vat)?.Id;
    var prefix = $"rows[{index}]";
    var uid = Guid.NewGuid().ToString("N")[..8];
    var cellLocked = isLocked || Model.PriceLocked;
    var minwerk = Model.IsMinwerk;
}
<tr class="gl-v2-co-row js-co-row @(Model.NeedsReview ? "is-needs-review" : "") @(Model.PriceLocked ? "is-price-locked" : "") @(minwerk ? "is-minwerk" : "")" data-index="@index">
    <td class="gl-v2-co-handle-cell co-c-g">
        @* Sleepgreep (28a): slepen met muis/vinger, of focus + pijl omhoog/omlaag. De volgorde van de rijen
           in het formulier is de volgorde die bewaard wordt (ChangeOrderDetail.SortOrder, migratie 067). *@
        <button type="button" class="gl-v2-co-handle js-co-handle" title="Sleep om te verplaatsen (of pijl omhoog/omlaag)" aria-label="Regel verplaatsen: sleep, of gebruik pijl omhoog en omlaag"><i class="ph ph-dots-six-vertical" aria-hidden="true"></i></button>
    </td>
    @* data-label: op smalle schermen wordt de rij een kaartje (zie gl-v2-projecten-changeorderdetail.css: tabel, dan twee lijnen, dan een kaartje per regel, 28r) en toont elke cel haar kolomnaam; co-c-* zijn de gebiedsnamen van dat raster. *@
    <td class="gl-v2-co-desc-td co-c-om" data-label="Omschrijving">
        <input type="hidden" name="@(prefix).id" class="js-co-id" value="@Model.Id" />
        <input type="hidden" name="@(prefix).groupKey" class="js-co-groupkey" value="@Model.GroupKey" />
        <input type="hidden" name="@(prefix).sourceImagePath" class="js-co-sourceimage" value="@Model.SourceImagePath" />
        @* Meerwerk of minwerk (28v): de knop vóór de omschrijving wisselt tussen + en −. Minwerk wordt aan kostprijs verrekend (commissie vast op 0 %). *@
        <input type="hidden" name="@(prefix).isMinwerk" class="js-co-isminwerk" value="@(minwerk ? "true" : "false")" />
        <div class="gl-v2-co-descwrap">
            <button type="button" class="gl-v2-co-pm js-co-sign @(minwerk ? "is-minus" : "")" aria-pressed="@(minwerk ? "true" : "false")" @(cellLocked ? "disabled" : "")
                    title="@(minwerk ? "Minwerk: waarde die wegvalt, aan kostprijs verrekend. Klik voor meerwerk." : "Meerwerk: waarde die erbij komt. Klik voor minwerk.")"
                    aria-label="Meerwerk of minwerk: nu @(minwerk ? "minwerk" : "meerwerk")"><span aria-hidden="true">@(minwerk ? "−" : "+")</span></button>
            <div class="gl-v2-field-box gl-v2-field-box-textarea gl-v2-co-descbox"><textarea class="gl-v2-field-input js-co-description" name="@(prefix).description" rows="1" maxlength="1000" @(isLocked ? "disabled" : "")>@Model.Description</textarea></div>
        </div>
        <span class="gl-v2-co-row-flags">
            @if (!string.IsNullOrWhiteSpace(Model.SourceImagePath))
            {
                <span class="gl-v2-co-photo-flag" title="Foto uit de offerte hangt aan deze regel"><i class="ph ph-image" aria-hidden="true"></i>foto</span>
            }
            @if (Model.PriceLocked)
            {
                <span class="gl-v2-co-photo-flag" title="Prijs, commissie en btw komen uit de offerte en liggen vast — aantal en omschrijving kan je nog aanpassen"><i class="ph ph-lock-simple" aria-hidden="true"></i>prijs uit offerte</span>
            }
            @if (Model.NeedsReview)
            {
                <button type="button" class="gl-v2-co-review-flag js-co-confirm-row" title="Onzekere waarde uit de offerte — klik om te bevestigen dat de regel klopt"><i class="ph ph-warning" aria-hidden="true"></i>controleer</button>
            }
        </span>
    </td>
    <td class="is-center co-c-me" data-label="Meetmethode">
        @await Html.PartialAsync("GlV2/_SelectList", new CPMCore.Models.GlV2.GlV2SelectListVm
        {
            Name = prefix + ".measurementType", Id = "co-mt-" + uid, Bare = true, Disabled = cellLocked, Value = Model.MeasurementType.ToString(),
            Items = Enum.GetValues(typeof(MeasurementType)).Cast<MeasurementType>().Select(mt => new CPMCore.Models.GlV2.GlV2SelectItem { Value = ((int)mt).ToString(), Text = mt.GetDisplayName() }).ToList()
        })
    </td>
    <td class="is-center co-c-ee" data-label="Eenheid">
        @await Html.PartialAsync("GlV2/_SelectList", new CPMCore.Models.GlV2.GlV2SelectListVm
        {
            Name = prefix + ".measurementUnit", Id = "co-mu-" + uid, Bare = true, Disabled = cellLocked, Value = Model.MeasurementUnit.ToString(),
            Items = Enum.GetValues(typeof(MeasurementUnit)).Cast<MeasurementUnit>().Select(mu => new CPMCore.Models.GlV2.GlV2SelectItem { Value = ((int)mu).ToString(), Text = mu.GetDisplayName() }).ToList()
        })
    </td>
    <td class="is-right co-c-aa" data-label="Aantal"><div class="gl-v2-field-box gl-v2-co-numbox is-qty"><input type="number" step="1" class="gl-v2-field-input js-co-number" name="@(prefix).number" value="@Model.Number" @(isLocked ? "disabled" : "") /></div></td>
    <td class="is-right co-c-pl" data-label="Prijs leverancier"><div class="gl-v2-field-box gl-v2-co-numbox is-money"><input type="text" inputmode="decimal" autocomplete="off" class="gl-v2-field-input is-num Currencymask js-co-price" name="@(prefix).price" value="@Model.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" @(isLocked ? "disabled" : Model.PriceLocked ? "readonly" : "") /><span class="gl-v2-field-suffix">€</span></div></td>
    <td class="is-right co-c-co" data-label="Commissie %"><div class="gl-v2-field-box gl-v2-co-numbox"><input type="number" step="0.01" min="0" class="gl-v2-field-input js-co-commission" name="@(prefix).commission" value="@((minwerk && !Model.PriceLocked ? 0m : Model.Commission).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" @(isLocked ? "disabled" : (Model.PriceLocked || minwerk) ? "readonly" : "") /></div></td>
    <td class="is-right gl-v2-co-tabular co-c-pk js-co-priceklant" data-label="Prijs klant">—</td>
    @if (vatTypes.Count > 0)
    {
        @* Btw-code van het facturatiebedrijf; het percentage (verborgen js-co-vat) volgt de gekozen code, ook server-side. *@
        <td class="is-right co-c-bt" data-label="Btw">
            <div class="gl-v2-co-vatbox">
            @await Html.PartialAsync("GlV2/_SelectList", new CPMCore.Models.GlV2.GlV2SelectListVm
            {
                Name = prefix + ".vatTypeId", Id = "co-vt-" + uid, Bare = true, Disabled = cellLocked, Value = selectedVatTypeId?.ToString(),
                Data = new Dictionary<string, string> { ["data-role"] = "vattype" },
                Items = vatTypes.Select(t => new CPMCore.Models.GlV2.GlV2SelectItem
                {
                    Value = t.Id.ToString(), Text = t.ShortDisplay, Title = t.LongDisplay,
                    Data = new Dictionary<string, string> { ["data-vat"] = t.Percentage.ToString(System.Globalization.CultureInfo.InvariantCulture) }
                }).ToList()
            })
            </div>
            <input type="hidden" class="js-co-vat" name="@(prefix).vatPercentage" value="@vat.ToString(System.Globalization.CultureInfo.InvariantCulture)" @(isLocked ? "disabled" : "") />
        </td>
    }
    else
    {
        <td class="is-right co-c-bt" data-label="Btw"><div class="gl-v2-field-box gl-v2-co-numbox"><input type="number" step="0.01" class="gl-v2-field-input js-co-vat" name="@(prefix).vatPercentage" value="@vat.ToString(System.Globalization.CultureInfo.InvariantCulture)" @(isLocked ? "disabled" : Model.PriceLocked ? "readonly" : "") /></div></td>
    }
    <td class="is-right gl-v2-co-tabular co-c-to js-co-total" data-label="Totaal">—</td>
    <td class="is-right co-c-d">
        <input type="hidden" name="@(prefix).needsReview" class="js-co-needsreview" value="@Model.NeedsReview.ToString().ToLowerInvariant()" />
        @if (!isLocked)
        {
            <button type="button" class="gl-v2-co-row-delete js-co-delete-row" title="Regel verwijderen"><i class="ph ph-trash" aria-hidden="true"></i></button>
        }
    </td>
</tr>
@* Schadevergoeding op dit minwerk (28v): een interne rij ONDER het minwerk, zoals in het ontwerp (gouden vlak, "INTERN", percentage + snelkeuzes,
   "Gaat naar", bedrag rechts). De klant ziet enkel het minwerk aan het eindbedrag, nooit de vergoeding of het percentage. Eigen <tr> direct na
   de regel: slepen, verwijderen en hernummeren in de JS nemen ze mee. *@
<tr class="gl-v2-co-sv-tr js-co-damage-row" data-index="@index" @(minwerk ? "" : "hidden")>
    <td colspan="11" class="gl-v2-co-sv-cell">
        <input type="hidden" class="js-co-dmg-to" name="@(prefix).damageGoesTo" value="@(Model.DamageGoesTo == 2 ? 2 : 1)" />
        <div class="gl-v2-co-sv-addrow js-co-dmg-add-row" @(Model.HasDamage ? "hidden" : "")>
            <button type="button" class="gl-v2-co-sv-link js-co-dmg-add" @(cellLocked ? "disabled" : "")><i class="ph ph-plus" aria-hidden="true"></i>Schadevergoeding op dit minwerk</button>
            <span>klant krijgt dan maar een deel van de waarde terug</span>
        </div>
        <div class="gl-v2-co-sv-row js-co-dmg-box" role="group" aria-label="Schadevergoeding op dit minwerk" @(Model.HasDamage ? "" : "hidden")>
            <span class="gl-v2-co-sv-hook" aria-hidden="true"><i class="ph ph-arrow-elbow-down-right"></i></span>
            <div class="gl-v2-co-sv-main">
                <div class="gl-v2-co-sv-t">
                    <b>Schadevergoeding niet-uitgevoerde werken</b>
                    <span class="gl-v2-co-sv-tag">INTERN</span>
                    <span class="gl-v2-co-sv-kz">klant ziet enkel het minwerk aan <span class="js-co-dmg-back">—</span></span>
                </div>
                <div class="gl-v2-co-sv-ctl">
                    <label class="gl-v2-co-sv-pct">
                        <span class="visually-hidden">Percentage</span>
                        <input type="text" inputmode="decimal" class="js-co-dmg-input" name="@(prefix).damagePercentage" value="@((Model.HasDamage ? Model.DamagePercentage : 0m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" @(cellLocked ? "readonly" : "") />
                        <em>%</em>
                    </label>
                    <span class="gl-v2-co-sv-on">van <span class="js-co-dmg-base">—</span></span>
                    <div class="gl-v2-co-sv-pre" role="group" aria-label="Snel kiezen">
                        @foreach (var q in new[] { 10, 20, 25 })
                        {
                            <button type="button" class="js-co-dmg-quick" data-pct="@q" @(cellLocked ? "disabled" : "")>@q %</button>
                        }
                    </div>
                    <span class="gl-v2-co-sv-sep" aria-hidden="true"></span>
                    <span class="gl-v2-co-sv-lbl">Gaat naar</span>
                    <div class="gl-v2-co-sv-seg" role="group" aria-label="Wie houdt de vergoeding">
                        <button type="button" class="js-co-dmg-toggle @(Model.DamageGoesTo != 2 ? "is-active" : "")" data-to="1" aria-pressed="@(Model.DamageGoesTo != 2 ? "true" : "false")" @(cellLocked ? "disabled" : "")>Bouwheer</button>
                        <button type="button" class="js-co-dmg-toggle @(Model.DamageGoesTo == 2 ? "is-active" : "")" data-to="2" aria-pressed="@(Model.DamageGoesTo == 2 ? "true" : "false")" @(cellLocked ? "disabled" : "")>Leverancier</button>
                    </div>
                </div>
                <span class="gl-v2-co-sv-sub js-co-dmg-sub"></span>
            </div>
            <span class="gl-v2-co-sv-amt gl-v2-co-tabular js-co-dmg-amt">—</span>
            @if (!cellLocked)
            {
                <button type="button" class="gl-v2-co-row-delete js-co-dmg-remove" title="Schadevergoeding weghalen" aria-label="Schadevergoeding weghalen"><i class="ph ph-trash" aria-hidden="true"></i></button>
            }
            else { <span></span> }
        </div>
    </td>
</tr>
