@using BOCore
@model CPMCore.Models.Projecten.ProjectCoordinatieModel
@{
    ViewData["Title"] = Model.ProjectName;
    var contractType = Model.ContractType;
    var showSchijven = contractType == CoordinationContractType.Schijven || contractType == CoordinationContractType.Gemengd;
    var showRegie    = contractType == CoordinationContractType.Regie    || contractType == CoordinationContractType.Gemengd;
    var settingsUrl  = Url.Action("CoordinatieInstellingen", "Projecten", new { projectid = Model.ProjectId });
    var canInvoiceSlices = showSchijven && Model.CoordinationIssuerCompanyId.HasValue && Model.ContractPrice.HasValue && Model.ContractPrice > 0;
}
@section PageStyle
{
    <link rel="stylesheet" href="~/lib/datatables/media/css/dataTables.bootstrap5.css" />
}
<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", Model.ProjectId)
        <div class="inner-body">
            <div class="row">
                <div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
                    <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
                        <h1 class="font-weight-bold mb-0 mt-0">Coördinatie</h1>
                        <h5 class="mb-4 mt-0">Overzicht van schijven en/of regie voor dit coördinatieproject</h5>
                    </div>
                    <div class="col-sm-auto px-0">
                        <div class="btn-group" role="group" aria-label="Project acties">
                            <div class="btn-group">
                                <button type="button" class="btn btn-primary btn-md px-3 me-1 dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-upload me-2"></i>Exporteer
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" id="btnExportExcel" href="#"><i class="fas fa-file-excel me-2 text-success"></i>Excel</a></li>
                                    <li><a class="dropdown-item" id="btnExportPdf" href="#"><i class="fas fa-file-pdf me-2 text-danger"></i>PDF</a></li>
                                </ul>
                            </div>
                            <a href="@settingsUrl" class="btn btn-primary btn-md px-3 me-1" title="Instellingen"><i class="fas fa-cog"></i></a>
                            @if (canInvoiceSlices)
                            {
                                <button type="submit"
                                        form="coordInvoiceForm"
                                        class="btn btn-primary btn-md px-3"
                                        id="btnCoordInvoice"
                                        disabled
                                        title="Factuur opmaken">
                                    <i class="fa fa-euro-sign me-2"></i>Factuur opmaken
                                </button>
                            }
                        </div>
                    </div>
                </div>

                @if (!showSchijven && !showRegie)
                {
                    <div class="alert alert-warning mt-3">
                        Geen contracttype geconfigureerd voor dit coördinatieproject. Stel het type in via de <a href="@settingsUrl">instellingen</a>.
                    </div>
                }
                else
                {
                    @if (showSchijven && showRegie)
                    {
                        <!-- Gemengd: twee tabbladen -->
                        <div class="coord-tabs" id="coordTabs" role="tablist">
                            <button class="coord-tab active" id="tab-schijven" data-bs-toggle="tab" data-bs-target="#pane-schijven" type="button" role="tab" aria-selected="true">Contractschijven</button>
                            <button class="coord-tab" id="tab-regie" data-bs-toggle="tab" data-bs-target="#pane-regie" type="button" role="tab" aria-selected="false">Regie-uren</button>
                        </div>
                    }
                    @* ── Stat-kaarten (boven de tab-content) ── *@
                    @if (showSchijven && showRegie)
                    {
                        @* Gemengd: beide blokken aanwezig, JS schakelt op tab-wissel *@
                        <div id="statCards-schijven" class="@(canInvoiceSlices ? "" : "d-none")">
                            @await Html.PartialAsync("Partials/_CoordinatieStatCards", Model)
                        </div>
                        <div id="statCards-regie" class="d-none">
                            @await Html.PartialAsync("Partials/_CoordinatieRegieStatCards", Model)
                        </div>
                    }
                    else if (showSchijven && canInvoiceSlices)
                    {
                        @await Html.PartialAsync("Partials/_CoordinatieStatCards", Model)
                    }
                    else if (showRegie)
                    {
                        @await Html.PartialAsync("Partials/_CoordinatieRegieStatCards", Model)
                    }

                    @if (showSchijven && showRegie)
                    {
                        <div class="tab-content " id="coordTabContent">
                            <div class="tab-pane fade show active" id="pane-schijven" role="tabpanel">
                                @await Html.PartialAsync("Partials/_CoordinatieSchijven", Model)
                            </div>
                            <div class="tab-pane fade" id="pane-regie" role="tabpanel">
                                @await Html.PartialAsync("Partials/_CoordinatieRegie", Model)
                            </div>
                        </div>
                    }
                    else if (showSchijven)
                    {
                        <div class="mt-3">
                            @await Html.PartialAsync("Partials/_CoordinatieSchijven", Model)
                        </div>
                    }
                    else
                    {
                        <div class="mt-3">
                            @await Html.PartialAsync("Partials/_CoordinatieRegie", Model)
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>

@if (canInvoiceSlices)
{
    <form id="coordInvoiceForm"
          method="post"
          action="@Url.Action("MakeCoordSliceInvoices", "Projecten")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="projectId" value="@Model.ProjectId" />
    </form>

    <!-- Loading modal -->
    <div class="modal fade" id="coordInvoiceBusyModal"
         data-bs-backdrop="static" data-bs-keyboard="false"
         tabindex="-1" aria-labelledby="coordInvoiceBusyModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title" id="coordInvoiceBusyModalLabel">Facturen worden opgemaakt</h5>
                </div>
                <div class="modal-body d-flex flex-column align-items-center gap-3 py-4">
                    <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
                    <span class="text-center">Even geduld. De pagina wordt vernieuwd zodra de verwerking klaar is.</span>
                </div>
            </div>
        </div>
    </div>
}

@section PageScripts
{
    <script src="https://cdn.datatables.net/v/bs5/jszip-3.10.1/dt-2.2.2/b-3.2.2/b-colvis-3.2.2/b-html5-3.2.2/b-print-3.2.2/datatables.min.js" integrity="sha384-GC9Im1BDtt06YOKSzkS553+5q43Nos2JSnLM31TjWFcFbzZrFhAtgCzrHDGM0iDy" crossorigin="anonymous"></script>
    <script>
        const dtSchijven = document.getElementById('dt-schijven');
        if (dtSchijven) {
            const rowCount = dtSchijven.querySelectorAll('tbody tr').length;
            const usePaging = rowCount > 20;
            const dt = new DataTable('#dt-schijven', {
                layout: {
                    topStart: {
                        buttons: [
                            { extend: 'excel', text: '<i class="fa fa-file-excel"></i>', className: 'btn btn-primary btn-md', titleAttr: 'Exporteer naar excel', exportOptions: { columns: ':visible' } },
                            { extend: 'pdf',   text: '<i class="fa fa-file-pdf"></i>',   className: 'btn btn-primary btn-md', titleAttr: 'Exporteer naar pdf',   exportOptions: { columns: ':visible' } }
                        ]
                    }
                },
                paging: usePaging, info: usePaging, searching: false
            });
            $(".buttons-excel").hide();
            $(".buttons-pdf").hide();
        }
$("#btnExportExcel").on('click', function () { $(".buttons-excel").first().trigger("click"); });
        $("#btnExportPdf").on('click', function ()   { $(".buttons-pdf").first().trigger("click");   });

        // Sync active class op custom coord-tab knoppen bij tab-wissel + stat-kaarten wisselen
        document.querySelectorAll('.coord-tab').forEach(function (btn) {
            btn.addEventListener('shown.bs.tab', function () {
                document.querySelectorAll('.coord-tab').forEach(function (b) { b.classList.remove('active'); });
                btn.classList.add('active');

                var target          = btn.getAttribute('data-bs-target');
                var schijvenCards   = document.getElementById('statCards-schijven');
                var regieCards      = document.getElementById('statCards-regie');
                if (schijvenCards && regieCards) {
                    var isRegie = target === '#pane-regie';
                    schijvenCards.classList.toggle('d-none',  isRegie);
                    regieCards.classList.toggle('d-none',    !isRegie);
                }
            });
        });
    </script>
    <script src="~/js/detail-coordinatie.js"></script>
}
