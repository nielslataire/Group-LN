@using CPMCore.Models.Budget
@model BudgetVergelijkenModel
@section PageStyle {
    <link rel="stylesheet" href="~/css/budget-wizard.css" />
<style>
    .versie-col { min-width: 180px; }
    .vergelijk-tabel th.versie-header { background: #e8f0fe; color: #0d6efd; text-align: center; font-weight: 700; }
    .vergelijk-tabel td.bedrag { text-align: right; font-weight: 600; }
    .vergelijk-tabel .groep-header { background: #f0f4ff; font-size: .8rem; text-transform: uppercase; color: #0d6efd; letter-spacing: .05em; }
    .vergelijk-tabel .totaal-row td { background: #e8f0fe; font-weight: 700; border-top: 2px solid #0d6efd; }
    .beste { color: #198754; }
    .slechtste { color: #dc3545; }
    .versie-toggle { cursor: pointer; transition: background .15s, color .15s; }
    .versie-toggle.geselecteerd { background: #0d6efd !important; color: #fff !important; }
</style>
}

<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", Model.ProjectId)
        <div class="inner-body bw-inner-body">

            @* ── Koptekst ── *@
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h2 class="bw-page-header__title mb-1">Versies vergelijken</h2>
                    <p class="text-muted mb-0">Budget <strong>@Model.BudgetNaam</strong> — @Model.ProjectName</p>
                </div>
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
                    <i class="bx bx-arrow-back me-1"></i> Terug
                </a>
            </div>

            @* ── Versie selector ── *@
            <div class="card card-modern mb-4">
                <div class="card-header"><strong>Selecteer versies om te vergelijken</strong></div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2" id="versieToggles">
                        @foreach (var v in Model.AlleVersies)
                        {
                            <span class="badge bg-light text-dark border versie-toggle p-2 fs-6"
                                  data-versie-id="@v.Id">
                                v@v.Versienummer — @v.VersieNaam
                                <span class="text-muted small ms-1">(@v.Status)</span>
                            </span>
                        }
                    </div>
                    <div class="mt-3 d-flex align-items-center gap-3">
                        <button type="button" class="btn btn-primary btn-sm" id="btnVergelijk">
                            <i class="bx bx-git-compare me-1"></i> Vergelijken
                        </button>
                        <span class="text-muted small" id="lblSelectie">0 versies geselecteerd</span>
                    </div>
                </div>
            </div>

            @* ── Spinner ── *@
            <div id="vergelijkSpinner" class="text-center py-4 d-none">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="mt-2 text-muted">Berekenen...</div>
            </div>

            @* ── Vergelijkingstabel (dynamisch gevuld) ── *@
            <div id="vergelijkResultaat" class="d-none">
                <div class="card card-modern">
                    <div class="card-header"><strong>Vergelijking</strong></div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table vergelijk-tabel mb-0">
                                <thead id="vergelijkHead"></thead>
                                <tbody id="vergelijkBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@section PageScripts {
<script>
    // VB.NET properties serialiseren als PascalCase via System.Text.Json
    const geselecteerd = new Set();

    $(document).on('click', '.versie-toggle', function () {
        const id = parseInt($(this).data('versie-id'));
        if (geselecteerd.has(id)) {
            geselecteerd.delete(id);
            $(this).removeClass('geselecteerd');
        } else {
            geselecteerd.add(id);
            $(this).addClass('geselecteerd');
        }
        $('#lblSelectie').text(geselecteerd.size + ' versie(s) geselecteerd');
    });

    $('#btnVergelijk').on('click', function () {
        if (geselecteerd.size < 1) {
            if (typeof toastr !== 'undefined') toastr.warning('Selecteer minstens 1 versie.');
            return;
        }
        $('#vergelijkResultaat').addClass('d-none');
        $('#vergelijkSpinner').removeClass('d-none');

        $.ajax({
            url: '@Url.Action("VergelijkenResultaat", "Projecten")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ versieIds: Array.from(geselecteerd) }),
            success: function (res) {
                $('#vergelijkSpinner').addClass('d-none');
                if (!res.success) {
                    if (typeof toastr !== 'undefined') toastr.error(res.message);
                    return;
                }
                bouwVergelijkTabel(res.resultaten);
                $('#vergelijkResultaat').removeClass('d-none');
            },
            error: function () {
                $('#vergelijkSpinner').addClass('d-none');
                if (typeof toastr !== 'undefined') toastr.error('Fout bij ophalen resultaten.');
            }
        });
    });

    function fmtEuro(val) {
        if (val == null) return '—';
        return '€ ' + Math.round(val).toLocaleString('nl-BE');
    }

    function bouwVergelijkTabel(resultaten) {
        // Header — PascalCase (VB.NET / System.Text.Json default)
        let thead = '<tr><th style="width:30%">Kostenpost</th>';
        resultaten.forEach(function (r) {
            thead += '<th class="versie-header versie-col">v' + r.Versienummer + ' — ' + (r.VersieNaam || '') + '</th>';
        });
        thead += '</tr>';
        $('#vergelijkHead').html(thead);

        function rij(label, getter, indent) {
            const waarden = resultaten.map(function (r) { return getter(r) || 0; });
            const min = Math.min(...waarden);
            const max = Math.max(...waarden);
            let tr = '<tr><td class="' + (indent ? 'ps-4' : 'fw-semibold') + '">' + label + '</td>';
            waarden.forEach(function (w) {
                const cls = waarden.length > 1
                    ? (w === min && min !== max ? ' beste' : w === max && min !== max ? ' slechtste' : '')
                    : '';
                tr += '<td class="bedrag' + cls + '">' + fmtEuro(w) + '</td>';
            });
            return tr + '</tr>';
        }

        function groepHeader(label, icon) {
            const colspan = resultaten.length + 1;
            return '<tr><th colspan="' + colspan + '" class="groep-header"><i class="bx ' + icon + ' me-1"></i>' + label + '</th></tr>';
        }

        let tbody = groepHeader('Bouwkost (activiteiten)', 'bx-buildings');
        tbody += rij('Totaal bouwkost', function (r) { return r.TotaalBouw; }, false);

        const heeftKosten = resultaten.some(function (r) { return r.KostenOpBouw && r.KostenOpBouw.length > 0; });
        if (heeftKosten) {
            tbody += groepHeader('Erelonen & Studies', 'bx-user-check');
            const keys = [...new Set(resultaten.flatMap(function (r) {
                return (r.KostenOpBouw || []).map(function (k) { return k.Omschrijving; });
            }))];
            keys.forEach(function (key) {
                tbody += rij(key, function (r) {
                    const k = (r.KostenOpBouw || []).find(function (x) { return x.Omschrijving === key; });
                    return k ? k.Bedrag : 0;
                }, true);
            });
        }

        const heeftForfaits = resultaten.some(function (r) {
            return r.Forfaits && r.Forfaits.some(function (f) { return f.Bedrag > 0; });
        });
        if (heeftForfaits) {
            tbody += groepHeader('Forfaits', 'bx-list-check');
            const keys = [...new Set(resultaten.flatMap(function (r) {
                return (r.Forfaits || []).filter(function (f) { return f.Bedrag > 0; }).map(function (k) { return k.Omschrijving; });
            }))];
            keys.forEach(function (key) {
                tbody += rij(key, function (r) {
                    const k = (r.Forfaits || []).find(function (x) { return x.Omschrijving === key; });
                    return k ? k.Bedrag : 0;
                }, true);
            });
        }

        const heeftFin = resultaten.some(function (r) {
            return r.Financiering && r.Financiering.some(function (f) { return f.Bedrag > 0; });
        });
        if (heeftFin) {
            tbody += groepHeader('Financiering', 'bx-euro');
            const keys = [...new Set(resultaten.flatMap(function (r) {
                return (r.Financiering || []).filter(function (f) { return f.Bedrag > 0; }).map(function (k) { return k.Omschrijving; });
            }))];
            keys.forEach(function (key) {
                tbody += rij(key, function (r) {
                    const k = (r.Financiering || []).find(function (x) { return x.Omschrijving === key; });
                    return k ? k.Bedrag : 0;
                }, true);
            });
        }

        tbody += groepHeader('Onvoorzien', 'bx-question-mark');
        tbody += rij('Onvoorzien', function (r) { return r.Onvoorzien; }, true);

        // Totaalrij
        const totalen = resultaten.map(function (r) { return r.TotaalKosten || 0; });
        const minTot  = Math.min(...totalen);
        const maxTot  = Math.max(...totalen);
        let totaalRij = '<tr class="totaal-row"><td>TOTALE KOSTPRIJS</td>';
        totalen.forEach(function (t) {
            const cls = totalen.length > 1
                ? (t === minTot && minTot !== maxTot ? ' beste' : t === maxTot && minTot !== maxTot ? ' slechtste' : '')
                : '';
            totaalRij += '<td class="bedrag' + cls + '">' + fmtEuro(t) + '</td>';
        });
        totaalRij += '</tr>';

        let eenheidRij = '<tr><td class="fw-semibold">Per eenheid</td>';
        resultaten.forEach(function (r) { eenheidRij += '<td class="bedrag">' + fmtEuro(r.TotaalPerEenheid) + '</td>'; });
        eenheidRij += '</tr>';

        let m2Rij = '<tr><td class="fw-semibold">Per m² GBA</td>';
        resultaten.forEach(function (r) { m2Rij += '<td class="bedrag">' + fmtEuro(r.TotaalPerM2GBA) + '</td>'; });
        m2Rij += '</tr>';

        $('#vergelijkBody').html(tbody + totaalRij + eenheidRij + m2Rij);
    }
</script>
}
