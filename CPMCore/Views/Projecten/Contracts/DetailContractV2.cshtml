@* ── Gsm (design-handoff 64i): kopkaart met icoon, naam, wat het is en de stand. De projecttabs vervallen: dit is een niveau dieper (terug = leverancierslijst). ── *@
@{
    var heroLots = Model.Contracts.Sum(c => c.Activities?.Count ?? 0);
    var heroFirstLot = Model.Contracts.SelectMany(c => c.Activities ?? new List<ContractActivityBO>()).Select(a => a.Activity?.Name).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n));
    var heroSent = Model.Contracts.Where(c => c.ContractSentDate.HasValue).Select(c => c.ContractSentDate!.Value).OrderBy(d => d).Cast<DateTime?>().FirstOrDefault();
    var heroTotalPrice = Model.Contracts.Sum(c => c.Activities?.Sum(a => a.EffectivePrice) ?? 0m);
    var heroBilled = invoices.Where(i => InvGroup(i) != "afgekeurd").Sum(i => i.InvoicePrice);
    var heroOverPct = heroTotalPrice > 0m && heroBilled > heroTotalPrice ? (int)Math.Round((heroBilled - heroTotalPrice) / heroTotalPrice * 100m, 0) : 0;
}
<div class="gl-v2-m-hero gl-v2-m-only">
    <span class="gl-v2-m-hero-ic"><i class="ph ph-hard-hat" aria-hidden="true"></i></span>
