        <a href="#" class="gl-v2-mobile-quickaction" aria-disabled="true" data-off-message="@(qaMissingPid ? "Geen e-mailadres om attesten op te vragen" : "Alle attesten zijn in orde")" data-qa-key="attest"><i class="ph ph-shield-check" aria-hidden="true"></i>Attest</a>
