        <a href="@qaEdit" class="gl-v2-mobile-quickaction gl-v2-mobile-quickaction-extra" data-subtitle="betaaltermijn, korting, waarborg"><i class="ph ph-scales" aria-hidden="true"></i>Voorwaarden bewerken</a>
    }
