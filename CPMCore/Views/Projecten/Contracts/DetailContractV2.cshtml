@model CPMCore.Models.Projecten.ProjectContractDetailModel
@using System.Globalization
@using BOCore
@using CPMCore.Helpers
@using CPMCore.Models.GlV2
@*
    gl-v2 layout-pilot (design-handoff/CRM Menu Wireframes.dc.html, punt 14b "Contractdetail — wat
    ontbreekt bovenaan, voorwaarden en attesten naast elkaar"). Shared by TWO controller actions —
    exactly like the legacy DetailContract.cshtml it replaces: ProjectenController.DetailContract
    (entered via a specific contractid) and .DetailSupplier (entered via a companyid, no contract
    pre-selected — e.g. the "geen contract" rows on DetailContractsV2). Both already loaded the same
    ProjectContractDetailModel and rendered the same legacy view, so the gl-v2 replacement follows
    suit rather than forking into two pages the controller never actually forked.

    14b's own layout assumes exactly one contract; the real data can have zero (no contract yet) or
    several (e.g. "Fluvius System Operator — 3 contracten" on 14a). Extended faithfully: zero renders
    an empty state with a real "Contract toevoegen" action, more than one renders design-handoff 14e's
    own variant — a collapsible panel per contract instead of a repeated card stack, see the 14e note
    further down — not a fabricated "pick one" UI 14b never designed for.

    Scope trims from 14b, disclosed rather than silently built as dead ends:
    - Tabbladen Facturen, Leverancier en Portaaltoegang (14f, 14g, 14h) zijn gebouwd, 16/11/2026: vier
      panelen in dezelfde pagina (.gl-v2-pcd-panel, de tabbar wisselt enkel welk paneel zichtbaar is,
      gekozen tab in de url-hash). Enkel wat uit bestaande tabellen komt is gebouwd. NIET gebouwd, want
      er bestaat geen opslag of bron voor: zijpaneel met het factuurverloop (een factuur opent de
      bestaande factuurpagina), gemiddelde betaaltermijn en benutte korting (geen betaaldatum),
      inhoudingsplicht op de lijst, IBAN/BIC/Peppol/KBO-controles/historiek op Leverancier,
      contactpersoon-tags Contract/Facturen/Attesten, "Wat de leverancier ziet" per project, de
      toegangsactiviteit en de portaallink. Leverancier bewerken en uitnodigen/intrekken gebruiken de
      bestaande LeveranciersController-acties (met returnUrl terug naar dit tabblad).
    - "Bijbestelling toevoegen" (14b's own "+ Bijbestelling" action on Loten & bijbestellingen) isn't
      wired here — that's the shared Partials/_BijbestellingModal + its AJAX endpoints
      (AddContractAdditionalOrder), left legacy-styled for a future pass rather than getting a one-off
      gl-v2 reskin on a page whose own primary action is EditContractV2 (which DOES need full
      lot/bijbestelling editing, and gets it — see that page's own notes).
    - "Herinnering sturen" (14b's secondary topbar action + its "Vraagt actie" row) has no dedicated
      backend action anywhere in this codebase — no reminder-email endpoint exists to call. Rather
      than invent one or silently drop the action, it's a real mailto: to the company's own e-mail
      address (same "real data, no invented backend" choice already used for Klanten/DetailV2's
      contact actions), shown only when that address is actually on file.
    - "Opvragen" (PID-attesten ontbrekende) — same reasoning, same mailto: treatment.
    - "Leveranciers"-teller (ItemCounts) op het inner menu: DetailContract/DetailSupplier/EditContract
      berekenen nu zelf hetzelfde aantal als DetailContractsV2's SupplierRows.Count
      (ProjectenController.GetProjectSupplierCount, hergebruikt de contractenlijst die deze actie toch
      al ophaalt) via een nieuwe Model.SupplierCount — geen tweede round-trip nodig.

    Bij meerdere contracten (design-handoff 14e, "Variant van 14b — één leverancier, meerdere
    contracten, lijst met uitklapbaar contract"): elk contract is nu een collapsible paneel i.p.v. een
    kaartenstapel die gewoon herhaalt. Sortering per 14e regel 6: niet-getekend eerst (oudst verstuurd
    boven), dan getekend — een "afgerond"-status bestaat niet in ContractBO, dus die derde 14e-groep
    is hier niet gebouwd (geen verzonnen veld). Het eerste contract in die volgorde staat open, de rest
    dicht (14e's eigen "één open, twee gesloten" voorbeeld) — bij precies één contract blijft de pagina
    exact 14b (geen paneel, meteen open), per 14e regel 7.
*@
@{
    var company = Model.Company;
    var companyName = !string.IsNullOrWhiteSpace(company?.Bedrijfsnaam) ? company.Bedrijfsnaam : (Model.Contract?.Company?.Display ?? "Leverancier");
    ViewData["Title"] = companyName;
    ViewData["PageIcon"] = "ph ph-hard-hat";
    ViewData["GlV2FullHeightBody"] = true;
    ViewData["BackUrl"] = Url.Action("DetailContracts", "Projecten", new { projectid = Model.ProjectId });
    // Mobiele componenten 65b/64i: kicker "Contract · projectnaam", titel = leverancier, de stand staat in de kopkaart.
    ViewData["TopbarKicker"] = "Contract · " + Model.ProjectName;
    ViewData["BadgesDesktopOnly"] = true;
    ViewData["QuickActionsMoreTitle"] = "contract";

    var be = CultureInfo.GetCultureInfo("nl-BE");
    var canWrite = ViewBag.CanWriteProjectSuppliers as bool? ?? false;
    var canDelete = ViewBag.CanDeleteProjectSuppliers as bool? ?? false;
    var invoiceCount = Model.IncommingInvoices?.Count ?? 0;

    var menuVm = new GlV2ProjectMenuVm
    {
        ProjectId = Model.ProjectId,
        ProjectName = Model.ProjectName,
        ProjectSubtitle = "leverancier · " + companyName,
        ItemCounts = new Dictionary<string, int> { ["Leveranciers"] = Model.SupplierCount }
    };

    var allSigned = Model.Contracts.Any() && Model.Contracts.All(c => c.ContractSigned);

    // 14e regel 6: niet-getekend eerst (oudst verstuurd boven), dan getekend. "Afgerond" bestaat niet
    // als apart veld op ContractBO, dus die derde 14e-groep wordt hier niet nagebouwd.
    var sortedContracts = Model.Contracts
        .OrderBy(c => c.ContractSigned)
        .ThenBy(c => c.ContractSentDate ?? DateTime.MinValue)
        .ToList();
    var isMultiContract = sortedContracts.Count > 1;

    // ── Tabblad Facturen (design-handoff 14f): alles uit de inkomende facturen van deze leverancier in dit project ──
    var vandaag = DateOnly.FromDateTime(DateTime.Today);
    var invoices = (Model.IncommingInvoices ?? new List<IncommingInvoiceBO>())
        .OrderByDescending(i => i.IncommingInvoiceDate).ThenByDescending(i => i.Id).ToList();
    // Eén status per factuur: te controleren · goedgekeurd · betaald (afgekeurd en duplicaten tellen nergens mee).
    string InvGroup(IncommingInvoiceBO i) =>
        i.StatusId == IncomingInvoiceStatus.Paid ? "betaald"
        : (i.StatusId == IncomingInvoiceStatus.Approved || i.StatusId == IncomingInvoiceStatus.Booked) ? "goedgekeurd"
        : (i.StatusId == IncomingInvoiceStatus.Rejected || i.StatusId == IncomingInvoiceStatus.Duplicate) ? "afgekeurd"
        : "controle";
    var countedInvoices = invoices.Where(i => InvGroup(i) != "afgekeurd").ToList();
    var invBilled = countedInvoices.Sum(i => i.InvoicePrice);
    var invPaid = countedInvoices.Where(i => InvGroup(i) == "betaald").Sum(i => i.InvoicePrice);
    var invApproved = countedInvoices.Where(i => InvGroup(i) == "goedgekeurd").ToList();
    var invApprovedSum = invApproved.Sum(i => i.InvoicePrice);
    var invReviewCount = countedInvoices.Count(i => InvGroup(i) == "controle");
    var invReviewSum = countedInvoices.Where(i => InvGroup(i) == "controle").Sum(i => i.InvoicePrice);
    var invPaidCount = countedInvoices.Count(i => InvGroup(i) == "betaald");
    var invNextDue = invApproved.Where(i => i.DueDate.HasValue).OrderBy(i => i.DueDate).Select(i => i.DueDate).FirstOrDefault();
    var invContractTotal = Model.Contracts.Sum(c => c.Activities?.Sum(a => a.EffectivePrice) ?? 0m);
    var invExtraTotal = Model.Contracts.Sum(c => c.Activities?.Sum(a => a.AdditionalOrdersTotal) ?? 0m);
    var invRest = invContractTotal > 0m ? Math.Max(0m, invContractTotal - invBilled) : 0m;
    var invPct = invContractTotal > 0m ? Math.Min(100m, Math.Round(invBilled / invContractTotal * 100m, 0)) : 0m;
    string InvUrl(IncommingInvoiceBO i) => Url.Action("IncommingInvoiceDetail", "Projecten", new { projectid = Model.ProjectId, invoiceid = i.Id });
    string InvNr(IncommingInvoiceBO i) => string.IsNullOrWhiteSpace(i.InvoiceExternalId) ? "zonder nummer" : i.InvoiceExternalId;

    // Korting contant per factuur, uit het contract van die factuur: (vervaldatum van de korting, bedrag).
    (DateOnly Date, decimal Amount)? InvDiscount(IncommingInvoiceBO i)
    {
        if (InvGroup(i) is "betaald" or "afgekeurd") return null;
        var c = Model.Contracts.FirstOrDefault(x => x.Id == i.ContractID);
        if (c == null || !c.CashDiscount || (c.CashDiscountPercentage ?? 0m) <= 0m || (c.CashDiscountPaymentTerm ?? 0m) <= 0m) return null;
        return (i.IncommingInvoiceDate.AddDays((int)c.CashDiscountPaymentTerm!.Value), Math.Round(i.InvoicePrice * c.CashDiscountPercentage!.Value / 100m, 2));
    }

    // "Vraagt actie" bij de facturen (zelfde kaart als Projecten/Detail): wat je moet doen vóór de volgende betaling.
    var invAttention = new GlV2VraagtActieVm { Subtitle = "Wat je moet doen vóór de volgende betaling." };
    foreach (var i in countedInvoices.Where(i => InvGroup(i) == "goedgekeurd" && i.DueDate.HasValue && i.DueDate.Value < vandaag))
    {
        var late = vandaag.DayNumber - i.DueDate!.Value.DayNumber;
        invAttention.Items.Add(new GlV2VraagtActieItem
        {
            Severity = "u", Type = "Factuur vervallen", Entiteit = InvNr(i), Icon = "ph-calendar-x", Categorie = "Betaling", BekijkUrl = InvUrl(i),
            Extra = i.InvoicePrice.ToString("C2", be) + " excl. btw, vervaldag " + i.DueDate.Value.ToString("dd/MM/yyyy", be), Meta = $"{late} dag{(late == 1 ? "" : "en")} te laat"
        });
    }
    foreach (var i in countedInvoices)
    {
        var disc = InvDiscount(i);
        if (disc is null) continue;
        var left = disc.Value.Date.DayNumber - vandaag.DayNumber;
        if (left is >= 0 and <= 7)
        {
            invAttention.Items.Add(new GlV2VraagtActieItem
            {
                Severity = left <= 2 ? "u" : "a", Type = "Korting contant vervalt", Entiteit = InvNr(i), Icon = "ph-percent", Categorie = "Korting", BekijkUrl = InvUrl(i),
                Extra = disc.Value.Amount.ToString("C2", be) + " korting tot " + disc.Value.Date.ToString("dd/MM/yyyy", be), Meta = left == 0 ? "vandaag" : "nog " + left + " dag" + (left == 1 ? "" : "en")
            });
        }
    }
    foreach (var i in countedInvoices.Where(i => InvGroup(i) == "controle"))
    {
        invAttention.Items.Add(new GlV2VraagtActieItem
        {
            Severity = "a", Type = "Factuur te controleren", Entiteit = InvNr(i), Icon = "ph-magnifying-glass", Categorie = "Controle", BekijkUrl = InvUrl(i),
            Extra = i.InvoicePrice.ToString("C2", be) + " excl. btw wacht op goedkeuring", Meta = i.IncommingInvoiceDate.ToString("dd/MM/yyyy", be)
        });
    }
    // Inhoudingsplicht (art. 30bis/30ter): staat die op "inhouden", dan moet je dat bij de betaling doen. Nooit gecontroleerd en er staat nog iets te betalen: eerst controleren.
    var retLast = Model.LastRetainment;
    if (retLast != null && retLast.HasObligation)
    {
        var retParts = new List<string>();
        if (retLast.SocialObligation) retParts.Add(retLast.SocialWithholdingPercentage + " % sociale schulden");
        if (retLast.FiscalObligation) retParts.Add(retLast.FiscalWithholdingPercentage + " % fiscale schulden");
        invAttention.Items.Add(new GlV2VraagtActieItem
        {
            Severity = "u", Type = "Inhoudingsplicht", Icon = "ph-shield-warning", Categorie = "Betaling", BekijkUrl = "#leverancier",
            Extra = "bij betaling inhouden: " + string.Join(" en ", retParts), Meta = "gecontroleerd " + retLast.CheckedAt.ToLocalTime().ToString("dd/MM/yyyy", be)
        });
    }
    else if (retLast == null && Model.RetainmentConfigured && Model.RetainmentHasIdentifier && invApproved.Any())
    {
        invAttention.Items.Add(new GlV2VraagtActieItem
        {
            Severity = "a", Type = "Inhoudingsplicht nog niet gecontroleerd", Icon = "ph-shield-check", Categorie = "Betaling", BekijkUrl = "#leverancier",
            Extra = "controleer vóór je " + invApproved.Count + " goedgekeurde factu" + (invApproved.Count == 1 ? "ur" : "ren") + " betaalt"
        });
    }
    invAttention.Categories = invAttention.Items.Select(x => x.Categorie).Distinct().ToList();
    if (invAttention.Categories.Count < 2) { invAttention.Categories.Clear(); }

    // Waarborg per contract (rechterkolom van het tabblad Facturen).
    var guaranteeContracts = Model.Contracts.Where(c => c.GuaranteeType != ContractGuaranteeType.NoGuarantee).ToList();

    // ── Tabbladen Leverancier en Portaaltoegang (design-handoff 14g/14h) ──
    string PortalLabel(string status) => status switch
    {
        "Draft" => "Concept", "Invited" => "Uitgenodigd", "PendingAcceptance" => "In afwachting", "Redeemed" => "Ingewisseld",
        "Active" => "Actief", "Failed" => "Mislukt", "Revoked" => "Ingetrokken", _ => ""
    };
    string PortalTone(string status) => status switch
    {
        "Invited" or "PendingAcceptance" => "is-attention", "Redeemed" or "Active" => "is-positive", "Failed" => "is-blocked", "Revoked" => "is-inactive", _ => "is-neutral"
    };
    // Na uitnodigen of intrekken terug op dit tabblad (enkel een lokale url wordt gevolgd, zie LeveranciersController.BackToSupplier).
    var returnTo = Context.Request.Path.Value + Context.Request.QueryString.Value + "#portaaltoegang";
    var withPortal = Model.Contacts.Count(c => c.LinkedUserId.HasValue && (c.PortalStatus == "Active" || c.PortalStatus == "Redeemed"));
    var contactsWithMail = Model.Contacts.Count(c => !string.IsNullOrWhiteSpace(c.Email));
    var companyAddress = string.Join(", ", new[]
    {
        string.Join(" ", new[] { company?.Straat, company?.Huisnummer }.Where(s => !string.IsNullOrWhiteSpace(s))) + (string.IsNullOrWhiteSpace(company?.Busnummer) ? "" : " bus " + company.Busnummer),
        string.Join(" ", new[] { company?.Postcode?.Postcode, company?.Postcode?.Gemeente }.Where(s => !string.IsNullOrWhiteSpace(s)))
    }.Where(s => !string.IsNullOrWhiteSpace(s)));
    var otherContractRows = Model.OtherContracts;
    var otherProjects = otherContractRows.Select(c => c.ProjectId).Distinct().Count();

    string FmtPaymentTerm(ContractBO c) => c.PaymentTerm is null ? "—" : $"{c.PaymentTerm:0} dagen";
    string FmtCashDiscount(ContractBO c) => c.CashDiscount
        ? $"{c.CashDiscountPercentage?.ToString("N2", be)} % binnen {c.CashDiscountPaymentTerm:0} dagen"
        : "—";
    string FmtGuarantee(ContractBO c) => c.GuaranteeType == ContractGuaranteeType.FinancialGuarantee
        ? $"{c.GuaranteePercentage?.ToString("N2", be)} % {c.GuaranteeType.GetDisplayName()}"
        : c.GuaranteeType.GetDisplayName();
    string ReminderMailto(ContractBO c, string subject) => !string.IsNullOrWhiteSpace(company?.Email)
        ? $"mailto:{company.Email}?subject={Uri.EscapeDataString(subject)}"
        : null;

    // 14b's kaartenstapel voor één contract (KPI-rij, Vraagt actie, Voorwaarden, Veiligheid &
    // attesten, Loten & bijbestellingen) — een lokale functie zodat exact dezelfde markup zowel
    // los (1 contract, 14e regel 7) als binnen een collapsible paneel (>1 contract) gerenderd kan
    // worden, zonder de inhoud te dupliceren of tags over losse @@if-blokken heen te splitsen.
    void RenderContractBody(ContractBO contract)
    {
        var sentDaysOpen = contract.ContractSentDate.HasValue && !contract.ContractSigned
            ? (int)(DateTime.Today - contract.ContractSentDate.Value).TotalDays
            : (int?)null;
        var contractPrice = contract.Activities?.Sum(a => a.EffectivePrice) ?? 0m;
        var missingSiteManager = !contract.SiteManagerContactId.HasValue || contract.SiteManagerContactId == 0;
        var lotCount = contract.Activities?.Count ?? 0;
        var siteManager = !missingSiteManager && Model.SiteManagers.TryGetValue(contract.SiteManagerContactId!.Value, out var smInfo) ? smInfo : null;

        // "Vraagt actie" in dezelfde kaart als Projecten/Detail (partial GlV2/_VraagtActie). Dringend = blokkeert, aandacht = loopt achter of komt eraan.
        var editHref = Url.Action("EditContract", "Projecten", new { projectid = Model.ProjectId, contractid = contract.Id });
        var attention = new GlV2VraagtActieVm { Subtitle = "Wat dit contract tegenhoudt, dringend eerst." };
        if (!contract.ContractSigned)
        {
            var reminderUrl = ReminderMailto(contract, $"Herinnering: contract {companyName} — {Model.ProjectName}");
            attention.Items.Add(new GlV2VraagtActieItem
            {
                Severity = "u", Type = "Contract niet getekend", Icon = "ph-file-text", Categorie = "Contract", BekijkUrl = reminderUrl,
                Extra = (contract.ContractSentDate.HasValue ? "verstuurd op " + contract.ContractSentDate.Value.ToString("dd/MM/yyyy", be) : "nog niet verstuurd") + (reminderUrl != null ? " · klik om een herinnering te mailen" : ""),
                Meta = sentDaysOpen.HasValue ? sentDaysOpen + " dagen open" : null
            });
        }
        if (contract.GuaranteeDocumentMissing && canWrite)
        {
            attention.Items.Add(new GlV2VraagtActieItem { Severity = "u", Type = "Bankwaarborg ontbreekt", Icon = "ph-shield-warning", Categorie = "Contract", Extra = "het waarborgdocument is nog niet ontvangen", BekijkUrl = editHref });
        }
        if (!contract.PidAttest)
        {
            var pidUrl = ReminderMailto(contract, $"PID-attesten opvragen — {companyName}, {Model.ProjectName}");
            attention.Items.Add(new GlV2VraagtActieItem { Severity = "a", Type = "PID-attesten ontbreken", Icon = "ph-shield-warning", Categorie = "Attesten", BekijkUrl = pidUrl, Extra = "nodig vóór oplevering" + (pidUrl != null ? " · klik om ze op te vragen" : "") });
        }
        if (missingSiteManager && canWrite)
        {
            attention.Items.Add(new GlV2VraagtActieItem { Severity = "a", Type = "Geen verantwoordelijke werfleider", Icon = "ph-hard-hat", Categorie = "Werf", Extra = "nodig voor werfpunten en verslagen", BekijkUrl = editHref });
        }
        attention.Categories = attention.Items.Select(i => i.Categorie).Distinct().ToList();
        if (attention.Categories.Count < 2) { attention.Categories.Clear(); }

        <span class="gl-v2-pcd-meta">
            Leverancier @companyName
            · @lotCount lot@(lotCount == 1 ? "" : "en")
            @if (contract.ContractSentDate.HasValue)
            {
                <text> · verstuurd @contract.ContractSentDate.Value.ToString("dd/MM/yyyy", be)</text>
            }
            · werfleider @(missingSiteManager ? "nog niet toegewezen" : "toegewezen")
        </span>

        <div class="gl-v2-pcd-stats">
            <div class="gl-v2-pcd-stat">
                <span class="gl-v2-pcd-stat-label">CONTRACTPRIJS</span>
                <span class="gl-v2-pcd-stat-value">@contractPrice.ToString("C2", be)</span>
                <span class="gl-v2-pcd-stat-sub">@lotCount lot@(lotCount == 1 ? "" : "en")@(contract.Activities?.Any(a => a.AdditionalOrders.Any()) == true ? " · bijbestellingen" : " · geen bijbestellingen")</span>
            </div>
            <div class="gl-v2-pcd-stat">
                <span class="gl-v2-pcd-stat-label">BETAALTERMIJN</span>
                <span class="gl-v2-pcd-stat-value">@FmtPaymentTerm(contract)</span>
                <span class="gl-v2-pcd-stat-sub">@(contract.CashDiscount ? "korting " + FmtCashDiscount(contract) : "geen korting contant")</span>
            </div>
            <div class="gl-v2-pcd-stat">
                <span class="gl-v2-pcd-stat-label">WAARBORG</span>
                <span class="gl-v2-pcd-stat-value">@(contract.GuaranteeType == ContractGuaranteeType.FinancialGuarantee ? contract.GuaranteePercentage?.ToString("0.##", be) + " %" : contract.GuaranteeType.GetDisplayName())</span>
                <span class="gl-v2-pcd-stat-sub">@contract.GuaranteeType.GetDisplayName()</span>
            </div>
            <div class="gl-v2-pcd-stat">
                <span class="gl-v2-pcd-stat-label">@(contract.ContractSigned ? "GETEKEND" : "OPEN SINDS")</span>
                @if (contract.ContractSigned)
                {
                    <span class="gl-v2-pcd-stat-value">@(contract.ContractSentDate?.ToString("dd/MM/yyyy", be) ?? "—")</span>
                    <span class="gl-v2-pcd-stat-sub">contract getekend</span>
                }
                else
                {
                    <span class="gl-v2-pcd-stat-value @(sentDaysOpen.HasValue ? "is-warning" : "")">@(sentDaysOpen.HasValue ? sentDaysOpen + " dagen" : "—")</span>
                    <span class="gl-v2-pcd-stat-sub">@(contract.ContractSentDate.HasValue ? "verstuurd, nog niet getekend" : "nog niet verstuurd")</span>
                }
            </div>
        </div>

        @if (attention.Items.Any())
        {
            @Html.Partial("GlV2/_VraagtActie", attention)
        }

        <div class="gl-v2-pcd-grid">
            <div class="gl-v2-section-card">
                <div class="gl-v2-section-card-header">
                    <span class="gl-v2-section-card-icon"><i class="ph ph-scales" aria-hidden="true"></i></span>
                    <h2 class="gl-v2-section-card-title">Voorwaarden</h2>
                </div>
                <div class="gl-v2-detail-grid gl-v2-pcd-2col" style="padding:16px 18px">
                    <div class="gl-v2-detail-field">
                        <span class="gl-v2-detail-label">BTW</span>
                        <span class="gl-v2-detail-value">@(contract.VatPercentage?.ToString("N2", be) ?? "0,00") %</span>
                        @if ((contract.VatPercentage ?? 0m) == 0m)
                        {
                            <span class="gl-v2-pcd-sm-hint">verlegd</span>
                        }
                    </div>
                    <div class="gl-v2-detail-field">
                        <span class="gl-v2-detail-label">Betaaltermijn</span>
                        <span class="gl-v2-detail-value">@FmtPaymentTerm(contract)</span>
                    </div>
                    <div class="gl-v2-detail-field">
                        <span class="gl-v2-detail-label">Korting contant</span>
                        <span class="gl-v2-detail-value@(contract.CashDiscount ? "" : " is-empty")">@FmtCashDiscount(contract)</span>
                    </div>
                    <div class="gl-v2-detail-field">
                        <span class="gl-v2-detail-label">Waarborg</span>
                        <span class="gl-v2-detail-value">@FmtGuarantee(contract)</span>
                    </div>
                    <div class="gl-v2-detail-field">
                        <span class="gl-v2-detail-label">Contract verstuurd</span>
                        <span class="gl-v2-detail-value@(contract.ContractSentDate.HasValue ? "" : " is-empty")">@(contract.ContractSentDate?.ToString("dd/MM/yyyy", be) ?? "—")</span>
                    </div>
                    <div class="gl-v2-detail-field">
                        <span class="gl-v2-detail-label">Opmerking verzending</span>
                        <span class="gl-v2-detail-value@(string.IsNullOrWhiteSpace(contract.ContractSentNote) ? " is-empty" : "")">@(string.IsNullOrWhiteSpace(contract.ContractSentNote) ? "—" : contract.ContractSentNote)</span>
                    </div>
                </div>
            </div>

            @* Werfleider aannemer (design-handoff 14i): naam, functie, gsm en e-mail om meteen te gebruiken. *@
            <div class="gl-v2-section-card">
                <div class="gl-v2-section-card-header">
                    <span class="gl-v2-section-card-icon"><i class="ph ph-hard-hat" aria-hidden="true"></i></span>
                    <h2 class="gl-v2-section-card-title">Werfleider aannemer</h2>
                    <span class="gl-v2-section-card-spacer"></span>
                    @if (canWrite && siteManager is not null)
                    {
                        <a href="@Url.Action("EditContract", "Projecten", new { projectid = Model.ProjectId, contractid = contract.Id })" class="gl-v2-card-header-action">Wijzigen</a>
                    }
                </div>
