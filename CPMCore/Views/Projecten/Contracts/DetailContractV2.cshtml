}
else
{
    RenderContractBody(sortedContracts[0]);
}
</div>
</div>

@* ── Tabblad Facturen (design-handoff 14f) ─────────────────────────────────────────────────────── *@
<div class="gl-v2-pcd-panel" id="gl-v2-pcd-panel-facturen" data-tab-panel="facturen" role="tabpanel" hidden>
<div class="gl-v2-m-only">
@{
    // ── Gsm (design-handoff 64k): kerncijfers, Vraagt actie samengevat, facturen met pillen, tegenover het contract, waarborg ──
    var fToday = vandaag;
    var fReview = countedInvoices.Where(i => InvGroup(i) == "controle").OrderBy(i => i.IncommingInvoiceDate).ToList();
    var fOverdue = countedInvoices.Where(i => InvGroup(i) == "goedgekeurd" && i.DueDate.HasValue && i.DueDate.Value < fToday).ToList();
    var fMissed = countedInvoices.Select(i => new { Inv = i, Disc = InvDiscount(i) }).Where(x => x.Disc.HasValue && x.Disc.Value.Date < fToday && InvGroup(x.Inv) != "betaald").ToList();
    var fMissedSum = fMissed.Sum(x => x.Disc!.Value.Amount);
    var fPctRaw = invContractTotal > 0m ? (int)Math.Round(invBilled / invContractTotal * 100m, 0) : 0;
    var fOver = invContractTotal > 0m && invBilled > invContractTotal;
    var fOverAmt = fOver ? invBilled - invContractTotal : 0m;
    var fVaCount = (fReview.Count > 0 ? 1 : 0) + (fOverdue.Count > 0 ? 1 : 0) + invAttention.Items.Count(x => x.Type.StartsWith("Inhoudingsplicht")) + invAttention.Items.Count(x => x.Type.StartsWith("Korting contant"));
    string FStatus(IncommingInvoiceBO i) => InvGroup(i) switch { "betaald" => "Betaald", "goedgekeurd" => "Goedgekeurd", "afgekeurd" => IncomingInvoiceStatus.Label(i.StatusId), _ => "Te controleren" };
    string FChip(IncommingInvoiceBO i) => InvGroup(i) switch { "betaald" => "is-ok", "goedgekeurd" => "", "afgekeurd" => "", _ => "is-gold" };
    var fOldest = fReview.FirstOrDefault();
}
<div class="gl-v2-m-stack">
    <section class="gl-v2-m-card gl-v2-m-kpi">
        <div><span class="gl-v2-m-k">GEFACTUREERD</span><b>@invBilled.ToString("C0", be)</b><small class="@(fOver ? "is-o" : "")">@(invContractTotal > 0m ? fPctRaw + " % van het contract" : "geen contract")</small></div>
        <div><span class="gl-v2-m-k">BETAALD</span><b>@invPaid.ToString("C0", be)</b><small>@invPaidCount van @countedInvoices.Count factu@(countedInvoices.Count == 1 ? "ur" : "ren")</small></div>
        <div><span class="gl-v2-m-k">TE CONTROLEREN</span><b>@invReviewCount</b><small>@invReviewSum.ToString("C0", be)</small></div>
        <div><span class="gl-v2-m-k">GOEDGEKEURD, OPEN</span><b>@invApprovedSum.ToString("C0", be)</b><small>@(invApproved.Count == 0 ? "niets te betalen" : invApproved.Count + " goedgekeurd" + (invNextDue.HasValue ? " · eerste vervaldag " + invNextDue.Value.ToString("dd/MM", be) : ""))</small></div>
    </section>

    @if (fVaCount > 0)
    {
        <section class="gl-v2-m-va is-gold" aria-label="Vraagt actie">
            <div class="gl-v2-m-va-head">
                <span class="gl-v2-m-va-icon"><i class="ph ph-warning-circle" aria-hidden="true"></i></span>
                <span class="gl-v2-m-va-title"><b>Vraagt actie</b><small>vóór de volgende betaling</small></span>
                <i class="gl-v2-m-va-n">@(invReviewCount + fOverdue.Count)</i>
            </div>
            @if (fReview.Count > 0)
            {
                <div class="gl-v2-m-va-row"><span class="gl-v2-m-va-ico is-gold"><i class="ph ph-magnifying-glass" aria-hidden="true"></i></span><span class="gl-v2-m-rt"><b>@fReview.Count factu@(fReview.Count == 1 ? "ur" : "ren") te controleren</b><small>oudste @fOldest!.IncommingInvoiceDate.ToString("dd/MM/yyyy", be) · @((fToday.DayNumber - fOldest.IncommingInvoiceDate.DayNumber)) dagen</small></span></div>
            }
            @if (fOverdue.Count > 0)
            {
                <div class="gl-v2-m-va-row"><span class="gl-v2-m-va-ico"><i class="ph ph-calendar-x" aria-hidden="true"></i></span><span class="gl-v2-m-rt"><b>@fOverdue.Count factu@(fOverdue.Count == 1 ? "ur" : "ren") vervallen</b><small>@fOverdue.Sum(i => i.InvoicePrice).ToString("C0", be) nog te betalen</small></span></div>
            }
            @foreach (var ret in invAttention.Items.Where(x => x.Type.StartsWith("Inhoudingsplicht")))
            {
                <div class="gl-v2-m-va-row"><span class="gl-v2-m-va-ico is-gold"><i class="ph ph-shield-warning" aria-hidden="true"></i></span><span class="gl-v2-m-rt"><b>@ret.Type</b><small>@ret.Extra</small></span><a class="gl-v2-m-va-act" href="#leverancier">Bekijken</a></div>
            }
            @if (fMissed.Count > 0)
            {
                <div class="gl-v2-m-loss"><i class="ph ph-trend-down" aria-hidden="true"></i><span>Korting contant is bij @(fMissed.Count == invoices.Count(i => InvGroup(i) != "betaald" && InvGroup(i) != "afgekeurd") && fMissed.Count > 1 ? "alle " : "")@fMissed.Count factu@(fMissed.Count == 1 ? "ur" : "ren") verlopen — <b>@fMissedSum.ToString("C0", be) gemist</b>.</span></div>
            }
            @if (fOldest is not null)
            {
                <a class="gl-v2-m-vall" href="@InvUrl(fOldest)">Controle starten (@fReview.Count)<i class="ph ph-caret-right" aria-hidden="true"></i></a>
            }
        </section>
    }

    <section class="gl-v2-m-card" id="gl-v2-m-inv-card">
        <div class="gl-v2-m-card-head"><span class="gl-v2-m-card-icon"><i class="ph ph-receipt" aria-hidden="true"></i></span><b>Facturen</b><span class="gl-v2-m-count">@invoices.Count</span><span class="gl-v2-m-spacer"></span></div>
        @if (invoices.Any())
        {
            <div class="gl-v2-m-card-pills">
                <div class="gl-v2-m-pills" id="gl-v2-m-inv-pills" role="group" aria-label="Filter facturen">
                    <button type="button" class="gl-v2-pill is-active" data-filter="">Alle <span class="gl-v2-pill-count">@invoices.Count</span></button>
                    <button type="button" class="gl-v2-pill" data-filter="controle">Te controleren <span class="gl-v2-pill-count">@invReviewCount</span></button>
                    <button type="button" class="gl-v2-pill" data-filter="goedgekeurd">Te betalen <span class="gl-v2-pill-count">@invApproved.Count</span></button>
                    <button type="button" class="gl-v2-pill" data-filter="betaald">Betaald <span class="gl-v2-pill-count">@invPaidCount</span></button>
                </div>
            </div>
            @foreach (var inv in invoices)
            {
                <a class="gl-v2-m-row" data-m-inv data-group="@InvGroup(inv)" href="@InvUrl(inv)">
                    <span class="gl-v2-m-rt"><code class="gl-v2-m-nr">@InvNr(inv)</code><small>@inv.IncommingInvoiceDate.ToString("dd/MM/yyyy", be) · vervaldag @(inv.DueDate.HasValue ? inv.DueDate.Value.ToString("dd/MM/yyyy", be) : "—")</small></span>
                    <span class="gl-v2-m-amt"><b>@inv.InvoicePrice.ToString("C2", be)</b><i class="gl-v2-m-chip @FChip(inv)">@FStatus(inv)</i></span>
                    <i class="ph ph-caret-right" aria-hidden="true"></i>
                </a>
            }
            <button type="button" class="gl-v2-m-all" id="gl-v2-m-inv-more" hidden>Nog <span></span> facturen<i class="ph ph-caret-down" aria-hidden="true"></i></button>
            <div class="gl-v2-m-total"><span>Totaal @invoices.Count factu@(invoices.Count == 1 ? "ur" : "ren")</span><b>@invBilled.ToString("C2", be)</b></div>
        }
        else
        {
            <div class="gl-v2-m-tip">Zodra @companyName een factuur voor dit project instuurt, staat ze hier.</div>
        }
    </section>

    <section class="gl-v2-m-card">
        <div class="gl-v2-m-card-head"><span class="gl-v2-m-card-icon"><i class="ph ph-scales" aria-hidden="true"></i></span><b>Tegenover het contract</b><span class="gl-v2-m-spacer"></span></div>
        @if (invContractTotal > 0m)
        {
            var fMax = Math.Max(invBilled, invContractTotal);
            var fGreen = fMax > 0m ? Math.Round(Math.Min(invBilled, invContractTotal) / fMax * 100m, 1) : 0m;
            <div class="gl-v2-m-inner">
                <div class="gl-v2-m-ov" role="img" aria-label="@fPctRaw procent van het contract gefactureerd"><span class="gl-v2-m-ovc" style="width:@(fGreen.ToString("0.#", CultureInfo.InvariantCulture))%"></span><span class="gl-v2-m-ovx" style="width:@((fOver ? 100m - fGreen : 0m).ToString("0.#", CultureInfo.InvariantCulture))%"></span></div>
                <div class="gl-v2-m-lg">
                    <span><i class="is-g"></i>Contract @invContractTotal.ToString("C2", be)</span>
                    @if (fOver) { <span><i class="is-o"></i>Boven contract @fOverAmt.ToString("C2", be)</span> }
                    else { <span><i class="is-o"></i>Nog te factureren @invRest.ToString("C2", be)</span> }
                    @if (invExtraTotal > 0m) { <span><i class="is-g"></i>Waarvan bijbestellingen @invExtraTotal.ToString("C2", be)</span> }
                </div>
                @if (fOver)
                {
                    <div class="gl-v2-m-gap"><i class="ph ph-warning-circle" aria-hidden="true"></i><span>@(invExtraTotal > 0m ? "Meer gefactureerd dan het contract inclusief bijbestellingen." : "Meer gefactureerd dan het contract en er is geen bijbestelling.")</span>
                        @if (canWrite && sortedContracts.Any()) { <a href="@Url.Action("EditContract", "Projecten", new { projectid = Model.ProjectId, contractid = sortedContracts[0].Id })">Bijbestelling</a> }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="gl-v2-m-tip">Er is nog geen contract met een prijs, dus er valt niets mee te vergelijken.</div>
        }
    </section>

    <section class="gl-v2-m-card">
        <div class="gl-v2-m-card-head"><span class="gl-v2-m-card-icon"><i class="ph ph-shield-check" aria-hidden="true"></i></span><b>Waarborg</b><span class="gl-v2-m-spacer"></span></div>
        @if (guaranteeContracts.Any())
        {
            foreach (var gc in guaranteeContracts)
            {
                var gcPrice = gc.Activities?.Sum(a => a.EffectivePrice) ?? 0m;
                var gcPct = gc.GuaranteePercentage ?? 0m;
                var gcAmount = Math.Round(gcPrice * gcPct / 100m, 2);
                var gcHeld = countedInvoices.Where(i => i.ContractID == gc.Id && i.BorgInhouden == true).Sum(i => i.BorgBedrag ?? 0m);
                var gcVo = gc.GuaranteeReleaseVOPercentageEffective;
                if (isMultiContract) { <div class="gl-v2-m-contract-name" style="padding:0 14px">@(string.IsNullOrWhiteSpace(gc.ContractName) ? "Contract" : gc.ContractName)</div> }
                <dl class="gl-v2-m-dl gl-v2-m-dl-pad">
                    <div><dt>Soort</dt><dd>@gc.GuaranteeType.GetDisplayName()</dd></div>
                    @if (gcPct > 0m) { <div><dt>Afgesproken</dt><dd>@gcPct.ToString("0.##", be) % · @gcAmount.ToString("C2", be)</dd></div> }
                    @if (gc.GuaranteeType == ContractGuaranteeType.FinancialGuarantee) { <div><dt>Ingehouden</dt><dd>@(gcHeld > 0m ? gcHeld.ToString("C2", be) : "nog niets")</dd></div> }
                    @if (gc.GuaranteeType == ContractGuaranteeType.BankGuarantee)
                    {
                        <div><dt>Document</dt><dd>
                            @if (!string.IsNullOrWhiteSpace(gc.GuaranteeDocFilename)) { <a href="@Url.Action("GuaranteeDoc", "Projecten", new { contractid = gc.Id })" target="_blank" rel="noopener">bekijken</a> }
                            else { <span>nog te ontvangen</span> }
                        </dd></div>
                    }
                    @if (gcPct > 0m) { <div><dt>Vrijgave</dt><dd>@gcVo.ToString("0.##", be) % voorlopige · @((100m - gcVo).ToString("0.##", be)) % definitieve oplevering</dd></div> }
                </dl>
            }
        }
        else
        {
            <div class="gl-v2-m-tip">Voor deze leverancier is geen waarborg afgesproken.</div>
        }
    </section>
</div>
</div>
<div class="gl-v2-d-wrap">
    <span class="gl-v2-pcd-meta">
        Inkomende facturen van @companyName op dit project
        · @invoices.Count factu@(invoices.Count == 1 ? "ur" : "ren")
    </span>

    <div class="gl-v2-pcd-stats">
        <div class="gl-v2-pcd-stat">
            <span class="gl-v2-pcd-stat-label">GEFACTUREERD</span>
            <span class="gl-v2-pcd-stat-value">@invBilled.ToString("C2", be)</span>
            <span class="gl-v2-pcd-stat-sub">@(invContractTotal > 0m ? invPct.ToString("N0", be) + " % van het contract" : "geen contract")</span>
        </div>
        <div class="gl-v2-pcd-stat">
            <span class="gl-v2-pcd-stat-label">BETAALD</span>
            <span class="gl-v2-pcd-stat-value">@invPaid.ToString("C2", be)</span>
            <span class="gl-v2-pcd-stat-sub">@invPaidCount factu@(invPaidCount == 1 ? "ur" : "ren")</span>
        </div>
        <div class="gl-v2-pcd-stat">
            <span class="gl-v2-pcd-stat-label">TE BETALEN</span>
            <span class="gl-v2-pcd-stat-value">@invApprovedSum.ToString("C2", be)</span>
            <span class="gl-v2-pcd-stat-sub">@(invApproved.Count == 0 ? "niets goedgekeurd en open" : invApproved.Count + " goedgekeurd" + (invNextDue.HasValue ? " · eerste vervaldag " + invNextDue.Value.ToString("dd/MM/yyyy", be) : ""))</span>
        </div>
        <div class="gl-v2-pcd-stat">
            <span class="gl-v2-pcd-stat-label">NOG TE FACTUREREN</span>
            <span class="gl-v2-pcd-stat-value">@(invContractTotal > 0m ? invRest.ToString("C2", be) : "—")</span>
            <span class="gl-v2-pcd-stat-sub">@(invContractTotal > 0m ? (100m - invPct).ToString("N0", be) + " % van het contract" : "geen contract om mee te vergelijken")</span>
        </div>
    </div>

    @if (invAttention.Items.Any())
    {
        @await Html.PartialAsync("GlV2/_VraagtActie", invAttention)
    }

    <div class="gl-v2-pcd-split">
        <div class="gl-v2-section-card gl-v2-pcd-inv-card">
            <div class="gl-v2-section-card-header">
                <span class="gl-v2-section-card-icon"><i class="ph ph-receipt" aria-hidden="true"></i></span>
                <h2 class="gl-v2-section-card-title">Facturen</h2>
                <span class="gl-v2-field-divider"></span>
                <span class="gl-v2-section-card-desc">Klik op een factuur voor het verloop en de betaling.</span>
            </div>
            @if (invoices.Any())
            {
                <div class="gl-v2-pcd-inv-toolbar">
                    <div class="gl-v2-segmented is-sm js-gl-v2-pcd-inv-filter" role="group" aria-label="Filter facturen">
                        <button type="button" class="is-active" data-filter="alle">Alles <span class="gl-v2-pcd-inv-count">@invoices.Count</span></button>
                        <button type="button" data-filter="open">Open <span class="gl-v2-pcd-inv-count">@invoices.Count(i => InvGroup(i) is "controle" or "goedgekeurd")</span></button>
                        <button type="button" data-filter="betaald">Betaald <span class="gl-v2-pcd-inv-count">@invPaidCount</span></button>
                    </div>
                </div>
                <div class="gl-v2-pcd-inv-table">
                    <div class="gl-v2-pcd-inv-row gl-v2-pcd-inv-head">
                        <span>Factuur</span><span>Datum</span><span>Vervaldag</span><span class="text-end">Bedrag excl. btw</span><span class="text-end">Korting</span><span>Status</span>
                    </div>
                    @foreach (var inv in invoices)
                    {
                        var group = InvGroup(inv);
                        var disc = InvDiscount(inv);
                        var overdue = group == "goedgekeurd" && inv.DueDate.HasValue && inv.DueDate.Value < vandaag;
                        var contractOfInvoice = Model.Contracts.FirstOrDefault(c => c.Id == inv.ContractID);
                        var kindText = inv.Kind.HasValue ? inv.Kind.Value.GetDisplayName() : "Factuur";
                        <a href="@InvUrl(inv)" class="gl-v2-pcd-inv-row js-gl-v2-pcd-inv-row" data-group="@(group == "betaald" ? "betaald" : group == "afgekeurd" ? "afgekeurd" : "open")">
                            <span class="gl-v2-pcd-inv-nr">
                                <b>@InvNr(inv)</b>
                                <small>@kindText@(isMultiContract && contractOfInvoice != null ? " · " + (string.IsNullOrWhiteSpace(contractOfInvoice.ContractName) ? "Contract" : contractOfInvoice.ContractName) : "")</small>
                            </span>
                            <span class="gl-v2-pcd-inv-date" data-label="Datum">@inv.IncommingInvoiceDate.ToString("dd/MM/yyyy", be)</span>
                            <span class="gl-v2-pcd-inv-date @(overdue ? "is-late" : "")" data-label="Vervaldag">@(inv.DueDate.HasValue ? inv.DueDate.Value.ToString("dd/MM/yyyy", be) : "—")</span>
                            <span class="text-end gl-v2-pcd-inv-amount" data-label="Bedrag">@inv.InvoicePrice.ToString("C2", be)</span>
                            <span class="text-end gl-v2-pcd-inv-discount @(disc.HasValue && disc.Value.Date < vandaag ? "is-late" : "")" data-label="Korting">@(disc.HasValue ? (disc.Value.Date < vandaag ? "verlopen" : "−" + disc.Value.Amount.ToString("C2", be) + " tot " + disc.Value.Date.ToString("dd/MM", be)) : "—")</span>
                            <span class="gl-v2-pcd-inv-status">
                                @switch (group)
                                {
                                    case "betaald":
                                        <span class="gl-v2-badge is-positive"><i class="ph ph-check-circle" aria-hidden="true"></i>BETAALD</span>
                                        break;
                                    case "goedgekeurd":
                                        <span class="gl-v2-badge is-info"><i class="ph ph-seal-check" aria-hidden="true"></i>GOEDGEKEURD</span>
                                        break;
                                    case "afgekeurd":
                                        <span class="gl-v2-badge is-inactive">@IncomingInvoiceStatus.Label(inv.StatusId).ToUpperInvariant()</span>
                                        break;
                                    default:
                                        <span class="gl-v2-badge is-attention"><i class="ph ph-magnifying-glass" aria-hidden="true"></i>TE CONTROLEREN</span>
                                        break;
                                }
                            </span>
                        </a>
                    }
                    <div class="gl-v2-pcd-inv-row gl-v2-pcd-inv-total">
                        <span>Totaal</span><span></span><span></span>
                        <span class="text-end gl-v2-pcd-inv-amount">@invBilled.ToString("C2", be)</span>
                        <span></span><span></span>
                    </div>
                </div>
            }
            else
            {
                <div class="gl-v2-empty-state gl-v2-empty-state-inline">
                    <span class="gl-v2-empty-state-icon"><i class="ph ph-receipt" aria-hidden="true"></i></span>
                    <h3 class="gl-v2-empty-state-title">Nog geen facturen</h3>
                    <p class="gl-v2-empty-state-desc">Zodra @companyName een factuur voor dit project instuurt, staat ze hier.</p>
                </div>
            }
        </div>

        <div class="gl-v2-pcd-side">
            <div class="gl-v2-section-card">
                <div class="gl-v2-section-card-header">
                    <span class="gl-v2-section-card-icon"><i class="ph ph-scales" aria-hidden="true"></i></span>
                    <h2 class="gl-v2-section-card-title">Tegenover het contract</h2>
                </div>
                @if (invContractTotal > 0m)
                {
                    <div class="gl-v2-pcd-side-body">
                        <div class="gl-v2-pcd-side-line"><span>Contractprijs</span><b>@invContractTotal.ToString("C2", be)</b></div>
                        <div class="gl-v2-pcd-bar" role="img" aria-label="@invPct.ToString("N0", be) procent gefactureerd"><i style="width:@(invPct.ToString("0", CultureInfo.InvariantCulture))%"></i></div>
                        <div class="gl-v2-pcd-side-line"><span>Gefactureerd · @invPct.ToString("N0", be) %</span><b>@invBilled.ToString("C2", be)</b></div>
                        <div class="gl-v2-pcd-side-line"><span>Nog te factureren</span><b>@invRest.ToString("C2", be)</b></div>
                        @if (invExtraTotal > 0m)
                        {
                            <div class="gl-v2-pcd-side-line is-soft"><span>Waarvan bijbestellingen</span><b>@invExtraTotal.ToString("C2", be)</b></div>
                        }
                        @if (invBilled > invContractTotal)
                        {
                            <span class="gl-v2-pcd-sm-hint">Er is meer gefactureerd dan de contractprijs. Controleer of er een bijbestelling ontbreekt.</span>
                        }
                    </div>
                }
                else
                {
                    <div class="gl-v2-pcd-side-body">
                        <span class="gl-v2-pcd-sm-hint">Er is nog geen contract met een prijs, dus er valt niets mee te vergelijken.</span>
                    </div>
                }
            </div>

            <div class="gl-v2-section-card">
                <div class="gl-v2-section-card-header">
                    <span class="gl-v2-section-card-icon"><i class="ph ph-shield-check" aria-hidden="true"></i></span>
                    <h2 class="gl-v2-section-card-title">Waarborg</h2>
                </div>
                @if (guaranteeContracts.Any())
                {
                    foreach (var gc in guaranteeContracts)
                    {
                        var gcPrice = gc.Activities?.Sum(a => a.EffectivePrice) ?? 0m;
                        var gcPct = gc.GuaranteePercentage ?? 0m;
                        // Wat de waarborg zou zijn volgens het contract, en wat er echt is ingehouden op de facturen (BorgInhouden).
                        var gcAmount = Math.Round(gcPrice * gcPct / 100m, 2);
                        var gcHeld = countedInvoices.Where(i => i.ContractID == gc.Id && i.BorgInhouden == true).Sum(i => i.BorgBedrag ?? 0m);
                        var gcVo = gc.GuaranteeReleaseVOPercentageEffective;
                        <div class="gl-v2-pcd-side-body">
                            @if (isMultiContract)
                            {
                                <span class="gl-v2-detail-label">@(string.IsNullOrWhiteSpace(gc.ContractName) ? "CONTRACT" : gc.ContractName.ToUpperInvariant())</span>
                            }
                            <div class="gl-v2-pcd-side-line"><span>@gc.GuaranteeType.GetDisplayName()@(gcPct > 0m ? " · " + gcPct.ToString("0.##", be) + " %" : "")</span></div>
                            @if (gc.GuaranteeType == ContractGuaranteeType.FinancialGuarantee)
                            {
                                <div class="gl-v2-pcd-side-line"><span>Ingehouden op facturen</span><b>@(gcHeld > 0m ? gcHeld.ToString("C2", be) : "nog niets")</b></div>
                                @if (gcPct > 0m)
                                {
                                    <div class="gl-v2-pcd-side-line is-soft"><span>Afgesproken: @gcPct.ToString("0.##", be) % van de contractprijs</span><b>@gcAmount.ToString("C2", be)</b></div>
                                }
                            }
                            @if (gc.GuaranteeType == ContractGuaranteeType.BankGuarantee)
                            {
                                if (!string.IsNullOrWhiteSpace(gc.GuaranteeDocFilename))
                                {
                                    <a href="@Url.Action("GuaranteeDoc", "Projecten", new { contractid = gc.Id })" target="_blank" rel="noopener" class="gl-v2-pcd-doc-link"><i class="ph ph-file-text" aria-hidden="true"></i>Waarborgdocument bekijken</a>
                                }
                                else
                                {
                                    <span class="gl-v2-badge is-attention">WAARBORG NOG TE ONTVANGEN</span>
                                }
                            }
                            @if (gcPct > 0m)
                            {
                                <span class="gl-v2-pcd-sm-hint">@gcVo.ToString("0.##", be) % vrij bij voorlopige oplevering · @((100m - gcVo).ToString("0.##", be)) % vrij bij definitieve oplevering</span>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="gl-v2-pcd-side-body">
                        <span class="gl-v2-pcd-sm-hint">Voor deze leverancier is geen waarborg afgesproken.</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
</div>

@* ── Tabblad Leverancier (design-handoff 14g) ───────────────────────────────────────────────────── *@
<div class="gl-v2-pcd-panel" id="gl-v2-pcd-panel-leverancier" data-tab-panel="leverancier" role="tabpanel" hidden>
<div class="gl-v2-m-only">
@{
    // ── Gsm (design-handoff 64l): uitleg, bedrijfsgegevens als rijen met een actie, contactpersonen, controles, andere projecten ──
    string LDigits(string? p) => new string((p ?? "").Where(ch => char.IsDigit(ch) || ch == '+').ToArray());
    var lPhone = !string.IsNullOrWhiteSpace(company?.Telefoon1) ? company.Telefoon1 : (!string.IsNullOrWhiteSpace(company?.GSM) ? company.GSM : null);
    var lRoute = companyAddress == "" ? null : "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(companyAddress);
    var lOthersTotal = otherContractRows.Sum(c => c.Price);
}
<div class="gl-v2-m-stack">
    <div class="gl-v2-m-info"><i class="ph ph-buildings" aria-hidden="true"></i><span>Geldt voor <b>@companyName</b>@(otherProjects > 1 ? " in alle " + otherProjects + " projecten" : " in alle projecten"). Prijs, voorwaarden en attesten van dit project staan bij Contract.</span></div>

    <section class="gl-v2-m-card">
        <div class="gl-v2-m-card-head"><span class="gl-v2-m-card-icon"><i class="ph ph-buildings" aria-hidden="true"></i></span><b>Bedrijfsgegevens</b><span class="gl-v2-m-spacer"></span>
            @if (Model.CanEditSupplier && company != null) { <a class="gl-v2-m-link" href="@Url.Action("Edit", "Leveranciers", new { id = company.CompanyId })"><i class="ph ph-pencil-simple" aria-hidden="true"></i>Bewerken</a> }
        </div>
        <div class="gl-v2-m-kv">
            @if (!string.IsNullOrWhiteSpace(company?.OndNr))
            {
                <div class="gl-v2-m-k2"><span><span class="gl-v2-m-k">ONDERNEMINGSNUMMER</span><b>@company.OndNr</b></span><button type="button" class="gl-v2-m-roundbtn js-gl-v2-pcd-copy" data-copy="@company.OndNr" aria-label="Ondernemingsnummer kopiëren"><i class="ph ph-copy" aria-hidden="true"></i></button></div>
            }
            @if (companyAddress != "")
            {
                <div class="gl-v2-m-k2"><span><span class="gl-v2-m-k">ADRES</span><b>@companyAddress</b></span><a class="gl-v2-m-roundbtn" href="@lRoute" target="_blank" rel="noopener" aria-label="Route"><i class="ph ph-navigation-arrow" aria-hidden="true"></i></a></div>
            }
            @if (lPhone is not null)
            {
                <div class="gl-v2-m-k2"><span><span class="gl-v2-m-k">TELEFOON</span><b>@lPhone</b></span><a class="gl-v2-m-roundbtn" href="tel:@LDigits(lPhone)" aria-label="Bellen"><i class="ph ph-phone" aria-hidden="true"></i></a></div>
            }
            @if (!string.IsNullOrWhiteSpace(company?.Email))
            {
                <div class="gl-v2-m-k2"><span><span class="gl-v2-m-k">E-MAIL</span><b>@company.Email</b></span><a class="gl-v2-m-roundbtn" href="mailto:@company.Email" aria-label="Mailen"><i class="ph ph-envelope-simple" aria-hidden="true"></i></a></div>
            }
            @if (string.IsNullOrWhiteSpace(company?.OndNr) && companyAddress == "" && lPhone is null && string.IsNullOrWhiteSpace(company?.Email))
            {
                <div class="gl-v2-m-tip">Nog geen bedrijfsgegevens ingevuld.</div>
            }
        </div>
    </section>

    <section class="gl-v2-m-card">
        <div class="gl-v2-m-card-head"><span class="gl-v2-m-card-icon"><i class="ph ph-users" aria-hidden="true"></i></span><b>Contactpersonen</b><span class="gl-v2-m-count">@Model.Contacts.Count</span><span class="gl-v2-m-spacer"></span>
            @if (Model.CanEditSupplier && company != null) { <a class="gl-v2-m-link" href="@Url.Action("Edit", "Leveranciers", new { id = company.CompanyId })"><i class="ph ph-plus" aria-hidden="true"></i>Toevoegen</a> }
        </div>
        @foreach (var person in Model.Contacts)
        {
            var lw = person.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            <div class="gl-v2-m-row gl-v2-m-cp">
                <span class="gl-v2-m-avatar">@(lw.Length == 0 ? "?" : string.Concat(lw.Take(2).Select(w => char.ToUpperInvariant(w[0]))))</span>
                <span class="gl-v2-m-rt"><b>@(person.Name == "" ? "Onbekende contactpersoon" : person.Name)</b><small>@(person.Role ?? "geen functie")@(person.Phone is null ? "" : " · " + person.Phone)</small>
                    @if (person.IsSiteManager || (person.LinkedUserId.HasValue && person.PortalStatus != null && PortalLabel(person.PortalStatus) != ""))
                    {
                        <span class="gl-v2-m-chips">
                            @if (person.IsSiteManager) { <i class="gl-v2-m-chip">Werfleider</i> }
                            @if (person.LinkedUserId.HasValue && person.PortalStatus != null && PortalLabel(person.PortalStatus) != "") { <i class="gl-v2-m-chip @(person.PortalStatus is "Redeemed" or "Active" ? "is-ok" : "is-gold")">Portaal · @PortalLabel(person.PortalStatus).ToLowerInvariant()</i> }
                        </span>
                    }
                </span>
                <span class="gl-v2-m-pair">
                    @if (person.Phone is not null) { <a class="gl-v2-m-roundbtn" href="tel:@LDigits(person.Phone)" aria-label="Bel @person.Name"><i class="ph ph-phone" aria-hidden="true"></i></a> }
                    @if (person.Email is not null) { <a class="gl-v2-m-roundbtn" href="mailto:@person.Email" aria-label="Mail @person.Name"><i class="ph ph-envelope-simple" aria-hidden="true"></i></a> }
                </span>
            </div>
        }
        @if (Model.Contacts.Count == 0) { <div class="gl-v2-m-tip">Nog geen contactpersonen. Voeg ze toe bij het bewerken van de leverancier.</div> }
    </section>

    @if (Model.RetainmentConfigured || Model.LastRetainment != null)
    {
        var lRet = Model.LastRetainment;
        var lRetBad = lRet != null && lRet.HasObligation;
        var lRetNone = lRet != null && lRet.SocialSituation == "notInDomain" && lRet.FiscalSituation == "notInDomain";
        <section class="gl-v2-m-card">
            <div class="gl-v2-m-card-head"><span class="gl-v2-m-card-icon"><i class="ph ph-shield-check" aria-hidden="true"></i></span><b>Controles</b><span class="gl-v2-m-spacer"></span>
                @if (Model.CanCheckRetainment && Model.RetainmentConfigured && Model.RetainmentHasIdentifier && company != null)
                {
                    <form method="post" action="@Url.Action("CheckSupplier", "Inhoudingsplicht")" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="companyId" value="@company.CompanyId" />
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path.Value + Context.Request.QueryString.Value + "#leverancier")" />
                        <button type="submit" class="gl-v2-m-link" style="border:0;background:none"><i class="ph ph-arrows-clockwise" aria-hidden="true"></i>Nu controleren</button>
                    </form>
                }
            </div>
            <div class="gl-v2-m-row"><span class="gl-v2-m-st @(lRet != null && !lRetBad ? "is-ok" : "is-no")"><i class="ph @(lRet != null && !lRetBad ? "ph-check" : "ph-x")" aria-hidden="true"></i></span>
                <span class="gl-v2-m-rt"><b>Inhoudingsplicht: @(lRet == null ? "nog niet gecontroleerd" : lRetBad ? "inhouden" : lRetNone ? "buiten toepassing" : "geen")</b><small>RSZ en FOD Financiën@(lRet != null ? " · gecontroleerd " + lRet.CheckedAt.ToLocalTime().ToString("dd/MM/yyyy", be) : "")</small></span></div>
            @if (lRetBad)
            {
                <div class="gl-v2-m-tip">Bij betaling moet je @(lRet!.SocialObligation ? lRet.SocialWithholdingPercentage + " % voor sociale schulden" : "")@(lRet.SocialObligation && lRet.FiscalObligation ? " en " : "")@(lRet.FiscalObligation ? lRet.FiscalWithholdingPercentage + " % voor fiscale schulden" : "") inhouden en doorstorten.</div>
            }
            else if (lRet == null && !Model.RetainmentHasIdentifier)
            {
                <div class="gl-v2-m-tip">Geen btw- of ondernemingsnummer: controleren is niet mogelijk.</div>
            }
        </section>
    }

    <section class="gl-v2-m-card">
        <div class="gl-v2-m-card-head"><span class="gl-v2-m-card-icon"><i class="ph ph-folders" aria-hidden="true"></i></span><b>In andere projecten</b><span class="gl-v2-m-count">@otherContractRows.Count</span><span class="gl-v2-m-spacer"></span></div>
        @foreach (var oc in otherContractRows)
        {
            var lHere = oc.ProjectId == Model.ProjectId;
            <a class="gl-v2-m-row@(lHere ? " is-here" : "")" href="@(lHere ? null : Url.Action("DetailContract", "Projecten", new { projectid = oc.ProjectId, contractid = oc.ContractId }))">
                <span class="gl-v2-m-rt"><b>@oc.ProjectName</b><small>@(lHere ? "dit project · " : "")@(string.IsNullOrWhiteSpace(oc.ContractName) ? "Contract" : oc.ContractName)</small></span>
                <span class="gl-v2-m-amt"><b>@oc.Price.ToString("C0", be)</b><i class="gl-v2-m-chip @(oc.Signed ? "is-ok" : "is-gold")">@(oc.Signed ? "Getekend" : "Niet getekend")</i></span>
                @if (!lHere) { <i class="ph ph-caret-right" aria-hidden="true"></i> }
            </a>
        }
        @if (otherContractRows.Count == 0) { <div class="gl-v2-m-tip">Nog geen contracten voor deze leverancier.</div> }
        else { <div class="gl-v2-m-total"><span>Samen @otherContractRows.Count contract@(otherContractRows.Count == 1 ? "" : "en")</span><b>@lOthersTotal.ToString("C0", be)</b></div> }
    </section>
</div>
</div>
<div class="gl-v2-d-wrap">
    <div class="gl-v2-notice gl-v2-notice-bar is-info" role="status">
        <i class="ph ph-buildings" aria-hidden="true"></i>
        <span>Deze gegevens gelden voor <b>@companyName</b> in alle projecten@(otherProjects > 1 ? " (" + otherProjects + " projecten)" : ""). Wat enkel voor dit project geldt, zoals prijs, voorwaarden en attesten, staat op het tabblad Contract.</span>
        @if (Model.CanEditSupplier && company != null)
        {
            <a class="gl-v2-btn gl-v2-btn-secondary" href="@Url.Action("Edit", "Leveranciers", new { id = company.CompanyId })"><i class="ph ph-pencil-simple" aria-hidden="true"></i>Leverancier bewerken</a>
        }
    </div>

    <div class="gl-v2-pcd-split">
        <div class="gl-v2-pcd-main">
            <div class="gl-v2-section-card">
                <div class="gl-v2-section-card-header">
                    <span class="gl-v2-section-card-icon"><i class="ph ph-buildings" aria-hidden="true"></i></span>
                    <h2 class="gl-v2-section-card-title">Bedrijfsgegevens</h2>
                </div>
                <div class="gl-v2-detail-grid gl-v2-pcd-2col" style="padding:16px 18px">
                    <div class="gl-v2-detail-field">
                        <span class="gl-v2-detail-label">Bedrijfsnaam</span>
                        <span class="gl-v2-detail-value">@companyName</span>
                    </div>
                    <div class="gl-v2-detail-field">
                        <span class="gl-v2-detail-label">Ondernemingsnummer</span>
                        <span class="gl-v2-detail-value@(string.IsNullOrWhiteSpace(company?.OndNr) ? " is-empty" : "")">@(string.IsNullOrWhiteSpace(company?.OndNr) ? "—" : company.OndNr)</span>
                    </div>
                    <div class="gl-v2-detail-field">
                        <span class="gl-v2-detail-label">Adres</span>
                        <span class="gl-v2-detail-value@(companyAddress == "" ? " is-empty" : "")">@(companyAddress == "" ? "—" : companyAddress)</span>
                    </div>
                    <div class="gl-v2-detail-field">
                        <span class="gl-v2-detail-label">Telefoon</span>
                        <span class="gl-v2-detail-value@(string.IsNullOrWhiteSpace(company?.Telefoon1) && string.IsNullOrWhiteSpace(company?.GSM) ? " is-empty" : "")">@(!string.IsNullOrWhiteSpace(company?.Telefoon1) ? company.Telefoon1 : (!string.IsNullOrWhiteSpace(company?.GSM) ? company.GSM : "—"))</span>
                    </div>
                    <div class="gl-v2-detail-field">
                        <span class="gl-v2-detail-label">E-mail</span>
                        @if (!string.IsNullOrWhiteSpace(company?.Email))
                        {
                            <span class="gl-v2-detail-value"><a href="mailto:@company.Email" class="gl-v2-pcd-link">@company.Email</a></span>
                        }
                        else
                        {
                            <span class="gl-v2-detail-value is-empty">—</span>
                        }
                    </div>
                    <div class="gl-v2-detail-field">
                        <span class="gl-v2-detail-label">Website</span>
                        @if (!string.IsNullOrWhiteSpace(company?.URL))
                        {
                            <span class="gl-v2-detail-value"><a href="@(company.URL.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? company.URL : "https://" + company.URL)" target="_blank" rel="noopener" class="gl-v2-pcd-link">@company.URL</a></span>
                        }
                        else
                        {
                            <span class="gl-v2-detail-value is-empty">—</span>
                        }
                    </div>
                </div>
            </div>

            <div class="gl-v2-section-card">
                <div class="gl-v2-section-card-header">
                    <span class="gl-v2-section-card-icon"><i class="ph ph-users" aria-hidden="true"></i></span>
                    <h2 class="gl-v2-section-card-title">Contactpersonen</h2>
                    <span class="gl-v2-field-divider"></span>
                    <span class="gl-v2-section-card-desc">De tag zegt wie wat ontvangt.</span>
                </div>
                @if (Model.Contacts.Any())
                {
                    <div class="gl-v2-pcd-people">
                        @foreach (var person in Model.Contacts)
                        {
                            var words = person.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            var initials = words.Length == 0 ? "?" : string.Concat(words.Take(2).Select(w => char.ToUpperInvariant(w[0])));
                            <div class="gl-v2-pcd-person">
                                <span class="gl-v2-pcd-sm-avatar" aria-hidden="true">@initials</span>
                                <div class="gl-v2-pcd-person-who">
                                    <b>@(person.Name == "" ? "Onbekende contactpersoon" : person.Name)</b>
                                    <small>@(person.Role ?? "geen functie")</small>
                                </div>
                                <div class="gl-v2-pcd-person-contact">
                                    @if (person.Email != null) { <a href="mailto:@person.Email" class="gl-v2-pcd-link">@person.Email</a> }
                                    @if (person.Phone != null) { <a href="tel:@(new string(person.Phone.Where(ch => char.IsDigit(ch) || ch == '+').ToArray()))" class="gl-v2-pcd-link gl-v2-pcd-sm-mono">@person.Phone</a> }
                                    @if (person.Email == null && person.Phone == null) { <small>geen e-mail of telefoon</small> }
                                </div>
                                <div class="gl-v2-pcd-person-tags">
                                    @if (person.IsSiteManager) { <span class="gl-v2-pcd-sm-chip"><i class="ph ph-hard-hat" aria-hidden="true"></i>Werf</span> }
                                    @if (person.LinkedUserId.HasValue && person.PortalStatus != null && PortalLabel(person.PortalStatus) != "")
                                    {
                                        <span class="gl-v2-badge @PortalTone(person.PortalStatus)">PORTAAL · @PortalLabel(person.PortalStatus).ToUpperInvariant()</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="gl-v2-empty-state gl-v2-empty-state-inline">
                        <span class="gl-v2-empty-state-icon"><i class="ph ph-users" aria-hidden="true"></i></span>
                        <h3 class="gl-v2-empty-state-title">Nog geen contactpersonen</h3>
                        <p class="gl-v2-empty-state-desc">Voeg ze toe bij het bewerken van de leverancier.</p>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(company?.Opmerking))
            {
                <div class="gl-v2-section-card">
                    <div class="gl-v2-section-card-header">
                        <span class="gl-v2-section-card-icon"><i class="ph ph-note" aria-hidden="true"></i></span>
                        <h2 class="gl-v2-section-card-title">Interne notitie</h2>
                        <span class="gl-v2-section-card-spacer"></span>
                        <span class="gl-v2-badge is-neutral">INTERN</span>
                    </div>
                    <p class="gl-v2-pcd-note">@company.Opmerking</p>
                </div>
            }
        </div>

        <div class="gl-v2-pcd-side">
            @if (Model.RetainmentConfigured || Model.LastRetainment != null)
            {
                var ret = Model.LastRetainment;
                var retBad = ret != null && ret.HasObligation;
                var retNone = ret != null && ret.SocialSituation == "notInDomain" && ret.FiscalSituation == "notInDomain";
                <div class="gl-v2-section-card" id="gl-v2-pcd-controles">
                    <div class="gl-v2-section-card-header">
                        <span class="gl-v2-section-card-icon"><i class="ph ph-shield-check" aria-hidden="true"></i></span>
                        <h2 class="gl-v2-section-card-title">Controles</h2>
                        <span class="gl-v2-field-divider"></span>
                        <span class="gl-v2-section-card-desc">Inhoudingsplicht van deze leverancier.</span>
                    </div>
                    <div class="gl-v2-pcd-checklist">
                        <div class="gl-v2-pcd-check @(ret == null ? "is-missing" : retBad ? "is-missing" : "is-ok")">
                            <span class="gl-v2-pcd-check-icon"><i class="ph @(ret != null && !retBad ? "ph-check" : "ph-x")" aria-hidden="true"></i></span>
                            <span class="gl-v2-pcd-check-label">Inhoudingsplicht<br /><small>RSZ en FOD Financiën@(ret != null ? " · gecontroleerd " + ret.CheckedAt.ToLocalTime().ToString("dd/MM/yyyy", be) : "")</small></span>
                            <span class="gl-v2-pcd-check-value">@(ret == null ? "nog niet gecontroleerd" : retBad ? "inhouden" : retNone ? "buiten toepassing" : "geen")</span>
                        </div>
                    </div>
                    @if (retBad)
                    {
                        <div class="gl-v2-pcd-side-body">
                            <span class="gl-v2-pcd-sm-hint">
                                Bij betaling aan deze leverancier moet je
                                @if (ret!.SocialObligation) { <b>@ret.SocialWithholdingPercentage % voor sociale schulden</b> }
                                @if (ret.SocialObligation && ret.FiscalObligation) { <text> en </text> }
                                @if (ret.FiscalObligation) { <b>@ret.FiscalWithholdingPercentage % voor fiscale schulden</b> }
                                inhouden en doorstorten.
                                @if (ret.Environment == "Simulation") { <text> Dit is een testresultaat.</text> }
                            </span>
                        </div>
                    }
                    @if (Model.CanCheckRetainment && Model.RetainmentConfigured && Model.RetainmentHasIdentifier && company != null)
                    {
                        <div class="gl-v2-pcd-side-body">
                            <form method="post" action="@Url.Action("CheckSupplier", "Inhoudingsplicht")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="companyId" value="@company.CompanyId" />
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path.Value + Context.Request.QueryString.Value + "#leverancier")" />
                                <button type="submit" class="gl-v2-btn gl-v2-btn-secondary"><i class="ph ph-arrows-clockwise" aria-hidden="true"></i>Nu controleren</button>
                            </form>
                        </div>
                    }
                    else if (ret == null && !Model.RetainmentHasIdentifier)
                    {
                        <div class="gl-v2-pcd-side-body"><span class="gl-v2-pcd-sm-hint">Geen btw- of ondernemingsnummer: controleren is niet mogelijk.</span></div>
                    }
                </div>
            }
            <div class="gl-v2-section-card">
                <div class="gl-v2-section-card-header">
                    <span class="gl-v2-section-card-icon"><i class="ph ph-folders" aria-hidden="true"></i></span>
                    <h2 class="gl-v2-section-card-title">In andere projecten</h2>
                </div>
                @if (otherContractRows.Any())
                {
                    <div class="gl-v2-pcd-others">
                        @foreach (var oc in otherContractRows)
                        {
                            var isHere = oc.ProjectId == Model.ProjectId;
                            <a class="gl-v2-pcd-other @(isHere ? "is-here" : "")" href="@Url.Action("DetailContract", "Projecten", new { projectid = oc.ProjectId, contractid = oc.ContractId })">
                                <span class="gl-v2-pcd-other-main">
                                    <b>@oc.ProjectName@(isHere ? " · dit project" : "")</b>
                                    <small>@(string.IsNullOrWhiteSpace(oc.ContractName) ? "Contract" : oc.ContractName)</small>
                                </span>
                                <span class="gl-v2-pcd-other-end">
                                    <b>@oc.Price.ToString("C2", be)</b>
                                    <span class="gl-v2-badge @(oc.Signed ? "is-positive" : "is-attention")">@(oc.Signed ? "GETEKEND" : "NIET GETEKEND")</span>
                                </span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="gl-v2-pcd-side-body"><span class="gl-v2-pcd-sm-hint">Nog geen contracten voor deze leverancier.</span></div>
                }
            </div>
        </div>
    </div>
</div>
</div>

@* ── Tabblad Portaaltoegang (design-handoff 14h) ────────────────────────────────────────────────── *@
<div class="gl-v2-pcd-panel" id="gl-v2-pcd-panel-portaaltoegang" data-tab-panel="portaaltoegang" role="tabpanel" hidden>
<div class="gl-v2-m-only">
@{
    // ── Gsm (design-handoff 64m): kort en bovenaan, per persoon chips, acties, wat de leverancier ziet, iemand uitnodigen ──
    var pInvited = Model.Contacts.Where(c => c.LinkedUserId.HasValue && c.PortalStatus != null && PortalLabel(c.PortalStatus) != "").ToList();
    var pOthers = Model.Contacts.Where(c => !pInvited.Contains(c) && c.Email != null).ToList();
    var pFirst = pInvited.FirstOrDefault(c => c.PortalStatus is "Active" or "Redeemed") ?? pInvited.FirstOrDefault();
    string PInit(string name) { var w = name.Split(' ', StringSplitOptions.RemoveEmptyEntries); return w.Length == 0 ? "?" : string.Concat(w.Take(2).Select(x => char.ToUpperInvariant(x[0]))); }
}
<div class="gl-v2-m-stack">
    <section class="gl-v2-m-card">
        <div class="gl-v2-m-port-h"><span class="gl-v2-m-k">WERFPORTAAL</span><b>@pInvited.Count uitgenodigd · @withPortal met toegang</b><small>Toegang geldt voor het hele bedrijf, niet per project.</small></div>
        @foreach (var person in pInvited)
        {
            var pCanRevoke = Model.CanEditSupplier && person.LinkedUserId.HasValue && person.PortalStatus != null && person.PortalStatus is not ("Failed" or "Revoked");
            var pCanInvite = Model.CanEditSupplier && person.Email != null && (person.PortalStatus is "Failed" or "Revoked");
            <div class="gl-v2-m-row gl-v2-m-cp">
                <span class="gl-v2-m-avatar">@PInit(person.Name)</span>
                <span class="gl-v2-m-rt"><b>@(person.Name == "" ? "Onbekende contactpersoon" : person.Name)</b><small>@(person.Email ?? "geen e-mailadres")@(person.Role == null ? "" : " · " + person.Role)</small>
                    <span class="gl-v2-m-chips">
                        <i class="gl-v2-m-chip @(person.PortalStatus is "Redeemed" or "Active" ? "is-ok" : "is-gold")">@PortalLabel(person.PortalStatus!)</i>
                        <i class="gl-v2-m-chip">@(person.IsFullCompanyAdmin ? "Volledig" : "Beperkt")</i>
                        @if (!person.LastLoginAt.HasValue) { <span class="gl-v2-m-mut">nog nooit aangemeld</span> }
                        else { <span class="gl-v2-m-mut">laatst aangemeld @person.LastLoginAt.Value.ToLocalTime().ToString("dd/MM HH:mm", be)</span> }
                    </span>
                </span>
            </div>
            @if (pCanInvite || pCanRevoke)
            {
                <div class="gl-v2-m-btns">
                    @if (pCanInvite)
                    {
                        <form method="post" action="@Url.Action("InviteContact", "Leveranciers")" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="contactId" value="@person.ContactId" />
                            <input type="hidden" name="isFullAdmin" value="@(person.IsFullCompanyAdmin ? "true" : "false")" />
                            <input type="hidden" name="returnUrl" value="@returnTo" />
                            <button type="submit" class="gl-v2-m-sec"><i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>Opnieuw uitnodigen</button>
                        </form>
                    }
                    @if (pCanRevoke)
                    {
                        <form method="post" action="@Url.Action("RevokeContactAccess", "Leveranciers")" class="d-inline" data-bv-titel="Portaaltoegang intrekken voor @(person.Name == "" ? "deze persoon" : person.Name)?" data-bv-tekst="Hij kan daarna niet meer aanmelden. Je kan hem later opnieuw uitnodigen." data-bv-ok="Toegang intrekken" data-bv-tone="warning" data-bv-icon="ph-link-break">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="contactId" value="@person.ContactId" />
                            <input type="hidden" name="returnUrl" value="@returnTo" />
                            <button type="submit" class="gl-v2-m-del">Intrekken</button>
                        </form>
                    }
                </div>
            }
        }
        @if (pInvited.Count == 0) { <div class="gl-v2-m-tip">Nog niemand van @companyName is uitgenodigd.</div> }
    </section>

    <section class="gl-v2-m-card">
        <div class="gl-v2-m-port-h"><span class="gl-v2-m-k">WAT ZIET DE LEVERANCIER?</span></div>
        <div class="gl-v2-m-lvl">
            <div class="@(pFirst is not null && !pFirst.IsFullCompanyAdmin ? "is-on" : "")"><b>Beperkt</b><small>Enkel de werven en punten van contracten waar deze persoon werfleider is.</small></div>
            <div class="@(pFirst is not null && pFirst.IsFullCompanyAdmin ? "is-on" : "")"><b>Volledig</b><small>Alle werven, voortgang en punten van het hele bedrijf.</small></div>
        </div>
    </section>

    <section class="gl-v2-m-card">
        <div class="gl-v2-m-card-head"><span class="gl-v2-m-card-icon"><i class="ph ph-user-plus" aria-hidden="true"></i></span><b>Iemand uitnodigen</b><span class="gl-v2-m-spacer"></span></div>
        @foreach (var person in pOthers)
        {
            var pCan = Model.CanEditSupplier;
            <div class="gl-v2-m-row gl-v2-m-cp">
                <span class="gl-v2-m-avatar">@PInit(person.Name)</span>
                <span class="gl-v2-m-rt"><b>@(person.Name == "" ? "Onbekende contactpersoon" : person.Name)</b><small>@person.Email@(person.Role == null ? "" : " · " + person.Role)</small></span>
            </div>
            @if (pCan)
            {
                <div class="gl-v2-m-btns">
                    <form method="post" action="@Url.Action("InviteContact", "Leveranciers")" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="contactId" value="@person.ContactId" /><input type="hidden" name="isFullAdmin" value="false" /><input type="hidden" name="returnUrl" value="@returnTo" />
                        <button type="submit" class="gl-v2-m-sec"><i class="ph ph-user-plus" aria-hidden="true"></i>Beperkt</button>
                    </form>
                    <form method="post" action="@Url.Action("InviteContact", "Leveranciers")" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="contactId" value="@person.ContactId" /><input type="hidden" name="isFullAdmin" value="true" /><input type="hidden" name="returnUrl" value="@returnTo" />
                        <button type="submit" class="gl-v2-m-sec"><i class="ph ph-buildings" aria-hidden="true"></i>Volledig</button>
                    </form>
                </div>
            }
        }
        @if (pOthers.Count == 0)
        {
            <div class="gl-v2-m-row"><span class="gl-v2-m-avatar">?</span><span class="gl-v2-m-rt"><b>Geen andere contactpersonen met e-mail</b><small>Voeg eerst een contactpersoon toe bij Leverancier.</small></span></div>
        }
    </section>
</div>
</div>
<div class="gl-v2-d-wrap">
    <span class="gl-v2-pcd-meta">
        Wie bij @companyName zich kan aanmelden in het werfportaal · @withPortal met toegang · @contactsWithMail met e-mailadres
    </span>

    <div class="gl-v2-section-card">
        <div class="gl-v2-section-card-header">
            <span class="gl-v2-section-card-icon"><i class="ph ph-key" aria-hidden="true"></i></span>
            <h2 class="gl-v2-section-card-title">Personen met toegang</h2>
            <span class="gl-v2-field-divider"></span>
            <span class="gl-v2-section-card-desc">Een uitnodiging stuurt een e-mail met een link om aan te melden.</span>
        </div>
        @if (Model.Contacts.Any())
        {
            <div class="gl-v2-pcd-access">
                <div class="gl-v2-pcd-access-row gl-v2-pcd-access-head">
                    <span>Persoon</span><span>Toegang</span><span>Status</span><span>Laatst aangemeld</span><span></span>
                </div>
                @foreach (var person in Model.Contacts)
                {
                    var hasStatus = person.PortalStatus != null && PortalLabel(person.PortalStatus) != "";
                    var canInvite = Model.CanEditSupplier && person.Email != null && (!person.LinkedUserId.HasValue || person.PortalStatus == null || person.PortalStatus is "Failed" or "Revoked");
                    var canRevoke = Model.CanEditSupplier && person.LinkedUserId.HasValue && person.PortalStatus != null && person.PortalStatus is not ("Failed" or "Revoked");
                    <div class="gl-v2-pcd-access-row">
                        <span class="gl-v2-pcd-person-who">
                            <b>@(person.Name == "" ? "Onbekende contactpersoon" : person.Name)</b>
                            <small>@(person.Email ?? "geen e-mailadres") @(person.Role == null ? "" : "· " + person.Role)</small>
                        </span>
                        <span data-label="Toegang">@(hasStatus && person.LinkedUserId.HasValue ? (person.IsFullCompanyAdmin ? "Volledig bedrijf" : (person.IsSiteManager ? "Beperkt · eigen contracten als werfleider" : "Beperkt")) : "—")</span>
                        <span data-label="Status">
                            @if (hasStatus)
                            {
                                <span class="gl-v2-badge @PortalTone(person.PortalStatus!)">@PortalLabel(person.PortalStatus!).ToUpperInvariant()</span>
                            }
                            else
                            {
                                <span class="gl-v2-pcd-sm-hint">niet uitgenodigd</span>
                            }
                        </span>
                        <span data-label="Laatst aangemeld">@(person.LastLoginAt.HasValue ? person.LastLoginAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm", be) : "—")</span>
                        <span class="gl-v2-pcd-access-actions">
                            @if (canInvite)
                            {
                                <form method="post" action="@Url.Action("InviteContact", "Leveranciers")" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="contactId" value="@person.ContactId" />
                                    <input type="hidden" name="isFullAdmin" value="false" />
                                    <input type="hidden" name="returnUrl" value="@returnTo" />
                                    <button type="submit" class="gl-v2-btn gl-v2-btn-secondary" title="Hij ziet enkel de contracten waarvoor hij werfleider is"><i class="ph ph-user-plus" aria-hidden="true"></i>Beperkt uitnodigen</button>
                                </form>
                                <form method="post" action="@Url.Action("InviteContact", "Leveranciers")" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="contactId" value="@person.ContactId" />
                                    <input type="hidden" name="isFullAdmin" value="true" />
                                    <input type="hidden" name="returnUrl" value="@returnTo" />
                                    <button type="submit" class="gl-v2-btn gl-v2-btn-primary" title="Hij ziet alle werven van het bedrijf"><i class="ph ph-buildings" aria-hidden="true"></i>Volledig uitnodigen</button>
                                </form>
                            }
                            else if (canRevoke)
                            {
                                <form method="post" action="@Url.Action("RevokeContactAccess", "Leveranciers")" class="d-inline" data-bv-titel="Portaaltoegang intrekken voor @(person.Name == "" ? "deze persoon" : person.Name)?" data-bv-tekst="Hij kan daarna niet meer aanmelden. Je kan hem later opnieuw uitnodigen." data-bv-ok="Toegang intrekken" data-bv-tone="warning" data-bv-icon="ph-link-break">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="contactId" value="@person.ContactId" />
                                    <input type="hidden" name="returnUrl" value="@returnTo" />
                                    <button type="submit" class="gl-v2-btn gl-v2-btn-danger"><i class="ph ph-link-break" aria-hidden="true"></i>Toegang intrekken</button>
                                </form>
                            }
                        </span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="gl-v2-empty-state gl-v2-empty-state-inline">
                <span class="gl-v2-empty-state-icon"><i class="ph ph-key" aria-hidden="true"></i></span>
                <h3 class="gl-v2-empty-state-title">Nog geen contactpersonen</h3>
                <p class="gl-v2-empty-state-desc">Voeg eerst een contactpersoon met e-mailadres toe aan de leverancier. Daarna kan je die uitnodigen.</p>
            </div>
        }
    </div>

    <div class="gl-v2-section-card">
        <div class="gl-v2-section-card-header">
            <span class="gl-v2-section-card-icon"><i class="ph ph-info" aria-hidden="true"></i></span>
            <h2 class="gl-v2-section-card-title">Wat de leverancier ziet</h2>
        </div>
        <div class="gl-v2-pcd-side-body">
            <span class="gl-v2-pcd-sm-hint">In het werfportaal ziet de uitgenodigde de werven van zijn bedrijf, de voortgang per werf en de punten die aan zijn bedrijf zijn toegewezen. Bij <b>beperkt</b> ziet hij enkel de werven en punten van de contracten waarvoor hij werfleider is. Bij <b>volledig</b> ziet hij alles van het bedrijf. Toegang geldt voor het hele bedrijf, niet per project.</span>
        </div>
    </div>
</div>
</div>

@* z-index-fix (gl-v2-shell.css, "de echte oorzaak van 'de modal rendert plat tussen de pagina-
   inhoud'"): --bs-modal-zindex wordt enkel opgetild boven de rail/topbar (z-index 99996-99999) voor
   modals met .gl-v2-modal-confirm/-form/-search — deze verwijder-modal miste die klasse, dus zijn
   .modal-backdrop (wél altijd op 100000, ongescoped) stond boven de modal zelf i.p.v. erachter. *@
<div class="modal fade gl-v2-modal-confirm" id="gl-v2-pcd-delete-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" id="gl-v2-pcd-delete-container"></div>
    </div>
</div>

@await Html.PartialAsync("GlV2/_BevestigModal")

@section PageScripts
{
