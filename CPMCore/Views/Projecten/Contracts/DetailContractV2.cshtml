    @{
        var qaSm = Model.SiteManagers.Values.FirstOrDefault(s => !string.IsNullOrWhiteSpace(s.Phone));
        var qaPhone = qaSm?.Phone ?? (!string.IsNullOrWhiteSpace(company?.Telefoon1) ? company.Telefoon1 : (!string.IsNullOrWhiteSpace(company?.Telefoon2) ? company.Telefoon2 : Model.Contacts.Select(c => c.Phone).FirstOrDefault(p => !string.IsNullOrWhiteSpace(p))));
        var qaMail = !string.IsNullOrWhiteSpace(company?.Email) ? company.Email : (qaSm?.Email ?? Model.Contacts.Select(c => c.Email).FirstOrDefault(e => !string.IsNullOrWhiteSpace(e)));
        var qaMissingPid = Model.Contracts.Any(c => !c.PidAttest);
        var qaTop = sortedContracts.FirstOrDefault();
        var qaEdit = qaTop is null || !canWrite ? null : Url.Action("EditContract", "Projecten", new { projectid = Model.ProjectId, contractid = qaTop.Id });
        var qaSubject = Uri.EscapeDataString($"PID-attesten opvragen — {companyName}, {Model.ProjectName}");
    }
    @if (!string.IsNullOrWhiteSpace(qaPhone))
