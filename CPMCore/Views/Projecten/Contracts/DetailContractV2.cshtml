    {
        <a href="#" class="gl-v2-mobile-quickaction" aria-disabled="true" data-off-message="Geen e-mailadres bij deze leverancier" data-qa-key="mail"><i class="ph ph-envelope-simple" aria-hidden="true"></i>Mailen</a>
