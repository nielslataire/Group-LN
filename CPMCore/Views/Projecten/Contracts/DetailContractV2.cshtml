        <b class="gl-v2-m-hero-name">@companyName</b>
        <span class="gl-v2-m-hero-sub">@(heroFirstLot is null ? "" : heroFirstLot + " · ")@heroLots lot@(heroLots == 1 ? "" : "en")@(heroSent.HasValue ? " · verstuurd " + heroSent.Value.ToString("dd/MM/yyyy", be) : "")</span>
        <span class="gl-v2-m-hero-chips">
            @if (!Model.HasContract) { <i class="gl-v2-m-chip">Geen contract</i> }
            else if (Model.Contracts.Count > 1) { <i class="gl-v2-m-chip @(allSigned ? "is-ok" : "is-gold")">@Model.Contracts.Count(c => c.ContractSigned) / @Model.Contracts.Count getekend</i> }
            else if (Model.Contracts[0].ContractSigned) { <i class="gl-v2-m-chip is-ok">Getekend</i> }
            else { <i class="gl-v2-m-chip is-gold">Niet getekend</i> }
            @if (heroOverPct >= 1) { <i class="gl-v2-m-chip is-gold">+ @heroOverPct % gefactureerd</i> }
        </span>
    </div>
</div>

