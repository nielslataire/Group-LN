    // ── Gsm (design-handoff 64i/64j): één contract als kaartenstapel — Vraagt actie (goud), kerncijfers, werfleider, attesten, loten. ──
    string MInvoiced(ContractBO c) => (invoices.Where(i => i.ContractID == c.Id && InvGroup(i) != "afgekeurd").Sum(i => i.InvoicePrice)).ToString("C2", be);
    async Task RenderContractMobile(ContractBO contract)
    {
        var mPrice = contract.Activities?.Sum(a => a.EffectivePrice) ?? 0m;
        var mBilled = invoices.Where(i => i.ContractID == contract.Id && InvGroup(i) != "afgekeurd").Sum(i => i.InvoicePrice);
        var mDiff = mPrice > 0m ? (int)Math.Round((mBilled - mPrice) / mPrice * 100m, 0) : 0;
        var mOver = mPrice > 0m && mBilled > mPrice && mDiff >= 1;
        var mDonePct = mPrice > 0m ? (int)Math.Round(mBilled / mPrice * 100m, 0) : 0;
        var mLots = contract.Activities?.Count ?? 0;
        var mMissingSm = !contract.SiteManagerContactId.HasValue || contract.SiteManagerContactId == 0;
        var mSm = !mMissingSm && Model.SiteManagers.TryGetValue(contract.SiteManagerContactId!.Value, out var mSmInfo) ? mSmInfo : null;
        var mEdit = Url.Action("EditContract", "Projecten", new { projectid = Model.ProjectId, contractid = contract.Id });
        var mDaysOpen = contract.ContractSentDate.HasValue && !contract.ContractSigned ? (int)(DateTime.Today - contract.ContractSentDate.Value).TotalDays : (int?)null;
        var mSmSheet = "gl-v2-m-sm-sheet-" + contract.Id;
        var mReminder = ReminderMailto(contract, $"Herinnering: contract {companyName} — {Model.ProjectName}");
        var mPid = ReminderMailto(contract, $"PID-attesten opvragen — {companyName}, {Model.ProjectName}");

        // Vraagt actie: elk punt met de actie rechts (Opvragen, Kiezen, …).
        var vaItems = new List<(string Title, string Sub, string Icon, string Act, string? Href, string? Sheet)>();
        if (!contract.ContractSigned)
            vaItems.Add(("Contract niet getekend", contract.ContractSentDate.HasValue ? $"verstuurd {contract.ContractSentDate.Value:dd/MM}" + (mDaysOpen.HasValue ? $" · {mDaysOpen} dagen open" : "") : "nog niet verstuurd", "ph-file-text", mReminder is null ? "" : "Herinnering", mReminder, null));
        if (contract.GuaranteeDocumentMissing && canWrite)
            vaItems.Add(("Bankwaarborg ontbreekt", "het waarborgdocument is nog niet ontvangen", "ph-shield-warning", "Bewerken", mEdit, null));
        if (!contract.PidAttest)
            vaItems.Add(("PID-attesten ontbreken", "nodig vóór oplevering", "ph-shield-warning", mPid is null ? "" : "Opvragen", mPid, null));
        if (mMissingSm && canWrite)
            vaItems.Add(("Geen werfleider", "nodig voor werfpunten en verslagen", "ph-hard-hat", "Kiezen", null, mSmSheet));

        <div class="gl-v2-m-stack">
        @if (isMultiContract)
        {
            <div class="gl-v2-m-contract-name">@(string.IsNullOrWhiteSpace(contract.ContractName) ? "Contract" : contract.ContractName) · @(contract.ContractSigned ? "getekend" : "niet getekend")</div>
        }
        @if (vaItems.Count > 0)
        {
            <section class="gl-v2-m-va is-gold" aria-label="Vraagt actie">
                <div class="gl-v2-m-va-head">
                    <span class="gl-v2-m-va-icon"><i class="ph ph-warning-circle" aria-hidden="true"></i></span>
                    <span class="gl-v2-m-va-title"><b>Vraagt actie</b><small>@vaItems.Count punt@(vaItems.Count == 1 ? "" : "en")</small></span>
                    <i class="gl-v2-m-va-n">@vaItems.Count</i>
                </div>
                @foreach (var va in vaItems)
                {
                    <div class="gl-v2-m-va-row">
                        <span class="gl-v2-m-va-ico is-gold"><i class="ph @va.Icon" aria-hidden="true"></i></span>
                        <span class="gl-v2-m-rt"><b>@va.Title</b><small>@va.Sub</small></span>
                        @if (va.Sheet is not null)
                        {
                            <button type="button" class="gl-v2-m-va-act js-gl-v2-menu-trigger" style="border:0;background:none" aria-haspopup="true" aria-expanded="false" aria-controls="@va.Sheet">@va.Act</button>
                        }
                        else if (!string.IsNullOrEmpty(va.Act) && va.Href is not null)
                        {
                            <a class="gl-v2-m-va-act" href="@va.Href">@va.Act</a>
                        }
                    </div>
                }
            </section>
        }

        <section class="gl-v2-m-card gl-v2-m-kpi">
            <div><span class="gl-v2-m-k">CONTRACTPRIJS</span><b>@mPrice.ToString("C2", be)</b><small>@mLots lot@(mLots == 1 ? "" : "en") · @(contract.Activities?.Any(a => a.AdditionalOrders.Any()) == true ? "bijbestellingen" : "geen bijbestellingen")</small></div>
            <div><span class="gl-v2-m-k">BETAALTERMIJN</span><b>@FmtPaymentTerm(contract)</b><small>@(contract.CashDiscount ? FmtCashDiscount(contract).Replace(" binnen ", " binnen ") : "geen korting contant")</small></div>
            <div><span class="gl-v2-m-k">GEFACTUREERD</span><b>@mBilled.ToString("C2", be)</b><small class="@(mOver ? "is-o" : "")">@(mOver ? "+ " + mDiff + " % boven contract" : (mPrice > 0m ? mDonePct + " % van het contract" : "geen contractprijs"))</small></div>
            <div><span class="gl-v2-m-k">WAARBORG</span><b>@(contract.GuaranteeType == ContractGuaranteeType.FinancialGuarantee ? contract.GuaranteePercentage?.ToString("0.##", be) + " %" : contract.GuaranteeType.GetDisplayName())</b><small>@contract.GuaranteeType.GetDisplayName()</small></div>
            <p class="gl-v2-m-mini">
                <span>BTW <em>@(contract.VatPercentage?.ToString("0.##", be) ?? "0") %@((contract.VatPercentage ?? 0m) == 0m ? " verlegd" : "")</em></span>
                @if (contract.ContractSentDate.HasValue) { <span>@(contract.ContractSigned ? "Getekend" : "Verstuurd") <em>@contract.ContractSentDate.Value.ToString("dd/MM/yyyy", be)</em></span> }
            </p>
        </section>

        <section class="gl-v2-m-card">
            <div class="gl-v2-m-card-head"><span class="gl-v2-m-card-icon"><i class="ph ph-hard-hat" aria-hidden="true"></i></span><b>Werfleider aannemer</b><span class="gl-v2-m-spacer"></span>
                @if (canWrite && mSm is not null) { <button type="button" class="gl-v2-m-link js-gl-v2-menu-trigger" style="border:0;background:none" aria-haspopup="true" aria-expanded="false" aria-controls="@mSmSheet">Wijzigen</button> }
            </div>
            @if (mSm is not null)
            {
                var mSmDigits = new string((mSm.Phone ?? "").Where(ch => char.IsDigit(ch) || ch == '+').ToArray());
                var mSmWords = mSm.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                <div class="gl-v2-m-row"><span class="gl-v2-m-avatar">@string.Concat(mSmWords.Take(2).Select(w => char.ToUpperInvariant(w[0])))</span><span class="gl-v2-m-rt"><b>@mSm.Name</b><small>@(mSm.Role is null ? "" : mSm.Role + " · ")@companyName</small></span>
                    @if (mSm.Phone is not null) { <a class="gl-v2-m-roundbtn" href="tel:@mSmDigits" aria-label="Bel @mSm.Name"><i class="ph ph-phone" aria-hidden="true"></i></a> }
                    @if (mSm.Email is not null) { <a class="gl-v2-m-roundbtn" href="mailto:@mSm.Email" aria-label="Mail @mSm.Name"><i class="ph ph-envelope-simple" aria-hidden="true"></i></a> }
                </div>
            }
            else
            {
                <div class="gl-v2-m-empty"><span>Nog geen werfleider. Kies iemand uit de contactpersonen van @companyName.</span>
                    @if (canWrite) { <button type="button" class="gl-v2-m-sec js-gl-v2-menu-trigger" aria-haspopup="true" aria-expanded="false" aria-controls="@mSmSheet"><i class="ph ph-plus" aria-hidden="true"></i>Werfleider kiezen</button> }
                </div>
            }
        </section>

        <section class="gl-v2-m-card">
            <div class="gl-v2-m-card-head"><span class="gl-v2-m-card-icon"><i class="ph ph-shield-check" aria-hidden="true"></i></span><b>Veiligheid &amp; attesten</b><span class="gl-v2-m-spacer"></span>
                @if (canWrite) { <a class="gl-v2-m-link" href="@mEdit">Bewerken</a> }
            </div>
            <div class="gl-v2-m-row"><span class="gl-v2-m-st @(contract.SiteNotification ? "is-ok" : "is-no")"><i class="ph @(contract.SiteNotification ? "ph-check" : "ph-x")" aria-hidden="true"></i></span><span class="gl-v2-m-rt"><b>Werfmelding</b></span><span class="gl-v2-m-sv @(contract.SiteNotification ? "" : "is-no")">@(contract.SiteNotification ? "in orde" : "ontbreekt")</span></div>
            <div class="gl-v2-m-row"><span class="gl-v2-m-st @(contract.VgmCharter ? "is-ok" : "is-no")"><i class="ph @(contract.VgmCharter ? "ph-check" : "ph-x")" aria-hidden="true"></i></span><span class="gl-v2-m-rt"><b>VGM-charter</b></span><span class="gl-v2-m-sv @(contract.VgmCharter ? "" : "is-no")">@(contract.VgmCharter ? "ondertekend" : "ontbreekt")</span></div>
            <div class="gl-v2-m-row"><span class="gl-v2-m-st @(contract.PidAttest ? "is-ok" : "is-no")"><i class="ph @(contract.PidAttest ? "ph-check" : "ph-x")" aria-hidden="true"></i></span><span class="gl-v2-m-rt"><b>PID-attesten</b></span><span class="gl-v2-m-sv @(contract.PidAttest ? "" : "is-no")">@(contract.PidAttest ? "ontvangen" : "ontbreekt")</span></div>
            @if (contract.GuaranteeType == ContractGuaranteeType.BankGuarantee)
            {
                <div class="gl-v2-m-row"><span class="gl-v2-m-st @(!contract.GuaranteeDocumentMissing ? "is-ok" : "is-no")"><i class="ph @(!contract.GuaranteeDocumentMissing ? "ph-check" : "ph-x")" aria-hidden="true"></i></span><span class="gl-v2-m-rt"><b>Bankwaarborg</b></span>
                    @if (!string.IsNullOrWhiteSpace(contract.GuaranteeDocFilename)) { <a class="gl-v2-m-sv" href="@Url.Action("GuaranteeDoc", "Projecten", new { contractid = contract.Id })" target="_blank" rel="noopener">bekijken</a> }
                    else { <span class="gl-v2-m-sv is-no">nog te ontvangen</span> }
                </div>
            }
        </section>

        <section class="gl-v2-m-card">
            <div class="gl-v2-m-card-head"><span class="gl-v2-m-card-icon"><i class="ph ph-stack" aria-hidden="true"></i></span><b>Loten en bijbestellingen</b><span class="gl-v2-m-spacer"></span>
                @if (canWrite) { <a class="gl-v2-m-link" href="@mEdit"><i class="ph ph-plus" aria-hidden="true"></i>Bijbestelling</a> }
            </div>
            @if (contract.Activities?.Any() == true)
            {
                foreach (var lot in contract.Activities)
                {
                    <div class="gl-v2-m-row"><span class="gl-v2-m-rt"><b>@lot.Activity?.Name</b><small>@(lot.AdditionalOrdersTotal > 0 ? "basisprijs " + (lot.Price ?? 0m).ToString("C2", be) + " + bijbestellingen" : "basisprijs")</small></span><b class="gl-v2-m-eur">@lot.EffectivePrice.ToString("C2", be)</b></div>
                    foreach (var order in lot.AdditionalOrders)
                    {
                        <div class="gl-v2-m-row"><span class="gl-v2-m-rt"><small>↳ @(string.IsNullOrWhiteSpace(order.Description) ? "Bijbestelling" : order.Description)</small></span><b class="gl-v2-m-eur">@order.Price.ToString("C2", be)</b></div>
                    }
                }
                <div class="gl-v2-m-tip">Bijbestellingen verhogen de contractprijs en verschijnen hier per lot.</div>
                <div class="gl-v2-m-total"><span>Contractprijs</span><b>@mPrice.ToString("C2", be)</b></div>
            }
            else
            {
                <div class="gl-v2-m-tip">Geen loten gekoppeld aan dit contract.</div>
            }
        </section>
        </div>

        @* 64j: werfleider kiezen — radiorijen uit de contactpersonen van de leverancier, de hoofdknop noemt de keuze. *@
        @if (canWrite)
        {
            <div class="gl-v2-menu" id="@mSmSheet">
                <b class="gl-v2-menu-sheet-title">Werfleider kiezen</b>
                <div class="gl-v2-menu-sheet-sub">Contactpersonen van @companyName</div>
                <form method="post" action="@Url.Action("SetContractSiteManager", "Projecten")" class="js-gl-v2-m-sm-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectid" value="@Model.ProjectId" />
                    <input type="hidden" name="contractid" value="@contract.Id" />
                    @foreach (var ct in Model.Contacts)
                    {
                        var ctWords = ct.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        <label class="gl-v2-m-rad">
                            <input type="radio" name="contactid" value="@ct.ContactId" data-first="@(ctWords.FirstOrDefault() ?? ct.Name)" @(contract.SiteManagerContactId == ct.ContactId ? "checked" : "") />
                            <span class="gl-v2-m-avatar">@string.Concat(ctWords.Take(2).Select(w => char.ToUpperInvariant(w[0])))</span>
                            <span class="gl-v2-m-rt"><b>@ct.Name</b><small>@(ct.Role is null ? "" : ct.Role)@(ct.Role is not null && ct.Phone is not null ? " · " : "")@ct.Phone</small></span>
                            <span class="gl-v2-m-rd" aria-hidden="true"></span>
                        </label>
                    }
                    @if (Model.Contacts.Count == 0)
                    {
                        <div class="gl-v2-m-tip">Deze leverancier heeft nog geen contactpersonen.</div>
                    }
