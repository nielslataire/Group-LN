@model CPMCore.Models.Projecten.CopyChangeOrderModalV2Vm
@*
    Kopie van een offerte of wijzigingsopdracht (design-handoff 29a "+ Nieuw · Kopie van een wijzigingsopdracht" en
    29b "Kopie": lijst · "···" op een rij → "Kies eenheid — regels en plan worden overgenomen,
    handtekeningen niet" → 28a met Bron = de oorspronkelijke WO). Inhoud van #gl-v2-cc-modal op de lijst
    (20b), AJAX-geladen door ProjectenController.CopyChangeOrderModalV2; het formulier post naar
    ChangeOrderCopyV2.
*@
@using System.Globalization
<input type="hidden" name="projectId" value="@Model.ProjectId" />

<div class="gl-v2-field gl-v2-field-full">
    @await Html.PartialAsync("GlV2/_SelectList", new CPMCore.Models.GlV2.GlV2SelectListVm
    {
        Name = "changeOrderId", Id = "gl-v2-cc-order", Label = "Offerte of wijzigingsopdracht", Required = true,
        Placeholder = "— kies een offerte of wijzigingsopdracht —", Value = Model.ChangeOrderId > 0 ? Model.ChangeOrderId.ToString() : "",
        Items = Model.Sources.Select(o => new CPMCore.Models.GlV2.GlV2SelectItem
        {
            Value = o.Id.ToString(), Text = o.Display,
            Data = new Dictionary<string, string> { ["data-quote"] = o.IsQuote ? "true" : "false" }
        }).ToList()
    })
</div>

<div class="gl-v2-field gl-v2-field-full">
    <span class="gl-v2-field-label">Kopie als</span>
    <div class="gl-v2-radio-group" role="radiogroup" aria-label="Kopie als">
        <label class="gl-v2-radio"><input type="radio" name="asQuote" value="true" id="gl-v2-cc-as-quote" /><span>Offerte</span></label>
        <label class="gl-v2-radio"><input type="radio" name="asQuote" value="false" id="gl-v2-cc-as-wo" checked /><span>Wijzigingsopdracht</span></label>
    </div>
    <span class="gl-v2-field-help" id="gl-v2-cc-as-hint">Van een offerte maak je een kopie als offerte; omzetten naar een wijzigingsopdracht doe je via “Omzetten →”.</span>
</div>

<div class="gl-v2-field gl-v2-field-full">
    @await Html.PartialAsync("GlV2/_SelectList", new CPMCore.Models.GlV2.GlV2SelectListVm
    {
        Name = "clientAccountId", Id = "gl-v2-cc-client", Label = "Voor welke eenheid", Required = true,
        Placeholder = "— kies een klant · eenheid —", Value = "",
        Items = Model.Clients.Select(c => new CPMCore.Models.GlV2.GlV2SelectItem
        {
            Value = c.Id.ToString(),
            Text = c.Display + (string.IsNullOrWhiteSpace(c.UnitName) ? "" : " · " + c.UnitName),
            Data = new Dictionary<string, string> { ["data-vat-label"] = c.VatLabel ?? "" }
        }).ToList()
    })
    <span class="gl-v2-field-help" id="gl-v2-cc-client-hint">btw klant volgt de betalingsgroep van de gekozen eenheid</span>
</div>

<div class="gl-v2-notice gl-v2-notice-compact is-info gl-v2-field-full">
    <i class="ph ph-info" aria-hidden="true"></i>
    <span>Regels worden overgenomen, handtekeningen niet; een kopie als wijzigingsopdracht neemt ook het facturatieplan over. De kopie start als concept; het oorspronkelijke document blijft als bron gekoppeld.</span>
</div>
