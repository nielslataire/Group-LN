@model BOCore.ProjectPictureBO


<div id="modaladdphoto" class="modal-block modal-block-primary">
			@using (Html.BeginForm("UploadImage", "Projecten", FormMethod.Post, new { @class = "ecommerce-form", id = "FormAddPhoto", enctype = "multipart/form-data" }))
			{
		@Html.HiddenFor(m => m.ProjectId)
	<section class="card">
		<header class="card-header">
			<h2 class="card-title">Foto uploaden</h2>
		</header>
		<div class="card-body">

				<div class="form-group">
					<div class="row align-items-center  pb-3">
						<label class="col-md-4 control-label text-lg-end mb-0 mt-1" for="txtCaption">@Html.LabelFor(m => m.Caption)</label>
						<div class="col-md-8">
						@Html.TextBoxFor(m => m.Caption, new { @placeholder = "Omschrijving", @class = "form-control form-control-modern", @id = "txtCaption" })
						</div>
					</div>

					<div class="row align-items-center pb-3">
						<label class="col-md-4 control-label text-lg-end mb-0 mt-1" for="txtCaption">@Html.LabelFor(m => m.Type) </label>
						<div class="col-md-8">
							@Html.DropDownListFor(
													m => m.Type,
													Html.GetEnumSelectList<BOCore.PictureType>(),
													"-- Kies type --",                  // placeholder (optioneel)
													new { @class = "form-control form-control-modern", id = "Type" }
													)
						</div>
					</div>
					<div class="row align-items-center pb-3">
						<label class="col-md-4 control-label text-lg-end mb-0 mt-1" for="txtCaption">Selecteer foto </label>
						<div class="col-md-8">

								<input type="file"
									   id="file"
								   name="file"
									   accept="image/*"
									   class="form-control form-control-modern w-100" />
						</div>
					</div>
				</div>
			
		</div>
			<footer class="card-footer">
				<div class="row">
					<div class="col-md-12 text-end">
						<button type="submit" class="btn btn-primary">Uploaden</button>
						<button class="btn btn-default modal-dismiss">Annuleren</button>
					</div>
				</div>
			</footer>
		</section>
	}
</div>