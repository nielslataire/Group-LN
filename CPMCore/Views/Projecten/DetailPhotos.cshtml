@using CPMCore.Models.Projecten
@inject IConfiguration Configuration
@model DetailPhotosModel
@{
    var canWrite  = ViewBag.CanWriteProjectPhotos  as bool? ?? false;
    var canDelete = ViewBag.CanDeleteProjectPhotos as bool? ?? false;
    var imgBase   = ((string)ViewBag.ImageWebURL  ?? "").TrimEnd('/');
    var vidBase   = ((string)ViewBag.VideoWebURL  ?? imgBase).TrimEnd('/');

    var hoofdMedia = Model.Photos.FirstOrDefault(p => p.Type == BOCore.PictureType.Hoofdfoto);
    var allPhotos  = Model.Photos.Where(p => p.Type != BOCore.PictureType.Nieuws).ToList();
    var totalPhotos = allPhotos.Count(p => p.MediaType == 0);
    var totalVideos = allPhotos.Count(p => p.MediaType == 1);
}
@section PageStyle {
    <style>
        :root {
            --mg-green:      #0a5a3b;
            --mg-green-dark: #083d28;
            --mg-green-tint: #f3f8f5;
            --mg-green-light: #e6f1eb;
            --mg-border:     #e3e7ee;
            --mg-muted:      #8892a4;
            --mg-text:       #1f2937;
        }

        /* ── Page layout ───────────────────────────────── */
        .media-manager { padding: 0 0 120px; }

        /* ── Header card ───────────────────────────────── */
        .mm-header-card {
            border: 1px solid var(--mg-border);
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 20px;
            background: #fafbfc;
        }
        .mm-header-card > .row { align-items: stretch; }
        .mm-header-card .col-md-5 { display: flex; flex-direction: column; padding: 0; }
        .mm-hero-thumb {
            background: #1e2a22;
            position: relative;
            flex: 1;
            min-height: 260px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }
        .mm-hero-thumb img, .mm-hero-thumb video {
            width: 100%; height: 100%;
            object-fit: cover;
            position: absolute; inset: 0;
        }
        .mm-hero-badge {
            position: absolute; top: 12px; left: 12px;
            background: #d97706; color: #fff;
            font-size: 10px; font-weight: 700;
            text-transform: uppercase; letter-spacing: .6px;
            padding: 4px 10px; border-radius: 4px;
            display: flex; align-items: center; gap: 5px;
        }
        .mm-hero-placeholder {
            color: rgba(255,255,255,.35);
            font-size: 13px; font-weight: 600;
            letter-spacing: .5px; text-transform: uppercase;
        }
        .mm-hero-preview-btn {
            position: absolute; bottom: 12px; right: 12px;
            background: rgba(255,255,255,.9); border: none;
            border-radius: 6px; padding: 6px 14px;
            font-size: 12px; font-weight: 600; color: var(--mg-text);
            cursor: pointer; display: flex; align-items: center; gap: 6px;
            text-decoration: none;
        }
        .mm-detail-panel { padding: 24px 28px; }
        .mm-section-label {
            font-size: 10px; font-weight: 700; color: var(--mg-green);
            text-transform: uppercase; letter-spacing: .7px;
            display: flex; align-items: center; gap: 6px; margin-bottom: 10px;
        }
        .mm-section-label i { font-size: 14px; }
        .mm-detail-title { font-size: 22px; font-weight: 700; color: var(--mg-text); margin-bottom: 6px; }
        .mm-detail-desc  { font-size: 13px; color: var(--mg-muted); margin-bottom: 18px; line-height: 1.5; }
        .mm-meta-grid {
            display: grid; grid-template-columns: 1fr 1fr;
            gap: 10px 24px; margin-bottom: 20px;
        }
        .mm-meta-item label {
            font-size: 10px; font-weight: 700; color: var(--mg-muted);
            text-transform: uppercase; letter-spacing: .5px;
            display: flex; align-items: center; gap: 5px; margin-bottom: 3px;
        }
        .mm-meta-item .val {
            font-size: 13px; color: var(--mg-text); font-weight: 500;
            display: flex; align-items: center; gap: 5px;
        }
        .mm-visibility-badge {
            display: inline-flex; align-items: center; gap: 4px;
            font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 12px;
        }
        .mm-visibility-badge.public  { background: #dcfce7; color: #166534; }
        .mm-visibility-badge.private { background: #f3f4f6; color: #374151; }
        .mm-action-btns { display: flex; gap: 8px; flex-wrap: wrap; }
        .mm-action-btns .btn { font-size: 12.5px; padding: 7px 16px; }

        /* ── Section tabs ──────────────────────────────── */
        .mm-sections-bar {
            border: 1px solid var(--mg-border);
            border-radius: 10px; overflow: hidden; margin-bottom: 20px;
            background: #fafbfc;
        }
        .mm-sections-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 12px 18px;
            border-bottom: 1px solid var(--mg-border);
            background: #fafbfc;
        }
        .mm-sections-title {
            font-size: 12px; font-weight: 700; color: var(--mg-text);
            display: flex; align-items: center; gap: 6px;
        }
        .mm-sections-title i { color: var(--mg-green); }
        .mm-sections-scroll { display: flex; gap: 10px; padding: 14px 16px; overflow-x: auto; }
        .mm-section-tab {
            flex-shrink: 0; min-width: 130px;
            border: 1px solid var(--mg-border); border-radius: 8px;
            padding: 12px 14px; cursor: pointer; transition: all .15s;
            background: #fff;
        }
        .mm-section-tab:hover   { border-color: var(--mg-green); }
        .mm-section-tab.active  { border-color: var(--mg-green); background: var(--mg-green-tint); }
        .mm-section-tab .sect-label {
            font-size: 9px; font-weight: 700; color: var(--mg-muted);
            text-transform: uppercase; letter-spacing: .5px; margin-bottom: 3px;
        }
        .mm-section-tab .sect-name { font-size: 13px; font-weight: 600; color: var(--mg-text); }
        .mm-section-tab .sect-count { font-size: 11px; color: var(--mg-green); margin-top: 2px; }
        .mm-section-tab.active .sect-name  { color: var(--mg-green); }
        .mm-section-tab.active .sect-count { color: var(--mg-green-dark); }

        /* ── Filter bar ────────────────────────────────── */
        .mm-filter-bar {
            display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
            padding: 12px 16px;
            border: 1px solid var(--mg-border); border-radius: 10px;
            background: #fff; margin-bottom: 20px;
        }
        .mm-search { position: relative; flex: 1; min-width: 200px; }
        .mm-search input {
            width: 100%; padding: 7px 12px 7px 34px;
            border: 1px solid var(--mg-border); border-radius: 7px;
            font-size: 12.5px; color: var(--mg-text); outline: none;
        }
        .mm-search input:focus { border-color: var(--mg-green); }
        .mm-search i { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--mg-muted); font-size: 14px; }
        .mm-filter-label { font-size: 11px; font-weight: 600; color: var(--mg-muted); white-space: nowrap; }
        .mm-filter-chips { display: flex; gap: 6px; flex-wrap: wrap; }
        .mm-chip {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 5px 12px; border-radius: 20px; cursor: pointer;
            font-size: 11.5px; font-weight: 600; border: 1px solid transparent;
            transition: all .12s;
        }
        .mm-chip.all     { background: var(--mg-green); color: #fff; border-color: var(--mg-green); }
        .mm-chip.photos  { background: #fff; color: var(--mg-text); border-color: var(--mg-border); }
        .mm-chip.videos  { background: #fff; color: var(--mg-text); border-color: var(--mg-border); }
        .mm-chip.public  { background: #fff; color: var(--mg-text); border-color: var(--mg-border); }
        .mm-chip.private { background: #fff; color: var(--mg-text); border-color: var(--mg-border); }
        .mm-chip.active  { background: var(--mg-green-tint); color: var(--mg-green); border-color: var(--mg-green); }
        .mm-chip i { font-size: 13px; }
        .mm-sort-select {
            margin-left: auto; padding: 6px 10px;
            border: 1px solid var(--mg-border); border-radius: 7px;
            font-size: 12px; color: var(--mg-text); background: #fff;
        }

        /* ── Section group header ──────────────────────── */
        .mm-group-header {
            display: flex; align-items: center; justify-content: space-between;
            margin: 28px 0 12px;
        }
        .mm-group-title {
            display: flex; align-items: center; gap: 8px;
            font-size: 14px; font-weight: 700; color: var(--mg-green-dark);
        }
        .mm-group-title i { color: var(--mg-green-dark); }
        .mm-group-count {
            font-size: 11px; font-weight: 600; color: var(--mg-green-dark);
            background: var(--mg-green-light); padding: 2px 8px; border-radius: 10px;
        }
        .mm-group-desc { font-size: 10px; color: var(--mg-muted);font-weight: 300; }
        .mm-group-actions { display: flex; align-items: center; gap: 10px; }
        .mm-visibility-indicator {
            display: flex; align-items: center; gap: 5px;
            font-size: 11px; font-weight: 600; color: var(--mg-green);
        }

        /* ── Media grid ────────────────────────────────── */
        .mm-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 14px;
        }
        .mm-card {
            border-radius: 10px; overflow: hidden;
            border: 2px solid transparent;
            transition: all .15s; cursor: pointer; position: relative;
            background: #fff;
        }
        .mm-card:hover       { border-color: var(--mg-green); box-shadow: 0 2px 12px rgba(10,90,59,.12); }
        .mm-card.selected    { border-color: var(--mg-green); }
        .mm-card.selected .mm-card-thumb::after {
            content: ''; position: absolute; inset: 0;
            background: rgba(10,90,59,.15); pointer-events: none;
        }
        .mm-card-thumb {
            position: relative; width: 100%; padding-top: 75%;
            background: #f0f0f0; overflow: hidden;
        }
        .mm-card-thumb img, .mm-card-thumb video {
            position: absolute; inset: 0;
            width: 100%; height: 100%; object-fit: cover;
        }
        .mm-card-thumb .mm-play-icon {
            position: absolute; inset: 0;
            display: flex; align-items: center; justify-content: center;
            pointer-events: none;
        }
        .mm-card-thumb .mm-play-icon i {
            font-size: 36px; color: #fff;
            text-shadow: 0 2px 8px rgba(0,0,0,.5);
        }
        .mm-card-thumb .mm-duration {
            position: absolute; bottom: 6px; left: 8px;
            background: rgba(0,0,0,.65); color: #fff;
            font-size: 10px; font-weight: 600;
            padding: 2px 6px; border-radius: 4px;
        }
        .mm-type-badge {
            position: absolute; top: 8px; left: 8px;
            display: flex; flex-direction: column; gap: 4px;
        }
        .mm-badge {
            display: inline-flex; align-items: center; gap: 4px;
            font-size: 9px; font-weight: 700; text-transform: uppercase;
            padding: 2px 7px; border-radius: 4px; letter-spacing: .4px;
        }
        .mm-badge.photo   { background: rgba(255,255,255,.92); color: #1f2937; }
        .mm-badge.video   { background: #dc2626; color: #fff; }
        .mm-badge.pub     { background: var(--mg-green); color: #fff; }
        .mm-badge.priv    { background: #6b7280; color: #fff; }
        .mm-card-check {
            position: absolute; top: 8px; right: 8px; z-index: 5;
        }
        .mm-card-check input[type=checkbox] {
            width: 18px; height: 18px; cursor: pointer;
            accent-color: var(--mg-green);
        }
        .mm-card-hover-actions {
            position: absolute; bottom: 0; left: 0; right: 0;
            background: rgba(0,0,0,.55);
            display: flex; justify-content: center; gap: 4px;
            padding: 8px 6px;
            opacity: 0; transition: opacity .15s;
        }
        .mm-card-thumb:hover .mm-card-hover-actions { opacity: 1; }
        .mm-card-hover-actions a,
        .mm-card-hover-actions button {
            width: 30px; height: 30px; border-radius: 6px;
            background: rgba(255,255,255,.15); border: 1px solid rgba(255,255,255,.25);
            color: #fff; display: flex; align-items: center; justify-content: center;
            font-size: 14px; cursor: pointer; transition: background .1s;
            text-decoration: none;
        }
        .mm-card-hover-actions a:hover,
        .mm-card-hover-actions button:hover { background: rgba(255,255,255,.35); color: #fff; }
        .mm-card-hover-actions .del-btn { color: #fca5a5; }
        .mm-card-hover-actions .del-btn:hover { background: rgba(220,38,38,.5); color: #fff; }
        .mm-card-hover-actions .btn-set-hoofdfoto { color: #fde68a; }
        .mm-card-hover-actions .btn-set-hoofdfoto:hover { background: rgba(245,158,11,.5); color: #fff; }
        .mm-card-body { padding: 10px 12px 12px; }
        .mm-card-caption { font-size: 12.5px; font-weight: 600; color: var(--mg-text); margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .mm-card-meta { display: flex; align-items: center; justify-content: space-between; gap: 6px; }
        .mm-card-type { font-size: 11px; color: var(--mg-muted); }
        .mm-card-date { font-size: 10.5px; color: var(--mg-muted); white-space: nowrap; }
        .mm-card-section-select {
            width: 100%; margin-top: 6px;
            padding: 4px 8px; font-size: 11px;
            border: 1px solid var(--mg-border); border-radius: 5px;
            color: var(--mg-text); background: #fafbfc;
        }

        /* ── Add placeholder card ──────────────────────── */
        .mm-add-card {
            border: 2px dashed var(--mg-border); border-radius: 10px;
            min-height: 180px; background: #fff;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            cursor: pointer; color: var(--mg-green); gap: 6px;
            padding-left: 10px; padding-right: 10px;
            transition: border-color .15s, background .15s;
        }
        .mm-add-card:hover { border-color: var(--mg-green); background: var(--mg-green-tint); }
        .mm-add-card i { font-size: 24px; }
        .mm-add-card span { font-size: 12px; font-weight: 600; text-align: center; width: 100%; }

        /* ── Bulk action bar ───────────────────────────── */
        .mm-bulk-bar {
            position: fixed; bottom: 0; left: 0; right: 0; z-index: 1050;
            background: var(--mg-green);
            padding: 12px 24px;
            display: flex; align-items: center; gap: 14px;
            box-shadow: 0 -4px 20px rgba(0,0,0,.2);
            transform: translateY(100%);
            transition: transform .25s cubic-bezier(.34,1.56,.64,1);
        }
        .mm-bulk-bar.visible { transform: translateY(0); }
        .mm-bulk-count {
            font-size: 13px; font-weight: 700; color: #fff;
            white-space: nowrap;
        }
        .mm-bulk-actions { display: flex; gap: 8px; flex-wrap: wrap; }
        .mm-bulk-btn {
            padding: 7px 16px; border-radius: 7px; font-size: 12.5px; font-weight: 600;
            border: 1px solid rgba(255,255,255,.35); background: rgba(255,255,255,.15);
            color: #fff; cursor: pointer; display: flex; align-items: center; gap: 6px;
            transition: background .12s;
        }
        .mm-bulk-btn:hover    { background: rgba(255,255,255,.28); }
        .mm-bulk-btn.danger   { background: rgba(220,38,38,.35); border-color: rgba(220,38,38,.5); }
        .mm-bulk-btn.danger:hover { background: rgba(220,38,38,.55); }
        .mm-bulk-section-select {
            padding: 7px 10px; border-radius: 7px; font-size: 12px;
            border: 1px solid rgba(255,255,255,.35); background: rgba(255,255,255,.1);
            color: #fff; min-width: 160px;
        }
        .mm-bulk-section-select option { color: #1f2937; }
        .mm-bulk-close {
            margin-left: auto; background: transparent; border: none;
            color: rgba(255,255,255,.7); font-size: 20px; cursor: pointer;
        }

        /* ── Upload modal ──────────────────────────────── */
        .mm-upload-modal .modal-dialog { max-width: 540px; }
        .mm-upload-modal .modal-header { border-bottom: 1px solid var(--mg-border); }
        .mm-upload-modal .modal-title  { font-size: 16px; font-weight: 700; }
        .mm-drop-zone {
            border: 2px dashed var(--mg-border); border-radius: 10px;
            padding: 36px 24px; text-align: center;
            cursor: pointer; transition: border-color .15s, background .15s;
            margin-bottom: 14px;
        }
        .mm-drop-zone:hover, .mm-drop-zone.drag-over {
            border-color: var(--mg-green); background: var(--mg-green-tint);
        }
        .mm-drop-zone i    { font-size: 32px; color: var(--mg-green); margin-bottom: 8px; }
        .mm-drop-zone p    { margin: 0; font-size: 13px; color: var(--mg-muted); }
        .mm-drop-zone strong { color: var(--mg-green); }

        /* ── Misc ──────────────────────────────────────── */
        .mm-empty { text-align: center; padding: 40px 20px; color: var(--mg-muted); }
        .mm-empty i { font-size: 40px; margin-bottom: 10px; display: block; }
    </style>
}

