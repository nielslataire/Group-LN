<!-- ── Preview lightbox modal ──────────────────────────────────────── -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" style="max-width:min(92vw,1200px);">
    <div class="modal-content" style="background:#0d1117;border:none;border-radius:10px;overflow:hidden;">
      <div class="modal-header" style="background:#0d1117;border-bottom:1px solid rgba(255,255,255,.08);padding:10px 16px;">
        <span class="modal-title" id="previewModalTitle" style="color:#e5e7eb;font-size:14px;"></span>
        <button type="button" class="btn-close" data-bs-dismiss="modal" style="filter:invert(1) grayscale(1) brightness(2);"></button>
      </div>
      <div class="modal-body" style="padding:0;display:flex;align-items:center;justify-content:center;background:#0d1117;min-height:200px;">
        <img id="previewImg" src="" alt="" style="max-width:100%;max-height:80vh;object-fit:contain;display:none;" />
        <video id="previewVideo" controls style="max-width:100%;max-height:80vh;display:none;background:#000;"></video>
      </div>
    </div>
  </div>
</div>

@section PageScripts {
<script>
(function () {
    var projectId      = @Model.ProjectId;
    var antiForgery    = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    var selectedIds    = new Set();
    var sectionsData   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Sections.Select(s => new { id = s.Id, name = s.Name, description = s.Description ?? "", isPublic = s.IsPublic, mediaCount = s.MediaCount })));

    // ── Helpers ──────────────────────────────────────────────
    function postJson(url, body) {
        return fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': antiForgery
            },
            body: JSON.stringify(body)
        });
    }

    // ── Section tabs ──────────────────────────────────────────
    document.querySelectorAll('.mm-section-tab').forEach(function(tab) {
        tab.addEventListener('click', function() {
            document.querySelectorAll('.mm-section-tab').forEach(function(t) { t.classList.remove('active'); });
            tab.classList.add('active');
            var sectionId = tab.dataset.section;
            document.querySelectorAll('.mm-section-group').forEach(function(group) {
                if (sectionId === 'all') {
                    group.style.display = '';
                } else if (sectionId === 'none') {
                    group.style.display = (group.dataset.sectionId === 'none') ? '' : 'none';
                } else {
                    group.style.display = (group.dataset.sectionId === sectionId) ? '' : 'none';
                }
            });
        });
    });

    // ── Media filter chips ────────────────────────────────────
    document.querySelectorAll('.mm-chip').forEach(function(chip) {
        chip.addEventListener('click', function() {
            document.querySelectorAll('.mm-chip').forEach(function(c) { c.classList.remove('active'); });
            chip.classList.add('active');
            var filter = chip.dataset.filter;
            document.querySelectorAll('.mm-card').forEach(function(card) {
                var match = filter === 'all'
                    || (filter === 'photo'   && card.dataset.mediatype === '0')
                    || (filter === 'video'   && card.dataset.mediatype === '1')
                    || (filter === 'public'  && card.dataset.ispublic === 'true')
                    || (filter === 'private' && card.dataset.ispublic === 'false');
                card.style.display = match ? '' : 'none';
            });
        });
    });

    // ── Search ────────────────────────────────────────────────
    document.getElementById('mmSearch').addEventListener('input', function() {
        var q = this.value.toLowerCase();
        document.querySelectorAll('.mm-card').forEach(function(card) {
            var caption  = (card.dataset.caption  || '').toLowerCase();
            var filename = (card.dataset.filename || '').toLowerCase();
            card.style.display = (!q || caption.includes(q) || filename.includes(q)) ? '' : 'none';
        });
    });

    // ── Checkbox selection ────────────────────────────────────
    function updateBulkBar() {
        var bar = document.getElementById('bulkBar');
        document.getElementById('bulkCount').textContent = selectedIds.size;
        if (selectedIds.size > 0) bar.classList.add('visible');
        else bar.classList.remove('visible');
    }

    document.addEventListener('change', function(e) {
        if (e.target && e.target.classList.contains('mm-check')) {
            var id = parseInt(e.target.value);
            if (e.target.checked) selectedIds.add(id);
            else selectedIds.delete(id);
            var card = e.target.closest('.mm-card');
            if (card) card.classList.toggle('selected', e.target.checked);
            updateBulkBar();
        }
    });

    document.getElementById('bulkClose').addEventListener('click', function() {
        selectedIds.clear();
        document.querySelectorAll('.mm-check').forEach(function(cb) { cb.checked = false; });
        document.querySelectorAll('.mm-card').forEach(function(c) { c.classList.remove('selected'); });
        updateBulkBar();
    });

    // ── Bulk move ─────────────────────────────────────────────
    document.getElementById('bulkMoveBtn').addEventListener('click', function() {
        var sectionId = document.getElementById('bulkSectionSelect').value;
        if (!sectionId) { alert('Kies een sectie om naar te verplaatsen.'); return; }
        postJson('/Projecten/MoveMediaToSection', { MediaIds: [...selectedIds], SectionId: parseInt(sectionId) })
            .then(function() { location.reload(); });
    });

    // ── Bulk visibility ───────────────────────────────────────
    document.getElementById('bulkPublicBtn').addEventListener('click', function() {
        postJson('/Projecten/UpdateMediaVisibility', { MediaIds: [...selectedIds], IsPublic: true })
            .then(function() { location.reload(); });
    });
    document.getElementById('bulkPrivateBtn').addEventListener('click', function() {
        postJson('/Projecten/UpdateMediaVisibility', { MediaIds: [...selectedIds], IsPublic: false })
            .then(function() { location.reload(); });
    });

    // ── Bulk delete ───────────────────────────────────────────
    document.getElementById('bulkDeleteBtn').addEventListener('click', function() {
        if (!confirm('Weet u zeker dat u ' + selectedIds.size + ' item(s) wil verwijderen?')) return;
        postJson('/Projecten/BulkDeleteMedia', { MediaIds: [...selectedIds] })
            .then(function() { location.reload(); });
    });

    // ── Single delete ─────────────────────────────────────────
    document.addEventListener('click', function(e) {
        var btn = e.target.closest('[data-delete-id]');
        if (!btn) return;
        document.getElementById('deleteMediaId').value = btn.dataset.deleteId;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    });

    document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
        var id = document.getElementById('deleteMediaId').value;
        postJson('/Projecten/BulkDeleteMedia', { MediaIds: [parseInt(id)] })
            .then(function() { location.reload(); });
    });

    // ── Set as hoofdfoto/video ────────────────────────────────
    document.addEventListener('click', function(e) {
        var btn = e.target.closest('.btn-set-hoofdfoto');
        if (!btn) return;
        var id = parseInt(btn.dataset.id);
        postJson('/Projecten/SetHoofdMedia', { mediaId: id, projectId: projectId })
            .then(function(r) { if (r.ok) location.reload(); });
    });

    // ── Toggle visibility per card ────────────────────────────
    document.addEventListener('click', function(e) {
        var btn = e.target.closest('.btn-toggle-vis');
        if (!btn) return;
        var id        = parseInt(btn.dataset.id);
        var isPublic  = btn.dataset.current !== 'true';
        postJson('/Projecten/UpdateMediaVisibility', { MediaIds: [id], IsPublic: isPublic })
            .then(function() { location.reload(); });
    });

    // ── Section move per card ─────────────────────────────────
    document.addEventListener('change', function(e) {
        if (e.target && e.target.classList.contains('mm-section-select')) {
            var id        = parseInt(e.target.dataset.mediaId);
            var sectionId = e.target.value ? parseInt(e.target.value) : null;
            postJson('/Projecten/MoveMediaToSection', { MediaIds: [id], SectionId: sectionId });
        }
    });

    // ── Preview lightbox ──────────────────────────────────────
    (function() {
        var modal   = document.getElementById('previewModal');
        var img     = document.getElementById('previewImg');
        var video   = document.getElementById('previewVideo');
        var title   = document.getElementById('previewModalTitle');
        modal.addEventListener('show.bs.modal', function(e) {
            var btn     = e.relatedTarget;
            var src     = btn.dataset.src;
            var isVideo = btn.dataset.mediatype === '1';
            title.textContent = isVideo ? 'Video voorvertoning' : 'Foto voorvertoning';
            if (isVideo) {
                img.style.display   = 'none';
                video.style.display = '';
                video.src = src;
            } else {
                video.style.display = 'none';
                img.style.display   = '';
                img.src = src;
            }
        });
        modal.addEventListener('hide.bs.modal', function() {
            video.pause();
            video.src = '';
            img.src   = '';
        });
    })();

    // ── Edit caption modal ────────────────────────────────────
    document.getElementById('editModal').addEventListener('show.bs.modal', function(e) {
        var trigger = e.relatedTarget;
        document.getElementById('editMediaId').value  = trigger.dataset.id;
        document.getElementById('editCaption').value  = trigger.dataset.caption ?? '';
    });

    document.getElementById('confirmEditBtn').addEventListener('click', function() {
        var id      = parseInt(document.getElementById('editMediaId').value);
        var caption = document.getElementById('editCaption').value;
        postJson('/Projecten/UpdateMediaCaption', { mediaId: id, caption: caption })
            .then(function(r) { if (r.ok) location.reload(); });
    });

    // ── Section settings modal ────────────────────────────────
    (function() {
        var sectModal  = document.getElementById('sectionSettingsModal');
        var sectChanged = false;

        function esc(s) {
            return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function viewRow(s) {
            return '<div class="d-flex align-items-center gap-2 px-3 py-2" data-sect-id="' + s.id + '">' +
                '<div class="flex-grow-1 overflow-hidden">' +
                    '<div style="font-size:13px;font-weight:600;">' + esc(s.name) + '</div>' +
                    (s.description ? '<div style="font-size:11.5px;color:#8892a4;">' + esc(s.description) + '</div>' : '') +
                '</div>' +
                '<span class="badge ' + (s.isPublic ? 'text-bg-success' : 'text-bg-secondary') + '" style="font-size:10px;">' + (s.isPublic ? 'Publiek' : 'Intern') + '</span>' +
                '<span style="font-size:11px;color:#8892a4;white-space:nowrap;">' + s.mediaCount + ' items</span>' +
                '<button class="btn btn-outline-secondary btn-sm py-0 px-2 sect-edit-btn" title="Bewerken"><i class="bx bx-edit"></i></button>' +
                '<button class="btn btn-outline-danger btn-sm py-0 px-2 sect-del-btn" title="Verwijderen"><i class="bx bx-trash"></i></button>' +
            '</div>';
        }

        function editRow(s) {
            return '<div class="px-3 py-2" style="background:#f8f9fa;" data-sect-id="' + s.id + '">' +
                '<div class="row g-2 mb-2">' +
                    '<div class="col-md-5"><input class="form-control form-control-sm sect-edit-name" value="' + esc(s.name) + '" placeholder="Naam *" /></div>' +
                    '<div class="col-md-4"><input class="form-control form-control-sm sect-edit-desc" value="' + esc(s.description) + '" placeholder="Beschrijving" /></div>' +
                    '<div class="col-md-3"><select class="form-select form-select-sm sect-edit-public">' +
                        '<option value="true"' + (s.isPublic ? ' selected' : '') + '>Publiek</option>' +
                        '<option value="false"' + (!s.isPublic ? ' selected' : '') + '>Intern</option>' +
                    '</select></div>' +
                '</div>' +
                '<div class="d-flex gap-2">' +
                    '<button class="btn btn-primary btn-sm sect-save-btn"><i class="bx bx-save me-1"></i> Opslaan</button>' +
                    '<button class="btn btn-outline-secondary btn-sm sect-cancel-btn">Annuleren</button>' +
                '</div>' +
            '</div>';
        }

        function renderList() {
            var list = document.getElementById('sectSettList');
            if (!sectionsData.length) {
                list.innerHTML = '<div class="p-3 text-center text-muted" style="font-size:13px;">Nog geen secties aangemaakt.</div>';
                return;
            }
            list.innerHTML = sectionsData.map(function(s, i) {
                return (i > 0 ? '<hr class="my-0" />' : '') + viewRow(s);
            }).join('');
        }

        sectModal.addEventListener('show.bs.modal', renderList);

        sectModal.addEventListener('hidden.bs.modal', function() {
            if (sectChanged) location.reload();
        });

        document.getElementById('sectSettList').addEventListener('click', function(e) {
            var row, id, s;

            var editBtn = e.target.closest('.sect-edit-btn');
            if (editBtn) {
                row = editBtn.closest('[data-sect-id]');
                id  = parseInt(row.dataset.sectId);
                s   = sectionsData.find(function(x) { return x.id === id; });
                row.outerHTML = editRow(s);
                return;
            }

            var cancelBtn = e.target.closest('.sect-cancel-btn');
            if (cancelBtn) {
                row = cancelBtn.closest('[data-sect-id]');
                id  = parseInt(row.dataset.sectId);
                s   = sectionsData.find(function(x) { return x.id === id; });
                row.outerHTML = viewRow(s);
                return;
            }

            var saveBtn = e.target.closest('.sect-save-btn');
            if (saveBtn) {
                row      = saveBtn.closest('[data-sect-id]');
                id       = parseInt(row.dataset.sectId);
                var name = row.querySelector('.sect-edit-name').value.trim();
                var desc = row.querySelector('.sect-edit-desc').value.trim();
                var pub  = row.querySelector('.sect-edit-public').value === 'true';
                if (!name) { row.querySelector('.sect-edit-name').focus(); return; }
                postJson('/Projecten/UpdateMediaSection', { id: id, projectId: projectId, name: name, description: desc, isPublic: pub })
                    .then(function(r) {
                        if (!r.ok) return;
                        s = sectionsData.find(function(x) { return x.id === id; });
                        s.name = name; s.description = desc; s.isPublic = pub;
                        row.outerHTML = viewRow(s);
                        sectChanged = true;
                    });
                return;
            }

            var delBtn = e.target.closest('.sect-del-btn');
            if (delBtn) {
                row = delBtn.closest('[data-sect-id]');
                id  = parseInt(row.dataset.sectId);
                s   = sectionsData.find(function(x) { return x.id === id; });
                if (!confirm('Sectie "' + s.name + '" verwijderen? Media in deze sectie wordt losgekoppeld.')) return;
                fetch('/Projecten/DeleteMediaSection?id=' + id + '&projectId=' + projectId, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': antiForgery }
                }).then(function(r) {
                    if (!r.ok) return;
                    sectionsData = sectionsData.filter(function(x) { return x.id !== id; });
                    sectChanged = true;
                    renderList();
                });
            }
        });

        document.getElementById('addSectBtn').addEventListener('click', function() {
            var name = document.getElementById('newSectName').value.trim();
            var desc = document.getElementById('newSectDesc').value.trim();
            var pub  = document.getElementById('newSectPublic').value === 'true';
            if (!name) { document.getElementById('newSectName').focus(); return; }
            postJson('/Projecten/CreateMediaSection', { id: 0, projectId: projectId, name: name, description: desc, isPublic: pub })
                .then(function(r) { return r.json(); })
                .then(function(s) {
                    sectionsData.push({ id: s.id, name: s.name, description: s.description || '', isPublic: s.isPublic, mediaCount: 0 });
                    document.getElementById('newSectName').value = '';
                    document.getElementById('newSectDesc').value = '';
                    sectChanged = true;
                    renderList();
                });
        });
    })();

    // ── Upload modal: file input / drop zone ──────────────────
    var dropZone    = document.getElementById('dropZone');
    var fileInput   = document.getElementById('fileInput');
    var uploadSubmit = document.getElementById('uploadSubmit');
    var filePreview = document.getElementById('filePreview');

    dropZone.addEventListener('click', function() { fileInput.click(); });
    dropZone.addEventListener('dragover', function(e) { e.preventDefault(); dropZone.classList.add('drag-over'); });
    dropZone.addEventListener('dragleave', function() { dropZone.classList.remove('drag-over'); });
    dropZone.addEventListener('drop', function(e) {
        e.preventDefault(); dropZone.classList.remove('drag-over');
        if (e.dataTransfer.files.length) setFile(e.dataTransfer.files[0]);
    });
    fileInput.addEventListener('change', function() { if (this.files.length) setFile(this.files[0]); });

    function setFile(file) {
        document.getElementById('fileName').textContent = file.name;
        document.getElementById('fileSize').textContent = (file.size / 1024 / 1024).toFixed(2) + ' MB';
        var isVideo = file.type.startsWith('video/');
        document.getElementById('fileThumb').style.display  = isVideo ? 'none' : '';
        document.getElementById('videoIcon').style.display  = isVideo ? '' : 'none';
        if (!isVideo) {
            var reader = new FileReader();
            reader.onload = function(e) { document.getElementById('fileThumb').src = e.target.result; };
            reader.readAsDataURL(file);
        }
        filePreview.style.display = '';
        uploadSubmit.disabled = false;
        // Transfer the file to the actual input
        var dt = new DataTransfer();
        dt.items.add(file);
        fileInput.files = dt.files;
    }

    document.getElementById('clearFile').addEventListener('click', function() {
        fileInput.value = '';
        filePreview.style.display = 'none';
        uploadSubmit.disabled = true;
    });

    // Section pre-fill from button data attribute
    document.querySelectorAll('[data-bs-target="#uploadModal"][data-section]').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var sectionId = btn.dataset.section;
            if (sectionId) document.getElementById('uploadSectionSelect').value = sectionId;
        });
    });

    // Show upload progress
    document.getElementById('uploadForm').addEventListener('submit', function() {
        uploadSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Bezig…';
        uploadSubmit.disabled = true;
    });
})();
</script>
}
