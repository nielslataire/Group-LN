@using CPMCore.Controllers
@using BOCore
@inject IConfiguration Configuration
@model CPMCore.Models.Projecten.DetailPhotosModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
	ViewData["Title"] = Model.ProjectName + " - Foto's";
}
@section PageStyle
{
    <link rel="stylesheet" href="~/lib/bootstrap-fileupload/bootstrap-fileupload.min.css" />
    <link rel="stylesheet" href="~/lib/magnific-popup/magnific-popup.css" />

}
@Html.HiddenFor(m => m.ProjectId)
<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", Model.ProjectId)
        <div class="inner-body">
            <div class="row">
            <div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
                <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
                    <h1 class="font-weight-bold mb-0 mt-0">Foto's</h1>
                    <h5 class="mb-4 mt-0">Beheer de foto's van het project</h5>
                </div>
                <div class="col-sm-auto px-0">
                        <a href="#ModalAddPhoto" class="btn btn-primary btn-md addPhoto" data-id="@Model.ProjectId" id="btnAddPhoto"><i class="fas fa-upload me-1"></i> Foto uploaden</a>
@*                         <a href="#modaladdphoto" class="btn btn-primary btn-md modal-with-form" type="button" id="btnAddPhoto"><i class="fas fa-upload me-1"></i> Foto uploaden</a> *@
                </div>
            </div>
            @await Html.PartialAsync("Photos", Model)
@*             @await Html.PartialAsync("_ModalAddPhoto", new ProjectPictureBO { @ProjectId = Model.ProjectId, @Type = PictureType.Werffoto }) *@
            </div>
        </div>
    </div>
</section>

<div id="ModalDeletePhoto" class="modal-block modal-block-warning mfp-hide">
    <div id="delete-photo-container"></div>
</div>
<div id="ModalAddPhoto" class="modal-block modal-block-warning mfp-hide">
    <div id="add-photo-container"></div>
</div>

@section PageScripts
{
    <script src="~/lib/isotope/jquery.isotope.js"></script>
    <script src="~/lib/bootstrap-fileupload/bootstrap-fileupload.min.js"></script>
    <script src="~/js/examples/examples.mediagallery.js"></script>
    <script>
        $('.deletePhoto').click(function () {
            var url = "/Projecten/ModalDeletePhoto"; // the url to the controller
            var id = $(this).attr('data-id'); // the id that's given to each button in the list
            $.get(url + '/' + id, function (data) {
                $('#delete-photo-container').html(data);
            });
        });
        $('.addPhoto').click(function () {
            var url = "/Projecten/ModalAddPhoto"; // the url to the controller
            var id = $(this).attr('data-id'); // the id that's given to each button in the list
            $.get(url + '/' + id, function (data) {
                $('#add-photo-container').html(data);
            });
        });
        $(document).ready(function () {
            $('.deletePhoto').magnificPopup({
                type: 'inline',
                src: 'deletePhoto',
            });
                     $('.addPhoto').magnificPopup({
                type: 'inline',
                src: 'addPhoto',
            });
        });
    </script>
}