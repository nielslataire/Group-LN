<!-- ── Section settings modal ──────────────────────────────────────── -->
<div class="modal fade" id="sectionSettingsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title"><i class="bx bx-cog me-1"></i> Sectie-instellingen</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-0">
        <div id="sectSettList"></div>
        <div class="p-3 border-top">
          <div style="font-size:12px;font-weight:700;margin-bottom:8px;">Nieuwe sectie toevoegen</div>
          <div class="row g-2">
            <div class="col-md-5"><input class="form-control form-control-sm" id="newSectName" placeholder="Naam *" /></div>
            <div class="col-md-4"><input class="form-control form-control-sm" id="newSectDesc" placeholder="Beschrijving (optioneel)" /></div>
            <div class="col-md-3">
              <select class="form-select form-select-sm" id="newSectPublic">
                <option value="true">Publiek</option>
                <option value="false">Intern</option>
              </select>
            </div>
