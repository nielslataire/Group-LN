        @if (hoofdMedia != null)
        {
          <!-- Hoofdmedia hero card -->
          <div class="mm-header-card">
            <div class="row g-0">
              <div class="col-md-5">
                <div class="mm-hero-thumb">
                  <div class="mm-hero-badge"><i class="bx bx-crown"></i> Hoofdmedia</div>
                  @if (hoofdMedia.MediaType == 1)
                  {
                    <video src="@vidBase/videos/@hoofdMedia.Name" muted loop autoplay playsinline style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"></video>
                  }
                  else
                  {
                    <img src="@imgBase/pictures/800/@hoofdMedia.Name" alt="@hoofdMedia.Caption" />
                  }
                  <button type="button" class="mm-hero-preview-btn"
                          data-bs-toggle="modal" data-bs-target="#previewModal"
                          data-src="@(hoofdMedia.MediaType == 1 ? $"{vidBase}/videos/{hoofdMedia.Name}" : $"{imgBase}/pictures/{hoofdMedia.Name}")"
                          data-mediatype="@hoofdMedia.MediaType">
                    <i class="bx bx-eye"></i> Voorbeeld
                  </button>
                </div>
              </div>
              <div class="col-md-7">
                <div class="mm-detail-panel">
                  <div class="mm-section-label"><i class="bx bx-image-alt"></i> Toont bovenaan op de publieke projectpagina</div>
                  <div class="mm-detail-title">@(string.IsNullOrWhiteSpace(hoofdMedia.Caption) ? "(geen caption)" : hoofdMedia.Caption)</div>
                  <div class="mm-detail-desc">Dit beeld verschijnt als header bovenaan de publieke projectpagina. Bezoekers zien dit als allereerste.</div>
                  <div class="mm-meta-grid">
                    <div class="mm-meta-item">
                      <label><i class="bx bx-categories"></i> Type</label>
                      <div class="val">@(hoofdMedia.MediaType == 1 ? "Video" : "Foto")</div>
                    </div>
                    <div class="mm-meta-item">
                      <label><i class="bx bx-file"></i> Formaat</label>
                      <div class="val">@(System.IO.Path.GetExtension(hoofdMedia.Name).TrimStart('.').ToUpper())@(hoofdMedia.WidthPx.HasValue ? $" · {hoofdMedia.WidthPx}×{hoofdMedia.HeightPx}" : "")</div>
                    </div>
                    <div class="mm-meta-item">
                      <label><i class="bx bx-hard-drive"></i> Grootte</label>
                      <div class="val">@(hoofdMedia.FileSizeBytes.HasValue ? $"{hoofdMedia.FileSizeBytes.Value / 1024.0 / 1024.0:F1} MB" : "—")</div>
                    </div>
                    <div class="mm-meta-item">
                      <label><i class="bx bx-eye"></i> Zichtbaarheid</label>
                      <div class="val">
                        <span class="mm-visibility-badge @(hoofdMedia.IsPublic ? "public" : "private")">
                          <i class="bx @(hoofdMedia.IsPublic ? "bx-globe" : "bx-lock")"></i>
                          @(hoofdMedia.IsPublic ? "Publiek" : "Intern")
                        </span>
                      </div>
                    </div>
                  </div>
                  @if (canWrite)
                  {
                    <div class="mm-action-btns">
                      <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#uploadModal" data-type="Hoofdfoto">
                        <i class="bx bx-refresh-cw me-1"></i> Vervangen
                      </button>
                      <a href="#" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#editModal" data-id="@hoofdMedia.Id" data-caption="@hoofdMedia.Caption">
                        <i class="bx bx-edit me-1"></i> Bewerken
                      </a>
                      <a href="@(hoofdMedia.MediaType == 1 ? $"{vidBase}/videos/{hoofdMedia.Name}" : $"{imgBase}/pictures/{hoofdMedia.Name}")" download class="btn btn-outline-secondary btn-sm">
                        <i class="bx bx-arrow-in-down-square-half me-1"></i> Download
                      </a>
                    </div>
                  }
                </div>
              </div>
            </div>
          </div>
        }

        <!-- Sections bar -->
        @if (Model.Sections.Any())
        {
          <div class="mm-sections-bar">
            <div class="mm-sections-header">
              <div class="mm-sections-title"><i class="bx bx-table"></i> Plaatsing op de publieke website <span class="text-muted fw-normal ms-1" style="font-size:11px;">Kies waar elke foto of video getoond wordt</span></div>
              @if (canWrite)
              {
                <button class="btn btn-link btn-sm p-0 text-muted" type="button" data-bs-toggle="modal" data-bs-target="#sectionSettingsModal">
                  <i class="bx bx-cog me-1"></i> Sectie-instellingen
                </button>
              }
            </div>
            <div class="mm-sections-scroll">
              <div class="mm-section-tab active" data-section="all">
                <div class="sect-label">Alle secties</div>
                <div class="sect-name">Alles</div>
                <div class="sect-count">@allPhotos.Count items</div>
              </div>
              @{ int sIdx = 1; }
              @foreach (var section in Model.Sections)
              {
                <div class="mm-section-tab" data-section="@(section.Id)">
                  <div class="sect-label">Sectie @sIdx</div>
                  <div class="sect-name">@(section.Name)</div>
                  <div class="sect-count">@(section.MediaCount) items</div>
                </div>
                sIdx++;
              }
              <!-- Items zonder sectie -->
              @{ var noSectionCount = allPhotos.Count(p => p.SectionId == null); }
              @if (noSectionCount > 0)
              {
                <div class="mm-section-tab" data-section="none">
                  <div class="sect-label">Geen sectie</div>
                  <div class="sect-name">Overig</div>
                  <div class="sect-count">@noSectionCount items</div>
                </div>
              }
            </div>
          </div>
        }

        <!-- Filter bar -->
        <div class="mm-filter-bar">
          <div class="mm-search">
            <i class="bx bx-search"></i>
            <input type="text" id="mmSearch" placeholder="Zoek op caption, tag of bestandsnaam..." />
          </div>
          <span class="mm-filter-label">TOON:</span>
          <div class="mm-filter-chips">
            <span class="mm-chip all active" data-filter="all"><i class="bx bx-grid-alt"></i> Alles <strong>@allPhotos.Count</strong></span>
            <span class="mm-chip photos" data-filter="photo"><i class="bx bx-image"></i> Foto's <strong>@totalPhotos</strong></span>
            <span class="mm-chip videos" data-filter="video"><i class="bx bx-video"></i> Video's <strong>@totalVideos</strong></span>
            <span class="mm-chip public" data-filter="public"><i class="bx bx-globe"></i> Publiek</span>
            <span class="mm-chip private" data-filter="private"><i class="bx bx-lock"></i> Intern</span>
          </div>
          <select class="mm-sort-select" id="mmSort">
            <option value="newest">Nieuwste eerst</option>
            <option value="oldest">Oudste eerst</option>
            <option value="name">Naam A–Z</option>
          </select>
        </div>

        <!-- Media content -->
        <div id="mmContent">
          @if (!allPhotos.Any())
          {
            <div class="mm-empty">
              <i class="bx bx-images"></i>
              <p>Nog geen media geüpload voor dit project.</p>
              @if (canWrite)
              {
                <button class="btn btn-primary btn-sm mt-2" type="button" data-bs-toggle="modal" data-bs-target="#uploadModal">
                  <i class="bx bx-upload me-1"></i> Eerste media uploaden
                </button>
              }
            </div>
          }
          else
          {
            @* Grouped by section *@
            @foreach (var section in Model.Sections)
            {
              var sectionMedia = allPhotos.Where(p => p.SectionId == section.Id).ToList();
              <div class="mm-section-group" data-section-id="@(section.Id)">
                <div class="mm-group-header">
                  <div class="mm-group-title">
                    <i class="bx bx-folder-open"></i>
                    @(section.Name)
                    <span class="mm-group-count">@sectionMedia.Count items</span>
                    @if (!string.IsNullOrWhiteSpace(section.Description))
                    {
                      <span class="mm-group-desc">@(section.Description)</span>
                    }
                  </div>
                  <div class="mm-group-actions">
                    <span class="mm-visibility-indicator">
                      <i class="bx @(section.IsPublic ? "bx-globe" : "bx-lock")"></i>
                      @(section.IsPublic ? "Publiek zichtbaar" : "Intern")
                    </span>
                    @if (canWrite)
                    {
                      <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#uploadModal" data-section="@(section.Id)">
                        <i class="bx bx-plus me-1"></i> Toevoegen
                      </button>
                    }
                  </div>
                </div>
                <div class="mm-grid" data-section-grid="@(section.Id)">
                  @foreach (var item in sectionMedia)
                  {
                    @await Html.PartialAsync("Partials/_MediaCard", item, new ViewDataDictionary(ViewData)
                    {
                        { "ImgBase", imgBase }, { "VidBase", vidBase },
                        { "CanDelete", canDelete }, { "CanWrite", canWrite },
                        { "Sections", Model.Sections }
                    })
                  }
                  @if (canWrite)
                  {
                    <div class="mm-add-card" data-bs-toggle="modal" data-bs-target="#uploadModal" data-section="@(section.Id)">
                      <i class="bx bx-plus"></i>
                      <span>Foto of video toevoegen aan @(section.Name)</span>
                    </div>
                  }
                </div>
              </div>
            }

            @* Items zonder sectie *@
            var noSection = allPhotos.Where(p => p.SectionId == null).ToList();
            if (noSection.Any())
            {
              <div class="mm-section-group" data-section-id="none">
                <div class="mm-group-header">
                  <div class="mm-group-title"><i class="bx bx-folder"></i> Niet ingedeeld <span class="mm-group-count">@noSection.Count items</span></div>
                </div>
                <div class="mm-grid">
                  @foreach (var item in noSection)
                  {
                    @await Html.PartialAsync("Partials/_MediaCard", item, new ViewDataDictionary(ViewData)
                    {
                        { "ImgBase", imgBase }, { "VidBase", vidBase },
                        { "CanDelete", canDelete }, { "CanWrite", canWrite },
                        { "Sections", Model.Sections }
                    })
                  }
                </div>
              </div>
            }
          }
        </div>

      </div><!-- /media-manager -->
    </div>
  </div>
</section>

<!-- ── Bulk action bar ─────────────────────────────────────────────── -->
<div class="mm-bulk-bar" id="bulkBar">
  <span class="mm-bulk-count"><span id="bulkCount">0</span> geselecteerd</span>
  <div class="mm-bulk-actions">
    <select class="mm-bulk-section-select" id="bulkSectionSelect">
      <option value="">Verplaats naar sectie…</option>
      @foreach (var s in Model.Sections)
      {
        <option value="@s.Id">@s.Name</option>
      }
    </select>
    <button class="mm-bulk-btn" type="button" id="bulkMoveBtn"><i class="bx bx-transfer"></i> Verplaats</button>
    <button class="mm-bulk-btn" type="button" id="bulkPublicBtn"><i class="bx bx-globe"></i> Publiek</button>
    <button class="mm-bulk-btn" type="button" id="bulkPrivateBtn"><i class="bx bx-lock"></i> Intern</button>
    <button class="mm-bulk-btn danger" type="button" id="bulkDeleteBtn"><i class="bx bx-trash"></i> Verwijder</button>
  </div>
  <button class="mm-bulk-close" type="button" id="bulkClose"><i class="bx bx-x"></i></button>
</div>

<!-- ── Upload modal ────────────────────────────────────────────────── -->
<div class="modal fade mm-upload-modal" id="uploadModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bx bx-upload me-2 text-success"></i> Media uploaden</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form asp-action="UploadImage" asp-controller="Projecten" method="post" enctype="multipart/form-data" id="uploadForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="UploadedBO.ProjectId" value="@Model.ProjectId" />
        <input type="hidden" name="UploadedBO.Type" value="1" />
        <input type="hidden" name="UploadedBO.SectionId" id="uploadSectionId" />
        <input type="hidden" name="UploadedBO.IsPublic" value="true" />

        <div class="modal-body">
          <div class="mm-drop-zone" id="dropZone">
            <i class="bx bx-cloud-upload"></i>
            <p><strong>Sleep bestanden hierheen</strong> of klik om te selecteren</p>
            <p style="font-size:11px;">JPG, PNG, WebP, GIF, MP4, WebM · Max 500MB</p>
            <input type="file" name="file" id="fileInput" accept="image/*,video/mp4,video/webm" style="display:none;" />
          </div>
          <div id="filePreview" style="display:none;" class="mb-3">
            <div class="d-flex align-items-center gap-3 p-2 border rounded">
              <img id="fileThumb" src="" alt="" style="width:60px;height:60px;object-fit:cover;border-radius:6px;display:none;" />
              <i class="bx bx-video" id="videoIcon" style="font-size:36px;color:var(--mg-green);display:none;"></i>
              <div>
                <div id="fileName" style="font-size:13px;font-weight:600;"></div>
                <div id="fileSize" style="font-size:11px;color:var(--mg-muted);"></div>
              </div>
              <button type="button" class="btn btn-link btn-sm ms-auto text-danger p-0" id="clearFile"><i class="bx bx-x"></i></button>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label" style="font-size:12px;font-weight:600;">Caption <span class="text-muted fw-normal">(optioneel)</span></label>
            <input type="text" class="form-control form-control-sm" name="UploadedBO.Caption" placeholder="Beschrijf het beeld…" />
          </div>
          <div class="row g-2">
            <div class="col-6">
              <label class="form-label" style="font-size:12px;font-weight:600;">Sectie</label>
              <select class="form-select form-select-sm" name="UploadedBO.SectionId" id="uploadSectionSelect">
                <option value="">— Geen sectie —</option>
                @foreach (var s in Model.Sections)
                {
                  <option value="@s.Id">@s.Name</option>
                }
              </select>
            </div>
            <div class="col-6">
              <label class="form-label" style="font-size:12px;font-weight:600;">Zichtbaarheid</label>
              <select class="form-select form-select-sm" name="UploadedBO.IsPublic">
                <option value="true">Publiek</option>
                <option value="false">Intern</option>
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Annuleren</button>
          <button type="submit" class="btn btn-primary btn-sm" id="uploadSubmit" disabled>
            <i class="bx bx-upload me-1"></i> Uploaden
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ── Delete confirm modal ───────────────────────────────────────── -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <div class="modal-header border-0 pb-0">
        <h6 class="modal-title text-danger"><i class="bx bx-trash me-1"></i> Verwijderen</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body pt-2">
        <p style="font-size:13px;" class="mb-0">Weet u zeker dat u dit mediabestand wil verwijderen? Dit kan niet ongedaan worden gemaakt.</p>
        <input type="hidden" id="deleteMediaId" />
      </div>
      <div class="modal-footer border-0">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Annuleren</button>
        <button type="button" class="btn btn-danger btn-sm" id="confirmDeleteBtn"><i class="bx bx-trash me-1"></i> Verwijder</button>
      </div>
    </div>
  </div>
</div>

<!-- ── Edit caption modal ──────────────────────────────────────────── -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <div class="modal-header border-0 pb-0">
        <h6 class="modal-title"><i class="bx bx-edit me-1"></i> Caption bewerken</h6>
