@model CPMCore.Models.Projecten.ProjectIncommingInvoiceAddUpdateModel
@using BOCore
@using CPMCore.Models.GlV2
@*
    gl-v2 — Factuur bewerken. Zelfde formulier als AddIncommingInvoiceV2 (zelfde partials, CSS en JS: gl-v2-projecten-incommininvoice-add.*),
    maar het post naar de BESTAANDE EditIncommingInvoice-actie met de verborgen IncommingInvoice.Id, zodat opslaan de bestaande factuur
    bijwerkt i.p.v. een nieuwe aan te maken. Model en Html.BeginCollectionItem("details")-binding zijn ongewijzigd; Factuurnummer, -datum en
    alle andere velden komen ingevuld uit de opgeslagen factuur. Wijzig je iets aan AddIncommingInvoiceV2, controleer dan ook deze view.
*@
@{
    ViewData["Title"] = "Factuur bewerken";
    ViewData["PageIcon"] = "bx bx-receipt";
    ViewData["GlV2FullHeightBody"] = true;
    ViewData["BackUrl"] = Url.Action("Recalculation", "Projecten", new { projectid = Model.ProjectId });
    var kindValue = ((int?)Model.IncommingInvoice.Kind) ?? 0;
}
@section PageStyle
{
    <link rel="stylesheet" href="~/css/gl-v2-projecten-incommininvoice-add.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-projecten-inhouding.css" asp-append-version="true" />
}

<form method="post" asp-action="EditIncommingInvoice" asp-controller="Projecten" id="gln-ai-form" autocomplete="off">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ProjectId" />
    <input type="hidden" asp-for="Type" />
    <input type="hidden" asp-for="ProjectName" />
    <input type="hidden" asp-for="CompanyName" />
    <input type="hidden" asp-for="IncommingInvoice.Id" />
    @* Plain hidden input (geen asp-for): de tag helper zou de value overschrijven met Model.IncommingInvoice.Kind
       (Nothing bij een nieuwe factuur → lege string), terwijl deze V2-form altijd een expliciete 0/1/2 wil
       versturen zodat IncommingInvoiceTranslator dit (voorwaardelijk) wegschrijft — zie de toelichting daar. *@
    <input type="hidden" name="IncommingInvoice.Kind" id="gln-ai-kind" value="@kindValue" />

    <div class="gln-ai-grid">
        <div class="gln-ai-main">
            @* Upload-dropzone (design-handoff 42c, 06) — enkel kolom 1, zodat het contractinfo-paneel
               ernaast staat i.p.v. er volledig onder. Leverancier/nummer/datum/bedrag worden ingevuld;
               de gebruiker kiest zelf nog altijd het Contract/Bedrijf (geen automatische matching op
               naam, te foutgevoelig om blind te vertrouwen). *@
            @await Html.PartialAsync("GlV2/_Dropzone", new GlV2DropzoneVm { Id = "gln-ai-file-input", Accept = "application/pdf,.pdf", Layout = "bar", Mode = "select", StatusSlot = true, Title = "Sleep de PDF van de factuur hierheen — nummer, datum, vervaldatum en bedrag worden ingevuld", LinkText = "kies een bestand", AriaLabel = "PDF van de factuur kiezen" })

            <section class="gl-v2-section-card">
                <div class="gl-v2-section-card-header">
                    <span class="gl-v2-section-card-icon"><i class="ph ph-info" aria-hidden="true"></i></span>
                    <h2 class="gl-v2-section-card-title">Algemene info</h2>
                    <span class="gl-v2-field-divider"></span>
                    <span class="gl-v2-section-card-desc">leverancier en contract eerst — de rest volgt uit het contract</span>
                </div>
                <div class="gl-v2-section-grid">
                    <div class="gl-v2-col-6">
                        <div class="gl-v2-field">
                            <label class="gl-v2-field-label">Contract</label>
                            @await Html.PartialAsync("GlV2/_Segmented", new GlV2SegmentedVm
                            {
                                Id = "gln-ai-contracttype-segmented", Outline = true, AriaLabel = "Met of zonder contract",
                                Items = new()
                                {
                                    new() { Text = "Met contract", Active = Model.Type == 0, Data = { ["contracttype"] = "0" } },
                                    new() { Text = "Zonder contract", Active = Model.Type != 0, Data = { ["contracttype"] = "1" } },
                                },
                            })
                        </div>
                    </div>
                    <div class="gl-v2-col-6" id="gln-ai-contract-field"@(Model.Type != 0 ? " hidden" : "")>
                        <div class="gl-v2-field">
                            <label class="gl-v2-field-label" for="lstProjectContracts_input">Welk contract</label>
                            @{
                                var huidigContract = Model.ProjectContracts.FirstOrDefault(c => Model.IncommingInvoice.ContractID > 0 && c.ID == Model.IncommingInvoice.ContractID);
                            }
                            @await Html.PartialAsync("GlV2/_GlV2Combo", new GlV2ComboVm
                            {
                                // Zelfde component als het leveranciersveld hieronder (zoekveld), maar met een
                                // statische lijst (OptionsJson, geen LookupUrl) die meteen al onder het veld
                                // staat zodra je erin klikt — er zijn doorgaans maar enkele contracten per
                                // project, geen reden om eerst te moeten typen zoals bij de leveranciers-AJAX.
                                Name = "IncommingInvoice.ContractID", Id = "lstProjectContracts",
                                Value = (Model.IncommingInvoice.ContractID ?? 0).ToString(), EmptyValue = "0",
                                DisplayText = huidigContract?.Display,
                                Placeholder = "Zoek of kies een contract…",
                                OptionsJson = System.Text.Json.JsonSerializer.Serialize(Model.ProjectContracts.Select(c => new { id = c.ID, text = c.Display })),
                                ListLabel = "Alle contracten", MinChars = 0, Icon = "ph-file-text",
                                Help = "Geen contract? Voeg eerst een contract toe, of kies \"Zonder contract\" hierboven.",
                            })
                        </div>
                    </div>
                    <div class="gl-v2-col-6" id="gln-ai-company-field"@(Model.Type == 0 ? " hidden" : "")>
                        <div class="gl-v2-field">
                            <label class="gl-v2-field-label" for="txtCompanyID_input">Leverancier</label>
                            @await Html.PartialAsync("GlV2/_GlV2Combo", new GlV2ComboVm
                            {
                                Name = "IncommingInvoice.CompanyId", Id = "txtCompanyID",
                                Value = (Model.IncommingInvoice.CompanyId ?? 0).ToString(), EmptyValue = "0",
                                DisplayText = string.IsNullOrWhiteSpace(Model.CompanyName) ? null : Model.CompanyName,
                                Placeholder = "Zoek een leverancier…",
                                LookupUrl = Url.Action("GetCompanys", "Projecten"), MinChars = 3, Icon = "ph-buildings",
                            })
                        </div>
                    </div>
                    <div class="gl-v2-col-6">
                        @Html.EditorFor(m => m.IncommingInvoice.InvoiceExternalId, "GlV2Text", new { Label = "Factuurnummer" })
                    </div>
                    <div class="gl-v2-col-6">
                        <div class="gl-v2-field">
                            <label class="gl-v2-field-label">Type</label>
                            @await Html.PartialAsync("GlV2/_Segmented", new GlV2SegmentedVm
                            {
                                Id = "gln-ai-kind-segmented", Outline = true, AriaLabel = "Type factuur",
                                Items = new()
                                {
                                    new() { Text = "Vordering", Active = kindValue == 0, Data = { ["kind"] = "0" } },
                                    new() { Text = "Eindvordering", Active = kindValue == 1, Data = { ["kind"] = "1" } },
                                    new() { Text = "Creditnota", Active = kindValue == 2, Data = { ["kind"] = "2" } },
                                },
                            })
                        </div>
                    </div>
                    @* Drie gelijke kolommen op desktop (col-4 elk): Factuurdatum, Vervaldatum, Factuurbedrag
                       samen op één rij — niet Factuurdatum alleen op zijn eigen volle rij. *@
                    <div class="gl-v2-col-4">
                        @Html.EditorFor(m => m.IncommingInvoice.IncommingInvoiceDate, "GlV2Date", new { Label = "Factuurdatum" })
                    </div>
                    <div class="gl-v2-col-4">
                        <div class="gl-v2-field">
                            <label class="gl-v2-field-label">Vervaldatum</label>
                            <div class="gl-v2-field-box" id="gln-ai-vervaldatum-box"><input type="date" class="gl-v2-field-input" id="gln-ai-vervaldatum" value="@(Model.IncommingInvoice.DueDate?.ToString("yyyy-MM-dd"))" /></div>
                            <span class="gl-v2-field-help" id="gln-ai-vervaldatum-hint"></span>
                            <span class="gl-v2-field-help" id="gln-ai-korting-hint"></span>
                        </div>
                    </div>
                    <div class="gl-v2-col-4">
                        @Html.EditorFor(m => m.IncommingInvoice.InvoicePrice, "GlV2Currency", new { Label = "Factuurbedrag", Required = true })
                    </div>
                </div>
                @await Html.PartialAsync("Partials/_IncommingInvoiceBorgV2", Model)
            </section>

            <section class="gl-v2-section-card">
                <div class="gl-v2-section-card-header">
                    <span class="gl-v2-section-card-icon"><i class="ph ph-list-bullets" aria-hidden="true"></i></span>
                    <h2 class="gl-v2-section-card-title">Factuurregels</h2>
                    <span class="gl-v2-field-divider"></span>
                    <span class="gl-v2-section-card-desc">per activiteit een regel — meerwerk voor een klant hang je aan de eenheid via de WO-kolom</span>
                </div>
                <div class="gln-ai-addrow">
                    @await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm
                    {
                        Name = "gln-ai-activiteit-value", Id = "lstActivities", Bare = true,
                        Placeholder = "Selecteer de activiteit…",
                        Items = Model.ListActivities.Where(a => a.ID != 0).Select(a => new GlV2SelectItem { Value = a.ID.ToString(), Text = a.Display }).ToList(),
                    })
                    <button type="button" class="gl-v2-btn gl-v2-btn-secondary" id="btnAddActivities"><i class="ph ph-plus" aria-hidden="true"></i>Toevoegen</button>
                </div>
                <div class="gln-ai-row-grid gln-ai-row-head">
                    <span>Lot</span><span>Type</span><span>Omschrijving</span><span>Bedrag</span><span>WO</span><span></span>
                </div>
                <div id="DetailRows">
                    @foreach (var item in Model.IncommingInvoice.Details)
                    {
                        @await Html.PartialAsync("_IncommingInvoiceDetailRowV2", item)
                    }
                </div>

                @* Legende (design-handoff 42c): de 4 regeltypes — overgenomen woord voor woord. *@
                <div class="gln-ai-legend">
                    <div class="gln-ai-legend-item"><span class="gl-v2-badge is-positive">Contract</span><span>telt mee in gecontracteerd vs gefactureerd</span></div>
                    <div class="gln-ai-legend-item"><span class="gl-v2-badge is-attention">Meerwerk klant</span><span>wordt doorgerekend aan de klant · eenheid verplicht, WO optioneel</span></div>
                    <div class="gln-ai-legend-item"><span class="gl-v2-badge is-neutral">Meerwerk algemeen</span><span>kost voor het project, niet doorgerekend</span></div>
                    <div class="gln-ai-legend-item"><span class="gl-v2-badge is-neutral">Geen contract</span><span>enkel als de factuur geen contract heeft</span></div>
                </div>
            </section>
        </div>

        <aside class="gln-ai-side">
            <section class="gl-v2-section-card" id="gln-ai-contract-card" hidden>
                <div class="gl-v2-section-card-header">
                    <span class="gl-v2-section-card-icon"><i class="ph ph-file-text" aria-hidden="true"></i></span>
                    <h2 class="gl-v2-section-card-title">Contract</h2>
                    <span class="gl-v2-section-card-spacer"></span>
                    <span class="gl-v2-badge is-positive" id="gln-ai-contract-signed" hidden>Getekend</span>
                </div>
                <div class="gln-ai-contract-body" id="gln-ai-contract-body">
                    <div class="gln-ai-contract-name" id="gln-ai-contract-name">—</div>

                    @* Gefactureerd incl. deze factuur — "eerder" (reeds gefactureerd, van de server) en
                       "deze" (som van de regels hieronder, live, zie updateContractLiveCijfers()). *@
                    <div class="gl-v2-progress" id="gln-ai-contract-progress" hidden>
                        <div class="gl-v2-progress-row">
                            <span class="gl-v2-progress-label">Gefactureerd incl. deze factuur</span>
                            <span class="gl-v2-progress-spacer"></span>
                            <span class="gl-v2-progress-value" id="gln-ai-contract-pct">0 %</span>
                        </div>
                        <div class="gl-v2-progress-track is-standard gln-ai-contract-track">
                            <div class="gl-v2-progress-fill gln-ai-contract-fill-prior" id="gln-ai-contract-fill-prior"></div>
                            <div class="gl-v2-progress-fill gln-ai-contract-fill-current" id="gln-ai-contract-fill-current"></div>
                        </div>
                        <div class="gln-ai-contract-legend">
                            <span class="gln-ai-contract-legend-item"><span class="gln-ai-contract-legend-dot is-prior"></span>eerder <span id="gln-ai-contract-eerder">€ 0</span></span>
                            <span class="gln-ai-contract-legend-item"><span class="gln-ai-contract-legend-dot is-current"></span>deze <span id="gln-ai-contract-deze">€ 0</span></span>
                        </div>
                    </div>

                    <div class="gln-ai-contract-grid">
                        <span class="gln-ai-contract-grid-label">Contractbedrag</span><span class="gln-ai-contract-grid-value" id="gln-ai-contract-bedrag">—</span>
                        <span class="gln-ai-contract-grid-label">Meerwerk (WO)</span><span class="gln-ai-contract-grid-value" id="gln-ai-contract-meerwerk">—</span>
                        <span class="gln-ai-contract-grid-label">Reeds gefactureerd</span><span class="gln-ai-contract-grid-value" id="gln-ai-contract-reedsgefactureerd">—</span>
                        <span class="gln-ai-contract-grid-label">Saldo na deze factuur</span><span class="gln-ai-contract-grid-value is-strong" id="gln-ai-contract-saldo">—</span>
                    </div>

                    <div class="gln-ai-contract-details">
                        <div class="gln-ai-contract-detail-row" id="gln-ai-contract-row-borg" hidden>
                            <span class="gln-ai-contract-detail-label">Borg</span>
                            <div class="gln-ai-contract-detail-text">
                                <span id="gln-ai-contract-waarborg">—</span>
                                <span class="gln-ai-contract-detail-hint" id="gln-ai-contract-waarborg-hint"></span>
                            </div>
                        </div>
                        <div class="gln-ai-contract-detail-row" id="gln-ai-contract-row-korting" hidden>
                            <span class="gln-ai-contract-detail-label">Korting contant</span>
                            <div class="gln-ai-contract-detail-text">
                                <span id="gln-ai-contract-korting">—</span>
                                <span class="gln-ai-contract-detail-hint" id="gln-ai-contract-korting-hint"></span>
                            </div>
                        </div>
                        <div class="gln-ai-contract-detail-row">
                            <span class="gln-ai-contract-detail-label">Betaaltermijn</span>
                            <div class="gln-ai-contract-detail-text">
                                <span id="gln-ai-contract-termijn">—</span>
                                <span class="gln-ai-contract-detail-hint" id="gln-ai-contract-termijn-hint"></span>
                            </div>
                        </div>
                        <div class="gln-ai-contract-detail-row">
                            <span class="gln-ai-contract-detail-label">Btw</span>
                            <div class="gln-ai-contract-detail-text">
                                <span id="gln-ai-contract-btw">—</span>
                            </div>
                        </div>
                    </div>

                    <div class="gln-ai-contract-open-row">
                        <a href="#" class="gl-v2-btn gl-v2-btn-secondary gln-ai-contract-open" id="gln-ai-contract-open" target="_blank" rel="noopener">
                            <i class="ph ph-file-text" aria-hidden="true"></i>Contract openen
                        </a>
                    </div>
                </div>
            </section>
            <div class="gl-v2-notice gl-v2-notice-compact is-info" id="gln-ai-geencontract-notice" hidden>
                <i class="ph ph-info" aria-hidden="true"></i><span><strong>Factuur zonder contract.</strong> Geen borg, korting of betaaltermijn uit een contract. Vervaldatum, eventuele borg en korting vul je zelf in. De factuur telt niet mee in gecontracteerd tegenover gefactureerd.</span>
            </div>
            @* Kaart "Te betalen" onder de contractkaart (design-handoff 42c): rekent live mee met factuurbedrag, extra inhouding, borg en korting contant. *@
            <section class="gl-v2-section-card" id="gln-ai-betalen-card" hidden>
                <div class="gl-v2-section-card-header">
                    <span class="gl-v2-section-card-icon"><i class="ph ph-coins" aria-hidden="true"></i></span>
                    <h2 class="gl-v2-section-card-title">Te betalen</h2>
                    <span class="gl-v2-section-card-spacer"></span>
                    <span class="gl-v2-section-card-desc">rekent live mee</span>
                </div>
                <div class="gln-ai-pay">
                    <div class="gln-ai-pay-row"><span class="gln-ai-pay-label">Factuurbedrag<small>excl. btw</small></span><span class="gln-ai-pay-value" id="gln-pay-factuur">—</span></div>
                    <div class="gln-ai-pay-row" id="gln-pay-inh-row" hidden><span class="gln-ai-pay-label">Extra inhouding<small>tijdelijk niet betalen</small></span><span class="gln-ai-pay-value" id="gln-pay-inh">—</span></div>
                    @* Borg: oranje waarschuwingskader met pil, vrijgaveregel en bedrag (42c) *@
                    <div class="gln-ai-pay-borg" id="gln-pay-borg-row" hidden>
                        <span class="gln-ai-pay-pill" id="gln-pay-borg-label">Borg</span>
                        <span class="gln-ai-pay-borgsub" id="gln-pay-borg-sub"></span>
                        <span class="gln-ai-pay-borgwaarde" id="gln-pay-borg">—</span>
                    </div>
                    <div class="gln-ai-pay-totaal"><span>Te betalen</span><span id="gln-pay-totaal">—</span></div>
                </div>
                @* Korting contant: groen infokader met witte rij voor het bedrag en de uiterste betaaldatum (42c) *@
                <div class="gln-ai-pay-korting" id="gln-pay-korting-blok" hidden>
                    <div class="gln-ai-pay-korting-kop">
                        <i class="ph ph-seal-percent" aria-hidden="true"></i>
                        <span class="gln-ai-pay-korting-titel" id="gln-pay-korting-label">Korting contant</span>
                        <span class="gln-ai-pay-dagen" id="gln-pay-korting-sub"></span>
                    </div>
                    <div class="gln-ai-pay-korting-wit" id="gln-pay-korting-rij">
                        <span id="gln-pay-korting-datum">korting bij betaling vóór</span>
                        <span class="gln-ai-pay-korting-waarde" id="gln-pay-korting">—</span>
                    </div>
                    <div class="gln-ai-pay-korting-tot" id="gln-pay-metkorting-rij">
                        <span>Te betalen met korting</span>
                        <span id="gln-pay-metkorting">—</span>
                    </div>
                </div>
            </section>
        </aside>
    </div>

    @* Actiebalk — somcontrole: som van de regels vs. Factuurbedrag (design-handoff 42e punt 05). *@
    <div class="gl-v2-form-actionbar">
        <span class="gln-ai-somcontrole" id="gln-ai-somcontrole"><i class="ph ph-circle-dashed" aria-hidden="true"></i><span id="gln-ai-somcontrole-tekst">Nog geen regels</span></span>
        <span class="gln-ai-betalen" id="gln-ai-betalen" hidden></span>
        <span class="gl-v2-form-actionbar-spacer"></span>
        <a href="@Url.Action("Recalculation", "Projecten", new { projectid = Model.ProjectId })" class="gl-v2-btn gl-v2-btn-text">Annuleren</a>
        <button type="submit" class="gl-v2-btn gl-v2-btn-primary"><i class="ph ph-check" aria-hidden="true"></i>Wijzigingen opslaan</button>
    </div>
</form>

@if (Model.InhoudingDetail != null)
{
    @await Html.PartialAsync("Partials/_InhoudingAfhandelenV2", Model.ProjectId)
}

@section PageScripts
{
    <script>
        window.glV2AddIncommingInvoiceConfig = {
            type: @Model.Type,
            invoiceId: @(Model.IncommingInvoice.Id),
            focusUpload: @((ViewData["FocusUpload"] as bool? ?? false).ToString().ToLowerInvariant()),
            contractId: @(Model.IncommingInvoice.ContractID ?? 0),
            companyId: @(Model.IncommingInvoice.CompanyId ?? 0),
            getContractActivitiesUrl: '@Url.Action("GetContractActivities", "Projecten")',
            getCompanyActivitiesUrl: '@Url.Action("GetCompanyActivities", "Projecten")',
            getCompanysUrl: '@Url.Action("GetCompanys", "Projecten")',
            addRowUrl: '@Url.Action("AddIncommingInvoiceDetailRowV2", "Projecten")',
            contractInfoUrl: '@Url.Action("GetContractInfoForInvoiceFormV2", "Projecten")',
            extractPdfUrl: '@Url.Action("AddIncommingInvoiceV2ExtractPdf", "Projecten")',
            contractOpenUrl: '@Url.Action("DetailContract", "Projecten", new { projectid = Model.ProjectId, contractid = 0 })',
        };
    </script>
    <script src="~/js/gl-v2-projecten-incommininvoice-add.js" asp-append-version="true"></script>
    <script src="~/js/gl-v2-projecten-inhouding.js" asp-append-version="true"></script>
}
