@model CPMCore.Models.Projecten.QuoteIntakeV2Vm
@*
    gl-v2 — Offerte inlezen (design-handoff 20c: "kader rond een tabel leest regels in, kader rond een
    foto hangt die aan een regel"). Stap 1 van de flow uit 29b: lijst · "+ Nieuw" → 20c → 21c (Omzetten,
    modal) → 28a (opmaakscherm). Werkt op dezelfde ChangeOrder-rij als het scherm per stap
    (ChangeOrderDetailV2, IsQuote=true tot het omzetten) — opslaan én omzetten posten naar
    ChangeOrderDetailV2Save: "Opslaan als offerte" bewaart enkel (29a "Offerte zonder omzetten"),
    "Omzetten" opent de 21c-modal en stuurt haar keuzes mee in dezelfde POST. Vanuit het opmaakscherm
    (Bron · "offerte koppelen of inlezen") werkt dit scherm op een bestaande WO (Model.IsQuote=false):
    dan valt het omzetten weg en gaat opslaan terug naar die WO. Eigen klassen-namespace gl-v2-qi-*
    (gl-v2-projecten-quoteintake.css/.js). PDF-weergave via pdf.js (wwwroot/lib/pdfjs, gevendord op
    2026-09-30 — er was nergens in de codebase al een PDF-renderer/canvas-crop-tool).
*@
@using CPMCore.Models.GlV2
@{
    ViewData["Title"] = Model.IsQuote
        ? (Model.IsNew ? "Offerte inlezen" : $"{Model.Number} · Offerte inlezen")
        : $"{Model.Number} · Offerte koppelen";
    ViewData["PageIcon"] = "ph ph-scan";
    ViewData["GlV2FullHeightBody"] = true;
    ViewData["BackUrl"] = Url.Action("ChangeOrdersV2", "Projecten", new { projectid = Model.ProjectId });

    var menuVm = new GlV2ProjectMenuVm { ProjectId = Model.ProjectId, ProjectName = Model.ProjectName, ProjectSubtitle = "project · offertes & wijzigingen" };
    var listUrl = Url.Action("ChangeOrdersV2", "Projecten", new { projectid = Model.ProjectId });
    var backUrl = Model.IsQuote ? listUrl : Url.Action("ChangeOrderDetailV2", "Projecten", new { projectid = Model.ProjectId, coid = Model.ChangeOrderId });

    // Zelfde zeven stappen als het scherm per stap (28) — dit scherm is stap 1.
    var stepLabels = new[] { "Offerte", "Opgemaakt", "Verzonden", "Ondertekend", "Factureerbaar", "Gefactureerd", "Betaald" };
    var stappenplan = new GlV2StappenplanVm
    {
        Size = "sm",
        AriaLabel = "Verloop van de wijzigingsopdracht",
        Steps = stepLabels.Select((label, i) => new GlV2StapVm { Label = label, State = i == 0 ? "current" : "todo", Sub = i == 0 ? "inlezen en controleren" : null }).ToList(),
    };
}
@section PageStyle
{
    <link rel="stylesheet" href="~/css/gl-v2-project-inner-menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-projecten-changeorderdetail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-projecten-quoteintake.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-projecten-convertquote.css" asp-append-version="true" />
}
@section PageTitleBadges
{
    <span class="gl-v2-badge is-neutral">@(Model.IsQuote ? "OFFERTE" : "BRON VAN " + Model.Number)</span>
}
@section ProjectMenu
{
    @{ menuVm.Mode = GlV2ProjectMenuMode.Outer; }
    @await Html.PartialAsync("GlV2/_ProjectInnerMenuV2", menuVm)
}
@{ menuVm.Mode = GlV2ProjectMenuMode.Phone; }
@await Html.PartialAsync("GlV2/_ProjectInnerMenuV2", menuVm)

@if (!Model.AzureConfigured)
{
    <div class="gl-v2-notice gl-v2-notice-compact is-warning">
        <i class="ph ph-warning" aria-hidden="true"></i>
        <span>Automatisch inlezen is niet geconfigureerd (geen AI-sleutel: QuoteExtraction:AnthropicApiKey of InvoiceExtraction:Azure) — regels manueel toevoegen kan wel.</span>
    </div>
}

<form id="gl-v2-qi-form" class="gl-v2-co-form" method="post" action="@Url.Action("ChangeOrderDetailV2Save")">
@Html.AntiForgeryToken()
<input type="hidden" name="projectId" value="@Model.ProjectId" />
<input type="hidden" name="changeOrderId" value="@Model.ChangeOrderId" />
@if (Model.ClientAccountId > 0)
{
    <input type="hidden" name="clientAccountId" value="@Model.ClientAccountId" />
}
<input type="hidden" name="returnTo" value="quote" />
<input type="hidden" name="description" id="gl-v2-qi-description-hidden" value="" />
<input type="hidden" name="invoiceableByBouwheer" value="false" />
<input type="hidden" name="convertAfterSave" id="gl-v2-qi-convert-after-save" value="false" />
@* Origineel offertebestand (migratie 066) — gevuld door de JS zodra een bestand geladen en bewaard is. *@
<input type="hidden" name="quoteSourcePath" id="gl-v2-qi-source-path" value="" />
<input type="hidden" name="quoteSourceFileName" id="gl-v2-qi-source-name" value="" />
@* Keuzes uit de 21c-modal (Omzetten) — zelfde veldnamen als ChangeOrderConvertV2Model. *@
<input type="hidden" name="convertClientAccountId" id="gl-v2-qi-cv-client" value="" />
<input type="hidden" name="convertCommission" id="gl-v2-qi-cv-commission" value="0" />
<input type="hidden" name="convertPlan" id="gl-v2-qi-cv-plan" value="" />
<input type="hidden" name="convertDescription" id="gl-v2-qi-cv-description" value="" />
<input type="hidden" name="convertConditions" id="gl-v2-qi-cv-conditions" value="" />
<input type="hidden" name="afterSave" id="gl-v2-qi-after-save" value="" />

<div class="gl-v2-co-scroll">
@if (Model.IsQuote)
{
    <div class="gl-v2-card gl-v2-co-card">
        <div class="gl-v2-card-body gl-v2-co-steps">
            <span class="gl-v2-co-steps-label">STAP 1 VAN 7</span>
            @await Html.PartialAsync("GlV2/_Stappenplan", stappenplan)
        </div>
    </div>
}
<div class="gl-v2-qi-layout">
    @* ── Linkerkolom: bronviewer + kader-selectie ─────────────────────────────────────────────────── *@
    <div class="gl-v2-qi-source">
        <div class="gl-v2-card gl-v2-co-card gl-v2-qi-source-card">
            <div class="gl-v2-qi-toolbar">
                <button type="button" class="gl-v2-qi-tool" id="gl-v2-qi-tool-select" data-mode="table">
                    <i class="ph ph-selection" aria-hidden="true"></i>Gebied selecteren — tabel
                </button>
                <button type="button" class="gl-v2-qi-tool" id="gl-v2-qi-tool-photo" data-mode="photo">
                    <i class="ph ph-image" aria-hidden="true"></i>Gebied selecteren — foto
                </button>
                <span class="gl-v2-qi-pagenav" id="gl-v2-qi-pagenav" hidden>
                    <button type="button" class="gl-v2-qi-tool" id="gl-v2-qi-page-prev" aria-label="Vorige pagina"><i class="ph ph-caret-left" aria-hidden="true"></i></button>
                    <span class="gl-v2-qi-pagelabel" id="gl-v2-qi-pagelabel"></span>
                    <button type="button" class="gl-v2-qi-tool" id="gl-v2-qi-page-next" aria-label="Volgende pagina"><i class="ph ph-caret-right" aria-hidden="true"></i></button>
                </span>
                <span class="gl-v2-qi-toolbar-spacer"></span>
                <button type="button" class="gl-v2-qi-tool" id="gl-v2-qi-camera"><i class="ph ph-camera" aria-hidden="true"></i>Foto nemen</button>
                <label class="gl-v2-qi-tool" for="gl-v2-qi-file"><i class="ph ph-upload-simple" aria-hidden="true"></i>Bestand</label>
                <input type="file" id="gl-v2-qi-file" accept="application/pdf,image/*" hidden />
                <input type="file" id="gl-v2-qi-camera-input" accept="image/*" capture="environment" hidden />
            </div>
            <div class="gl-v2-qi-canvas-wrap" id="gl-v2-qi-canvas-wrap">
                <div class="gl-v2-qi-canvas-empty" id="gl-v2-qi-empty">
                    <i class="ph ph-file-text" aria-hidden="true"></i>
                    <p>Laad een offerte (PDF of foto) — slepen of plakken (Ctrl+V) kan ook</p>
                    @if (!string.IsNullOrWhiteSpace(Model.SourceFileName))
                    {
                        <p class="gl-v2-qi-source-kept"><i class="ph ph-paperclip" aria-hidden="true"></i>Bewaard bronbestand: @Model.SourceFileName — laad een nieuw bestand om verder in te lezen of het te vervangen.</p>
                    }
                </div>
                <div class="gl-v2-qi-canvas-stage" id="gl-v2-qi-stage" hidden>
                    <canvas id="gl-v2-qi-canvas"></canvas>
                    <canvas id="gl-v2-qi-overlay"></canvas>
                </div>
            </div>
            <div class="gl-v2-qi-hint">
                Sleep een kader rond een tabel: regels, aantallen en prijzen worden ingelezen. Sleep een kader rond een foto of schets: die hangt als beeld aan de regel die je daarna kiest. Werkt ook met een foto van een papieren offerte of een schermafdruk (Ctrl+V).
            </div>
        </div>
    </div>

    @* ── Rechterkolom: offerte-gegevens + herkende regels ─────────────────────────────────────────── *@
    <div class="gl-v2-qi-data">
        <div class="gl-v2-card gl-v2-co-card">
            <div class="gl-v2-card-header">
                <span class="gl-v2-card-header-icon"><i class="ph ph-file-text" aria-hidden="true"></i></span>
                <h2 class="gl-v2-card-header-title">Offerte</h2>
                <span class="gl-v2-field-divider"></span>
                <span class="gl-v2-card-header-count">Van de leverancier, nog intern — niet zichtbaar voor de klant</span>
            </div>
            <div class="gl-v2-card-body gl-v2-co-form-grid">
                <div class="gl-v2-field">
                    <label class="gl-v2-field-label" for="gl-v2-qi-contractactivity">Leverancier · contract</label>
                    <div class="gl-v2-field-box"><select class="gl-v2-field-input" id="gl-v2-qi-contractactivity" name="contractActivityId">
                        <option value="">— kies —</option>
                        @foreach (var a in Model.ContractActivities)
                        {
                            <option value="@a.ID" selected="@(a.ID == Model.ContractActivityId)">@a.Display</option>
                        }
                    </select></div>
                </div>
                <div class="gl-v2-field">
                    @if (Model.ClientAccountId > 0)
                    {
                        <span class="gl-v2-field-label">Klant · eenheid</span>
                        <div class="gl-v2-co-readout">@Model.ClientName@(string.IsNullOrWhiteSpace(Model.UnitName) ? "" : " · " + Model.UnitName)</div>
                    }
                    else
                    {
                        <label class="gl-v2-field-label" for="gl-v2-qi-client">Klant</label>
                        <div class="gl-v2-field-box"><select class="gl-v2-field-input" id="gl-v2-qi-client" name="clientAccountId">
                            <option value="">— kies een klant —</option>
                            @foreach (var c in Model.ClientAccounts)
                            {
                                <option value="@c.ID">@c.Display</option>
                            }
                        </select></div>
                        <span class="gl-v2-field-help">nodig om de offerte te bewaren — bij omzetten kies je klant en eenheid in de volgende stap</span>
                    }
                </div>
                <div class="gl-v2-field">
                    <label class="gl-v2-field-label" for="gl-v2-qi-quote-ref">Offertenr. leverancier</label>
                    <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" id="gl-v2-qi-quote-ref" name="quoteSupplierReference" value="@Model.QuoteSupplierReference" /></div>
                </div>
                <div class="gl-v2-field">
                    <label class="gl-v2-field-label" for="gl-v2-qi-quote-vat">Btw leverancier</label>
                    <div class="gl-v2-field-box"><input type="number" step="0.01" class="gl-v2-field-input" id="gl-v2-qi-quote-vat" name="quoteVatPercentage" value="@(Model.QuoteVatPercentage?.ToString(System.Globalization.CultureInfo.InvariantCulture))" /></div>
                </div>
            </div>
        </div>

        <div class="gl-v2-card gl-v2-co-card">
            <div class="gl-v2-card-header">
                <span class="gl-v2-card-header-icon"><i class="ph ph-list-bullets" aria-hidden="true"></i></span>
                <h2 class="gl-v2-card-header-title">Herkende regels</h2>
                <span class="gl-v2-field-divider"></span>
                <span class="gl-v2-card-header-count">Controleer wat gemarkeerd is; de rest staat klaar</span>
                <span class="gl-v2-card-header-spacer"></span>
                <button type="button" class="gl-v2-card-header-action" id="gl-v2-qi-add-row">+ Regel</button>
            </div>
            <div class="gl-v2-co-table-scroll">
                <table class="gl-v2-co-table" id="gl-v2-qi-rows-table">
                    <thead>
                        <tr>
                            <th>Bron</th><th>Omschrijving</th><th class="is-center">Eenh.</th>
                            <th class="is-right">Aantal</th><th class="is-right">Prijs lev.</th><th></th>
                        </tr>
                    </thead>
                    <tbody id="gl-v2-qi-rows-body">
                        @for (var i = 0; i < Model.Rows.Count; i++)
                        {
                            @await Html.PartialAsync("Partials/_QuoteIntakeRowV2", Model.Rows[i], new ViewDataDictionary(ViewData) { { "Index", i } })
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="is-right">Totaal leverancier excl. btw</td>
                            <td class="is-right gl-v2-co-tabular" id="gl-v2-qi-sum-total">€ 0,00</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="gl-v2-notice gl-v2-notice-compact is-info">
            <i class="ph ph-info" aria-hidden="true"></i>
            @if (Model.IsQuote)
            {
                <span><b>Omzetten</b> vraagt klant · eenheid, commissie en facturatieplan en opent daarna de wijzigingsopdracht als concept. Leverancier, regels en foto's gaan mee; deze offerte blijft gekoppeld als bron.</span>
            }
            else
            {
                <span>Je koppelt een offerte aan <b>@Model.Number</b>. Nieuwe regels krijgen de commissie en btw van die wijzigingsopdracht; omschrijving en facturatieplan blijven ongewijzigd.</span>
            }
        </div>
    </div>
</div>
</div>

<div class="gl-v2-form-actionbar">
    <span class="gl-v2-form-actionbar-status" id="gl-v2-qi-status"></span>
    <span class="gl-v2-form-actionbar-spacer"></span>
    <div class="gl-v2-form-actionbar-actions">
        <a class="gl-v2-btn gl-v2-btn-text" href="@backUrl">Annuleren</a>
        @if (!Model.IsQuote)
        {
            <button type="submit" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-qi-save">Opslaan en terug naar @Model.Number</button>
        }
        else if (Model.KeepOnly)
        {
            <button type="button" class="gl-v2-btn gl-v2-btn-secondary" id="gl-v2-qi-convert">Omzetten naar wijzigingsopdracht</button>
            <button type="submit" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-qi-save">Opslaan als offerte</button>
        }
        else
        {
            <button type="submit" class="gl-v2-btn gl-v2-btn-secondary" id="gl-v2-qi-save">Opslaan als offerte</button>
            <button type="button" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-qi-convert">
                <i class="ph ph-arrow-right" aria-hidden="true"></i><span>Omzetten naar wijzigingsopdracht</span>
            </button>
        }
    </div>
</div>
</form>

@if (Model.IsQuote)
{
    @await Html.PartialAsync("Partials/_ConvertQuoteModalShellV2")
}

@section PageScripts
{
    <script id="gl-v2-qi-config" type="application/json">
    {
        "projectId": @Model.ProjectId,
        "changeOrderId": @Model.ChangeOrderId,
        "clientAccountId": @Model.ClientAccountId,
        "number": "@Model.Number",
        "convertModalUrl": "@Url.Action("ConvertQuoteModalV2")",
        "uploadSourceUrl": "@Url.Action("QuoteIntakeV2UploadSource")",
        "pdfWorkerUrl": "@Url.Content("~/lib/pdfjs/pdf.worker.min.js")",
        "extractTableUrl": "@Url.Action("QuoteIntakeV2ExtractTable")",
        "attachPhotoUrl": "@Url.Action("QuoteIntakeV2AttachPhoto")",
        "addRowUrl": "@Url.Action("QuoteIntakeV2AddRow")",
        "saveUrl": "@Url.Action("ChangeOrderDetailV2Save")",
        "listUrl": "@Url.Action("ChangeOrdersV2", "Projecten", new { projectid = Model.ProjectId })"
    }
    </script>
    <script src="~/lib/pdfjs/pdf.min.js"></script>
    <script src="~/js/gl-v2-project-inner-menu.js" asp-append-version="true"></script>
    <script src="~/js/gl-v2-projecten-convertquote.js" asp-append-version="true"></script>
    <script src="~/js/gl-v2-projecten-quoteintake.js" asp-append-version="true"></script>
}
