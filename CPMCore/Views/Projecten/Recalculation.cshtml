                                className: 'btn btn-primary btn-md font-weight-semibold btn-py-2 px-4',
                                titleAttr: 'Exporteer naar pdf',
                                    attr: {
                                      "data-bs-toggle": "tooltip"
                                    },
                                 orientation: 'landscape',
                                 pageSize:'A3',
                                 exportOptions: {
                                    columns: ':visible'
                                }
                            }
                        ]
                    }
                },
                columnDefs: [{ width: '1%', targets: 0 }],
                     language: {
