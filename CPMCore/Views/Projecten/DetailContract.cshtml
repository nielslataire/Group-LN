@using System.Globalization
@using CPMCore.Helpers
@using BOCore
@using System.Linq
@model CPMCore.Models.Projecten.ProjectContractDetailModel


@{
    var currencyCulture = CultureInfo.CreateSpecificCulture("nl-BE");
    var invoiceCount = Model.IncommingInvoices?.Count ?? 0;
    var invoiceTotal = Model.IncommingInvoices?.Sum(i => i.InvoicePrice) ?? 0;
    var contractCount = Model.Contracts?.Count ?? 0;
    var companyName = Model.Contract?.Company?.Display ?? Model.Company?.Bedrijfsnaam ?? "Leverancier";
    var companyId = Model.Company?.CompanyId ?? Model.Contract?.Company?.ID ?? 0;
    var addressLine = string.IsNullOrWhiteSpace(Model.Company?.Straat)
        ? "-"
        : $"{Model.Company.Straat} {Model.Company.Huisnummer}{(string.IsNullOrWhiteSpace(Model.Company.Busnummer) ? string.Empty : $" bus {Model.Company.Busnummer}")}";
    var cityLine = string.IsNullOrWhiteSpace(Model.Company?.Postcode?.Postcode) && string.IsNullOrWhiteSpace(Model.Company?.Postcode?.Gemeente)
        ? "-"
        : $"{Model.Company?.Postcode?.Postcode} {Model.Company?.Postcode?.Gemeente}".Trim();
    var canWriteProjectSuppliers = ViewBag.CanWriteProjectSuppliers as bool? ?? false;
    var canDeleteProjectSuppliers = ViewBag.CanDeleteProjectSuppliers as bool? ?? false;
}

@section PageStyle
{
    <link rel="stylesheet" href="~/css/projecten-custom.css" />
    <link rel="stylesheet" href="~/lib/magnific-popup/magnific-popup.css" />
}

<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", Model.ProjectId)
        <div class="inner-body">
            <div class="row justify-content-between align-items-center pt-2 pe-0 mb-3">
                <div class="col-sm-auto mb-3 mb-sm-0">
                    <div class="d-flex align-items-center">
                        <a href="@Url.Action("DetailContracts", "Projecten", new { projectid = Model.ProjectId })" class="text-decoration-none text-reset d-flex align-items-center me-3">
                            <i class="bx bx-chevron-left fs-1"></i>
                        </a>
                        <div>
                            <h1 class="fw-bold mb-0">@companyName</h1>
                            <h5 class="mb-0 text-muted">Contract detail</h5>
                        </div>
                    </div>
                </div>
            </div>

            <div class="coord-tabs" role="tablist">
                @if (Model.HasContract)
                {
                    <button class="coord-tab active" type="button" data-section-toggle="contract">Contract (@contractCount)</button>
                }
                <button class="coord-tab @(Model.HasContract ? string.Empty : "active")" type="button" data-section-toggle="facturen">Facturen (@invoiceCount)</button>
                <button class="coord-tab" type="button" data-section-toggle="leverancier">Leverancier</button>
                <button class="coord-tab" type="button" data-section-toggle="portaal">Portaaltoegang</button>
            </div>

            @if (Model.HasContract)
            {
                <div id="contract-detail-section" class="supplier-section">
                    <div class="row">
                        @foreach (var contract in Model.Contracts)
                        {
                            var activityCount = contract.Activities?.Count ?? 0;
                            var contractTotal = contract.Activities?.Sum(a => a.Price ?? 0) ?? 0;
                            <div class="col-xl-6 mb-4">
                                <section class="card card-modern h-100">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bx bx-file fs-5"></i>
                                            <span class="fw-semibold">
                                                @if (!string.IsNullOrWhiteSpace(contract.ContractName))
                                                {
                                                    @contract.ContractName
                                                }
                                                else
                                                {
                                                    <text>Contract</text>
                                                }
                                            </span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (contract.ContractSigned)
                                            {
                                                <span class="badge bg-success">Getekend</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Niet getekend</span>
                                            }
                                            @if (canWriteProjectSuppliers)
                                            {
                                                <a href="@Url.Action("EditContract", "Projecten", new { projectid = Model.ProjectId, contractid = contract.Id })"
                                                   class="btn btn-sm btn-outline-secondary" title="Bewerken">
                                                    <i class="bx bx-edit"></i>
                                                </a>
                                            }
                                            @if (canDeleteProjectSuppliers)
                                            {
                                                <a href="#modaldeletecontract" class="btn btn-sm btn-outline-danger deleteContract"
                                                   data-id="@contract.Id" title="Verwijderen">
                                                    <i class="bx bx-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-3">
                                            <div class="col-6">
                                                <span class="fw-semibold fs-6">BTW %</span>
                                                <div class="text-muted">@(contract.VatPercentage is null ? "-" : contract.VatPercentage.Value.ToString("N2"))</div>
                                            </div>
                                            <div class="col-6">
                                                <span class="fw-semibold fs-6">Betaaltermijn</span>
                                                <div class="text-muted">@(contract.PaymentTerm is null ? "-" : $"{contract.PaymentTerm} dagen")</div>
                                            </div>
                                            <div class="col-6 mt-3">
                                                <span class="fw-semibold fs-6">Korting contant</span>
                                                <div class="text-muted">
                                                    @(contract.CashDiscount
                                                        ? $"{contract.CashDiscountPercentage?.ToString("N2")}% binnen {contract.CashDiscountPaymentTerm} dagen"
                                                        : "-")
                                                </div>
                                            </div>
                                            <div class="col-6 mt-3">
                                                <span class="fw-semibold fs-6">Borg</span>
                                                <div class="text-muted">
                                                    @(contract.GuaranteeType == BOCore.ContractGuaranteeType.FinancialGuarantee
                                                        ? $"{contract.GuaranteePercentage?.ToString("N2")}% {contract.GuaranteeType.GetDisplayName()}"
                                                        : contract.GuaranteeType.GetDisplayName())
                                                </div>
                                                @if (contract.GuaranteeType == BOCore.ContractGuaranteeType.BankGuarantee)
                                                {
                                                    <div class="mt-1">
                                                        @if (!string.IsNullOrWhiteSpace(contract.GuaranteeDocFilename))
                                                        {
                                                            <a href="@Url.Action("GuaranteeDoc", "Projecten", new { contractid = contract.Id })" target="_blank" rel="noopener" class="small">
                                                                <i class="bx bx-file" aria-hidden="true"></i> Waarborgdocument bekijken
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning text-dark"><i class="bx bx-error-circle" aria-hidden="true"></i> waarborg nog te ontvangen</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            <div class="col-6 mt-3">
                                                <span class="fw-semibold fs-6">Contract verstuurd</span>
                                                <div class="text-muted">
                                                    @if (contract.ContractSentDate is null && string.IsNullOrWhiteSpace(contract.ContractSentNote))
                                                    {
                                                        <text>-</text>
                                                    }
                                                    else
                                                    {
                                                        @(contract.ContractSentDate?.ToString("dd/MM/yyyy") ?? "-")
                                                        @if (!string.IsNullOrWhiteSpace(contract.ContractSentNote))
                                                        {
                                                            <text> (@contract.ContractSentNote)</text>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-6 mt-3">
                                                <span class="fw-semibold fs-6">Werfmelding</span>
                                                <div>
                                                    @if (contract.SiteNotification)
                                                    {
                                                        <span class="badge bg-success">Ja</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Nee</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-6 mt-3">
                                                <span class="fw-semibold fs-6">VGM charter</span>
                                                <div>
                                                    @if (contract.VgmCharter)
                                                    {
                                                        <span class="badge bg-success">Ja</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Nee</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-6 mt-3">
                                                <span class="fw-semibold fs-6">PID-attesten</span>
                                                <div>
                                                    @if (contract.PidAttest)
                                                    {
                                                        <span class="badge bg-success">Ja</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Nee</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fw-semibold fs-6">Loten (@activityCount)</span>
                                            <span class="fw-semibold">@contractTotal.ToString("C", currencyCulture)</span>
                                        </div>
                                        @if (contract.Activities?.Any() == true)
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-hover table-sm mb-0">
                                                    <thead>
                                                        <tr>
                                                            <th>Lot</th>
                                                            <th class="text-end">Prijs</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var activity in contract.Activities)
                                                        {
                                                            <tr>
                                                                <td>@activity.Activity?.Name</td>
                                                                <td class="text-end">@(activity.Price.HasValue ? activity.Price.Value.ToString("C", currencyCulture) : "-")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-muted">Geen loten gekoppeld.</div>
                                        }
                                    </div>
                                </section>
                            </div>
                        }
                    </div>
                </div>
            }

            <div id="contract-invoices-section" class="supplier-section @(Model.HasContract ? "d-none" : string.Empty)">
                <section class="card card-modern">
                    <div class="card-body">
                        @if (Model.IncommingInvoices?.Any() == true)
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Factuurdatum</th>
                                            <th>Externe referentie</th>
                                            @if (Model.Contracts?.Count > 1)
                                            {
                                                <th>Contract</th>
                                            }
                                            <th class="text-end">Factuurbedrag</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var invoice in Model.IncommingInvoices)
                                        {
                                            var linkedContract = Model.Contracts?.FirstOrDefault(c => c.Id == invoice.ContractID);
                                            <tr class="invoice-row" data-invoice-href="@Url.Action("IncommingInvoiceDetail", "Projecten", new { projectid = Model.ProjectId, invoiceid = invoice.Id })">
                                                <td>@invoice.IncommingInvoiceDate.ToString("dd/MM/yyyy")</td>
                                                <td>@(string.IsNullOrWhiteSpace(invoice.InvoiceExternalId) ? "-" : invoice.InvoiceExternalId)</td>
                                                @if (Model.Contracts?.Count > 1)
                                                {
                                                    <td>
                                                        @if (linkedContract != null)
                                                        {
                                                            @(string.IsNullOrWhiteSpace(linkedContract.ContractName)
                                                                ? "Contract"
                                                                : linkedContract.ContractName)
                                                        }
                                                        else
                                                        {
                                                            <text>-</text>
                                                        }
                                                    </td>
                                                }
                                                <td class="text-end">@invoice.InvoicePrice.ToString("C", currencyCulture)</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th colspan="@(Model.Contracts?.Count > 1 ? 3 : 2)" class="text-end">Totaal</th>
                                            <th class="text-end">@invoiceTotal.ToString("C", currencyCulture)</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="mb-0 text-muted">Er zijn nog geen facturen gekoppeld aan deze leverancier. </p>
                        }
                    </div>
                </section>
            </div>

            <div id="supplier-detail-section" class="supplier-section d-none">
                <section class="card card-modern card-big-info">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-2-5 col-xl-2-5">
                                <i class="card-big-info-icon bx bx-building-house"></i>
                                <h2 class="card-big-info-title">Leverancier</h2>
                                <p class="card-big-info-desc">Gegevens van de leverancier voor dit contract.</p>
                            </div>
                            <div class="col-lg-3-5 col-xl-3-5">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <span class="fw-semibold fs-6">Bedrijfsnaam</span>
                                        <div class="text-muted">@(!string.IsNullOrWhiteSpace(Model.Company?.Bedrijfsnaam) ? Model.Company.Bedrijfsnaam : "-")</div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <span class="fw-semibold fs-6">Ondernemingsnummer</span>
                                        <div class="text-muted">@(EnterpriseNumberFormatter.Format(Model.Company?.OndNr) ?? "-")</div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <span class="fw-semibold fs-6">Telefoon</span>
                                        <div class="text-muted">@(!string.IsNullOrWhiteSpace(Model.Company?.Telefoon1) ? Model.Company.Telefoon1 : "-")</div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <span class="fw-semibold fs-6">GSM</span>
                                        <div class="text-muted">@(!string.IsNullOrWhiteSpace(Model.Company?.GSM) ? Model.Company.GSM : "-")</div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <span class="fw-semibold fs-6">Email</span>
                                        <div class="text-muted">@(!string.IsNullOrWhiteSpace(Model.Company?.Email) ? Model.Company.Email : "-")</div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <span class="fw-semibold fs-6">Website</span>
                                        <div class="text-muted">
                                            @if (!string.IsNullOrWhiteSpace(Model.Company?.URL))
                                            {
                                                <a href="@Model.Company.URL" target="_blank" rel="noopener">@Model.Company.URL</a>
                                            }
                                            else
                                            {
                                                <text>-</text>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-12 mb-3">
                                        <span class="fw-semibold fs-6">Adres</span>
                                        <div class="text-muted">
                                            @addressLine
                                            <br />
                                            @cityLine
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <div id="portaal-detail-section" class="supplier-section d-none">
                <section class="card card-modern card-big-info">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-2-5 col-xl-2-5">
                                <i class="card-big-info-icon bx bx-buildings"></i>
                                <h2 class="card-big-info-title">Aannemersportaal</h2>
                                <p class="card-big-info-desc">Beheer wie voor <strong>@companyName</strong> toegang heeft tot het portaal.</p>
                            </div>
                            <div class="col-lg-3-5 col-xl-3-5 d-flex align-items-center gap-2">
                                <a href="@Url.Action("Overzicht", "ContractorInvite", new { companyId = companyId })"
                                   class="btn btn-outline-primary">
                                    <i class="bx bx-group me-1"></i>Verantwoordelijken bekijken
                                </a>
                                <a href="@Url.Action("Aanmaken", "ContractorInvite", new { companyId = companyId })"
                                   class="btn btn-primary">
                                    <i class="bx bx-user-plus me-1"></i>Verantwoordelijke uitnodigen
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</section>

<div id="modaldeletecontract" class="modal-block modal-block-warning mfp-hide">
    <div id="delete-contract-container"></div>
</div>

@section PageScripts {
    <script src="~/lib/magnific-popup/jquery.magnific-popup.js"></script>
    <script>
        (function () {
            const sectionButtons = document.querySelectorAll('[data-section-toggle]');
            const sections = {
                contract:    document.getElementById('contract-detail-section'),
                facturen:    document.getElementById('contract-invoices-section'),
                leverancier: document.getElementById('supplier-detail-section'),
                portaal:     document.getElementById('portaal-detail-section')
            };

            sectionButtons.forEach((button) => {
                button.addEventListener('click', (event) => {
                    const target = button.getAttribute('data-section-toggle');

                    sectionButtons.forEach((btn) => btn.classList.remove('active'));
                    button.classList.add('active');

                    Object.values(sections).forEach((section) => section?.classList.add('d-none'));
                    sections[target]?.classList.remove('d-none');
                });
            });

            document.querySelectorAll('[data-invoice-href]').forEach((row) => {
                row.style.cursor = 'pointer';
                row.addEventListener('click', () => {
                    const href = row.getAttribute('data-invoice-href');
                    if (href) {
                        window.location.href = href;
                    }
                });
            });

            $(document).on('click', '.deleteContract', function (e) {
                e.preventDefault();
                var url = "/Projecten/ModalDeleteContract";
                var id = $(this).attr('data-id');
                $.get(url + '/' + id, function (data) {
                    $('#delete-contract-container').html(data);
                    $.magnificPopup.open({
                        items: { src: '#modaldeletecontract' },
                        type: 'inline',
                        closeBtnInside: true
                    });
                });
            });
        })();
    </script>
}