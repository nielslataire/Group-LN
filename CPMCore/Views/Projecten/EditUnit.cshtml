@using CPMCore.Controllers
@using BOCore
@inject IConfiguration Configuration
@model CPMCore.Models.Projecten.EditUnitModel;

@{
	ViewData["Title"] = "Project - " + Model.ProjectName;
}

@section PageStyle
{
<link rel="stylesheet" href="~/lib/bootstrap-fileupload/bootstrap-fileupload.min.css" />
<link rel="stylesheet" href="~/lib/select2/css/select2.css" />
<link rel="stylesheet" href="~/lib/select2-bootstrap-theme/select2-bootstrap.min.css" />
<link rel="stylesheet" href="~/lib/bootstrap-tagsinput/bootstrap-tagsinput.css" />
<link rel="stylesheet" href="~/lib/magnific-popup/magnific-popup.css" />
<link rel="stylesheet" href="~/css/projecten-custom.css" />
}


<h2 class="font-weight-bold text-6">Eenheid bewerken</h2>
@using (Html.BeginForm("EditUnit", "Projecten", FormMethod.Post, new { @class = "ecommerce-form action-buttons-fixed", @id = "myForm", @action = "#", enctype = "multipart/form-data" }))
{
@* 	@Html.AntiForgeryToken() *@
	@Html.HiddenFor(m => m.Unit.Id, new {id = "unitid"})
	@Html.HiddenFor(m => m.Unit.ClientAccountId)
	@Html.HiddenFor(m => m.Unit.LandValueSold)
	@Html.HiddenFor(m => m.Unit.Type.Id)
	@Html.HiddenFor(m => m.Unit.ProjectId)
	@Html.HiddenFor(m => m.Unit.AttachedUnitsId)
	@Html.HiddenFor(m => m.Unit.LinkedUnitId)
	@Html.HiddenFor(m => m.Unit.PaymentGroupId)
	@Html.HiddenFor(m => m.Unit.IsLink)
	@Html.HiddenFor(m => m.ProjectId, new {id = "projectid"})
	@Html.HiddenFor(m => m.ProjectName, new { id = "projectname" })

	<div class="row mt-2">
		<div class="col">
			<section class="card card-modern card-big-info">
				<div class="card-body">
					<div class="row">
						<div class="col-lg-2-5 col-xl-1-5">
							<i class="card-big-info-icon bx bx-box"></i>
							<h2 class="card-big-info-title">Algemene info</h2>
							<p class="card-big-info-desc">Voeg hier de algemene info van de eenheid in.</p>
						</div>
						<div class="col-lg-3-5 col-xl-4-5">
							<div class="row align-items-center pb-3">
								<label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Naam</label>
								<div class="col-lg-7 col-xl-6">
									@Html.TextBoxFor(m => m.Unit.Name, new { @class = "form-control", id = "txtNaam", placeholder = "naam van de eenheid" })
								</div>
							</div>
								<div class="row align-items-center pb-3">
									<label class="col-lg-5 col-xl-3 control-label text-lg-end pt-2 mt-1 mb-0">Adres</label>
									<div class="col-lg-5 col-xl-4">
									@Html.TextBoxFor(m => m.Unit.Street, new { @class = "form-control", id = "txtStraat", placeholder = "straat" })
									</div>
									<div class="col-lg-1 col-xl-1">
										@Html.TextBoxFor(m => m.Unit.HouseNumber, new { @class = "form-control", id = "txtHuisnr", placeholder = "nr" })
									</div>
									<div class="col-lg-1 col-xl-1">
									@Html.TextBoxFor(m => m.Unit.BusNumber, new { @class = "form-control", id = "txtBusnr", placeholder = "bus" })
									</div>
								</div>

							<div class="row align-items-center pb-3">
								<label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Kadaster</label>
								<div class="col-lg-7 col-xl-6">
									@Html.TextBoxFor(m => m.Unit.PreKad, new { @class = "form-control", id = "txtKadaster", placeholder = "kadastraal nummer" })
								</div>
							</div>
							<div class="row align-items-center pb-3">
								<label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Aandeel in de basisakte</label>
								<div class="col-lg-7 col-xl-6">
									@Html.TextBoxFor(m => m.Unit.Landshare, new { @class = "form-control", id = "txtTienduizend", placeholder = "geef het aantal aandelen in de basisakte in", type = "number" })
								</div>
							</div>
							<div class="row align-items-center pb-3">
								<label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Verdieping</label>
								<div class="col-lg-7 col-xl-6">
									@Html.TextBoxFor(m => m.Unit.Level, new { @class = "form-control", id = "txtVerdieping", placeholder = "Geef het nummer van de verdieping in", type = "number" })
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
		</div>
	</div>
	<div class="row mt-4">
		<div class="col">
			<section class="card card-modern card-big-info">
				<div class="card-body">
					<div class="tabs-modern row gl-tabs-min-h">
						<div class="col-lg-2-5 col-xl-1-5">
							<div class="nav flex-column" id="tab" role="tablist" aria-orientation="vertical">
								<a class="nav-link active" id="types-tab" data-bs-toggle="pill" data-bs-target="#types" role="tab" aria-controls="types" aria-selected="false"><i class="bx bx-building-house me-2"></i> Types</a>
								<a class="nav-link" id="bedragen-tab" data-bs-toggle="pill" data-bs-target="#bedragen" role="tab" aria-controls="bedragen" aria-selected="false"><i class="bx bx-euro me-2"></i> Bedragen</a>
								<a class="nav-link" id="oppervlaktes-tab" data-bs-toggle="pill" data-bs-target="#oppervlaktes" role="tab" aria-controls="oppervlaktes" aria-selected="false"><i class="fa fa-ruler me-2"></i> Oppervlaktes</a>
								<a class="nav-link" id="indeling-tab" data-bs-toggle="pill" data-bs-target="#indeling" role="tab" aria-controls="indeling" aria-selected="false"><i class="bx bx-cabinet me-2"></i> Indeling</a>
								<a class="nav-link" id="documenten-tab" data-bs-toggle="pill" data-bs-target="#documenten" role="tab" aria-controls="documenten" aria-selected="false"><i class="bx bx-file me-2"></i> Documenten</a>
							</div>
						</div>
						<div class="col-lg-3-5 col-xl-4-5">
							<div class="tab-content" id="tabContent">
								<!-- TYPES-->
								<div class="tab-pane fade show active" id="types" role="tabpanel" aria-labelledby="types-tab">
									<div class="row align-items-center pb-3">
										<label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Naam</label>
										<div class="col-lg-7 col-xl-6">
											@Html.DropDownListFor(m => m.SelectedGroupType, new SelectList(Model.GroupTypes, "Id", "Name", Model.SelectedGroupType), "Selecteer...", new { @class = "form-control populate", id = "lstGroupTypes" })
										</div>
									</div>

									<div class="row align-items-center pb-3">
										<label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Subtype</label>
										<div class="col-lg-7 col-xl-6">
											@Html.DropDownListFor(m => m.SelectedType, new SelectList(Model.Types, "Id", "Name", Model.SelectedType), "Selecteer...", new { @class = "form-control populate", id = "lstTypes" })
										</div>
									</div>
									<div class="row align-items-center pb-3">
										<label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Koppelen aan hoofdeenheid</label>
										<div class="col-lg-7 col-xl-6">
											@Html.DropDownListFor(m => m.Unit.AttachedUnitsId, new SelectList(Model.AttachableUnits, "ID", "Display", Model.Unit.AttachedUnitsId, "Group"), "Selecteer...", new { @class = "form-control w-100 populate", data_plugin_selecttwo = "", id = "lstAttachableUnits" })
										</div>
									</div>
								</div>
								<!-- BEDRAGEN-->
								<div class="tab-pane fade show" id="bedragen" role="tabpanel" aria-labelledby="bedragen-tab">

									<!-- Grondwaarde -->
									<div class="gl-grond-block mb-3">
										<small class="gl-grond-label">Grondwaarde</small>
										@Html.EditorFor(m => m.Unit.LandValue)
									</div>

									<!-- Bouwwaardes per afwerkingsgroep -->
									<div class="d-flex justify-content-between align-items-center mb-2 border-bottom border-1 pb-2 mb-2">
										<strong class="text-uppercase small" style="letter-spacing:.05em">Bouwwaardes per afwerkingsgroep</strong>
										<span class="text-muted small">Totaal: <span id="gl-bouw-totaal">€ –</span></span>
									</div>
									<div id="FinishingOptionSections">
										@{
											ViewBag.UnitId = Model.Unit.Id;
											ViewBag.ProjectId = Model.ProjectId;
										}
										@foreach (var option in Model.FinishingOptions ?? new List<UnitFinishingOptionBO>())
										{
											@await Html.PartialAsync("_FinishingOptionSection", option)
										}
									</div>
									<div class="mb-3 mt-3">
										<button class="btn btn-dashed w-100" type="button" id="btnAddFinishingOption">
											<i class="fa fa-plus me-1"></i> Afwerkingsoptie toevoegen
										</button>
									</div>

									<!-- Totaalprijs eenheid per afwerkingsgroep -->
									<div class="border-top pt-3 mt-1">
										<strong class="d-block mb-2">Totaalprijs eenheid</strong>
										<div id="gl-totaalprijs-rows"></div>
									</div>

								</div>
								<!-- OPPERVLAKTES-->
								<div class="tab-pane fade show" id="oppervlaktes" role="tabpanel" aria-labelledby="oppervlaktes-tab">
									<div class="row align-items-center pb-3">
										<label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Grondoppervlakte</label>
										<div class="col-lg-7 col-xl-6">
											@Html.EditorFor(m => m.Unit.GroundSurface)
										</div>
									</div>
									<div class="row align-items-center pb-3 form-control-sm">
										<label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Bewoonbare oppervlakte</label>
										<div class="col-lg-7 col-xl-6">
											@Html.EditorFor(m => m.Unit.Surface)
										</div>
									</div>
								</div>
								<!-- INDELING-->
								<div class="tab-pane fade show" id="indeling" role="tabpanel" aria-labelledby="indeling-tab">
									<div id="RoomRows" class="ecommerce-attributes-wrapper">
										@foreach(var item in Model.Rooms)
										{
											@await Html.PartialAsync("_RoomEditorRow", item)
										}
									</div>
									<div class="row justify-content-center mt-4">
										<div class="col-xl-9 text-end">
											<a href="#" class="ecommerce-attribute-add-new btn btn-primary btn-px-4 btn-py-2" id="btnAddRoom">+ Ruimte toevoegen</a>
										</div>
									</div>
								</div>
								<!-- DOCUMENTEN-->
								<div class="tab-pane fade show" id="documenten" role="tabpanel" aria-labelledby="documenten-tab">
									<div class="form-group row pb-4">
										<label class="col-lg-5 col-xl-3 control-label text-lg-end pt-2">Verkoopplan opladen</label>
										<div class="col-lg-7 col-xl-6">
											@if (Model.Unit.Plan is null)
											{
												<div class="fileupload fileupload-new w-100" data-provides="fileupload">
													<div class="input-append d-flex w-100 gap-2">
														<div class="uneditable-input d-flex flex-grow-1 align-items-center gap-2">
															<span class="fileupload-preview flex-grow-1 text-truncate"></span>
														</div>
														<span class="btn btn-default btn-file">
															<span class="fileupload-exists">Wijzig</span>
															<span class="fileupload-new">Selecteer bestand</span>
															<input type="file" name="file" accept=".pdf" formnovalidate="formnovalidate" />
														</span>
														<a href="#" class="btn btn-default fileupload-exists" data-dismiss="fileupload">Verwijder</a>
													</div>
												</div>
											}
											else
											{
												<div class="fileupload fileupload-exists w-100" data-provides="fileupload" data-name="Unit.Plan">
													@Html.HiddenFor(m => m.Unit.Plan)
													<div class="input-append d-flex w-100 gap-2">
														<div class="uneditable-input d-flex flex-grow-1 align-items-center gap-2">
															<span class="fileupload-preview flex-grow-1 text-truncate">@Model.Unit.Plan</span>
														</div>
														<span class="btn btn-default btn-file">
															<span class="fileupload-exists">Wijzig</span>
															<span class="fileupload-new">Selecteer bestand</span>
															<input type="file" name="file" accept=".pdf" formnovalidate="formnovalidate" />
														</span>
														<a href="#" class="btn btn-default fileupload-exists" data-dismiss="fileupload">Verwijder</a>
													</div>
												</div>
											}
										</div>
									</div>

									<div class="row pb-4">
										<label class="col-lg-5 col-xl-3 control-label text-lg-end pt-2">Uitvoeringsplannen</label>
										<div class="col-lg-7 col-xl-6">
											<div id="executionPlanPreview" class="d-flex flex-wrap gap-2 align-items-start">
												@foreach (var plan in Model.ExecutionPlans)
												{
													<div class="position-relative gl-execution-plan-item" data-existing-plan-id="@plan.Id">
														<div class="gl-execution-plan-preview d-flex flex-column align-items-center justify-content-center text-center p-1">
															<i class="fa fa-file-pdf text-danger fs-1"></i>
															<span class="small text-truncate w-100" title="@plan.Name">@plan.Name</span>
														</div>
														<input type="hidden" name="deleteExecutionPlanIds" value="@plan.Id" disabled data-delete-plan-input="@plan.Id" />
														<button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 p-0 gl-execution-plan-remove" data-remove-existing-plan="@plan.Id">×</button>
													</div>
												}
												<button type="button" id="addExecutionPlanButton" class="btn d-inline-flex flex-column align-items-center justify-content-center gl-execution-plan-add-tile">
													<i class="bx bx-file fs-3"></i>
													<span class="gl-tile-label">Toevoegen</span>
												</button>
											</div>
											<input id="executionPlanFilesInput" name="executionPlanFiles" type="file" accept="application/pdf,.pdf" class="d-none" />
											<div id="executionPlanNamesContainer"></div>
											<small class="text-muted d-block mt-2">Voeg meerdere uitvoeringsplannen toe met naam.</small>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
			</section>
		</div>
	</div>
	<div class="row action-buttons">
		<div class="col-12 col-md-auto">
			<button type="submit" class="submit-button btn btn-primary btn-px-4 py-3 d-flex align-items-center font-weight-semibold line-height-1" data-loading-text="Laden...">
				<i class="bx bx-save text-4 me-2"></i> Eenheid opslaan
			</button>
		</div>
		<div class="col-12 col-md-auto px-md-0 mt-3 mt-md-0">
			<a href="@TempData.Peek("Referrer")" class="cancel-button btn btn-light btn-px-4 py-3 border font-weight-semibold text-color-dark text-3">Annuleren</a>
		</div>
		
	</div>
}

<div class="modal fade" id="executionPlanNameModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Naam uitvoeringsplan</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
			</div>
			<div class="modal-body">
				<label class="form-label">Naam</label>
				<input type="text" id="executionPlanNameInput" class="form-control" placeholder="bv. Technisch uitvoeringsplan" />
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-default" data-bs-dismiss="modal">Annuleren</button>
				<button type="button" class="btn btn-primary" id="confirmExecutionPlanName">Toevoegen</button>
			</div>
		</div>
	</div>
</div>


<!-- Magnific Popup – bevestiging verwijderen afwerkingsgroep -->
<div id="gl-confirm-remove-option" class="mfp-hide">
	<div class="gl-confirm-popup">
		<h5 class="gl-confirm-title"><i class="fa fa-trash me-2 text-danger"></i>Afwerkingsgroep verwijderen</h5>
		<p class="gl-confirm-body">Ben je zeker dat je deze afwerkingsgroep en alle bijhorende bouwwaardes wilt verwijderen?</p>
		<div class="gl-confirm-actions">
			<button type="button" class="btn btn-default btn-sm" id="gl-confirm-cancel">Annuleren</button>
			<button type="button" class="btn btn-danger btn-sm" id="gl-confirm-delete">Verwijderen</button>
		</div>
	</div>
</div>

@section PageScripts
{
	<script src="~/lib/select2/js/select2.js"></script>
	<script src="~/lib/bootstrap-fileupload/bootstrap-fileupload.min.js"></script>
	<script src="~/lib/jquery-mask/jquery.mask.js"></script>
	<script src="~/lib/magnific-popup/jquery.magnific-popup.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/autonumeric@4.6.0/dist/autoNumeric.min.js"></script>
	<script src="~/js/currency.js"></script>
	<script>
		// ==============================
		// BIJ VERANDEREN VAN HOOFDTYPE
		// ==============================
		$('#lstGroupTypes').on('change', function () {

			var val = $(this).val();
			if (val) {

				var subitems = "";
				$.getJSON("@Url.Action("GetSubType", "Projecten")", { id: val }, function (data) {
					$.each(data, function (index, item) {
						subitems += "<option value='" + item.id + "'>" + item.display + "</option>";
					});
					$('#lstTypes').html(subitems);
					$('#lstTypes').attr("disabled", false);
				});
			}
			else {
				$('#lstTypes').attr("disabled", true);
			}
		});

		// ==============================
		// Select2 UX fixes (ongewijzigd)
		// ==============================

		// on first focus (bubbles up to document), open the menu
		$(document).on('focus', '.select2-selection.select2-selection--single', function () {
			$(this).closest(".select2-container")
				   .siblings('select:enabled')
				   .select2('open');
		});

		// steal focus during close - only capture once and stop propagation
		$('select.select2').on('select2:closing', function (e) {
			$(e.target).data("select2").$selection.one('focus focusin', function (e) {
				e.stopPropagation();
			});
		});

		// ==============================
		// CurrencyMask init (vervangt mask + submit-cleaning)
		// ==============================
		$(document).ready(function () {
			CurrencyMask.init('.Currencymask');
			CurrencyMask.init('.Surfacemask');
			glRecalcBedragen();
		});

		// ==============================
		// Auto-herberekening bedragen
		// ==============================
		function glGetAN(el) {
			const an = AutoNumeric.getAutoNumericElement(el);
			return an ? (an.getNumber() || 0) : 0;
		}

		function glFormatEuro(val) {
			if (!val) return '€ –';
			return '€ ' + val.toLocaleString('nl-BE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
		}

		function glRecalcBedragen() {
			const grondInput = document.getElementById('Unit_LandValue');
			const grond = grondInput ? glGetAN(grondInput) : 0;

			let totalBouw = 0;
			const groepRows = [];

			document.querySelectorAll('.gl-finishing-option-section').forEach(function (section) {
				let sectionTotal = 0;
				section.querySelectorAll('.gl-cv-rows .Currencymask').forEach(function (inp) {
					sectionTotal += glGetAN(inp);
				});
				totalBouw += sectionTotal;

				const subtotaalEl = section.querySelector('.gl-option-subtotal');
				if (subtotaalEl) subtotaalEl.textContent = glFormatEuro(sectionTotal);

				const nameInput = section.querySelector('.gl-option-name');
				const name = nameInput ? (nameInput.value.trim() || 'Optie') : 'Optie';
				groepRows.push({ name: name, grond: grond, bouw: sectionTotal });
			});

			const totalBouwEl = document.getElementById('gl-bouw-totaal');
			if (totalBouwEl) totalBouwEl.textContent = glFormatEuro(totalBouw);

			const totaalprijsContainer = document.getElementById('gl-totaalprijs-rows');
			if (totaalprijsContainer) {
				if (groepRows.length === 0) {
					totaalprijsContainer.innerHTML = '<span class="text-muted small">Voeg een afwerkingsoptie toe.</span>';
				} else {
					totaalprijsContainer.innerHTML = groepRows.map(function (r) {
						const total = r.grond + r.bouw;
						return '<div class="d-flex justify-content-between align-items-center py-2 border-bottom">' +
							'<span class="text-muted small">' + r.name + ': Grond ' + glFormatEuro(r.grond) + ' + Bouw ' + glFormatEuro(r.bouw) + ' =' + '</span>' +
							'<strong>' + glFormatEuro(total) + '</strong>' +
							'</div>';
					}).join('');
				}
			}
		}

		$(document).on('change autoNumeric:rawValueModified', '#bedragen .Currencymask', function () {
			glRecalcBedragen();
		});

		document.querySelector('#bedragen-tab')?.addEventListener('shown.bs.tab', glRecalcBedragen);

		// ==============================
		// Nieuwe rij bij indeling
		// ==============================
		$("#btnAddRoom").click(function () {
			$.ajax({
				url: "BlankRoomRow",
				data: { unitid: @Model.Unit.Id },
				cache: false,
				traditional: true,
				type: 'POST',
				success: function (html) {
					const $row = $(html);
					$("#RoomRows").append($row);

					// 🔑 CurrencyMask op nieuwe inputs
					CurrencyMask.init($row.find('.Currencymask, .Surfacemask'));
				}
			});
			return false;
		});

		// ==============================
		// Afwerkingsopties beheren (AJAX)
		// ==============================
		$('#btnAddFinishingOption').click(function () {
			const name = 'Afwerkingsgroep';
			$.post('@Url.Action("AddFinishingOption", "Projecten")', { unitId: @Model.Unit.Id, name: name }, function (data) {
				if (data.error) { alert(data.error); return; }
				$.ajax({
					url: 'BlankFinishingOptionSection',
					data: { optionId: data.id, unitId: @Model.Unit.Id, projectId: @Model.ProjectId },
					type: 'POST',
					success: function (html) {
						$('#FinishingOptionSections').append(html);
						CurrencyMask.init($('#FinishingOptionSections').find('.Currencymask'));
						glRecalcBedragen();
					}
				});
			});
		});

		$(document).on('blur', '.gl-option-name', function () {
			const $input = $(this);
			const optionId = $input.data('option-id');
			const name = $input.val().trim();
			if (!name) return;
			$.post('@Url.Action("RenameFinishingOption", "Projecten")', { id: optionId, name: name });
		});

		let _glRemoveOptionId = null;
		let _glRemoveSection  = null;

		$(document).on('click', '.gl-remove-finishing-option', function () {
			_glRemoveOptionId = $(this).data('option-id');
			_glRemoveSection  = $(this).closest('.gl-finishing-option-section');
			$.magnificPopup.open({
				items: { src: '#gl-confirm-remove-option', type: 'inline' },
				modal: true
			});
		});

		$(document).on('click', '#gl-confirm-cancel', function () {
			$.magnificPopup.close();
			_glRemoveOptionId = null;
			_glRemoveSection  = null;
		});

		$(document).on('click', '#gl-confirm-delete', function () {
			if (!_glRemoveOptionId) return;
			$.post('@Url.Action("RemoveFinishingOption", "Projecten")', { id: _glRemoveOptionId }, function () {
				_glRemoveSection.remove();
				glRecalcBedragen();
			});
			$.magnificPopup.close();
			_glRemoveOptionId = null;
			_glRemoveSection  = null;
		});

		$(document).on('click', '.gl-add-cv-for-option', function () {
			const $btn = $(this);
			const optionId = $btn.data('option-id');
			const unitId = $btn.data('unit-id');
			const projectId = $btn.data('project-id');
			$.ajax({
				url: 'BlankConstructionValueRow',
				data: { unitid: unitId, projectid: projectId, finishingOptionId: optionId },
				cache: false,
				type: 'POST',
				success: function (html) {
					const $row = $(html);
					$btn.closest('.card-body').find('.gl-cv-rows').append($row);
					CurrencyMask.init($row.find('.Currencymask'));
					glRecalcBedragen();
				}
			});
		});

		// ==============================
		// Indeling verwijderen
		// ==============================
		$(document).on('click', 'a.deleteRow', function () {
			$(this).closest('div').parent('div').remove();
			return false;
		});

		// ==============================
		// Bouwwaarde verwijderen
		// ==============================
		$(document).on('click', 'a.deleteConstructionRow', function () {
			$(this).closest('tr').remove();
			glRecalcBedragen();
			return false;
		});


		// ==============================
		// Uitvoeringsplannen (meerdere PDF + naam)
		// ==============================
		const executionPlanFilesInput = document.getElementById('executionPlanFilesInput');
		const executionPlanPreview = document.getElementById('executionPlanPreview');
		const addExecutionPlanButton = document.getElementById('addExecutionPlanButton');
		const executionPlanNamesContainer = document.getElementById('executionPlanNamesContainer');
		const executionPlanNameInput = document.getElementById('executionPlanNameInput');
		const confirmExecutionPlanName = document.getElementById('confirmExecutionPlanName');
		const executionPlanNameModalEl = document.getElementById('executionPlanNameModal');
		const executionPlanNameModal = executionPlanNameModalEl ? new bootstrap.Modal(executionPlanNameModalEl) : null;

		let pendingExecutionPlanFile = null;
		let executionPlanQueue = [];

		function rebuildExecutionPlanFiles() {
			if (!executionPlanFilesInput) return;
			const dt = new DataTransfer();
			executionPlanQueue.forEach(item => dt.items.add(item.file));
			executionPlanFilesInput.files = dt.files;
			executionPlanNamesContainer.innerHTML = '';
			executionPlanQueue.forEach(item => {
				const input = document.createElement('input');
				input.type = 'hidden';
				input.name = 'executionPlanNames';
				input.value = item.name;
				executionPlanNamesContainer.appendChild(input);
			});
		}

		function createExecutionPlanCard(name, key, existingId) {
			const wrapper = document.createElement('div');
			wrapper.className = 'position-relative gl-execution-plan-item';
			wrapper.dataset.planKey = key;
			wrapper.innerHTML = `<div class="gl-execution-plan-preview d-flex flex-column align-items-center justify-content-center text-center p-1"><i class="bx bxs-file-pdf text-danger fs-1"></i><span class="small text-truncate w-100" title="${name}">${name}</span></div>`;

			const remove = document.createElement('button');
			remove.type = 'button';
			remove.className = 'btn btn-danger btn-sm position-absolute top-0 end-0 p-0 gl-execution-plan-remove';
			remove.textContent = '×';
			remove.addEventListener('click', () => {
				if (existingId) {
					const hiddenInput = document.querySelector(`[data-delete-plan-input="${existingId}"]`);
					if (hiddenInput) hiddenInput.disabled = false;
				} else {
					executionPlanQueue = executionPlanQueue.filter(x => x.key !== key);
					rebuildExecutionPlanFiles();
				}
				wrapper.remove();
			});

			wrapper.appendChild(remove);
			executionPlanPreview.insertBefore(wrapper, addExecutionPlanButton);
		}

		addExecutionPlanButton?.addEventListener('click', () => executionPlanFilesInput?.click());

		executionPlanFilesInput?.addEventListener('change', (e) => {
			const file = (e.target.files || [])[0];
			executionPlanFilesInput.value = '';
			if (!file) return;
			if ((file.type && file.type !== 'application/pdf') && !file.name.toLowerCase().endsWith('.pdf')) {
				alert('Kies een PDF bestand.');
				return;
			}
			pendingExecutionPlanFile = file;
			executionPlanNameInput.value = file.name.replace(/\.pdf$/i, '');
			executionPlanNameModal?.show();
			setTimeout(() => executionPlanNameInput.focus(), 200);
		});

		confirmExecutionPlanName?.addEventListener('click', () => {
			if (!pendingExecutionPlanFile) return;
			const name = (executionPlanNameInput.value || '').trim() || pendingExecutionPlanFile.name.replace(/\.pdf$/i, '');
			const key = `${Date.now()}_${Math.random().toString(36).slice(2)}`;
			executionPlanQueue.push({ key, name, file: pendingExecutionPlanFile });
			rebuildExecutionPlanFiles();
			createExecutionPlanCard(name, key, null);
			pendingExecutionPlanFile = null;
			executionPlanNameModal?.hide();
		});

		executionPlanNameModalEl?.addEventListener('hidden.bs.modal', () => {
			pendingExecutionPlanFile = null;
		});

		document.querySelectorAll('[data-remove-existing-plan]').forEach(button => {
			button.addEventListener('click', () => {
				const id = button.getAttribute('data-remove-existing-plan');
				const hiddenInput = document.querySelector(`[data-delete-plan-input="${id}"]`);
				if (hiddenInput) hiddenInput.disabled = false;
				const card = document.querySelector(`[data-existing-plan-id="${id}"]`);
				if (card) card.remove();
			});
		});
	</script>

}