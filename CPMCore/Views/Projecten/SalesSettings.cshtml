@using CPMCore.Controllers
@using CPMCore.Helpers
@using BOCore
@inject IConfiguration Configuration
@model CPMCore.Models.Projecten.ProjectSalesSettingsModel

@section PageStyle
{
	<link rel="stylesheet" href="~/lib/bootstrap-fileupload/bootstrap-fileupload.min.css" />
	<link rel="stylesheet" href="~/lib/select2/css/select2.css" />
 	<link rel="stylesheet" href="~/lib/select2-bootstrap-theme/select2-bootstrap.css" />
	<link rel="stylesheet" href="~/css/admin/theme-admin-extension.css" />
	<link rel="stylesheet" href="~/css/admin/skins/extension.css" />
	<link rel="stylesheet" href="~/lib/bootstrap-tagsinput/bootstrap-tagsinput.css" />
	<link rel="stylesheet" href="~/lib/bootstrap-multiselect/css/bootstrap-multiselect.css">
	<link rel="stylesheet" href="~/lib/dropzone/basic.css" />
	<link rel="stylesheet" href="~/lib/dropzone/dropzone.css" />
	<script src="https://cdnjs.cloudflare.com/ajax/libs/inputmask/5.0.8/jquery.inputmask.min.js"></script>

}
<div class="row">
<div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
		<div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
			<div class="row align-items-center">
				<div class="col-sm-auto d-flex align-items-center">
					<a href="@Url.Action("DetailSales", "Projecten", new { projectid = Model.ProjectId })" class="text-decoration-none text-reset d-flex align-items-center">
						<i class="bx bx-chevron-left fs-1"></i>
					</a>
				</div>
				<div class="col-sm-auto">
					<h1 class="fw-bold mb-0">Verkoopinstellingen</h1>
					<h5 class="mb-4 mt-0">Bewerk hier de verkoopinstellingen van het project</h5>
				</div>
			</div>
		</div>
</div>
</div>
@if (Model.MissingBuilder)
{
	<div class="alert alert-warning alert-dismissible fade show" role="alert">
		<i class="bx bx-error-circle"></i> @Model.BuilderWarning
		<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
	</div>
}
@using (Html.BeginForm("UpdateSalesSettings", "Projecten", FormMethod.Post, new { @class = "ecommerce-form action-buttons-fixed", @action = "#" }))
{

	@Html.HiddenFor(m => m.ProjectId)
	@Html.HiddenFor(m => m.Settings.SettingsId)
	@Html.HiddenFor(m => m.Settings.ProjectId)
	@Html.HiddenFor(m => m.ProjectName)
	@Html.HiddenFor(m => m.Project.Id)
	<div class="row mt-2">
		<div class="col">
			<section class="card card-modern card-big-info">
				<div class="card-body">
					<div class="row">
						<div class="col-lg-2-5 col-xl-1-5">
							<i class="card-big-info-icon bx bx-wallet"></i>
							<h2 class="card-big-info-title">Financiële instellingen</h2>
							<p class="card-big-info-desc">Bewerk hier de algemene instellingen van de verkoop van het project</p>
						</div>
						<div class="col-lg-3-5 col-xl-4-5">
							<div class="row align-items-center pb-3">
								<label class="col-lg-3 control-label text-lg-end pt-2 col-lg-3">Verkoop onder btw-stelsel</label>
								<div class="col-lg-9">
									<div class="switch switch-sm switch-primary">
										@Html.CheckBox("Settings.MixedVatRegistration", Model.Settings.MixedVatRegistration ?? false,
										new { data_plugin_ios_switch = "" })
									</div>

								</div>
							</div>
							<div class="row align-items-center pb-3">
								<label class="col-lg-3 control-label text-lg-end pt-2 col-lg-3">@Html.LabelFor(m => m.Settings.RegistrationType)</label>
								<div class="col-lg-9">
									@Html.DropDownListFor(m => m.Settings.RegistrationType, Html.GetEnumSelectList(Model.Settings.RegistrationType.GetType()), new { @class = "form-control form-control-modern"})
								</div>
							</div>
							<div class="row align-items-center pb-3">
								<label class="col-lg-3 control-label text-lg-end pt-2 col-lg-3">@Html.LabelFor(m => m.Settings.RegistrationPercentage)</label>
								<div class="col-lg-9">
									@Html.EditorFor(m => m.Settings.RegistrationPercentage)
								</div>
							</div>
							<div class="row  align-items-center pb-3">
								<label class="col-lg-3 control-label text-lg-end pt-2 col-lg-3">@Html.LabelFor(m => m.Settings.VatPercentage)</label>
								<div class="col-lg-9">
									@Html.EditorFor(m => m.Settings.VatPercentage)
								</div>
							</div>

						<div class="row  align-items-center pb-3">
							<label class="col-lg-3 control-label text-lg-end pt-2 col-lg-3">@Html.LabelFor(m => m.Settings.BankAccountId, "Projectrekening")</label>
							<div class="col-lg-9">
								@if (Model.BankAccounts != null && Model.BankAccounts.Any())
									{
										@Html.DropDownListFor(m => m.Settings.BankAccountId, Model.BankAccounts, "Selecteer een projectrekening", new { @class = "form-control form-control-modern" })
										<small class="text-muted">Rekeningen behorend bij de geselecteerde bouwer.</small>
									}
									else
									{
										<p class="mb-1 text-muted">Geen rekeningen gevonden voor deze bouwer. Vul hieronder een IBAN in om een projectrekening aan te maken.</p>
									}
									<div class="mt-2">
										@Html.TextBoxFor(m => m.NewBankAccountIban, new { placeholder = "Nieuw IBAN voor projectrekening", @class = "form-control form-control-modern" })
										<small class="text-muted">Ontbrekende rekeningen worden automatisch aangemaakt bij issuer 1 met de projectnaam als omschrijving.</small>
									</div>
									<div>
										@Html.ValidationMessageFor(m => m.Settings.BankAccountId, "", new { @class = "text-danger" })
										@Html.ValidationMessageFor(m => m.NewBankAccountIban, "", new { @class = "text-danger" })
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
		</div>
	</div>
	<div class="row mt-4">
		<div class="col">
			<section class="card card-modern card-big-info">
				<div class="card-body">
					<div class="row">
						<div class="col-lg-2-5 col-xl-1-5">
							<i class="card-big-info-icon bx bx-euro"></i>
							<h2 class="card-big-info-title">Kosten</h2>
							<p class="card-big-info-desc">Bewerk hier de aktekosten en andere gerelateerde kosten van het project</p>
						</div>
						<div class="col-lg-3-5 col-xl-4-5">
							<div class="row align-items-center pb-3">
								<label class="col-lg-3 control-label text-lg-end pt-2 col-lg-3">@Html.LabelFor(m => m.Settings.FixedCertificateCost)</label>
								<div class="col-lg-9">
									@Html.EditorFor(m => m.Settings.FixedCertificateCost)
								</div>
							</div>
							<div class="row align-items-center pb-3">
								<label class="col-lg-3 control-label text-lg-end pt-2 col-lg-3">@Html.LabelFor(m => m.Settings.MortageRegistrationCost)</label>
								<div class="col-lg-9">
									@Html.EditorFor(m => m.Settings.MortageRegistrationCost)
								</div>
							</div>
							<div class="row align-items-center pb-3">
								<label class="col-lg-3 control-label text-lg-end pt-2 col-lg-3">@Html.LabelFor(m => m.Settings.BaseCertificateCost)</label>
								<div class="col-lg-9">
									@Html.EditorFor(m => m.Settings.BaseCertificateCost)
								</div>
							</div>
							<div class="row align-items-center pb-3">
								<label class="col-lg-3 control-label text-lg-end pt-2 col-lg-3">@Html.LabelFor(m => m.Settings.ParcelCost)</label>
								<div class="col-lg-9">
									@Html.EditorFor(m => m.Settings.ParcelCost)
								</div>
							</div>
							<div class="row align-items-center pb-3">
								<label class="col-lg-3 control-label text-lg-end pt-2 col-lg-3">@Html.LabelFor(m => m.Settings.ConnectionFees)</label>
								<div class="col-lg-9">
									@Html.EditorFor(m => m.Settings.ConnectionFees)
								</div>
							</div>
							<div class="row align-items-center pb-3">
								<label class="col-lg-3 control-label text-lg-end pt-2 col-lg-3">@Html.LabelFor(m => m.Settings.SurveyorCost)</label>
								<div class="col-lg-9">
									@Html.EditorFor(m => m.Settings.SurveyorCost)
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
		</div>
	</div>
	<div class="row mt-4">
		<div class="col">
			<section class="card card-modern card-big-info">
				<div class="card-body">
					<div class="row">
						<div class="col-lg-2-5 col-xl-1-5">
							<i class="card-big-info-icon bx bx-desktop"></i>
							<h2 class="card-big-info-title">Website</h2>
							<p class="card-big-info-desc">Bewerk hier de instellingen met betrekking tot de websites</p>
						</div>
						<div class="col-lg-3-5 col-xl-4-5">
						<div class="row align-items-center pb-3">
							<label class="col-lg-3 control-label text-lg-end pt-2 col-lg-3">Verkoop zichtbaar maken </label>
							<div class="col-lg-9">
								<div class="switch switch-sm switch-primary">
									@Html.CheckBox("Settings.SaleVisible", Model.Settings.SaleVisible ?? false, new { data_plugin_ios_switch = "" })
								</div>

							</div>
						</div>
						<div class="row align-items-center pb-3">
							<label class="col-lg-3 control-label text-lg-end pt-2 col-lg-3">Uitgelicht project</label>
							<div class="col-lg-9">
								<div class="switch switch-sm switch-primary">
									@Html.CheckBox("Settings.IsFeatured", Model.Settings.IsFeatured ?? false, new { data_plugin_ios_switch = "" })
								</div>
							</div>
						</div>
						<div class="row align-items-center pb-3">
							<label class="col-lg-3 control-label text-lg-end pt-2 col-lg-3">Website status</label>
							<div class="col-lg-9">
								@Html.DropDownListFor(m => m.Settings.SalesDisplayStatus, Html.GetEnumSelectList(typeof(BOCore.SalesDisplayStatus)), "Automatisch bepalen", new { @class = "form-control form-control-modern" })
							</div>
						</div>
						<div class="row  align-items-center pb-3">
							<label class="col-lg-3 control-label text-lg-end pt-2 col-lg-3">@Html.LabelFor(m => m.Project.CommercialTitleNL)</label>
							<div class="col-lg-9">
								@Html.TextBoxFor(m => m.Project.CommercialTitleNL, new { placeholder = "Title voor website", @class = "form-control form-control-modern" })
							</div>
						</div>
						<div class="row  align-items-center pb-3">
							<label class="col-lg-3 control-label text-lg-end pt-2 col-lg-3">@Html.LabelFor(m => m.Project.CommercialTextNL)</label>
							<div class="col-lg-9">
								@Html.TextAreaFor(m => m.Project.CommercialTextNL, new { placeholder = "Tekst voor website", @class = "form-control form-control-modern", @rows="5" })
							</div>
						</div>
						</div>
					</div>
				</div>
			</section>
		</div>
	</div>
	<div class="row action-buttons">
		<div class="col-12 col-md-auto">
			<button type="submit" class="submit-button btn btn-primary btn-px-4 py-3 d-flex align-items-center font-weight-semibold line-height-1" data-loading-text="Laden...">
				<i class="bx bx-save text-4 me-2"></i> Instellingen opslaan
			</button>
		</div>
		<div class="col-12 col-md-auto px-md-0 mt-3 mt-md-0">
			<a href="@TempData.Peek("Referrer")" class="cancel-button btn btn-light btn-px-4 py-3 border font-weight-semibold text-color-dark text-3">Annuleren</a>
		</div>

	</div>
}


@section PageScripts
{
	<script src="~/lib/select2/js/select2.js"></script>
	<script src="~/js/theme.admin.extension.js"></script>
	<script src="~/lib/select2/js/i18n/nl.js"></script>
	<script src="~/lib/jquery-validation/jquery.validate.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/autonumeric@4.6.0/dist/autoNumeric.min.js"></script>
	<script src="~/js/currency.js"></script>
	<script src="~/lib/ios7-switch/ios7-switch.js"></script>

	<script>
		// ==============================
		// CurrencyMask init (ipv AutoNumeric)
		// ==============================
		$(document).ready(function () {
			CurrencyMask.init('.Currencymask');
		});
	</script>

	<script>
		// ==============================
		// iOS switches (ongewijzigd)
		// ==============================
		document.addEventListener('DOMContentLoaded', function () {
			initIosSwitches();
		});

		function initIosSwitches() {
			var $els = $('[data-plugin-ios-switch]');
			$els.each(function () {
				var $el = $(this);
				if (!$el.data('plugin-ios7Switch')) {
					$el.themePluginIOS7Switch(); // Porto init
				}
			});
		}
	</script>

}