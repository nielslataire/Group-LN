@using CPMCore.Models.Projecten
@model IProjectFormModel
@{
    var showWerfmelding = ViewData["ShowWerfmelding"] as bool? ?? false;
}

<section class="gl-form-section">
    <div class="gl-form-section__body">
        <div class="gl-form-section__head">
            <i class="bx bx-info-circle" aria-hidden="true"></i>
            <div>
                <h2 class="gl-form-section__title">Algemene info</h2>
                <p class="gl-form-section__hint">Naam, code, adres en de commerciële teksten.</p>
            </div>
        </div>

        @Html.HiddenFor(m => m.SelectedPostalcode, new { id = "SelectedPostalcode" })

        <div class="gl-field-grid">
            <div class="gl-field">
                <label for="Project_Name">@Html.DisplayNameFor(m => m.Project.Name) <span class="gl-req" aria-hidden="true">*</span></label>
                @Html.TextBoxFor(m => m.Project.Name, new { @class = "form-control form-control-modern", placeholder = "Naam van het project", autocomplete = "off", required = "required" })
                <span asp-validation-for="Project.Name" class="text-danger"></span>
            </div>

            <div class="gl-field">
                <label for="Project_ProjectCode">@Html.DisplayNameFor(m => m.Project.ProjectCode)</label>
                @Html.TextBoxFor(m => m.Project.ProjectCode, new { @class = "form-control form-control-modern", placeholder = "bv. P-2024-118", maxlength = "50", autocomplete = "off", id = "Project_ProjectCode" })
                <span asp-validation-for="Project.ProjectCode" class="text-danger"></span>
            </div>

            <div class="gl-field gl-field--full">
                <label for="Project_Street">@Html.DisplayNameFor(m => m.Project.Street)</label>
                <div class="gl-field-address">
                    <div class="gl-street">
                        @Html.TextBoxFor(m => m.Project.Street, new { @class = "form-control form-control-modern", placeholder = "Straat" })
                    </div>
                    <div class="gl-nr">
                        @Html.TextBoxFor(m => m.Project.HouseNumber, new { @class = "form-control form-control-modern", placeholder = "Nr.", aria_label = "Huisnummer" })
                    </div>
                </div>
            </div>

            <div class="gl-field">
                <label for="lstProjectCountries">Land</label>
                @Html.DropDownListFor(m => m.SelectedCountry, new SelectList(Model.Countries, "ID", "Display", Model.SelectedCountry), new { @class = "form-control form-control-modern", id = "lstProjectCountries" })
            </div>

            <div class="gl-field">
                <label for="PostalSelect">Gemeente <span class="gl-req" aria-hidden="true">*</span></label>
                <select id="PostalSelect" class="form-control w-100" aria-label="Gemeente">
                    @if (Model.SelectedPostalcode > 0)
                    {
                        <option value="@Model.SelectedPostalcode" selected>
                            @($"{Model.Project.Postalcode.Postcode} - {Model.Project.Postalcode.Gemeente}")
                        </option>
                    }
                </select>
                <span id="postalSelectError" class="text-danger" hidden>Kies een gemeente uit de lijst.</span>
            </div>

            @if (showWerfmelding)
            {
                <div class="gl-field">
                    <label for="Project_WerfmeldingDate">@Html.DisplayNameFor(m => m.Project.WerfmeldingDate)</label>
                    @Html.TextBoxFor(m => m.Project.WerfmeldingDate, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control form-control-modern", id = "Project_WerfmeldingDate" })
                </div>
                <div class="gl-field">
                    <label for="Project_WerfmeldingDossier">@Html.DisplayNameFor(m => m.Project.WerfmeldingDossier)</label>
                    @Html.TextBoxFor(m => m.Project.WerfmeldingDossier, new { @class = "form-control form-control-modern", placeholder = "Dossiernummer", maxlength = "100", id = "Project_WerfmeldingDossier" })
                </div>
            }

            <div class="gl-field gl-field--full">
                <label for="Project_CommercialTitleNL">@Html.DisplayNameFor(m => m.Project.CommercialTitleNL)</label>
                @Html.TextBoxFor(m => m.Project.CommercialTitleNL, new { @class = "form-control form-control-modern", placeholder = "Commerciële titel" })
            </div>

            <div class="gl-field gl-field--full gl-field--wide">
                <label for="commercialTextEditorContainer">@Html.DisplayNameFor(m => m.Project.CommercialTextNL)</label>
                <div id="commercialTextEditorContainer"></div>
                @Html.TextAreaFor(m => m.Project.CommercialTextNL, 6, 40, new { @class = "d-none", id = "commercialTextEditor" })
                <small class="text-muted">Opmaak (vet, lijsten, links) wordt bewaard.</small>
            </div>
        </div>
    </div>
</section>
