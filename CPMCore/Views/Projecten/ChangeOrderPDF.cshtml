@using BOCore
@model CPMCore.Models.Projecten.ProjectChangeOrderExportModel
@{
    Layout = null;
    var vatAmount = Model.ProjectSalesSettings.VatPercentage * Model.ChangeOrder.Totaal / 100;
    var totalIncl = Model.ChangeOrder.Totaal + vatAmount;
}

<!DOCTYPE html>
<html style="height:100%">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Wijzigingsopdracht @Model.Project.Name - @Model.ClientAccount.DisplayName</title>
    <style>
        body {
            font-family: "Avenir", "Avenir Next", "Segoe UI", Arial, sans-serif;
            font-size: 12px;
            color: #2f3640;
            margin: 0;
            padding: 20px 28px 44mm;
            line-height: 1.35;
        }

        .title {
            font-size: 22px;
            font-weight: 700;
            text-align: center;
            margin-bottom: 10px;
        }

        .sub-title {
            text-align: center;
            font-size: 14px;
            margin-bottom: 4px;
        }

        .description {
            text-align: center;
            margin-bottom: 18px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        .line-table {
            margin-top: 30px;
        }

        .line-table th,
        .line-table td {
            border-bottom: 1px solid #dfe4ea;
            padding: 8px 6px;
            vertical-align: top;
        }

        .line-table th {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .03em;
            color: #6c757d;
            font-weight: 700;
        }

        .text-end {
            text-align: right;
        }

        .totals {
            margin-top: 18px;
            margin-left: auto;
            width: 52%;
        }

            .totals td {
                padding: 5px 0;
            }

            .totals .grand-total {
                font-weight: 700;
                border-top: 1px solid #dfe4ea;
                padding-top: 8px;
            }

        .notice {
            margin-top: 24px;
            font-weight: 600;
        }

        .footer {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            height: 38mm;
            border-top: 1px solid #dfe4ea;
            padding: 0 28px;
            font-size: 11px;
            display: flex;
            align-items: flex-end;
        }

            .footer table {
                margin: 0;
            }

            .footer th,
            .footer td {
                border: 1px solid #dfe4ea;
                padding: 8px;
                vertical-align: top;
            }

            .footer th {
                background-color: #01532d;
                color: #ffffff;
            }

        .signature-row td {
            height: 54px;
        }
    </style>
</head>
<body>
    <div class="title">Wijzigingsopdracht - WO @Html.DisplayFor(m => m.ChangeOrder.ChangeOrderDate) - @Model.ChangeOrder.Id</div>
    <div class="sub-title"><strong>Project:</strong> @Model.Project.Name, @Model.Project.Street @Model.Project.HouseNumber te @Model.Project.Postalcode.Postcode @Model.Project.Postalcode.Gemeente</div>
    <div class="sub-title"><strong>Klant:</strong> @Model.ClientAccount.Salutation.GetDisplayName() @Model.ClientAccount.DisplayName</div>
    <div class="description">@Model.Units</div>
    <div class="description"><strong>Opdracht:</strong> @Model.ChangeOrder.Description</div>

    <table class="line-table">
        <thead>
            <tr>
                <th style="width:36%">Omschrijving</th>
                <th style="width:14%">Eenheid</th>
                <th style="width:14%">Type</th>
                <th style="width:10%" class="text-end">Hoev.</th>
                <th style="width:13%" class="text-end">EH-prijs</th>
                <th style="width:13%" class="text-end">Totaal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var detail in Model.ChangeOrder.Details)
            {
                var unitPrice = (detail.Price * detail.Commision / 100) + detail.Price;
                var rowTotal = unitPrice * detail.Number;
                <tr>
                    <td>@detail.Description</td>
                    <td>@detail.MeasurementUnit.GetDisplayName()</td>
                    <td>@detail.MeasurementType.GetDisplayName()</td>
                    <td class="text-end">@detail.Number</td>
                    <td class="text-end">@String.Format("{0:C}", unitPrice)</td>
                    <td class="text-end">@String.Format("{0:C}", rowTotal)</td>
                </tr>
            }
        </tbody>
    </table>

    @if (!string.IsNullOrWhiteSpace(Model.ChangeOrder.Comment))
    {
        <div style="margin-top:16px;">
            <strong>Opmerkingen:</strong><br />
            @Html.Raw(Model.ChangeOrder.Comment)
        </div>
    }

    <table class="totals">
        <tr>
            <td>Totale som van de opdracht (excl. btw):</td>
            <td class="text-end">@String.Format("{0:C}", Model.ChangeOrder.Totaal)</td>
        </tr>
        <tr>
            <td>BTW bedrag:</td>
            <td class="text-end">@String.Format("{0:C}", vatAmount)</td>
        </tr>
        <tr>
            <td class="grand-total">Totale som van de opdracht (incl. btw):</td>
            <td class="text-end grand-total">@String.Format("{0:C}", totalIncl)</td>
        </tr>
    </table>

    <div class="notice">Gelieve, indien u akkoord gaat, deze wijzigingsopdracht voor akkoord ondertekend terug te bezorgen tegen ten laatste @Html.DisplayFor(m => m.ChangeOrder.ExpirationDate).</div>

    <div class="footer">
        <table>
            <tr>
                <th style="width:40%">Voorwaarden</th>
                <th style="width:30%">Datum</th>
                <th style="width:30%">Handtekening voor akkoord</th>
            </tr>
            <tr class="signature-row">
                <td>@Model.ChangeOrder.ChangeOrderConditions</td>
                <td></td>
                <td></td>
            </tr>
        </table>
    </div>
</body>
</html>
