@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@model CPMCore.Models.Projecten.BWDModel

@{
    ViewData["Title"] = "Projecten - Weerverlet";
    var canWriteProjectWeather = ViewBag.CanWriteProjectWeather as bool? ?? false;
}

@section PageStyle
{
@* 	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.css"> *@
    <style>
        /* Container breedte zodat 2x6 maanden past */
        #weatherCalendar {
/*             max-width: 1600px;
            margin: 0 auto; */
        }

        /* Weekenden donker + niet klikbaar */
        .fc .fc-daygrid-day.fc-day-sat .fc-daygrid-day-frame,
        .fc .fc-daygrid-day.fc-day-sun .fc-daygrid-day-frame {
            background: #999;
        }

        .fc .fc-daygrid-day.fc-day-sat .fc-daygrid-day-number,
        .fc .fc-daygrid-day.fc-day-sun .fc-daygrid-day-number {
            color: #ccc;
        }

        .fc .fc-daygrid-day.fc-day-sat,
        .fc .fc-daygrid-day.fc-day-sun {
            pointer-events: none;
        }
        /* Kleiner dagnummer */
        .fc .fc-daygrid-day-number {
            font-size: 10px; /* bv. 10–11px */
            line-height: 14px;
            padding: 1;
            padding-bottom:0;
        }

        /* Grotere dagcellen in de year-view */
        #weatherCalendar .fc-multimonth .fc-daygrid-day-frame {
            min-height: 44px; /* > maak dit 56/72/88px naar smaak */
            display: flex;
            flex-direction: column;
        }



        #weatherCalendar .fc-daygrid-day-events {
            margin-top: 2px;
        }

        /* pill-styling compact zodat er 2-3 onder elkaar passen */
        #weatherCalendar .fc-daygrid-event {
            margin: 2px 0;
            padding: 0 6px;
            font-size: 11px;
            line-height: 1.15;
            border-radius: 6px;
        }
    </style>
}

@section PageScripts {

    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar/core@6.1.19/locales-all.global.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
          const el = document.getElementById('weatherCalendar');
          const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

          const EP = {
            bundle: '@Url.Action("GetCalendarBundle", "Projecten")',
            add:    '@Url.Action("AddBadWeatherDay", "Projecten")',
            update: '@Url.Action("UpdateBadWeatherDay", "Projecten")',
            del:    '@Url.Action("DeleteBadWeatherDay", "Projecten")'
          };

          const TYPE = { rain: 0, wind: 1 };
          let currentType = null;
          const typeShort = t => t === TYPE.wind ? 'W' : 'R';
          const typeColor = t => t === TYPE.wind ? '#fd7e14' : '#0d6efd';
          const textColor = '#ffffff';

          // ---------- Stevige AJAX helpers ----------
          async function postRaw(url, data) {
            // géén dataType forceren: laat jQuery de content-type volgen
            return $.ajax({ url, method: 'POST', data });
          }
          function coerceId(res) {
            if (typeof res === 'number') return res;
            if (typeof res === 'string') {
              const n = parseInt(res, 10);
              return Number.isFinite(n) ? n : NaN;
            }
            if (res && typeof res === 'object') {
              // veelvoorkomende varianten
              for (const k of ['id', 'Id', 'value', 'Value', 'message', 'Message']) {
                if (k in res) {
                  const n = parseInt(res[k], 10);
                  if (Number.isFinite(n)) return n;
                }
              }
            }
            return NaN;
          }
          async function postInt(url, data) {
            const res = await postRaw(url, data);
            const n = coerceId(res);
            return Number.isFinite(n) ? n : NaN;
          }
          async function postBool(url, data) {
            const res = await postRaw(url, data);
            if (typeof res === 'boolean') return res;
            if (typeof res === 'string') {
              const s = res.trim().toLowerCase();
              if (s === 'true') return true;
              if (s === 'false') return false;
            }
            return !!res;
          }

          // fetch bundel en zoek id op (fallback als add geen id teruggaf)
          async function probeId(wsId, dateStr, type) {
            try {
              const year = parseInt(dateStr.slice(0, 4), 10);
              const bundle = await $.getJSON(EP.bundle, { weatherstationid: wsId, year });
              const list = type === TYPE.wind ? (bundle.wind || []) : (bundle.rain || []);
              const y = year, m = parseInt(dateStr.slice(5,7), 10), d = parseInt(dateStr.slice(8,10), 10);
              const item = list.find(x => x.year === y && x.month === m && x.day === d);
              return item ? parseInt(item.id, 10) : NaN;
            } catch { return NaN; }
          }

          // Anti-race teller voor fetches
          let fetchSeq = 0;

          // id-cache + queue (per station|datum|type)
          const idCache = new Map();
          const pendingOps = new Map();
          const keyFor = (wsId, dateStr, type) => `${wsId}|${dateStr}|${type}`;
          const currentStation = () => document.getElementById('lstWeatherStations')?.value;

          const cal = new FullCalendar.Calendar(el, {
            initialView: 'multiMonthYear',
            locale: 'nl',
            firstDay: 1,
            height: 'auto',
            monthCount: 12,
            multiMonthMaxColumns: 6,
            multiMonthMinWidth: 120,
            dayMaxEventRows: 3,
            dayMaxEvents: 3,
            views: { multiMonthYear: { dayMaxEventRows: 3, dayMaxEvents: 3 } },
            headerToolbar: { left: 'prev', center: 'title', right: 'next' },
            buttonText: { prev: '‹', next: '›' },

            dayCellDidMount: (arg) => {
              const dow = arg.date.getDay();
              if (dow === 0 || dow === 6) arg.el.classList.add('fc-disabled-weekend');
            },

            dateClick: async (info) => {
              const dow = info.date.getDay();
              if (dow === 0 || dow === 6) return;
              await toggleByType(info.dateStr);
            },

            eventClick: async (arg) => {
              arg.jsEvent.preventDefault();
              await toggleByType(arg.event.startStr);
            },

            eventSources: [
              async (fetchInfo, success, failure) => {
                const seq = ++fetchSeq;
                try {
                  const wsId = currentStation();
                  const year = fetchInfo.start.getFullYear();
                  const bundle = await $.getJSON(EP.bundle, { weatherstationid: wsId, year });

                  const rain = (bundle.rain || []).map(d => {
                    const dstr = `${d.year}-${String(d.month).padStart(2,'0')}-${String(d.day).padStart(2,'0')}`;
                    idCache.set(keyFor(wsId, dstr, TYPE.rain), parseInt(d.id, 10));
                    return {
                      id: String(d.id), start: dstr, end: dstr, allDay: true,
                      title: 'R', color: '#0d6efd', textColor: '#ffffff',
                      extendedProps: { isWeather: true, type: TYPE.rain }
                    };
                  });

                  const wind = (bundle.wind || []).map(d => {
                    const dstr = `${d.year}-${String(d.month).padStart(2,'0')}-${String(d.day).padStart(2,'0')}`;
                    idCache.set(keyFor(wsId, dstr, TYPE.wind), parseInt(d.id, 10));
                    return {
                      id: String(d.id), start: dstr, end: dstr, allDay: true,
                      title: 'W', color: '#fd7e14', textColor: '#ffffff',
                      extendedProps: { isWeather: true, type: TYPE.wind }
                    };
                  });

                  const vac = (bundle.vacation || []).map(d => {
                    const dstr = `${d.year}-${String(d.month).padStart(2,'0')}-${String(d.day).padStart(2,'0')}`;
                    return {
                      id: `VAC_${dstr}`,
                      start: dstr, end: dstr, allDay: true,
                      title: 'V', color: '#009336', textColor: '#ffffff',
                      editable: false, extendedProps: { isVacation: true }
                    };
                  });

                  if (seq !== fetchSeq) return;
                  success([...rain, ...wind, ...vac]);
                } catch (e) {
                  if (seq !== fetchSeq) return;
                  failure(e);
                }
              }
            ]
          });

          // toggle (add/remove) per actief type, met queue + idCache + fallback-probe
          async function toggleByType(dateStr) {
            if (currentType === null) return;
            const wsId = currentStation();
            const key = keyFor(wsId, dateStr, currentType);

            const run = async () => {
              // V blokkeert mutaties
              const hasVacation = cal.getEvents().some(ev =>
                ev.extendedProps?.isVacation && ev.startStr === dateStr
              );
              if (hasVacation) return;

              // Event in UI?
              const uiEvent = cal.getEvents().find(ev =>
                ev.extendedProps?.isWeather &&
                ev.extendedProps.type === currentType &&
                ev.startStr === dateStr
              );

              // id uit UI of cache
              let knownId = uiEvent?.id ?? idCache.get(key);
              let knownIdNum = knownId != null ? parseInt(knownId, 10) : NaN;

              try {
                if (Number.isFinite(knownIdNum)) {
                  // DELETE
                  const ok = await postBool(EP.del, { id: knownIdNum, __RequestVerificationToken: token });
                  if (ok) {
                    if (currentStation() === wsId) uiEvent?.remove();
                    idCache.delete(key);
                  } else {
                    alert('Verwijderen mislukt.');
                  }
                } else {
                  // ADD
                  let newId = await postInt(EP.add, {
                    dag: dateStr, weatherstationid: wsId, type: currentType, __RequestVerificationToken: token
                  });

                  // Fallback: als geen geldig id, probeer via bundel te lezen
                  if (!Number.isFinite(newId) || newId === 0) {
                    newId = await probeId(wsId, dateStr, currentType);
                  }

                  if (Number.isFinite(newId) && newId !== 0) {
                    idCache.set(key, newId);
                    if (currentStation() === wsId) {
                      cal.addEvent({
                        id: String(newId),
                        start: dateStr, end: dateStr, allDay: true,
                        title: (currentType === TYPE.wind ? 'W' : 'R'),
                        color: (currentType === TYPE.wind ? '#fd7e14' : '#0d6efd'),
                        textColor: textColor,
                        extendedProps: { isWeather: true, type: currentType }
                      });
                    }
                  } else {
                    console.warn('AddBadWeatherDay gaf geen ID terug. Response was geen parsebare int.');
                    alert('Opslaan mislukt (ongeldig ID).');
                  }
                }
              } catch {
                alert('Opslaan/verwijderen mislukt.');
              }
            };

            const prev = pendingOps.get(key) || Promise.resolve();
            const next = prev.then(run).catch(() => {});
            pendingOps.set(key, next);
            await next;
          }

          cal.render();

          // Station wissel → alles leeg + cache leeg + refetch + anti-race
          $(document).on('change', '#lstWeatherStations', function () {
            fetchSeq++;
            idCache.clear();
            cal.batchRendering(() => {
              cal.removeAllEvents();
              cal.refetchEvents();
            });
          });

          // Toggle-knoppen
          $(document).on('click', '[data-daytype]', function () {
            const t = $(this).data('daytype') === 'wind' ? TYPE.wind : TYPE.rain;
            if (currentType === t) { currentType = null; $(this).removeClass('active'); }
            else { currentType = t; $('[data-daytype]').removeClass('active'); $(this).addClass('active'); }
          });
        });
    </script>





}


<div class="row justify-content-between align-items-end mb-3">
    <div class="col-auto">
        <h1 class="fw-bold mb-1">Weerverlet</h1>
        <h5 class="text-muted">Kies het type en klik in de kalender</h5>
    </div>
</div>
<div class="card card-modern mb-4">
    <div class="card-body">
            <div class="form-group row align-items-center">
                <label class="col-lg-2 col-xl-2 control-label text-lg-end mb-0">
                Selecteer het weerstation :
                </label>
                <div class="col-lg-8 col-xl-8">
                @Html.DropDownListFor(m => m.SelectedWeatherStation,
                         new SelectList(Model.WeatherStations, "ID", "Display", Model.SelectedWeatherStation),
                         new { @class = "form-control form-modern", id = "lstWeatherStations" })
                </div>
            @if (canWriteProjectWeather)
            {
            <div class="col-lg-2 col-xl-2 d-flex gap-2" role="group" aria-label="Weerverlet type">
                <button type="button" class="btn btn-outline-primary flex-fill" data-daytype="rain">
                    <i class='bx bx-cloud-rain'></i> Regendag
                </button>
                <button type="button" class="btn btn-outline-warning flex-fill" data-daytype="wind">
                    <i class='bx bx-wind'></i> Winddag
                </button>
            </div>
            }
            </div>   
    </div>
</div>

<div class="row">
    <section class="card card-modern card-modern-alt-padding">
        <div class="card-body bg-light">
            <div id="weatherCalendar"></div>
            @Html.AntiForgeryToken() <!-- voor AJAX posts -->
        </div>
    </section>
</div>