@using CPMCore.Controllers
@model CPMCore.Models.Budget.BudgetActivityLijnenModel
@{
    var ic = System.Globalization.CultureInfo.InvariantCulture;
    string Fmt(decimal v, int d = 2) => v.ToString("F" + d, ic);
    string FmtN(decimal v) => v.ToString("N0", ic);
}

@section PageStyle {
    <link rel="stylesheet" href="~/css/budget-wizard.css" />
<style>
    .calc-detail               { display: none; }
    .calc-detail.visible       { display: block; }
    .lot-accordion .accordion-button:not(.collapsed) { background-color: #e8f0fe; color: #0d6efd; }
    .kpi-card                  { border-top: 3px solid; }
    .kpi-card.alt              { border-color: #0d6efd; }
    .kpi-card.nacalc           { border-color: #198754; }
    .kpi-card.verschil         { border-color: #ffc107; }
    .kpi-card.m2               { border-color: #6c757d; }
    .activity-row input        { min-width: 80px; }
    .popover-ruwbouw           { max-width: 420px; }
</style>
}

<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", Model.ProjectId)
        <div class="inner-body bw-inner-body">

            @* ── Wizard tabbladen ── *@
            @await Html.PartialAsync("Partials/_BudgetWizardTabs", new BudgetWizardTabsModel { VersieId = Model.BudgetVersieId, ActiveStep = 6, ShowCalcToggle = false })

            @* ── Pagina-koptekst ── *@
            @await Html.PartialAsync("Partials/_BudgetPageHeader", new BudgetPageHeaderModel
            {
                StepNum         = 6,
                PageTitle       = "Activiteiten",
                PageDescription = "Nacalc- en alternatiefprijzen per activiteit (VMSW-structuur), geïndexeerd met de gewogen S/I bouwkostfactor.",
                MasterNaam      = Model.BudgetNaam,
                VersieLabel     = Model.VersieLabel,
                VersieStatus    = Model.VersieStatus,
                PrevUrl         = Url.Action("BudgetDakAfbraak", "Projecten", new { versieId = Model.BudgetVersieId }),
                NextUrl         = Url.Action("BudgetParams",     "Projecten", new { versieId = Model.BudgetVersieId })
            })

            @* ── 4 KPI cards ── *@
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="card kpi-card alt p-3 text-center">
                        <div class="fs-4 fw-bold text-primary" id="kpiAlt">€ @FmtN(Model.TotaalAlternatief)</div>
                        <div class="small text-muted">Alternatief totaal</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card kpi-card nacalc p-3 text-center">
                        <div class="fs-4 fw-bold text-success" id="kpiNacalc">€ @FmtN(Model.TotaalNacalc)</div>
                        <div class="small text-muted">Nacalc totaal</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card kpi-card verschil p-3 text-center">
                        <div class="fs-4 fw-bold text-warning" id="kpiVerschil">€ @FmtN(Model.Verschil)</div>
                        <div class="small text-muted">Verschil</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card kpi-card m2 p-3 text-center">
                        <div class="fs-4 fw-bold text-secondary" id="kpiM2">€ @Fmt(Model.PrijsPerM2GBA)</div>
                        <div class="small text-muted">
                            €/m² GBA
                            <br />
                            <span class="text-muted" style="font-size:.75rem;">
                                @Fmt(Model.OppervlakteGBA) m² · @Model.AantalEenheden eenheden
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            @* ── S/I bouwindex + nacalc import balk ── *@
            <div class="card card-modern mb-4">
                <div class="card-body">
                    <div class="row align-items-center g-3">
                        <div class="col-md-auto d-flex flex-wrap gap-2">
                            <span class="badge bg-light text-dark border">
                                S-start: <strong>@Model.SIndexStart.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)</strong>
                            </span>
                            <span class="badge bg-light text-dark border">
                                S-huidig: <strong>@Model.SIndexHuidig.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)</strong>
                            </span>
                            <span class="badge bg-light text-dark border">
                                I-start: <strong>@Model.IIndexStart.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)</strong>
                            </span>
                            <span class="badge bg-light text-dark border">
                                I-huidig: <strong>@Model.IIndexHuidig.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)</strong>
                            </span>
                            <span class="badge bg-primary">
                                Gewogen factor: <strong>@Model.GewogenFactor.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)</strong>
                            </span>
                            <span class="text-muted small align-self-center">(I/I₀)×0.40 + (S/S₀)×0.40 + 0.20</span>
                        </div>
                        <div class="col-md-auto ms-md-auto d-flex gap-2">
                            <select class="form-select form-select-sm" id="ddlBronProject" style="min-width:200px">
                                <option value="">Kies bronproject...</option>
                                @foreach (var item in Model.BeschikbareProjecten)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnImportNacalc">
                                <i class="bx bx-import me-1"></i> Nacalc importeren
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnToggleCalc">
                                <i class="bx bx-calculator me-1"></i> Formules
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @* ── Accordion per lot ── *@
            <form id="frmActivityLijnen">
                <input type="hidden" id="hdnVersieId" value="@Model.BudgetVersieId" />

                <div class="accordion lot-accordion mb-4" id="lotAccordion">
                    @{int lotIdx = 0;}
                    @foreach (var lot in Model.LotGroepen)
                    {
                        string collapseId = $"lotCollapse{lotIdx}";
                        string headerId   = $"lotHeader{lotIdx}";
                        bool   isFirst    = lotIdx == 0;
                        lotIdx++;
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="@headerId">
                            <button class="accordion-button @(isFirst ? "" : "collapsed")"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId"
                                    aria-expanded="@(isFirst ? "true" : "false")"
                                    aria-controls="@collapseId">
                                <span class="badge bg-primary me-2">Lot @lot.LotNummer.ToString("G", ic)</span>
                                <span class="me-3">@lot.LotNaam</span>
                                <span class="ms-auto me-3 small text-muted">
                                    Alt: <strong class="lot-totaal-alt text-primary">
                                        € @Fmt(lot.TotaalAlternatief)
                                    </strong>
                                </span>
                                <span class="small text-muted">
                                    Nacalc: <strong class="lot-totaal-nacalc text-success">
                                        € @Fmt(lot.TotaalNacalc)
                                    </strong>
                                </span>
                            </button>
                        </h2>
                        <div id="@collapseId"
                             class="accordion-collapse collapse @(isFirst ? "show" : "")"
                             aria-labelledby="@headerId"
                             data-bs-parent="#lotAccordion">
                            <div class="accordion-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Activiteit</th>
                                                <th style="min-width:90px;">Alt. €/eenh.</th>
                                                <th class="text-end">Alt. totaal</th>
                                                <th style="min-width:90px;">Nacalc €/eenh.</th>
                                                <th style="min-width:80px;">Corr.</th>
                                                <th class="text-end">Nacalc geïnd.</th>
                                                <th class="text-end">Verschil</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody class="lot-tbody">
                                            @foreach (var lijn in lot.Lijnen)
                                            {
                                                @await Html.PartialAsync("Partials/_ActivityLijnRow", lijn)
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    }
                </div>

                @* ── Actie-knoppen ── *@
                <div class="d-flex gap-2 align-items-center mb-4">
                    <button type="button" id="btnSaveActivity" class="btn btn-primary">
                        <i class="bx bx-save me-1"></i>Opslaan
                    </button>
                    @if (!string.IsNullOrEmpty(ViewData["Referrer"] as string))
                    {
                        <a href="@ViewData["Referrer"]" class="btn btn-outline-secondary">Annuleren</a>
                    }
                </div>
            </form>

        </div>
    </div>
</section>

@section PageScripts {
<script>
    // Initialiseer popovers
    document.querySelectorAll('[data-bs-toggle="popover"]').forEach(el => new bootstrap.Popover(el, { sanitize: false }));

    const versieId       = @Model.BudgetVersieId;
    const aantalEenheden = @Model.AantalEenheden;
    const oppGBA         = @Fmt(Model.OppervlakteGBA);
    const antiForgery    = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const gewogenFactor  = @Model.GewogenFactor.ToString("F6", System.Globalization.CultureInfo.InvariantCulture);

    // ── Herbereken één rij ─────────────────────────────────────────────────
    function herbereken($tr) {
        const altPrijs    = parseFloat($tr.find('.alt-prijs').val())    || 0;
        const nacalcPrijs = parseFloat($tr.find('.nacalc-prijs').val()) || 0;
        const corr        = parseFloat($tr.find('.corr-factor').val())  || 1;

        const altTotaal  = altPrijs * aantalEenheden;
        const nacalcGein = nacalcPrijs * corr * gewogenFactor;
        const nacalcTot  = nacalcGein * aantalEenheden;
        const verschil   = altTotaal - nacalcTot;

        $tr.find('.alt-totaal').text('€ ' + altTotaal.toLocaleString('nl-BE', { minimumFractionDigits: 2 }));
        $tr.find('.nacalc-geind').text('€ ' + nacalcGein.toLocaleString('nl-BE', { minimumFractionDigits: 2 }));

        const $badge = $tr.find('.verschil-cel .badge');
        $badge.text('€ ' + verschil.toLocaleString('nl-BE', { minimumFractionDigits: 2 }));
        $badge.removeClass('bg-warning text-dark bg-primary bg-success');
        if (verschil > 0.01)       $badge.addClass('bg-warning text-dark');
        else if (verschil < -0.01) $badge.addClass('bg-primary');
        else                       $badge.addClass('bg-success');
    }

    // ── Herbereken lot-totalen ─────────────────────────────────────────────
    function herberekenLotTotalen($tbody) {
        let sumAlt    = 0;
        let sumNacalc = 0;
        $tbody.find('.activity-row').each(function () {
            const $tr = $(this);
            const altPrijs    = parseFloat($tr.find('.alt-prijs').val())    || 0;
            const nacalcPrijs = parseFloat($tr.find('.nacalc-prijs').val()) || 0;
            const corr        = parseFloat($tr.find('.corr-factor').val())  || 1;
            sumAlt    += altPrijs * aantalEenheden;
            sumNacalc += nacalcPrijs * corr * gewogenFactor * aantalEenheden;
        });
        const $accItem = $tbody.closest('.accordion-item');
        $accItem.find('.lot-totaal-alt').text('€ ' + sumAlt.toFixed(2));
        $accItem.find('.lot-totaal-nacalc').text('€ ' + sumNacalc.toFixed(2));
    }

    // ── Update KPI-cards ───────────────────────────────────────────────────
    function updateKPIs() {
        let totAlt    = 0;
        let totNacalc = 0;
        $('.activity-row').each(function () {
            const $tr = $(this);
            const altPrijs    = parseFloat($tr.find('.alt-prijs').val())    || 0;
            const nacalcPrijs = parseFloat($tr.find('.nacalc-prijs').val()) || 0;
            const corr        = parseFloat($tr.find('.corr-factor').val())  || 1;
            totAlt    += altPrijs * aantalEenheden;
            totNacalc += nacalcPrijs * corr * gewogenFactor * aantalEenheden;
        });
        const verschil = totAlt - totNacalc;
        const m2Prijs  = oppGBA > 0 ? totAlt / oppGBA : 0;

        $('#kpiAlt').text('€ ' + Math.round(totAlt).toLocaleString('nl-BE'));
        $('#kpiNacalc').text('€ ' + Math.round(totNacalc).toLocaleString('nl-BE'));
        $('#kpiVerschil').text('€ ' + Math.round(verschil).toLocaleString('nl-BE'));
        $('#kpiM2').text('€ ' + m2Prijs.toFixed(2));
    }

    // ── Input event: één handler voor alles ───────────────────────────────
    $(document).on('input', '.activity-row input', function () {
        const $tr    = $(this).closest('tr');
        const $tbody = $(this).closest('tbody');
        herbereken($tr);
        herberekenLotTotalen($tbody);
        updateKPIs();
    });

    // ── Formules toggle ────────────────────────────────────────────────────
    $('#btnToggleCalc').on('click', function () {
        $('.calc-detail').toggleClass('visible');
        $(this).toggleClass('btn-outline-primary btn-primary');
    });

    // ── Opslaan ────────────────────────────────────────────────────────────
    $('#btnSaveActivity').on('click', function () {
        const lijnen = [];
        $('.activity-row').each(function () {
            const $tr = $(this);
            lijnen.push({
                activityId:                  parseInt($tr.data('activity-id')),
                alternatievePrijsPerEenheid:  parseFloat($tr.find('.alt-prijs').val())    || 0,
                nacalcPrijsPerEenheid:        parseFloat($tr.find('.nacalc-prijs').val()) || 0,
                correctiefactor:              parseFloat($tr.find('.corr-factor').val())  || 1,
                isManueel:                    false
            });
        });

        $.ajax({
            url:         '@Url.Action("SaveActivityLijnen", "Projecten")',
            method:      'POST',
            contentType: 'application/json',
            data:        JSON.stringify({ budgetVersieId: versieId, lijnen: lijnen }),
            success: function (result) {
                if (result.success) {
                    if (typeof toastr !== 'undefined') toastr.success('Activiteiten opgeslagen.');
                    else alert('Opgeslagen.');
                } else {
                    if (typeof toastr !== 'undefined') toastr.error(result.message || 'Fout bij opslaan.');
                    else alert('Fout: ' + (result.message || 'onbekend'));
                }
            },
            error: function () {
                if (typeof toastr !== 'undefined') toastr.error('Verbindingsfout.');
                else alert('Verbindingsfout.');
            }
        });
    });

    // ── Nacalc importeren ──────────────────────────────────────────────────
    $('#btnImportNacalc').on('click', function () {
        const bronId = $('#ddlBronProject').val();
        if (!bronId) { alert('Kies eerst een bronproject.'); return; }
        $.post('@Url.Action("ImportNacalcVanProject", "Projecten")',
            { bronProjectId: bronId, doelVersieId: versieId },
            function (result) {
                if (result.success) { location.reload(); }
                else {
                    if (typeof toastr !== 'undefined') toastr.info(result.message);
                    else alert(result.message);
                }
            });
    });
</script>
}
