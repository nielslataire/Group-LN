@using CPMCore.Helpers
@using CPMCore.Models.Projecten
@model CPMCore.Models.Projecten.ProjectModel

@section PageStyle
{
    @await Html.PartialAsync("_ProjectFormStyles")
}

@using (Html.BeginForm("Toevoegen", "Projecten", FormMethod.Post, new { @class = "ecommerce-form action-buttons-fixed gl-project-form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="alert alert-danger @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

    <div class="card card-modern">
        <div class="card-body">
            <section class="gl-form-section">
                <div class="gl-form-section__body">
                    <div class="gl-form-section__head">
                        <i class="bx bx-building-house" aria-hidden="true"></i>
                        <div>
                            <h2 class="gl-form-section__title">Nieuw project</h2>
                            <p class="gl-form-section__hint">Genoeg om het project aan te maken — de rest vul je erna aan bij Bewerken.</p>
                        </div>
                    </div>

                    @Html.HiddenFor(m => m.SelectedPostalcode, new { id = "SelectedPostalcode" })

                    <div class="gl-field-grid">
                        <div class="gl-field">
                            <label for="Project_Name">@Html.DisplayNameFor(m => m.Project.Name) <span class="gl-req" aria-hidden="true">*</span></label>
                            @Html.TextBoxFor(m => m.Project.Name, new { @class = "form-control form-control-modern", placeholder = "Naam van het project", autocomplete = "off", required = "required" })
                            <span asp-validation-for="Project.Name" class="text-danger"></span>
                        </div>

                        <div class="gl-field">
                            <label for="Project_ProjectCode">@Html.DisplayNameFor(m => m.Project.ProjectCode)</label>
                            @Html.TextBoxFor(m => m.Project.ProjectCode, new { @class = "form-control form-control-modern", placeholder = "bv. P-2024-118", maxlength = "50", autocomplete = "off", id = "Project_ProjectCode" })
                            <span asp-validation-for="Project.ProjectCode" class="text-danger"></span>
                        </div>

                        <div class="gl-field">
                            <label for="lstProjectCountries">Land</label>
                            @Html.DropDownListFor(m => m.SelectedCountry, new SelectList(Model.Countries, "ID", "Display", Model.SelectedCountry), new { @class = "form-control form-control-modern", id = "lstProjectCountries" })
                        </div>

                        <div class="gl-field">
                            <label for="PostalSelect">Gemeente <span class="gl-req" aria-hidden="true">*</span></label>
                            <select id="PostalSelect" class="form-control w-100" aria-label="Gemeente">
                                @if (Model.SelectedPostalcode > 0)
                                {
                                    <option value="@Model.SelectedPostalcode" selected>
                                        @($"{Model.Project.Postalcode.Postcode} - {Model.Project.Postalcode.Gemeente}")
                                    </option>
                                }
                            </select>
                            <span id="postalSelectError" class="text-danger" hidden>Kies een gemeente uit de lijst.</span>
                        </div>

                        <div class="gl-field">
                            <label for="Project_AspNetUserID">@Html.DisplayNameFor(m => m.Project.AspNetUserID)</label>
                            @Html.DropDownListFor(m => m.Project.AspNetUserID, new SelectList(Model.Users, "Id", "DisplayName", Model.Project.AspNetUserID), "Selecteer een verantwoordelijke", new { @class = "form-control form-control-modern", id = "Project_AspNetUserID" })
                        </div>

                        <div class="gl-field">
                            <label for="Project_SalesResponsibleUserID">@Html.DisplayNameFor(m => m.Project.SalesResponsibleUserID)</label>
                            @Html.DropDownListFor(m => m.Project.SalesResponsibleUserID, new SelectList(Model.Users, "Id", "DisplayName", Model.Project.SalesResponsibleUserID), "Selecteer een verkoopverantwoordelijke", new { @class = "form-control form-control-modern", id = "Project_SalesResponsibleUserID" })
                        </div>

                        <div class="gl-field gl-field--full">
                            <label for="StandardFotoUpload">Standaard foto <small class="text-muted">— optioneel</small></label>
                            <input type="file" name="StandardFotoUpload" id="StandardFotoUpload"
                                   accept="image/jpeg,image/png,image/webp" class="form-control form-control-modern" />
                            <img id="projectStdFotoPreview" class="gl-form-foto-preview d-none mt-2" alt="Voorbeeld van de standaard projectfoto" />
                            <span id="projectStdFotoEmpty" class="d-none"></span>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="row action-buttons">
        <div class="col-12 col-md-auto">
            <button type="submit" class="submit-button btn btn-primary btn-px-4 py-3 d-flex align-items-center font-weight-semibold line-height-1" data-loading-text="Laden...">
                <i class="bx bx-save text-4 me-2" aria-hidden="true"></i> Project aanmaken
            </button>
        </div>
        <div class="col-12 col-md-auto px-md-0 mt-3 mt-md-0">
            <a href="@((TempData.Peek("Referrer") as string) ?? Url.Action("Index", "Projecten"))" class="cancel-button btn btn-light btn-px-4 py-3 border font-weight-semibold text-color-dark text-3">Annuleren</a>
        </div>
    </div>
}

@section PageScripts
{
    @await Html.PartialAsync("_ProjectFormScripts", Model)
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/lib/jquery-validation/localization/messages_nl.js"></script>
}
