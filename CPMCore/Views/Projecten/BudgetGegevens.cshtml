@using CPMCore.Controllers
@using BOCore
@using ServiceCore.Budget
@model CPMCore.Models.Projecten.BudgetGegevensModel
@inject ServiceCore.Budget.BudgetActivityFormuleService FormuleSvc
@{
    var poortWaarschuwing = await FormuleSvc.IsPoortWaarschuwingAsync(Model.VersieId);
    var currentYear = DateTime.Now.Year;
    Model.FormulaVoorstellingen.TryGetValue(FormulaSleutels.NacalcRuwbouwBasis,      out var fRuwbouw);
    Model.FormulaVoorstellingen.TryGetValue(FormulaSleutels.BovenbouwGevelmetselwerk, out var fGevel);
    Model.FormulaVoorstellingen.TryGetValue(FormulaSleutels.BovenbouwGipsblokken,     out var fGips);
    Model.FormulaVoorstellingen.TryGetValue(FormulaSleutels.BovenbouwTerras,          out var fTerras);
    var ruwbouwBasePrijs = fRuwbouw?.MateriaalPrijs;
    var ruwbouwIRef      = fRuwbouw?.MateriaalIRef ?? 100m;
    var ruwbouwSRef      = fRuwbouw?.MateriaalSRef ?? 100m;
    var gevelBasePrijs   = fGevel?.MateriaalPrijs;
    var gevelIRef        = fGevel?.MateriaalIRef ?? 100m;
    var gevelSRef        = fGevel?.MateriaalSRef ?? 100m;
    var gipsBasePrijs    = fGips?.MateriaalPrijs;
    var gipsIRef         = fGips?.MateriaalIRef ?? 100m;
    var gipsSRef         = fGips?.MateriaalSRef ?? 100m;
    var terrasBasePrijs  = fTerras?.MateriaalPrijs;
    var terrasIRef       = fTerras?.MateriaalIRef ?? 100m;
    var terrasSRef       = fTerras?.MateriaalSRef ?? 100m;
}
@section PageStyle {
    <link rel="stylesheet" href="~/css/budget-wizard.css" />
}

<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", Model.ProjectId)
        <div class="inner-body bw-inner-body">

            @* ── Wizard tabbladen ── *@
            @await Html.PartialAsync("Partials/_BudgetWizardTabs", new BudgetWizardTabsModel { VersieId = Model.VersieId, ActiveStep = 1, ShowCalcToggle = false })

            @* ── Pagina-koptekst ── *@
            @await Html.PartialAsync("Partials/_BudgetPageHeader", new BudgetPageHeaderModel
            {
                StepNum         = 1,
                PageTitle       = "Projectgegevens",
                PageDescription = "Aantallen, dimensies en S/I bouwkostindexering. Deze waarden voeden alle volgende stappen.",
                MasterNaam      = Model.MasterNaam,
                VersieLabel     = Model.VersieLabel,
                VersieStatus    = Model.VersieStatus,
                ShowSaveButton  = true,
                SaveFormId      = "bw-form"
            })

            <div class="bw-body-grid">

                @* ── Linker kolom: formulier ── *@
                <div class="bw-col-main">

                    <form id="bw-form" asp-action="BudgetGegevens" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="VersieId" />
                        <input type="hidden" asp-for="MasterId" />
                        <input type="hidden" asp-for="ProjectId" />
                        <input type="hidden" asp-for="ProjectName" />
                        <input type="hidden" asp-for="MasterNaam" />
                        <input type="hidden" asp-for="VersieLabel" />
                        <input type="hidden" asp-for="VersieStatus" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                        <div class="bw-invoer-card">
                            <div class="bw-invoer-card__header">
                                <span><i class="fas fa-pencil-alt me-2"></i>Invoer</span>
                                <span class="bw-autosave" id="autosave-label"></span>
                            </div>
                            <div class="bw-invoer-card__body">

                                @* ── AANTALLEN ── *@
                                <div class="bw-section-label">Aantallen</div>

                                <div class="bw-section-note">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Aantal &amp; samenstelling van de eenheden worden bepaald in
                                    <a asp-action="BudgetOppervlaktes" asp-route-versieId="@Model.VersieId">stap 2 — Oppervlaktes</a>.
                                </div>

                                <div class="row g-3 mb-4">
                                    <div class="col-sm-12 col-md-6">
                                        <label asp-for="Gegevens.AantalLiften" class="form-label">Aantal liften</label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="Gegevens.AantalLiften" type="number" min="0"
                                                   class="form-control form-control-sm text-end" />
                                            <span class="input-group-text fs-7">st</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 col-md-6">
                                        <label asp-for="Gegevens.AantalBinnentrappen" class="form-label">Aantal binnentrappen</label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="Gegevens.AantalBinnentrappen" type="number" min="0"
                                                   class="form-control form-control-sm text-end" />
                                            <span class="input-group-text">st</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 col-md-6">
                                        <label asp-for="Gegevens.AantalTrapzalen" class="form-label">Aantal trapzalen</label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="Gegevens.AantalTrapzalen" type="number" min="0"
                                                   class="form-control form-control-sm text-end" />
                                            <span class="input-group-text">st</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 col-md-6">
                                        <label asp-for="Gegevens.AantalBovengrondseVerdiepingen" class="form-label">Bovengrondse verdiepingen</label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="Gegevens.AantalBovengrondseVerdiepingen" type="number" min="0"
                                                   class="form-control form-control-sm text-end" />
                                            <span class="input-group-text">st</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 col-md-6">
                                        <label asp-for="Gegevens.AantalVerdiepingenOndergronds" class="form-label">Ondergrondse verdiepingen</label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="Gegevens.AantalVerdiepingenOndergronds" type="number" min="0"
                                                   class="form-control form-control-sm text-end" />
                                            <span class="input-group-text">st</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 col-md-6">
                                        <label asp-for="Gegevens.TypePoorten" class="form-label">
                                            Type poorten
                                            @if (poortWaarschuwing)
                                            {
                                                <i class="fas fa-exclamation-triangle text-danger ms-1"
                                                   data-bs-toggle="tooltip" data-bs-placement="top"
                                                   title="De poorten moeten geselecteerd worden."></i>
                                            }
                                        </label>
                                        <select asp-for="Gegevens.TypePoorten" asp-items="Model.TypePoortenOptions"
                                                class="form-select form-select-sm">
                                            <option value="">— kies type —</option>
                                        </select>
                                    </div>
                                </div>

                                @* ── DIMENSIES ── *@
                                <div class="bw-section-label">Dimensies</div>
                                <div class="row g-3 mb-4">
                                    <div class="col-sm-12 col-md-6">
                                        <label asp-for="Gegevens.OppFunderingen" class="form-label">Oppervlakte funderingen</label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="Gegevens.OppFunderingen" type="number" min="0" step="0.01"
                                                   class="form-control form-control-sm text-end" />
                                            <span class="input-group-text">m²</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 col-md-6">
                                        <label asp-for="Gegevens.M3Grondwerk" class="form-label">Grondwerk</label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="Gegevens.M3Grondwerk" type="number" min="0" step="0.01"
                                                   class="form-control form-control-sm text-end" />
                                            <span class="input-group-text">m²</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 col-md-6">
                                        <label asp-for="Gegevens.LmBerlinerwanden" class="form-label">Berlinerwanden</label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="Gegevens.LmBerlinerwanden" type="number" min="0" step="0.01"
                                                   class="form-control form-control-sm text-end" />
                                            <span class="input-group-text">lm</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 col-md-6">
                                        <label asp-for="Gegevens.LmSecanpalen" class="form-label">Secanpalen</label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="Gegevens.LmSecanpalen" type="number" min="0" step="0.01"
                                                   class="form-control form-control-sm text-end" />
                                            <span class="input-group-text">lm</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-12 col-md-6">
                                        <label asp-for="Gegevens.M3Onderschoeiingen" class="form-label">Onderschoeiingen</label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="Gegevens.M3Onderschoeiingen" type="number" min="0" step="0.01"
                                                   class="form-control form-control-sm text-end" />
                                            <span class="input-group-text">m³</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <label asp-for="Gegevens.TypeDak" class="form-label">Type dak</label>
                                        <select asp-for="Gegevens.TypeDak" asp-items="Model.TypeDakOptions"
                                                class="form-select form-select-sm">
                                            <option value="">— kies type —</option>
                                        </select>
                                    </div>
                                </div>

                                @* ── BOUWKOSTINDEXERING ── *@
                                <div class="bw-section-label">
                                    <i class="fas fa-chart-line me-1"></i>Bouwkostindexering (S/I)
                                </div>
                                <div class="row g-3">
                                    @* Ruwbouw basisprijs *@
                                    <div class="col-sm-12 col-md-6">
                                        <label asp-for="Gegevens.NacalcBasisprijs" class="form-label">
                                            Nacalc basisprijs ruwbouw
                                            @if (fRuwbouw?.MNaam != null) {
                                                <span class="badge bg-light text-secondary border ms-1" style="font-size:.7rem;font-weight:400;"
                                                      title="Materiaal: @fRuwbouw.MNaam">
                                                    <i class="bx bx-link-alt me-1"></i>@fRuwbouw.MNaam
                                                </span>
                                            }
                                        </label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">€</span>
                                            <input asp-for="Gegevens.NacalcBasisprijs" type="number" min="0" step="0.01"
                                                   class="form-control form-control-sm text-end" id="inp-basisprijs" />
                                            <span class="input-group-text">/m²</span>
                                            @if (ruwbouwBasePrijs != null) {
                                                <button type="button" class="btn btn-sm btn-default"
                                                        onclick="document.getElementById('inp-basisprijs').value='@ruwbouwBasePrijs.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)'; updateIndexFactors();"
                                                        title="Basisprijs overnemen uit Kostprijsmaterialen">
                                                    <i class="bx bx-repeat"></i>
                                                </button>
                                            }
                                        </div>
                                        @if (ruwbouwBasePrijs != null) {
                                            <div class="form-text text-primary">
                                                <i class="bx bx-link-external me-1"></i>Basisprijs materiaal: <strong>€ @ruwbouwBasePrijs.Value.ToString("N2", new System.Globalization.CultureInfo("nl-BE"))</strong>/m²
                                                @if (fRuwbouw.MNaam != null) { <span class="text-muted">— @fRuwbouw.MNaam</span> }
                                            </div>
                                        } else if (fRuwbouw != null) {
                                            <div class="form-text text-muted">
                                                <i class="bx bx-link-external me-1"></i>Geen materiaal gekoppeld — stel in via <a asp-controller="Instellingen" asp-action="KostprijsMaterialen" target="_blank">Instellingen</a>.
                                            </div>
                                        }
                                    </div>
                                    @* Gevelmetselwerk *@
                                    <div class="col-sm-12 col-md-6">
                                        <label asp-for="Gegevens.GevelMetselwerkPrijsPerM2" class="form-label">
                                            Gevelmetselwerk
                                            @if (fGevel?.MNaam != null) {
                                                <span class="badge bg-light text-secondary border ms-1" style="font-size:.7rem;font-weight:400;"
                                                      title="Materiaal: @fGevel.MNaam">
                                                    <i class="bx bx-link-alt me-1"></i>@fGevel.MNaam
                                                </span>
                                            }
                                        </label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">€</span>
                                            <input asp-for="Gegevens.GevelMetselwerkPrijsPerM2" type="number" min="0" step="0.01"
                                                   class="form-control form-control-sm text-end" id="inp-gevel" />
                                            <span class="input-group-text">/m²</span>
                                            @if (gevelBasePrijs != null) {
                                                <button type="button" class="btn btn-sm btn-default"
                                                        onclick="document.getElementById('inp-gevel').value='@gevelBasePrijs.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)'; updateIndexFactors();"
                                                        title="Basisprijs overnemen uit Kostprijsmaterialen">
                                                    <i class="bx bx-repeat"></i>
                                                </button>
                                            }
                                        </div>
                                        @if (gevelBasePrijs != null) {
                                            <div class="form-text text-primary">
                                                <i class="bx bx-link-external me-1"></i>Basisprijs materiaal: <strong>€ @gevelBasePrijs.Value.ToString("N2", new System.Globalization.CultureInfo("nl-BE"))</strong>/m²
                                                @if (fGevel.MNaam != null) { <span class="text-muted">— @fGevel.MNaam</span> }
                                            </div>
                                        } else if (fGevel != null) {
                                            <div class="form-text text-muted">
                                                <i class="bx bx-link-external me-1"></i>Geen materiaal gekoppeld — stel in via <a asp-controller="Instellingen" asp-action="KostprijsMaterialen" target="_blank">Instellingen</a>.
                                            </div>
                                        }
                                    </div>
                                    @* Gipsblokken *@
                                    <div class="col-sm-12 col-md-6">
                                        <label asp-for="Gegevens.GipswerkenPrijsPerM2" class="form-label">
                                            Gipsblokken
                                            @if (fGips?.MNaam != null) {
                                                <span class="badge bg-light text-secondary border ms-1" style="font-size:.7rem;font-weight:400;"
                                                      title="Materiaal: @fGips.MNaam">
                                                    <i class="bx bx-link-alt me-1"></i>@fGips.MNaam
                                                </span>
                                            }
                                        </label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">€</span>
                                            <input asp-for="Gegevens.GipswerkenPrijsPerM2" type="number" min="0" step="0.01"
                                                   class="form-control form-control-sm text-end" id="inp-gips" />
                                            <span class="input-group-text">/unit</span>
                                            @if (gipsBasePrijs != null) {
                                                <button type="button" class="btn btn-sm btn-default"
                                                        onclick="document.getElementById('inp-gips').value='@gipsBasePrijs.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)'; updateIndexFactors();"
                                                        title="Basisprijs overnemen uit Kostprijsmaterialen">
                                                    <i class="bx bx-repeat"></i>
                                                </button>
                                            }
                                        </div>
                                        @if (gipsBasePrijs != null) {
                                            <div class="form-text text-primary">
                                                <i class="bx bx-link-external me-1"></i>Basisprijs materiaal: <strong>€ @gipsBasePrijs.Value.ToString("N2", new System.Globalization.CultureInfo("nl-BE"))</strong>/m²
                                                @if (fGips.MNaam != null) { <span class="text-muted">— @fGips.MNaam</span> }
                                            </div>
                                        } else if (fGips != null) {
                                            <div class="form-text text-muted">
                                                <i class="bx bx-link-external me-1"></i>Geen materiaal gekoppeld — stel in via <a asp-controller="Instellingen" asp-action="KostprijsMaterialen" target="_blank">Instellingen</a>.
                                            </div>
                                        }
                                    </div>
                                    @* Terras *@
                                    <div class="col-sm-12 col-md-6">
                                        <label asp-for="Gegevens.TerrasPrijsPerM2" class="form-label">
                                            Terras
                                            @if (fTerras?.MNaam != null) {
                                                <span class="badge bg-light text-secondary border ms-1" style="font-size:.7rem;font-weight:400;"
                                                      title="Materiaal: @fTerras.MNaam">
                                                    <i class="bx bx-link-alt me-1"></i>@fTerras.MNaam
                                                </span>
                                            }
                                        </label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">€</span>
                                            <input asp-for="Gegevens.TerrasPrijsPerM2" type="number" min="0" step="0.01"
                                                   class="form-control form-control-sm text-end" id="inp-terras" />
                                            <span class="input-group-text">/m²</span>
                                            @if (terrasBasePrijs != null) {
                                                <button type="button" class="btn btn-sm btn-default"
                                                        onclick="document.getElementById('inp-terras').value='@terrasBasePrijs.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)'; updateIndexFactors();"
                                                        title="Basisprijs overnemen uit Kostprijsmaterialen">
                                                    <i class="bx bx-repeat"></i>
                                                </button>
                                            }
                                        </div>
                                        @if (terrasBasePrijs != null) {
                                            <div class="form-text text-primary">
                                                <i class="bx bx-link-external me-1"></i>Basisprijs materiaal: <strong>€ @terrasBasePrijs.Value.ToString("N2", new System.Globalization.CultureInfo("nl-BE"))</strong>/m²
                                                @if (fTerras.MNaam != null) { <span class="text-muted">— @fTerras.MNaam</span> }
                                            </div>
                                        } else if (fTerras != null) {
                                            <div class="form-text text-muted">
                                                <i class="bx bx-link-external me-1"></i>Geen materiaal gekoppeld — stel in via <a asp-controller="Instellingen" asp-action="KostprijsMaterialen" target="_blank">Instellingen</a>.
                                            </div>
                                        }
                                    </div>
                                </div>

                                @* ── S/I INDEXEN ── *@
                                <div class="bw-section-label mt-4">
                                    <i class="fas fa-chart-bar me-1"></i>S-index (lonen) &amp; I-index (materialen)
                                </div>

                                @* S-index huidig *@
                                <div class="form-group row align-items-center pb-3">
                                    <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">
                                        S-index (lonen)
                                    </label>
                                    <div class="col-lg-3 col-xl-2">
                                        @Html.TextBoxFor(m => m.Gegevens.SIndexHuidig,
                                            new { @class = "form-control form-control-sm", type = "number",
                                                  step = "0.0001", placeholder = "bv. 119.1000" })
                                    </div>
                                    <div class="col-auto">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPickSIndex">
                                            <i class="fas fa-history me-1"></i> Uit historiek
                                        </button>
                                    </div>
                                </div>
                                @* I-index huidig *@
                                <div class="form-group row align-items-center pb-3">
                                    <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">
                                        I2021-index (materialen)
                                    </label>
                                    <div class="col-lg-3 col-xl-2">
                                        @Html.TextBoxFor(m => m.Gegevens.IIndexHuidig,
                                            new { @class = "form-control form-control-sm", type = "number",
                                                  step = "0.0001", placeholder = "bv. 123.5000" })
                                    </div>
                                    <div class="col-auto">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPickIIndex">
                                            <i class="fas fa-history me-1"></i> Uit historiek
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal fade" id="modalIndexPick" tabindex="-1">
                            <div class="modal-dialog modal-sm">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Kies indexwaarde</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body" id="modalIndexLijst"></div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-primary" id="btnBevestigIndex">Overnemen</button>
                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuleren</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>

                @* ── Rechter kolom: live berekening ── *@
                <div class="bw-col-aside">
                    <div class="bw-live-panel sticky-top" style="top:1rem;">
                        <div class="bw-live-panel__header">
                            <i class="fas fa-circle-notch me-2" style="font-size:.75rem;"></i>
                            <span>Live berekening</span>
                            <span class="bw-live-dot ms-auto" id="live-badge">● LIVE</span>
                        </div>
                        <div class="bw-live-panel__body">
                            <div class="bw-live-row">
                                <span>Ruwbouwprijs/m² (geïnd.)</span>
                                <strong id="sidebar-ruwbouw">—</strong>
                            </div>
                            <div class="bw-live-row">
                                <span>Gevelmetselwerk/m² (geïnd.)</span>
                                <strong id="sidebar-gevel">—</strong>
                            </div>
                            <div class="bw-live-row">
                                <span>Gipsblokken/m² (geïnd.)</span>
                                <strong id="sidebar-gips">—</strong>
                            </div>
                            <div class="bw-live-row">
                                <span>Terras/m² (geïnd.)</span>
                                <strong id="sidebar-terras">—</strong>
                            </div>

                            <div class="bw-live-note mt-3">
                                <i class="fas fa-info-circle me-1"></i>
                                (I/I₀)×0.40 + (S/S₀)×0.40 + 0.20
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            @* ── Bottom navigatiebalk ── *@
            <div class="bw-bottom-nav">
                <a href="@Url.Action("BudgetIndex", "Projecten", new { projectId = Model.ProjectId })"
                   class="bw-bottom-nav__back">
                    <i class="fas fa-chevron-left me-1"></i>Terug naar overzicht
                </a>
                <span class="bw-bottom-nav__indicator">
                    <i class="fas fa-check-circle me-1 text-success"></i>Stap 1 van 10 — Projectgegevens
                </span>
                <a href="@Url.Action("BudgetOppervlaktes", "Projecten", new { versieId = Model.VersieId })"
                   class="bw-bottom-nav__next">
                    Volgende: Oppervlaktes <i class="fas fa-chevron-right ms-1"></i>
                </a>
            </div>

        </div>
    </div>
</section>

@section PageScripts {
<script src="~/js/budget-wizard.js"></script>
<script>
    const fmt = (val, decimals = 2) => BudgetWizard.fmtNL(val, decimals);
    const eur = (val) => val != null && !isNaN(val) ? '€ ' + fmt(val) : '—';

    const ruwbouwBasePrijs = @((ruwbouwBasePrijs.HasValue ? ruwbouwBasePrijs.Value.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) : "null"));
    const ruwbouwIRef = @((ruwbouwIRef > 0 ? ruwbouwIRef.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) : "100"));
    const ruwbouwSRef = @((ruwbouwSRef > 0 ? ruwbouwSRef.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) : "100"));
    const gevelBasePrijs = @((gevelBasePrijs.HasValue ? gevelBasePrijs.Value.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) : "null"));
    const gevelIRef = @((gevelIRef > 0 ? gevelIRef.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) : "100"));
    const gevelSRef = @((gevelSRef > 0 ? gevelSRef.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) : "100"));
    const gipsBasePrijs = @((gipsBasePrijs.HasValue ? gipsBasePrijs.Value.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) : "null"));
    const gipsIRef = @((gipsIRef > 0 ? gipsIRef.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) : "100"));
    const gipsSRef = @((gipsSRef > 0 ? gipsSRef.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) : "100"));
    const terrasBasePrijs = @((terrasBasePrijs.HasValue ? terrasBasePrijs.Value.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) : "null"));
    const terrasIRef = @((terrasIRef > 0 ? terrasIRef.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) : "100"));
    const terrasSRef = @((terrasSRef > 0 ? terrasSRef.ToString("F4", System.Globalization.CultureInfo.InvariantCulture) : "100"));

    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));

    function matFactor(iHuidig, sHuidig, iRef, sRef) {
        return (iHuidig / iRef) * 0.40 + (sHuidig / sRef) * 0.40 + 0.20;
    }

    function updateIndexFactors() {
        const sHuidig = parseFloat($('[name$="SIndexHuidig"]').val()) || 0;
        const iHuidig = parseFloat($('[name$="IIndexHuidig"]').val()) || 0;

        const prijs  = parseFloat(document.getElementById('inp-basisprijs')?.value) || 0;
        const gevel  = parseFloat(document.getElementById('inp-gevel')?.value) || 0;
        const gips   = parseFloat(document.getElementById('inp-gips')?.value)  || 0;
        const terras = parseFloat(document.getElementById('inp-terras')?.value) || 0;

        const ok = iHuidig > 0 && sHuidig > 0;
        const fallback = 1.0;

        const rFactor = ok ? matFactor(iHuidig, sHuidig, ruwbouwIRef, ruwbouwSRef) : fallback;
        const gFactor = ok ? matFactor(iHuidig, sHuidig, gevelIRef,   gevelSRef)   : fallback;
        const pFactor = ok ? matFactor(iHuidig, sHuidig, gipsIRef,    gipsSRef)    : fallback;
        const tFactor = ok ? matFactor(iHuidig, sHuidig, terrasIRef,  terrasSRef)  : fallback;

        document.getElementById('sidebar-ruwbouw').textContent = prijs  > 0 ? eur(prijs  * rFactor) : '—';
        document.getElementById('sidebar-gevel').textContent   = gevel  > 0 ? eur(gevel  * gFactor) : '—';
        document.getElementById('sidebar-gips').textContent    = gips   > 0 ? eur(gips   * pFactor) : '—';
        document.getElementById('sidebar-terras').textContent  = terras > 0 ? eur(terras * tFactor) : '—';
    }

    $('[name$="SIndexHuidig"],[name$="IIndexHuidig"],' +
      '#inp-basisprijs,#inp-gevel,#inp-gips,#inp-terras')
        .on('input', updateIndexFactors);

    // ── Auto-opslaan bij navigeren ────────────────────────────────────────────
    async function autoSaveEnNavigeer(targetUrl) {
        const form   = document.getElementById('bw-form');
        const label  = document.getElementById('autosave-label');
        label.textContent = 'Opslaan…';
        try {
            const resp = await fetch('@Url.Action("BudgetGegevensOpslaan", "Projecten")', {
                method: 'POST',
                body:   new FormData(form)
            });
            const json = await resp.json();
            if (json.success) {
                window.location.href = targetUrl;
            } else {
                label.textContent = '⚠ Fout bij opslaan';
            }
        } catch {
            label.textContent = '⚠ Fout bij opslaan';
        }
    }

    document.querySelectorAll('a.bw-step, a.bw-bottom-nav__next, a.bw-bottom-nav__back').forEach(link => {
        link.addEventListener('click', function (e) {
            e.preventDefault();
            autoSaveEnNavigeer(this.href);
        });
    });

    $(document).ready(function () {
        if (ruwbouwBasePrijs !== null) {
            var _inp = document.getElementById('inp-basisprijs');
            if (_inp && (parseFloat(_inp.value) || 0) === 0) _inp.value = ruwbouwBasePrijs.toFixed(2);
        }
        if (gevelBasePrijs !== null) {
            var _inp = document.getElementById('inp-gevel');
            if (_inp && (parseFloat(_inp.value) || 0) === 0) _inp.value = gevelBasePrijs.toFixed(2);
        }
        if (gipsBasePrijs !== null) {
            var _inp = document.getElementById('inp-gips');
            if (_inp && (parseFloat(_inp.value) || 0) === 0) _inp.value = gipsBasePrijs.toFixed(2);
        }
        if (terrasBasePrijs !== null) {
            var _inp = document.getElementById('inp-terras');
            if (_inp && (parseFloat(_inp.value) || 0) === 0) _inp.value = terrasBasePrijs.toFixed(2);
        }
        updateIndexFactors();

        $('#btnPickSIndex').on('click', function () {
            $.getJSON('@Url.Action("GetBouwIndexen", "Projecten")', { type: 'S' }, function (data) {
                var opties = data.map(function (d) {
                    return '<option value="' + d.indexWaarde + '">'
                        + d.jaar + (d.maand ? '/' + d.maand : '') + ' — ' + d.indexWaarde + '</option>';
                }).join('');
                $('#modalIndexLijst').html('<select class="form-select" id="ddlPickedIndex">' + opties + '</select>');
                $('#modalIndexPick').data('target', 'S').modal('show');
            });
        });

        $('#btnPickIIndex').on('click', function () {
            $.getJSON('@Url.Action("GetBouwIndexen", "Projecten")', { type: 'I2021' }, function (data) {
                var opties = data.map(function (d) {
                    return '<option value="' + d.indexWaarde + '">'
                        + d.jaar + (d.maand ? '/' + d.maand : '') + ' — ' + d.indexWaarde + '</option>';
                }).join('');
                $('#modalIndexLijst').html('<select class="form-select" id="ddlPickedIndex">' + opties + '</select>');
                $('#modalIndexPick').data('target', 'I').modal('show');
            });
        });

        $('#btnBevestigIndex').on('click', function () {
            const waarde = $('#ddlPickedIndex').val();
            const type = $('#modalIndexPick').data('target');
            if (type === 'S') $('[name$="SIndexHuidig"]').val(waarde);
            if (type === 'I') $('[name$="IIndexHuidig"]').val(waarde);
            updateIndexFactors();
            $('#modalIndexPick').modal('hide');
        });
    });
</script>
}