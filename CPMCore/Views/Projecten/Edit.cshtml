@using CPMCore.Helpers
@using BOCore
@using CPMCore.Models.Projecten
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model CPMCore.Models.Projecten.EditProjectDetail

@{
    var canWriteProject = ViewBag.CanWriteProject as bool? ?? false;
}

@section PageStyle
{
    <link rel="stylesheet" href="~/lib/select2/css/select2.css" />
    <link rel="stylesheet" href="~/lib/select2-bootstrap-theme/select2-bootstrap.css" />
    <link rel="stylesheet" href="~/css/admin/theme-admin-extension.css" />
    <link rel="stylesheet" href="~/css/admin/skins/extension.css" />
    <link href="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.js"></script>
    <style>
        #commercialTextEditorContainer .ql-editor { min-height: 220px; }
    </style>
}

<div class="row">
    <div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
        <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
            <div class="row align-items-center">
                <div class="col-sm-auto d-flex align-items-center">
                    <a href="@Url.Action("Detail", "Projecten", new { projectid = Model.Project.Id })" class="text-decoration-none text-reset d-flex align-items-center">
                        <i class="bx bx-chevron-left fs-1"></i>
                    </a>
                </div>
                <div class="col-sm-auto">
                    <h1 class="fw-bold mb-0">@Model.Project.Name bewerken</h1>
                    <h5 class="mb-4 mt-0">Werk de gegevens van dit project bij</h5>
                </div>
            </div>
        </div>
    </div>
</div>

@using (Html.BeginForm("Edit", "Projecten", FormMethod.Post, new { @class = "ecommerce-form action-buttons-fixed", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Project.Id)
    @Html.HiddenFor(m => m.Project.StandardFotoName)
    @Html.HiddenFor(m => m.SelectedPostalcode, new { id = "SelectedPostalcode" })
    @Html.HiddenFor(m => m.Project.WheaterStation.Id, new { id = "Project_WheaterStation_Id" })
    @Html.HiddenFor(m => m.Project.WheaterStation.Name, new { id = "Project_WheaterStation_Name" })
    @Html.HiddenFor(m => m.Project.Developer.ID, new { id = "Project_Developer_ID" })
    @Html.HiddenFor(m => m.Project.Developer.Display, new { id = "Project_Developer_Display" })
    @Html.HiddenFor(m => m.Project.Builder.ID, new { id = "Project_Builder_ID" })
    @Html.HiddenFor(m => m.Project.Builder.Display, new { id = "Project_Builder_Display" })
    @Html.HiddenFor(m => m.Project.Architect.ID, new { id = "Project_Architect_ID" })
    @Html.HiddenFor(m => m.Project.Architect.Display, new { id = "Project_Architect_Display" })
    @Html.HiddenFor(m => m.Project.Engineer.ID, new { id = "Project_Engineer_ID" })
    @Html.HiddenFor(m => m.Project.Engineer.Display, new { id = "Project_Engineer_Display" })
    @Html.HiddenFor(m => m.Project.SecurityCoordinator.ID, new { id = "Project_SecurityCoordinator_ID" })
    @Html.HiddenFor(m => m.Project.SecurityCoordinator.Display, new { id = "Project_SecurityCoordinator_Display" })
    @Html.HiddenFor(m => m.Project.EpbReporter.ID, new { id = "Project_EpbReporter_ID" })
    @Html.HiddenFor(m => m.Project.EpbReporter.Display, new { id = "Project_EpbReporter_Display" })

    <div class="row mt-2">
        <div class="col">
            <section class="card card-modern card-big-info">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-2-5 col-xl-1-5">
                            <i class="card-big-info-icon bx bx-info-circle"></i>
                            <h2 class="card-big-info-title">Algemene info</h2>
                            <p class="card-big-info-desc">Basisgegevens van het project. </p>
                        </div>
                        <div class="col-lg-3-5 col-xl-4-5">
                            @if (!ViewData.ModelState.IsValid)
                            {
                                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
                            }
                            <div class="form-group row align-items-center pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0">Puur coördinatieproject</label>
                                <div class="col-lg-8 col-xl-8">
                                    <div class="switch switch-sm switch-primary">
                                        @Html.CheckBoxFor(m => m.Project.IsOnlyCoordinationProject, new { data_plugin_ios_switch = "", id = "IsOnlyCoordinationProject" })
                                    </div>
                                    <small class="text-muted">Enkel coördinatie, geen eigen ontwikkeling</small>
                                </div>
                            </div>
                            <div class="form-group row align-items-center pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0">Heeft coördinatie</label>
                                <div class="col-lg-8 col-xl-8">
                                    <div class="switch switch-sm switch-primary">
                                        @Html.CheckBoxFor(m => m.Project.IsCoordinationProject, new { data_plugin_ios_switch = "", id = "IsCoordinationProject" })
                                    </div>
                                    <small class="text-muted">Toont coördinatiegegevens (ook voor ontwikkelingsprojecten)</small>
                                </div>
                            </div>
                            <div class="form-group row align-items-center pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="Project_Name">
                                    @Html.LabelFor(m => m.Project.Name)
                                </label>
                                <div class="col-lg-8 col-xl-8">
                                    @Html.TextBoxFor(m => m.Project.Name, new { @class = "form-control form-control-modern", placeholder = "Naam van het project", autocomplete = "off" })
                                </div>
                            </div>

                            <div class="form-group row align-items-center pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="Project_Street">
                                    @Html.LabelFor(m => m.Project.Street)
                                </label>
                                <div class="col-lg-5 col-xl-6">
                                    @Html.TextBoxFor(m => m.Project.Street, new { @class = "form-control form-control-modern", placeholder = "Straat" })
                                </div>
                                <div class="col-lg-3 col-xl-2">
                                    @Html.TextBoxFor(m => m.Project.HouseNumber, new { @class = "form-control form-control-modern", placeholder = "Nr." })
                                </div>
                            </div>

                            <div class="form-group row align-items-center pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="lstProjectCountries">Land</label>
                                <div class="col-lg-3 col-xl-3">
                                    @Html.DropDownListFor(m => m.SelectedCountry, new SelectList(Model.Countries, "ID", "Display", Model.SelectedCountry), new { @class = "form-control form-control-modern", id = "lstProjectCountries" })
                                </div>
                                <label class="col-lg-2 col-xl-2 control-label text-lg-end mb-0" for="PostalSelect">
                                    @Html.LabelFor(m => m.Project.Postalcode.Gemeente)
                                </label>
                                <div class="col-lg-3 col-xl-3">
                                    <select id="PostalSelect" class="form-control w-100">
                                        @if (Model.SelectedPostalcode > 0)
                                        {
                                            <option value="@Model.SelectedPostalcode" selected>
                                                @($"{Model.Project.Postalcode.Postcode} - {Model.Project.Postalcode.Gemeente}")
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="form-group row align-items-center pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="Project_CommercialTitleNL">
                                    @Html.LabelFor(m => m.Project.CommercialTitleNL)
                                </label>
                                <div class="col-lg-8 col-xl-8">
                                    @Html.TextBoxFor(m => m.Project.CommercialTitleNL, new { @class = "form-control form-control-modern", placeholder = "Commerciële titel" })
                                </div>
                            </div>

                            <div class="form-group row align-items-start pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="Project_CommercialTextNL">
                                    @Html.LabelFor(m => m.Project.CommercialTextNL)
                                </label>
                                <div class="col-lg-8 col-xl-8">
                                    <div id="commercialTextEditorContainer"></div>
                                    @Html.TextAreaFor(m => m.Project.CommercialTextNL, 6, 40, new { @class = "d-none", id = "commercialTextEditor" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col">
            <section class="card card-modern card-big-info">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-2-5 col-xl-1-5">
                            <i class="card-big-info-icon bx bx-image"></i>
                            <h2 class="card-big-info-title">Standaard foto</h2>
                            <p class="card-big-info-desc">Upload een standaard projectfoto die overal wordt weergegeven.</p>
                        </div>
                        <div class="col-lg-3-5 col-xl-4-5">
                            <div class="form-group row align-items-start pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0 pt-2">Huidige foto</label>
                                <div class="col-lg-8 col-xl-8">
                                    @{
                                        string stdUrl;
                                        if (!string.IsNullOrEmpty(Model.Project.StandardFotoName))
                                            stdUrl = Configuration["URL:ImageWebUrl"] + "pictures/447/" + Model.Project.StandardFotoName;
                                        else if (Model.Project.DefaultPicture?.Name is not null)
                                            stdUrl = Configuration["URL:ImageWebUrl"] + "pictures/447/" + Model.Project.DefaultPicture.Name;
                                        else
                                            stdUrl = "~/img/no_image.jpg";
                                    }
                                    <img src="@Url.Content(stdUrl)" id="editStdFotoPreview"
                                         style="max-height:160px;max-width:100%;object-fit:cover;border-radius:6px;border:1px solid #dee2e6;" alt="Standaard foto" />
                                </div>
                            </div>
                            <div class="form-group row align-items-center pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0">Nieuwe foto uploaden</label>
                                <div class="col-lg-8 col-xl-8">
                                    <input type="file" name="StandardFotoUpload" id="StandardFotoUpload" accept="image/jpeg,image/png,image/webp" class="form-control form-control-modern" />
                                    <small class="text-muted">Formaten: JPG, PNG, WEBP. Laat leeg om de huidige foto te behouden.</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col">
            <section class="card card-modern card-big-info">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-2-5 col-xl-1-5">
                            <i class="card-big-info-icon bx bx-search-alt"></i>
                            <h2 class="card-big-info-title">SEO</h2>
                            <p class="card-big-info-desc">Zoekmachineoptimalisatie. Laat leeg om automatisch te genereren.</p>
                        </div>
                        <div class="col-lg-3-5 col-xl-4-5">
                            <div class="form-group row align-items-center pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="Project_SeoTitle">
                                    SEO-titel
                                </label>
                                <div class="col-lg-8 col-xl-8">
                                    @Html.TextBoxFor(m => m.Project.SeoTitle, new { @class = "form-control form-control-modern", placeholder = "Laat leeg voor automatische titel", maxlength = "120", id = "Project_SeoTitle" })
                                    <small class="text-muted">Max. 120 tekens — wordt getoond in zoekresultaten. Leeg = automatisch gegenereerd.</small>
                                </div>
                            </div>
                            <div class="form-group row align-items-start pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0 pt-2" for="Project_SeoDescription">
                                    Meta-omschrijving
                                </label>
                                <div class="col-lg-8 col-xl-8">
                                    @Html.TextAreaFor(m => m.Project.SeoDescription, 4, 40, new { @class = "form-control form-control-modern", placeholder = "Laat leeg voor automatische omschrijving", maxlength = "320", id = "Project_SeoDescription" })
                                    <small class="text-muted">Max. 155 tekens aanbevolen — wordt getoond onder de titel in Google.</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col">
            <section class="card card-modern card-big-info">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-2-5 col-xl-1-5">
                            <i class="card-big-info-icon bx bx-calendar"></i>
                            <h2 class="card-big-info-title">Planning & status</h2>
                            <p class="card-big-info-desc">Plan de uitvoering en wijs verantwoordelijken toe.</p>
                        </div>
                        <div class="col-lg-3-5 col-xl-4-5">
                            <div class="form-group row align-items-center pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="Project_StartDateConstruction">@Html.LabelFor(m => m.Project.StartDateConstruction)</label>
                                <div class="col-lg-3 col-xl-3">
                                    <input type="date" class="form-control form-control-modern" id="Project_StartDateConstruction" name="Project.StartDateConstruction" value="@(Model.Project.StartDateConstruction.HasValue? Model.Project.StartDateConstruction.Value.ToString("yyyy-MM-dd") : string.Empty)" />
                                </div>
                                <label class="col-lg-3 col-xl-2 control-label text-lg-end mb-0" for="Project_ExecutionDays">@Html.LabelFor(m => m.Project.ExecutionDays)</label>
                                <div class="col-lg-3 col-xl-3">
                                    @Html.TextBoxFor(m => m.Project.ExecutionDays, new { @class = "form-control form-control-modern", type = "number", min = "0" })
                                </div>
                            </div>

                            <div class="form-group row align-items-center pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="Project_DeliveryDate">@Html.LabelFor(m => m.Project.DeliveryDate)</label>
                                <div class="col-lg-3 col-xl-3">
                                    <input type="date" class="form-control form-control-modern" id="Project_DeliveryDate" name="Project.DeliveryDate" value="@(Model.Project.DeliveryDate.HasValue? Model.Project.DeliveryDate.Value.ToString("yyyy-MM-dd") : string.Empty)" />
                                </div>
                                <label class="col-lg-3 col-xl-2 control-label text-lg-end mb-0" for="Project_DeliveryDateDef">@Html.LabelFor(m => m.Project.DeliveryDateDef)</label>
                                <div class="col-lg-3 col-xl-3">
                                    <input type="date" class="form-control form-control-modern" id="Project_DeliveryDateDef" name="Project.DeliveryDateDef" value="@(Model.Project.DeliveryDateDef.HasValue? Model.Project.DeliveryDateDef.Value.ToString("yyyy-MM-dd") : string.Empty)" />
                                </div>
                            </div>

                            <div class="form-group row align-items-center pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="WheaterSelect">@Html.LabelFor(m => m.Project.WheaterStation)</label>
                                <div class="col-lg-3 col-xl-3">
                                    <select id="WheaterSelect" class="form-control w-100">
                                        @if (Model.Project.WheaterStation.Id > 0)
                                        {
                                            <option value="@Model.Project.WheaterStation.Id" selected>@Model.Project.WheaterStation.Name</option>
                                        }
                                    </select>
                                </div>
                                <label class="col-lg-3 col-xl-2 control-label text-lg-end mb-0" for="lstProjectStatuses">@Html.LabelFor(m => m.Project.Status)</label>
                                <div class="col-lg-3 col-xl-3">
                                    @Html.DropDownListFor(m => m.SelectedStatus, new SelectList(Model.Statuses, "ID", "Display", Model.SelectedStatus), new { @class = "form-control form-control-modern", id = "lstProjectStatuses" })
                                </div>
                            </div>

                            <div class="form-group row align-items-center pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" asp-for="Project.IsPublished">@Html.LabelFor(m => m.Project.IsPublished)</label>
                                <div class="col-lg-8 col-xl-8">
                                    <div class="switch switch-sm switch-primary">
                                        @Html.CheckBoxFor(m => m.Project.IsPublished, new { data_plugin_ios_switch = "" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group row align-items-center pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="Project_ProjectType">@Html.LabelFor(m => m.Project.ProjectType)</label>
                                <div class="col-lg-3 col-xl-3">
                                    @Html.DropDownListFor(m => m.Project.ProjectType, Html.GetEnumSelectList<ProjectType>(), new { @class = "form-control form-control-modern" })
                                </div>
                                <label class="col-lg-3 col-xl-2 control-label text-lg-end mb-0" for="Project_AspNetUserID">@Html.LabelFor(m => m.Project.AspNetUserID)</label>
                                <div class="col-lg-3 col-xl-3">
                                    @Html.DropDownListFor(m => m.Project.AspNetUserID, new SelectList(Model.Users, "Id", "DisplayName", Model.Project.AspNetUserID), "Selecteer een verantwoordelijke", new { @class = "form-control form-control-modern" })
                                </div>
                            </div>

                            <div class="form-group row align-items-center pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="Project_TotalLandShare">@Html.LabelFor(m => m.Project.TotalLandShare)</label>
                                <div class="col-lg-3 col-xl-3">
                                    @Html.TextBoxFor(m => m.Project.TotalLandShare, new { @class = "form-control form-control-modern", type = "number", step = "0.01", min = "0" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col">
            <section class="card card-modern card-big-info">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-2-5 col-xl-1-5">
                            <i class="card-big-info-icon bx bx-user"></i>
                            <h2 class="card-big-info-title">Partners & documenten</h2>
                            <p class="card-big-info-desc">Koppel de betrokken partijen en beheer de documentatie.</p>
                        </div>
                        <div class="col-lg-3-5 col-xl-4-5">
                            <div class="form-group row align-items-center pb-3">
                                <label class="col-lg-3 col-xl-3 control-label text-lg-end mb-0" for="DeveloperSelect">@Html.LabelFor(m => m.Project.Developer)</label>
                                <div class="col-lg-3 col-xl-3">
                                    <select id="DeveloperSelect" class="form-control w-100">
                                        @if (Model.Project.Developer.ID > 0)
                                        {
                                            <option value="@Model.Project.Developer.ID" selected>@Model.Project.Developer.Display</option>
                                        }
                                    </select>
                                </div>
                                <label class="col-lg-3 col-xl-2 control-label text-lg-end mb-0" for="BuilderSelect">@Html.LabelFor(m => m.Project.Builder)</label>
                                <div class="col-lg-3 col-xl-3">
                                    <select id="BuilderSelect" class="form-control w-100">
                                        @if (Model.Project.Builder.ID > 0)
                                        {
                                            <option value="@Model.Project.Builder.ID" selected>@Model.Project.Builder.Display</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row align-items-center pb-3">
                                <label class="col-lg-3 col-xl-3 control-label text-lg-end mb-0" for="Project_IssuerCompanyIdBuilder">@Html.DisplayNameFor(m => m.Project.IssuerCompanyIdBuilder)</label>
                                <div class="col-lg-3 col-xl-3">
                                    @Html.DropDownListFor(m => m.Project.IssuerCompanyIdBuilder, new SelectList(Model.IssuerCompanies, nameof(ProjectIssuerCompanyOptionVM.Id), nameof(ProjectIssuerCompanyOptionVM.Name), Model.Project.IssuerCompanyIdBuilder), "-- Selecteer --", new { @class = "form-control form-control-modern" })
                                </div>
                                <label class="col-lg-3 col-xl-2 control-label text-lg-end mb-0" for="Project_IssuerCompanyLandOwner">@Html.DisplayNameFor(m => m.Project.IssuerCompanyIdLandOwner)</label>
                                <div class="col-lg-3 col-xl-3">
                                    @Html.DropDownListFor(m => m.Project.IssuerCompanyIdLandOwner, new SelectList(Model.IssuerCompanies, nameof(ProjectIssuerCompanyOptionVM.Id), nameof(ProjectIssuerCompanyOptionVM.Name), Model.Project.IssuerCompanyIdLandOwner), "-- Selecteer --", new { @class = "form-control form-control-modern" })
                                </div>
                            </div>
                            <div class="form-group row align-items-center pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="ArchitectSelect">@Html.LabelFor(m => m.Project.Architect)</label>
                                <div class="col-lg-3 col-xl-3">
                                    <select id="ArchitectSelect" class="form-control w-100">
                                        @if (Model.Project.Architect.ID > 0)
                                        {
                                            <option value="@Model.Project.Architect.ID" selected>@Model.Project.Architect.Display</option>
                                        }
                                    </select>
                                </div>
                                <label class="col-lg-3 col-xl-2 control-label text-lg-end mb-0" for="EngineerSelect">@Html.LabelFor(m => m.Project.Engineer)</label>
                                <div class="col-lg-3 col-xl-3">
                                    <select id="EngineerSelect" class="form-control w-100">
                                        @if (Model.Project.Engineer.ID > 0)
                                        {
                                            <option value="@Model.Project.Engineer.ID" selected>@Model.Project.Engineer.Display</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="form-group row align-items-center pb-3">
                                <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="SecuritySelect">@Html.LabelFor(m => m.Project.SecurityCoordinator)</label>
                                <div class="col-lg-3 col-xl-3">
                                    <select id="SecuritySelect" class="form-control w-100">
                                        @if (Model.Project.SecurityCoordinator.ID > 0)
                                        {
                                            <option value="@Model.Project.SecurityCoordinator.ID" selected>@Model.Project.SecurityCoordinator.Display</option>
                                        }
                                    </select>
                                </div>
                                <label class="col-lg-3 col-xl-2 control-label text-lg-end mb-0" for="EpbSelect">@Html.LabelFor(m => m.Project.EpbReporter)</label>
                                <div class="col-lg-3 col-xl-3">
                                    <select id="EpbSelect" class="form-control w-100">
                                        @if (Model.Project.EpbReporter.ID > 0)
                                        {
                                            <option value="@Model.Project.EpbReporter.ID" selected>@Model.Project.EpbReporter.Display</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            @if (canWriteProject)
                            {
                                <hr />
                                <h4 class="fw-bold mb-3">Verplichte documenten</h4>
                                <div class="form-group row align-items-center pb-3">
                                    <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="Project_DocDelivery">@Html.LabelFor(m => m.Project.DocDelivery)</label>
                                    <div class="col-lg-3 col-xl-3">
                                        <div class="form-check">
                                            @Html.CheckBox("Project.DocDelivery", Model.Project.DocDelivery ?? false, new { @class = "form-check-input" })
                                        </div>
                                    </div>
                                    <label class="col-lg-2 col-xl-2 control-label text-lg-end mb-0" for="Project_DocDefDelivery">@Html.LabelFor(m => m.Project.DocDefDelivery)</label>
                                    <div class="col-lg-3 col-xl-3">
                                        <div class="form-check">
                                            @Html.CheckBox("Project.DocDefDelivery", Model.Project.DocDefDelivery ?? false, new { @class = "form-check-input" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row align-items-center pb-3">
                                    <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="Project_DocPID">@Html.LabelFor(m => m.Project.DocPID)</label>
                                    <div class="col-lg-3 col-xl-3">
                                        <div class="form-check">
                                            @Html.CheckBox("Project.DocPID", Model.Project.DocPID ?? false, new { @class = "form-check-input" })
                                        </div>
                                    </div>
                                    <label class="col-lg-2 col-xl-2 control-label text-lg-end mb-0" for="Project_DocElectricalInspection">@Html.LabelFor(m => m.Project.DocElectricalInspection)</label>
                                    <div class="col-lg-3 col-xl-3">
                                        <div class="form-check">
                                            @Html.CheckBox("Project.DocElectricalInspection", Model.Project.DocElectricalInspection ?? false, new { @class = "form-check-input" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row align-items-center pb-3">
                                    <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="Project_DocWaterInspection">@Html.LabelFor(m => m.Project.DocWaterInspection)</label>
                                    <div class="col-lg-3 col-xl-3">
                                        <div class="form-check">
                                            @Html.CheckBox("Project.DocWaterInspection", Model.Project.DocWaterInspection ?? false, new { @class = "form-check-input" })
                                        </div>
                                    </div>
                                    <label class="col-lg-2 col-xl-2 control-label text-lg-end mb-0" for="Project_DocFireInspection">@Html.LabelFor(m => m.Project.DocFireInspection)</label>
                                    <div class="col-lg-3 col-xl-3">
                                        <div class="form-check">
                                            @Html.CheckBox("Project.DocFireInspection", Model.Project.DocFireInspection ?? false, new { @class = "form-check-input" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row align-items-center pb-3">
                                    <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0" for="Project_DocSewerInspection">@Html.LabelFor(m => m.Project.DocSewerInspection)</label>
                                    <div class="col-lg-3 col-xl-3">
                                        <div class="form-check">
                                            @Html.CheckBox("Project.DocSewerInspection", Model.Project.DocSewerInspection ?? false, new { @class = "form-check-input" })
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    @* ── Coördinatieproject ───────────────────────────────────────────────── *@
    <div id="coordinationCard">
    <div class="row mt-4">
        <div class="col">
            <section class="card card-modern card-big-info">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-2-5 col-xl-1-5">
                            <i class="card-big-info-icon bx bx-briefcase"></i>
                            <h2 class="card-big-info-title">Type project</h2>
                            <p class="card-big-info-desc">Eigen project of coördinatieproject met contract.</p>
                        </div>
                        <div class="col-lg-3-5 col-xl-4-5">

                            <div>
                                <div class="form-group row align-items-center pb-3">
                                    <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0">
                                        @Html.LabelFor(m => m.Project.CoordinationIssuerCompanyId)
                                    </label>
                                    <div class="col-lg-4 col-xl-4">
                                        @Html.DropDownListFor(m => m.Project.CoordinationIssuerCompanyId,
                                            new SelectList(Model.IssuerCompanies, nameof(ProjectIssuerCompanyOptionVM.Id), nameof(ProjectIssuerCompanyOptionVM.Name), Model.Project.CoordinationIssuerCompanyId),
                                            "-- Selecteer facturatiebedrijf --",
                                            new { @class = "form-control form-control-modern" })
                                    </div>
                                </div>

                                <div class="form-group row align-items-center pb-3">
                                    <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0">
                                        @Html.LabelFor(m => m.Project.ContractType)
                                    </label>
                                    <div class="col-lg-4 col-xl-4">
                                    <select asp-for="Project.ContractType"
                                            asp-items="Html.GetEnumSelectList<BOCore.CoordinationContractType>()"
                                            class="form-control form-control-modern">
                                        <option value="">-- Selecteer type --</option>
                                    </select>
                                    </div>
                                </div>

                                @if (Model.Project.ProjectDistanceKm.HasValue)
                                {
                                    <div class="form-group row align-items-center pb-3">
                                        <label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0">Berekende afstand</label>
                                        <div class="col-lg-4 col-xl-4">
                                            <span class="form-control-plaintext fw-bold">@Model.Project.ProjectDistanceKm?.ToString("0.##") km</span>
                                        </div>
                                    </div>
                                }

                                @* ── Schijven sectie ── *@
                                <div id="slicesSection">
                                    <hr />
                                    <h6 class="fw-bold mb-3">Contract schijven <small class="text-muted">(totaal moet 100% zijn)</small></h6>
                                    <div id="slicesContainer">
                                        @for (int i = 0; i < Model.ContractSlices.Count; i++)
                                        {
                                            <div class="row slice-row mb-2">
                                                <div class="col-lg-6">
                                                    <input type="text" name="ContractSlices[@i].Description"
                                                           value="@Model.ContractSlices[i].Description"
                                                           class="form-control form-control-modern" placeholder="Omschrijving" />
                                                </div>
                                                <div class="col-lg-3">
                                                    <div class="input-group">
                                                        <input type="number" name="ContractSlices[@i].Percentage"
                                                               value="@Model.ContractSlices[i].Percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                                               class="form-control form-control-modern slice-pct" step="0.01" min="0.01" max="100" placeholder="%" />
                                                        <span class="input-group-text">%</span>
                                                    </div>
                                                </div>
                                                <div class="col-lg-1">
                                                    <button type="button" class="btn btn-danger btn-sm remove-slice"><i class="bx bx-trash"></i></button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <div class="row mt-2">
                                        <div class="col-lg-9">
                                            <span class="badge bg-secondary me-2">Totaal: <span id="slicesTotal">0</span>%</span>
                                            <button type="button" id="addSlice" class="btn btn-outline-secondary btn-sm">
                                                <i class="bx bx-plus"></i> Schijf toevoegen
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                @* ── Regie sectie ── *@
                                <div id="regieSection">
                                    <hr />
                                    <h6 class="fw-bold mb-3">Uurtarieven (regie)</h6>
                                    <div id="ratesContainer">
                                        @for (int i = 0; i < Model.HourlyRates.Count; i++)
                                        {
                                            <div class="row rate-row mb-2">
                                                <div class="col-lg-6">
                                                    <select name="HourlyRates[@i].UserId" class="form-control form-control-modern rate-user">
                                                        <option value="">-- Selecteer persoon --</option>
                                                        @foreach (var u in Model.AvailableUsers)
                                                        {
                                                            if (Model.HourlyRates[i].UserId == u.Group)
                                                            {
                                                                <option value="@u.Group" selected>@u.Display</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@u.Group">@u.Display</option>
                                                            }
                                                        }
                                                    </select>
                                                    <input type="hidden" name="HourlyRates[@i].UserFullName" value="@Model.HourlyRates[i].UserFullName" />
                                                </div>
                                                <div class="col-lg-3">
                                                    <div class="input-group">
                                                        <span class="input-group-text">€</span>
                                                        <input type="number" name="HourlyRates[@i].HourlyRate"
                                                               value="@Model.HourlyRates[i].HourlyRate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                                               class="form-control form-control-modern" step="0.01" min="0" placeholder="0,00" />
                                                    </div>
                                                </div>
                                                <div class="col-lg-1">
                                                    <button type="button" class="btn btn-danger btn-sm remove-rate"><i class="bx bx-trash"></i></button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <div class="row mt-2">
                                        <div class="col">
                                            <button type="button" id="addRate" class="btn btn-outline-secondary btn-sm">
                                                <i class="bx bx-plus"></i> Tarief toevoegen
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
    </div>@* /coordinationCard *@

    <div class="row action-buttons">
        <div class="col-12 col-md-auto">
            <button type="submit" class="submit-button btn btn-primary btn-px-4 py-3 d-flex align-items-center font-weight-semibold line-height-1" data-loading-text="Laden...">
                <i class="bx bx-save text-4 me-2"></i> Wijzigingen opslaan
            </button>
        </div>
        <div class="col-12 col-md-auto px-md-0 mt-3 mt-md-0">
            <a href="@((TempData.Peek("Referrer") as string) ?? Url.Action("Detail", "Projecten", new { projectid = Model.Project.Id }))" class="cancel-button btn btn-light btn-px-4 py-3 border font-weight-semibold text-color-dark text-3">Annuleren</a>
        </div>
    </div>
}

@section PageScripts
{
    <script src="~/lib/select2/js/select2.js"></script>
    <script src="~/lib/select2/js/i18n/nl.js"></script>
    <script src="~/js/theme.admin.extension.js"></script>
    <script src="~/lib/ios7-switch/ios7-switch.js"></script>
    <script>
        function configureSelect(selector, options, onSelect) {
                const $el = $(selector).select2(options);
                if (onSelect) {
                        $el.on('select2:select', onSelect);
                        $el.on('select2:clear', function () {
                                onSelect({ params: { data: { id: 0, text: '' } } });
                        });
                }
                return $el;
        }

        $(function () {
                const companyOptions = {
                        theme: 'bootstrap',
                        placeholder: 'Selecteer...',
                        width: '100%',
                        language: 'nl',
                        allowClear: true,
                        minimumInputLength: 3,
                        ajax: {
                                url: '@Url.Action("GetCompanys", "Projecten")',
                                type: 'POST',
                                dataType: 'json',
                                delay: 250,
                                data: function (params) {
                                        return { term: params.term };
                                },
                                processResults: function (data) {
                                        return { results: data };
                                }
                        }
                };

                configureSelect('#PostalSelect', {
                        theme: 'bootstrap',
                        placeholder: 'Selecteer de gemeente',
                        width: '100%',
                        language: 'nl',
                        allowClear: true,
                        ajax: {
                                url: '@Url.Action("GetPostcodesByCountry", "Projecten")',
                                type: 'POST',
                                dataType: 'json',
                                delay: 250,
                                data: function (params) {
                                        return {
                                                term: params.term,
                                                countryId: $('#lstProjectCountries').val()
                                        };
                                },
                                processResults: function (data) {
                                        return { results: data };
                                }
                        }
                }, function (e) {
                        $('#SelectedPostalcode').val(e.params.data.id);
                });

                configureSelect('#WheaterSelect', {
                        theme: 'bootstrap',
                        placeholder: 'Selecteer het KMI weerstation',
                        width: '100%',
                        language: 'nl',
                        allowClear: true,
                        minimumInputLength: 1,
                        ajax: {
                                url: '@Url.Action("GetWheaterstations", "Projecten")',
                                type: 'POST',
                                dataType: 'json',
                                delay: 250,
                                data: function (params) {
                                        return { term: params.term };
                                },
                                processResults: function (data) {
                                        return { results: data };
                                }
                        }
                }, function (e) {
                        $('#Project_WheaterStation_Id').val(e.params.data.id);
                        $('#Project_WheaterStation_Name').val(e.params.data.text);
                });

                configureSelect('#DeveloperSelect', companyOptions, function (e) {
                        $('#Project_Developer_ID').val(e.params.data.id);
                        $('#Project_Developer_Display').val(e.params.data.text);
                });
                configureSelect('#BuilderSelect', companyOptions, function (e) {
                        $('#Project_Builder_ID').val(e.params.data.id);
                        $('#Project_Builder_Display').val(e.params.data.text);
                });
                configureSelect('#ArchitectSelect', companyOptions, function (e) {
                        $('#Project_Architect_ID').val(e.params.data.id);
                        $('#Project_Architect_Display').val(e.params.data.text);
                });
                configureSelect('#EngineerSelect', companyOptions, function (e) {
                        $('#Project_Engineer_ID').val(e.params.data.id);
                        $('#Project_Engineer_Display').val(e.params.data.text);
                });
                configureSelect('#SecuritySelect', companyOptions, function (e) {
                        $('#Project_SecurityCoordinator_ID').val(e.params.data.id);
                        $('#Project_SecurityCoordinator_Display').val(e.params.data.text);
                });
                configureSelect('#EpbSelect', companyOptions, function (e) {
                        $('#Project_EpbReporter_ID').val(e.params.data.id);
                        $('#Project_EpbReporter_Display').val(e.params.data.text);
                });

                if ($('#PostalSelect').val()) {
                        $('#SelectedPostalcode').val($('#PostalSelect').val());
                }

                // ── Coördinatieproject logica ─────────────────────────────────────
                var availableUsers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    Model.AvailableUsers.Select(u => new { id = u.Group, text = u.Display }).ToList()));

                function updateCoordinationVisibility() {
                    var isCoord = $('#IsCoordinationProject').is(':checked');
                    $('#coordinationCard').toggle(isCoord);
                    if (isCoord) updateContractTypeVisibility();
                }

                function updateContractTypeVisibility() {
                    var type = $('#Project_ContractType').val();
                    var showSlices = (type === '1' || type === '3');
                    var showRegie = (type === '2' || type === '3');
                    $('#slicesSection').toggle(showSlices);
                    $('#regieSection').toggle(showRegie);
                    updateSlicesTotal();
                }

                $('#IsCoordinationProject').on('change', updateCoordinationVisibility);
                $('#Project_ContractType').on('change', updateContractTypeVisibility);
                updateCoordinationVisibility();

                // ── Schijven ──────────────────────────────────────────────────────
                var sliceIndex = @Model.ContractSlices.Count;

                function updateSlicesTotal() {
                    var total = 0;
                    $('.slice-pct').each(function () {
                        var v = parseFloat($(this).val()) || 0;
                        total += v;
                    });
                    var rounded = Math.round(total * 100) / 100;
                    $('#slicesTotal').text(rounded);
                    $('#slicesTotal').parent().toggleClass('bg-success', rounded === 100).toggleClass('bg-secondary', rounded !== 100);
                }
                updateSlicesTotal();

                $(document).on('input', '.slice-pct', updateSlicesTotal);

                $('#addSlice').on('click', function () {
                    var idx = sliceIndex++;
                    var row = '<div class="row slice-row mb-2">' +
                        '<div class="col-lg-6"><input type="text" name="ContractSlices[' + idx + '].Description" class="form-control form-control-modern" placeholder="Omschrijving" /></div>' +
                        '<div class="col-lg-3"><div class="input-group"><input type="number" name="ContractSlices[' + idx + '].Percentage" class="form-control form-control-modern slice-pct" step="0.01" min="0.01" max="100" placeholder="%" /><span class="input-group-text">%</span></div></div>' +
                        '<div class="col-lg-1"><button type="button" class="btn btn-danger btn-sm remove-slice"><i class="bx bx-trash"></i></button></div>' +
                        '</div>';
                    $('#slicesContainer').append(row);
                    updateSlicesTotal();
                });

                $(document).on('click', '.remove-slice', function () {
                    $(this).closest('.slice-row').remove();
                    $('#slicesContainer .slice-row').each(function (i) {
                        $(this).find('input[name*="Description"]').attr('name', 'ContractSlices[' + i + '].Description');
                        $(this).find('input[name*="Percentage"]').attr('name', 'ContractSlices[' + i + '].Percentage');
                    });
                    sliceIndex = $('#slicesContainer .slice-row').length;
                    updateSlicesTotal();
                });

                // ── Uurtarieven ───────────────────────────────────────────────────
                var rateIndex = @Model.HourlyRates.Count;

                function buildUserOptions(selectedId) {
                    var html = '<option value="">-- Selecteer persoon --</option>';
                    availableUsers.forEach(function (u) {
                        html += '<option value="' + u.id + '"' + (u.id === selectedId ? ' selected' : '') + '>' + u.text + '</option>';
                    });
                    return html;
                }

                $('#addRate').on('click', function () {
                    var idx = rateIndex++;
                    var row = '<div class="row rate-row mb-2">' +
                        '<div class="col-lg-6"><select name="HourlyRates[' + idx + '].UserId" class="form-control form-control-modern rate-user">' + buildUserOptions('') + '</select>' +
                        '<input type="hidden" name="HourlyRates[' + idx + '].UserFullName" value="" /></div>' +
                        '<div class="col-lg-3"><div class="input-group"><span class="input-group-text">€</span><input type="number" name="HourlyRates[' + idx + '].HourlyRate" class="form-control form-control-modern" step="0.01" min="0" placeholder="0,00" /></div></div>' +
                        '<div class="col-lg-1"><button type="button" class="btn btn-danger btn-sm remove-rate"><i class="bx bx-trash"></i></button></div>' +
                        '</div>';
                    $('#ratesContainer').append(row);
                });

                $(document).on('change', '.rate-user', function () {
                    var selected = $(this).find('option:selected').text();
                    $(this).closest('.rate-row').find('input[name*="UserFullName"]').val(selected);
                });

                $(document).on('click', '.remove-rate', function () {
                    $(this).closest('.rate-row').remove();
                    $('#ratesContainer .rate-row').each(function (i) {
                        $(this).find('select').attr('name', 'HourlyRates[' + i + '].UserId');
                        $(this).find('input[name*="UserFullName"]').attr('name', 'HourlyRates[' + i + '].UserFullName');
                        $(this).find('input[name*="HourlyRate"]').attr('name', 'HourlyRates[' + i + '].HourlyRate');
                    });
                    rateIndex = $('#ratesContainer .rate-row').length;
                });

        });

        var quill = new Quill('#commercialTextEditorContainer', {
            theme: 'snow',
            modules: {
                toolbar: [
                    ['bold', 'italic', 'underline'],
                    [{ list: 'ordered' }, { list: 'bullet' }],
                    ['link'],
                    ['clean']
                ]
            }
        });

        var commercialTextArea = document.getElementById('commercialTextEditor');
        if (commercialTextArea.value) {
            quill.root.innerHTML = commercialTextArea.value;
        }

        quill.on('text-change', function () {
            commercialTextArea.value = quill.root.innerHTML;
        });
    </script>
}