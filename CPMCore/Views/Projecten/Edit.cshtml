@using System
@using CPMCore.Helpers
@using BOCore
@using CPMCore.Models.Projecten
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model CPMCore.Models.Projecten.EditProjectDetail

@functions {
    // Welke veld-sleutels bij welke tab horen — om een tab te markeren die na
    // een mislukte Save een validatiefout bevat.
    private static readonly (string Key, string[] Prefixes)[] TabMap = new[]
    {
        ("algemeen",    new[] { "Project.Name", "Project.ProjectCode", "Project.Street", "Project.HouseNumber", "SelectedCountry", "SelectedPostalcode", "Project.Postalcode", "Project.Werfmelding", "Project.CommercialTitleNL", "Project.CommercialTextNL", "SelectedStatus", "Project.Status", "Project.ProjectType", "Project.DeliveryDateDef", "Project.TotalLandShare", "Project.IsPublished", "Project.StandardFotoName", "StandardFotoUpload" }),
        ("planning",    new[] { "Project.StartDateConstruction", "Project.ExecutionDays", "Project.DeliveryDate", "Project.WheaterStation", "Project.AspNetUserID", "Project.SalesResponsibleUserID" }),
        ("partners",    new[] { "Project.Developer", "Project.Builder", "Project.IssuerCompanyIdBuilder", "Project.IssuerCompanyIdLandOwner", "Project.Architect", "Project.Engineer", "Project.SecurityCoordinator", "Project.EpbReporter", "Project.Notary" }),
        ("documenten",  new[] { "Project.Doc" }),
        ("seo",         new[] { "Project.Seo" }),
        ("coordinatie", new[] { "Project.Coordination", "Project.ContractType", "Project.IsCoordinationProject", "Project.IsOnlyCoordinationProject", "Project.KmAllowance", "ContractSlices", "HourlyRates" }),
    };
}

@{
    var canWriteProject = ViewBag.CanWriteProject as bool? ?? false;

    // "pictures/447/" bestaat enkel voor afbeeldingen; een video als standaardfoto
    // (MediaType == 1) heeft er geen en zou een gebroken beeld geven.
    string currentPhotoUrl = null;
    if (!string.IsNullOrEmpty(Model.Project.StandardFotoName))
        currentPhotoUrl = Configuration["URL:ImageWebUrl"] + "pictures/447/" + Model.Project.StandardFotoName;
    else if (Model.Project.DefaultPicture?.Name is not null && Model.Project.DefaultPicture.MediaType != 1)
        currentPhotoUrl = Configuration["URL:ImageWebUrl"] + "pictures/447/" + Model.Project.DefaultPicture.Name;

    ViewData["ShowWerfmelding"] = true;
    ViewData["ShowExtendedPartners"] = true;
    ViewData["CurrentPhotoUrl"] = currentPhotoUrl;

    var erroredKeys = ViewData.ModelState
        .Where(kv => kv.Value != null && kv.Value.Errors.Count > 0)
        .Select(kv => kv.Key)
        .ToList();

    Func<string, int> tabErrorCount = tabKey =>
    {
        var prefixes = TabMap.First(t => t.Key == tabKey).Prefixes;
        return erroredKeys.Count(k => prefixes.Any(p => k.StartsWith(p, StringComparison.OrdinalIgnoreCase)));
    };

    var tabDefs = new (string Key, string Label, string Icon)[]
    {
        ("algemeen", "Algemeen", "bx-info-circle"),
        ("planning", "Planning", "bx-calendar"),
        ("partners", "Partners", "bx-group"),
        ("documenten", "Documenten", "bx-check-shield"),
        ("seo", "SEO", "bx-search-alt"),
        ("coordinatie", "Coördinatie", "bx-briefcase"),
    };

    var firstErrorTab = tabDefs.Select(t => t.Key).FirstOrDefault(k => tabErrorCount(k) > 0);
}

@section PageStyle
{
    @await Html.PartialAsync("_ProjectFormStyles")
    <style>
        #commercialTextEditorContainer .ql-editor { min-height: 220px; }
    </style>
}

@using (Html.BeginForm("Edit", "Projecten", FormMethod.Post, new { @class = "ecommerce-form action-buttons-fixed gl-project-form gl-project-form--tabbed", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Project.Id)
    @Html.HiddenFor(m => m.Project.StandardFotoName)

    <div asp-validation-summary="All" class="alert alert-danger @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

    <div class="card card-modern gl-project-tabcard">
        <div class="card-body">
            <div class="gl-tabs" role="tablist" aria-label="Projectgegevens" data-tabgroup="project-edit" data-force-tab="@firstErrorTab">
                @foreach (var t in tabDefs)
                {
                    var n = tabErrorCount(t.Key);
                    <button type="button" class="gl-tab" role="tab" id="tabbtn-@t.Key" data-tab="@t.Key"
                            aria-controls="tab-@t.Key" aria-selected="@(t.Key == "algemeen" ? "true" : "false")"
                            tabindex="@(t.Key == "algemeen" ? "0" : "-1")">
                        <i class="bx @t.Icon" aria-hidden="true"></i>
                        <span>@t.Label</span>
                        @if (n > 0)
                        {
                            <span class="gl-tab__badge" title="@n fout(en) op dit tabblad">@n</span>
                        }
                    </button>
                }
            </div>

            <div id="tab-algemeen" class="gl-tabpanel" role="tabpanel" aria-labelledby="tabbtn-algemeen" tabindex="0">
                @await Html.PartialAsync("_ProjectFormGeneral", Model)

                <section class="gl-form-section">
                    <div class="gl-form-section__body">
                        <div class="gl-form-section__head">
                            <i class="bx bx-flag" aria-hidden="true"></i>
                            <div>
                                <h2 class="gl-form-section__title">Status &amp; publicatie</h2>
                                <p class="gl-form-section__hint">Waar staat het project en is het publiek zichtbaar?</p>
                            </div>
                        </div>
                        <div class="gl-field-grid">
                            <div class="gl-field">
                                <label for="lstProjectStatuses">@Html.DisplayNameFor(m => m.Project.Status)</label>
                                @Html.DropDownListFor(m => m.SelectedStatus, new SelectList(Model.Statuses, "ID", "Display", Model.SelectedStatus), new { @class = "form-control form-control-modern", id = "lstProjectStatuses" })
                            </div>
                            <div class="gl-field">
                                <label for="Project_ProjectType">@Html.DisplayNameFor(m => m.Project.ProjectType)</label>
                                @Html.DropDownListFor(m => m.Project.ProjectType, Html.GetEnumSelectList<ProjectType>(), new { @class = "form-control form-control-modern", id = "Project_ProjectType" })
                            </div>
                            <div class="gl-field">
                                <label for="Project_DeliveryDateDef">@Html.DisplayNameFor(m => m.Project.DeliveryDateDef)</label>
                                <input type="date" class="form-control form-control-modern" id="Project_DeliveryDateDef" name="Project.DeliveryDateDef"
                                       value="@(Model.Project.DeliveryDateDef.HasValue ? Model.Project.DeliveryDateDef.Value.ToString("yyyy-MM-dd") : string.Empty)" />
                            </div>
                            <div class="gl-field">
                                <label for="Project_TotalLandShare">@Html.DisplayNameFor(m => m.Project.TotalLandShare)</label>
                                @Html.TextBoxFor(m => m.Project.TotalLandShare, new { @class = "form-control form-control-modern", type = "number", step = "0.01", min = "0", id = "Project_TotalLandShare" })
                            </div>
                        </div>
                        <div class="gl-switch-row">
                            <div class="switch switch-sm switch-primary">
                                @Html.CheckBoxFor(m => m.Project.IsPublished, new { data_plugin_ios_switch = "", id = "Project_IsPublished" })
                            </div>
                            <label for="Project_IsPublished">@Html.DisplayNameFor(m => m.Project.IsPublished) <small class="text-muted">— zichtbaar op de publieke website</small></label>
                        </div>
                    </div>
                </section>

                @await Html.PartialAsync("_ProjectFormMedia", Model)
            </div>

            <div id="tab-planning" class="gl-tabpanel" role="tabpanel" aria-labelledby="tabbtn-planning" tabindex="0" hidden>
                @await Html.PartialAsync("_ProjectFormPlanning", Model)
            </div>

            <div id="tab-partners" class="gl-tabpanel" role="tabpanel" aria-labelledby="tabbtn-partners" tabindex="0" hidden>
                @await Html.PartialAsync("_ProjectFormPartners", Model)
            </div>

            <div id="tab-documenten" class="gl-tabpanel" role="tabpanel" aria-labelledby="tabbtn-documenten" tabindex="0" hidden>
                @if (canWriteProject)
                {
                    @await Html.PartialAsync("_ProjectFormDocs", Model)
                }
                else
                {
                    <p class="text-muted mb-0">Je hebt geen rechten om de verplichte documenten te wijzigen.</p>
                }
            </div>

            <div id="tab-seo" class="gl-tabpanel" role="tabpanel" aria-labelledby="tabbtn-seo" tabindex="0" hidden>
                <section class="gl-form-section">
                    <div class="gl-form-section__body">
                        <div class="gl-form-section__head">
                            <i class="bx bx-search-alt" aria-hidden="true"></i>
                            <div>
                                <h2 class="gl-form-section__title">SEO</h2>
                                <p class="gl-form-section__hint">Laat leeg om automatisch te genereren.</p>
                            </div>
                        </div>
                        <div class="gl-field-grid">
                            <div class="gl-field gl-field--full gl-field--wide">
                                <label for="Project_SeoTitle">SEO-titel</label>
                                @Html.TextBoxFor(m => m.Project.SeoTitle, new { @class = "form-control form-control-modern", placeholder = "Laat leeg voor automatische titel", maxlength = "120", id = "Project_SeoTitle" })
                                <small class="text-muted">Max. 120 tekens — getoond in zoekresultaten.</small>
                            </div>
                            <div class="gl-field gl-field--full gl-field--wide">
                                <label for="Project_SeoDescription">Meta-omschrijving</label>
                                @Html.TextAreaFor(m => m.Project.SeoDescription, 4, 40, new { @class = "form-control form-control-modern", placeholder = "Laat leeg voor automatische omschrijving", maxlength = "320", id = "Project_SeoDescription" })
                                <small class="text-muted">Max. 155 tekens aanbevolen — getoond onder de titel in Google.</small>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <div id="tab-coordinatie" class="gl-tabpanel" role="tabpanel" aria-labelledby="tabbtn-coordinatie" tabindex="0" hidden>
                @await Html.PartialAsync("_ProjectFormCoordinationCard", Model)
            </div>
        </div>
    </div>

    <div class="row action-buttons">
        <div class="col-12 col-md-auto">
            <button type="submit" class="submit-button btn btn-primary btn-px-4 py-3 d-flex align-items-center font-weight-semibold line-height-1" data-loading-text="Laden...">
                <i class="bx bx-save text-4 me-2" aria-hidden="true"></i> Wijzigingen opslaan
            </button>
        </div>
        <div class="col-12 col-md-auto px-md-0 mt-3 mt-md-0">
            <a href="@((TempData.Peek("Referrer") as string) ?? Url.Action("Detail", "Projecten", new { projectid = Model.Project.Id }))" class="cancel-button btn btn-light btn-px-4 py-3 border font-weight-semibold text-color-dark text-3">Annuleren</a>
        </div>
    </div>
}

@section PageScripts
{
    @await Html.PartialAsync("_ProjectFormScripts", Model)
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/lib/jquery-validation/localization/messages_nl.js"></script>
    @await Html.PartialAsync("_ProjectFormTabs")
}
