@model CPMCore.Models.Projecten.ChangeOrdersV2Vm
@*
    gl-v2 — Offertes & wijzigingen (design-handoff 20b + 29a: "één lijst, één verloop: offerte → opgemaakt
    → verzonden → ondertekend → gefactureerd → betaald"). Het vertrekpunt van de flow uit 29b:
      · "+ Nieuw" (één knop, vier ingangen): Offerte inlezen (→ 20c → 21c → 28a) · Leeg beginnen (→ 28b) ·
        Kopie van een wijzigingsopdracht (→ kies eenheid → 28a) · Offerte zonder omzetten (→ 20c, enkel bewaren);
      · een offerte-rij opent het offertescherm (zelfde scherm als de WO), "Omzetten →" de 21c-modal;
      · "···" op een WO-rij: Openen · Kopie maken · PDF.
    Eigen klassen-namespace gl-v2-co2-* (gl-v2-projecten-changeorders.css/.js) — "co2" om botsing met de
    gl-v2-co-* namespace van ChangeOrderDetailV2 te vermijden. De 21c- en kopie-modal delen hun stijl/gedrag
    met 20c via gl-v2-projecten-convertquote.css/.js.
*@
@using System.Globalization
@using CPMCore.Models.GlV2
@{
    ViewData["Title"] = "Offertes & wijzigingen";
    ViewData["PageIcon"] = "ph ph-file-text";
    ViewData["GlV2FullHeightBody"] = true;
    ViewData["BackUrl"] = Url.Action("Detail", "Projecten", new { projectid = Model.ProjectId });

    var be = CultureInfo.GetCultureInfo("nl-BE");
    string Eur(decimal v) => (v < 0 ? "− € " : "€ ") + Math.Abs(v).ToString("N2", be);

    var kpiIcons = new[] { "ph-file-text", "ph-pencil-simple-line", "ph-paper-plane-tilt", "ph-signature", "ph-receipt", "ph-check-circle" };
    var kpis = Model.Funnel.Select((f, i) => new GlV2KpiItemVm
    {
        Label = f.Label,
        Value = f.Count.ToString(),
        IconClass = kpiIcons[Math.Min(i, kpiIcons.Length - 1)],
        Tone = f.IsHighlighted ? GlV2KpiTone.Warning : GlV2KpiTone.Primary,
    }).ToList();

    var menuVm = new GlV2ProjectMenuVm { ProjectId = Model.ProjectId, ProjectName = Model.ProjectName, ProjectSubtitle = "project · offertes & wijzigingen" };
}
@section PageStyle
{
    <link rel="stylesheet" href="~/css/gl-v2-project-inner-menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-projecten-changeorders.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-projecten-convertquote.css" asp-append-version="true" />
}
@section PageActions
{
    @if (Model.CanWrite)
    {
        <button type="button" class="gl-v2-btn gl-v2-btn-primary js-gl-v2-menu-trigger" id="gl-v2-co2-new-btn" aria-haspopup="true" aria-expanded="false" aria-controls="gl-v2-co2-new-menu">
            <i class="ph ph-plus" aria-hidden="true"></i><span>Nieuw</span><i class="ph ph-caret-down" aria-hidden="true"></i>
        </button>
    }
}
@section ProjectMenu
{
    @{ menuVm.Mode = GlV2ProjectMenuMode.Outer; }
    @await Html.PartialAsync("GlV2/_ProjectInnerMenuV2", menuVm)
}
@* De tabbar moet het letterlijke eerste kind van .gl-v2-content zijn (gl-v2-shell.css: negatieve marge
   die .gl-v2-content se padding opheft) — niet in een wrapper en niet na het Phone-menu, anders blijft er
   een gat boven. Zie Klanten/Core/DetailV2.cshtml. *@
<div class="gl-v2-tabbar" id="gl-v2-co2-tabs" role="tablist">
    <button type="button" class="gl-v2-tabbar-tab is-active" role="tab" aria-selected="true" data-type="">Alles <span class="gl-v2-tabbar-count">@Model.AllCount</span></button>
    <button type="button" class="gl-v2-tabbar-tab" role="tab" aria-selected="false" data-type="offerte">Offertes <span class="gl-v2-tabbar-count">@Model.QuoteCount</span></button>
    <button type="button" class="gl-v2-tabbar-tab" role="tab" aria-selected="false" data-type="wo">Wijzigingsopdrachten <span class="gl-v2-tabbar-count">@Model.OrderCount</span></button>
</div>

@{ menuVm.Mode = GlV2ProjectMenuMode.Phone; }
@await Html.PartialAsync("GlV2/_ProjectInnerMenuV2", menuVm)

@if (Model.CanWrite)
{
    @* "+ Nieuw" (29a) — het gedeelde contextmenu (.gl-v2-menu); positie/open/sluiten door gl-v2-shell.js. *@
    <div class="gl-v2-menu gl-v2-co2-new-menu" id="gl-v2-co2-new-menu">
        <div class="gl-v2-menu-title">NIEUWE WIJZIGINGSOPDRACHT</div>
        <a class="gl-v2-menu-item" href="@Url.Action("QuoteIntakeV2", "Projecten", new { projectid = Model.ProjectId })">
            <i class="ph ph-scan" aria-hidden="true"></i>
            <span class="gl-v2-menu-item-text">
                <span class="gl-v2-menu-item-label">Offerte inlezen</span>
                <span class="gl-v2-menu-item-sub">Foto of PDF van de leverancier → regels worden herkend, daarna offerte opmaken.</span>
            </span>
        </a>
        <a class="gl-v2-menu-item" href="@Url.Action("ChangeOrderDetailV2", "Projecten", new { projectid = Model.ProjectId, quote = true })">
            <i class="ph ph-pencil-simple-line" aria-hidden="true"></i>
            <span class="gl-v2-menu-item-text">
                <span class="gl-v2-menu-item-label">Offerte opmaken</span>
                <span class="gl-v2-menu-item-sub">Leeg beginnen: regels en prijzen zelf invullen, de klant krijgt ze per mail.</span>
            </span>
        </a>
        <a class="gl-v2-menu-item" href="@Url.Action("ChangeOrderDetailV2", "Projecten", new { projectid = Model.ProjectId })">
            <i class="ph ph-signature" aria-hidden="true"></i>
            <span class="gl-v2-menu-item-text">
                <span class="gl-v2-menu-item-label">Wijzigingsopdracht zonder offerte</span>
                <span class="gl-v2-menu-item-sub">Rechtstreeks ter ondertekening, bv. wat al mondeling afgesproken is.</span>
            </span>
        </a>
        <button type="button" class="gl-v2-menu-item js-co2-copy" data-co-id="0" @(Model.OrderCount == 0 ? "disabled" : "")>
            <i class="ph ph-copy" aria-hidden="true"></i>
            <span class="gl-v2-menu-item-text">
                <span class="gl-v2-menu-item-label">Kopie van een wijzigingsopdracht</span>
                <span class="gl-v2-menu-item-sub">Bv. dezelfde buitenkraan voor een ander lot.</span>
            </span>
        </button>
        <div class="gl-v2-menu-divider"></div>
        <a class="gl-v2-menu-item" href="@Url.Action("QuoteIntakeV2", "Projecten", new { projectid = Model.ProjectId, intent = "keep" })">
            <i class="ph ph-archive-box" aria-hidden="true"></i>
            <span class="gl-v2-menu-item-text">
                <span class="gl-v2-menu-item-label">Offerte inlezen en bewaren</span>
                <span class="gl-v2-menu-item-sub">Enkel bewaren — later opmaken en verzenden vanuit de lijst.</span>
            </span>
        </a>
    </div>
}

<div id="gl-v2-co2-root" data-project-id="@Model.ProjectId">
    @* ── KPI's (design-handoff 7a): het aantal per fase van het verloop — "Verzonden" (wacht op de klant) is de
       aandachtskaart. Gedeelde strip (GlV2/_KpiStrip), geen eigen kaartvorm. ───────────────────────────── *@
    @await Html.PartialAsync("GlV2/_KpiStrip", kpis)

    @* ── Zoekveld + Filters (optie 4f, zoals Klanten/IndexV2 en Projecten/DetailClientsV2): zoekveld over de
       volledige breedte, daarnaast de Filters-knop met tellertje die het paneel met de filters openklapt. ── *@
    <div class="gl-v2-toolbar-card gl-v2-filters-card">
        <div class="gl-v2-filters-row">
            <div class="gl-v2-field gl-v2-toolbar-search">
                <div class="gl-v2-field-box">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                    <input type="text" class="gl-v2-field-input" name="search-term" id="search-term" placeholder="Zoek op nummer, klant, leverancier…">
                    <button type="button" class="gl-v2-field-clear" id="search-term-clear" aria-label="Zoekterm wissen">&times;</button>
                </div>
            </div>
            <button type="button" class="gl-v2-filters-toggle" id="filters-toggle" aria-expanded="false" aria-controls="filters-panel">
                <i class="ph ph-funnel" aria-hidden="true"></i>
                Filters
                <span class="gl-v2-filters-toggle-count" id="filters-toggle-count" hidden>0</span>
            </button>
        </div>

        <div class="gl-v2-filters-panel" id="filters-panel" hidden>
            <div class="gl-v2-filters-sheet-header">
                <div class="gl-v2-filters-sheet-handle" aria-hidden="true"></div>
                <div class="gl-v2-filters-sheet-title-row">
                    <span class="gl-v2-filters-sheet-title">Filters</span>
                    <span class="gl-v2-filters-sheet-badge" id="filters-sheet-badge" hidden>0 actief</span>
                    <span class="gl-v2-filters-sheet-spacer"></span>
                    <button type="button" class="gl-v2-filters-clear gl-v2-filters-sheet-clear" id="filters-sheet-clear">Wissen</button>
                </div>
            </div>
            <div class="gl-v2-filters-grid">
                <div class="gl-v2-filters-field">
                    <span class="gl-v2-filters-field-label">Status</span>
                    <div class="gl-v2-select gl-v2-filters-select" id="status-select">
                        <input type="hidden" id="status-select-value" value="open" />
                        <button type="button" class="gl-v2-select-trigger" id="status-select-trigger" aria-haspopup="listbox" aria-expanded="false" aria-controls="status-select-panel">
                            <span class="gl-v2-select-trigger-label" id="status-select-label">Open (nog werk aan)</span>
                            <i class="ph ph-caret-down gl-v2-select-trigger-caret" aria-hidden="true"></i>
                        </button>
                        <div class="gl-v2-select-backdrop" id="status-select-backdrop"></div>
                        <div class="gl-v2-select-panel" id="status-select-panel" role="listbox" aria-labelledby="status-select-trigger">
                            <div class="gl-v2-select-sheet-header">
                                <span class="gl-v2-select-sheet-title">Status</span>
                                <button type="button" class="gl-v2-select-sheet-close" id="status-select-close">Sluiten</button>
                            </div>
                            <div class="gl-v2-select-options">
                                <button type="button" class="gl-v2-select-option is-selected" role="option" data-value="open" data-label="Open (nog werk aan)">
                                    <i class="ph ph-check" aria-hidden="true"></i><span>Open (nog werk aan)</span>
                                </button>
                                <button type="button" class="gl-v2-select-option" role="option" data-value="all" data-label="Alles, ook afgerond">
                                    <i class="ph ph-check" aria-hidden="true"></i><span>Alles, ook afgerond</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="gl-v2-filters-chips" id="filters-chips">
                <div class="gl-v2-filters-chip-list" id="filters-chip-list"></div>
                <button type="button" class="gl-v2-filters-clear" id="filters-clear">Wissen</button>
            </div>

            @* Enkel <768px zichtbaar — filters passen zichzelf al toe, dit is puur een "klaar"-knop om het sheet te sluiten. *@
            <button type="button" class="gl-v2-filters-show-btn" id="filters-show-btn">
                <span>Toon</span>
                <span id="filters-show-count">0</span>
                <span>resultaten</span>
            </button>
        </div>
    </div>
    @* Enkel zichtbaar <768px — #filters-panel wordt daar een bottom sheet, deze scrim erachter. *@
    <div class="gl-v2-filters-panel-backdrop" id="filters-panel-backdrop" hidden></div>

    @* ── Offertes ──────────────────────────────────────────────────────────────────────────────────── *@
    @if (Model.Quotes.Count > 0)
    {
        <div class="gl-v2-card gl-v2-co2-card" data-co2-section="offerte">
            <div class="gl-v2-card-header">
                <span class="gl-v2-card-header-icon"><i class="ph ph-scan" aria-hidden="true"></i></span>
                <h2 class="gl-v2-card-header-title">Offertes</h2>
                <span class="gl-v2-field-divider"></span>
                <span class="gl-v2-card-header-count">Aan de klant — nog geen afspraak; na akkoord omzetten naar een wijzigingsopdracht</span>
            </div>
            <div class="gl-v2-co2-table-scroll">
                <table class="gl-v2-co2-table">
                    <thead>
                        <tr>
                            <th>Nr.</th><th>Omschrijving</th><th>Eenheid · klant</th>
                            <th class="is-right">Klant excl. btw</th><th>Status</th><th>Verloop</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Quotes)
                        {
                            @await Html.PartialAsync("Partials/_ChangeOrdersRowV2", row, new ViewDataDictionary(ViewData) { { "ProjectId", Model.ProjectId }, { "CanWrite2", Model.CanWrite } })
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* ── Wijzigingsopdrachten ──────────────────────────────────────────────────────────────────────── *@
    @if (Model.Orders.Count > 0)
    {
        <div class="gl-v2-card gl-v2-co2-card" data-co2-section="wo">
            <div class="gl-v2-card-header">
                <span class="gl-v2-card-header-icon"><i class="ph ph-file-text" aria-hidden="true"></i></span>
                <h2 class="gl-v2-card-header-title">Wijzigingsopdrachten</h2>
            </div>
            <div class="gl-v2-co2-table-scroll">
                <table class="gl-v2-co2-table">
                    <thead>
                        <tr>
                            <th>Nr.</th><th>Omschrijving</th><th>Eenheid · klant</th>
                            <th class="is-right">Klant excl. btw</th><th>Status</th><th>Verloop</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Orders)
                        {
                            @await Html.PartialAsync("Partials/_ChangeOrdersRowV2", row, new ViewDataDictionary(ViewData) { { "ProjectId", Model.ProjectId }, { "CanWrite2", Model.CanWrite } })
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="7">
                                <div class="gl-v2-co2-totals">
                                    <span>Meerwerk ondertekend <b class="gl-v2-co2-tabular">@Eur(Model.SignedExtraTotal)</b></span>
                                    <span>Minwerk <b class="gl-v2-co2-tabular">@Eur(Model.SignedReductionTotal)</b></span>
                                    <span>Netto <b class="gl-v2-co2-tabular">@Eur(Model.SignedNetTotal)</b></span>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }

    @if (Model.AllCount == 0)
    {
        <div class="gl-v2-card gl-v2-co2-card">
            <div class="gl-v2-card-body">
                <div class="gl-v2-empty-state gl-v2-empty-state-inline">
                    <span class="gl-v2-empty-state-icon"><i class="ph ph-file-text" aria-hidden="true"></i></span>
                    <h2 class="gl-v2-empty-state-title">Nog geen offertes of wijzigingsopdrachten</h2>
                    <p class="gl-v2-empty-state-desc">Start met "+ Nieuw": lees een offerte van de leverancier in, maak een offerte op voor de klant of begin rechtstreeks met een wijzigingsopdracht.</p>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.CanWrite)
{
    @await Html.PartialAsync("Partials/_ConvertQuoteModalShellV2")

    @* Kopie-modal (29b "Kopie") — inhoud via AJAX (Modals/_ModalCopyChangeOrderV2). *@
    <div class="modal fade gl-v2-modal-form" id="gl-v2-cc-modal" tabindex="-1" aria-hidden="true" aria-labelledby="gl-v2-cc-title">
        <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
            <form class="modal-content" method="post" action="@Url.Action("ChangeOrderCopyV2", "Projecten")">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <div class="gl-v2-cq-header-text">
                        <h2 class="modal-title" id="gl-v2-cc-title">Kopie van een wijzigingsopdracht</h2>
                        <span class="gl-v2-cq-header-sub">Zelfde werk voor een andere eenheid</span>
                    </div>
                    <button type="button" class="gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button>
                </div>
                <div class="modal-body" id="gl-v2-cc-body"></div>
                <div class="modal-footer">
                    <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="gl-v2-btn gl-v2-btn-primary">Kopie maken en openen</button>
                </div>
            </form>
        </div>
    </div>
}

@section PageScripts
{
    <script id="gl-v2-co2-config" type="application/json">
    {
        "projectId": @Model.ProjectId,
        "convertModalUrl": "@Url.Action("ConvertQuoteModalV2", "Projecten")",
        "copyModalUrl": "@Url.Action("CopyChangeOrderModalV2", "Projecten")"
    }
    </script>
    <script src="~/js/gl-v2-project-inner-menu.js" asp-append-version="true"></script>
    <script src="~/js/gl-v2-projecten-convertquote.js" asp-append-version="true"></script>
    <script src="~/js/gl-v2-projecten-changeorders.js" asp-append-version="true"></script>
}
