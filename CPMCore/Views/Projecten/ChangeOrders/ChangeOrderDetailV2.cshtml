@model CPMCore.Models.Projecten.ChangeOrderDetailV2Vm
@*
    gl-v2 — Wijzigingsopdracht, het scherm per stap (design-handoff punt 28, 28a–28i: "zelfde scherm, wat
    verandert: melding, vergrendeling, facturatieplan, ondertekening, facturen en knoppen"). Stap → scherm
    volgens 29b: 2 Opgemaakt (28a met offerte / 28b zonder) · 3 Verzonden (28c) · 4 Ondertekend (28d wacht)
    · 5 Factureerbaar (28e) · 6 Gefactureerd (28f) · 7 Betaald (28g), plus de uitzonderingen geweigerd (28h)
    en te laat betaald (28i). Stap 1 (Offerte) is een ander scherm: QuoteIntakeV2 (20c).

    De view beslist niets: fase, pillen, stappenplan, melding, vergrendeling en statussen komen kant-en-
    klaar uit ProjectenController.BuildScreenState (Model.Phase/IsEditable/…). Bewerkbaar (concept) = het
    formulier met de rij-partials; vergrendeld = dezelfde kaarten als leesweergave. Acties buiten het
    formulier (herinneren, intrekken, opladen, versie 2, vrijgeven) zijn losse POST-formulieren onderaan,
    aangesproken via het form-attribuut van hun knop — geen geneste formulieren, geen eigen JS.
    Eigen klassen-namespace gl-v2-co-* (gl-v2-projecten-changeorderdetail.css/.js).
*@
@using System.Globalization
@using BOCore
@using CPMCore.Models.GlV2
@using CPMCore.Models.Projecten
@{
    var title = string.IsNullOrWhiteSpace(Model.Description) ? (Model.IsQuote ? "Offerte" : "Wijzigingsopdracht") : Model.Description;
    var newTitle = Model.IsQuote ? "Nieuwe offerte" : "Nieuwe wijzigingsopdracht";
    ViewData["Title"] = Model.IsNew ? newTitle : $"{Model.Number} · {title}";
    ViewData["TitleMobile"] = Model.IsNew ? newTitle : Model.Number;
    ViewData["PageIcon"] = "ph ph-file-text";
    ViewData["CoachmarkPageKey"] = "Projects.ChangeOrderDetail";
    ViewData["GlV2FullHeightBody"] = true;

    var listUrl = Url.Action("ChangeOrdersV2", "Projecten", new { projectid = Model.ProjectId });
    ViewData["BackUrl"] = listUrl;

    var be = CultureInfo.GetCultureInfo("nl-BE");
    string Eur(decimal v) => (v < 0 ? "− € " : "€ ") + Math.Abs(v).ToString("N2", be);
    string Pct(decimal? v) => (v ?? 0).ToString("0.##", be);

    var menuVm = new GlV2ProjectMenuVm { ProjectId = Model.ProjectId, ProjectName = Model.ProjectName, ProjectSubtitle = "project · offertes & wijzigingen" };

    var phase = Model.Phase;
    var editable = Model.IsEditable;
    var isSent = phase is "verzonden" or "wacht";
    var isSigned = phase is "ondertekend" or "factureerbaar" or "gefactureerd" or "betaald" or "telaat";
    // Offerte aan de klant (stap 1): zelfde scherm, per mail verzonden i.p.v. ondertekend.
    var isQuote = Model.IsQuote;
    var quoteSent = phase == "offerte-verzonden";
    var quoteConverted = phase == "offerte-omgezet";
    var convertedUrl = Model.ConvertedToChangeOrderId.HasValue ? Url.Action("ChangeOrderDetailV2", "Projecten", new { projectid = Model.ProjectId, coid = Model.ConvertedToChangeOrderId }) : null;
    var hasActiveCase = Model.ActiveSigningCase != null;
    var canSign = Model.SigningEnabled && Model.CanStartSigning;
    // Verzonden zonder lopend dossier = met de hand gezet (elektronisch ondertekenen uit, of op papier).
    var manualSent = isSent && !hasActiveCase;

    var pdfUrl = Model.IsNew ? null : Url.Action("ChangeOrderPDF", "Projecten", new { changeorderid = Model.ChangeOrderId });
    var signedPdfUrl = Model.CompletedSigningCase != null
        ? Url.Action("Download", "SigningAdmin", new { caseId = Model.CompletedSigningCase.CaseId, kind = (int)SigningDocumentKind.Final, inline = true })
        : pdfUrl;
    var invoicingUrl = Url.Action("InvoicingV2", "Projecten", new { projectid = Model.ProjectId });
    var intakeUrl = Model.IsNew ? null : Url.Action("QuoteIntakeV2", "Projecten", new { projectid = Model.ProjectId, coid = Model.ChangeOrderId });
    var openInvoiceUrl = Model.OpenInvoice != null ? Url.Action("Detail", "Invoices", new { id = Model.OpenInvoice.InvoiceId }) : null;
    var nextTerm = Model.NextInvoiceableTerm;
    var invoiceLabel = nextTerm != null ? $"{nextTerm.KindLabel} factureren" : "Factureren";
    var showInvoiceAction = phase == "factureerbaar" && Model.CanWrite;
    var waitingSigners = Model.Signers.Where(s => s.CanRemind).ToList();
    var remindLabel = waitingSigners.Count == 1 && Model.Signers.Count > 1 ? $"Herinnering naar {waitingSigners[0].Name.Split(' ')[0]}" : "Herinnering sturen";

    var noticeIcon = Model.NoticeType switch { "success" => "ph-check-circle", "warning" => "ph-warning", "danger" => "ph-x-circle", _ => "ph-info" };

    // Leesweergave: totalen server-side (bewerkbaar rekent de JS ze live na).
    var cost = Model.Rows.Sum(r => r.SupplierCost);
    var commissionTotal = Model.Rows.Sum(r => r.Sign * r.Number * r.Price * r.Commission / 100m);
    // Na schadevergoeding (28v): de klant betaalt of krijgt terug wat er ná de vergoeding overblijft; de btw rekent op dat eindbedrag.
    var excl = Model.Rows.Sum(r => r.ClientExcl);
    var vatTotal = Model.Rows.Sum(r => r.ClientExcl * r.VatPercentage / 100m);
    var damageRows = Model.Rows.Where(r => r.HasDamage).ToList();
    var damageValue = damageRows.Sum(r => r.Number * r.Price);
    var damageSum = damageRows.Sum(r => r.DamageAmount);
    var damageCredit = damageRows.Sum(r => r.SupplierCost);
    var bouwheerDamage = Model.Rows.Sum(r => r.BouwheerResult);
    // Kaart "Offerte leverancier" (28a) bovenaan: bij een offerte aan de klant altijd zodra er een
    // leveranciersofferte aan hangt; bij een WO enkel in concept zonder eigen herkomst.
    var showQuoteCard = Model.Groups.Count <= 1 && (isQuote ? Model.HasQuoteSource : (editable && Model.HasQuoteSource && !Model.SourceChangeOrderId.HasValue));

    // Actiebalk (28r): de waarschuwing hoort bij de knop Verzenden, dus in de balk i.p.v. enkel in de zijkolom.
    var noMailCount = Model.Recipients.Count(r => r.Tone == "is-rood");
    var barWarning = isQuote && (editable || quoteSent) && noMailCount > 0
        ? (noMailCount == Model.Recipients.Count ? "Klant heeft geen e-mailadres" : $"{noMailCount} van {Model.Recipients.Count} eigenaars hebben geen e-mailadres")
        : null;
    var savedParts = (Model.SavedAtText ?? "").Split(' ', 2);
    // Meer acties (⋯): Verwijderen staat altijd hier (destructief); "Omzetten" verhuist er op tablet naartoe.
    var convertInMenu = isQuote && editable;
    var hasMore = Model.CanDelete || convertInMenu;

    // Compacte stappenbalk (28r): de huidige stap en de volgende.
    var stepList = Model.Stappenplan?.Steps ?? new List<GlV2StepItemVm>();
    var stepNow = stepList.Count > 0 ? stepList[Math.Clamp(Model.Stappenplan!.Current, 0, stepList.Count - 1)] : null;
    var stepNext = stepNow != null && Model.Stappenplan!.Current + 1 < stepList.Count ? stepList[Model.Stappenplan.Current + 1] : null;
}
@section PageStyle
{
    <link rel="stylesheet" href="~/css/gl-v2-project-inner-menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-projecten-changeorderdetail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-projecten-convertquote.css" asp-append-version="true" />
}
@section PageTitleBadges
{
    <span class="gl-v2-badge @Model.StatusPillTone">@Model.StatusPillLabel.ToUpperInvariant()</span>
    @if (Model.Rows.Count > 0)
    {
        <span class="gl-v2-badge is-info gl-v2-co-hide-md">@(Model.IsMinwerk ? "MINWERK" : "MEERWERK")</span>
    }
}
@section PageActions
{
    @if (!Model.IsNew)
    {
        @if (isSigned && Model.CompletedSigningCase != null)
        {
            <a href="@signedPdfUrl" target="_blank" rel="noopener" class="gl-v2-btn gl-v2-btn-secondary gl-v2-co-pdf-btn" title="Getekende PDF" aria-label="Getekende PDF"><i class="ph ph-file-pdf" aria-hidden="true"></i><span class="gl-v2-co-pdf-label">Getekende PDF</span></a>
        }
        else if (isSigned && Model.SignedDocId.HasValue)
        {
            <a href="@Url.Action("ViewDoc", "Projecten", new { id = Model.SignedDocId })" target="_blank" rel="noopener" class="gl-v2-btn gl-v2-btn-secondary gl-v2-co-pdf-btn" title="Getekend exemplaar" aria-label="Getekend exemplaar"><i class="ph ph-file-pdf" aria-hidden="true"></i><span class="gl-v2-co-pdf-label">Getekend exemplaar</span></a>
        }
        else
        {
            <a href="@pdfUrl" target="_blank" rel="noopener" class="gl-v2-btn gl-v2-btn-secondary gl-v2-co-pdf-btn" title="@(editable ? "Voorbeeld-PDF" : "PDF")" aria-label="@(editable ? "Voorbeeld-PDF" : "PDF")"><i class="ph ph-file-pdf" aria-hidden="true"></i><span class="gl-v2-co-pdf-label">@(editable ? "Voorbeeld-PDF" : "PDF")</span></a>
        }
        @if (quoteConverted && convertedUrl != null)
        {
            <a href="@convertedUrl" class="gl-v2-btn gl-v2-btn-primary"><i class="ph ph-arrow-right" aria-hidden="true"></i><span>Open WO-@(Model.ConvertedToChangeOrderId!.Value.ToString("000"))</span></a>
        }
        else if (quoteSent && Model.CanWrite)
        {
            <button type="button" class="gl-v2-btn gl-v2-btn-primary js-co-open-convert"><i class="ph ph-arrow-right" aria-hidden="true"></i><span>Omzetten naar wijzigingsopdracht</span></button>
        }
        else if (isSent && hasActiveCase && canSign && waitingSigners.Count > 0)
        {
            <button type="submit" form="gl-v2-co-f-remind" class="gl-v2-btn gl-v2-btn-primary"><i class="ph ph-bell-ringing" aria-hidden="true"></i><span>@remindLabel</span></button>
        }
        else if (showInvoiceAction)
        {
            <a href="@invoicingUrl" class="gl-v2-btn gl-v2-btn-primary"><i class="ph ph-receipt" aria-hidden="true"></i><span>@invoiceLabel</span></a>
        }
        else if ((phase is "gefactureerd" or "telaat") && openInvoiceUrl != null)
        {
            <a href="@openInvoiceUrl" class="gl-v2-btn gl-v2-btn-primary"><i class="ph ph-receipt" aria-hidden="true"></i><span>Factuur openen</span></a>
        }
        else if (phase == "betaald")
        {
            <a href="@Url.Action("Recalculation", "Projecten", new { projectid = Model.ProjectId })" class="gl-v2-btn gl-v2-btn-primary"><i class="ph ph-calculator" aria-hidden="true"></i><span>Naar nacalculatie</span></a>
        }
        else if (phase == "geweigerd" && Model.CanWrite && !Model.ReplacedByChangeOrderId.HasValue)
        {
            <button type="button" class="gl-v2-btn gl-v2-btn-primary" data-bs-toggle="modal" data-bs-target="#gl-v2-co-version-modal"><i class="ph ph-copy" aria-hidden="true"></i><span>Versie 2 opmaken</span></button>
        }
    }
}
@section ProjectMenu
{
    @{ menuVm.Mode = GlV2ProjectMenuMode.Outer; }
    @await Html.PartialAsync("GlV2/_ProjectInnerMenuV2", menuVm)
}
@{ menuVm.Mode = GlV2ProjectMenuMode.Phone; }
@await Html.PartialAsync("GlV2/_ProjectInnerMenuV2", menuVm)

<form id="gl-v2-co-form" class="gl-v2-co-form" method="post" action="@Url.Action("ChangeOrderDetailV2Save")">
@Html.AntiForgeryToken()
<input type="hidden" name="projectId" value="@Model.ProjectId" />
<input type="hidden" name="changeOrderId" value="@Model.ChangeOrderId" />
@if (Model.ClientAccountId > 0)
{
    <input type="hidden" name="clientAccountId" value="@Model.ClientAccountId" />
}
@if (isQuote)
{
    @* Enkel van belang voor een nieuwe rij: een offerte aan de klant i.p.v. rechtstreeks een wijzigingsopdracht. *@
    <input type="hidden" name="isQuote" value="true" />
}
@if (editable)
{
    <input type="hidden" name="quoteVatPercentage" value="@(Model.QuoteVatPercentage?.ToString(CultureInfo.InvariantCulture))" />
}
<div class="gl-v2-co-scroll" id="gl-v2-co-root" data-project-id="@Model.ProjectId" data-co-id="@Model.ChangeOrderId" data-phase="@phase">

    @* ── Stappenplan (punt 27, variant lijn · sm) ─────────────────────────────────────────────────── *@
    <div class="gl-v2-card gl-v2-co-card">
        <div class="gl-v2-card-body gl-v2-co-steps">
            <span class="gl-v2-co-steps-label">@Model.StepLabel.ToUpperInvariant()</span>
            @* 28r: 7 labels zolang de kolom breed genoeg is, daaronder het balkje "Offerte · concept · volgende: Opgemaakt". *@
            <div class="gl-v2-co-steps-full">@await Html.PartialAsync("GlV2/_Steps", Model.Stappenplan)</div>
            @if (stepNow != null)
            {
                <div class="gl-v2-co-steps-compact">
                    <div class="gl-v2-co-steps-compact-line">
                        <b>@stepNow.Label</b>
                        <span>@(string.IsNullOrWhiteSpace(stepNow.Sub) ? "" : stepNow.Sub + " · ")@(stepNext != null ? "volgende: " + stepNext.Label : "laatste stap")</span>
                    </div>
                    <div class="gl-v2-co-steps-bar" aria-hidden="true">
                        @foreach (var st in stepList)
                        {
                            <span class="@(st.State is GlV2StepState.Done or GlV2StepState.Current or GlV2StepState.Wacht or GlV2StepState.Warning or GlV2StepState.Error ? "is-on" : "")"></span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="gl-v2-co-layout">
        <div class="gl-v2-co-main">
            @* ── Melding (punt 25b: uitgebreid, bovenaan het scherm) ───────────────────────────────── *@
            <div class="gl-v2-notice gl-v2-notice-expanded is-@Model.NoticeType">
                <span class="gl-v2-notice-expanded-icon"><i class="ph @noticeIcon" aria-hidden="true"></i></span>
                <div class="gl-v2-notice-body">
                    <span class="gl-v2-notice-title">@Model.NoticeTitle</span>
                    <span class="gl-v2-notice-text">@Model.NoticeText</span>
                    @if (Model.ConvertedToChangeOrderId.HasValue)
                    {
                        <div class="gl-v2-notice-actions">
                            <a class="gl-v2-notice-action" href="@convertedUrl">Open WO-@(Model.ConvertedToChangeOrderId.Value.ToString("000"))</a>
                        </div>
                    }
                    @if (Model.ReplacedByChangeOrderId.HasValue)
                    {
                        <div class="gl-v2-notice-actions">
                            <a class="gl-v2-notice-action" href="@Url.Action("ChangeOrderDetailV2", "Projecten", new { projectid = Model.ProjectId, coid = Model.ReplacedByChangeOrderId })">Open WO-@(Model.ReplacedByChangeOrderId.Value.ToString("000"))</a>
                        </div>
                    }
                </div>
            </div>

            @* ── Offerte leverancier (28a: concept met de offerte bovenaan) ────────────────────────── *@
            @if (showQuoteCard)
            {
                <div class="gl-v2-card gl-v2-co-card">
                    <div class="gl-v2-card-header">
                        <span class="gl-v2-card-header-icon"><i class="ph ph-scan" aria-hidden="true"></i></span>
                        <h2 class="gl-v2-card-header-title">Offerte leverancier</h2>
                        <span class="gl-v2-field-divider"></span>
                        <span class="gl-v2-card-header-count">Intern — de klant ziet de offerte en de kostprijs nooit</span>
                    </div>
                    <div class="gl-v2-card-body gl-v2-co-quote">
                        @if (!string.IsNullOrWhiteSpace(Model.QuoteSourceUrl))
                        {
                            <a class="gl-v2-co-quote-preview" href="@Model.QuoteSourceUrl" target="_blank" rel="noopener" title="Offerte openen">
                                @if (Model.QuoteSourceIsImage)
                                {
                                    <img src="@Model.QuoteSourceUrl" alt="Offerte van de leverancier" />
                                }
                                else
                                {
                                    <i class="ph ph-file-pdf" aria-hidden="true"></i>
                                    <span>PDF openen</span>
                                }
                            </a>
                        }
                        else
                        {
                            <div class="gl-v2-co-quote-preview is-empty">
                                <i class="ph ph-file-dashed" aria-hidden="true"></i>
                                <span>Geen bestand bewaard</span>
                            </div>
                        }
                        <div class="gl-v2-co-quote-fields">
                            <div class="gl-v2-field">
                                <span class="gl-v2-field-label">Leverancier</span>
                                <div class="gl-v2-co-readout">@(Model.SupplierName ?? "—")</div>
                            </div>
                            <div class="gl-v2-field">
                                <label class="gl-v2-field-label" for="gl-v2-co-quote-ref">Offertenummer</label>
                                <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" id="gl-v2-co-quote-ref" name="quoteSupplierReference" maxlength="100" value="@Model.QuoteSupplierReference" /></div>
                            </div>
                            <div class="gl-v2-field">
                                <span class="gl-v2-field-label">Datum</span>
                                <div class="gl-v2-co-readout">@Model.QuoteDate.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="gl-v2-field">
                                <span class="gl-v2-field-label">Geldig tot</span>
                                <div class="gl-v2-co-readout">@Model.ExpirationDate.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="gl-v2-field">
                                <span class="gl-v2-field-label">Bedrag excl. btw</span>
                                <div class="gl-v2-co-readout gl-v2-co-tabular" id="gl-v2-co-quote-cost">@Eur(cost)</div>
                            </div>
                            <div class="gl-v2-field">
                                <span class="gl-v2-field-label">Bijlage</span>
                                <div class="gl-v2-co-readout">
                                    @if (!string.IsNullOrWhiteSpace(Model.QuoteSourceUrl))
                                    {
                                        <a href="@Model.QuoteSourceUrl" target="_blank" rel="noopener" class="gl-v2-co-link">@(Model.QuoteSourceFileName ?? "offerte")</a>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </div>
                            </div>
                            <p class="gl-v2-co-quote-note">
                                Ingelezen uit @(Model.QuoteSourceIsImage ? "foto" : "de offerte") · bron van de regels hieronder ·
                                <a href="@intakeUrl" class="gl-v2-co-link">Andere offerte koppelen</a>
                            </p>
                        </div>
                    </div>
                </div>
            }

            @* ── Opdracht ──────────────────────────────────────────────────────────────────────────── *@
            <div class="gl-v2-card gl-v2-co-card">
                <div class="gl-v2-card-header">
                    <span class="gl-v2-card-header-icon"><i class="ph ph-briefcase" aria-hidden="true"></i></span>
                    <h2 class="gl-v2-card-header-title">Opdracht</h2>
                    <span class="gl-v2-field-divider"></span>
                    <span class="gl-v2-card-header-count">Voor wie en waarom — de leveranciers volgen uit de regels</span>
                    <span class="gl-v2-card-header-spacer"></span>
                    @if (Model.LockText != null)
                    {
                        <span class="gl-v2-co-lock"><i class="ph ph-lock-simple" aria-hidden="true"></i>@Model.LockText</span>
                    }
                </div>
                <div class="gl-v2-card-body gl-v2-co-form-grid is-4">
                    <div class="gl-v2-field gl-v2-co-span2">
                        @if (Model.ClientAccountId > 0 || !editable)
                        {
                            <span class="gl-v2-field-label">Klant · eenheid</span>
                            <div class="gl-v2-co-readout">@Model.ClientName@(string.IsNullOrWhiteSpace(Model.UnitName) ? "" : " · " + Model.UnitName)</div>
                        }
                        else
                        {
                            @await Html.PartialAsync("GlV2/_SelectList", new CPMCore.Models.GlV2.GlV2SelectListVm
                            {
                                Name = "clientAccountId", Id = "gl-v2-co-client", Label = "Klant · eenheid", Required = true,
                                Placeholder = "— kies een klant —", Value = "",
                                Items = Model.ClientOptions.Select(c => new CPMCore.Models.GlV2.GlV2SelectItem
                                {
                                    Value = c.Id.ToString(),
                                    Text = c.Display + (string.IsNullOrWhiteSpace(c.UnitName) ? "" : " · " + c.UnitName),
                                    Data = new Dictionary<string, string>
                                    {
                                        ["data-vat"] = c.VatPercentage.ToString(CultureInfo.InvariantCulture),
                                        ["data-vat-type"] = c.VatTypeId?.ToString() ?? "",
                                        ["data-vat-label"] = c.VatLabel ?? ""
                                    }
                                }).ToList()
                            })
                        }
                    </div>
                    <div class="gl-v2-field gl-v2-co-span2">
                        <span class="gl-v2-field-label">Leveranciers</span>
                        @* Samenvatting van de groepen bij de regels (28t): kiezen doe je per groep, hier staan ze enkel als chips. *@
                        <div class="gl-v2-co-supplier-chips" id="gl-v2-co-supplier-chips" aria-live="polite">
                            @foreach (var g in Model.Groups)
                            {
                                <span class="gl-v2-co-supplier-chip" data-key="@g.Key"><span class="gl-v2-co-chip-ini" aria-hidden="true">@g.Initials</span><span class="gl-v2-co-chip-name">@g.SupplierName</span><span class="gl-v2-co-chip-n">@g.Rows.Count @(g.Rows.Count == 1 ? "regel" : "regels")</span></span>
                            }
                            <span class="gl-v2-field-help gl-v2-co-supplier-none" @(Model.Groups.Count > 0 ? "hidden" : "")>nog geen leverancier</span>
                        </div>
                        <span class="gl-v2-field-help">volgt uit de regels — leverancier, contract en bron kies je per groep hieronder</span>
                    </div>
                    <div class="gl-v2-field">
                        @if (editable)
                        {
                            <label class="gl-v2-field-label" for="gl-v2-co-default-commission">Commissie %</label>
                            <div class="gl-v2-field-box"><input type="number" step="0.01" min="0" class="gl-v2-field-input" id="gl-v2-co-default-commission" value="@Model.DefaultCommission.ToString("0.00", CultureInfo.InvariantCulture)" /></div>
                            <span class="gl-v2-field-help">intern — geldt voor elke regel, per regel bij te sturen</span>
                        }
                        else
                        {
                            <span class="gl-v2-field-label">Commissie</span>
                            <div class="gl-v2-co-readout gl-v2-co-tabular">@Eur(commissionTotal) · intern</div>
                        }
                    </div>
                    <div class="gl-v2-field">
                        <span class="gl-v2-field-label">Btw klant</span>
                        <div class="gl-v2-co-readout gl-v2-co-locked-field" title="wijzigen in Betalingsschijven"><i class="ph ph-lock-simple" aria-hidden="true"></i><span id="gl-v2-co-vat-label">@Model.VatKlantLabel</span></div>
                        <input type="hidden" id="gl-v2-co-vat-klant" value="@Model.VatKlantPercentage.ToString(CultureInfo.InvariantCulture)" />
                    </div>
                    <div class="gl-v2-field">
                        <span class="gl-v2-field-label">Type</span>
                        <div class="gl-v2-co-readout" id="gl-v2-co-type">@(Model.IsMinwerk ? "Minwerk — zonder commissie" : "Meerwerk")</div>
                    </div>
                    @if (editable)
                    {
                        @await Html.PartialAsync("GlV2/_DateField", new GlV2DateFieldVm
                        {
                            Name = "expirationDate",
                            Id = "gl-v2-co-expires",
                            Label = "Geldig tot",
                            IsoValue = Model.ExpirationDate.ToString("yyyy-MM-dd"),
                            DisplayValue = Model.ExpirationDate.ToString("dd/MM/yyyy")
                        })
                    }
                    else
                    {
                        <div class="gl-v2-field">
                            <span class="gl-v2-field-label">Geldig tot</span>
                            <div class="gl-v2-co-readout">@Model.ExpirationDate.ToString("dd/MM/yyyy")</div>
                        </div>
                    }
                    <div class="gl-v2-field gl-v2-field-full">
                        @if (editable)
                        {
                            <label class="gl-v2-field-label" for="gl-v2-co-subject">Onderwerp</label>
                            <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" id="gl-v2-co-subject" name="subject" maxlength="150" value="@Model.Subject" /></div>
                        }
                        else
                        {
                            <span class="gl-v2-field-label">Onderwerp</span>
                            <div class="gl-v2-co-readout">@(string.IsNullOrWhiteSpace(Model.Subject) ? "—" : Model.Subject)</div>
                        }
                    </div>
                    <div class="gl-v2-field gl-v2-field-full">
                        @if (editable)
                        {
                            <label class="gl-v2-field-label" for="gl-v2-co-description">Omschrijving voor de klant</label>
                            <div class="gl-v2-field-box gl-v2-field-box-textarea gl-v2-co-textbox-sm"><textarea class="gl-v2-field-input" id="gl-v2-co-description" name="description" rows="2" maxlength="250">@Model.Description</textarea></div>
                        }
                        else
                        {
                            <span class="gl-v2-field-label">Omschrijving voor de klant</span>
                            <div class="gl-v2-co-readout is-multiline">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</div>
                        }
                    </div>
                    @if (isQuote)
                    {
                        @* Bij een offerte is er geen facturatieplan-kaart; de voorwaarden staan hier, zodat ze op de offerte-PDF komen. *@
                        <div class="gl-v2-field gl-v2-field-full">
                            @if (editable)
                            {
                                <label class="gl-v2-field-label" for="gl-v2-co-conditions">Voorwaarden op het document</label>
                                <div class="gl-v2-field-box gl-v2-field-box-textarea gl-v2-co-textbox-sm"><textarea class="gl-v2-field-input" id="gl-v2-co-conditions" name="conditionsText" rows="2" maxlength="1000">@Model.ConditionsText</textarea></div>
                                <span class="gl-v2-field-help">komt op de offerte-PDF, naast het vak "Voor akkoord"</span>
                            }
                            else
                            {
                                <span class="gl-v2-field-label">Voorwaarden op het document</span>
                                <div class="gl-v2-co-readout is-multiline">@(string.IsNullOrWhiteSpace(Model.ConditionsText) ? "—" : Model.ConditionsText)</div>
                            }
                        </div>
                    }
                </div>
            </div>

            @* ── Regels ────────────────────────────────────────────────────────────────────────────── *@
            <div class="gl-v2-card gl-v2-co-card">
                <div class="gl-v2-card-header">
                    <span class="gl-v2-card-header-icon"><i class="ph ph-list-bullets" aria-hidden="true"></i></span>
                    <h2 class="gl-v2-card-header-title">Regels per leverancier</h2>
                    <span class="gl-v2-field-divider"></span>
                    <span class="gl-v2-card-header-count">@Model.RegelsSub</span>
                    <span class="gl-v2-card-header-spacer"></span>
                    @if (Model.LockText != null)
                    {
                        <span class="gl-v2-co-lock"><i class="ph ph-lock-simple" aria-hidden="true"></i>@Model.LockText</span>
                    }
                </div>
                @* Leveranciersgroepen (28t/28u): de leverancier hoort bij een groep regels — elke groep heeft haar eigen contract, bron en
                   "via ons gefactureerd". Eén leverancier = één groep (zoals vroeger). De klant ziet enkel de groepstitels en de prijzen klant. *@
                <div class="gl-v2-card-body gl-v2-co-groups-intro">
                    <span class="gl-v2-field-help">Elke groep heeft zijn eigen leverancier, contract en bron · meer- en minwerk kunnen in één groep staan (minwerk wordt aan kostprijs verrekend, commissie 0 %) · de klant ziet enkel de titel en de prijs klant.</span>
                </div>
                <div class="gl-v2-co-groups" id="gl-v2-co-groups">
                    @for (var gi = 0; gi < Model.Groups.Count; gi++)
                    {
                        var g = Model.Groups[gi];
                        var groupViewData = new ViewDataDictionary(ViewData);
                        groupViewData["Editable"] = editable;
                        groupViewData["IsQuote"] = isQuote;
                        groupViewData["GroupIndex"] = gi;
                        groupViewData["RowStart"] = Model.Groups.Take(gi).Sum(x => x.Rows.Count);
                        groupViewData["VatKlant"] = Model.VatKlantPercentage;
                        groupViewData["VatTypes"] = Model.VatTypes;
                        groupViewData["IsLocked"] = false;
                        groupViewData["CanRemove"] = editable && Model.Groups.Count > 0;
                        groupViewData["ChangeOrderId"] = Model.ChangeOrderId;
                        groupViewData["ProjectId"] = Model.ProjectId;
                        @await Html.PartialAsync("Partials/_ChangeOrderGroupV2", g, groupViewData)
                    }
                    @if (!editable && Model.Groups.Count == 0)
                    {
                        <p class="gl-v2-co-empty gl-v2-co-groups-empty">Geen regels.</p>
                    }
                </div>
                @if (editable)
                {
                    <div class="gl-v2-card-body gl-v2-co-addsupplier" id="gl-v2-co-addsupplier">
                        @* 28u: "Leverancier toevoegen" opent onder de laatste groep meteen het zoekvak (geen modal); kiezen maakt er een groep van. *@
                        <section class="gl-v2-co-group is-picking" id="gl-v2-co-picker" @(Model.Groups.Count > 0 ? "hidden" : "")>
                            <div class="gl-v2-co-group-pickhead">
                                <span class="gl-v2-co-group-avatar is-empty" aria-hidden="true"><i class="ph ph-buildings"></i></span>
                                <div class="gl-v2-co-group-pickfield">
                                    <div class="gl-v2-field">
                                        @await Html.PartialAsync("GlV2/_GlV2Combo", new GlV2ComboVm
                                    {
                                        Name = "co_supplier_pick", Id = "gl-v2-co-supplier-pick", Placeholder = "Leverancier zoeken …", Icon = "ph-buildings",
                                        LookupUrl = Url.Action("ChangeOrderDetailV2SupplierLookup", "Projecten", new { projectId = Model.ProjectId }),
                                        MinChars = 0, Avatar = true, ClearOnSelect = true,
                                        Help = "Eerst leveranciers met een contract in dit project, dan de andere."
                                    })
                                    </div>
                                </div>
                                <button type="button" class="gl-v2-btn gl-v2-btn-text js-co-pick-none" title="Een groep zonder leverancier; je kiest hem later in de kop van de groep">Zonder leverancier</button>
                                <button type="button" class="gl-v2-btn gl-v2-btn-text js-co-cancel-pick">Annuleren</button>
                            </div>
                            <p class="gl-v2-field-help gl-v2-co-group-pickhelp">Nog geen leverancier bekend? Kies <b>Zonder leverancier</b> en vul hem later in. Staat de leverancier er niet bij? <a class="gl-v2-co-link" href="@Url.Action("Create", "Leveranciers")" target="_blank" rel="noopener">Maak hem eerst aan</a> en zoek hem daarna hier.</p>
                        </section>
                        <button type="button" class="gl-v2-co-add-supplier" id="gl-v2-co-add-group" @(Model.Groups.Count == 0 ? "hidden" : "")>
                            <i class="ph ph-plus" aria-hidden="true"></i><span>Leverancier toevoegen</span><small>nieuwe groep met eigen regels</small>
                        </button>
                    </div>
                }
                @* Afrekening van het minwerk (28v): enkel intern, enkel als er een schadevergoeding op staat. De klant ziet één minwerkregel aan het eindbedrag. *@
                <div class="gl-v2-card-body gl-v2-co-settle" id="gl-v2-co-settle" @(damageRows.Count == 0 ? "hidden" : "")>
                    <div class="gl-v2-co-settle-head"><span class="gl-v2-co-settle-title">AFREKENING VAN HET MINWERK</span><span class="gl-v2-badge is-neutral">INTERN</span></div>
                    <dl class="gl-v2-co-settle-list">
                        <div><dt>Waarde minwerk</dt><dd class="gl-v2-co-tabular" id="gl-v2-co-settle-value">@Eur(-damageValue)</dd></div>
                        <div><dt>Schadevergoeding · intern</dt><dd class="gl-v2-co-tabular" id="gl-v2-co-settle-damage">+ @Eur(damageSum)</dd></div>
                        <div class="is-strong"><dt>Klant ziet en krijgt terug</dt><dd class="gl-v2-co-tabular" id="gl-v2-co-settle-back">@Eur(-(damageValue - damageSum))</dd></div>
                        <div><dt>Leverancier crediteert · intern</dt><dd class="gl-v2-co-tabular" id="gl-v2-co-settle-credit">@Eur(damageCredit)</dd></div>
                        <div class="is-strong"><dt>Resultaat bouwheer op dit minwerk</dt><dd class="gl-v2-co-tabular" id="gl-v2-co-settle-result">@(bouwheerDamage > 0 ? "+ " : "")@Eur(bouwheerDamage)</dd></div>
                    </dl>
                </div>
                @* Totalen: één totaal voor de klant; intern de kostprijs per leverancier en de commissie samen. *@
                <div class="gl-v2-co-table-scroll gl-v2-co-rows-scroll gl-v2-co-totals-scroll">
                    <table class="gl-v2-co-table gl-v2-co-rows is-readonly gl-v2-co-totals">
                        <tfoot>
                            <tr>
                                <td colspan="7" class="is-right">Totaal excl. btw</td>
                                <td class="is-right gl-v2-co-tabular" id="gl-v2-co-sum-excl">@Eur(excl)</td>
                            </tr>
                            <tr>
                                <td colspan="7" class="is-right">Btw</td>
                                <td class="is-right gl-v2-co-tabular" id="gl-v2-co-sum-vat">@Eur(vatTotal)</td>
                            </tr>
                            <tr class="gl-v2-co-sum-total">
                                @* Netto negatief (28v)? Dan staat er "Terug te betalen aan de klant" en wordt het een creditpost in Facturatie. *@
                                <td colspan="7" class="is-right" id="gl-v2-co-sum-total-label">@(excl + vatTotal < 0 ? "Terug te betalen aan de klant" : "Te betalen door klant")</td>
                                <td class="is-right gl-v2-co-tabular" id="gl-v2-co-sum-total">@Eur(Math.Abs(excl + vatTotal))</td>
                            </tr>
                            @foreach (var g in Model.Groups)
                            {
                                <tr class="js-co-cost-line" data-key="@g.Key">
                                    <td colspan="7" class="is-right">Kostprijs <span class="js-co-cost-name">@g.SupplierName@(string.IsNullOrWhiteSpace(g.Title) ? "" : " · " + g.Title)</span> · intern</td>
                                    <td class="is-right gl-v2-co-tabular gl-v2-co-internal js-co-cost-val">@Eur(g.Cost)</td>
                                </tr>
                            }
                            @if (Model.Groups.Count == 0)
                            {
                                <tr class="js-co-cost-line">
                                    <td colspan="7" class="is-right">Kostprijs leveranciers · intern</td>
                                    <td class="is-right gl-v2-co-tabular gl-v2-co-internal" id="gl-v2-co-sum-cost">@Eur(cost)</td>
                                </tr>
                            }
                            <tr id="gl-v2-co-commission-line">
                                <td colspan="7" class="is-right">Commissie · intern</td>
                                <td class="is-right gl-v2-co-tabular gl-v2-co-internal" id="gl-v2-co-sum-commission">@Eur(commissionTotal)</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                @if (editable && Model.HasRowsNeedingReview)
                {
                    <div class="gl-v2-card-body gl-v2-co-card-notice">
                        <div class="gl-v2-notice gl-v2-notice-compact is-warning">
                            <i class="ph ph-warning" aria-hidden="true"></i>
                            <span>Minstens één regel staat op "controleer" — klik de vlag aan zodra de regel klopt; verzenden kan pas daarna.</span>
                        </div>
                    </div>
                }
            </div>

            @* ── Bijlagen (offerte aan de klant: plan, fiche, … — gaan mee met de offertemail) ────────── *@
            @if (isQuote)
            {
                var canEditAttachments = editable && Model.CanWrite && !Model.IsNew;
                <div class="gl-v2-card gl-v2-co-card" id="gl-v2-co-attachments">
                    <div class="gl-v2-card-header">
                        <span class="gl-v2-card-header-icon"><i class="ph ph-paperclip" aria-hidden="true"></i></span>
                        <h2 class="gl-v2-card-header-title">Bijlagen</h2>
                        <span class="gl-v2-field-divider"></span>
                        <span class="gl-v2-card-header-count">Plan, fiche, … — gaan mee met de offertemail naar de klant</span>
                    </div>
                    <div class="gl-v2-card-body gl-v2-co-attach">
                        <ul class="gl-v2-co-attach-list" id="gl-v2-co-attach-list">
                            @foreach (var a in Model.Attachments)
                            {
                                <li class="gl-v2-co-attach-item" data-id="@a.Id">
                                    <i class="ph ph-file" aria-hidden="true"></i>
                                    @if (!string.IsNullOrWhiteSpace(a.Url))
                                    {
                                        <a class="gl-v2-co-link gl-v2-co-attach-name" href="@a.Url" target="_blank" rel="noopener">@a.FileName</a>
                                    }
                                    else
                                    {
                                        <span class="gl-v2-co-attach-name">@a.FileName</span>
                                    }
                                    <span class="gl-v2-co-attach-size">@a.SizeText</span>
                                    @if (canEditAttachments)
                                    {
                                        <button type="button" class="gl-v2-co-row-delete js-co-attach-delete" title="Bijlage verwijderen" aria-label="Bijlage @a.FileName verwijderen"><i class="ph ph-trash" aria-hidden="true"></i></button>
                                    }
                                </li>
                            }
                        </ul>
                        <p class="gl-v2-field-help gl-v2-co-attach-empty" id="gl-v2-co-attach-empty" @(Model.Attachments.Count > 0 ? "hidden" : "")>Geen bijlagen.</p>
                        @if (canEditAttachments)
                        {
                            <label class="gl-v2-co-dashed-btn" for="gl-v2-co-attach-file"><i class="ph ph-plus" aria-hidden="true"></i>Bijlage toevoegen</label>
                            <input type="file" id="gl-v2-co-attach-file" hidden multiple />
                            <span class="gl-v2-field-help" id="gl-v2-co-attach-status" role="status"></span>
                        }
                        else if (editable && Model.IsNew)
                        {
                            <p class="gl-v2-field-help">Bijlagen toevoegen kan zodra de offerte opgeslagen is.</p>
                        }
                    </div>
                </div>
            }

            @* ── Facturatieplan ────────────────────────────────────────────────────────────────────── *@
            @* Factureren alle leveranciers zelf, dan is er niets door ons te factureren en dus geen facturatieplan: de kaart is verborgen. *@
            @if (!isQuote)
            {
            <div class="gl-v2-card gl-v2-co-card" id="gl-v2-co-plan-card" @(Model.Groups.Count > 0 && Model.Groups.All(g => !g.InvoicedByUs) ? "hidden" : "")>
                <div class="gl-v2-card-header">
                    <span class="gl-v2-card-header-icon"><i class="ph ph-calendar-check" aria-hidden="true"></i></span>
                    <h2 class="gl-v2-card-header-title">Facturatieplan</h2>
                    <span class="gl-v2-field-divider"></span>
                    <span class="gl-v2-card-header-count">@Model.PlanSub</span>
                    <span class="gl-v2-card-header-spacer"></span>
                    @if (Model.LockText != null)
                    {
                        <span class="gl-v2-co-lock"><i class="ph ph-lock-simple" aria-hidden="true"></i>@Model.LockText</span>
                    }
                </div>
                @if (editable)
                {
                    <div class="gl-v2-card-body">
                        <div class="gl-v2-co-presets" id="gl-v2-co-presets" role="group" aria-label="Snel kiezen">
                            <span class="gl-v2-co-presets-label">SNEL KIEZEN</span>
                            <button type="button" class="gl-v2-co-preset @(Model.FacturatieplanPreset == "laatste-schijf" ? "is-active" : "")" data-preset="laatste-schijf">Alles bij laatste schijf</button>
                            <button type="button" class="gl-v2-co-preset @(Model.FacturatieplanPreset == "voorschot-saldo" ? "is-active" : "")" data-preset="voorschot-saldo">Voorschot + saldo</button>
                            <button type="button" class="gl-v2-co-preset @(Model.FacturatieplanPreset == "na-ondertekening" ? "is-active" : "")" data-preset="na-ondertekening">Volledig na ondertekening</button>
                            <button type="button" class="gl-v2-co-preset @(Model.FacturatieplanPreset == "eigen" ? "is-active" : "")" data-preset="eigen">Eigen verdeling</button>
                        </div>
                        <div class="gl-v2-co-table-scroll gl-v2-co-table-inset">
                            <table class="gl-v2-co-table gl-v2-co-terms-table" id="gl-v2-co-terms-table">
                                <thead>
                                    <tr>
                                        <th>Termijn</th>
                                        <th class="is-right">%</th>
                                        <th class="is-right">Excl. btw</th>
                                        <th>Wanneer factureerbaar</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="gl-v2-co-terms-body">
                                    @for (var i = 0; i < Model.Terms.Count; i++)
                                    {
                                        @await Html.PartialAsync("Partials/_ChangeOrderTermRowV2", Model.Terms[i], new ViewDataDictionary(ViewData) { { "Index", i }, { "Stages", Model.Stages }, { "IsLocked", false } })
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="gl-v2-co-terms-foot">
                            <button type="button" class="gl-v2-co-add-term" id="gl-v2-co-add-term"><i class="ph ph-plus" aria-hidden="true"></i>Tussentijdse termijn</button>
                            <span class="gl-v2-card-header-spacer"></span>
                            <span class="gl-v2-co-terms-total">
                                <span id="gl-v2-co-terms-total-pct">0 %</span>
                                <span class="gl-v2-badge" id="gl-v2-co-terms-total-badge">controleer</span>
                            </span>
                        </div>
                        <div class="gl-v2-field gl-v2-field-full">
                            <label class="gl-v2-field-label" for="gl-v2-co-conditions">Voorwaarden op het document</label>
                            <div class="gl-v2-field-box gl-v2-field-box-textarea gl-v2-co-textbox-sm"><textarea class="gl-v2-field-input" id="gl-v2-co-conditions" name="conditionsText" rows="2" maxlength="1000">@Model.ConditionsText</textarea></div>
                            <span class="gl-v2-field-help">komt op de PDF die de klant tekent · na verzenden ligt het plan vast</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="gl-v2-co-table-scroll">
                        <table class="gl-v2-co-table gl-v2-co-terms-table is-readonly">
                            <thead>
                                <tr>
                                    <th>Termijn</th>
                                    <th class="is-right">%</th>
                                    <th class="is-right">Excl. btw</th>
                                    <th>Wanneer factureerbaar</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model.Terms)
                                {
                                    <tr>
                                        <td>
                                            <span class="gl-v2-co-term-kind-label">@t.KindLabel</span>
                                            @if (t.InvoiceId.HasValue)
                                            {
                                                <a class="gl-v2-co-term-invoice" href="@Url.Action("Detail", "Invoices", new { id = t.InvoiceId })">@t.InvoiceNumber</a>
                                            }
                                        </td>
                                        <td class="is-right gl-v2-co-tabular" data-label="Percentage">@(t.Percentage.HasValue ? Pct(t.Percentage) + " %" : "—")</td>
                                        <td class="is-right gl-v2-co-tabular" data-label="Excl. btw">@Eur(t.AmountExVat)</td>
                                        <td class="is-wide" data-label="Wanneer factureerbaar">@t.TriggerLabel</td>
                                        <td class="is-wide" data-label="Status">
                                            <span class="gl-v2-badge @t.StatusTone">@t.StatusLabel.ToUpperInvariant()</span>
                                            @if (isSigned && Model.CanWrite && t.TriggerType == 3 && !t.IsTriggered && !t.IsInvoiced)
                                            {
                                                <button type="submit" form="gl-v2-co-f-release" name="termId" value="@t.Id" class="gl-v2-co-inline-action">Vrijgeven</button>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (Model.Terms.Count == 0)
                                {
                                    <tr><td colspan="5" class="gl-v2-co-empty">Geen facturatieplan — het volledige bedrag wordt in één keer gefactureerd.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.ConditionsText))
                    {
                        <div class="gl-v2-card-body gl-v2-co-conditions">
                            <span class="gl-v2-field-label">Voorwaarden op het document</span>
                            <p>@Model.ConditionsText</p>
                        </div>
                    }
                }
            </div>
            }
        </div>

        <div class="gl-v2-co-side">
            @* ── Ondertekening ─────────────────────────────────────────────────────────────────────── *@
            @if (!isQuote)
            {
            <div class="gl-v2-card gl-v2-co-card">
                <div class="gl-v2-card-header">
                    <span class="gl-v2-card-header-icon"><i class="ph ph-signature" aria-hidden="true"></i></span>
                    <h2 class="gl-v2-card-header-title">Ondertekening</h2>
                </div>
                <div class="gl-v2-co-sign-head @Model.SigningHeadTone">@Model.SigningHeadText</div>
                <div class="gl-v2-card-body gl-v2-co-sign">
                    @foreach (var s in Model.Signers)
                    {
                        <div class="gl-v2-co-signer">
                            <span class="gl-v2-co-signer-avatar">@s.Initials<span class="gl-v2-co-signer-dot @s.Tone" aria-hidden="true"></span></span>
                            <span class="gl-v2-stack is-tight gl-v2-co-signer-text">
                                <span class="gl-v2-co-signer-name">@s.Name</span>
                                @if (!string.IsNullOrWhiteSpace(s.StatusText))
                                {
                                    <span class="gl-v2-co-signer-status @s.Tone">@s.StatusText</span>
                                }
                            </span>
                            @if (s.CanRemind && canSign)
                            {
                                <button type="submit" form="gl-v2-co-f-remind" name="partyId" value="@s.PartyId" class="gl-v2-icon-btn" title="Herinnering sturen naar @s.Name" aria-label="Herinnering sturen naar @s.Name"><i class="ph ph-bell-ringing" aria-hidden="true"></i></button>
                            }
                        </div>
                    }
                    @if (Model.Signers.Count == 0 && Model.ClientAccountId <= 0)
                    {
                        <p class="gl-v2-field-help">Kies eerst een klant · eenheid — de eigenaars tekenen.</p>
                    }
                    @if (Model.SigningMeta.Count > 0)
                    {
                        <dl class="gl-v2-co-meta">
                            @foreach (var m in Model.SigningMeta)
                            {
                                <div><dt>@m.Key</dt><dd>@m.Value</dd></div>
                            }
                        </dl>
                    }
                    @if (!Model.SigningEnabled && editable)
                    {
                        <p class="gl-v2-field-help">Elektronisch ondertekenen staat uit: verzenden kan enkel als PDF die je zelf bezorgt.</p>
                    }
                    @if (editable && !isQuote && !Model.IsNew && !hasActiveCase && Model.CanWrite)
                    {
                        @* Buiten de digitale ondertekening: de klant tekende op papier of per mail — zonder te verzenden registreren, met het getekende exemplaar erbij. *@
                        <button type="button" class="gl-v2-btn gl-v2-btn-secondary gl-v2-co-side-btn" data-bs-toggle="modal" data-bs-target="#gl-v2-co-regsigned-modal"><i class="ph ph-signature" aria-hidden="true"></i><span>Reeds ondertekend registreren</span></button>
                    }
                    @if (isSent && hasActiveCase && canSign)
                    {
                        <label class="gl-v2-btn gl-v2-btn-secondary gl-v2-co-side-btn" for="gl-v2-co-signed-file"><i class="ph ph-upload-simple" aria-hidden="true"></i><span>Getekende versie opladen</span></label>
                    }
                    @if (manualSent && Model.CanWrite)
                    {
                        <button type="submit" form="gl-v2-co-f-step" name="step" value="signed" class="gl-v2-btn gl-v2-btn-primary gl-v2-co-side-btn"><i class="ph ph-check" aria-hidden="true"></i><span>Akkoord ontvangen</span></button>
                        <button type="submit" form="gl-v2-co-f-step" name="step" value="concept" class="gl-v2-btn gl-v2-btn-text gl-v2-co-side-btn">Terug naar concept</button>
                    }
                    @if (isSigned && Model.CompletedSigningCase != null)
                    {
                        <a class="gl-v2-btn gl-v2-btn-secondary gl-v2-co-side-btn" href="@signedPdfUrl" target="_blank" rel="noopener"><i class="ph ph-download-simple" aria-hidden="true"></i><span>Getekende PDF downloaden</span></a>
                    }
                    @if (isSigned && Model.CompletedSigningCase == null && Model.SignedDocId.HasValue)
                    {
                        <a class="gl-v2-btn gl-v2-btn-secondary gl-v2-co-side-btn" href="@Url.Action("ViewDoc", "Projecten", new { id = Model.SignedDocId })" target="_blank" rel="noopener"><i class="ph ph-file-pdf" aria-hidden="true"></i><span>Getekend exemplaar bekijken</span></a>
                    }
                    @if (isSigned && Model.CompletedSigningCase == null && !Model.SignedDocId.HasValue && Model.CanWrite)
                    {
                        @* Akkoord geregistreerd zonder bestand: het getekende exemplaar kan achteraf nog toegevoegd worden. *@
                        <form method="post" enctype="multipart/form-data" action="@Url.Action("ChangeOrderDetailV2AttachSigned")" class="gl-v2-co-side-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="projectId" value="@Model.ProjectId" />
                            <input type="hidden" name="changeOrderId" value="@Model.ChangeOrderId" />
                            <input type="file" name="file" id="gl-v2-co-attach-signed-file" accept="application/pdf,image/*" hidden onchange="this.form.submit()" />
                            <label class="gl-v2-btn gl-v2-btn-secondary gl-v2-co-side-btn" for="gl-v2-co-attach-signed-file"><i class="ph ph-upload-simple" aria-hidden="true"></i><span>Getekend exemplaar toevoegen</span></label>
                        </form>
                    }
                    @if (Model.SigningCaseId.HasValue && !editable && Model.SigningEnabled)
                    {
                        <a class="gl-v2-co-link gl-v2-co-side-link" href="@Url.Action("Dossier", "SigningAdmin", new { id = Model.SigningCaseId })">Ondertekendossier en audit trail →</a>
                    }
                </div>
            </div>

            }
            @if (isQuote)
            {
                @* ── Verzending (offerte aan de klant: per mail, zonder handtekening) ─────────────────── *@
                <div class="gl-v2-card gl-v2-co-card">
                    <div class="gl-v2-card-header">
                        <span class="gl-v2-card-header-icon"><i class="ph ph-paper-plane-tilt" aria-hidden="true"></i></span>
                        <h2 class="gl-v2-card-header-title">Verzending</h2>
                    </div>
                    <div class="gl-v2-co-sign-head @Model.SigningHeadTone">@Model.SigningHeadText</div>
                    <div class="gl-v2-card-body gl-v2-co-sign">
                        @foreach (var r in Model.Recipients)
                        {
                            <div class="gl-v2-co-signer">
                                <span class="gl-v2-co-signer-avatar">@r.Initials<span class="gl-v2-co-signer-dot @r.Tone" aria-hidden="true"></span></span>
                                <span class="gl-v2-stack is-tight gl-v2-co-signer-text">
                                    <span class="gl-v2-co-signer-name">@r.Name</span>
                                    <span class="gl-v2-co-signer-status @(r.Tone == "is-rood" ? "is-rood" : "")">@r.StatusText</span>
                                </span>
                            </div>
                        }
                        @if (Model.Recipients.Count == 0)
                        {
                            <p class="gl-v2-field-help">Kies eerst een klant · eenheid — de eigenaars krijgen de offerte.</p>
                        }
                        @if (Model.SigningMeta.Count > 0)
                        {
                            <dl class="gl-v2-co-meta">
                                @foreach (var m in Model.SigningMeta)
                                {
                                    <div><dt>@m.Key</dt><dd>@m.Value</dd></div>
                                }
                            </dl>
                        }
                        @if (editable)
                        {
                            <p class="gl-v2-field-help">De offerte gaat als PDF per mail naar de eigenaars; je kiest de ontvangers bij het verzenden. Een handtekening is niet nodig — die volgt op de wijzigingsopdracht.</p>
                        }
                    </div>
                </div>
            }

            @* ── Facturen (vanaf ondertekend) ──────────────────────────────────────────────────────── *@
            @if (isSigned)
            {
                <div class="gl-v2-card gl-v2-co-card">
                    <div class="gl-v2-card-header">
                        <span class="gl-v2-card-header-icon"><i class="ph ph-receipt" aria-hidden="true"></i></span>
                        <h2 class="gl-v2-card-header-title">Facturen</h2>
                    </div>
                    <div class="gl-v2-card-body gl-v2-co-invoices">
                        @foreach (var inv in Model.Invoices)
                        {
                            <a class="gl-v2-co-invoice" href="@Url.Action("Detail", "Invoices", new { id = inv.InvoiceId })">
                                <span class="gl-v2-co-invoice-text">
                                    <span class="gl-v2-co-invoice-nr">@inv.Number</span>
                                    <span class="gl-v2-co-invoice-desc">@inv.Description</span>
                                </span>
                                <span class="gl-v2-co-invoice-side">
                                    <span class="gl-v2-co-tabular">@Eur(inv.Amount)</span>
                                    <span class="gl-v2-badge @inv.StatusTone">@inv.StatusLabel.ToUpperInvariant()</span>
                                </span>
                            </a>
                        }
                        @foreach (var t in Model.Terms.Where(t => t.IsTriggered && !t.IsInvoiced))
                        {
                            <a class="gl-v2-co-invoice" href="@invoicingUrl">
                                <span class="gl-v2-co-invoice-text">
                                    <span class="gl-v2-co-invoice-nr">—</span>
                                    <span class="gl-v2-co-invoice-desc">@t.KindLabel @(t.Percentage.HasValue ? Pct(t.Percentage) + " %" : "") · klaar</span>
                                </span>
                                <span class="gl-v2-co-invoice-side">
                                    <span class="gl-v2-co-tabular">@Eur(t.AmountExVat)</span>
                                    <span class="gl-v2-badge is-attention">NOG TE MAKEN</span>
                                </span>
                            </a>
                        }
                        @if (Model.Invoices.Count == 0 && !Model.Terms.Any(t => t.IsTriggered && !t.IsInvoiced))
                        {
                            <p class="gl-v2-field-help">@(Model.InvoiceableByBouwheer ? "Nog geen facturen — er staat nog geen termijn klaar." : "De onderaannemer factureert dit werk zelf.")</p>
                        }
                    </div>
                </div>
            }

            @* ── Bron (28a toont de offerte al bovenaan, dan valt deze kaart weg) ──────────────────── *@
            @if (!showQuoteCard)
            {
                <div class="gl-v2-card gl-v2-co-card">
                    <div class="gl-v2-card-header">
                        <span class="gl-v2-card-header-icon"><i class="ph ph-file-text" aria-hidden="true"></i></span>
                        <h2 class="gl-v2-card-header-title">Bron</h2>
                    </div>
                    <div class="gl-v2-card-body gl-v2-co-source">
                        @if (Model.SourceChangeOrderId.HasValue)
                        {
                            <div class="gl-v2-co-source-item">
                                <span class="gl-v2-co-source-kind">@(Model.SourceKind == 2 ? "VORIGE VERSIE" : Model.SourceKind == 3 ? "OFFERTE AAN DE KLANT" : "KOPIE VAN")</span>
                                <span>@Model.SourceChangeOrderLabel</span>
                                <a class="gl-v2-co-link" href="@Url.Action("ChangeOrderDetailV2", "Projecten", new { projectid = Model.ProjectId, coid = Model.SourceChangeOrderId })">Open @(Model.SourceKind == 2 ? "vorige versie" : Model.SourceKind == 3 ? "de offerte" : "oorspronkelijke WO") →</a>
                            </div>
                        }
                        @if (Model.Groups.Count > 1)
                        {
                            @* Bronnen per leverancier (28t): elke groep heeft haar eigen leveranciersofferte. *@
                            foreach (var g in Model.Groups)
                            {
                                <div class="gl-v2-co-source-item">
                                    <span class="gl-v2-co-source-kind">OFFERTE @g.SupplierName.ToUpperInvariant()</span>
                                    @if (g.HasQuoteSource)
                                    {
                                        <span>@string.Join(" · ", new[] { g.QuoteSupplierReference, Eur(g.Cost) }.Where(x => !string.IsNullOrWhiteSpace(x)))</span>
                                        @if (!string.IsNullOrWhiteSpace(g.QuoteSourceUrl))
                                        {
                                            <a class="gl-v2-co-link" href="@g.QuoteSourceUrl" target="_blank" rel="noopener">Open offerte →</a>
                                        }
                                    }
                                    else
                                    {
                                        <span>nog geen offerte gekoppeld</span>
                                    }
                                </div>
                            }
                        }
                        else if (Model.HasQuoteSource)
                        {
                            <div class="gl-v2-co-source-item">
                                <span class="gl-v2-co-source-kind">OFFERTE LEVERANCIER</span>
                                <span>@string.Join(" · ", new[] { Model.QuoteSupplierReference, Model.SupplierName, Eur(Model.CostTotal) }.Where(x => !string.IsNullOrWhiteSpace(x)))</span>
                                @if (!string.IsNullOrWhiteSpace(Model.QuoteSourceUrl))
                                {
                                    <a class="gl-v2-co-link" href="@Model.QuoteSourceUrl" target="_blank" rel="noopener">Open offerte →</a>
                                }
                            </div>
                        }
                        @if (isQuote && Model.ConvertedToChangeOrderId.HasValue)
                        {
                            <div class="gl-v2-co-source-item">
                                <span class="gl-v2-co-source-kind">WIJZIGINGSOPDRACHT</span>
                                <span>WO-@(Model.ConvertedToChangeOrderId.Value.ToString("000"))</span>
                                <a class="gl-v2-co-link" href="@convertedUrl">Open de wijzigingsopdracht →</a>
                            </div>
                        }
                        @if (!Model.HasQuoteSource && !Model.SourceChangeOrderId.HasValue && !Model.ConvertedToChangeOrderId.HasValue)
                        {
                            <p class="gl-v2-field-help">Geen offerte gekoppeld.</p>
                        }
                        @if (editable && !Model.HasQuoteSource)
                        {
                            if (Model.IsNew)
                            {
                                <p class="gl-v2-field-help">Een offerte koppelen of inlezen kan zodra de wijzigingsopdracht opgeslagen is.</p>
                            }
                            else
                            {
                                <a class="gl-v2-co-dashed-btn" href="@intakeUrl"><i class="ph ph-plus" aria-hidden="true"></i>Offerte koppelen of inlezen</a>
                            }
                        }
                    </div>
                </div>
            }

            @* ── Historiek ─────────────────────────────────────────────────────────────────────────── *@
            <div class="gl-v2-card gl-v2-co-card">
                <div class="gl-v2-card-header">
                    <span class="gl-v2-card-header-icon"><i class="ph ph-clock-counter-clockwise" aria-hidden="true"></i></span>
                    <h2 class="gl-v2-card-header-title">Historiek</h2>
                </div>
                <div class="gl-v2-card-body gl-v2-co-history">
                    @if (Model.History.Count == 0)
                    {
                        <p class="gl-v2-field-help">Nog geen geschiedenis.</p>
                    }
                    else
                    {
                        @foreach (var h in Model.History)
                        {
                            <div class="gl-v2-co-history-item">
                                <span class="gl-v2-co-history-date">@(h.When?.ToString("dd/MM/yyyy") ?? "")</span>
                                <span>@h.Label</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Voetbalk: context links, knoppen rechts — per stap andere (28a–28i) ──────────────────────────── *@
@* 28r: de balk blijft op één lijn; de uitlegzin valt eerst weg (laptop), dan de datum en de waarschuwingstekst, dan de lange knoppen (zie CSS). *@
<div class="gl-v2-form-actionbar gl-v2-co-actionbar">
    <span class="gl-v2-form-actionbar-status gl-v2-co-status">
        @if (!string.IsNullOrEmpty(Model.SavedAtText))
        {
            <span class="gl-v2-co-saved"><i class="ph ph-check-circle" aria-hidden="true"></i><b>Opgeslagen</b><span class="gl-v2-co-saved-date"> op @savedParts[0]</span>@(savedParts.Length > 1 ? " " + savedParts[1] : "")</span>
        }
        @if (barWarning != null)
        {
            <span class="gl-v2-co-barwarn" title="@barWarning"><i class="ph ph-warning" aria-hidden="true"></i><span>@barWarning</span></span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.FooterText))
        {
            <span class="gl-v2-co-hint">@Model.FooterText</span>
        }
    </span>
    <span class="gl-v2-form-actionbar-spacer"></span>
    <div class="gl-v2-form-actionbar-actions">
        @if (isQuote)
        {
            @if (editable)
            {
                <a class="gl-v2-btn gl-v2-btn-text gl-v2-co-cancel" href="@listUrl">Annuleren</a>
                <button type="submit" class="gl-v2-btn gl-v2-btn-secondary gl-v2-co-bar-convert" id="gl-v2-co-convert" name="afterSave" value="convert">Omzetten naar wijzigingsopdracht</button>
                <button type="submit" class="gl-v2-btn gl-v2-btn-secondary" id="gl-v2-co-save">Opslaan</button>
                <button type="submit" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-co-send" name="afterSave" value="send">
                    <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i><span class="gl-v2-co-lg">Verzenden per mail</span><span class="gl-v2-co-sm">Verzenden</span>
                </button>
            }
            else if (quoteSent && Model.CanWrite)
            {
                <a class="gl-v2-btn gl-v2-btn-text" href="@listUrl">Sluiten</a>
                <button type="submit" form="gl-v2-co-f-step" name="step" value="concept" class="gl-v2-btn gl-v2-btn-secondary">Aanpassen</button>
                <button type="button" class="gl-v2-btn gl-v2-btn-secondary js-co-open-send">Opnieuw mailen</button>
                <button type="button" class="gl-v2-btn gl-v2-btn-primary js-co-open-convert"><i class="ph ph-arrow-right" aria-hidden="true"></i><span>Omzetten naar wijzigingsopdracht</span></button>
            }
            else
            {
                <a class="gl-v2-btn gl-v2-btn-secondary" href="@listUrl">Sluiten</a>
                @if (convertedUrl != null)
                {
                    <a class="gl-v2-btn gl-v2-btn-primary" href="@convertedUrl"><i class="ph ph-arrow-right" aria-hidden="true"></i><span>Open WO-@(Model.ConvertedToChangeOrderId!.Value.ToString("000"))</span></a>
                }
            }
        }
        else if (editable)
        {
            <a class="gl-v2-btn gl-v2-btn-text gl-v2-co-cancel" href="@listUrl">Annuleren</a>
            <button type="submit" class="gl-v2-btn gl-v2-btn-secondary" id="gl-v2-co-save">Opslaan</button>
            <button type="submit" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-co-send" name="afterSave" value="send">
                <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i><span class="gl-v2-co-lg">@(phase == "concept" ? "Verzenden naar klant" : "Opnieuw verzenden")</span><span class="gl-v2-co-sm">@(phase == "concept" ? "Verzenden" : "Opnieuw")</span>
            </button>
        }
        else
        {
            @if (isSent && hasActiveCase && canSign)
            {
                <button type="button" class="gl-v2-btn gl-v2-btn-danger" data-bs-toggle="modal" data-bs-target="#gl-v2-co-withdraw-modal">Intrekken</button>
            }
            @if (isSent && Model.CanWrite)
            {
                <button type="button" class="gl-v2-btn gl-v2-btn-secondary" data-bs-toggle="modal" data-bs-target="#gl-v2-co-version-modal">Versie 2 maken</button>
            }
            @if (phase == "geweigerd" && Model.CanWrite && !Model.ReplacedByChangeOrderId.HasValue)
            {
                <button type="button" class="gl-v2-btn gl-v2-btn-secondary" data-bs-toggle="modal" data-bs-target="#gl-v2-co-version-modal">Versie 2 opmaken</button>
            }
            @if ((phase is "gefactureerd" or "telaat") && openInvoiceUrl != null)
            {
                <a class="gl-v2-btn gl-v2-btn-secondary" href="@openInvoiceUrl">Factuur openen</a>
            }
            @if (showInvoiceAction)
            {
                <a class="gl-v2-btn gl-v2-btn-text" href="@listUrl">Sluiten</a>
                <a class="gl-v2-btn gl-v2-btn-primary" href="@invoicingUrl"><i class="ph ph-receipt" aria-hidden="true"></i><span>@invoiceLabel</span></a>
            }
            else
            {
                <a class="gl-v2-btn gl-v2-btn-primary" href="@listUrl">Sluiten</a>
            }
        }
        @if (hasMore)
        {
            <button type="button" class="gl-v2-icon-btn gl-v2-co-more js-gl-v2-menu-trigger @(Model.CanDelete ? "" : "gl-v2-co-more-narrow")" aria-haspopup="true" aria-expanded="false" aria-controls="gl-v2-co-more-menu" aria-label="Meer acties" title="Meer acties"><i class="ph ph-dots-three" aria-hidden="true"></i></button>
            <div class="gl-v2-menu" id="gl-v2-co-more-menu">
                @if (convertInMenu)
                {
                    <button type="submit" class="gl-v2-menu-item gl-v2-co-menu-convert" name="afterSave" value="convert"><i class="ph ph-arrow-right" aria-hidden="true"></i><span class="gl-v2-menu-item-text"><span class="gl-v2-menu-item-label">Omzetten naar wijzigingsopdracht</span></span></button>
                }
                @if (Model.CanDelete)
                {
                    <button type="button" class="gl-v2-menu-item is-danger" data-bs-toggle="modal" data-bs-target="#gl-v2-co-delete-modal"><i class="ph ph-trash" aria-hidden="true"></i><span class="gl-v2-menu-item-text"><span class="gl-v2-menu-item-label">Verwijderen</span></span></button>
                }
            </div>
        }
    </div>
</div>
</form>

@* ── Losse actie-formulieren (buiten het hoofdformulier; knoppen verwijzen ernaar met form="…") ────── *@
@if (!Model.IsNew)
{
    <form id="gl-v2-co-f-remind" method="post" action="@Url.Action("ChangeOrderDetailV2Remind")" hidden>
        @Html.AntiForgeryToken()
        <input type="hidden" name="projectId" value="@Model.ProjectId" />
        <input type="hidden" name="changeOrderId" value="@Model.ChangeOrderId" />
    </form>
    <form id="gl-v2-co-f-step" method="post" action="@Url.Action("ChangeOrderDetailV2SetStep")" hidden>
        @Html.AntiForgeryToken()
        <input type="hidden" name="projectId" value="@Model.ProjectId" />
        <input type="hidden" name="changeOrderId" value="@Model.ChangeOrderId" />
    </form>
    <form id="gl-v2-co-f-release" method="post" action="@Url.Action("ChangeOrderDetailV2ReleaseTerm")" hidden>
        @Html.AntiForgeryToken()
        <input type="hidden" name="projectId" value="@Model.ProjectId" />
        <input type="hidden" name="changeOrderId" value="@Model.ChangeOrderId" />
    </form>
    <form id="gl-v2-co-f-upload" method="post" enctype="multipart/form-data" action="@Url.Action("ChangeOrderDetailV2UploadSigned")" hidden>
        @Html.AntiForgeryToken()
        <input type="hidden" name="projectId" value="@Model.ProjectId" />
        <input type="hidden" name="changeOrderId" value="@Model.ChangeOrderId" />
        <input type="file" id="gl-v2-co-signed-file" name="file" accept="application/pdf" />
    </form>

    @* 21d — "Verzenden ter ondertekening": opent na "Verzenden naar klant" (eerst opslaan, dan deze modal
       op de bewaarde toestand) en na 21c "Aanmaken en verzenden". Inhoud via AJAX
       (Modals/_ModalSendChangeOrderV2). *@
    @if (editable || quoteSent)
    {
        <div class="modal fade gl-v2-modal-form gl-v2-co-send-modal" id="gl-v2-co-send-modal" tabindex="-1" aria-hidden="true" aria-labelledby="gl-v2-co-send-title">
            <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
                <form class="modal-content" id="gl-v2-co-send-form" method="post" action="@Url.Action(isQuote ? "ChangeOrderQuoteSendV2" : "ChangeOrderSendV2")">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <span class="gl-v2-co-send-icon"><i class="ph ph-paper-plane-tilt" aria-hidden="true"></i></span>
                        <div class="gl-v2-stack gl-v2-co-send-header-text">
                            <h2 class="modal-title" id="gl-v2-co-send-title">@Model.Number @(isQuote ? "per mail verzenden" : "verzenden ter ondertekening")</h2>
                            <span class="gl-v2-co-send-header-sub" id="gl-v2-co-send-subtitle"></span>
                        </div>
                        <button type="button" class="gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button>
                    </div>
                    <div class="modal-body" id="gl-v2-co-send-body"></div>
                    <div class="modal-footer">
                        <span class="gl-v2-co-send-footnote">@(isQuote ? "De klant ontvangt de offerte als PDF. Na akkoord zet je ze om naar een wijzigingsopdracht ter ondertekening." : "Na verzenden liggen bedragen en facturatiemoment vast; wijzigen maakt een nieuwe versie.")</span>
                        <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
                        <button type="submit" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-co-send-submit" disabled>
                            <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i><span id="gl-v2-co-send-submit-label">Verzenden</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (editable && !isQuote && !Model.IsNew && !hasActiveCase && Model.CanWrite)
    {
        <div class="modal fade gl-v2-modal-form" id="gl-v2-co-regsigned-modal" tabindex="-1" aria-hidden="true" aria-labelledby="gl-v2-co-regsigned-title">
            <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
                <form class="modal-content" method="post" enctype="multipart/form-data" action="@Url.Action("ChangeOrderDetailV2RegisterSigned")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@Model.ProjectId" />
                    <input type="hidden" name="changeOrderId" value="@Model.ChangeOrderId" />
                    <div class="modal-header">
                        <span class="gl-v2-co-send-icon"><i class="ph ph-signature" aria-hidden="true"></i></span>
                        <div class="gl-v2-stack gl-v2-co-send-header-text">
                            <h2 class="modal-title" id="gl-v2-co-regsigned-title">@Model.Number als ondertekend registreren</h2>
                            <span class="gl-v2-co-send-header-sub">zonder te verzenden — de klant tekende buiten de digitale ondertekening</span>
                        </div>
                        <button type="button" class="gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button>
                    </div>
                    <div class="modal-body">
                        @await Html.PartialAsync("GlV2/_DateField", new GlV2DateFieldVm { Name = "signedOn", Id = "gl-v2-co-regsigned-date", Label = "Ondertekend op", Required = true, IsoValue = DateTime.Today.ToString("yyyy-MM-dd"), DisplayValue = DateTime.Today.ToString("dd/MM/yyyy") })
                        @await Html.PartialAsync("GlV2/_Dropzone", new GlV2DropzoneVm { Id = "gl-v2-co-regsigned-file", Name = "file", Label = "Getekend exemplaar (PDF of foto)", Accept = "application/pdf,image/*", Layout = "bar", Mode = "row", Sub = "optioneel — wordt bewaard bij de documenten van het project" })
                        <p class="gl-v2-field-help">Bedragen en facturatieplan liggen daarna vast; de wijzigingsopdracht staat op ondertekend en de termijnen worden factureerbaar volgens het plan.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
                        <button type="submit" class="gl-v2-btn gl-v2-btn-primary"><i class="ph ph-check" aria-hidden="true"></i><span>Registreren als ondertekend</span></button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (Model.CanDelete)
    {
        @await Html.PartialAsync("GlV2/_ModalConfirm", new GlV2ModalConfirmVm
        {
            Id = "gl-v2-co-delete-modal",
            Tone = GlV2ModalTone.Danger,
            IconClass = "ph-trash",
            Title = (isQuote ? "Offerte" : "Wijzigingsopdracht") + " verwijderen?",
            Description = Model.Number + " wordt definitief verwijderd. Dit kan niet ongedaan gemaakt worden.",
            ConfirmLabel = "Verwijderen",
            FormAction = Url.Action("ChangeOrderDeleteV2") ?? "",
            HiddenFields = new Dictionary<string, string> { { "projectId", Model.ProjectId.ToString() }, { "changeOrderId", Model.ChangeOrderId.ToString() } },
        })
    }

    @if (isQuote && Model.CanWrite && !quoteConverted)
    {
        @* 21c — Omzetten naar wijzigingsopdracht: opent na "Omzetten naar wijzigingsopdracht" (eerst opslaan,
           dan deze modal op de bewaarde toestand). Inhoud via AJAX (Modals/_ModalConvertQuoteV2). *@
        @await Html.PartialAsync("Partials/_ConvertQuoteModalShellV2")
    }

    @await Html.PartialAsync("GlV2/_ModalConfirm", new GlV2ModalConfirmVm
    {
        Id = "gl-v2-co-withdraw-modal",
        Tone = GlV2ModalTone.Danger,
        IconClass = "ph-arrow-u-up-left",
        Title = "Ondertekening intrekken?",
        Description = "De links van de klant werken dan niet meer en handtekeningen die er al staan vervallen. De wijzigingsopdracht wordt weer een concept dat je kan aanpassen en opnieuw verzenden.",
        ConfirmLabel = "Intrekken",
        FormAction = Url.Action("ChangeOrderDetailV2Withdraw") ?? "",
        HiddenFields = new Dictionary<string, string> { { "projectId", Model.ProjectId.ToString() }, { "changeOrderId", Model.ChangeOrderId.ToString() } },
    })
    @await Html.PartialAsync("GlV2/_ModalConfirm", new GlV2ModalConfirmVm
    {
        Id = "gl-v2-co-version-modal",
        Tone = GlV2ModalTone.Warning,
        IconClass = "ph-copy",
        Title = "Nieuwe versie maken?",
        Description = (hasActiveCase ? "De lopende ondertekening wordt ingetrokken; handtekeningen die er al staan vervallen. " : "") + "Alles wordt overgenomen in een nieuw concept dat je kan aanpassen en opnieuw verzenden. Deze versie blijft bewaard als bron.",
        ConfirmLabel = "Versie maken",
        FormAction = Url.Action("ChangeOrderCopyV2") ?? "",
        HiddenFields = new Dictionary<string, string> { { "projectId", Model.ProjectId.ToString() }, { "changeOrderId", Model.ChangeOrderId.ToString() }, { "asVersion", "true" } },
    })
}

@section PageScripts
{
    <script id="gl-v2-co-config" type="application/json">
    {
        "projectId": @Model.ProjectId,
        "changeOrderId": @Model.ChangeOrderId,
        "clientAccountId": @Model.ClientAccountId,
        "editable": @(editable ? "true" : "false"),
        "isQuote": @(isQuote ? "true" : "false"),
        "openSend": @(Model.OpenSendModal ? "true" : "false"),
        "openConvert": @(Model.OpenConvertModal ? "true" : "false"),
        "sendModalUrl": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action(isQuote ? "SendQuoteModalV2" : "SendChangeOrderModalV2", "Projecten", new { projectId = Model.ProjectId, changeOrderId = Model.ChangeOrderId }))),
        "convertModalUrl": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("ConvertQuoteModalV2", "Projecten", new { projectId = Model.ProjectId, changeOrderId = Model.ChangeOrderId }))),
        "vatKlant": @Model.VatKlantPercentage.ToString(CultureInfo.InvariantCulture),
        "vatKlantTypeId": @(Model.VatKlantTypeId?.ToString() ?? "null"),
        "addRowUrl": "@Url.Action("ChangeOrderDetailV2AddRow")",
        "addGroupUrl": "@Url.Action("ChangeOrderDetailV2AddGroup")",
        "supplierContractsUrl": "@Url.Action("ChangeOrderDetailV2SupplierContracts")",
        "defaultDamage": @Model.DefaultDamagePercentage.ToString(CultureInfo.InvariantCulture),
        "attachAddUrl": "@Url.Action("ChangeOrderAttachmentAddV2")",
        "attachDeleteUrl": "@Url.Action("ChangeOrderAttachmentDeleteV2")",
        "addTermUrl": "@Url.Action("ChangeOrderDetailV2AddTerm")",
        "stagesUrl": "@Url.Action("ChangeOrderDetailV2Stages")",
        "clientAccountId": @Model.ClientAccountId,
        "listUrl": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(listUrl))
    }
    </script>
    <script src="~/js/currency.js"></script>
    <script src="~/js/gl-v2-project-inner-menu.js" asp-append-version="true"></script>
    <script src="~/js/gl-v2-projecten-convertquote.js" asp-append-version="true"></script>
    <script src="~/js/gl-v2-projecten-changeorderdetail.js" asp-append-version="true"></script>
}
