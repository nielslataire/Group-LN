@model CPMCore.Models.Planning.PlanningIndexVm
@*
    gl-v2 — Planning van een project (design-handoff "CRM Planning", 59a–59c): takenlijst en Gantt naast elkaar, duur in werkdagen,
    voorgangers (FS/SS/FF/SF met wachttijd), alles schuift automatisch mee. Eerste ronde (nov. 2026): lijst + Gantt, taken en fases
    toevoegen/bewerken/verwijderen/verplaatsen, ongedaan maken, kritiek pad, basisplanning, waarschuwingen. Nog niet: slepen van
    balken, rechtsklikmenu, importeren, exporteren, werkkalender-paneel, sjablonen.

    Alles wordt client-side getekend uit één JSON-staat (#gl-v2-pl-config); elke wijziging gaat als commando naar
    ProjectPlanningController.Commando en komt volledig herberekend terug (ServiceCore/Planning). Eigen klassen-namespace gl-v2-pl-*
    (gl-v2-projecten-planning.css/.js); de Gantt is het projectwijde component gl-v2/gantt.css + gl-v2-gantt.js.
*@
@using CPMCore.Models.GlV2
@{
    ViewData["Title"] = "Planning";
    ViewData["PageIcon"] = "ph ph-chart-bar-horizontal";
    ViewData["GlV2FullHeightBody"] = true;
    ViewData["BackUrl"] = Url.Action("Detail", "Projecten", new { projectid = Model.ProjectId });
    // Gsm (64p): kicker "Project · planning" boven de projectnaam; de snelactiebalk heeft zijn eigen Meer-blad
    ViewData["TitleMobile"] = Model.ProjectName;
    ViewData["TopbarKicker"] = "Project · planning";
    ViewData["BadgesDesktopOnly"] = true;
    ViewData["QuickActionsMoreTitle"] = "planning";

    var menuVm = new GlV2ProjectMenuVm { ProjectId = Model.ProjectId, ProjectName = Model.ProjectName, ProjectSubtitle = "project · planning" };
    var menuPhoneVm = new GlV2ProjectMenuVm { ProjectId = Model.ProjectId, ProjectName = Model.ProjectName, ProjectSubtitle = "project · planning", Mode = GlV2ProjectMenuMode.Phone };

    GlV2SelectListVm Select(string id, string name, string label, string? help = null) => new()
    {
        Id = id, Name = name, Label = label, Value = "", Items = new List<GlV2SelectItem>(), Placeholder = "Kies …", Help = help
    };
    GlV2ComboVm Uitvoerder(string id, string name, string help) => new()
    {
        Id = id, Name = name, Placeholder = "Geen", Help = help, Icon = "ph-hard-hat", OptionsJson = "[]", MinChars = 0, ListLabel = "AANNEMERS IN DIT PROJECT"
    };
    GlV2DateFieldVm Date(string id, string name, string label) => new() { Id = id, Name = name, Label = label };
}
@section PageStyle
{
    <link rel="stylesheet" href="~/css/gl-v2-project-inner-menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2/gantt.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-projecten-planning.css" asp-append-version="true" />
}
@section PageActions
{
    @if (Model.CanWrite)
    {
        <button type="button" class="gl-v2-btn gl-v2-btn-secondary js-pl-add-fase">
            <i class="ph ph-stack-plus" aria-hidden="true"></i><span>Fase</span>
        </button>
        <button type="button" class="gl-v2-btn gl-v2-btn-primary js-pl-add-taak">
            <i class="ph ph-plus" aria-hidden="true"></i><span>Taak toevoegen</span>
        </button>
    }
}
@section MobileQuickActions
{
    @* 65j "Planning" (64p/64r): Vandaag · Verletdag · Taak (hoofdactie) · Meer. Fase, Per aannemer, Basis, Importeren, Sjablonen en Instellen staan in Meer. *@
    <button type="button" class="gl-v2-mobile-quickaction js-pl-q-vandaag" data-qa-key="vandaag"><i class="ph ph-clock" aria-hidden="true"></i>Vandaag</button>
    <a href="@Url.Action("Weather", "Projecten")" class="gl-v2-mobile-quickaction" data-qa-key="verlet"><i class="ph ph-cloud-rain" aria-hidden="true"></i>Verletdag</a>
    @if (Model.CanWrite)
    {
        <button type="button" class="gl-v2-mobile-quickaction gl-v2-mobile-quickaction-primary js-pl-add-taak" data-qa-key="taak">
            <i class="ph ph-plus" aria-hidden="true"></i>Taak
        </button>
        <button type="button" class="gl-v2-mobile-quickaction gl-v2-mobile-quickaction-extra js-pl-add-fase" data-subtitle="een groep taken, bv. Dakwerken">
            <i class="ph ph-stack-plus" aria-hidden="true"></i>Fase toevoegen
        </button>
    }
    <button type="button" class="gl-v2-mobile-quickaction gl-v2-mobile-quickaction-extra js-pl-q-aann" data-subtitle="planning gefilterd per leverancier">
        <i class="ph ph-hard-hat" aria-hidden="true"></i>Per aannemer
    </button>
    @if (Model.CanWrite)
    {
        <button type="button" class="gl-v2-mobile-quickaction gl-v2-mobile-quickaction-extra js-pl-q-basis" data-subtitle="om later te vergelijken met de werkelijkheid">
            <i class="ph ph-bookmark-simple" aria-hidden="true"></i>Basis vastleggen
        </button>
        <button type="button" class="gl-v2-mobile-quickaction gl-v2-mobile-quickaction-extra js-pl-q-import" data-subtitle="MS Project (XML)">
            <i class="ph ph-upload-simple" aria-hidden="true"></i>Importeren
        </button>
        <button type="button" class="gl-v2-mobile-quickaction gl-v2-mobile-quickaction-extra js-pl-q-sj" data-subtitle="sjabloon gebruiken of deze planning bewaren">
            <i class="ph ph-copy" aria-hidden="true"></i>Sjablonen
        </button>
        <button type="button" class="gl-v2-mobile-quickaction gl-v2-mobile-quickaction-extra js-pl-q-instel" data-subtitle="naam, woningen en startdatum, of verwijderen">
            <i class="ph ph-gear-six" aria-hidden="true"></i>Instellen
        </button>
        <a href="@Url.Action("Edit", "Projecten", new { projectid = Model.ProjectId })" class="gl-v2-mobile-quickaction gl-v2-mobile-quickaction-extra" data-subtitle="weerstation, deadline en andere projectgegevens">
            <i class="ph ph-sliders-horizontal" aria-hidden="true"></i>Projectgegevens
        </a>
    }
}
@section ProjectMenu
{
    @{ menuVm.Mode = GlV2ProjectMenuMode.Outer; }
    @await Html.PartialAsync("GlV2/_ProjectInnerMenuV2", menuVm)
}

@await Html.PartialAsync("GlV2/_ProjectInnerMenuV2", menuPhoneVm)

<div id="gl-v2-pl-root" class="gl-v2-pl" data-project-id="@Model.ProjectId" data-can-write="@(Model.CanWrite ? "1" : "0")" data-can-delete="@(Model.CanDelete ? "1" : "0")" data-can-link="@(Model.CanLinkTraject ? "1" : "0")" data-can-sjabloon="@(Model.CanSaveTemplate ? "1" : "0")" data-can-sjabloon-delete="@(Model.CanDeleteTemplate ? "1" : "0")">

    @* Blokkerende fout (4g): opvallend, gecentreerd, blijft staan tot je ze sluit of een volgende actie lukt *@
    <div class="gl-v2-inline-error gl-v2-pl-fout" id="gl-v2-pl-fout" role="alert" hidden>
        <span class="gl-v2-inline-error-icon"><i class="ph ph-warning-circle" aria-hidden="true"></i></span>
        <div class="gl-v2-inline-error-text">
            <div class="gl-v2-inline-error-title" id="gl-v2-pl-fout-titel">Dat kan niet</div>
            <div class="gl-v2-inline-error-desc" id="gl-v2-pl-fout-tekst"></div>
        </div>
        <button type="button" class="gl-v2-inline-error-close" id="gl-v2-pl-fout-close" aria-label="Melding sluiten"><i class="ph ph-x" aria-hidden="true"></i></button>
    </div>

    @* Tabs: de plannings van het project (hoofdplanning en één per bouwdeel) *@
    <div class="gl-v2-pl-tabs" id="gl-v2-pl-tabs" role="tablist" aria-label="Plannings van dit project" hidden></div>

    @* Kop: kerngegevens van de planning *@
    <div class="gl-v2-card gl-v2-pl-kop" id="gl-v2-pl-kop" aria-live="polite"></div>

    @* Meldingen (cyclus, deadline, geen voorganger …) *@
    <div id="gl-v2-pl-notices" class="gl-v2-pl-notices"></div>

    @* Wat er na een wijziging is verschoven, met Ongedaan maken *@
    <div class="gl-v2-pl-changebar" id="gl-v2-pl-changebar" role="status" hidden>
        <i class="ph ph-arrows-left-right" aria-hidden="true"></i>
        <span class="gl-v2-pl-changebar-text" id="gl-v2-pl-changebar-text"></span>
        <button type="button" class="gl-v2-pl-changebar-undo" id="gl-v2-pl-undo">Ongedaan maken</button>
        <button type="button" class="gl-v2-icon-btn gl-v2-pl-changebar-close" id="gl-v2-pl-changebar-close" aria-label="Melding sluiten"><i class="ph ph-x" aria-hidden="true"></i></button>
    </div>

    @* Lege staat *@
    <div class="gl-v2-card gl-v2-pl-empty" id="gl-v2-pl-empty" hidden>
        <div class="gl-v2-empty-state gl-v2-empty-state-inline">
            <span class="gl-v2-empty-state-icon"><i class="ph ph-chart-bar-horizontal" aria-hidden="true"></i></span>
            <h2 class="gl-v2-empty-state-title" id="gl-v2-pl-empty-title" data-project="@Model.ProjectName">Nog geen planning voor @Model.ProjectName</h2>
            <p class="gl-v2-empty-state-desc">Bouw de planning op met fases en taken, met een duur in werkdagen en voorgangers. Alles schuift vanzelf mee.</p>
            @if (Model.CanWrite)
            {
                <div class="gl-v2-pl-empty-actions">
                    <button type="button" class="gl-v2-btn gl-v2-btn-primary js-pl-add-taak"><i class="ph ph-plus" aria-hidden="true"></i>Eerste taak toevoegen</button>
                    <button type="button" class="gl-v2-btn gl-v2-btn-secondary js-pl-add-fase"><i class="ph ph-stack-plus" aria-hidden="true"></i>Eerst een fase maken</button>
                </div>
            }
        </div>
    </div>

    @* Gsm (64p–64r): Week · Lijst · Tijdlijn, gevuld door gl-v2-projecten-planning.js; op desktop en tablet onzichtbaar *@
    <div class="gl-v2-pl-m gl-v2-m-only" id="gl-v2-pl-m" hidden></div>

    @* Lijst en Gantt *@
    @* Per aannemer: alle taken van één uitvoerder uit alle plannings (enkel lezen, gevuld door JS) *@
    <div class="gl-v2-pl-aann" id="gl-v2-pl-aann" hidden></div>

    <div class="gl-v2-card gl-v2-pl-card" id="gl-v2-pl-card" hidden>
        <div class="gl-v2-pl-toolbar">
            <div class="gl-v2-segmented is-sm gl-v2-pl-zoom" id="gl-v2-pl-zoom" role="group" aria-label="Tijdschaal">
                <button type="button" data-scale="dag" aria-pressed="false">Dag</button>
                <button type="button" data-scale="week" class="is-active" aria-pressed="true">Week</button>
                <button type="button" data-scale="maand" aria-pressed="false">Maand</button>
                <button type="button" data-scale="alles" aria-pressed="false" title="De hele planning in één beeld">Alles</button>
            </div>
            <button type="button" class="gl-v2-pl-toggle" id="gl-v2-pl-toggle-kritiek" aria-pressed="false"><i class="ph ph-lightning" aria-hidden="true"></i>Kritiek pad</button>
            <button type="button" class="gl-v2-pl-toggle" id="gl-v2-pl-toggle-basis" aria-pressed="false" hidden><i class="ph ph-line-segment" aria-hidden="true"></i>Basisplanning</button>
            <button type="button" class="gl-v2-pl-toggle" id="gl-v2-pl-toggle-verlet" aria-pressed="true" title="Verletdagen tellen als niet-werkdag. Uitzetten = simulatie zonder verlet."><i class="ph ph-cloud-rain" aria-hidden="true"></i>Verlet</button>
            <span class="gl-v2-pl-toolbar-spacer"></span>
            <button type="button" class="gl-v2-btn gl-v2-btn-text gl-v2-pl-small" id="gl-v2-pl-start" title="Naar het begin van de planning"><i class="ph ph-arrow-line-left" aria-hidden="true"></i>Begin</button>
            <button type="button" class="gl-v2-btn gl-v2-btn-text gl-v2-pl-small" id="gl-v2-pl-today"><i class="ph ph-crosshair" aria-hidden="true"></i>Vandaag</button>
            <button type="button" class="gl-v2-btn gl-v2-btn-text gl-v2-pl-small" id="gl-v2-pl-collapse"><i class="ph ph-arrows-in-line-vertical" aria-hidden="true"></i><span>Fases inklappen</span></button>
            <button type="button" class="gl-v2-btn gl-v2-btn-text gl-v2-pl-small" id="gl-v2-pl-fs" aria-pressed="false" title="Planning schermvullend tonen"><i class="ph ph-arrows-out" aria-hidden="true"></i><span>Volledig scherm</span></button>
            @if (Model.CanWrite)
            {
                <button type="button" class="gl-v2-btn gl-v2-btn-text gl-v2-pl-small" id="gl-v2-pl-basis-set" title="Legt de huidige planning vast als basisplanning"><i class="ph ph-bookmark-simple" aria-hidden="true"></i><span>Basis vastleggen</span></button>
            }
        </div>
        <div class="gl-v2-pl-scroll" id="gl-v2-pl-scroll" tabindex="0" role="region" aria-label="Planning: pijltjestoetsen om te scrollen, sleep de grafiek om te verschuiven">
            <div class="gl-v2-pl-list" id="gl-v2-pl-list" role="table" aria-label="Taken en fases"></div>
            <div class="gl-v2-pl-chart" id="gl-v2-pl-gantt"></div>
        </div>
        <div class="gl-v2-pl-legend" aria-hidden="true">
            <span><i class="lg lg-task"></i>taak</span>
            <span><i class="lg lg-phase"></i>fase</span>
            <span><i class="lg lg-ms"></i>mijlpaal</span>
            <span><i class="lg lg-done"></i>afgevinkt</span>
            <span><i class="lg lg-late"></i>voorbij einde, niet afgevinkt</span>
            <span><i class="lg lg-now"></i>loopt vandaag</span>
            <span><i class="lg lg-coin"></i>schijf (goud: verschuldigd)</span>
            <span><i class="lg lg-today"></i>vandaag</span>
            <span><i class="lg lg-crit"></i>kritiek</span>
            <span><i class="lg lg-shift"></i>verschoven</span>
            <span><i class="lg lg-base"></i>basis</span>
            <span><i class="lg lg-nw"></i>weekend</span>
            <span><i class="lg lg-verlof"></i>feestdag of verlof</span>
            <span><i class="lg lg-verlet"></i>verlet</span>
        </div>
    </div>

    @* Zijpaneel: taak of fase toevoegen/bewerken *@
    <div class="gl-v2-pl-backdrop" id="gl-v2-pl-backdrop" hidden></div>
    <aside class="gl-v2-pl-panel" id="gl-v2-pl-panel" aria-labelledby="gl-v2-pl-panel-title" aria-hidden="true" hidden>
        <header class="gl-v2-pl-panel-head">
            <div class="gl-v2-stack">
                <span class="gl-v2-pl-panel-kicker" id="gl-v2-pl-panel-kicker"></span>
                <h2 class="gl-v2-pl-panel-title" id="gl-v2-pl-panel-title"></h2>
                <span class="gl-v2-pl-panel-sub" id="gl-v2-pl-panel-sub"></span>
            </div>
            <button type="button" class="gl-v2-icon-btn" id="gl-v2-pl-panel-close" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button>
        </header>
        <form class="gl-v2-pl-panel-body" id="gl-v2-pl-form" novalidate autocomplete="off">
            <div class="gl-v2-notice gl-v2-notice-compact is-danger" id="gl-v2-pl-form-error" role="alert" hidden>
                <i class="ph ph-x-circle" aria-hidden="true"></i><span></span>
            </div>

            <div class="gl-v2-pl-info" id="gl-v2-pl-info" hidden></div>

            <div class="gl-v2-field">
                <label class="gl-v2-field-label" for="gl-v2-pl-f-naam">Naam <span class="gl-v2-field-req" aria-hidden="true">*</span></label>
                <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" id="gl-v2-pl-f-naam" maxlength="300" /></div>
            </div>

            @* Taak *@
            <div class="gl-v2-pl-only-taak">
                <div class="gl-v2-pl-row2">
                    <div class="gl-v2-field">
                        <label class="gl-v2-field-label" for="gl-v2-pl-f-duur">Duur</label>
                        <div class="gl-v2-field-box">
                            <input type="number" class="gl-v2-field-input is-tabular" id="gl-v2-pl-f-duur" min="0" max="2000" step="1" inputmode="numeric" />
                            <span class="gl-v2-field-suffix">werkdagen</span>
                        </div>
                        <span class="gl-v2-field-help">0 = mijlpaal</span>
                    </div>
                    @await Html.PartialAsync("GlV2/_SelectList", Select("gl-v2-pl-f-fase", "fase", "Fase"))
                </div>
                <div class="gl-v2-field" id="gl-v2-pl-wrap-voor">
                    <label class="gl-v2-field-label" for="gl-v2-pl-f-voor">Voorgangers</label>
                    <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" id="gl-v2-pl-f-voor" placeholder="bv. 5.1  of  5.1SS  of  5.1FS+3d" /></div>
                    <span class="gl-v2-field-help">Het nummer van de taak, daarna het soort (FS, SS, FF, SF) en een wachttijd in werkdagen, ook negatief. Meerdere voorgangers scheid je met ;<span id="gl-v2-pl-voor-help-hoofd" hidden> Een taak uit de hoofdplanning schrijf je met H: ervoor, bv. H:3.1.</span><span id="gl-v2-pl-voor-help-andere" hidden> Een taak uit een andere planning schrijf je met de naam van die planning ervoor, bv. <span id="gl-v2-pl-voor-help-voorbeeld">Woning 1:3.2</span>.</span></span>
                    <div>
                        <button type="button" class="gl-v2-btn gl-v2-btn-secondary" id="gl-v2-pl-kies-open" aria-expanded="false" aria-controls="gl-v2-pl-kies"><i class="ph ph-list-magnifying-glass" aria-hidden="true"></i>Kies uit de lijst</button>
                    </div>
                    <div class="gl-v2-pl-kies" id="gl-v2-pl-kies" hidden>
                        <div class="gl-v2-field-box"><input type="search" class="gl-v2-field-input" id="gl-v2-pl-kies-zoek" placeholder="Zoek op naam of nummer" autocomplete="off" aria-label="Zoek een taak of fase" /></div>
                        <div class="gl-v2-pl-kies-lijst" id="gl-v2-pl-kies-lijst" role="listbox" aria-multiselectable="true" aria-label="Taken en fases van alle plannings"></div>
                    </div>
                </div>
                <div class="gl-v2-field" id="gl-v2-pl-wrap-estafette" hidden>
                    <span class="gl-v2-field-label">Estafette</span>
                    <span class="gl-v2-field-help">Laat deze taak wachten tot dezelfde taak in een andere woning of een ander gebouw klaar is. Kies de planning in de lijst, ze komt in het veld Voorgangers te staan. Je kiest dit per taak, en zo vaak je wilt.</span>
                    <div class="gl-v2-pl-chips" id="gl-v2-pl-estafette-chips"></div>
                    @await Html.PartialAsync("GlV2/_SelectList", Select("gl-v2-pl-estafette-kies", "estafette", ""))
                </div>
                <div id="gl-v2-pl-wrap-plaats">
                    @await Html.PartialAsync("GlV2/_SelectList", Select("gl-v2-pl-f-plaats", "plaats", "Plaats in de fase"))
                </div>
                <div class="gl-v2-pl-row2">
                    @await Html.PartialAsync("GlV2/_SelectList", Select("gl-v2-pl-f-bep", "beperking", "Beperking"))
                    @await Html.PartialAsync("GlV2/_DateField", Date("gl-v2-pl-f-bepdatum", "beperkingDatum", "Datum van de beperking"))
                </div>
                @await Html.PartialAsync("GlV2/_DateField", Date("gl-v2-pl-f-deadline", "deadline", "Deadline (optioneel)"))
                <div class="gl-v2-pl-row2" id="gl-v2-pl-wrap-werkelijk">
                    @await Html.PartialAsync("GlV2/_DateField", Date("gl-v2-pl-f-wstart", "werkelijkStart", "Werkelijke start"))
                    @await Html.PartialAsync("GlV2/_DateField", Date("gl-v2-pl-f-weinde", "werkelijkEinde", "Werkelijk einde"))
                </div>
                <div class="gl-v2-pl-row2" id="gl-v2-pl-wrap-voortgang">
                    <div class="gl-v2-field">
                        <label class="gl-v2-field-label" for="gl-v2-pl-f-pct">Voortgang</label>
                        <div class="gl-v2-field-box">
                            <input type="number" class="gl-v2-field-input is-tabular" id="gl-v2-pl-f-pct" min="0" max="100" step="5" inputmode="numeric" />
                            <span class="gl-v2-field-suffix">%</span>
                        </div>
                    </div>
                    @await Html.PartialAsync("GlV2/_SelectList", Select("gl-v2-pl-f-wie", "verantwoordelijke", "Verantwoordelijke"))
                </div>
                <div id="gl-v2-pl-wrap-uitv">
                    @await Html.PartialAsync("GlV2/_UitvoerderCombo", Uitvoerder("gl-v2-pl-f-uitv", "uitvoerder", "Optioneel. Kies de aannemer zodra die is aangesteld. Leeg = de uitvoerder van de fase."))
                </div>
                <div class="gl-v2-field" id="gl-v2-pl-wrap-schijf" hidden>
                    <span class="gl-v2-field-label" id="gl-v2-pl-wrap-schijf-label">Koppeling met schijven</span>
                    <div class="gl-v2-field-box"><input type="search" class="gl-v2-field-input" id="gl-v2-pl-wrap-schijf-zoek" placeholder="Zoek een schijf…" autocomplete="off" aria-label="Zoek een schijf" /></div>
                    <div class="gl-v2-pl-eenheden" id="gl-v2-pl-wrap-schijf-lijst" role="group" aria-labelledby="gl-v2-pl-wrap-schijf-label"></div>
                    <span class="gl-v2-field-help">Optioneel. Vink één of meer schijven aan. Is deze taak klaar, dan krijg je de vraag of de schijf bereikt is voor de eenheden van deze planning.</span>
                </div>
                <div id="gl-v2-pl-wrap-traj" hidden>
                    @await Html.PartialAsync("GlV2/_SelectList", Select("gl-v2-pl-f-traj", "trajectmijlpaal", "Koppeling met trajectmijlpaal", "Optioneel. De mijlpaal in het Traject volgt dan het einde van deze taak en staat op bereikt zodra de taak klaar is."))
                </div>
                <div class="gl-v2-field">
                    <label class="gl-v2-field-label" for="gl-v2-pl-f-notitie">Notitie</label>
                    <div class="gl-v2-field-box gl-v2-field-box-textarea"><textarea class="gl-v2-field-input" id="gl-v2-pl-f-notitie" rows="3" maxlength="1000"></textarea></div>
                </div>
            </div>

            @* Planning (hoofdplanning of planning voor een of meer eenheden) *@
            <div class="gl-v2-pl-only-planning" hidden>
                <div class="gl-v2-field" id="gl-v2-pl-wrap-bouwdeel">
                    <span class="gl-v2-field-label" id="gl-v2-pl-f-eenheden-label">Woningen en gebouwen</span>
                    <div class="gl-v2-pl-eenheden" id="gl-v2-pl-f-eenheden" role="group" aria-labelledby="gl-v2-pl-f-eenheden-label"></div>
                    <span class="gl-v2-field-help" id="gl-v2-pl-f-eenheden-help">Optioneel. Kies de woningen of het gebouw waar deze planning voor geldt. Een planning mag meerdere eenheden bundelen; een eenheid zit in hoogstens één planning, ook als de betalingsgroep meerdere eenheden heeft.</span>
                </div>
                @await Html.PartialAsync("GlV2/_DateField", Date("gl-v2-pl-f-pstart", "startDatum", "Startdatum van de planning (optioneel)"))
                <span class="gl-v2-field-help">Eerste dag waarop deze planning mag beginnen. Leeg = de aanvangsdatum van het project. Een voorganger kan haar nog later laten starten.</span>
            </div>

            @* Fase *@
            <div class="gl-v2-pl-only-fase" hidden>
                <div id="gl-v2-pl-wrap-faseplaats">
                    @await Html.PartialAsync("GlV2/_SelectList", Select("gl-v2-pl-f-faseplaats", "faseplaats", "Plaats in de planning", "Een deelfase komt binnen een andere fase, bv. Buitenschrijnwerk binnen Technieken."))
                </div>
                <div id="gl-v2-pl-wrap-eerste">
                    <div class="gl-v2-pl-row2">
                        <div class="gl-v2-field">
                            <label class="gl-v2-field-label" for="gl-v2-pl-f-eerste">Eerste taak in deze fase</label>
                            <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" id="gl-v2-pl-f-eerste" maxlength="300" /></div>
                        </div>
                        <div class="gl-v2-field">
                            <label class="gl-v2-field-label" for="gl-v2-pl-f-eerste-duur">Duur</label>
                            <div class="gl-v2-field-box">
                                <input type="number" class="gl-v2-field-input is-tabular" id="gl-v2-pl-f-eerste-duur" min="0" max="2000" value="1" />
                                <span class="gl-v2-field-suffix">werkdagen</span>
                            </div>
                        </div>
                    </div>
                    <div class="gl-v2-field">
                        <label class="gl-v2-field-label" for="gl-v2-pl-f-startna">De fase start na</label>
                        <div class="gl-v2-field-box"><input type="text" class="gl-v2-field-input" id="gl-v2-pl-f-startna" placeholder="bv. 4.2  of  5.1FS+2d" /></div>
                        <span class="gl-v2-field-help">Zonder voorganger start de fase op de eerste projectdag. Een fase is een groep: ze bestaat uit taken en neemt hun begin en einde over.</span>
                    </div>
                </div>
                <div class="gl-v2-field" id="gl-v2-pl-wrap-schijff" hidden>
                    <span class="gl-v2-field-label" id="gl-v2-pl-wrap-schijff-label">Koppeling met schijven</span>
                    <div class="gl-v2-field-box"><input type="search" class="gl-v2-field-input" id="gl-v2-pl-wrap-schijff-zoek" placeholder="Zoek een schijf…" autocomplete="off" aria-label="Zoek een schijf" /></div>
                    <div class="gl-v2-pl-eenheden" id="gl-v2-pl-wrap-schijff-lijst" role="group" aria-labelledby="gl-v2-pl-wrap-schijff-label"></div>
                    <span class="gl-v2-field-help">Optioneel. Vink één of meer schijven aan. Zijn alle taken van deze fase klaar, dan krijg je de vraag of de schijf bereikt is voor de eenheden van deze planning.</span>
                </div>
                <div id="gl-v2-pl-wrap-trajf" hidden>
                    @await Html.PartialAsync("GlV2/_SelectList", Select("gl-v2-pl-f-trajf", "trajectmijlpaalfase", "Koppeling met trajectmijlpaal", "Optioneel. De mijlpaal in het Traject volgt dan het einde van de laatste taak van de fase en staat op bereikt zodra alle taken klaar zijn."))
                </div>
                <div class="gl-v2-pl-lot" id="gl-v2-pl-wrap-lot">
                    @await Html.PartialAsync("GlV2/_UitvoerderCombo", Uitvoerder("gl-v2-pl-f-uitvf", "uitvoerderfase", "Optioneel. Taken in deze fase zonder eigen uitvoerder nemen deze over."))
                    @await Html.PartialAsync("GlV2/_SelectList", Select("gl-v2-pl-f-lot", "lot", "Budgetlot (optioneel)", "Koppelt de fase aan een lot uit het budget."))
                    <label class="gl-v2-toggle-row" for="gl-v2-pl-f-teltmee">
                        <input type="checkbox" id="gl-v2-pl-f-teltmee" class="gl-v2-toggle-switch" />
                        <span class="gl-v2-toggle-track" aria-hidden="true"></span>
                        <span class="gl-v2-toggle-text">
                            <span class="gl-v2-toggle-label">Telt mee voor de fysieke voortgang</span>
                            <span class="gl-v2-toggle-hint">De voortgang van de taken in deze fase vervangt dan de schatting op basis van facturen voor dit lot.</span>
                        </span>
                    </label>
                </div>
            </div>
        </form>
        <footer class="gl-v2-pl-panel-foot">
            @if (Model.CanDelete)
            {
                <button type="button" class="gl-v2-btn gl-v2-btn-text gl-v2-pl-delete" id="gl-v2-pl-panel-delete" hidden><i class="ph ph-trash" aria-hidden="true"></i>Verwijderen</button>
            }
            <span class="gl-v2-pl-panel-foot-spacer"></span>
            <button type="button" class="gl-v2-btn gl-v2-btn-text" id="gl-v2-pl-panel-cancel">Annuleren</button>
            <button type="button" class="gl-v2-btn gl-v2-btn-secondary" id="gl-v2-pl-panel-again" hidden>Toevoegen en nog één</button>
            <button type="submit" form="gl-v2-pl-form" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-pl-panel-save"><i class="ph ph-check" aria-hidden="true"></i><span>Opslaan</span></button>
        </footer>
    </aside>
</div>

<div class="gl-v2-menu" id="gl-v2-pl-menu" role="menu" aria-label="Acties voor deze rij"></div>
<div class="gl-v2-menu" id="gl-v2-pl-sjmenu" role="menu" aria-label="Sjablonen"></div>
<div class="gl-v2-menu" id="gl-v2-pl-aannmenu" role="menu" aria-label="Uitvoerder kiezen"></div>
@* Gsm-bladen (64p/64r): planningkeuze, taak en sjablonen; gevuld en geopend door gl-v2-projecten-planning.js *@
<div class="gl-v2-menu gl-v2-pl-m-blad" id="gl-v2-pl-m-pick" role="menu" aria-label="Planning kiezen"></div>
<div class="gl-v2-menu gl-v2-pl-m-blad" id="gl-v2-pl-m-sj" role="menu" aria-label="Sjablonen"></div>
<div class="gl-v2-menu gl-v2-pl-m-blad is-taak" id="gl-v2-pl-m-task" role="dialog" aria-label="Taak"></div>

    @* Projectsjabloon toepassen (design-handoff 59g/59h): links de vragen in vier stappen, rechts "Wat er gebeurt" dat live meeverandert; planning, traject en schijven in één keer (TYPE 2 formulier-modal) *@
    <div class="modal fade gl-v2-modal-form gl-v2-pl-sj-modal gl-v2-pl-pj-modal" id="gl-v2-pl-pj" tabindex="-1" aria-hidden="true" aria-labelledby="gl-v2-pl-pj-titel">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-fullscreen-lg-down">
            <form class="modal-content" novalidate autocomplete="off">
                <div class="modal-header gl-v2-pl-pj-kop-rij"><div><h2 class="modal-title" id="gl-v2-pl-pj-titel">Projectsjabloon toepassen</h2><span class="gl-v2-pl-pj-sub" id="gl-v2-pl-pj-sub" data-project="@Model.ProjectName">@Model.ProjectName · je ziet eerst wat er gebeurt; wat al bestaat blijft ongemoeid</span></div><button type="button" class="gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button></div>
                <div class="modal-body gl-v2-pl-pj-body">
                    <div class="gl-v2-pl-pj-links">
                        <section class="gl-v2-pl-pj-sec">
                            <span class="gl-v2-pl-pj-k">1 · Beschrijf het gebouw <i>optioneel</i></span>
                            <div class="gl-v2-field-box gl-v2-field-box-textarea" id="gl-v2-pl-pj-ta-box"><textarea class="gl-v2-field-input" id="gl-v2-pl-pj-beschrijving" rows="3" maxlength="2000" aria-label="Beschrijf het gebouw" placeholder="bv. appartementsgebouw met gelijkvloers en drie verdiepingen, ondergrondse parking, plat dak en terrassen op de 1ste en 2de verdieping"></textarea></div>
                            <div class="gl-v2-pl-pj-aibalk" id="gl-v2-pl-pj-aibalk"><button type="button" class="gl-v2-btn gl-v2-btn-secondary" id="gl-v2-pl-pj-ai"><i class="ph ph-sparkle" aria-hidden="true"></i>Laat de AI een voorstel doen</button><span class="gl-v2-field-help" id="gl-v2-pl-pj-ai-uitleg" role="status">Geen namen, adressen, telefoonnummers of bedragen: die gaan niet naar de AI.</span></div>
                            <div class="gl-v2-notice gl-v2-notice-compact gl-v2-pl-pj-ainote" id="gl-v2-pl-pj-ainote" hidden>
                                <i class="ph ph-sparkle" aria-hidden="true"></i>
                                <span id="gl-v2-pl-pj-ainote-tekst"></span>
                                <button type="button" class="gl-v2-btn gl-v2-btn-text" id="gl-v2-pl-pj-ongedaan">Ongedaan maken</button>
                            </div>
                            <div class="gl-v2-pl-pj-aidetails" id="gl-v2-pl-pj-ai-details" aria-live="polite" hidden>
                                <b class="gl-v2-pl-pj-kop">Aannames van de AI</b><ul id="gl-v2-pl-pj-ai-aannames"></ul>
                                <b class="gl-v2-pl-pj-kop" id="gl-v2-pl-pj-ai-vragen-kop">Vragen</b><ul id="gl-v2-pl-pj-ai-vragen"></ul>
                                <b class="gl-v2-pl-pj-kop">Doorgerekend</b><p id="gl-v2-pl-pj-ai-controle"></p>
                            </div>
                        </section>
                        <section class="gl-v2-pl-pj-sec">
                            <span class="gl-v2-pl-pj-k" id="gl-v2-pl-pj-lijst-label">2 · Projectsjabloon</span>
                            <div class="gl-v2-radio-cards gl-v2-pl-pj-kaarten" id="gl-v2-pl-pj-lijst" role="radiogroup" aria-labelledby="gl-v2-pl-pj-lijst-label"></div>
                            <span class="gl-v2-field-help" id="gl-v2-pl-pj-info"></span>
                        </section>
                        <div id="gl-v2-pl-pj-rest" hidden>
                            <section class="gl-v2-pl-pj-sec">
                                <span class="gl-v2-pl-pj-k">3 · Het gebouw</span>
                                <div class="gl-v2-pl-pj-q" id="gl-v2-pl-pj-q-verd">
                                    <span class="gl-v2-pl-pj-qt"><b>Bouwlagen <span class="gl-v2-pl-pj-aib" hidden><i class="ph ph-sparkle" aria-hidden="true"></i>AI</span></b><small>gelijkvloers + verdiepingen</small></span>
                                    <span class="gl-v2-pl-pj-stap" role="group" aria-label="Aantal bouwlagen"><button type="button" id="gl-v2-pl-pj-min" aria-label="Eén bouwlaag minder">−</button><b id="gl-v2-pl-pj-verd-t">1</b><button type="button" id="gl-v2-pl-pj-plus" aria-label="Eén bouwlaag meer">+</button></span>
                                    <input type="hidden" id="gl-v2-pl-pj-verd" value="1" />
                                </div>
                                <div class="gl-v2-pl-pj-q" id="gl-v2-pl-pj-q-kelder">
                                    <span class="gl-v2-pl-pj-qt"><b>Kelder <span class="gl-v2-pl-pj-aib" hidden><i class="ph ph-sparkle" aria-hidden="true"></i>AI</span></b><small>kelder of ondergrondse verdieping</small></span>
                                    <div class="gl-v2-segmented is-sm" id="gl-v2-pl-pj-kelder-seg" role="group" aria-label="Kelder"><button type="button" data-v="ja">Met kelder</button><button type="button" data-v="nee" class="is-active">Zonder</button></div>
                                    <input type="checkbox" id="gl-v2-pl-pj-kelder" hidden />
                                </div>
                                <div class="gl-v2-pl-pj-q" id="gl-v2-pl-pj-q-dak">
                                    <span class="gl-v2-pl-pj-qt"><b>Dak <span class="gl-v2-pl-pj-aib" hidden><i class="ph ph-sparkle" aria-hidden="true"></i>AI</span></b></span>
                                    <div class="gl-v2-segmented is-sm" id="gl-v2-pl-pj-dak-seg" role="group" aria-label="Dak"><button type="button" data-v="" class="is-active">Geen keuze</button><button type="button" data-v="plat">Plat</button><button type="button" data-v="hellend">Hellend</button></div>
                                    <input type="hidden" id="gl-v2-pl-pj-dak" value="" />
                                </div>
                                <div class="gl-v2-pl-pj-q" id="gl-v2-pl-pj-q-lagen">
                                    <span class="gl-v2-pl-pj-qt"><b>Terrassen of luifels <span class="gl-v2-pl-pj-aib" hidden><i class="ph ph-sparkle" aria-hidden="true"></i>AI</span></b><small>bij de afdek van bouwlaag (leeg = geen)</small></span>
                                    <div class="gl-v2-pl-lagen" id="gl-v2-pl-pj-lagen" role="group" aria-label="Terrassen of luifels bij de afdek van"></div>
                                </div>
                            </section>
                            <section class="gl-v2-pl-pj-sec" id="gl-v2-pl-pj-q-een">
                                <span class="gl-v2-pl-pj-k">4 · Planning <span class="gl-v2-pl-pj-aib" hidden><i class="ph ph-sparkle" aria-hidden="true"></i>AI</span></span>
                                <div class="gl-v2-segmented is-sm" id="gl-v2-pl-pj-een-seg" role="group" aria-label="Aantal planningen"><button type="button" data-v="een">Eén planning voor het gebouw</button><button type="button" data-v="elk" class="is-active" id="gl-v2-pl-pj-elk">Per eenheid</button></div>
                                <input type="checkbox" id="gl-v2-pl-pj-een" hidden />
                                <span class="gl-v2-field-help" id="gl-v2-pl-pj-een-help">Bij een appartementsgebouw is één planning de standaard: de werf loopt per bouwlaag, niet per appartement. “Per eenheid” maakt een planning per eenheid.</span>
                                <label class="gl-v2-toggle-row" for="gl-v2-pl-pj-hoofd" id="gl-v2-pl-pj-hoofd-rij" hidden><input type="checkbox" id="gl-v2-pl-pj-hoofd" class="gl-v2-toggle-switch" checked /><span class="gl-v2-toggle-text"><span class="gl-v2-toggle-label">In de hoofdplanning zetten</span><span class="gl-v2-toggle-desc">enkel als de hoofdplanning nog leeg is. Uit of niet leeg = een aparte planning naast de hoofdplanning</span></span></label>
                            </section>
                        </div>
                    </div>
                    <aside class="gl-v2-pl-pj-rechts" aria-label="Wat er gebeurt">
                        <div class="gl-v2-pl-pj-rh"><b>Wat er gebeurt</b><small>live voor de antwoorden links</small></div>
                        <div id="gl-v2-pl-pj-voorbeeld" class="gl-v2-pl-pj-kaartlijst" aria-live="polite">
                            <p class="gl-v2-pl-pj-leeg" id="gl-v2-pl-pj-leeg">Kies links een projectsjabloon om te zien wat er gebeurt.</p>
                        </div>
                    </aside>
                </div>
                <div class="modal-footer">
                    <span class="gl-v2-pl-pj-fs" id="gl-v2-pl-pj-fs"></span>
                    <span class="gl-v2-field-help gl-v2-pl-sj-fout" id="gl-v2-pl-pj-fout" role="alert" hidden></span>
                    <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-pl-pj-ok" disabled><i class="ph ph-check" aria-hidden="true"></i>Toepassen</button>
                </div>
            </form>
        </div>
    </div>

    @* Vraagt actie (59i): kies eerst wat klopt, dan afvinken of schijven markeren (gevuld door gl-v2-projecten-planning.js) *@
    <div class="modal fade gl-v2-modal-form gl-v2-pl-sj-modal gl-v2-pl-vr-modal" id="gl-v2-pl-vr" tabindex="-1" aria-hidden="true" aria-labelledby="gl-v2-pl-vr-titel">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-md-down">
            <form class="modal-content" novalidate autocomplete="off">
                <div class="modal-header"><h2 class="modal-title" id="gl-v2-pl-vr-titel"></h2><button type="button" class="gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button></div>
                <div class="modal-body">
                    <div class="gl-v2-pl-vr-body">
                        <p class="gl-v2-field-help" id="gl-v2-pl-vr-uitleg"></p>
                        <div class="gl-v2-field" id="gl-v2-pl-vr-extra" hidden></div>
                        <div class="gl-v2-pl-vr-alle"><span class="gl-v2-check"><input type="checkbox" id="gl-v2-pl-vr-alle" checked /><label for="gl-v2-pl-vr-alle"></label></span><label for="gl-v2-pl-vr-alle" id="gl-v2-pl-vr-alle-t">Alles kiezen</label></div>
                        <div class="gl-v2-pl-vr-lijst" id="gl-v2-pl-vr-lijst"></div>
                        <span class="gl-v2-field-help gl-v2-pl-sj-fout" id="gl-v2-pl-vr-fout" role="alert" hidden></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-pl-vr-ok"><i class="ph ph-check" aria-hidden="true"></i><span id="gl-v2-pl-vr-ok-t">Toepassen</span></button>
                </div>
            </form>
        </div>
    </div>

    @* Sjabloon toepassen op woningen of gebouwen (TYPE 2 formulier-modal) *@
    <div class="modal fade gl-v2-modal-form gl-v2-pl-sj-modal" id="gl-v2-pl-sj-toepas" tabindex="-1" aria-hidden="true" aria-labelledby="gl-v2-pl-sj-toepas-titel">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-md-down">
            <form class="modal-content" novalidate autocomplete="off">
                <div class="modal-header"><h2 class="modal-title" id="gl-v2-pl-sj-toepas-titel">Sjabloon toepassen</h2><button type="button" class="gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button></div>
                <div class="modal-body">
                    <div class="gl-v2-field-full">
                        @await Html.PartialAsync("GlV2/_SelectList", Select("gl-v2-pl-sj-kies", "sjabloon", "Sjabloon"))
                        <span class="gl-v2-field-help" id="gl-v2-pl-sj-info"></span>
                    </div>
                    <div class="gl-v2-field gl-v2-field-full" id="gl-v2-pl-sj-bouwdelen-wrap" hidden>
                        <span class="gl-v2-field-label">Woningen en gebouwen</span>
                        <span class="gl-v2-field-help" id="gl-v2-pl-sj-bouwdelen-help"></span>
                        <div class="gl-v2-pl-sj-tabel" id="gl-v2-pl-sj-tabel" role="group" aria-label="Woningen en gebouwen"></div>
                    </div>
                    <span class="gl-v2-field-help gl-v2-field-full gl-v2-pl-sj-fout" id="gl-v2-pl-sj-fout" role="alert" hidden></span>
                </div>
                <div class="modal-footer">
                    <button type="button" class="gl-v2-btn gl-v2-btn-text gl-v2-pl-sj-verwijder" id="gl-v2-pl-sj-verwijder" hidden><i class="ph ph-trash" aria-hidden="true"></i>Sjabloon verwijderen</button>
                    <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-pl-sj-ok">Toepassen</button>
                </div>
            </form>
        </div>
    </div>

    @* Planning bewaren als sjabloon *@
    <div class="modal fade gl-v2-modal-form gl-v2-pl-sj-modal" id="gl-v2-pl-sj-bewaar" tabindex="-1" aria-hidden="true" aria-labelledby="gl-v2-pl-sj-bewaar-titel">
        <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
            <form class="modal-content" novalidate autocomplete="off">
                <div class="modal-header"><h2 class="modal-title" id="gl-v2-pl-sj-bewaar-titel">Bewaren als sjabloon</h2><button type="button" class="gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button></div>
                <div class="modal-body">
                    <p class="gl-v2-pl-sj-uitleg" id="gl-v2-pl-sj-bewaar-uitleg"></p>
                    <div class="gl-v2-field gl-v2-field-full"><label class="gl-v2-field-label" for="gl-v2-pl-sj-naam">Naam van het sjabloon</label><div class="gl-v2-field-box"><input class="gl-v2-field-input" id="gl-v2-pl-sj-naam" maxlength="200" required /></div></div>
                    <div class="gl-v2-field gl-v2-field-full"><label class="gl-v2-field-label" for="gl-v2-pl-sj-besch">Omschrijving <span class="gl-v2-pl-sj-optioneel">· optioneel</span></label><div class="gl-v2-field-box"><input class="gl-v2-field-input" id="gl-v2-pl-sj-besch" maxlength="1000" /></div></div>
                    <span class="gl-v2-field-help gl-v2-field-full gl-v2-pl-sj-fout" id="gl-v2-pl-sj-bewaar-fout" role="alert" hidden></span>
                </div>
                <div class="modal-footer">
                    <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-pl-sj-bewaar-ok">Bewaren</button>
                </div>
            </form>
        </div>
    </div>

    @* Planning importeren uit MS Project-XML (design-handoff 59b): Bestand · Controle · Opties · Resultaat *@
    <div class="modal fade gl-v2-modal-form gl-v2-pl-imp-modal" id="gl-v2-pl-imp" tabindex="-1" aria-hidden="true" aria-labelledby="gl-v2-pl-imp-titel">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-fullscreen-lg-down">
            <form class="modal-content" novalidate autocomplete="off">
                <div class="modal-header"><h2 class="modal-title" id="gl-v2-pl-imp-titel">Planning importeren</h2><button type="button" class="gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button></div>
                <ol class="gl-v2-pl-imp-stappen" id="gl-v2-pl-imp-stappen" aria-label="Stappen"></ol>
                <div class="modal-body">
                    @* 1 Bestand *@
                    <div class="gl-v2-pl-imp-stap" data-stap="0">
                        <div class="gl-v2-pl-imp-drop" id="gl-v2-pl-imp-drop">
                            <i class="ph ph-upload-simple" aria-hidden="true"></i>
                            <b>Sleep je bestand hierheen</b>
                            <span>MS Project-XML (.xml) · max. 10 MB</span>
                            <button type="button" class="gl-v2-btn gl-v2-btn-secondary" id="gl-v2-pl-imp-kies">Bestand kiezen</button>
                            <input type="file" id="gl-v2-pl-imp-file" accept=".xml,text/xml,application/xml" hidden />
                        </div>
                        <div class="gl-v2-notice gl-v2-notice-compact is-info"><span class="gl-v2-notice-icon"><i class="ph ph-info" aria-hidden="true"></i></span><span class="gl-v2-notice-text"><b>Een .mpp-bestand?</b> Dat kan niet rechtstreeks. Open het in MS Project, kies <b>Bestand › Opslaan als</b> en dan <b>XML-indeling (*.xml)</b>, en kies dat bestand hier. Taken, duur, voorgangers en fases gaan mee.</span></div>
                    </div>
                    @* 2 Controle *@
                    <div class="gl-v2-pl-imp-stap" data-stap="1" hidden>
                        <div class="gl-v2-pl-imp-bestand" id="gl-v2-pl-imp-bestand"></div>
                        <div class="gl-v2-pl-imp-kpis" id="gl-v2-pl-imp-kpis"></div>
                        <div class="gl-v2-notice gl-v2-notice-compact is-warning"><span class="gl-v2-notice-icon"><i class="ph ph-warning" aria-hidden="true"></i></span><span class="gl-v2-notice-text"><b>Wat we niet overnemen:</b> resources en kosten worden genegeerd, duren in uren worden afgerond naar werkdagen, “zo laat mogelijk” wordt “zo vroeg mogelijk”, en voorgangers die niet bestaan of een kring zouden maken worden weggelaten. Beperkingen, deadlines, basisplanning, werkelijke data en voortgang gaan wel mee.</span></div>
                        <div class="gl-v2-pl-imp-filter">
                            <div class="gl-v2-segmented is-sm" id="gl-v2-pl-imp-filter" role="group" aria-label="Filter"></div>
                            <span class="gl-v2-field-help" id="gl-v2-pl-imp-filter-info"></span>
                        </div>
                        <div class="gl-v2-pl-imp-tabel" id="gl-v2-pl-imp-tabel" role="table" aria-label="Voorbeeld van het bestand"></div>
                    </div>
                    @* 3 Uitvoerders koppelen (enkel als het bestand resources heeft) *@
                    <div class="gl-v2-pl-imp-stap" data-stap="2" hidden>
                        <div class="gl-v2-notice gl-v2-notice-compact is-info"><span class="gl-v2-notice-icon"><i class="ph ph-info" aria-hidden="true"></i></span><span class="gl-v2-notice-text">Het bestand heeft <b>resources</b> (meestal aannemers). Koppel ze aan een bedrijf uit je project, dan staat dat bedrijf als <b>uitvoerder</b> bij de taak. CPM stelt een koppeling voor op basis van de naam. Een naam die je niet koppelt, komt als tekst in de notitie van de taak, zodat je later nog kunt koppelen.</span></div>
                        <div class="gl-v2-pl-imp-filter"><span class="gl-v2-field-help" id="gl-v2-pl-imp-res-info"></span></div>
                        <div class="gl-v2-pl-imp-tabel" id="gl-v2-pl-imp-res" role="table" aria-label="Resources koppelen aan bedrijven"></div>
                    </div>
                    @* 4 Opties *@
                    <div class="gl-v2-pl-imp-stap" data-stap="3" hidden>
                        <div class="gl-v2-field gl-v2-field-full">
                            <span class="gl-v2-field-label">Waar komt de planning terecht?</span>
                            <div class="gl-v2-pl-imp-kaarten" role="radiogroup" aria-label="Doelplanning">
                                <label class="gl-v2-pl-imp-kaart" id="gl-v2-pl-imp-k-nieuw"><input type="radio" name="gl-v2-pl-imp-doel" value="nieuw" checked /><span><b>Nieuwe planning</b><small>Een eigen planning voor één of meer woningen of een gebouw.</small></span></label>
                                <label class="gl-v2-pl-imp-kaart" id="gl-v2-pl-imp-k-huidig"><input type="radio" name="gl-v2-pl-imp-doel" value="huidig" /><span><b id="gl-v2-pl-imp-k-huidig-naam">Deze planning</b><small>Achteraan toevoegen, of de huidige fases en taken vervangen.</small></span></label>
                            </div>
                        </div>
                        <div id="gl-v2-pl-imp-o-nieuw">
                            <div class="gl-v2-field gl-v2-field-full"><label class="gl-v2-field-label" for="gl-v2-pl-imp-naam">Naam van de planning</label><div class="gl-v2-field-box"><input class="gl-v2-field-input" id="gl-v2-pl-imp-naam" maxlength="200" /></div></div>
                        </div>
                        <div class="gl-v2-field gl-v2-field-full">
                            <span class="gl-v2-field-label" id="gl-v2-pl-imp-een-label">Woningen en gebouwen</span>
                            <div class="gl-v2-pl-eenheden" id="gl-v2-pl-imp-eenheden" role="group" aria-labelledby="gl-v2-pl-imp-een-label"></div>
                            <span class="gl-v2-field-help">Optioneel. Voor welke eenheden geldt deze planning? Leeg bij een bestaande planning laat de eenheden zoals ze zijn. Alleen eenheden zonder andere planning staan in de lijst.</span>
                        </div>
                        <div id="gl-v2-pl-imp-o-huidig" hidden>
                            <div class="gl-v2-field gl-v2-field-full">
                                <span class="gl-v2-field-label">Wat met de huidige planning?</span>
                                <div class="gl-v2-pl-imp-kaarten" role="radiogroup" aria-label="Modus">
                                    <label class="gl-v2-pl-imp-kaart"><input type="radio" name="gl-v2-pl-imp-modus" value="toevoegen" checked /><span><b>Toevoegen</b><small>De geïmporteerde fases komen achteraan; wat er staat blijft.</small></span></label>
                                    <label class="gl-v2-pl-imp-kaart"><input type="radio" name="gl-v2-pl-imp-modus" value="vervangen" /><span><b>Vervangen</b><small>De huidige fases en taken verdwijnen. Dit kan je niet ongedaan maken.</small></span></label>
                                </div>
                            </div>
                        </div>
                        <div class="gl-v2-field gl-v2-field-full">
                            <span class="gl-v2-field-label">Startdatum</span>
                            <div class="gl-v2-pl-imp-kaarten" role="radiogroup" aria-label="Startdatum">
                                <label class="gl-v2-pl-imp-kaart" id="gl-v2-pl-imp-s-bestand"><input type="radio" name="gl-v2-pl-imp-start" value="bestand" checked /><span><b>Zoals in het bestand</b><small id="gl-v2-pl-imp-s-bestand-info"></small></span></label>
                                <label class="gl-v2-pl-imp-kaart"><input type="radio" name="gl-v2-pl-imp-start" value="nieuw" /><span><b>Nieuwe startdatum</b><small>Alle taken schuiven mee; vastgepinde taken blijven staan. De werkkalender van het project (feestdagen, bouwverlof) wordt toegepast.</small></span></label>
                                <label class="gl-v2-pl-imp-kaart" id="gl-v2-pl-imp-s-geen" hidden><input type="radio" name="gl-v2-pl-imp-start" value="geen" /><span><b>De planning niet aanraken</b><small>De startdatum van de planning blijft zoals ze is.</small></span></label>
                            </div>
                        </div>
                        <div id="gl-v2-pl-imp-o-datum" hidden>
                            @await Html.PartialAsync("GlV2/_DateField", Date("gl-v2-pl-imp-startdatum", "importStart", "Nieuwe startdatum"))
                        </div>
                    </div>
                    @* 4 Resultaat *@
                    <div class="gl-v2-pl-imp-stap" data-stap="4" hidden>
                        <div class="gl-v2-pl-imp-resultaat" id="gl-v2-pl-imp-resultaat"></div>
                    </div>
                    <span class="gl-v2-field-help gl-v2-field-full gl-v2-pl-sj-fout" id="gl-v2-pl-imp-fout" role="alert" hidden></span>
                </div>
                <div class="modal-footer">
                    <button type="button" class="gl-v2-btn gl-v2-btn-text" id="gl-v2-pl-imp-terug" hidden>← Vorige</button>
                    <span class="gl-v2-pl-panel-foot-spacer"></span>
                    <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal" id="gl-v2-pl-imp-annuleer">Annuleren</button>
                    <button type="button" class="gl-v2-btn gl-v2-btn-secondary" id="gl-v2-pl-imp-nogeen" hidden>Nog een bestand</button>
                    @* type=button: de generieke "bezig"-knopstaat van gl-v2-modal-form zou een submit-knop na de eerste klik vergrendelen; de stappen sturen zelf *@
                    <button type="button" class="gl-v2-btn gl-v2-btn-primary" id="gl-v2-pl-imp-ok" hidden>Volgende →</button>
                </div>
            </form>
        </div>
    </div>

@await Html.PartialAsync("GlV2/_BevestigModal")

@section PageScripts
{
    <script id="gl-v2-pl-config" type="application/json">
    {
        "projectId": @Model.ProjectId,
        "commandoUrl": "@Url.Action("Commando", "ProjectPlanning", new { projectId = Model.ProjectId })",
        "staatUrl": "@Url.Action("Staat", "ProjectPlanning", new { projectId = Model.ProjectId })",
        "projectEditUrl": "@Url.Action("Edit", "Projecten", new { projectid = Model.ProjectId })",
        "puntenUrl": "@Url.Action("Index", "ProjectsIssues", new { projectId = Model.ProjectId })",
        "importControleUrl": "@Url.Action("ImportControle", "ProjectPlanning", new { projectId = Model.ProjectId })",
        "koppelUrl": "@Url.Action("Koppeling", "ProjectPlanning", new { projectId = Model.ProjectId })",
        "schijfKoppelUrl": "@Url.Action("SchijfKoppeling", "ProjectPlanning", new { projectId = Model.ProjectId })",
        "projectSjablonenUrl": "@Url.Action("ProjectSjablonen", "ProjectPlanning", new { projectId = Model.ProjectId })",
        "projectSjabloonVoorbeeldUrl": "@Url.Action("ProjectSjabloonVoorbeeld", "ProjectPlanning", new { projectId = Model.ProjectId })",
        "projectSjabloonToepassenUrl": "@Url.Action("ProjectSjabloonToepassen", "ProjectPlanning", new { projectId = Model.ProjectId })",
        "projectSjabloonAiUrl": "@Url.Action("ProjectSjabloonAi", "ProjectPlanning", new { projectId = Model.ProjectId })",
        "schijfMarkeerUrl": "@Url.Action("SchijfMarkeren", "ProjectPlanning", new { projectId = Model.ProjectId })",
        "sjabloonBewaarUrl": "@Url.Action("SjabloonBewaren", "ProjectPlanning", new { projectId = Model.ProjectId })",
        "sjabloonVerwijderUrl": "@Url.Action("SjabloonVerwijderen", "ProjectPlanning", new { projectId = Model.ProjectId })",
        "staat": @Html.Raw(Model.StaatJson)
    }
    </script>
    @Html.AntiForgeryToken()
    <script src="~/js/gl-v2-project-inner-menu.js" asp-append-version="true"></script>
    <script src="~/js/gl-v2-gantt.js" asp-append-version="true"></script>
    <script src="~/js/gl-v2-projecten-planning.js" asp-append-version="true"></script>
}
