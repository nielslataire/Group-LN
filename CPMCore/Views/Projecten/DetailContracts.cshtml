@using CPMCore.Controllers
@using BOCore
@inject IConfiguration Configuration
@model CPMCore.Models.Projecten.DetailContractsModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@* @{
	ViewBag.Breadcrumbs = new List<Breadcrumb>()
	{
		new Breadcrumb("Home", nameof(HomeController.Index), "Home", true),
		new Breadcrumb("Projecten", nameof(ProjectenController.Index), "Projecten", true),
		new Breadcrumb(Model.ProjectName, nameof(ProjectenController.Detail) + "?projectid=" + Model.ProjectId, "Projecten", true),
		new Breadcrumb("Klanten", nameof(ProjectenController.DetailClients), "Projecten", false)
	};
} *@
@{
	String urlTotal = "";
	var canWriteProjectSuppliers = ViewBag.CanWriteProjectSuppliers as bool? ?? false;
	var canDeleteProjectSuppliers = ViewBag.CanDeleteProjectSuppliers as bool? ?? false;
}
@section PageStyle
{
    <link rel="stylesheet" href="~/lib/magnific-popup/magnific-popup.css" />
    <link rel="stylesheet" href="~/lib/datatables/media/css/dataTables.bootstrap5.css" />
    <link rel="stylesheet" href="~/lib/select2/css/select2.css" />
    <link rel="stylesheet" href="~/lib/select2-bootstrap-theme/select2-bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-tagsinput/bootstrap-tagsinput.css" />
    <link href="https://cdn.datatables.net/v/bs5/jszip-3.10.1/dt-2.2.2/b-3.2.2/b-colvis-3.2.2/b-html5-3.2.2/b-print-3.2.2/datatables.min.css" rel="stylesheet" integrity="sha384-W8PzvGseaJlM52wTjdPHNrEA9WHp36V+XpQyv1gCKz+1sbFfDo5MlMDT7awB3rAs" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/projecten-custom.css" />
    <style>
        /* DataTables child-wrapper: geen padding, geen border */
        #datatable-contracts-list tr.child > td.child {
            padding: 0 !important;
            border-top: 0 !important;
            border-bottom: 0 !important;
        }
        /* Inner tabel: geen borders op de rijen (Bootstrap .table voegt ze toe) */
        #datatable-contracts-list td.child .table > tbody > tr > td {
            border-top: 0 !important;
            border-bottom: 0 !important;
            vertical-align: middle;
        }
    </style>
}
<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", Model.ProjectId)
        <div class="inner-body">
            <div class="row">
            <div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
                <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
                    <h1 class="font-weight-bold mb-0 mt-0">Leveranciers</h1>
                    <h5 class="mb-4 mt-0">Beheer de leveranciers van het project</h5>
                </div>
                <div class="col-sm-auto px-0">
                        <div class="btn-group" role="group" aria-label="Project acties">
                    <button type="button" class="btn btn-primary btn-md px-3 me-1" id="btnExportExcel"><i class="fas fa-file-excel"></i></button>
                    <button type="button" class="btn btn-primary btn-md px-3 me-1" id="btnExportPdf"><i class="fas fa-file-pdf"></i></button>
                    <div class="btn-group">
                                <button type="button" class="btn btn-primary btn-md px-3 me-1 dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="Aannemerslijst afdrukken">
                            <i class="bx bx-printer"></i> Aannemerslijst
                        </button>
                        <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                            <p class="text-muted small mb-2">Kolommen op de aannemerslijst</p>
                            <div class="checkbox-custom checkbox-default mb-2">
                                <input type="checkbox" id="chkSupplierListSent" checked>
                                <label for="chkSupplierListSent">Contract verstuurd</label>
                            </div>
                            <div class="checkbox-custom checkbox-default mb-2">
                                <input type="checkbox" id="chkSupplierListSigned" checked>
                                <label for="chkSupplierListSigned">Getekend</label>
                            </div>
                            <div class="checkbox-custom checkbox-default mb-2">
                                <input type="checkbox" id="chkSupplierListVgm" checked>
                                <label for="chkSupplierListVgm">VGM charter</label>
                            </div>
                            <div class="checkbox-custom checkbox-default mb-2">
                                <input type="checkbox" id="chkSupplierListNotification" checked>
                                <label for="chkSupplierListNotification">Werfmelding</label>
                            </div>
                            <div class="checkbox-custom checkbox-default mb-3">
                                <input type="checkbox" id="chkSupplierListPid" checked>
                                <label for="chkSupplierListPid">PID attesten</label>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm w-100" id="btnPrintSupplierList">
                                <i class="bx bx-download"></i> PDF afdrukken
                            </button>
                        </div>
                    </div>
                        @if (canWriteProjectSuppliers)
                        {
                            <a href="@Url.Action("AddContract", "Projecten", new {projectid = Model.ProjectId})" class="btn btn-primary btn-md">+ Leverancier toevoegen</a>
                        }
                        </div>
                    </div>
                </div>
            </div>
            @await Html.PartialAsync("Contracts", Model)
            </div>
        </div>
    </div>
</section>
<div id="modaldeletecontract" class="modal-block modal-block-warning mfp-hide">
    <div id="delete-contract-container"></div>
</div>
@section PageScripts
{
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/rowgroup/1.5.1/js/dataTables.rowGroup.js"></script>
    <script src="https://cdn.datatables.net/rowgroup/1.5.1/js/rowGroup.dataTables.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js" integrity="sha384-VFQrHzqBh5qiJIU0uGU5CIW3+OWpdGGJM9LBnGbuIH2mkICcFZ7lPd/AAtI7SNf7" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js" integrity="sha384-/RlQG9uf0M2vcTw3CX7fbqgbj/h8wKxw7C3zu9/GxcBPRKOEcESxaxufwRXqzq6n" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/v/bs5/jszip-3.10.1/dt-2.2.2/b-3.2.2/b-colvis-3.2.2/b-html5-3.2.2/b-print-3.2.2/datatables.min.js" integrity="sha384-GC9Im1BDtt06YOKSzkS553+5q43Nos2JSnLM31TjWFcFbzZrFhAtgCzrHDGM0iDy" crossorigin="anonymous"></script>
    <script src="~/lib/magnific-popup/jquery.magnific-popup.js"></script>
    <script src="~/lib/select2/js/select2.js"></script>
    <script src="~/lib/jquery-mask/jquery.mask.js"></script>
    <script>
            // ===== Naamgeving voor weergave =====
        // Pas deze 2 woorden aan en alle taalregels volgen mee
        const entity = {
          singular: 'leverancier',
          plural: 'leveranciers'
        };

        // Bouw de DataTables language-teksten in NL met dynamische naamgeving
        function buildLanguage(e) {
          const capSing = e.singular.charAt(0).toUpperCase() + e.singular.slice(1);
          const capPlur = e.plural.charAt(0).toUpperCase() + e.plural.slice(1);

          return {
            processing:     "Bezig met verwerken…",
            search:         "Zoeken:",
            lengthMenu:     "Toon _MENU_",
            info:           `${capSing} _START_ tot _END_ van _TOTAL_ ${capPlur}`,
            infoEmpty:      `${capSing} 0 tot 0 van 0 ${capPlur}`,
            infoFiltered:   "(gefilterd uit _MAX_ totaal)",
            loadingRecords: "Bezig met laden…",
            zeroRecords:    `Geen ${e.plural} om weer te geven`,
            emptyTable:     `Er zijn geen ${e.plural} om weer te geven`,

            aria: {
              sortAscending:  ": activeer om oplopend te sorteren",
              sortDescending: ": activeer om aflopend te sorteren"
            }
          };
        }

        // ===== Init DataTable =====
        const table = new DataTable('#datatable-contracts-list', {
          order: [[1, 'asc']],
          language: buildLanguage(entity),
          layout: {
            topStart: {
              buttons: [
                {
                  extend: 'excel',
                  text: '<i class="fa fa-file-excel"></i>',
                  className: 'btn btn-default me-2',
                  titleAttr: 'Exporteer naar Excel',
                  attr: { "data-bs-toggle": "tooltip" },
                  exportOptions: { columns: ':visible' }
                },
                {
                  extend: 'pdf',
                  text: '<i class="fa fa-file-pdf"></i>',
                  className: 'btn btn-default me-2',
                  titleAttr: 'Exporteer naar PDF',
                  attr: { "data-bs-toggle": "tooltip" },
                  orientation: 'landscape',
                  pageSize: 'A3',
                  exportOptions: { columns: ':visible' }
                },
                {
                  extend: 'colvis',
                  text: '<i class="bx bx-columns me-2"></i><span>Alle kolommen</span>',
                  titleAttr: 'Selecteer kolommen',
                  attr: { "data-bs-toggle": "tooltip" },
                  columns: ':not(.noVis)',
                  init: function (api, node) {
                    // styling fix
                    $(node).removeClass('btn-secondary').addClass('btn btn-default');
                  }
                }
              ]
            }
          }
        });

        // ===== UI-aanpassingen / custom knoppen =====
        // Verberg standaard knoppen/search indien je eigen UI gebruikt
        $(".buttons-excel").hide();
        $(".buttons-pdf").hide();
        $(".dt-search").hide(); // DataTables v2 (v1: .dataTables_filter)

        // Koppel custom export-knoppen
        $("#btnExportExcel").on('click', function () {
          $(".buttons-excel").trigger("click");
        });
        $("#btnExportPdf").on('click', function () {
          $(".buttons-pdf").trigger("click");
        });

        // Aannemerslijst-PDF: kolomkeuze meesturen als querystring
        $("#btnPrintSupplierList").on('click', function () {
          var params = $.param({
            projectid: @Model.ProjectId,
            sent: $("#chkSupplierListSent").is(":checked"),
            signed: $("#chkSupplierListSigned").is(":checked"),
            vgm: $("#chkSupplierListVgm").is(":checked"),
            notification: $("#chkSupplierListNotification").is(":checked"),
            pid: $("#chkSupplierListPid").is(":checked")
          });
          window.open('@Url.Action("PrintSupplierList", "Projecten")' + '?' + params, '_blank');
        });

        // Verplaats knoppen naar een eigen container
        table.buttons(0, null).containers().appendTo('#colvis-container');

        // ===== Custom zoekveld =====
        $('#search-term').on('keyup', function () {
          table.search($(this).val()).draw();
        });
        //Tonen van modal delete contract
        $(document).on('click', '.deleteContract', function (e) {
            e.preventDefault();
            var url = "/Projecten/ModalDeleteContract"; // the url to the controller
            var id = $(this).attr('data-id'); // the id that's given to each button in the list
            $.get(url + '/' + id, function (data) {
                $('#delete-contract-container').html(data);
                $.magnificPopup.open({
                    items: { src: '#modaldeletecontract' },
                    type: 'inline',
                    closeBtnInside: true
                });
            });
        });

        // ===== Chevron expand/collapse voor meerdere contracten =====
        const canWriteContracts = @((ViewBag.CanWriteProjectSuppliers as bool? ?? false).ToString().ToLower());
        const canDeleteContracts = @((ViewBag.CanDeleteProjectSuppliers as bool? ?? false).ToString().ToLower());
        const editContractBaseUrl = '@Url.Action("EditContract", "Projecten")';
        const deleteContractBaseUrl = '@Url.Action("ModalDeleteContract", "Projecten")';
        const projectIdForEdit = @Model.ProjectId;

        function getColWidths() {
            return Array.from(
                document.querySelectorAll('#datatable-contracts-list thead th')
            ).map(th => th.offsetWidth + 'px');
        }

        // Zelfde iconencluster als de server-side FollowUpIcons() in Contracts.cshtml:
        // inline-SVG (solid-vorm uit lib/boxicons/svg/solid/*.svg), want het geladen boxicons
        // "basic"-pack bevat geen bxs-* varianten. fill=currentColor + text-success (groen =
        // "ja") / text-muted (gedempt = "nee"); titel/aria-label voor de niet-visuele betekenis.
        const FOLLOWUP_ICO = {
            signed: 'M12 2C6.486 2 2 6.486 2 12s4.486 10 10 10 10-4.486 10-10S17.514 2 12 2zm-1.999 14.413-3.713-3.705L7.7 11.292l2.299 2.295 5.294-5.294 1.414 1.414-6.706 6.706z',
            vgm: 'm20.496 6.106-7.973-4a.997.997 0 0 0-.895-.002l-8.027 4c-.297.15-.502.437-.544.767-.013.097-1.145 9.741 8.541 15.008a.995.995 0 0 0 .969-.009c9.307-5.259 8.514-14.573 8.476-14.967a1 1 0 0 0-.547-.797z',
            notification: 'M20 18v-3a8 8 0 0 0-5-7.4V13h-1V5h-4v8H9V7.6A8 8 0 0 0 4 15v3H2v2h20v-2z'
        };
        function buildFollowUpIcons(signed, vgm, notification) {
            function chip(on, path, label) {
                const cls = on ? 'text-success' : 'text-muted';
                const opacity = on ? '1' : '.4';
                const text = label + ': ' + (on ? 'ja' : 'nee');
                return `<svg viewBox="0 0 24 24" width="18" height="18" class="${cls}" style="vertical-align:-.2em;opacity:${opacity}" role="img" aria-label="${text}"><title>${text}</title><path fill="currentColor" d="${path}"/></svg>`;
            }
            return '<div class="d-inline-flex align-items-center gap-2">'
                + chip(signed, FOLLOWUP_ICO.signed, 'Contract getekend')
                + chip(vgm, FOLLOWUP_ICO.vgm, 'VGM charter')
                + chip(notification, FOLLOWUP_ICO.notification, 'Werfmelding')
                + '</div>';
        }

        function buildContractChildRows(contracts) {
            const w = getColWidths();

            const rows = contracts.map(function (c) {
                const statusClass = c.signed ? 'completed' : 'failed';
                const statusTitle = c.signed ? 'Contract getekend' : 'Contract niet getekend';
                const statusDot   = `<span class="ecommerce-status ${statusClass}" title="${statusTitle}"></span>`;

                const editBtn = canWriteContracts
                    ? `<a class="ms-1 me-1" title="Bewerken"
                          href="${editContractBaseUrl}?projectid=${projectIdForEdit}&contractid=${c.id}">
                           <i class="bx bx-edit fs-5"></i>
                       </a>`
                    : '';

                const deleteBtn = canDeleteContracts
                    ? `<a href="#" class="ms-1 me-1 deleteContract" title="Contract verwijderen" data-id="${c.id}">
                           <i class="bx bx-trash fs-5"></i>
                       </a>`
                    : '';

                // Kolommen 0-11 in dezelfde volgorde als de thead
                return `<tr>
                    <td style="width:${w[0]}"></td>
                    <td style="width:${w[1]}">
                        <div class="d-flex align-items-center gap-2" style="padding-left:5.5rem">
                            ${statusDot}
                            ${c.name}
                        </div>
                    </td>
                    <td style="width:${w[2]}"></td>
                    <td style="width:${w[3]};text-align:right">${c.price}</td>
                    <td style="width:${w[4]}"></td>
                    <td style="width:${w[5]};text-align:right">${c.vat}</td>
                    <td style="width:${w[6]};text-align:right">${c.paymentTerm}</td>
                    <td style="width:${w[7]};text-align:right">${c.cashDiscount}</td>
                    <td style="width:${w[8]};text-align:right">${c.guarantee}</td>
                    <td style="width:${w[9]};text-align:center">${c.sent}</td>
                    <td style="width:${w[10]};text-align:center">${buildFollowUpIcons(c.signed, c.vgm, c.notification)}</td>
                    <td style="width:${w[11]}" class="actions">${editBtn}${deleteBtn}</td>
                </tr>`;
            }).join('');

            // .table geeft Bootstrap-padding + thema-linkkleur; fixed-layout + breedtes voor exacte uitlijning
            return `<table class="table mb-0" style="width:100%;table-layout:fixed">
                        <tbody>${rows}</tbody>
                    </table>`;
        }

        $(document).on('click', '.supplier-toggle', function () {
            const $icon = $(this);
            const tr    = $icon.closest('tr');
            const row   = table.row(tr);
            const contractsRaw = tr.attr('data-contracts');
            if (!contractsRaw) return;

            if (row.child.isShown()) {
                row.child.hide();
                $icon.removeClass('bx-chevron-down').addClass('bx-chevron-right');
            } else {
                const contracts = JSON.parse(contractsRaw);
                row.child(buildContractChildRows(contracts)).show();
                $icon.removeClass('bx-chevron-right').addClass('bx-chevron-down');
            }
        });
    </script>
}