@using CPMCore.Controllers
@model CPMCore.Models.Projecten.BudgetMasterAanmakenModel
<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", Model.ProjectId)
        <div class="inner-body">

            <div class="row justify-content-between align-items-center pt-2 pb-3">
                <div class="col-auto">
                    <h1 class="font-weight-bold mb-0">Nieuw budget aanmaken</h1>
                    <p class="text-muted mb-0">@Model.ProjectName</p>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <form asp-action="BudgetMasterAanmaken" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="ProjectId" />
                                <input type="hidden" asp-for="ProjectName" />

                                <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

                                <div class="mb-3">
                                    <label asp-for="Naam" class="form-label fw-semibold"></label>
                                    <input asp-for="Naam" class="form-control" placeholder="Bv. 8 Woningen" required />
                                    <span asp-validation-for="Naam" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Omschrijving" class="form-label fw-semibold">Omschrijving <span class="text-muted fw-normal">(optioneel)</span></label>
                                    <textarea asp-for="Omschrijving" class="form-control" rows="3" placeholder="Korte toelichting bij dit budget"></textarea>
                                </div>

                                <div class="d-flex gap-2 justify-content-end">
                                    <a href="@Url.Action("BudgetIndex", "Projecten", new { projectId = Model.ProjectId })"
                                       class="btn btn-outline-secondary">
                                        Annuleren
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        Aanmaken <i class="fas fa-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@section PageScripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
