@using CPMCore.Controllers
@using BOCore
@inject IConfiguration Configuration
@model CPMCore.Models.Klanten.DetailClientsModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@* @{
	ViewBag.Breadcrumbs = new List<Breadcrumb>()
	{
		new Breadcrumb("Home", nameof(HomeController.Index), "Home", true),
		new Breadcrumb("Projecten", nameof(ProjectenController.Index), "Projecten", true),
		new Breadcrumb(Model.ProjectName, nameof(ProjectenController.Detail) + "?projectid=" + Model.ProjectId, "Projecten", true),
		new Breadcrumb("Klanten", nameof(ProjectenController.DetailClients), "Projecten", false)
	};
} *@
@{
	String urlTotal = "";
}
@section PageStyle
{
    <link rel="stylesheet" href="~/lib/magnific-popup/magnific-popup.css" />
    <link rel="stylesheet" href="~/lib/datatables/media/css/dataTables.bootstrap5.css" />
    <link href="https://cdn.datatables.net/v/bs5/jszip-3.10.1/dt-2.2.2/b-3.2.2/b-colvis-3.2.2/b-html5-3.2.2/b-print-3.2.2/datatables.min.css" rel="stylesheet" integrity="sha384-W8PzvGseaJlM52wTjdPHNrEA9WHp36V+XpQyv1gCKz+1sbFfDo5MlMDT7awB3rAs" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/projecten-custom.css" />
}
@* Titel/subtitel en acties leven niet meer in de content-body (DESIGN.md "Paginakop" is
   vervangen — zie de "Titel/acties horen in de topbar/sticky actiebalk" regel): titel+icoon
   komen uit SetPageHeader (ProjectenController.DetailClients), acties uit @section PageActions
   hieronder (topbar, ≥768px) + de mobiele fallback-rij in .inner-body (<768px) — zelfde patroon
   als ProjectTraject/Index.cshtml + _TrajectActionButtons.cshtml. Geen subtitel meer: de topbar
   heeft daar geen slot voor, en een losse ondertitel-regel in de content-body zou het topbar-
   patroon net weer gedeeltelijk herhalen. *@
@section PageActions
{
    @await Html.PartialAsync("Partials/_ClientsActionButtons", Model)
}
<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", Model.ProjectId)
        <div class="inner-body">
            <div class="d-flex d-md-none justify-content-end gap-2 mb-3">
                @await Html.PartialAsync("Partials/_ClientsActionButtons", Model)
            </div>
            @await Html.PartialAsync("Clients", Model)
        </div>
    </div>
</section>
<div id="modaldeleteclient" class="modal-block modal-block-warning mfp-hide">
    <div id="delete-client-container"></div>
</div>
@section PageScripts
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js" integrity="sha384-VFQrHzqBh5qiJIU0uGU5CIW3+OWpdGGJM9LBnGbuIH2mkICcFZ7lPd/AAtI7SNf7" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js" integrity="sha384-/RlQG9uf0M2vcTw3CX7fbqgbj/h8wKxw7C3zu9/GxcBPRKOEcESxaxufwRXqzq6n" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/v/bs5/jszip-3.10.1/dt-2.2.2/b-3.2.2/b-colvis-3.2.2/b-html5-3.2.2/b-print-3.2.2/datatables.min.js" integrity="sha384-GC9Im1BDtt06YOKSzkS553+5q43Nos2JSnLM31TjWFcFbzZrFhAtgCzrHDGM0iDy" crossorigin="anonymous"></script>
    <script>
                // ===== Naamgeving voor weergave =====
            // Pas deze 2 woorden aan en alle taalregels volgen mee
            const entity = {
              singular: 'klant',
              plural: 'klanten'
            };

            // Bouw de DataTables language-teksten in NL met dynamische naamgeving
            function buildLanguage(e) {
              const capSing = e.singular.charAt(0).toUpperCase() + e.singular.slice(1);
              const capPlur = e.plural.charAt(0).toUpperCase() + e.plural.slice(1);

              return {
                processing:     "Bezig met verwerken…",
                search:         "Zoeken:",
                lengthMenu:     "Toon _MENU_",
                info:           `${capSing} _START_ tot _END_ van _TOTAL_ ${capPlur}`,
                infoEmpty:      `${capSing} 0 tot 0 van 0 ${capPlur}`,
                infoFiltered:   "(gefilterd uit _MAX_ totaal)",
                loadingRecords: "Bezig met laden…",
                zeroRecords:    `Geen ${e.plural} om weer te geven`,
                emptyTable:     `Er zijn geen ${e.plural} om weer te geven`,

                // Klassieke pijltjes-iconen i.p.v. tekst (DESIGN.md "Table pagination controls").
                // Phosphor heeft — anders dan Boxicons — een echt dubbel-caret-icoon (ph-caret-
                // double-left/-right) voor eerste/laatste, dus geen kunstgreep meer nodig (twee
                // enkele iconen tegen elkaar aan) zoals bij de Mijlpalen-tabel. Tekst blijft
                // visually-hidden staan voor schermlezers.
                paginate: {
                  first: '<i class="ph ph-caret-double-left" aria-hidden="true"></i><span class="visually-hidden">Eerste</span>',
                  previous: '<i class="ph ph-caret-left" aria-hidden="true"></i><span class="visually-hidden">Vorige</span>',
                  next: '<i class="ph ph-caret-right" aria-hidden="true"></i><span class="visually-hidden">Volgende</span>',
                  last: '<i class="ph ph-caret-double-right" aria-hidden="true"></i><span class="visually-hidden">Laatste</span>'
                },

                aria: {
                  sortAscending:  ": activeer om oplopend te sorteren",
                  sortDescending: ": activeer om aflopend te sorteren"
                }
              };
            }

            // ===== Init DataTable =====
            const table = new DataTable('#datatable-clients-list', {
              order: [[1, 'asc']],
              language: buildLanguage(entity),
              // Alle kolommen staan standaard aan — Verkoopdatum/Aktedatum/Opleverdatum stonden
              // vroeger als data-visible="false" op de <th> (een Bootstrap Table-plugin-attribuut
              // dat DataTables v2 sowieso niet leest, dus in de praktijk al nooit verborgen was);
              // colvis blijft beschikbaar om zelf kolommen te verbergen, maar niet meer standaard.
              layout: {
                topStart: {
                  buttons: [
                    {
                      extend: 'excel',
                      text: '<i class="ph ph-file-xls"></i>',
                      className: 'btn btn-default me-2',
                      titleAttr: 'Exporteer naar Excel',
                      attr: { "data-bs-toggle": "tooltip" },
                      exportOptions: { columns: ':visible' }
                    },
                    {
                      extend: 'colvis',
                      text: '<i class="ph ph-columns me-2"></i><span>Alle kolommen</span>',
                      titleAttr: 'Selecteer kolommen',
                      attr: { "data-bs-toggle": "tooltip" },
                      columns: ':not(.noVis)',
                      init: function (api, node) {
                        // styling fix
                        $(node).removeClass('btn-secondary').addClass('btn btn-default');
                      }
                    }
                  ]
                }
              }
            });

            // ===== UI-aanpassingen / custom knoppen =====
            // Verberg standaard knoppen/search indien je eigen UI gebruikt
            $(".buttons-excel").hide();
            $(".dt-search").hide(); // DataTables v2 (v1: .dataTables_filter)

            // Koppel custom export-knoppen — class i.p.v. id: _ClientsActionButtons.cshtml wordt
            // tweemaal gerenderd (topbar + mobiele fallback), een id-selector zou enkel de eerste
            // knop binden.
            $(".js-export-excel").on('click', function () {
              $(".buttons-excel").trigger("click");
            });

            // Klantenlijst-PDF (server-side, Group LN-huisstijl)
            $(".js-print-clientlist").on('click', function () {
              window.open('@Url.Action("PrintClientList", "Projecten")' + '?projectid=' + @Model.ProjectId, '_blank');
            });

            // Verplaats knoppen naar een eigen container
            table.buttons(0, null).containers().appendTo('#colvis-container');

            // ===== Custom zoekveld =====
            $('#search-term').on('keyup', function () {
              table.search($(this).val()).draw();
            });
        $('.deleteClient').click(function () {
            var url = "/Klanten/PartialDeleteClientModal"; // the url to the controller
            var id = $(this).attr('data-id'); // the id that's given to each button in the list
            $.get(url + '/' + id, function (data) {

                $('#delete-client-container').html(data);
            });
        });
    $(document).ready(function () {
        $('.deleteClient').magnificPopup({
            type: 'inline',
            src: 'deleteClient',
        });       
    });

    </script>
}
