@model CPMCore.Models.Projecten.ContactAddModel
@{
    var contactMethods = new[]
    {
    new { Value = "Group LN", Text = "Website Group LN" },
    new { Value = "BCO", Text = "Website BCO" },
    new { Value = "Telefoon",   Text = "Telefoon" },
    new { Value = "Email",   Text = "E-mail" },
    new { Value = "Makelaar",  Text = "Website makelaar" }
};
}

<section class="body">
    <div class="content-wrapper">
        <div class="row">
            <div class="col-12">
                <div class="card card-modern">
                    <div class="card-body">
                        <h1 class="h4 mb-4">Contact toevoegen</h1>
                        <form method="post" action="@Url.Action("AddContact", "Projecten")">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ProjectId" value="@Model.ProjectId" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Voornaam</label>
                                    <input type="text" class="form-control" name="Firstname" value="@Model.Firstname" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Achternaam</label>
                                    <input type="text" class="form-control" name="Lastname" value="@Model.Lastname" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">E-mail</label>
                                    <input type="email" class="form-control" name="Email" value="@Model.Email" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Telefoon</label>
                                    <input type="text" class="form-control" name="Phone" value="@Model.Phone" />
                                </div>
                                 <div class="col-md-6">
                                    <label class="form-label">Contactdatum</label>
                                    <input type="date" class="form-control" name="ContactDate" value="@(Model.ContactDate?.ToString("yyyy-MM-dd") ?? string.Empty)" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Contact via</label>
                                    <select class="form-select" name="ContactMethod" required>
                                        <option value="">Kies een kanaal</option>
                                        @foreach (var method in contactMethods)
                                        {
                                            var isSelected = string.Equals(method.Value, Model.ContactMethod, StringComparison.OrdinalIgnoreCase);

                                            <option value="@method.Value" selected="@(isSelected ? "selected" : null)">
                                                @method.Text
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Commentaar</label>
                                    <textarea class="form-control" name="Comment" rows="3" placeholder="Optioneel commentaar">@Model.Comment</textarea>
                                </div>
                            </div>

                            <div class="mt-4 d-flex gap-2">
                                <button type="submit" class="btn btn-primary">Opslaan</button>
                                <a href="@Url.Action("DetailContacts", "Projecten", new { projectid = Model.ProjectId })" class="btn btn-default">Annuleren</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>