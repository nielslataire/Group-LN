@model CPMCore.Models.Issues.PuntenIndexV2Vm
@*
    gl-v2 — Punten, lijst (design-handoff 40a) + selectie (40n).
      · KPI's per fase van het verloop (Concept → Ter goedkeuring → Doorgestuurd → Gemeld uitgevoerd → Afgesloten) + Kritiek;
      · zoekveld + Filters (optie 4f): Status, Eenheid, Aannemer, Fase, Deadline, Prioriteit, Op plan — standaard "Open (alle behalve afgesloten)";
      · tabel met sorteerbare kolommen, rij = link naar het detail (40o), ··· menu per rij;
      · vinkjes openen de donkere selectiebalk (30b): Goedkeuren, Status…, Deadline…, Aannemer…, Verwijderen.
    Eigen klassen-namespace gl-v2-pt-* (gl-v2-projecten-punten.css/.js). Het legacy Index.cshtml blijft bestaan (?classic=true).
    Nog niet in deze fase: Op plan / Per aannemer (40b), Punt toevoegen-paneel (40c), Goedkeuren & doorsturen (40d), Aan verslag (40i).
*@
@using System.Globalization
@using BOCore
@using CPMCore.Helpers
@using CPMCore.Models.GlV2
@using CPMCore.Models.Issues
@{
    ViewData["Title"] = "Punten";
    ViewData["PageIcon"] = "ph ph-warning-circle";
    ViewData["GlV2FullHeightBody"] = true;
    ViewData["BackUrl"] = Url.Action("Detail", "Projecten", new { projectid = Model.ProjectId });

    var rows = Model.Rows;
    int Count(ConstructionIssueStatus s) => rows.Count(r => PuntenWeergave.Canon(r.Status) == (int)s);
    var critical = rows.Where(r => !r.IsClosed && r.Priority == 3).ToList();
    var overdue = rows.Count(r => r.Overdue);
    var openCount = rows.Count(r => !r.IsClosed);
    var kpis = new List<GlV2KpiItemVm>
    {
        new() { Label = "Concept", HintInline = true, FilterKey = "status:8", Value = Count(ConstructionIssueStatus.Concept).ToString(), Hint = "nog niet ingediend", IconClass = "ph-pencil-simple-line" },
        new() { Label = "Ter goedkeuring", HintInline = true, FilterKey = "status:9", Value = Count(ConstructionIssueStatus.PendingApproval).ToString(), Hint = "wacht op werfleider", IconClass = "ph-hourglass-medium", Tone = GlV2KpiTone.Warning },
        new() { Label = "Goedgekeurd", HintInline = true, FilterKey = "status:13", Value = Count(ConstructionIssueStatus.Approved).ToString(), Hint = "gaat 's avonds mee", IconClass = "ph-check" },
        new() { Label = "Doorgestuurd", HintInline = true, FilterKey = "status:10", Value = Count(ConstructionIssueStatus.Forwarded).ToString(), Hint = "bij " + rows.Where(r => PuntenWeergave.Canon(r.Status) == (int)ConstructionIssueStatus.Forwarded && r.ContractorId.HasValue).Select(r => r.ContractorId).Distinct().Count() + " aannemers", IconClass = "ph-paper-plane-tilt" },
        new() { Label = "Gemeld uitgevoerd", HintInline = true, FilterKey = "status:11", Value = Count(ConstructionIssueStatus.Reported).ToString(), Hint = "te controleren", IconClass = "ph-check-circle" },
        new() { Label = "Afgesloten", HintInline = true, FilterKey = "status:5", Value = Count(ConstructionIssueStatus.Closed).ToString(), Hint = "totaal", IconClass = "ph-seal-check" },
        new() { Label = "Kritiek", HintInline = true, FilterKey = "critical", Value = critical.Count.ToString(), Hint = overdue + " over deadline", IconClass = "ph-warning", Tone = GlV2KpiTone.Danger },
    };
    var menuVm = new GlV2ProjectMenuVm { ProjectId = Model.ProjectId, ProjectName = Model.ProjectName, ProjectSubtitle = "project · punten" };
    var be = CultureInfo.GetCultureInfo("nl-BE");

    GlV2SelectListVm Filter(string id, string empty, IEnumerable<GlV2SelectItem> items, string value = "") => new()
    {
        Name = id, Id = id, Bare = true, Value = value, EmptyText = empty, Items = items.ToList()
    };
}
@section PageStyle
{
    <link href="https://cdn.datatables.net/v/bs5/jszip-3.10.1/dt-2.2.2/b-3.2.2/b-colvis-3.2.2/b-html5-3.2.2/b-print-3.2.2/datatables.min.css" rel="stylesheet" integrity="sha384-W8PzvGseaJlM52wTjdPHNrEA9WHp36V+XpQyv1gCKz+1sbFfDo5MlMDT7awB3rAs" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/gl-v2-project-inner-menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-punt-planviewer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-projecten-punten.css" asp-append-version="true" />
}
@section PageActions
{
    <button type="button" class="gl-v2-btn gl-v2-btn-secondary" id="pt-print"><i class="ph ph-printer" aria-hidden="true"></i><span>Afdrukken</span></button>
    @if (Model.CanWrite)
    {
        <a class="gl-v2-btn gl-v2-btn-secondary" href="@Url.Action("SendV2", "ProjectsIssues", new { projectId = Model.ProjectId })"><i class="ph ph-paper-plane-tilt" aria-hidden="true"></i><span>Goedkeuren &amp; doorsturen</span></a>
        <button type="button" class="gl-v2-btn gl-v2-btn-primary js-pt-new"><i class="ph ph-plus" aria-hidden="true"></i><span>Punt toevoegen</span></button>
    }
}
@section MobileQuickActions
{
    @if (Model.CanWrite)
    {
        <button type="button" class="gl-v2-mobile-quickaction gl-v2-mobile-quickaction-primary js-pt-new"><i class="ph ph-plus" aria-hidden="true"></i>Punt</button>
    }
}
@section ProjectMenu
{
    @{ menuVm.Mode = GlV2ProjectMenuMode.Outer; }
    @await Html.PartialAsync("GlV2/_ProjectInnerMenuV2", menuVm)
}

@* De tabbar moet het letterlijke eerste kind van .gl-v2-content zijn (zie ChangeOrdersV2). *@
@await Html.PartialAsync("Partials/_PuntTabsV2", new PuntTabsV2Vm { ProjectId = Model.ProjectId, Active = "lijst", ListCount = Model.Rows.Count, PlanCount = Model.PlanCount })

@{ menuVm.Mode = GlV2ProjectMenuMode.Phone; }
@await Html.PartialAsync("GlV2/_ProjectInnerMenuV2", menuVm)

<div id="gl-v2-pt-root" data-send-url="@Url.Action("SendV2", "ProjectsIssues", new { projectId = Model.ProjectId })" data-edit-url="@Url.Action("EditV2", "ProjectsIssues", new { projectId = Model.ProjectId, id = 0 })" data-edit-data-url="@Url.Action("EditData", "ProjectsIssues", new { projectId = Model.ProjectId, id = 0 })" data-project-id="@Model.ProjectId" data-can-write="@(Model.CanWrite ? "1" : "0")">
    @await Html.PartialAsync("GlV2/_KpiStrip", (IReadOnlyList<GlV2KpiItemVm>)kpis)

    <div class="gl-v2-toolbar-card gl-v2-filters-card">
        <div class="gl-v2-filters-row">
            <div class="gl-v2-field gl-v2-toolbar-search">
                <div class="gl-v2-field-box">
                    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                    <input type="text" class="gl-v2-field-input" id="pt-search" placeholder="Zoek op titel, locatie of nummer…" autocomplete="off" aria-label="Zoek punten">
                    <button type="button" class="gl-v2-field-clear" id="pt-search-clear" aria-label="Zoekterm wissen">&times;</button>
                </div>
            </div>
            <button type="button" class="gl-v2-filters-toggle" id="pt-filters-toggle" aria-expanded="false" aria-controls="pt-filters-panel">
                <i class="ph ph-funnel" aria-hidden="true"></i>Filters<span class="gl-v2-filters-toggle-count" id="pt-filters-count" hidden>0</span>
            </button>
        </div>
        <div class="gl-v2-filters-panel" id="pt-filters-panel" hidden>
            <div class="gl-v2-filters-grid gl-v2-pt-filters-grid">
                <div class="gl-v2-filters-field"><span class="gl-v2-filters-field-label">Status</span>
                    @await Html.PartialAsync("GlV2/_SelectList", Filter("pt-f-status", "", new[]
                    {
                        new GlV2SelectItem { Value = "open", Text = "Open (alle behalve afgesloten)" }, new GlV2SelectItem { Value = "all", Text = "Alle statussen" },
                        new GlV2SelectItem { Value = "8", Text = "Concept" }, new GlV2SelectItem { Value = "9", Text = "Ter goedkeuring" }, new GlV2SelectItem { Value = "13", Text = "Goedgekeurd" }, new GlV2SelectItem { Value = "10", Text = "Doorgestuurd" },
                        new GlV2SelectItem { Value = "11", Text = "Gemeld uitgevoerd" }, new GlV2SelectItem { Value = "12", Text = "In de wacht" }, new GlV2SelectItem { Value = "6", Text = "Afgewezen" }, new GlV2SelectItem { Value = "5", Text = "Afgesloten" }
                    }, "open"))
                </div>
                <div class="gl-v2-filters-field"><span class="gl-v2-filters-field-label">Eenheid</span>
                    @await Html.PartialAsync("GlV2/_SelectList", Filter("pt-f-unit", "Alle eenheden", new[] { new GlV2SelectItem { Value = "0", Text = "Algemeen" } }.Concat(Model.Units.Select(u => new GlV2SelectItem { Value = u.Key.ToString(), Text = u.Value }))))
                </div>
                <div class="gl-v2-filters-field"><span class="gl-v2-filters-field-label">Aannemer</span>
                    @await Html.PartialAsync("GlV2/_SelectList", Filter("pt-f-contractor", "Alle aannemers", Model.Contractors.Select(c => new GlV2SelectItem { Value = c.Key.ToString(), Text = c.Value })))
                </div>
                <div class="gl-v2-filters-field"><span class="gl-v2-filters-field-label">Fase</span>
                    @await Html.PartialAsync("GlV2/_SelectList", Filter("pt-f-phase", "Alle fases", Model.Phases.Select(p => new GlV2SelectItem { Value = p.Key.ToString(), Text = p.Value })))
                </div>
                <div class="gl-v2-filters-field"><span class="gl-v2-filters-field-label">Deadline</span>
                    @await Html.PartialAsync("GlV2/_SelectList", Filter("pt-f-due", "Alle deadlines", new[]
                    {
                        new GlV2SelectItem { Value = "over", Text = "Over deadline" }, new GlV2SelectItem { Value = "week", Text = "Deze week" }, new GlV2SelectItem { Value = "none", Text = "Zonder deadline" }
                    }))
                </div>
                <div class="gl-v2-filters-field"><span class="gl-v2-filters-field-label">Prioriteit</span>
                    @await Html.PartialAsync("GlV2/_SelectList", Filter("pt-f-priority", "Alle", new[]
                    {
                        new GlV2SelectItem { Value = "3", Text = "Kritiek" }, new GlV2SelectItem { Value = "2", Text = "Hoog" }, new GlV2SelectItem { Value = "1", Text = "Normaal" }, new GlV2SelectItem { Value = "0", Text = "Laag" }
                    }))
                </div>
                <div class="gl-v2-filters-field"><span class="gl-v2-filters-field-label">Verslag</span>
                    @await Html.PartialAsync("GlV2/_SelectList", Filter("pt-f-verslag", "Alle verslagen", Model.Verslagen.Select(v => new GlV2SelectItem { Value = v.Id.ToString(), Text = v.Naam })))
                </div>
                <div class="gl-v2-filters-field"><span class="gl-v2-filters-field-label">Op plan</span>
                    @await Html.PartialAsync("GlV2/_SelectList", Filter("pt-f-plan", "Maakt niet uit", new[] { new GlV2SelectItem { Value = "yes", Text = "Op plan aangeduid" }, new GlV2SelectItem { Value = "no", Text = "Niet op plan" } }))
                </div>
            </div>
            <div class="gl-v2-filters-chips">
                <div class="gl-v2-filters-chip-list" id="pt-chips"></div>
                <button type="button" class="gl-v2-filters-clear" id="pt-filters-clear" hidden>Wissen</button>
            </div>
        </div>
    </div>

    <div class="gl-v2-card gl-v2-detail-table-card gl-v2-pt-card">
      <div class="gl-v2-card-body">
        <div class="table-responsive-md">
            <table class="table table-hover mb-0 w-100 gl-v2-detail-table" id="datatable-punten">
                <thead>
                    <tr>
                        <th class="gl-v2-pt-check no-sort"><input type="checkbox" id="pt-check-all" aria-label="Alles selecteren" @(Model.CanWrite ? "" : "hidden")></th>
                        <th>Punt</th>
                        <th>Eenheid</th>
                        <th>Kamer / zone</th>
                        <th>Fase</th>
                        <th>Aannemer</th>
                        <th>Status</th>
                        <th>Deadline</th>
                        <th class="no-sort"></th>
                    </tr>
                </thead>
                <tbody id="pt-body">
                    @foreach (var r in rows)
                    {
                        var menuId = "pt-menu-" + r.Id;
                        var canon = PuntenWeergave.Canon(r.Status);
                        var word = PuntenWeergave.PriorityWord(r.Priority);
                        <tr class="gl-v2-pt-row @(r.IsClosed ? "is-closed" : "")" data-id="@r.Id" data-nr="@r.Nr" data-status="@canon" data-closed="@(r.IsClosed ? 1 : 0)"
                            data-unit="@(r.UnitId ?? 0)" data-unitname="@r.UnitName" data-contractor="@(r.ContractorId ?? 0)" data-phase="@r.Phase"
                            data-due="@r.DueDate?.ToString("yyyy-MM-dd")" data-overdue="@(r.Overdue ? 1 : 0)" data-priority="@r.Priority" data-plan="@(r.HasPlan ? 1 : 0)" data-verslagen="@r.VerslagIds"
                            data-href="@Url.Action("Details", "ProjectsIssues", new { projectId = Model.ProjectId, id = r.Id })"
                            data-search="@((r.Title + " " + r.NrLabel + " " + r.UnitName + " " + r.Zone + " " + r.Contractor).ToLowerInvariant())">
                            <td class="gl-v2-pt-check"><input type="checkbox" class="js-pt-check" value="@r.Id" aria-label="Selecteer @r.NrLabel" @(Model.CanWrite ? "" : "hidden")></td>
                            <td class="gl-v2-pt-title" data-order="@r.Nr">
                                <span class="gl-v2-pt-title-main">@r.Title</span>
                                @if (word != "" || r.HasPlan)
                                {
                                    <span class="gl-v2-pt-title-sub">
                                        @if (word != "") { <span class="gl-v2-pt-tag @(r.Priority == 3 ? "is-critical" : "")">@word</span> }
                                        @if (r.HasPlan) { <span class="gl-v2-pt-tag is-plan">op plan</span> }
                                    </span>
                                }
                            </td>
                            <td>@r.UnitName</td>
                            <td class="gl-v2-pt-muted">@(string.IsNullOrWhiteSpace(r.Zone) ? "—" : r.Zone)</td>
                            <td class="gl-v2-pt-muted">@r.PhaseLabel</td>
                            <td>@(string.IsNullOrWhiteSpace(r.Contractor) ? "—" : r.Contractor)</td>
                            <td data-order="@canon"><span class="gl-v2-badge @r.StatusTone">@r.StatusLabel</span></td>
                            <td class="gl-v2-pt-due @(r.Overdue ? "is-overdue" : "")" data-order="@(r.DueDate?.ToString("yyyy-MM-dd") ?? "9999-12-31")">@(r.DueDate.HasValue ? r.DueDate.Value.ToString("dd/MM", be) : "—")</td>
                            <td class="gl-v2-pt-actions">
                                <i class="ph ph-caret-right gl-v2-pt-chev" aria-hidden="true"></i>
                                <div class="gl-v2-pt-rowacts">
                                    <a class="gl-v2-icon-btn" href="@Url.Action("Details", "ProjectsIssues", new { projectId = Model.ProjectId, id = r.Id })" title="Openen" aria-label="Openen @r.NrLabel"><i class="ph ph-arrow-square-out" aria-hidden="true"></i></a>
                                    @if (Model.CanWrite)
                                    {
                                        <button type="button" class="gl-v2-icon-btn js-pt-edit" data-id="@r.Id" title="Bewerken" aria-label="Bewerken @r.NrLabel"><i class="ph ph-pencil-simple" aria-hidden="true"></i></button>
                                        <button type="button" class="gl-v2-icon-btn js-pt-dup" data-id="@r.Id" title="Dupliceren" aria-label="Dupliceren @r.NrLabel"><i class="ph ph-copy" aria-hidden="true"></i></button>
                                    }
                                    @if (Model.CanDelete)
                                    {
                                        <button type="button" class="gl-v2-icon-btn is-danger js-pt-delete" data-id="@r.Id" data-title="@r.Title" title="Verwijderen" aria-label="Verwijderen @r.NrLabel"><i class="ph ph-trash" aria-hidden="true"></i></button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
      </div>
    </div>
</div>

@if (Model.CanWrite)
{
    @* Selectiebalk (40n): zwevend onderaan; acties met "…" openen een klein paneel boven de balk. *@
    <div class="gl-v2-pt-selectionbar" id="pt-selbar" hidden>
        <span class="gl-v2-pt-selbar-count"><b id="pt-sel-n">0</b> geselecteerd</span>
        <span class="gl-v2-pt-selbar-spacer"></span>
        <button type="button" class="gl-v2-pt-selbar-action" data-op="approve"><i class="ph ph-check" aria-hidden="true"></i>Goedkeuren</button>
        <button type="button" class="gl-v2-pt-selbar-action" data-op="send"><i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>Doorsturen…</button>
        <button type="button" class="gl-v2-pt-selbar-action js-pt-pop" data-pop="pt-pop-status"><i class="ph ph-arrows-clockwise" aria-hidden="true"></i>Status…</button>
        <button type="button" class="gl-v2-pt-selbar-action js-pt-pop" data-pop="pt-pop-deadline"><i class="ph ph-calendar" aria-hidden="true"></i>Deadline…</button>
        <button type="button" class="gl-v2-pt-selbar-action js-pt-pop" data-pop="pt-pop-verslag"><i class="ph ph-notebook" aria-hidden="true"></i>Aan verslag…</button>
        <button type="button" class="gl-v2-pt-selbar-action js-pt-pop" data-pop="pt-pop-contractor"><i class="ph ph-hard-hat" aria-hidden="true"></i>Aannemer…</button>
        @if (Model.CanDelete)
        {
            <span class="gl-v2-pt-selbar-divider"></span>
            <button type="button" class="gl-v2-pt-selbar-action is-danger" id="pt-sel-delete"><i class="ph ph-trash" aria-hidden="true"></i>Verwijderen</button>
        }
        <button type="button" class="gl-v2-pt-selbar-close" id="pt-sel-clear" aria-label="Selectie wissen"><i class="ph ph-x" aria-hidden="true"></i></button>

        <div class="gl-v2-pt-pop" id="pt-pop-status" hidden>
            <div class="gl-v2-pt-pop-title">STATUS VOOR <span class="js-pt-sel-n"></span> PUNTEN</div>
            @foreach (var s in new[] { (9, "Ter goedkeuring"), (13, "Goedgekeurd"), (10, "Doorgestuurd"), (11, "Gemeld uitgevoerd"), (5, "Afgesloten"), (6, "Afgewezen") })
            {
                <button type="button" class="gl-v2-pt-pop-item js-pt-do" data-op="status" data-status="@s.Item1">@s.Item2</button>
            }
            <div class="gl-v2-pt-pop-note">"In de wacht" zet je per punt, met reden en opvolgdatum.</div>
        </div>
        <div class="gl-v2-pt-pop gl-v2-pt-pop-form" id="pt-pop-deadline" hidden>
            <div class="gl-v2-pt-pop-title">DEADLINE VOOR <span class="js-pt-sel-n"></span> PUNTEN</div>
            @await Html.PartialAsync("GlV2/_DateField", new GlV2DateFieldVm { Name = "pt-due-input", Id = "pt-due-input", Label = "Nieuwe deadline" })
            <div class="gl-v2-pt-pop-actions"><button type="button" class="gl-v2-btn gl-v2-btn-text js-pt-pop-close">Annuleren</button><button type="button" class="gl-v2-btn gl-v2-btn-primary js-pt-do" data-op="deadline">Toepassen</button></div>
        </div>
        <div class="gl-v2-pt-pop" id="pt-pop-verslag" hidden>
            <div class="gl-v2-pt-pop-title">AAN VERSLAG TOEVOEGEN (<span class="js-pt-sel-n"></span> PUNTEN)</div>
            @foreach (var v in Model.Verslagen.Where(v => v.Open))
            {
                <button type="button" class="gl-v2-pt-pop-item js-pt-do" data-op="verslag" data-verslag="@v.Id"><span>@v.Naam</span><small>concept — nog open</small></button>
            }
            @if (!Model.Verslagen.Any(v => v.Open)) { <div class="gl-v2-pt-pop-note">Er is geen lopend verslag. Start er eerst één onder Verslagen.</div> }
        </div>
        <div class="gl-v2-pt-pop" id="pt-pop-contractor" hidden>
            <div class="gl-v2-pt-pop-title">AANNEMER VOOR <span class="js-pt-sel-n"></span> PUNTEN</div>
            @foreach (var c in Model.ProjectContractors)
            {
                var open = Model.OpenPerContractor.GetValueOrDefault(c.Key);
                <button type="button" class="gl-v2-pt-pop-item js-pt-do" data-op="contractor" data-contractor="@c.Key"><span>@c.Value</span><small>@(open == 0 ? "geen punten" : open + " open punten in dit project")</small></button>
            }
            @if (Model.ProjectContractors.Count == 0) { <div class="gl-v2-pt-pop-note">Dit project heeft nog geen aannemers met een contract.</div> }
        </div>
    </div>

    <form method="post" id="pt-bulk-form" action="@Url.Action("BulkV2", "ProjectsIssues", new { projectId = Model.ProjectId })" hidden>
        @Html.AntiForgeryToken()
        <input type="hidden" name="op" id="pt-bulk-op" /><input type="hidden" name="status" id="pt-bulk-status" />
        <input type="hidden" name="dueDate" id="pt-bulk-due" /><input type="hidden" name="contractorId" id="pt-bulk-contractor" /><input type="hidden" name="verslagId" id="pt-bulk-verslag" />
        <div id="pt-bulk-ids"></div>
    </form>
}
@if (Model.CanDelete)
{
    @await Html.PartialAsync("GlV2/_ModalConfirm", new GlV2ModalConfirmVm
    {
        Id = "pt-delete-modal", Tone = GlV2ModalTone.Danger, IconClass = "ph-trash", Title = "Punt verwijderen?", Description = "Het punt, de foto's en de historiek worden definitief verwijderd.",
        ConfirmLabel = "Verwijderen", FormAction = Url.Action("Delete", "ProjectsIssues", new { projectId = Model.ProjectId, id = 0 })!
    })
}
@if (Model.CanWrite)
{
    @await Html.PartialAsync("Partials/_PuntPanelV2", Model)
}

<form method="post" id="pt-print-form" action="@Url.Action("DownloadPdf", "ProjectsIssues", new { projectId = Model.ProjectId })" hidden>
    @Html.AntiForgeryToken()
    <div id="pt-print-ids"></div>
</form>

@section PageScripts
{
    <script src="https://cdn.datatables.net/v/bs5/jszip-3.10.1/dt-2.2.2/b-3.2.2/b-colvis-3.2.2/b-html5-3.2.2/b-print-3.2.2/datatables.min.js" integrity="sha384-GC9Im1BDtt06YOKSzkS553+5q43Nos2JSnLM31TjWFcFbzZrFhAtgCzrHDGM0iDy" crossorigin="anonymous"></script>
    <script src="~/js/gl-v2-project-inner-menu.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
    <script src="~/js/gl-v2-punt-planviewer.js" asp-append-version="true"></script>
    <script src="~/js/gl-v2-punt-panel.js" asp-append-version="true"></script>
    <script src="~/js/gl-v2-projecten-punten.js" asp-append-version="true"></script>
}
