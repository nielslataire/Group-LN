@using CPMCore.Models.Projecten
@model IProjectFormModel
@{
    var showExtended = ViewData["ShowExtendedPartners"] as bool? ?? false;
}

<section class="gl-form-section">
    <div class="gl-form-section__body">
        <div class="gl-form-section__head">
            <i class="bx bx-group" aria-hidden="true"></i>
            <div>
                <h2 class="gl-form-section__title">Partners</h2>
                <p class="gl-form-section__hint">De betrokken bedrijven en de facturatiebedrijven.</p>
            </div>
        </div>

        @Html.HiddenFor(m => m.Project.Developer.ID, new { id = "Project_Developer_ID" })
        @Html.HiddenFor(m => m.Project.Developer.Display, new { id = "Project_Developer_Display" })
        @Html.HiddenFor(m => m.Project.Builder.ID, new { id = "Project_Builder_ID" })
        @Html.HiddenFor(m => m.Project.Builder.Display, new { id = "Project_Builder_Display" })
        @Html.HiddenFor(m => m.Project.Notary.ID, new { id = "Project_Notary_ID" })
        @Html.HiddenFor(m => m.Project.Notary.Display, new { id = "Project_Notary_Display" })
        @if (showExtended)
        {
            @Html.HiddenFor(m => m.Project.Architect.ID, new { id = "Project_Architect_ID" })
            @Html.HiddenFor(m => m.Project.Architect.Display, new { id = "Project_Architect_Display" })
            @Html.HiddenFor(m => m.Project.Engineer.ID, new { id = "Project_Engineer_ID" })
            @Html.HiddenFor(m => m.Project.Engineer.Display, new { id = "Project_Engineer_Display" })
            @Html.HiddenFor(m => m.Project.SecurityCoordinator.ID, new { id = "Project_SecurityCoordinator_ID" })
            @Html.HiddenFor(m => m.Project.SecurityCoordinator.Display, new { id = "Project_SecurityCoordinator_Display" })
            @Html.HiddenFor(m => m.Project.EpbReporter.ID, new { id = "Project_EpbReporter_ID" })
            @Html.HiddenFor(m => m.Project.EpbReporter.Display, new { id = "Project_EpbReporter_Display" })
        }

        <div class="gl-field-grid">
            <div class="gl-field">
                <label for="DeveloperSelect">@Html.DisplayNameFor(m => m.Project.Developer)</label>
                <select id="DeveloperSelect" class="form-control w-100" aria-label="Projectontwikkelaar">
                    @if (Model.Project.Developer.ID > 0)
                    {
                        <option value="@Model.Project.Developer.ID" selected>@Model.Project.Developer.Display</option>
                    }
                </select>
            </div>
            <div class="gl-field">
                <label for="BuilderSelect">@Html.DisplayNameFor(m => m.Project.Builder)</label>
                <select id="BuilderSelect" class="form-control w-100" aria-label="Bouwheer">
                    @if (Model.Project.Builder.ID > 0)
                    {
                        <option value="@Model.Project.Builder.ID" selected>@Model.Project.Builder.Display</option>
                    }
                </select>
            </div>

            <div class="gl-field">
                <label for="Project_IssuerCompanyIdBuilder">@Html.DisplayNameFor(m => m.Project.IssuerCompanyIdBuilder)</label>
                @Html.DropDownListFor(m => m.Project.IssuerCompanyIdBuilder, new SelectList(Model.IssuerCompanies, nameof(ProjectIssuerCompanyOptionVM.Id), nameof(ProjectIssuerCompanyOptionVM.Name), Model.Project.IssuerCompanyIdBuilder), "-- Selecteer --", new { @class = "form-control form-control-modern", id = "Project_IssuerCompanyIdBuilder" })
            </div>
            <div class="gl-field">
                <label for="Project_IssuerCompanyIdLandOwner">@Html.DisplayNameFor(m => m.Project.IssuerCompanyIdLandOwner)</label>
                @Html.DropDownListFor(m => m.Project.IssuerCompanyIdLandOwner, new SelectList(Model.IssuerCompanies, nameof(ProjectIssuerCompanyOptionVM.Id), nameof(ProjectIssuerCompanyOptionVM.Name), Model.Project.IssuerCompanyIdLandOwner), "-- Selecteer --", new { @class = "form-control form-control-modern", id = "Project_IssuerCompanyIdLandOwner" })
            </div>

            @if (showExtended)
            {
                <div class="gl-field">
                    <label for="ArchitectSelect">@Html.DisplayNameFor(m => m.Project.Architect)</label>
                    <select id="ArchitectSelect" class="form-control w-100" aria-label="Architect">
                        @if (Model.Project.Architect.ID > 0)
                        {
                            <option value="@Model.Project.Architect.ID" selected>@Model.Project.Architect.Display</option>
                        }
                    </select>
                </div>
                <div class="gl-field">
                    <label for="EngineerSelect">@Html.DisplayNameFor(m => m.Project.Engineer)</label>
                    <select id="EngineerSelect" class="form-control w-100" aria-label="Ingenieur">
                        @if (Model.Project.Engineer.ID > 0)
                        {
                            <option value="@Model.Project.Engineer.ID" selected>@Model.Project.Engineer.Display</option>
                        }
                    </select>
                </div>
                <div class="gl-field">
                    <label for="SecuritySelect">@Html.DisplayNameFor(m => m.Project.SecurityCoordinator)</label>
                    <select id="SecuritySelect" class="form-control w-100" aria-label="Veiligheidscoördinator">
                        @if (Model.Project.SecurityCoordinator.ID > 0)
                        {
                            <option value="@Model.Project.SecurityCoordinator.ID" selected>@Model.Project.SecurityCoordinator.Display</option>
                        }
                    </select>
                </div>
                <div class="gl-field">
                    <label for="EpbSelect">@Html.DisplayNameFor(m => m.Project.EpbReporter)</label>
                    <select id="EpbSelect" class="form-control w-100" aria-label="EPB-verslaggever">
                        @if (Model.Project.EpbReporter.ID > 0)
                        {
                            <option value="@Model.Project.EpbReporter.ID" selected>@Model.Project.EpbReporter.Display</option>
                        }
                    </select>
                </div>
            }

            <div class="gl-field">
                <label for="NotarySelect">@Html.DisplayNameFor(m => m.Project.Notary)</label>
                <select id="NotarySelect" class="form-control w-100" aria-label="Notaris">
                    @if (Model.Project.Notary.ID > 0)
                    {
                        <option value="@Model.Project.Notary.ID" selected>@Model.Project.Notary.Display</option>
                    }
                </select>
            </div>
        </div>
    </div>
</section>
