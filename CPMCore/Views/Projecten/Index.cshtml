@using BOCore
@using CPMCore.Controllers
@using CPMCore.Models
@using Microsoft.Extensions.Configuration
@using System.Collections.Generic
@inject IConfiguration Configuration
@model CPMCore.Models.Projecten.ShowProjectsModel

@{
    ViewBag.Breadcrumbs = new List<Breadcrumb>()
    {
        new Breadcrumb("Home", nameof(HomeController.Index), "Home", true),
        new Breadcrumb("Projecten", nameof(ProjectenController.Index), "Projecten", false)
    };
}

@section PageStyle {
    <link rel="stylesheet" href="~/css/projecten-custom.css" />
}

<div class="row justify-content-between align-items-center mb-3 mb-sm-4">
    <div class="col">
        <h1 class="font-weight-bold mb-0">@ViewData["SubTitle"]</h1>
        <p class="mb-0">@ViewData["SubTitleText"]</p>
    </div>
    <div class="col-auto text-end mt-3 mt-sm-0">
        <a href="@Url.Action("Toevoegen", "Projecten")" class="btn btn-primary btn-md">
            <i class="bx bx-plus"></i><span class="d-none d-sm-inline"> Project toevoegen</span>
        </a>
    </div>
</div>

<div class="card card-modern mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-12 col-sm">
                <div class="input-group">
                    <span class="input-group-text"><i class="bx bx-search"></i></span>
                    <input id="search-term"
                           type="text"
                           class="form-control form-control-modern"
                           placeholder="Zoek op projectnaam of gemeente ...">
                </div>
            </div>
            <div class="col-12 col-sm-auto" id="colvis-container">
                <div class="input-group">
                    <span class="input-group-text"><i class="bx bx-filter"></i></span>
                    <select id="status-filter-select"
                            class="form-control form-control-modern">
                        <option value="*">Alle projecten</option>
                        @if (Model.Statuses != null)
                        {
                            foreach (var status in Model.Statuses)
                            {
                                <option value=".status-@status.Id">@status.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 🔥 Enige filterbron = selectbox → GEEN toolbar meer -->
<div class="row mg-files" id="project-grid" data-total-count="@Model.TotalProjectCount" data-loaded-count="@Model.VisibleProjectCount" data-batch-size="@Model.BatchSize">
    @if (Model.Projects != null && Model.Projects.Any())
    {
        @await Html.PartialAsync("_ProjectGridItems", new CPMCore.Models.Projecten.ProjectGridRenderModel
        {
            Projects  = Model.Projects,
            Statuses  = Model.Statuses  ?? new List<ProjectStatusBO>(),
            SalesData = Model.SalesData ?? new Dictionary<int, ProjectSalesDataBO>(),
            Voortgang = Model.Voortgang ?? new Dictionary<int, ProjectVoortgangBO>()
        })
        }
    else
    {
        <div class="col-12">
            <div class="alert alert-info">Er zijn momenteel geen projecten beschikbaar.</div>
        </div>
    }
</div>

<div class="text-center mt-4 @(Model.HasMoreProjects && Model.BatchSize > 0 ? string.Empty : "d-none")" id="load-more-container">
    <button type="button" id="load-more-projects" class="btn btn-primary" data-url="@Url.Action("LoadMoreProjects", "Projecten")">
        Laad meer
    </button>
    <div class="text-muted small mt-2">
        <span id="loaded-count">@Model.VisibleProjectCount</span> van <span id="total-count">@Model.TotalProjectCount</span> projecten geladen.
    </div>
</div>
@section PageScripts {
    <script src="https://unpkg.com/isotope-layout@3/dist/isotope.pkgd.min.js"></script>
    <script src="https://unpkg.com/imagesloaded@4/imagesloaded.pkgd.min.js"></script>

    <script>
        $(function () {

            var $grid = $('#project-grid');
            var $loadMoreButton = $('#load-more-projects');
            var $loadMoreContainer = $('#load-more-container');
            var totalCount = parseInt($grid.data('total-count')) || 0;
            var loadedCount = parseInt($grid.data('loaded-count')) || 0;
            var batchSize = parseInt($grid.data('batch-size')) || 0;
            var loadUrl = $loadMoreButton.data('url');
            var $loadedCountDisplay = $('#loaded-count');
            var $totalCountDisplay = $('#total-count');

            // ⭐ Init Isotope
            $grid.isotope({
                itemSelector: '.isotope-item',
                layoutMode: 'fitRows',
                percentPosition: true,
                filter: function () {
                    var searchText = qsRegex ? $(this).text().toLowerCase().match(qsRegex) : true;
                    var statusMatch = filterStatus ? $(this).is(filterStatus) : true;
                    return searchText && statusMatch;
                }
            });

            $grid.imagesLoaded(function () {
                $grid.isotope('layout');
                equalizeCardBodies();
            });

            updateProgress();

            if (!shouldShowLoadMore()) {
                $loadMoreContainer.hide();
            }


            // ------------------------------
            // ⭐ FILTERS: STATUS + SEARCH
            // ------------------------------

            var filterStatus = "*";   // huidige selectbox filter
            var qsRegex = null;       // zoek regex

            // ⭐ SELECTBOX → FILTER
            $('#status-filter-select').on('change', function () {
                filterStatus = $(this).val() || "*";
                $grid.isotope();
                relayout();
            });

            // ⭐ LIVE SEARCH (met debounce)
            var debounce = function (fn, delay) {
                var timer = null;
                return function () {
                    var context = this, args = arguments;
                    clearTimeout(timer);
                    timer = setTimeout(function () {
                        fn.apply(context, args);
                    }, delay);
                };
            };

            $('#search-term').on('keyup', debounce(function () {
                var query = $(this).val().toLowerCase();
                qsRegex = query.length ? new RegExp(query, 'gi') : null;
                $grid.isotope();
                relayout();
            }, 150));

            // ------------------------------
            // ⭐ HELPER: opnieuw layout + cards gelijk maken
            // ------------------------------

            function relayout() {
                setTimeout(function () {
                    $grid.isotope('layout');
                    equalizeCardBodies();
                }, 150);
            }

            function equalizeCardBodies() {
                // On mobile cards stack naturally — skip equalisation to avoid
                // changing heights after isotope has already positioned items.
                if (window.innerWidth < 768) {
                    $('.gl-project-card .card-body').css('min-height', '0');
                    $grid.isotope('layout');
                    return;
                }
                var maxH = 0;
                $('.gl-project-card .card-body').css('min-height', '0');

                $('.gl-project-card .card-body').each(function () {
                    var h = $(this).outerHeight();
                    if (h > maxH) maxH = h;
                });

                $('.gl-project-card .card-body').css('min-height', maxH + 'px');
                // Reposition items after height changes so nothing overlaps
                $grid.isotope('layout');
            }

            $(window).on('resize', equalizeCardBodies);
            $loadMoreButton.on('click', function () {
                if (!shouldShowLoadMore() || !loadUrl) {
                    return;
                }

                $loadMoreButton.prop('disabled', true).text('Laden...');

                $.get(loadUrl, { skip: loadedCount, take: batchSize })
                    .done(function (html) {
                        if (!html || !html.trim()) {
                            $loadMoreContainer.hide();
                            return;
                        }

                        var parsed = $.parseHTML(html, document, true) || [];
                        var $parsed = $(parsed);
                        var $items = $parsed.filter('.isotope-item');

                        if (!$items.length) {
                            $items = $parsed.find('.isotope-item');
                        }

                        if (!$items.length) {
                            $loadMoreContainer.hide();
                            return;
                        }

                        $grid.append($items).isotope('appended', $items);

                        $grid.imagesLoaded(function () {
                            equalizeCardBodies();
                            $grid.isotope('layout');
                        });

                        loadedCount += $items.length;
                        updateProgress();

                        if (!shouldShowLoadMore()) {
                            $loadMoreContainer.hide();
                        } else {
                            $loadMoreButton.prop('disabled', false).text('Laad meer');
                        }
                    })
                    .fail(function () {
                        $loadMoreButton.prop('disabled', false).text('Laad meer');
                    });
            });

            function updateProgress() {
                $loadedCountDisplay.text(Math.min(loadedCount, totalCount));
                $totalCountDisplay.text(totalCount);
            }

            function shouldShowLoadMore() {
                return batchSize > 0 && loadedCount < totalCount;
            }
        });
    </script>
}

