@using CPMCore.Controllers
@using BOCore
@using System.Globalization
@inject IConfiguration Configuration
@model CPMCore.Models.Projecten.ShowProjectDetail
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var canWriteProject = ViewBag.CanWriteProject as bool? ?? false;
    var canDeleteProject = ViewBag.CanDeleteProject as bool? ?? false;
    var be = CultureInfo.GetCultureInfo("nl-BE");
    ViewData["CoachmarkPageKey"] = "Projects.Detail";
}
@{
    ViewBag.Breadcrumbs = new List<Breadcrumb>()
	{
		new Breadcrumb("Home", nameof(HomeController.Index), "Home", true),
		new Breadcrumb("Projecten", nameof(ProjectenController.Index), "Projecten", true),
		new Breadcrumb("Detail", nameof(ProjectenController.Detail), "Projecten", false)
	};
}
@{
    String urlTotal = "";
}
@section PageStyle
{
    @* gl-mc-*/gl-page-header component library — zie DESIGN.md "Rol-dashboard
       componentbibliotheek"; hier voor het eerst buiten de Home-dashboards gebruikt. *@
    <link rel="stylesheet" href="~/css/dashboard-projectleider.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/projecten-custom.css" asp-append-version="true" />
}
@{
    // Projectacties leven nu in de topbar zelf (@section PageActions, gerenderd
    // door _Layout.cshtml naast pageTitle/breadcrumb) i.p.v. een eigen titelbalk
    // hier in de content-body — die was een letterlijke herhaling van de topbar.
    // Op mobiel (<768px) verbergt de topbar deze sectie bewust (minimale
    // 60px-balk); daarom hieronder ook een d-md-none fallback-rij met dezelfde
    // knoppen (via dezelfde partial), puur voor kleine schermen.
    var actionButtonsModel = new CPMCore.Models.Projecten.ProjectActionButtonsVM
    {
        ProjectId = Model.Project.Id,
        CanWrite = canWriteProject,
        CanDelete = canDeleteProject
    };
}
@section PageActions
{
    @await Html.PartialAsync("Partials/ProjectActionButtons", actionButtonsModel)
}
@Html.AntiForgeryToken()
<!-- start: page -->
<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", Model.Project.Id)
        <div class="inner-body gl-detail-body">
            <div class="d-flex d-md-none justify-content-end gap-2 mb-3">
                @await Html.PartialAsync("Partials/ProjectActionButtons", actionButtonsModel)
            </div>

            @{
                // KPI-strip (gl-kpi2-*): 7 tegels op uitdrukkelijke keuze van de
                // gebruiker; elke tegel is een link naar het bijhorende onderdeel
                // (Href), de 3 minst dringende (Secondary) vallen weg op < 576px.
                // Sub = de kleine tweede regel; RingPct != null geeft een donut-
                // icoon gevuld tot dat percentage (Fysiek/Financieel). Severe
                // kleurt de tegel Danger (Werkdagen te laat, Open punten > 0),
                // anders Primary — geen andere accentkleuren (One Green Rule).
                var kpiToday = DateOnly.FromDateTime(DateTime.Today);
                var overdueIssueCount = Model.OpenIssues.Count(i => i.DueDate.HasValue && i.DueDate.Value < kpiToday);

                // Omzet & potentieel: opgeteld uit exact dezelfde bedragen als de
                // "Eenheden & verkoopstatus"-tabel (grond + constructiewaarde per
                // eenheid, zónder afwerkingsopties) i.p.v. de aparte SalesData-
                // aggregatie die hier afweek. Omzet = verkochte eenheden;
                // potentieel = alle eenheden (verkocht + te koop). Eén geldformaat
                // (C0) overal — geen aparte "mio"-notatie meer.
                bool KpiIsSold(CPMCore.Models.Projecten.ProjectDetailUnitRowVM r) =>
                    r.Status == "Verkocht" || r.Status == "Akte verleden";
                var kpiOmzetVerkocht = Model.UnitRows.Where(KpiIsSold).Sum(r => r.Vraagprijs);
                // Potentieel = per eenheid de hoogst haalbare totaalwaarde:
                // verkocht -> de verkochte waarde; nog te koop -> grond + basis +
                // de DUURSTE afwerkingsoptie (Afwerkingen is leeg bij verkocht).
                var kpiOmzetPotentieel = Model.UnitRows.Sum(r =>
                    r.Vraagprijs + (r.Afwerkingen.Count > 0 ? r.Afwerkingen.Max(a => a.Cost) : 0m));

                var werkdagenLaat = Model.WorkingDaysLeft != -9999 && Model.WorkingDaysLeft < 0;
                var editUrl = Url.Action("Edit", "Projecten", new { projectid = Model.Project.Id });
                var recalcUrl = Url.Action("Recalculation", "Projecten", new { projectid = Model.Project.Id });

                // Href = klik-doorstroom naar de deelpagina; Secondary = valt weg
                // op een telefoon (< 576px) zodat de kern-tegels niet geperst worden.
                var kpiTiles = new List<(string Label, string Value, string? Sub, string Icon, bool Severe, decimal? RingPct, string Href, bool Secondary)>
                {
                    ("Status", Model.Project.Status?.Name ?? "—", null, "bx-flag", false, null, editUrl, true),
                    ("Verkocht", $"{Model.SalesData?.LivingUnitsSold ?? 0} / {Model.SalesData?.LivingUnits ?? 0} eenheden",
                        Model.SalesData is not null ? Model.SalesData.PercentageLivingUnitsSold.ToString("0.#", be) + "%" : null,
                        "bx-key", false, null, Url.Action("DetailClients", "Projecten", new { projectid = Model.Project.Id }), false),
                    ("Omzet", kpiOmzetVerkocht.ToString("C0", be),
                        kpiOmzetPotentieel > 0 ? "van " + kpiOmzetPotentieel.ToString("C0", be) + " potentieel" : null,
                        "bx-euro", false, null, Url.Action("DetailSales", "Projecten", new { projectid = Model.Project.Id }), true),
                    ("Fysiek", Model.Voortgang is not null ? Model.Voortgang.FysiekeVoortgangPct.ToString("0.#") + "%" : "—", "voortgang",
                        "bx-trending-up", false, Model.Voortgang?.FysiekeVoortgangPct, recalcUrl, false),
                    ("Financieel", Model.Voortgang is not null ? Model.Voortgang.FinancieleVoortgangPct.ToString("0.#") + "%" : "—", "voortgang",
                        "bx-wallet", false, Model.Voortgang?.FinancieleVoortgangPct, recalcUrl, true),
                    ("Werkdagen", Model.WorkingDaysLeft == -9999 ? "—" : (werkdagenLaat ? $"{-Model.WorkingDaysLeft} te laat" : Model.WorkingDaysLeft.ToString()),
                        Model.FinalConstructionDate != DateOnly.MinValue ? "tot " + Model.FinalConstructionDate.ToString("dd/MM/yy") : null,
                        "bx-calendar", werkdagenLaat, null, editUrl, false),
                    ("Open punten", Model.OpenIssuesCount.ToString(),
                        overdueIssueCount > 0 ? $"{overdueIssueCount} over datum" : null,
                        "bx-alert-circle", Model.OpenIssuesCount > 0, null, Url.Action("Index", "ProjectsIssues", new { projectId = Model.Project.Id }), false),
                };
            }
            <div class="gl-kpi2-strip mb-3">
                @foreach (var tile in kpiTiles)
                {
                    var kpiColorVar = tile.Severe ? "--danger" : "--primary";
                    <div class="gl-kpi2-tile-col@(tile.Secondary ? " gl-kpi2-tile-col--sec" : "")">
                        <a class="gl-kpi2-tile" href="@tile.Href" style="--kpi-color: var(@kpiColorVar);" aria-label="@tile.Label: @tile.Value@(tile.Sub is not null ? " (" + tile.Sub + ")" : "")">
                            @if (tile.RingPct.HasValue)
                            {
                                <div class="gl-kpi2-icon gl-kpi2-ring" style="--pct: @(tile.RingPct.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));">
                                    <div class="gl-kpi2-ring-inner"><i class="bx @tile.Icon" aria-hidden="true"></i></div>
                                </div>
                            }
                            else
                            {
                                <div class="gl-kpi2-icon"><i class="bx @tile.Icon" aria-hidden="true"></i></div>
                            }
                            <div class="gl-kpi2-body">
                                <div class="gl-kpi2-label">@tile.Label</div>
                                <div class="gl-kpi2-value @(tile.Severe ? "gl-kpi2-value-severe" : "")">@tile.Value</div>
                                @if (tile.Sub is not null)
                                {
                                    <div class="gl-kpi2-sub">@tile.Sub</div>
                                }
                            </div>
                        </a>
                    </div>
                }
            </div>

            <div class="gl-detail-mobile-title">@Model.Project.Name</div>
            <nav class="gl-detail-subnav" aria-label="Projectonderdelen">
                <a href="@Url.Action("DetailClients", "Projecten", new { projectid = Model.Project.Id })"><i class="bx bx-group" aria-hidden="true"></i>Klanten</a>
                <a href="@Url.Action("DetailUnits", "Projecten", new { projectid = Model.Project.Id })"><i class="bx bx-building-house" aria-hidden="true"></i>Eenheden</a>
                <a href="@Url.Action("DetailContracts", "Projecten", new { projectid = Model.Project.Id })"><i class="bx bx-briefcase" aria-hidden="true"></i>Leveranciers</a>
                <a href="@Url.Action("Index", "ProjectsIssues", new { projectId = Model.Project.Id })"><i class="bx bx-checklist" aria-hidden="true"></i>Punten</a>
                <a href="@Url.Action("DetailDocs", "Projecten", new { projectid = Model.Project.Id })"><i class="bx bx-folder" aria-hidden="true"></i>Documenten</a>
                <a href="@Url.Action("DetailInsurances", "Projecten", new { projectid = Model.Project.Id })"><i class="bx bx-shield" aria-hidden="true"></i>Verzekeringen</a>
                <a href="@Url.Action("Invoicing", "Projecten", new { projectid = Model.Project.Id })"><i class="bx bx-receipt" aria-hidden="true"></i>Facturatie</a>
                <a href="@Url.Action("PaymentStages", "Projecten", new { projectid = Model.Project.Id })"><i class="bx bx-euro" aria-hidden="true"></i>Betalingen</a>
                <a href="@Url.Action("Recalculation", "Projecten", new { projectid = Model.Project.Id })"><i class="bx bx-calculator" aria-hidden="true"></i>Nacalculatie</a>
                <a href="@Url.Action("BudgetIndex", "Projecten", new { projectId = Model.Project.Id })"><i class="bx bx-table" aria-hidden="true"></i>Budgetten</a>
                <a href="@Url.Action("DetailsChangeOrder", "Projecten", new { projectid = Model.Project.Id })"><i class="bx bx-edit" aria-hidden="true"></i>Wijzigingsopdrachten</a>
                <a href="@Url.Action("DetailPhotos", "Projecten", new { projectid = Model.Project.Id })"><i class="bx bx-images" aria-hidden="true"></i>Foto's</a>
            </nav>

            @{
                // Aandachtspaneel: dezelfde gl-mc-urgent/gl-mc-normal-groepering als de
                // Home-dashboards, hier gevuld met de opvolging die specifiek dit ene
                // project aangaat i.p.v. het hele portfolio. Tuple-lijst-aanpak (Tekst/
                // BekijkUrl/Icon/Categorie) is dezelfde techniek als
                // _DashboardProjectleider.cshtml's "meldingen"-opbouw, hier uitgebreid
                // met een Categorie-veld voor de filterchips.
                var attentionToday = DateOnly.FromDateTime(DateTime.Today);
                // Type/Entiteit/Extra i.p.v. één platte tekst — Type is het label
                // ("Contract niet getekend"), Entiteit de leverancier/klant/eenheid,
                // Extra een korte omschrijving (contractnaam, punt-titel, ...).
                var urgentItems = new List<(string Type, string? Entiteit, string? Extra, string? BekijkUrl, string Icon, string Categorie, string? Meta)>();
                var normalItems = new List<(string Type, string? Entiteit, string? Extra, string? BekijkUrl, string Icon, string Categorie, string? Meta)>();

                foreach (var c in Model.UnsignedContracts)
                {
                    string? meta = c.ContractSentDate.HasValue
                        ? $"{(DateTime.Today - c.ContractSentDate.Value).Days} dagen open"
                        : null;
                    urgentItems.Add(("Contract niet getekend", c.Company?.Display ?? "onbekende leverancier", c.ContractName,
                        Url.Action("EditContract", "Projecten", new { projectid = Model.Project.Id, contractid = c.Id }), "bx-file", "Contracten", meta));
                }
                foreach (var c in Model.GuaranteeMissingContracts)
                {
                    // Geen meta hier: er is geen datumveld dat "sinds wanneer ontbreekt
                    // dit" vastlegt (ContractSentDate hoort bij de andere melding,
                    // GuaranteeDocUploadedAt is enkel gezet zodra het document er wél is).
                    urgentItems.Add(("Bankwaarborg ontbreekt", c.Company?.Display ?? "onbekende leverancier", c.ContractName,
                        Url.Action("EditContract", "Projecten", new { projectid = Model.Project.Id, contractid = c.Id }), "bx-shield", "Contracten", null));
                }
                // Enkel voor projecten in uitvoering: een ontbrekende/verlopen
                // werfmelding en een ontbrekende/vervallen ABR-polis zijn dringend.
                if (Model.Project.Status?.Id == (int)ProjectStatusType.Uitvoering)
                {
                    var werfmeldingEditUrl = Url.Action("Edit", "Projecten", new { projectid = Model.Project.Id });
                    if (!Model.Project.WerfmeldingDate.HasValue)
                    {
                        urgentItems.Add(("Werfmelding ontbreekt", null,
                            "Project is in uitvoering maar er is nog geen werfmelding ingediend",
                            werfmeldingEditUrl, "bx-file", "Werf", null));
                    }
                    else if (Model.Project.WerfmeldingEndDate.HasValue && Model.Project.WerfmeldingEndDate.Value < attentionToday)
                    {
                        var werfEinde = Model.Project.WerfmeldingEndDate.Value;
                        var dagenVerlopen = (attentionToday.ToDateTime(TimeOnly.MinValue) - werfEinde.ToDateTime(TimeOnly.MinValue)).Days;
                        urgentItems.Add(("Werfmelding verlopen", null,
                            $"Einddatum {werfEinde.ToString("dd/MM/yyyy", be)} is verstreken — werfmelding verlengen",
                            werfmeldingEditUrl, "bx-calendar-x", "Werf", $"{dagenVerlopen} dagen verlopen"));
                    }

                    // ABR-polis: CheckInsurances() waarschuwt enkel voor bestaande
                    // ABR-polissen zonder einddatum; hier vullen we aan met de twee
                    // gevallen die daar buiten vallen — géén ABR-polis, en een
                    // ABR-polis met een verstreken einddatum.
                    var insurancesEditUrl = Url.Action("DetailInsurances", "Projecten", new { projectid = Model.Project.Id });
                    var abrPolicies = Model.Insurances.Where(i => i.Type == InsuranceType.ABR).ToList();
                    if (abrPolicies.Count == 0)
                    {
                        urgentItems.Add(("ABR-verzekering ontbreekt", null,
                            "Project is in uitvoering maar er is geen ABR-polis geregistreerd",
                            insurancesEditUrl, "bx-shield-x", "Financieel", null));
                    }
                    else if (abrPolicies.All(i => i.Enddate.HasValue && i.Enddate.Value < attentionToday))
                    {
                        var abrEinde = abrPolicies.Max(i => i.Enddate.Value);
                        var dagenVervallen = (attentionToday.ToDateTime(TimeOnly.MinValue) - abrEinde.ToDateTime(TimeOnly.MinValue)).Days;
                        urgentItems.Add(("ABR-verzekering vervallen", null,
                            $"ABR-polis vervallen sinds {abrEinde.ToString("dd/MM/yyyy", be)} — verlengen",
                            insurancesEditUrl, "bx-shield-x", "Financieel", $"{dagenVervallen} dagen vervallen"));
                    }
                }
                if (Model.Voortgang is not null)
                {
                    // WarningList geeft interne codes terug (OVERFACTURATIE, ...), geen
                    // zinnen — hier vertaald naar Type + een omschrijving met de
                    // werkelijke percentages, i.p.v. de rauwe code te tonen.
                    foreach (var code in Model.Voortgang.WarningList)
                    {
                        string vType; string vExtra;
                        switch (code)
                        {
                            case "OVERFACTURATIE":
                                vType = "Overfacturatie";
                                vExtra = $"Financiële voortgang ({Model.Voortgang.FinancieleVoortgangPct.ToString("0.#")}%) loopt voor op fysieke voortgang ({Model.Voortgang.FysiekeVoortgangPct.ToString("0.#")}%)";
                                break;
                            case "ONDERFACTURATIE":
                                vType = "Onderfacturatie";
                                vExtra = $"Fysieke voortgang ({Model.Voortgang.FysiekeVoortgangPct.ToString("0.#")}%) loopt voor op financiële voortgang ({Model.Voortgang.FinancieleVoortgangPct.ToString("0.#")}%)";
                                break;
                            case "KOSTENOVERSCHRIJDING":
                                vType = "Kostenoverschrijding";
                                vExtra = "Gefactureerd bedrag ligt meer dan 110% boven het gecontracteerde bedrag";
                                break;
                            case "GROTE_AFWIJKING":
                                vType = "Grote afwijking";
                                vExtra = $"Fysieke ({Model.Voortgang.FysiekeVoortgangPct.ToString("0.#")}%) en financiële voortgang ({Model.Voortgang.FinancieleVoortgangPct.ToString("0.#")}%) wijken sterk van elkaar af";
                                break;
                            default:
                                vType = "Voortgangswaarschuwing";
                                vExtra = code;
                                break;
                        }
                        urgentItems.Add((vType, null, vExtra, null, "bx-trending-down", "Financieel", null));
                    }
                }
                foreach (var w in Model.ProjectInsuranceWarnings.Where(x => x.Type == "danger"))
                {
                    // WarningBO.Display is één kant-en-klare zin die de projectnaam
                    // herhaalt — overbodig op de pagina van dat project zelf, dus
                    // eruit gehaald i.p.v. blind getoond.
                    var insExtra = w.Display?.Replace($" van project {Model.Project.Name}", "");
                    urgentItems.Add(("Verzekering", null, insExtra, Url.Action("DetailInsurances", "Projecten", new { projectid = Model.Project.Id }), "bx-shield-x", "Financieel", null));
                }
                foreach (var i in Model.OpenIssues.Where(x => x.Priority >= (int)ConstructionIssuePriority.High))
                {
                    string? meta = i.DueDate.HasValue
                        ? (i.DueDate.Value < attentionToday ? $"{(attentionToday.ToDateTime(TimeOnly.MinValue) - i.DueDate.Value.ToDateTime(TimeOnly.MinValue)).Days} dagen te laat" : $"Nog {(i.DueDate.Value.ToDateTime(TimeOnly.MinValue) - attentionToday.ToDateTime(TimeOnly.MinValue)).Days} dagen")
                        : null;
                    urgentItems.Add((i.Category?.Name ?? "Werfpunt", i.Unit?.Name, i.Title,
                        Url.Action("Details", "ProjectsIssues", new { projectId = Model.Project.Id, id = i.Id }), "bx-alert-circle", "Werf", meta));
                }

                foreach (var i in Model.OpenIssues.Where(x => x.Priority < (int)ConstructionIssuePriority.High))
                {
                    string? meta = i.DueDate.HasValue
                        ? (i.DueDate.Value < attentionToday ? $"{(attentionToday.ToDateTime(TimeOnly.MinValue) - i.DueDate.Value.ToDateTime(TimeOnly.MinValue)).Days} dagen te laat" : $"Nog {(i.DueDate.Value.ToDateTime(TimeOnly.MinValue) - attentionToday.ToDateTime(TimeOnly.MinValue)).Days} dagen")
                        : null;
                    normalItems.Add((i.Category?.Name ?? "Werfpunt", i.Unit?.Name, i.Title,
                        Url.Action("Details", "ProjectsIssues", new { projectId = Model.Project.Id, id = i.Id }), "bx-task", "Werf", meta));
                }
                foreach (var w in Model.ProjectInsuranceWarnings.Where(x => x.Type != "danger"))
                {
                    var insExtra = w.Display?.Replace($" van project {Model.Project.Name}", "");
                    normalItems.Add(("Verzekering", null, insExtra, Url.Action("DetailInsurances", "Projecten", new { projectid = Model.Project.Id }), "bx-shield", "Financieel", null));
                }

                var allAttentionItems = urgentItems.Concat(normalItems).ToList();
                var attentionCategories = new[] { "Contracten", "Werf", "Financieel" }
                    .Select(cat => (Naam: cat, Aantal: allAttentionItems.Count(i => i.Categorie == cat)))
                    .Where(c => c.Aantal > 0)
                    .ToList();
            }
            @{
                // "pictures/447/" bestaat enkel voor afbeeldingen; een video als
                // standaardfoto (MediaType == 1) heeft er geen en zou een gebroken
                // afbeelding geven.
                if (!string.IsNullOrEmpty(Model.Project.StandardFotoName))
                    urlTotal = Configuration["URL:ImageWebUrl"] + "pictures/447/" + Model.Project.StandardFotoName;
                else if (Model.Project.DefaultPicture?.Name is not null && Model.Project.DefaultPicture.MediaType != 1)
                    urlTotal = Configuration["URL:ImageWebUrl"] + "pictures/447/" + Model.Project.DefaultPicture.Name;
                else
                    urlTotal = "~/img/no_image.jpg";
            }
            @*HERO-RIJ 1: projectfoto + aandacht vereist — twee kaarten, gelijke hoogte*@
            <div class="row mb-3 gl-detail-hero-row gl-detail-hero-row-1">
                <div class="col-12 col-xl-4 mb-3 mb-xl-0 gl-detail-hero-cell">
                    @*PROJECTFOTO — de foto zelf is de kaart, geen aparte titelbalk erboven*@
                    <div class="card card-modern gl-detail-photo-card">
                        <div class="gl-detail-photo-wrap">
                            <img src="@Url.Content(urlTotal)" class="gl-detail-photo" alt="@Model.Project.Name"
                                 onerror="this.onerror=null;this.src='@Url.Content("~/img/no_image.jpg")';" />
                            @if (canWriteProject)
                            {
                                <button type="button" class="gl-detail-thumb-edit" id="editStandardFotoBtn" aria-label="Foto wijzigen" title="Foto wijzigen">
                                    <i class="bx bx-camera" aria-hidden="true"></i>
                                </button>
                                <input type="file" id="standardFotoInput" accept="image/*" hidden />
                                @if (!string.IsNullOrEmpty(Model.Project.StandardFotoName))
                                {
                                    <button type="button" class="gl-detail-thumb-remove" id="removeStandardFotoBtn" aria-label="Standaard foto verwijderen" title="Standaard foto verwijderen">
                                        <i class="bx bx-x" aria-hidden="true"></i>
                                    </button>
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12 col-xl-8 gl-detail-hero-cell">
                    @*AANDACHT VEREIST*@
                    <section class="card card-modern gl-mc-card gl-detail-mc-card">
                        <header class="card-header">
                            <h2 class="card-title">
                                <i class="bx bx-bell text-primary"></i>
                                Aandacht vereist
                            </h2>
                        </header>
                        @if (allAttentionItems.Any())
                        {
                            <div class="gl-mc-filters" role="group" aria-label="Filter op categorie">
                                <button type="button" class="gl-mc-filter-chip active" data-cat="alle" aria-pressed="true">Alles (@allAttentionItems.Count)</button>
                                @foreach (var cat in attentionCategories)
                                {
                                    <button type="button" class="gl-mc-filter-chip" data-cat="@cat.Naam" aria-pressed="false">@cat.Naam (@cat.Aantal)</button>
                                }
                            </div>
                            <div id="mcFilterStatus" class="visually-hidden" aria-live="polite"></div>
                        }
                        <div class="card-body p-0 gl-mc-body gl-mc-body-capped">
                            @if (urgentItems.Any())
                            {
                                <div class="gl-mc-group gl-mc-urgent">
                                    <div class="gl-mc-group-hdr">
                                        <i class="bx bx-alert-circle"></i> ACTIE VEREIST
                                        <span class="gl-mc-cnt">@urgentItems.Count</span>
                                    </div>
                                    <div class="gl-mc-group-body">
                                        @foreach (var item in urgentItems)
                                        {
                                            <a class="gl-mc-item gl-mc-item-urgent" data-cat="@item.Categorie" href="@item.BekijkUrl">
                                                <i class="bx @item.Icon gl-mc-item-icon"></i>
                                                <span class="gl-mc-item-text">
                                                    <strong>@item.Type</strong>@(item.Entiteit is not null ? " — " + item.Entiteit : "")@(item.Extra is not null ? " · " + item.Extra : "")
                                                </span>
                                                @if (item.Meta is not null || item.BekijkUrl is not null)
                                                {
                                                    <span class="gl-mc-item-actions">
                                                        @if (item.Meta is not null)
                                                        {
                                                            <span class="gl-mc-item-meta">@item.Meta</span>
                                                        }
                                                        @if (item.BekijkUrl is not null)
                                                        {
                                                            <span class="gl-mc-btn-bekijk">Bekijk <i class="bx bx-chevron-right" aria-hidden="true"></i></span>
                                                        }
                                                    </span>
                                                }
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                            @if (normalItems.Any())
                            {
                                <div class="gl-mc-group gl-mc-normal">
                                    <div class="gl-mc-group-hdr">
                                        <i class="bx bx-clock"></i> OP TE LOSSEN
                                        <span class="gl-mc-cnt">@normalItems.Count</span>
                                    </div>
                                    <div class="gl-mc-group-body">
                                        @foreach (var item in normalItems)
                                        {
                                            <a class="gl-mc-item gl-mc-item-normal" data-cat="@item.Categorie" href="@item.BekijkUrl">
                                                <i class="bx @item.Icon gl-mc-item-icon"></i>
                                                <span class="gl-mc-item-text">
                                                    <strong>@item.Type</strong>@(item.Entiteit is not null ? " — " + item.Entiteit : "")@(item.Extra is not null ? " · " + item.Extra : "")
                                                </span>
                                                @if (item.Meta is not null || item.BekijkUrl is not null)
                                                {
                                                    <span class="gl-mc-item-actions">
                                                        @if (item.Meta is not null)
                                                        {
                                                            <span class="gl-mc-item-meta">@item.Meta</span>
                                                        }
                                                        @if (item.BekijkUrl is not null)
                                                        {
                                                            <span class="gl-mc-btn-bekijk">Bekijk <i class="bx bx-chevron-right" aria-hidden="true"></i></span>
                                                        }
                                                    </span>
                                                }
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                            @if (!urgentItems.Any() && !normalItems.Any())
                            {
                                <div class="gl-mc-empty">
                                    <i class="bx bx-check-circle"></i>
                                    <span>Niets dat aandacht vraagt</span>
                                </div>
                            }
                        </div>
                    </section>
                </div>
            </div>

            @*TRAJECT-SAMENVATTING*@
            <div class="row mb-3">
                <div class="col-12">
                    @await Html.PartialAsync("_TrajectSummaryCard", Model.Project.Id)
                </div>
            </div>

            @*HERO-RIJ 2: algemene gegevens + eenheden & verkoopstatus — twee kaarten, gelijke hoogte*@
            <div class="row mb-3 gl-detail-hero-row gl-detail-hero-row-2">
                <div class="col-12 col-xl-4 mb-3 mb-xl-0 gl-detail-hero-cell">
                    @{
                        var projectLeaderName = Model.Users?.FirstOrDefault(x => x.Id == Model.Project.AspNetUserID)?.DisplayName;
                        var salesResponsibleName = Model.Users?.FirstOrDefault(x => x.Id == Model.Project.SalesResponsibleUserID)?.DisplayName;
                        var countryName = Model.Project.Postalcode?.Country?.Name;
                    }
                    @*ALGEMENE GEGEVENS*@
                    <div class="card card-modern card-modern-alt-padding gl-detail-card mb-0">
                        <header class="card-header gl-detail-card-header">
                            <h2 class="card-title mb-0">
                                <i class="bx bx-info-circle text-primary" aria-hidden="true"></i>
                                Algemene gegevens
                            </h2>
                            @if (canWriteProject)
                            {
                                <a href="@Url.Action("Edit", "Projecten", new { projectid = Model.Project.Id })" class="gl-detail-card-edit">
                                    <i class="bx bx-pencil" aria-hidden="true"></i><span>Bewerken</span>
                                </a>
                            }
                        </header>
                        <div class="card-body bg-light p-0">
                            <dl class="gl-detail-kv mb-0">
                                <div class="gl-detail-kv-row">
                                    <i class="bx bx-map" aria-hidden="true"></i>
                                    <dt>Adres</dt>
                                    <dd>
                                        @Model.Project.Street @Model.Project.HouseNumber<br />
                                        @Model.Project.Postalcode.Postcode @Model.Project.Postalcode.Gemeente@(string.IsNullOrWhiteSpace(countryName) ? "" : ", " + countryName)
                                    </dd>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Model.Project.ProjectCode))
                                {
                                    <div class="gl-detail-kv-row">
                                        <i class="bx bx-hashtag" aria-hidden="true"></i>
                                        <dt>Projectcode</dt>
                                        <dd>@Model.Project.ProjectCode</dd>
                                    </div>
                                }
                                @if (Model.Project.Status is not null && !string.IsNullOrWhiteSpace(Model.Project.Status.Name))
                                {
                                    <div class="gl-detail-kv-row">
                                        <i class="bx bx-pulse" aria-hidden="true"></i>
                                        <dt>Status</dt>
                                        <dd>@Model.Project.Status.Name</dd>
                                    </div>
                                }
                                @if (Model.Project.WheaterStation is not null && !string.IsNullOrWhiteSpace(Model.Project.WheaterStation.Name))
                                {
                                    <div class="gl-detail-kv-row">
                                        <i class="bx bx-cloud-sun" aria-hidden="true"></i>
                                        <dt>Weerstation</dt>
                                        <dd>@Model.Project.WheaterStation.Name</dd>
                                    </div>
                                }
                                @if (Model.Project.Developer is not null && !string.IsNullOrWhiteSpace(Model.Project.Developer.Display))
                                {
                                    <div class="gl-detail-kv-row">
                                        <i class="bx bx-buildings" aria-hidden="true"></i>
                                        <dt>Ontwikkelaar</dt>
                                        <dd>@Model.Project.Developer.Display</dd>
                                    </div>
                                }
                                @if (Model.Project.Builder is not null && !string.IsNullOrWhiteSpace(Model.Project.Builder.Display))
                                {
                                    <div class="gl-detail-kv-row">
                                        <i class="bx bx-hard-hat" aria-hidden="true"></i>
                                        <dt>Aannemer</dt>
                                        <dd>@Model.Project.Builder.Display</dd>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(projectLeaderName))
                                {
                                    <div class="gl-detail-kv-row">
                                        <i class="bx bx-user" aria-hidden="true"></i>
                                        <dt>Projectleider</dt>
                                        <dd>@projectLeaderName</dd>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(salesResponsibleName))
                                {
                                    <div class="gl-detail-kv-row">
                                        <i class="bx bx-user-voice" aria-hidden="true"></i>
                                        <dt>Verkoopverantw.</dt>
                                        <dd>@salesResponsibleName</dd>
                                    </div>
                                }
                                @if (Model.Project.Notary is not null && !string.IsNullOrWhiteSpace(Model.Project.Notary.Display))
                                {
                                    <div class="gl-detail-kv-row">
                                        <i class="bx bx-bank" aria-hidden="true"></i>
                                        <dt>Notaris</dt>
                                        <dd>@Model.Project.Notary.Display</dd>
                                    </div>
                                }
                                @if (Model.Project.Architect is not null && !string.IsNullOrWhiteSpace(Model.Project.Architect.Display))
                                {
                                    <div class="gl-detail-kv-row">
                                        <i class="bx bx-ruler" aria-hidden="true"></i>
                                        <dt>Architect</dt>
                                        <dd>@Model.Project.Architect.Display</dd>
                                    </div>
                                }
                                @if (Model.Project.Engineer is not null && !string.IsNullOrWhiteSpace(Model.Project.Engineer.Display))
                                {
                                    <div class="gl-detail-kv-row">
                                        <i class="bx bx-cube" aria-hidden="true"></i>
                                        <dt>Ingenieur stab.</dt>
                                        <dd>@Model.Project.Engineer.Display</dd>
                                    </div>
                                }
                                @if (Model.Project.SecurityCoordinator is not null && !string.IsNullOrWhiteSpace(Model.Project.SecurityCoordinator.Display))
                                {
                                    <div class="gl-detail-kv-row">
                                        <i class="bx bx-shield" aria-hidden="true"></i>
                                        <dt>Veiligheidsco&ouml;rd.</dt>
                                        <dd>@Model.Project.SecurityCoordinator.Display</dd>
                                    </div>
                                }
                                @if (Model.Project.EpbReporter is not null && !string.IsNullOrWhiteSpace(Model.Project.EpbReporter.Display))
                                {
                                    <div class="gl-detail-kv-row">
                                        <i class="bx bx-file" aria-hidden="true"></i>
                                        <dt>EPB-verslaggever</dt>
                                        <dd>@Model.Project.EpbReporter.Display</dd>
                                    </div>
                                }
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-xl-8 gl-detail-hero-cell">
                    @*EENHEDEN & VERKOOPSTATUS*@
                    <div class="card card-modern card-modern-alt-padding gl-detail-card mb-0">
                        <header class="card-header gl-detail-card-header">
                            <h2 class="card-title mb-0">Eenheden &amp; verkoopstatus <span class="text-muted small">(@Model.UnitRows.Count)</span></h2>
                            <a class="gl-detail-card-edit" href="@Url.Action("DetailSales", "Projecten", new { projectid = Model.Project.Id })">
                                <i class="bx bx-building-house" aria-hidden="true"></i><span>Alle eenheden</span>
                            </a>
                        </header>
                        <div class="card-body bg-light p-0">
                            @if (Model.UnitRows.Any())
                            {
                                <div class="gl-detail-units-search">
                                    <i class="bx bx-search" aria-hidden="true"></i>
                                    <input type="search" id="unitFilter" class="form-control form-control-sm"
                                           placeholder="Zoek een eenheid of klant…" autocomplete="off"
                                           aria-label="Eenheden filteren op eenheid of klant" />
                                </div>
                                <div class="gl-detail-units-scroll">
                                <div class="table-responsive gl-detail-units-body">
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th scope="col">Eenheid</th>
                                                <th scope="col">Type</th>
                                                <th scope="col" class="text-end">Opp.</th>
                                                <th scope="col" class="text-end">Vraag-/verkoopprijs</th>
                                                <th scope="col">Status</th>
                                                <th scope="col">Klant</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var u in Model.UnitRows)
                                            {
                                                <tr>
                                                    <td>
                                                        <a href="@Url.Action("EditUnit", "Projecten", new { projectid = Model.Project.Id, unitid = u.UnitId })" class="gl-detail-table-link">@u.Naam</a>
                                                    </td>
                                                    <td>@u.TypeName</td>
                                                    <td class="text-end">@(u.Oppervlakte.HasValue ? u.Oppervlakte.Value.ToString("0") + " m²" : "—")</td>
                                                    <td class="text-end">
                                                        @{
                                                            var effectiefVerkocht = u.Status == "Verkocht" || u.Status == "Akte verleden";
                                                        }
                                                        @if (effectiefVerkocht)
                                                        {
                                                            @* Verkocht pand: enkel grond + constructiewaarde, geen afwerkingsopties. *@
                                                            @u.Vraagprijs.ToString("C0", be)
                                                        }
                                                        else if (u.Afwerkingen.Count > 1)
                                                        {
                                                            <div>vanaf @((u.Vraagprijs + u.Afwerkingen.Min(a => a.Cost)).ToString("C0", be))</div>
                                                            <div class="gl-detail-row-sub">
                                                                @foreach (var afwerking in u.Afwerkingen)
                                                                {
                                                                    <div>@afwerking.Description: @((u.Vraagprijs + afwerking.Cost).ToString("C0", be))</div>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            @u.Vraagprijs.ToString("C0", be)
                                                            @if (u.Afwerkingen.Any())
                                                            {
                                                                <div class="gl-detail-row-sub">
                                                                    @foreach (var afwerking in u.Afwerkingen)
                                                                    {
                                                                        <div>+ @afwerking.Description (@afwerking.Cost.ToString("C0", be))</div>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                    </td>
                                                    <td><span class="badge bg-@u.StatusVariant">@u.Status</span></td>
                                                    <td>
                                                        @if (u.ClientId.HasValue)
                                                        {
                                                            <a href="@Url.Action("Detail", "Klanten", new { clientid = u.ClientId, projectid = Model.Project.Id })" class="gl-detail-table-link">@u.KlantNaam</a>
                                                        }
                                                        else
                                                        {
                                                            @:—
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                            <tr id="unitFilterNoResults" hidden>
                                                <td colspan="6" class="text-muted small p-3">Geen eenheid of klant gevonden.</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small p-3 mb-0">Nog geen eenheden ingesteld voor dit project.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="row gl-detail-cards-row">
                <div class="col-12 col-md-6 col-xl-3 mb-3">
                @*FACTURATIE*@
                    <div class="card card-modern card-modern-alt-padding gl-detail-card">
                        <header class="card-header gl-detail-card-header">
                            <h2 class="card-title mb-0">
                                <a href="@Url.Action("Invoicing", "Projecten", new { projectid = Model.Project.Id })" class="gl-detail-table-link">Facturatie</a>
                            </h2>
                            <a href="@Url.Action("Invoicing", "Projecten", new { projectid = Model.Project.Id })" class="gl-detail-card-edit">
                                <i class="bx bx-receipt" aria-hidden="true"></i><span>Facturatieblad</span>
                            </a>
                        </header>
                        <div class="card-body bg-light">
                            @if (Model.RecentInvoices.Any())
                            {
                                <div class="gl-detail-row-list">
                                    @foreach (var inv in Model.RecentInvoices)
                                    {
                                        <div class="gl-detail-row-item">
                                            <div class="gl-detail-row-main">
                                                <div class="gl-detail-row-title">
                                                    <a href="@Url.Action("Detail", "Invoices", new { id = inv.Id })" class="gl-detail-table-link">@(string.IsNullOrWhiteSpace(inv.PublicId) ? "Proforma" : inv.PublicId)</a>
                                                </div>
                                                <div class="gl-detail-row-sub">
                                                    @if (inv.ClientType == (int)InvoicePartyType.ClientAccount && inv.ClientId.HasValue)
                                                    {
                                                        <a href="@Url.Action("Detail", "Klanten", new { clientid = inv.ClientId, projectid = Model.Project.Id })" class="gl-detail-table-link">@inv.ClientName</a>
                                                    }
                                                    else
                                                    {
                                                        @inv.ClientName
                                                    }
                                                    &middot; @inv.StatusName
                                                </div>
                                            </div>
                                            <a href="@Url.Action("Detail", "Invoices", new { id = inv.Id })" class="gl-detail-row-value gl-detail-table-link">@((inv.Balance ?? 0m).ToString("C0", be))</a>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small mb-0">Nog geen facturen voor dit project.</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl-3 mb-3">
                @*VOORTGANG & BUDGET*@
                    <div class="card card-modern card-modern-alt-padding gl-detail-card" id="gl-detail-voortgang-card">
                        <header class="card-header gl-detail-card-header">
                            <h2 class="card-title mb-0">
                                <a href="@Url.Action("Recalculation", "Projecten", new { projectid = Model.Project.Id })" class="gl-detail-table-link">Voortgang &amp; budget</a>
                            </h2>
                            <a href="@Url.Action("Recalculation", "Projecten", new { projectid = Model.Project.Id })" class="gl-detail-card-edit">
                                <i class="bx bx-calculator" aria-hidden="true"></i><span>Nacalculatie</span>
                            </a>
                        </header>
                        <div class="card-body bg-light">
                            @{
                                string VbW(decimal pct) => Math.Clamp(pct, 0m, 100m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                var fysPct = Model.Voortgang?.FysiekeVoortgangPct ?? 0m;
                                var finPct = Model.Voortgang?.FinancieleVoortgangPct ?? 0m;
                                var soldPct = Model.SalesData?.PercentageSold ?? 0m;
                                var budgetPct = Model.Voortgang?.BudgetBestedPct ?? 0m;
                            }
                            <div class="gl-vb-list">
                                <div class="gl-vb-item gl-vb-fys">
                                    <div class="gl-vb-head">
                                        <span class="gl-vb-label">Fysieke voortgang</span>
                                        <span class="gl-vb-pct">@fysPct.ToString("0.#", be)%</span>
                                    </div>
                                    <div class="gl-vb-track"><div class="gl-vb-fill" style="--gl-vb-width:@VbW(fysPct)%"></div></div>
                                </div>
                                <div class="gl-vb-item gl-vb-fin">
                                    <div class="gl-vb-head">
                                        <span class="gl-vb-label">Financiële voortgang</span>
                                        <span class="gl-vb-pct">@finPct.ToString("0.#", be)%</span>
                                    </div>
                                    <div class="gl-vb-track"><div class="gl-vb-fill" style="--gl-vb-width:@VbW(finPct)%"></div></div>
                                </div>
                                <div class="gl-vb-item gl-vb-sold">
                                    <div class="gl-vb-head">
                                        <span class="gl-vb-label">Verkocht (waarde)</span>
                                        <span class="gl-vb-pct">@soldPct.ToString("0.#", be)%</span>
                                    </div>
                                    <div class="gl-vb-track"><div class="gl-vb-fill" style="--gl-vb-width:@VbW(soldPct)%"></div></div>
                                </div>
                                <div class="gl-vb-item gl-vb-budget@(budgetPct > 100m ? " gl-vb-over" : "")">
                                    <div class="gl-vb-head">
                                        <span class="gl-vb-label">Budget besteed</span>
                                        <span class="gl-vb-pct">@budgetPct.ToString("0.#", be)%</span>
                                    </div>
                                    <div class="gl-vb-track"><div class="gl-vb-fill" style="--gl-vb-width:@VbW(budgetPct)%"></div></div>
                                </div>
                            </div>
                            <div class="gl-vb-stats">
                                <div class="gl-vb-stat">
                                    <div class="gl-vb-stat-label">Budget</div>
                                    <div class="gl-vb-stat-value">@((Model.Voortgang?.TotaalBegroot ?? 0m).ToString("C0", be))</div>
                                    <div class="gl-vb-stat-sub">besteed @((Model.Voortgang?.TotaalGefactureerd ?? 0m).ToString("C0", be))</div>
                                </div>
                                <div class="gl-vb-stat">
                                    <div class="gl-vb-stat-label">Gecontracteerd</div>
                                    <div class="gl-vb-stat-value">@((Model.Voortgang?.TotaalGecontracteerd ?? 0m).ToString("C0", be))</div>
                                    <div class="gl-vb-stat-sub">@((Model.Voortgang?.ContractueleVolwassenheidPct ?? 0m).ToString("0.#", be))% van budget</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl-3 mb-3">
                @*DOCUMENTEN*@
                    <div class="card card-modern card-modern-alt-padding gl-detail-card">
                        <header class="card-header gl-detail-card-header">
                            <h2 class="card-title mb-0">
                                <a href="@Url.Action("DetailDocs", "Projecten", new { projectid = Model.Project.Id })" class="gl-detail-table-link">Documenten</a>
                            </h2>
                            <a href="@Url.Action("DetailDocs", "Projecten", new { projectid = Model.Project.Id })" class="gl-detail-card-edit">
                                <i class="bx bx-folder" aria-hidden="true"></i><span>Alle documenten</span>
                            </a>
                        </header>
                        <div class="card-body bg-light">
                            @{
                                (string Label, string Cls) DocBadge(string filename)
                                {
                                    var e = System.IO.Path.GetExtension(filename ?? string.Empty).TrimStart('.').ToLowerInvariant();
                                    var c = e switch
                                    {
                                        "pdf" => "gl-doc-pdf",
                                        "doc" or "docx" or "odt" or "rtf" => "gl-doc-word",
                                        "xls" or "xlsx" or "csv" or "ods" => "gl-doc-excel",
                                        "dwg" or "dxf" or "dwf" => "gl-doc-cad",
                                        "jpg" or "jpeg" or "png" or "gif" or "webp" or "tif" or "tiff" or "bmp" => "gl-doc-img",
                                        _ => string.Empty
                                    };
                                    var label = string.IsNullOrEmpty(e) ? "DOC" : (e.Length > 4 ? e.Substring(0, 4) : e).ToUpperInvariant();
                                    return (label, c);
                                }
                            }
                            @if (Model.LatestDocs.Any())
                            {
                                <div class="gl-doc-list">
                                    @foreach (var doc in Model.LatestDocs)
                                    {
                                        var badge = DocBadge(doc.Filename);
                                        var docTitle = string.IsNullOrWhiteSpace(doc.Name) ? doc.Type.GetDisplayName() : doc.Name;
                                        <a class="gl-doc-item" href="@Url.Action("ViewDoc", "Projecten", new { id = doc.Docid })" target="_blank" rel="noopener">
                                            <span class="gl-doc-badge @badge.Cls">@badge.Label</span>
                                            <span class="gl-doc-main">
                                                <span class="gl-doc-title">@docTitle</span>
                                                <span class="gl-doc-sub">@doc.Type.GetDisplayName()@(doc.DocDate.HasValue ? " · " + doc.DocDate.Value.ToString("dd/MM/yyyy") : "")</span>
                                            </span>
                                            <span class="gl-doc-open">Open</span>
                                        </a>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="gl-doc-empty mb-0">Nog geen documenten voor dit project.</p>
                            }

                            @if (canWriteProject)
                            {
                                <a class="gl-doc-add modal-with-form" href="#modaladddoc" rel="tooltip" data-placement="bottom" title="Document toevoegen">
                                    <i class="bx bx-plus" aria-hidden="true"></i><span>Document toevoegen</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl-3 mb-3">
                @*FOTOS & MEDIA*@
                    <div class="card card-modern card-modern-alt-padding gl-detail-card">
                        <header class="card-header gl-detail-card-header">
                            <h2 class="card-title mb-0">
                                <a href="@Url.Action("DetailPhotos", "Projecten", new { projectid = Model.Project.Id })" class="gl-detail-table-link">Foto's &amp; media</a>
                            </h2>
                            <a href="@Url.Action("DetailPhotos", "Projecten", new { projectid = Model.Project.Id })" class="gl-detail-card-edit">
                                <i class="bx bx-images" aria-hidden="true"></i><span>Alle foto's</span>
                            </a>
                        </header>
                        <div class="card-body bg-light">
                            @{
                                var fotos = Model.LatestPictures.Take(5).ToList();
                                var mediaBase = Configuration["URL:ImageWebURL"];
                            }
                            <div class="gl-detail-media-grid">
                                @foreach (var pic in fotos)
                                {
                                    var isVideoThumb = pic.MediaType == 1;
                                    <a href="@Url.Action("DetailPhotos", "Projecten", new { projectid = Model.Project.Id })" class="gl-detail-media-thumb@(isVideoThumb ? " is-video" : "")">
                                        @if (isVideoThumb)
                                        {
                                            @* Video's krijgen geen "pictures/447/"-thumbnail; toon het eerste frame. *@
                                            <video src="@Url.Content(mediaBase + "videos/" + pic.Name)" preload="metadata" muted playsinline
                                                   onerror="this.remove();"></video>
                                            <span class="gl-detail-media-play" aria-hidden="true"><i class="bx bx-play-circle"></i></span>
                                        }
                                        else
                                        {
                                            <img src="@Url.Content(mediaBase + "pictures/447/" + pic.Name)" alt="" loading="lazy"
                                                 onerror="this.remove();">
                                        }
                                    </a>
                                }
                                @for (var i = fotos.Count; i < 5; i++)
                                {
                                    <div class="gl-detail-media-empty" aria-hidden="true"></div>
                                }
                                @if (canWriteProject)
                                {
                                    <a class="gl-detail-media-add modal-with-form" href="#modaladdphoto" rel="tooltip" data-placement="bottom" title="Foto toevoegen" aria-label="Foto toevoegen">
                                        <i class="bx bx-plus" aria-hidden="true"></i>
                                    </a>
                                }
                                else
                                {
                                    <a class="gl-detail-media-add" href="@Url.Action("DetailPhotos", "Projecten", new { projectid = Model.Project.Id })" aria-label="Alle foto's">
                                        <i class="bx bx-images" aria-hidden="true"></i>
                                    </a>
                                }
                            </div>
                            @if (fotos.Count == 0)
                            {
                                <p class="text-muted small mt-3 mb-0">Nog geen foto's voor dit project.</p>
                            }
                            else if (Model.TotalPictureCount > fotos.Count)
                            {
                                <p class="text-muted small mt-3 mb-0">@fotos.Count van @Model.TotalPictureCount foto's</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
		</div>
    </div>
</section>
@if (canWriteProject)
{
    @await Html.PartialAsync("Modals/_ModalAddDoc", new CPMCore.Models.Projecten.ProjectDocModalVM
    {
        Document = new BOCore.ProjectDocBO { ProjectId = Model.Project.Id, Type = BOCore.ProjectDocType.Sales },
        Target = "Project",
        IsEditMode = false
    })
    @await Html.PartialAsync("Modals/_ModalAddPhoto", new BOCore.ProjectPictureBO { ProjectId = Model.Project.Id })
}
<div id="modaldeleteproject" class="modal-block modal-block-warning mfp-hide">
    <div id="delete-project-container"></div>
</div>
<div id="modalremovefoto" class="modal-block modal-block-warning mfp-hide">
    <section class="card">
        <header class="card-header">
            <h2 class="card-title">Standaard foto verwijderen?</h2>
        </header>
        <div class="card-body">
            <div class="modal-wrapper">
                <div class="modal-icon">
                    <i class="bx bx-help-circle" aria-hidden="true"></i>
                </div>
                <div class="modal-text">
                    <p>Weet u zeker dat u de standaard foto van dit project wilt verwijderen?</p>
                </div>
            </div>
        </div>
        <footer class="card-footer">
            <div class="row">
                <div class="col-md-12 text-end">
                    <button type="button" class="btn btn-warning" id="confirmRemoveFotoBtn">Verwijderen</button>
                    <button type="button" class="btn btn-default modal-dismiss">Annuleren</button>
                </div>
            </div>
        </footer>
    </section>
</div>

@section PageScripts {
    <script>
        // (De hero-kolommen krijgen hun hoogte nu puur uit CSS — geen
        //  JS-hoogtesynchronisatie meer; zie projecten-custom.css.)

        // Eenheden & verkoopstatus: filter de tabel op eenheid- of klantnaam.
        (function () {
            var input = document.getElementById('unitFilter');
            if (!input) return;
            var tbody = input.closest('.card-body')?.querySelector('.gl-detail-units-body tbody');
            if (!tbody) return;
            var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'))
                .filter(function (r) { return r.id !== 'unitFilterNoResults'; });
            var noResults = document.getElementById('unitFilterNoResults');

            input.addEventListener('input', function () {
                var q = input.value.trim().toLowerCase();
                var anyVisible = false;
                rows.forEach(function (row) {
                    var cells = row.querySelectorAll('td');
                    // 1e cel = eenheid, laatste cel = klant
                    var hay = ((cells[0] ? cells[0].textContent : '') + ' ' +
                               (cells.length ? cells[cells.length - 1].textContent : '')).toLowerCase();
                    var match = q === '' || hay.indexOf(q) !== -1;
                    row.hidden = !match;
                    if (match) anyVisible = true;
                });
                if (noResults) noResults.hidden = anyVisible || q === '';
            });
        })();

        function notify(title, text, type) {
            if (typeof PNotify !== 'undefined') {
                new PNotify({
                    title: title || '',
                    text: text || '',
                    type: type || 'info',
                    addclass: 'stack-bar-top',
                    stack: { dir1: 'down', dir2: 'right', push: 'top', spacing1: 5 }
                });
            } else {
                window.alert((title ? title + '\n' : '') + (text || ''));
            }
        }

        // Standaard foto AJAX upload
        document.getElementById('editStandardFotoBtn')?.addEventListener('click', function () {
            document.getElementById('standardFotoInput')?.click();
        });

        document.getElementById('standardFotoInput')?.addEventListener('change', function () {
            var file = this.files[0];
            if (!file) return;
            var input = this;
            var btn = document.getElementById('editStandardFotoBtn');

            // Client-side controle vóór het uploaden — een fout meteen benoemen
            // i.p.v. de server laten falen.
            if (!/^image\//.test(file.type)) {
                notify('Kan deze foto niet gebruiken', 'Kies een afbeeldingsbestand (JPG, PNG of WEBP).', 'error');
                input.value = '';
                return;
            }
            if (file.size > 10 * 1024 * 1024) {
                notify('Foto is te groot', 'De foto is ' + (file.size / 1048576).toFixed(1) + ' MB. Maximaal 10 MB — verklein de foto en probeer opnieuw.', 'error');
                input.value = '';
                return;
            }

            if (btn) { btn.disabled = true; btn.setAttribute('aria-busy', 'true'); btn.setAttribute('title', 'Bezig met uploaden…'); }

            var formData = new FormData();
            formData.append('projectId', '@Model.Project.Id');
            formData.append('file', file);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '');
            fetch('@Url.Action("UploadProjectStandardFoto", "Projecten")', { method: 'POST', body: formData })
                .then(r => r.json())
                .then(d => {
                    if (d.success) { notify('Foto opgeslagen', 'De projectfoto wordt vernieuwd…', 'success'); location.reload(); }
                    else { notify('Upload mislukt', d.error ?? 'De server kon de foto niet opslaan. Probeer opnieuw of neem contact op met de beheerder.', 'error'); resetBtn(); }
                })
                .catch(function () {
                    notify('Upload mislukt', 'Geen verbinding met de server. Controleer je netwerk en probeer opnieuw.', 'error');
                    resetBtn();
                });

            function resetBtn() {
                input.value = '';
                if (btn) { btn.disabled = false; btn.removeAttribute('aria-busy'); btn.setAttribute('title', 'Foto wijzigen'); }
            }
        });

        document.getElementById('removeStandardFotoBtn')?.addEventListener('click', function () {
            $.magnificPopup.open({ items: { src: '#modalremovefoto' }, type: 'inline' });
        });

        document.getElementById('confirmRemoveFotoBtn')?.addEventListener('click', function () {
            var btn = this;
            btn.disabled = true;
            fetch('@Url.Action("RemoveProjectStandardFoto", "Projecten")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'projectId=@Model.Project.Id&__RequestVerificationToken=' + encodeURIComponent(document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '')
            })
            .then(r => r.json())
            .then(d => {
                if (d.success) location.reload();
                else { notify('Verwijderen mislukt', 'De server kon de foto niet verwijderen. Probeer opnieuw of neem contact op met de beheerder.', 'error'); btn.disabled = false; }
            })
            .catch(function () {
                notify('Verwijderen mislukt', 'Geen verbinding met de server. Controleer je netwerk en probeer opnieuw.', 'error');
                btn.disabled = false;
            });
        });

        // KPI-ringen: bij het eerste zien naar hun waarde vegen (--pct 0 -> doel).
        (function () {
            if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            var rings = document.querySelectorAll('.gl-kpi2-ring');
            if (!rings.length) return;
            rings.forEach(function (r) {
                var target = r.style.getPropertyValue('--pct');
                r.style.setProperty('--pct', '0');
                void r.offsetWidth;
                requestAnimationFrame(function () { r.style.setProperty('--pct', target); });
            });
        })();

        // Aandachtspaneel: categoriefilter-chips
        var mcBody = document.querySelector('.gl-detail-mc-card .gl-mc-body-capped');
        document.querySelectorAll('.gl-mc-filter-chip').forEach(function (chip) {
            chip.addEventListener('click', function () {
                var cat = this.dataset.cat;
                if (mcBody) {
                    mcBody.classList.add('is-refiltering');
                    setTimeout(function () { mcBody.classList.remove('is-refiltering'); }, 140);
                }
                document.querySelectorAll('.gl-mc-filter-chip').forEach(function (c) {
                    c.classList.toggle('active', c === chip);
                    c.setAttribute('aria-pressed', c === chip ? 'true' : 'false');
                });
                document.querySelectorAll('.gl-mc-item').forEach(function (item) {
                    item.style.display = (cat === 'alle' || item.dataset.cat === cat) ? '' : 'none';
                });
                document.querySelectorAll('.gl-mc-group').forEach(function (group) {
                    var visible = Array.prototype.slice.call(group.querySelectorAll('.gl-mc-item'))
                        .some(function (item) { return item.style.display !== 'none'; });
                    group.style.display = visible ? '' : 'none';
                });
                var shown = document.querySelectorAll('.gl-mc-item').length
                    ? Array.prototype.filter.call(document.querySelectorAll('.gl-mc-item'), function (i) { return i.style.display !== 'none'; }).length
                    : 0;
                var status = document.getElementById('mcFilterStatus');
                if (status) {
                    status.textContent = (cat === 'alle' ? 'Alle aandachtspunten' : 'Categorie ' + cat)
                        + ': ' + shown + (shown === 1 ? ' punt' : ' punten') + ' getoond.';
                }
            });
        });

        $(document).on('click', '.delete-project-trigger', function (e) {
            e.preventDefault();
            const projectId = $(this).data('project-id');

            $('#delete-project-container').empty();

            $.get('@Url.Action("ModalDeleteProject", "Projecten")', { id: projectId })
                .done(function (html) {
                    $('#delete-project-container').html(html);
                    $.magnificPopup.open({
                        items: { src: '#modaldeleteproject' },
                        type: 'inline'
                    });
                })
                .fail(function () {
                    alert('Kon de verwijderbevestiging niet laden.');
                });
        });
    </script>
}
