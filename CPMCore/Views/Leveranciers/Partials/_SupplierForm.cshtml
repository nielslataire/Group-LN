@model CPMCore.Models.Leveranciers.SupplierFormViewModel
@using System.Linq
@using CPMCore.Models.Leveranciers

@{
    var groupedActivities = Model.Activities
        .GroupBy(a => string.IsNullOrWhiteSpace(a.GroupName) ? "Overige" : a.GroupName!)
        .OrderBy(g => g.Key)
        .ToList();

    var formRouteValues = Model.Id.HasValue ? new { id = Model.Id } : null;

    var vatCountryOptions = Model.Countries
        .Where(c => !string.IsNullOrWhiteSpace(c.IsoCode))
        .Select(c => new
        {
            Iso = c.IsoCode!.ToUpperInvariant(),
            Name = string.IsNullOrWhiteSpace(c.Name) ? c.IsoCode!.ToUpperInvariant() : c.Name!
        })
        .GroupBy(c => c.Iso)
        .Select(g => g.First())
        .OrderBy(c => c.Name)
        .ToList();

    var selectedCountryIso = Model.Countries
        .FirstOrDefault(c => c.Id == Model.SelectedCountryId)?.IsoCode?.ToUpperInvariant()
        ?? (Model.CountryCode ?? string.Empty).ToUpperInvariant();
    var isBelgianAddress = string.Equals(selectedCountryIso, "BE", StringComparison.OrdinalIgnoreCase);
    var belgianPostalClass = isBelgianAddress ? string.Empty : "d-none";
    var nonBelgianPostalClass = isBelgianAddress ? "d-none" : string.Empty;
    var vatStatusOptions = new[]
   {
        SupplierFormViewModel.VatStatusParticulier,
        SupplierFormViewModel.VatStatusNietBtwPlichtig,
        SupplierFormViewModel.VatStatusBtwPlichtig
    };
}

<div class="row">
    <div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
        <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
            <div class="row align-items-center">
                <div class="col-sm-auto d-flex align-items-center">
                    <a href="@Url.Action("Index", "Leveranciers")" class="text-decoration-none text-reset d-flex align-items-center">
                        <i class="bx bx-chevron-left fs-1"></i>
                    </a>
                </div>
                <div class="col-sm-auto">
                    <h1 class="fw-bold mb-0">@Model.Title</h1>
                    <h5 class="mb-4 mt-0">@Model.Subtitle</h5>
                </div>
            </div>
        </div>
    </div>
</div>

@using (Html.BeginForm(Model.Id.HasValue ? "Edit" : "Create", "Leveranciers", formRouteValues, FormMethod.Post, antiforgery: null, htmlAttributes: new { @class = "ecommerce-form action-buttons-fixed", id = "supplier-form" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(m => m.Id)

    <div class="row mt-2">
        <div class="col">
            <section class="card card-modern card-big-info">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-2-5 col-xl-1-5">
                            <i class="card-big-info-icon bx bx-buildings"></i>
                            <h2 class="card-big-info-title">Algemene info</h2>
                            <p class="card-big-info-desc">Vul de basisgegevens van de leverancier in.</p>
                        </div>
                        <div class="col-lg-3-5 col-xl-4-5">
                            <div class="form-group">
                                <div class="row align-items-center pb-3">
                                    <label class="col-lg-5 col-xl-3 control-label text-lg-end">@Html.LabelFor(m => m.SelectedIssuerCompanyIds)</label>
                                    <div class="col-lg-7 col-xl-8">
                                        <select id="SelectedIssuerCompanyIds" name="SelectedIssuerCompanyIds" class="form-control form-control-modern" multiple="multiple" data-plugin-multiselect data-plugin-options='{"maxHeight": 200, "includeSelectAllOption": true, "buttonWidth": "100%"}'>
                                            @foreach (var issuer in Model.IssuerCompanies)
                                            {
                                                var selected = Model.SelectedIssuerCompanyIds != null && Model.SelectedIssuerCompanyIds.Contains(issuer.Id);
                                                <option value="@issuer.Id" selected="@(selected ? "selected" : null)">@issuer.Name</option>
                                            }
                                        </select>
                                        @Html.ValidationMessageFor(m => m.SelectedIssuerCompanyIds, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="row align-items-center pb-3">
                                    <label class="col-lg-5 col-xl-3 control-label text-lg-end">@Html.LabelFor(m => m.Name)</label>
                                    <div class="col-lg-7 col-xl-8">
                                        <div class="row g-2">
                                            <div class="col-lg-4 col-xl-4">
                                                <select id="SelectedLegalFormId" name="SelectedLegalFormId" class="form-control form-control-modern populate">
                                                    <option value="">Bedrijfsvorm</option>
                                                    @foreach (var legal in Model.LegalForms)
                                                    {
                                                        <option value="@legal.Id" selected="@(Model.SelectedLegalFormId == legal.Id ? "selected" : null)">@legal.Name (@legal.Abbreviation)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-lg-8 col-xl-8">
                                                @Html.TextBoxFor(m => m.Name, new { @class = "form-control form-control-modern", placeholder = "Bedrijfsnaam" })
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="row align-items-center pb-3">
                                    <label class="col-lg-5 col-xl-3 control-label text-lg-end">@Html.LabelFor(m => m.EnterpriseNumber)</label>
                                    <div class="col-lg-7 col-xl-8">
                                        <div class="row g-2">
                                        <div class="col-lg-4 col-xl-4">
                                                <select id="EnterpriseNumberCountryCode" name="EnterpriseNumberCountryCode" class="form-control form-control-modern">
                                                    @foreach (var option in vatCountryOptions)
                                                    {
                                                        var selected = string.Equals(option.Iso, Model.EnterpriseNumberCountryCode, StringComparison.OrdinalIgnoreCase);
                                                        <option value="@option.Iso" selected="@(selected ? "selected" : null)">@option.Name (@option.Iso)</option>
                                                    }
                                                </select>
                                        </div>
                                        <div class="col-lg-8 col-xl-8">
                                            <div class="input-group">
                                                    @Html.TextBoxFor(m => m.EnterpriseNumber, new { @class = "form-control form-control-modern", placeholder = "Ondernemingsnummer", id = "enterprise-number", autocomplete = "off" })
                                            </div>
                                        </div>
                                        </div>
                                        <small class="text-muted d-block mt-1">Voer de landcode en het btw nummer in (bv. BE 0123456789).</small>
                                        @Html.ValidationMessageFor(m => m.EnterpriseNumber, "", new { @class = "text-danger" })
                                </div>
                                </div>
                                <div class="row align-items-center pb-3">
                                    <label class="col-lg-5 col-xl-3 control-label text-lg-end">@Html.LabelFor(m => m.VatNumber)</label>
                                    <div class="col-lg-7 col-xl-8">
                                        <div class="input-group">
                                            @Html.TextBoxFor(m => m.VatNumber, new { @class = "form-control form-control-modern", placeholder = "BTW nummer", id = "vat-number", autocomplete = "off" })
                                            <button type="button" class="btn btn-primary" id="btn-validate-vat"><i class="bx bx-check"></i><span class="d-none d-sm-inline ms-1">Controleren</span></button>
                                        </div>
                                        <small class="text-muted d-block mt-1">Voor Belgische ondernemingen is dit gelijk aan het ondernemingsnummer.</small>
                                        @Html.ValidationMessageFor(m => m.VatNumber, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="row align-items-center pb-3">
                                    <label class="col-lg-5 col-xl-3 control-label text-lg-end">@Html.LabelFor(m => m.VatStatus)</label>
                                    <div class="col-lg-7 col-xl-8">
                                        <select id="VatStatus" name="VatStatus" class="form-control form-control-modern populate">
                                            @foreach (var status in vatStatusOptions)
                                            {
                                                <option value="@status" selected="@(string.Equals(Model.VatStatus, status, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@status</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="row align-items-center pb-3">
                                    <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Adres</label>
                                    <div class="col-lg-4 col-xl-6 mb-2 mb-lg-0">
                                        @Html.TextBoxFor(m => m.Street, new { @class = "form-control form-control-modern", placeholder = "Straat", id = "Street" })
                                    </div>
                                    <div class="col-lg-1 col-xl-1 mb-2 mb-lg-0">
                                        @Html.TextBoxFor(m => m.HouseNumber, new { @class = "form-control form-control-modern", placeholder = "Nr", id = "HouseNumber" })
                                    </div>
                                    <div class="col-lg-1 col-xl-1">
                                        @Html.TextBoxFor(m => m.BusNumber, new { @class = "form-control form-control-modern", placeholder = "Bus", id = "BusNumber" })
                                    </div>
                                </div>
                                <div class="row align-items-center pb-3">
                                    <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Plaats</label>
                                    <div class="col-lg-3 col-xl-3 mb-2 mb-lg-0">
                                        <select id="SelectedCountryId" name="SelectedCountryId" class="form-control form-control-modern populate">
                                            @foreach (var country in Model.Countries)
                                            {
                                                <option value="@country.Id" data-isocode="@country.IsoCode" selected="@(Model.SelectedCountryId == country.Id ? "selected" : null)">@country.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-lg-3 col-xl-2 mb-2 mb-lg-0 @nonBelgianPostalClass" id="postal-manual-wrapper">
                                        @Html.TextBoxFor(m => m.PostalCode, new { @class = "form-control form-control-modern", placeholder = "Postcode", id = "PostalCode" })
                                    </div>
                                    <div class="col-lg-3 col-xl-5 mb-2 mb-lg-0 @belgianPostalClass" id="postal-select-wrapper">
                                        <select id="SelectedPostalCodeId" name="SelectedPostalCodeId" class="form-control form-control-modern populate postal-select" data-selected-text="@((Model.SelectedPostalCodeId.HasValue && !string.IsNullOrWhiteSpace(Model.PostalCode) && !string.IsNullOrWhiteSpace(Model.City)) ? ($"{Model.PostalCode} - {Model.City}") : string.Empty)">
                                            @if (Model.SelectedPostalCodeId.HasValue && !string.IsNullOrWhiteSpace(Model.PostalCode) && !string.IsNullOrWhiteSpace(Model.City))
                                            {
                                                <option value="@Model.SelectedPostalCodeId" selected="selected">@Model.PostalCode - @Model.City</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-lg-3 col-xl-3 mb-2 mb-lg-0 @nonBelgianPostalClass" id="city-manual-wrapper">
                                        @Html.TextBoxFor(m => m.City, new { @class = "form-control form-control-modern", placeholder = "Gemeente", id = "City" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col">
            <section class="card card-modern card-big-info">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-2-5 col-xl-1-5">
                            <i class="card-big-info-icon bx bxs-contact"></i>
                            <h2 class="card-big-info-title">Contact & Facturatie</h2>
                            <p class="card-big-info-desc">Contactgegevens, facturatie en activiteiten.</p>
                        </div>
                        <div class="col-lg-3-5 col-xl-4-5">
                            <div class="form-group">
                                <div class="row align-items-center pb-3">
                                    <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">@Html.LabelFor(m => m.Phone)</label>
                                    <div class="col-lg-7 col-xl-8">
                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="fas fa-phone"></i>
                                            </span>
                                            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control form-control-modern phone-mask", placeholder = "Telefoon", autocomplete = "tel" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row align-items-center pb-3">
                                    <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">@Html.LabelFor(m => m.Mobile)</label>
                                    <div class="col-lg-7 col-xl-8">
                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="fas fa-mobile-alt"></i>
                                            </span>
                                            @Html.TextBoxFor(m => m.Mobile, new { @class = "form-control form-control-modern mobile-mask", placeholder = "GSM", autocomplete = "tel-national" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row align-items-center pb-3">
                                    <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">@Html.LabelFor(m => m.Email)</label>
                                    <div class="col-lg-7 col-xl-8">
                                        @{
                                            var emailFeedbackId = $"{Html.IdFor(m => m.Email)}-feedback";
                                        }
                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="fas fa-envelope"></i>
                                            </span>
                                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control-modern email-validate", placeholder = "Email", type = "email", data_feedback = "#" + emailFeedbackId })
                                        </div>
                                        <div id="@emailFeedbackId" class="invalid-feedback d-none">
                                            Gelieve een geldig e-mailadres in te geven.
                                        </div>
                                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="row align-items-center pb-3">
                                    <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">@Html.LabelFor(m => m.InvoiceEmail)</label>
                                    <div class="col-lg-7 col-xl-8">
                                        @{
                                            var invoiceEmailFeedbackId = $"{Html.IdFor(m => m.InvoiceEmail)}-feedback";
                                        }
                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="fas fa-file-invoice"></i>
                                            </span>
                                            @Html.TextBoxFor(m => m.InvoiceEmail, new { @class = "form-control form-control-modern email-validate", placeholder = "Facturatie email", type = "email", data_feedback = "#" + invoiceEmailFeedbackId })
                                        </div>
                                        <div id="@invoiceEmailFeedbackId" class="invalid-feedback d-none">
                                            Gelieve een geldig e-mailadres in te geven.
                                        </div>
                                        @Html.ValidationMessageFor(m => m.InvoiceEmail, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="row align-items-center pb-3">
                                    <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">@Html.LabelFor(m => m.WebUrl)</label>
                                    <div class="col-lg-7 col-xl-8">
                                        <div class="input-group">
                                            <span class="input-group-text">
                                                <i class="fas fa-globe"></i>
                                            </span>
                                            @Html.TextBoxFor(m => m.WebUrl, new { @class = "form-control form-control-modern", placeholder = "Website" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row align-items-center pb-3">
                                    <label class="col-lg-5 col-xl-3 control-label text-lg-end pt-2">@Html.LabelFor(m => m.IsActive)</label>
                                    <div class="col-lg-7 col-xl-8">
                                        <div class="checkbox-custom checkbox-default checkbox-inline mt-2">
                                            @Html.CheckBoxFor(m => m.IsActive, new { data_plugin_ios_switch = "" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row align-items-center pb-3">
                                    <div class="col-lg-5 col-xl-3"></div>
                                    <div class="col-lg-7 col-xl-8">
                                        <div class="checkbox-custom checkbox-default">
                                            @Html.CheckBoxFor(m => m.RequiresDigitalInvoice, new { id = "checkboxDigitalInvoice" })
                                            <label for="checkboxDigitalInvoice">Digitale facturatie vereist</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row align-items-center pb-3">
                                    <div class="col-lg-5 col-xl-3"></div>
                                    <div class="col-lg-7 col-xl-8">
                                        <div class="checkbox-custom checkbox-default">
                                            @Html.CheckBoxFor(m => m.AttachUblByDefault, new { id = "checkboxAttachUbl" })
                                            <label for="checkboxAttachUbl">UBL standaard meesturen</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row align-items-center pb-3">
                                    <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">@Html.LabelFor(m => m.SelectedActivityIds)</label>
                                    <div class="col-lg-7 col-xl-8">
                                        <select id="SelectedActivityIds" name="SelectedActivityIds" class="form-control form-control-modern populate" multiple data-plugin-selectTwo>
                                            @foreach (var group in groupedActivities)
                                            {
                                                <optgroup label="@group.Key">
                                                    @foreach (var activity in group.OrderBy(a => a.Name))
                                                    {
                                                        var selected = Model.SelectedActivityIds != null && Model.SelectedActivityIds.Contains(activity.Id);
                                                        <option value="@activity.Id" selected="@(selected ? "selected" : null)">@activity.Name</option>
                                                    }
                                                </optgroup>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="row align-items-center pb-3">
                                    <div class="col-lg-5 col-xl-3"></div>
                                    <div class="col-lg-7 col-xl-8">
                                        <div class="checkbox-custom checkbox-default">
                                            @Html.CheckBoxFor(m => m.IsCustomer, new { id = "checkboxIsCustomer" })
                                            <label for="checkboxIsCustomer">Deze leverancier is ook klant</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col">
            <section class="card card-modern card-big-info">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-2-5 col-xl-1-5">
                            <i class="card-big-info-icon bx bxs-building-house"></i>
                            <h2 class="card-big-info-title">Afdelingen</h2>
                            <p class="card-big-info-desc">Voeg verschillende afdelingen toe met hun adresgegevens.</p>
                        </div>
                        <div class="col-lg-3-5 col-xl-4-5">
                            <div class="d-flex justify-content-end mb-3">
                                <a href="@Url.Action("BlankDepartmentRow", "Leveranciers")" class="btn btn-default btn-md" id="add-department" role="button"><i class="bx bx-plus me-2"></i>Afdeling toevoegen</a>
                            </div>
                            <div id="departmentRows">
                                @foreach (var department in Model.Departments)
                                {
                                    @Html.Partial("_SupplierDepartmentRow", department)
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col">
            <section class="card card-modern card-big-info">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-2-5 col-xl-1-5">
                            <i class="card-big-info-icon bx bxs-user-detail"></i>
                            <h2 class="card-big-info-title">Contacten</h2>
                            <p class="card-big-info-desc">Koppel meerdere contactpersonen aan de leverancier.</p>
                        </div>
                        <div class="col-lg-3-5 col-xl-4-5">
                            <div class="d-flex justify-content-end mb-3">
                                <a href="@Url.Action("BlankContactRow", "Leveranciers")" class="btn btn-default btn-md" id="add-contact" role="button"><i class="bx bx-plus me-2"></i>Contact toevoegen</a>
                            </div>
                            <div id="contactRows">
                                @foreach (var contact in Model.Contacts)
                                {
                                    @Html.Partial("_SupplierContactRow", contact)
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col d-flex justify-content-end gap-2">
            <a class="btn btn-default btn-md" href="@Url.Action("Index", "Leveranciers")">Annuleren</a>
            <button type="submit" class="btn btn-primary btn-md">Opslaan</button>
        </div>
    </div>
}

<div class="modal fade" id="vat-lookup-modal" tabindex="-1" aria-labelledby="vatLookupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="vatLookupModalLabel">Gegevens van het btw-nummer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Controleer de gevonden gegevens, pas ze indien nodig aan en kies dan voor "Gegevens overnemen".</p>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label mb-1" for="vatLookupName">Naam</label>
                        <input type="text" class="form-control form-control-modern" id="vatLookupName" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label mb-1" for="vatLookupStreet">Straat</label>
                        <input type="text" class="form-control form-control-modern" id="vatLookupStreet" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label mb-1" for="vatLookupHouseNumber">Nr</label>
                        <input type="text" class="form-control form-control-modern" id="vatLookupHouseNumber" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label mb-1" for="vatLookupPostal">Postcode</label>
                        <input type="text" class="form-control form-control-modern" id="vatLookupPostal" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label mb-1" for="vatLookupCity">Gemeente</label>
                        <input type="text" class="form-control form-control-modern" id="vatLookupCity" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label mb-1" for="vatLookupCountry">Land</label>
                        <select id="vatLookupCountry" class="form-control form-control-modern">
                            @foreach (var option in vatCountryOptions)
                            {
                                <option value="@option.Iso">@option.Name (@option.Iso)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-bs-dismiss="modal">Annuleren</button>
                <button type="button" class="btn btn-primary" id="btn-apply-vat-data">Gegevens overnemen</button>
            </div>
        </div>
    </div>
</div>