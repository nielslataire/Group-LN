@using System.Globalization
@using System.Linq
@model CPMCore.Models.Leveranciers.SupplierIndexViewModel

@{
    ViewData["Title"] ??= "Leveranciers";
    var currencyCulture = CultureInfo.CreateSpecificCulture("nl-BE");
    var groupedActivities = Model.Activities
        .GroupBy(a => string.IsNullOrWhiteSpace(a.GroupName) ? "Overige" : a.GroupName!)
        .OrderBy(g => g.Key)
        .ToList();
}

@section PageStyle
{
    <link rel="stylesheet" href="~/lib/select2/css/select2.css" />
    <link rel="stylesheet" href="~/lib/select2-bootstrap-theme/select2-bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-multiselect/css/bootstrap-multiselect.css" />
    <link rel="stylesheet" href="~/lib/magnific-popup/magnific-popup.css" />
    <link rel="stylesheet" href="~/lib/datatables/media/css/dataTables.bootstrap5.css" />
    <link href="https://cdn.datatables.net/v/bs5/jszip-3.10.1/dt-2.2.2/b-3.2.2/b-colvis-3.2.2/b-html5-3.2.2/b-print-3.2.2/datatables.min.css" rel="stylesheet" integrity="sha384-W8PzvGseaJlM52wTjdPHNrEA9WHp36V+XpQyv1gCKz+1sbFfDo5MlMDT7awB3rAs" crossorigin="anonymous">
    <style>
        #datatable-suppliers.dataTable > thead > tr > th,
        #datatable-suppliers.dataTable > tbody > tr > td {
            padding-top: 1rem !important;
            padding-bottom: 1rem !important;
            line-height: 1.2 !important;
            vertical-align: middle !important;
        }

        #datatable-suppliers td.actions {
            white-space: nowrap;
            width: 1%;
        }

            #datatable-suppliers td.actions i {
                line-height: 1 !important;
            }

        #datatable-suppliers th.actions {
            width: 1%;
            white-space: nowrap;
        }

        #datatable-suppliers_wrapper .dataTables_paginate {
            margin-top: 1rem;
        }
    </style>
}

<div class="row justify-content-between align-items-center pt-2 pe-0 mb-2">
    <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
        <h1 class="font-weight-bold mb-0 mt-0">Leveranciers</h1>
        <h5 class="mb-4 mt-0">Beheer en doorzoek alle leveranciers</h5>
    </div>
    <div class="col-sm-auto px-0">
        <a href="@Url.Action("Create", "Leveranciers", new { issuerCompanyId = Model.SelectedIssuerCompanyId })" class="btn btn-primary btn-md">+ Leverancier toevoegen</a>
    </div>
</div>

<div class="card card-modern mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-lg-4">
                <label class="form-label mb-1" for="search-term">Zoek leverancier</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bx bx-search"></i></span>
                    <input id="search-term"
                           type="text"
                           class="form-control form-control-modern me-2"
                           placeholder="Zoek je leverancier ...">
                </div>
            </div>
             <div class="col-lg-4">
                <label class="form-label mb-1" for="issuer-filter">Filter op facturatiebedrijf</label>
                <div class="input-group input-group-select-append">
                    <span class="input-group-text">
                        <i class="fas fa-filter"></i>
                    </span>
                    <select id="issuer-filter" class="form-control form-control-modern">
                        <option value="">Alle bedrijven</option>

                        @foreach (var issuer in Model.IssuerCompanies)
                        {
                            var selected = issuer.Id == Model.SelectedIssuerCompanyId ? "selected" : null;

                            <option value="@issuer.Id" selected="@selected">
                                @issuer.Name
                            </option>
                        }
                    </select>
                </div>
               
            </div>
            <div class="col-lg-4">
                <label class="form-label mb-1" for="activity-filter">Filter op activiteit</label>

                <select id="activity-filter" multiple data-plugin-selectTwo class="form-control form-control-modern populate">
                            @foreach (var group in groupedActivities)
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var activity in group.OrderBy(a => a.Name))
                                    {
                                        <option value="@activity.Id">@activity.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
            </div>
        </div>
    </div>
</div>

<div class="card card-modern">
    <div class="card-body">
        <div class="datatables-header-footer-wrapper mt-2">
            <div class="datatable-header d-flex justify-content-end mb-3" id="colvis-container"></div>
            <table class="table table-responsive-md table-hover mb-3" id="datatable-suppliers" style="min-width: 720px;">
                <thead>
                    <tr>
                        <th>Bedrijfsnaam</th>
                        <th>Ondernemingsnummer</th>
                        <th>GSM (indien niet telefoon)</th>
                        <th>Email</th>
                        <th>Totaal aantal contracten</th>
                        <th>Totaal bedrag contracten</th>
                        <th class="text-end noVis">Acties</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var canDelete = User.IsInRole("Admin") || User.IsInRole("Administrator");
                    }
                    @foreach (var supplier in Model.Suppliers)
                    {
                        var phone = supplier.PrimaryPhone;
                        var activityData = string.Join(",", supplier.ActivityIds);
                        var issuerData = string.Join(",", supplier.IssuerCompanyIds);
                        <tr data-activities="@activityData" data-issuers="@issuerData">
                            <td>
                                <a href="@Url.Action("Details", "Leveranciers", new { id = supplier.Id })" class="text-decoration-none text-reset fw-semibold">
                                    @supplier.Name
                                </a>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(supplier.EnterpriseNumber) ? "-" : supplier.EnterpriseNumber)</td>
                            <td>@(string.IsNullOrWhiteSpace(phone) ? "-" : phone)</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(supplier.Email))
                                {
                                    <a href="mailto:@supplier.Email">@supplier.Email</a>
                                }
                                else
                                {
                                    @:-
                                }
                            </td>
                            <td>@supplier.ContractCount</td>
                            <td>@supplier.TotalContractAmount.ToString("C", currencyCulture)</td>
                            <td class="actions text-end">
                                <a class="ms-1 me-1" data-placement="top" title="Bewerken" data-original-title="Bewerken" href="@Url.Action("Edit", "Leveranciers", new { id = supplier.Id })">
                                    <i class="bx bx-pencil fs-5"></i>
                                    <span class="visually-hidden">Bewerken</span>
                                </a>
                                @if (canDelete)
                                {
                                    <a href="#modaldeletesupplier" data-toggle="tooltip" data-placement="top" title="Verwijderen" data-original-title="Verwijderen" class="deleteSupplier ms-1 me-1" data-id="@supplier.Id">
                                        <i class="bx bx-trash fs-5 text-danger"></i>
                                        <span class="visually-hidden">Verwijderen</span>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div id="modaldeletesupplier" class="modal-block modal-block-warning mfp-hide">
    <div id="delete-supplier-container"></div>
</div>

@section PageScripts
{
    <script src="~/lib/select2/js/select2.js"></script>
    <script src="~/lib/bootstrap-multiselect/js/bootstrap-multiselect.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js" integrity="sha384-VFQrHzqBh5qiJIU0uGU5CIW3+OWpdGGJM9LBnGbuIH2mkICcFZ7lPd/AAtI7SNf7" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js" integrity="sha384-/RlQG9uf0M2vcTw3CX7fbqgbj/h8wKxw7C3zu9/GxcBPRKOEcESxaxufwRXqzq6n" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/v/bs5/jszip-3.10.1/dt-2.2.2/b-3.2.2/b-colvis-3.2.2/b-html5-3.2.2/b-print-3.2.2/datatables.min.js" integrity="sha384-GC9Im1BDtt06YOKSzkS553+5q43Nos2JSnLM31TjWFcFbzZrFhAtgCzrHDGM0iDy" crossorigin="anonymous"></script>
    <script src="~/lib/magnific-popup/jquery.magnific-popup.js"></script>
    <script>
        (function () {
            const entity = {
                singular: 'leverancier',
                plural: 'leveranciers'
            };

            function buildLanguage(e) {
                const capSing = e.singular.charAt(0).toUpperCase() + e.singular.slice(1);
                const capPlur = e.plural.charAt(0).toUpperCase() + e.plural.slice(1);

                return {
                    processing: "Bezig met verwerken…",
                    search: "Zoeken:",
                    lengthMenu: "Toon _MENU_",
                    info: `${capSing} _START_ tot _END_ van _TOTAL_ ${capPlur}`,
                    infoEmpty: `${capSing} 0 tot 0 van 0 ${capPlur}`,
                    infoFiltered: "(gefilterd uit _MAX_ totaal)",
                    loadingRecords: "Bezig met laden…",
                    zeroRecords: `Geen ${e.plural} om weer te geven`,
                    emptyTable: `Er zijn geen ${e.plural} om weer te geven`,
                    aria: {
                        sortAscending: ": activeer om oplopend te sorteren",
                        sortDescending: ": activeer om aflopend te sorteren"
                    }
                };
            }

            let selectedActivityIds = [];
            let selectedIssuerId = document.getElementById('issuer-filter')?.value || '';

            const suppliersTableElement = document.getElementById('datatable-suppliers');

            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                if (settings.nTable !== suppliersTableElement) {
                    return true;
                }

                if (!selectedActivityIds.length) {
                    return true;
                }

                const rowElement = settings.aoData[dataIndex]?.nTr;
                const rowActivities = (rowElement?.dataset.activities || '')
                    .toString()
                    .split(',')
                    .filter(Boolean);

                    if (selectedIssuerId) {
                    const rowIssuers = (rowElement?.dataset.issuers || '')
                        .toString()
                        .split(',')
                        .filter(Boolean);

                    if (!rowIssuers.includes(selectedIssuerId)) {
                        return false;
                    }
                }

                if (!selectedActivityIds.length) {
                    return true;
                }

                if (!rowActivities.length) {
                    return false;
                }

                return selectedActivityIds.every(id => rowActivities.includes(id));
            });

            const table = new DataTable('#datatable-suppliers', {
                dom: 'rtip',
                order: [[0, 'asc']],
                language: buildLanguage(entity),
                columnDefs: [
                    { targets: -1, orderable: false, searchable: false, className: 'text-end actions' }
                ],
                lengthChange: false,
                autoWidth: false,
                layout: {
                    topStart: {
                        buttons: [
                            {
                                extend: 'colvis',
                                text: '<i class="bx bx-filter me-2"></i><span>Kolommen</span>',
                                titleAttr: 'Selecteer kolommen',
                                attr: { "data-bs-toggle": "tooltip" },
                                columns: ':not(.noVis)',
                                init: function (api, node) {
                                    $(node).removeClass('btn-secondary').addClass('btn btn-default');
                                }
                            }
                        ]
                    }
                }
            });


            $('#search-term').on('input', function () {
                table.search($(this).val()).draw();
            });

            $('#activity-filter').select2({
                theme: 'bootstrap',
                placeholder: 'Alle activiteiten',
                allowClear: true,
                closeOnSelect: false,
                width: '100%',
                language: 'nl'
            }).on('change', function () {
                selectedActivityIds = $(this).val() || [];
                table.draw();
            });

            $('#issuer-filter').on('change', function () {
                selectedIssuerId = $(this).val() || '';
                table.draw();
            });


            const deleteModalSelector = '#modaldeletesupplier';
            const deleteContainerSelector = '#delete-supplier-container';
            const deleteUrl = '@Url.Action("ModalDelete", "Leveranciers")';

            $(document).on('click', '.deleteSupplier', function (e) {
                e.preventDefault();
                const id = $(this).data('id');

                $.get(`${deleteUrl}/${id}`, function (data) {
                    $(deleteContainerSelector).html(data);

                    $.magnificPopup.open({
                        items: {
                            src: deleteModalSelector
                        },
                        type: 'inline',
                        preloader: false,
                        focus: '#delete-supplier-container'
                    });
                });
            });
        })();
    </script>
}