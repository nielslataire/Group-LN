@model CPMCore.Models.Leveranciers.SupplierDeleteViewModel
<section class="card">
    <header class="card-header">
        <h2 class="card-title">Leverancier verwijderen?</h2>
    </header>
    <div class="card-body">
        <div class="modal-wrapper">
            <div class="modal-icon">
                <i class="fas fa-question-circle"></i>
            </div>
            <div class="modal-text">
                <p>U staat op het punt om @Model.Name te verwijderen. Bent u zeker dat u deze wilt verwijderen?</p>
            </div>
        </div>
    </div>
    <footer class="card-footer">
        <div class="row">
            <div class="col-md-12 text-end">
                @using (Html.BeginForm("Delete", "Leveranciers", new { id = Model.Id }, FormMethod.Post, null, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning">Verwijderen</button>
                }
                <button class="btn btn-default modal-dismiss">Annuleren</button>
            </div>
        </div>
    </footer>
</section>