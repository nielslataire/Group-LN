@model CPMCore.Models.Leveranciers.SupplierDetailViewModel
@using System.Globalization
@using System.Linq
@using CPMCore.Helpers

@{
    var currencyCulture = CultureInfo.CreateSpecificCulture("nl-BE");
    var departmentCount = Model.Departments?.Count() ?? 0;
    var contactCount = Model.Contacts?.Count() ?? 0;
    var contractCount = Model.Contracts?.Count() ?? 0;
    var invoiceCount = Model.Invoices?.Count() ?? 0;
}

@section PageStyle
{
    <link rel="stylesheet" href="~/css/klanten-custom.css" />
}

<div class="row justify-content-between align-items-center pt-2 pe-0 mb-3">
    <div class="col-sm-auto mb-3 mb-sm-0">
        <div class="d-flex align-items-center">
            <a href="@Url.Action("Index", "Leveranciers")" class="text-decoration-none text-reset d-flex align-items-center me-3">
                <i class="bx bx-chevron-left fs-1"></i>
            </a>
            <div>
                <h1 class="fw-bold mb-0">@Model.Name</h1>
                <h5 class="mb-0 text-muted">Leverancier detail</h5>
            </div>
        </div>
    </div>
    <div class="col-sm-auto text-sm-end">
        <div class="btn-group" role="group" aria-label="Leverancier acties">
            @if (Model.CanEdit)
            {
                <a href="@Url.Action("Edit", "Leveranciers", new { id = Model.Id })" class="btn btn-primary btn-md px-3 me-1">
                    <i class="bx bx-pencil me-1"></i>Bewerken
                </a>
            }
            @if (Model.CanDelete)
            {
                <a href="#modaldeletesupplier" id="delete-supplier-button" data-id="@Model.Id" class="btn btn-danger btn-md px-3">
                    <i class="bx bx-trash me-1"></i>Verwijderen
                </a>
            }
        </div>
    </div>
</div>

<div class="coord-tabs" role="tablist">
    <button class="coord-tab active" type="button" data-section-toggle="algemeen">Algemene Gegevens</button>
    <button class="coord-tab" type="button" data-section-toggle="afdelingen">Afdelingen (@departmentCount)</button>
    <button class="coord-tab" type="button" data-section-toggle="contacten">Contacten (@contactCount)</button>
    <button class="coord-tab" type="button" data-section-toggle="contracten">Contracten (@contractCount)</button>
    <button class="coord-tab" type="button" data-section-toggle="facturen">Facturen (@invoiceCount)</button>
</div>

<div id="supplier-general-section" class="supplier-section">
    <section class="card card-modern card-big-info">
        <div class="card-body">
            <div class="row">
                <div class="col-lg-2-5 col-xl-2-5">
                    <i class="card-big-info-icon bx bx-box"></i>
                    <h2 class="card-big-info-title">Algemene info</h2>
                    <p class="card-big-info-desc">Hier vindt u de basisgegevens van de leverancier.</p>
                </div>
                <div class="col-lg-3-5 col-xl-3-5">
                    <div class="col-md-12">
                        <span class="fw-semibold fs-6">Ondernemingsnummer</span>
                        <div class="text-muted">@(EnterpriseNumberFormatter.Format(Model.EnterpriseNumber, Model.CountryCode) ?? "-")</div>
                    </div>
                    <div class="col-md-12">
                        <span class="fw-semibold fs-6">Bedrijfsvorm</span>
                        <div class="text-muted">@(string.IsNullOrWhiteSpace(Model.LegalForm) ? "-" : Model.LegalForm)</div>
                    </div>
                    <div class="col-md-12">
                        <span class="fw-semibold fs-6">Adres</span>
                        <div class="text-muted">
                            @if (!string.IsNullOrWhiteSpace(Model.Street))
                            {
                                <text>@Model.Street @Model.HouseNumber @(string.IsNullOrWhiteSpace(Model.BusNumber) ? string.Empty : $" bus {Model.BusNumber}")</text>
                                <br />
                                <text>@Model.PostalCode @Model.City</text>
                                if (!string.IsNullOrWhiteSpace(Model.CountryName))
                                {
                                    <text><br />@Model.CountryName</text>
                                }
                            }
                            else
                            {
                                <text>-</text>
                            }
                        </div>
                    </div>
                    <div class="col-md-12">
                        <span class="fw-semibold fs-6">Activiteiten</span>
                        @if (Model.Activities.Any())
                        {
                            <div class="mt-2">
                                @foreach (var activity in Model.Activities)
                                {
                                    <span class="badge badge-default me-1 mb-1 fs-6">@activity</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="fw-semibold">-</div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </section>
    <section class="card card-modern card-big-info">
        <div class="card-body">
            <div class="row">
                <div class="col-lg-2-5 col-xl-2-5">
                    <i class="card-big-info-icon bx bxs-contact"></i>
                    <h2 class="card-big-info-title">Contact & facturatie</h2>
                    <p class="card-big-info-desc">Hier vindt u de contact en facturatiegegevens van de leverancier.</p>
                </div>
                <div class="col-lg-3-5 col-xl-3-5">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-3">
                            <span class="fw-semibold fs-6">Telefoon</span>
                            <div><i class="fas fa-phone me-2"></i>@(string.IsNullOrWhiteSpace(Model.Phone) ? "-" : Model.Phone)</div>
                        </li>
                        <li class="mb-3">
                            <span class="fw-semibold fs-6">GSM</span>
                            <div><i class="fas fa-mobile-alt me-2"></i>@(string.IsNullOrWhiteSpace(Model.Mobile) ? "-" : Model.Mobile)</div>
                        </li>
                        <li class="mb-3">
                            <span class="fw-semibold fs-6">Email</span>
                            <div>
                                <i class="fas fa-envelope me-2 text-primary"></i>
                                @if (!string.IsNullOrWhiteSpace(Model.Email))
                                {
                                    <a href="mailto:@Model.Email">@Model.Email</a>
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </div>
                        </li>
                        <li class="mb-3">
                            <span class="fw-semibold fs-6">Facturatie email</span>
                            <div>
                                <i class="fas fa-file-invoice me-2 text-primary"></i>
                                @if (!string.IsNullOrWhiteSpace(Model.InvoiceEmail))
                                {
                                    <a href="mailto:@Model.InvoiceEmail">@Model.InvoiceEmail</a>
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </div>
                        </li>
                        <li class="mb-3">
                            <span class="fw-semibold fs-6">Website</span>
                            <div>
                                <i class="fas fa-globe me-2 text-primary"></i>
                                @if (!string.IsNullOrWhiteSpace(Model.WebUrl))
                                {
                                    <a href="@Model.WebUrl" target="_blank" rel="noopener">@Model.WebUrl</a>
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </div>
                        </li>
                        <li>
                            <span class="fw-semibold fs-6">Facturatie instellingen</span>
                            <div class="mt-2">
                                <span class="badge @(Model.RequiresDigitalInvoice ? "bg-success" : "bg-secondary") me-1">Digitale factuur @(Model.RequiresDigitalInvoice ? "vereist" : "niet vereist")</span>
                                <span class="badge @(Model.AttachUblByDefault ? "bg-success" : "bg-secondary")">UBL standaard @(Model.AttachUblByDefault ? "aan" : "uit")</span>
                            </div>
                        </li>
                    </ul>

                </div>
            </div>
        </div>
    </section>
</div>

<section class="card card-modern supplier-section d-none" id="supplier-departments-section">
    <div class="card-body">
        <div class="d-flex align-items-center mb-3">
            <i class="bx bx-git-branch fs-3 me-2 text-primary"></i>
            <h4 class="mb-0">Afdelingen</h4>
        </div>
        @if (Model.Departments.Any())
        {
            <div class="row row-cols-1 row-cols-md-2 g-3">
                @foreach (var department in Model.Departments)
                {
                    <div class="col">
                        <div class="border rounded p-3 h-100">
                            <div class="fw-bold mb-2">@(!string.IsNullOrWhiteSpace(department.Name) ? department.Name : "Onbenoemde afdeling")</div>
                            <div class="small text-muted">Adres</div>
                            <div class="mb-2">
                                @(string.IsNullOrWhiteSpace(department.Street) ? "-" : $"{department.Street} {department.HouseNumber} {(string.IsNullOrWhiteSpace(department.Bus) ? string.Empty : "bus " + department.Bus)}")
                                <br />
                                @(string.IsNullOrWhiteSpace(department.PostalCode) ? string.Empty : $"{department.PostalCode} ")@department.City
                                @if (!string.IsNullOrWhiteSpace(department.CountryName))
                                {
                                    <text><br />@department.CountryName</text>
                                }
                            </div>
                            <div class="mb-1"><i class="fas fa-phone me-2 text-primary"></i>@(string.IsNullOrWhiteSpace(department.Phone) ? "-" : department.Phone)</div>
                            <div class="mb-1"><i class="fas fa-mobile-alt me-2 text-primary"></i>@(string.IsNullOrWhiteSpace(department.Mobile) ? "-" : department.Mobile)</div>
                            <div><i class="fas fa-envelope me-2 text-primary"></i>@(string.IsNullOrWhiteSpace(department.Email) ? "-" : department.Email)</div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="mb-0 text-muted">Er zijn nog geen afdelingen toegevoegd.</p>
        }
    </div>
</section>

<section class="card card-modern supplier-section d-none" id="supplier-contacts-section">
    <div class="card-body">
        <div class="d-flex align-items-center mb-3">
            <i class="bx bx-user fs-3 me-2 text-primary"></i>
            <h4 class="mb-0">Contacten</h4>
        </div>
        @if (Model.Contacts.Any())
        {
            <div class="row row-cols-1 row-cols-md-2 g-3">
                @foreach (var contact in Model.Contacts)
                {
                    var statusBadge = contact.PortaalStatus switch {
                        "Draft"             => ("badge-secondary", "Draft"),
                        "Invited"           => ("badge-info",      "Uitgenodigd"),
                        "PendingAcceptance" => ("badge-warning",   "In afwachting"),
                        "Redeemed"          => ("badge-success",   "Ingewisseld"),
                        "Active"            => ("badge-success",   "Actief"),
                        "Failed"            => ("badge-danger",    "Mislukt"),
                        "Revoked"           => ("badge-dark",      "Ingetrokken"),
                        _                  => ((string?)null, (string?)null)
                    };
                    <div class="col">
                        <div class="border rounded p-3 h-100 d-flex flex-column">
                            <div class="d-flex align-items-start justify-content-between gap-2 mb-1">
                                <div class="fw-bold">@(!string.IsNullOrWhiteSpace(contact.LastName) || !string.IsNullOrWhiteSpace(contact.FirstName) ? $"{contact.FirstName} {contact.LastName}".Trim() : "Onbekende contactpersoon")</div>
                                @if (statusBadge.Item1 != null)
                                {
                                    <span class="badge @statusBadge.Item1 flex-shrink-0" title="Portaalstatus">
                                        <i class="bx bx-buildings me-1"></i>@statusBadge.Item2
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(contact.Function))
                            {
                                <div class="text-muted small mb-2">@contact.Function</div>
                            }
                            <div class="mb-1"><i class="fas fa-phone me-2 text-primary"></i>@(string.IsNullOrWhiteSpace(contact.Phone) ? "-" : contact.Phone)</div>
                            <div class="mb-1"><i class="fas fa-mobile-alt me-2 text-primary"></i>@(string.IsNullOrWhiteSpace(contact.Mobile) ? "-" : contact.Mobile)</div>
                            <div class="mb-1"><i class="fas fa-envelope me-2 text-primary"></i>@(string.IsNullOrWhiteSpace(contact.Email) ? "-" : contact.Email)</div>
                            @if (!string.IsNullOrWhiteSpace(contact.DepartmentName))
                            {
                                <div class="text-muted small mb-2">Afdeling: @contact.DepartmentName</div>
                            }
                            @if (contact.LastLoginAt.HasValue)
                            {
                                <div class="text-muted small mb-2">
                                    <i class="bx bx-log-in me-1"></i>Laatste login: @contact.LastLoginAt.Value.ToLocalTime().ToString("dd/MM/yy HH:mm")
                                </div>
                            }
                            @if (contact.LinkedUserId.HasValue && contact.PortaalStatus != null)
                            {
                                <div class="text-muted small mb-2">
                                    <i class="bx bx-building me-1"></i>
                                    Toegang: @(contact.IsFullCompanyAdmin ? "Volledig bedrijf" : "Beperkt (eigen contracten als SiteManager)")
                                </div>
                            }
                            @* Portaalacties — alleen tonen als e-mail aanwezig is *@
                            @if (!string.IsNullOrWhiteSpace(contact.Email) && Model.CanEdit)
                            {
                                <div class="mt-auto pt-2 border-top d-flex flex-wrap gap-1">
                                    @if (contact.PortaalStatus == null || contact.PortaalStatus is "Failed" or "Revoked")
                                    {
                                        <form method="post" asp-action="InviteContact" asp-controller="Leveranciers">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="contactId" value="@contact.ContactId" />
                                            <input type="hidden" name="isFullAdmin" value="false" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                                <i class="bx bx-user-plus me-1"></i>Uitnodigen (beperkt)
                                            </button>
                                        </form>
                                        <form method="post" asp-action="InviteContact" asp-controller="Leveranciers">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="contactId" value="@contact.ContactId" />
                                            <input type="hidden" name="isFullAdmin" value="true" />
                                            <button type="submit" class="btn btn-sm btn-primary">
                                                <i class="bx bx-building me-1"></i>Uitnodigen (volledig)
                                            </button>
                                        </form>
                                    }
                                    else if (contact.LinkedUserId.HasValue)
                                    {
                                        <form method="post" asp-action="RevokeContactAccess" asp-controller="Leveranciers"
                                              onsubmit="return confirm('Portaaltoegang intrekken voor @($"{contact.FirstName} {contact.LastName}".Trim())?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="contactId" value="@contact.ContactId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bx bx-unlink me-1"></i>Toegang intrekken
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="mb-0 text-muted">Er zijn nog geen contacten toegevoegd.</p>
        }
    </div>
</section>

<section class="card card-modern supplier-section d-none" id="supplier-contracts-section">
    <div class="card-body">
        <div class="d-flex align-items-center mb-3">
            <i class="bx bx-file fs-3 me-2 text-primary"></i>
            <div>
                <h4 class="mb-0">Contracten</h4>
                <div class="text-muted small">Overzicht van alle gekoppelde contracten.</div>
            </div>
        </div>
        @if (Model.Contracts.Any())
        {
            <div class="row g-3">
                @foreach (var contract in Model.Contracts)
                {
                    <div class="col-12">
                        <div class="border rounded p-3 h-100">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                                <div>
                                    <div class="text-muted small">Project</div>
                                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(contract.ProjectName) ? "-" : contract.ProjectName)</div>
                                    <div class="text-muted small mt-2">Contractnummer</div>
                                    <div class="fw-semibold">@contract.Id</div>
                                </div>
                                <div class="text-end">
                                    <div class="text-muted small">Totale waarde</div>
                                    <div class="fw-bold fs-6">@contract.TotalAmount.ToString("C", currencyCulture)</div>
                                    <a href="@Url.Action("EditContract", "Projecten", new { projectid = contract.ProjectId, contractid = contract.Id })" class="btn btn-sm btn-primary mt-2">
                                        Details
                                    </a>
                                </div>
                            </div>
                            <hr class="my-3" />
                            <div class="row g-3 align-items-center">
                                <div class="col-md-4">
                                    <span class="text-muted small d-block">Aantal activiteiten</span>
                                    <div class="fw-semibold">@contract.ActivityCount</div>
                                </div>
                                <div class="col-md-4">
                                    <span class="text-muted small d-block">Contract #</span>
                                    <div class="fw-semibold">@contract.Id</div>
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <span class="text-muted small d-block">Project</span>
                                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(contract.ProjectName) ? "-" : contract.ProjectName)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="mb-0 text-muted">Er zijn geen contracten gekoppeld. </p>
        }
    </div>
</section>
<section class="card card-modern supplier-section d-none" id="supplier-invoices-section">
    <div class="card-body">
        <div class="d-flex align-items-center mb-3">
            <i class="bx bx-file fs-3 me-2 text-primary"></i>
            <div>
                <h4 class="mb-0">Facturen</h4>
                <div class="text-muted small">Overzicht van alle facturen voor deze leverancier.</div>
            </div>
        </div>
        @if (Model.Invoices.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Factuurdatum</th>
                            <th>Externe referentie</th>
                            <th>Project</th>
                            <th class="text-end">Factuurbedrag</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in Model.Invoices)
                        {
                            <tr>
                                <td>@invoice.InvoiceDate.ToString("dd/MM/yyyy")</td>
                                <td>@(string.IsNullOrWhiteSpace(invoice.ExternalInvoiceId) ? "-" : invoice.ExternalInvoiceId)</td>
                                <td>@(string.IsNullOrWhiteSpace(invoice.ProjectName) ? "-" : invoice.ProjectName)</td>
                                <td class="text-end">@invoice.Amount.ToString("C", currencyCulture)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="mb-0 text-muted">Er zijn nog geen facturen gekoppeld aan deze leverancier.</p>
        }
    </div>
</section>

<div id="modaldeletesupplier" class="modal-block modal-block-warning mfp-hide">
    <div id="delete-supplier-container"></div>
</div>
@section PageScripts {
    <script>
        (function () {
            const sectionButtons = document.querySelectorAll('[data-section-toggle]');
            const sections = {
                algemeen: document.getElementById('supplier-general-section'),
                afdelingen: document.getElementById('supplier-departments-section'),
                contacten: document.getElementById('supplier-contacts-section'),
                 contracten: document.getElementById('supplier-contracts-section'),
                facturen: document.getElementById('supplier-invoices-section')
            };

            sectionButtons.forEach((button) => {
                button.addEventListener('click', () => {
                    const target = button.getAttribute('data-section-toggle');

                    sectionButtons.forEach((btn) => btn.classList.remove('active'));
                    button.classList.add('active');

                    Object.values(sections).forEach((section) => section?.classList.add('d-none'));
                    sections[target]?.classList.remove('d-none');
                });
            });
        })();

        $(function () {
            const deleteModalSelector = '#modaldeletesupplier';
            const deleteContainerSelector = '#delete-supplier-container';
            const deleteUrl = '@Url.Action("ModalDelete", "Leveranciers")';

            $(document).on('click', '#delete-supplier-button', function (e) {
                e.preventDefault();
                const id = $(this).data('id');

                $(deleteContainerSelector).empty();

                $.get(`${deleteUrl}/${id}`, function (data) {
                    $(deleteContainerSelector).html(data);

                    $.magnificPopup.open({
                        items: {
                            src: deleteModalSelector
                        },
                        type: 'inline',
                        preloader: false,
                        focus: '#delete-supplier-container'
                    });
                });
            });
        });
    </script>
}
