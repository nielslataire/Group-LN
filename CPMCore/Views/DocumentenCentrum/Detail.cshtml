@model FacadeCore.IncomingInvoiceDetailVm
@using DALCore.Models
@using BOCore
@{
    ViewData["Title"] = $"Document — {Model.InvoiceNumber}";
    var projects = ViewBag.Projects as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                   ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2 align-items-center">
            <div class="col-sm-7">
                <h1 class="m-0">
                    <i class="bx bx-file-blank me-2" aria-hidden="true"></i>
                    @Model.SupplierName
                    <small class="text-muted fs-6">— @Model.InvoiceNumber</small>
                </h1>
            </div>
            <div class="col-sm-5 d-flex justify-content-end gap-2">
                <a href="@Url.Action("Index", "DocumentenCentrum", new { issuerCompanyId = Model.IssuerCompanyId })"
                   class="btn btn-secondary btn-sm">
                    <i class="bx bx-arrow-back"></i> Terug
                </a>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-@TempData["MessageType"] alert-dismissible fade show" role="alert">
                <strong>@TempData["MessageTitle"]</strong> @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row">

            @* ── Linkerkolom: documentgegevens ── *@
            <div class="col-lg-8">

                @* Document metadata *@
                <div class="card mb-3">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <span class="fw-semibold"><i class="bx bx-info-circle me-1"></i> Documentgegevens</span>
                        <span class="badge @Model.StatusBadgeClass">@Model.StatusLabel</span>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label text-muted small">Facturatiebedrijf</label>
                                <div class="fw-semibold">@Model.IssuerCompanyName</div>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label text-muted small">Type document</label>
                                <div>@(Model.DocumentType == "Invoice" ? "Factuur" : Model.DocumentType == "CreditNote" ? "Creditnota" : Model.DocumentType)</div>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label text-muted small">Leverancier</label>
                                <div class="fw-semibold">@Model.SupplierName</div>
                                @if (!string.IsNullOrEmpty(Model.SupplierVatNumber))
                                {
                                    <small class="text-muted">@Model.SupplierVatNumber</small>
                                }
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label text-muted small">Factuurnummer</label>
                                <div class="fw-semibold">@Model.InvoiceNumber</div>
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label text-muted small">Factuurdatum</label>
                                <div>@Model.InvoiceDate.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label text-muted small">Vervaldatum</label>
                                <div class="@(Model.DueDate.HasValue && Model.DueDate.Value < DateOnly.FromDateTime(DateTime.Today) && Model.StatusId < IncomingInvoiceStatus.Paid ? "text-danger fw-semibold" : "")">
                                    @(Model.DueDate.HasValue ? Model.DueDate.Value.ToString("dd/MM/yyyy") : "—")
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label text-muted small">Valuta</label>
                                <div>@Model.CurrencyCode</div>
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label text-muted small">Netto</label>
                                <div>@(Model.NetAmount.HasValue ? Model.NetAmount.Value.ToString("N2") : "—")</div>
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label text-muted small">BTW</label>
                                <div>@(Model.VatAmount.HasValue ? Model.VatAmount.Value.ToString("N2") : "—")</div>
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label text-muted small">Totaal incl. BTW</label>
                                <div class="fw-bold fs-5">@Model.TotalAmountInclVat.ToString("N2") @Model.CurrencyCode</div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Notes))
                            {
                                <div class="col-12">
                                    <label class="form-label text-muted small">Notities</label>
                                    <div class="text-break">@Model.Notes</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* Bijlagen — PDF bovenaan, UBL/XML onderaan *@
                @if (Model.Attachments.Any())
                {
                    var pdfAtt = Model.Attachments.FirstOrDefault(a => a.AttachmentType == "PDF");
                    var otherAtts = Model.Attachments.Where(a => a.AttachmentType != "PDF").ToList();

                    @* Inline PDF preview *@
                    @if (pdfAtt != null)
                    {
                        <div class="card mb-3">
                            <div class="card-header d-flex align-items-center justify-content-between">
                                <span class="fw-semibold">
                                    <i class="bx bxs-file-pdf text-danger me-1"></i> @pdfAtt.FileName
                                    @if (pdfAtt.FileSizeBytes.HasValue)
                                    {
                                        <small class="text-muted ms-2">@FormatFileSize(pdfAtt.FileSizeBytes.Value)</small>
                                    }
                                </span>
                                <a href="@Url.Action("DownloadAttachment", "DocumentenCentrum", new { attachmentId = pdfAtt.Id })"
                                   class="btn btn-outline-secondary btn-sm">
                                    <i class="bx bx-download"></i> Downloaden
                                </a>
                            </div>
                            <div class="card-body p-0">
                                <iframe src="@Url.Action("ViewAttachment", "DocumentenCentrum", new { attachmentId = pdfAtt.Id })"
                                        style="width:100%;height:700px;border:none;" title="Factuur PDF"></iframe>
                            </div>
                        </div>
                    }

                    @* Overige bijlagen (UBL/XML, Other) *@
                    @if (otherAtts.Any())
                    {
                        <div class="card mb-3">
                            <div class="card-header fw-semibold">
                                <i class="bx bx-paperclip me-1"></i> Overige bijlagen (@otherAtts.Count)
                            </div>
                            <div class="card-body p-0">
                                <ul class="list-group list-group-flush">
                                    @foreach (var att in otherAtts)
                                    {
                                        <li class="list-group-item d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center gap-2">
                                                @if (att.AttachmentType == "UBL")
                                                {
                                                    <i class="bx bxs-file-xml text-success fs-5"></i>
                                                }
                                                else
                                                {
                                                    <i class="bx bxs-file text-muted fs-5"></i>
                                                }
                                                <div>
                                                    <div class="fw-semibold">@att.FileName</div>
                                                    @if (att.FileSizeBytes.HasValue)
                                                    {
                                                        <small class="text-muted">@FormatFileSize(att.FileSizeBytes.Value)</small>
                                                    }
                                                </div>
                                            </div>
                                            <a href="@Url.Action("DownloadAttachment", "DocumentenCentrum", new { attachmentId = att.Id })"
                                               class="btn btn-outline-secondary btn-sm">
                                                <i class="bx bx-download"></i>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                }

                @* Detaillijnen *@
                @if (Model.Lines.Any())
                {
                    <div class="card mb-3">
                        <div class="card-header fw-semibold">
                            <i class="bx bx-list-ul me-1"></i> Detaillijnen
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Omschrijving</th>
                                        <th class="text-end text-nowrap">Bedrag (excl. BTW)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in Model.Lines)
                                    {
                                        <tr>
                                            <td>@line.Description</td>
                                            <td class="text-end text-nowrap">
                                                @(line.Price.HasValue ? line.Price.Value.ToString("N2") : "—")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light fw-semibold">
                                    <tr>
                                        <td>Totaal lijnen</td>
                                        <td class="text-end text-nowrap">
                                            @Model.Lines.Where(l => l.Price.HasValue).Sum(l => l.Price!.Value).ToString("N2")
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                }

                @* Octopus booking-info (fase 2 — tonen indien beschikbaar) *@
                @if (!string.IsNullOrEmpty(Model.OctopusExternalId) || Model.OctopusBookedAt.HasValue)
                {
                    <div class="card mb-3">
                        <div class="card-header fw-semibold">
                            <i class="bx bx-link-external me-1"></i> Octopus informatie
                        </div>
                        <div class="card-body">
                            <div class="row g-2">
                                @if (!string.IsNullOrEmpty(Model.OctopusExternalId))
                                {
                                    <div class="col-sm-6">
                                        <label class="form-label text-muted small">Extern ID</label>
                                        <div class="font-monospace small">@Model.OctopusExternalId</div>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.OctopusBookingStatus))
                                {
                                    <div class="col-sm-6">
                                        <label class="form-label text-muted small">Boekingstatus</label>
                                        <div>@Model.OctopusBookingStatus</div>
                                    </div>
                                }
                                @if (Model.OctopusBookedAt.HasValue)
                                {
                                    <div class="col-sm-6">
                                        <label class="form-label text-muted small">Geboekt op</label>
                                        <div>@Model.OctopusBookedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="form-label text-muted small">Geboekt door</label>
                                        <div>@(Model.OctopusBookedBy ?? "—")</div>
                                    </div>
                                }
                                @if (Model.SyncedAt.HasValue)
                                {
                                    <div class="col-sm-6">
                                        <label class="form-label text-muted small">Laatste sync</label>
                                        <div class="small text-muted">@Model.SyncedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.SyncError))
                                {
                                    <div class="col-12">
                                        <label class="form-label text-muted small">Syncfout</label>
                                        <div class="alert alert-warning py-1 px-2 small mb-0">@Model.SyncError</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

            </div>

            @* ── Rechterkolom: acties ── *@
            <div class="col-lg-4">

                @* Koppelen aan werf *@
                <div class="card mb-3">
                    <div class="card-header fw-semibold">
                        <i class="bx bx-building-house me-1"></i> Werf / Project
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.ProjectName))
                        {
                            <div class="mb-2">
                                <span class="badge bg-success fs-6">@Model.ProjectName</span>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small mb-2">Nog niet gekoppeld aan een werf.</p>
                        }
                        <form method="post" asp-action="LinkToProject" asp-controller="DocumentenCentrum">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="incomingInvoiceId" value="@Model.Id" />
                            <div class="mb-2">
                                <select asp-for="ProjectId" asp-items="projects" class="form-select form-select-sm">
                                    <option value="">— Geen werf —</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm w-100">
                                <i class="bx bx-link"></i> Koppelen
                            </button>
                        </form>
                    </div>
                </div>

                @* Status aanpassen *@
                <div class="card mb-3">
                    <div class="card-header fw-semibold">
                        <i class="bx bx-flag me-1"></i> Status
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <span class="badge @Model.StatusBadgeClass fs-6">@Model.StatusLabel</span>
                        </div>
                        <form method="post" asp-action="UpdateStatus" asp-controller="DocumentenCentrum">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="incomingInvoiceId" value="@Model.Id" />
                            <div class="mb-2">
                                <select name="statusId" class="form-select form-select-sm">
                                    @{
                                        var statuses = new[]
                                        {
                                                                        (IncomingInvoiceStatus.New, IncomingInvoiceStatus.Label(IncomingInvoiceStatus.New)),
                                                                        (IncomingInvoiceStatus.PendingApproval, IncomingInvoiceStatus.Label(IncomingInvoiceStatus.PendingApproval)),
                                                                        (IncomingInvoiceStatus.Approved, IncomingInvoiceStatus.Label(IncomingInvoiceStatus.Approved)),
                                                                        (IncomingInvoiceStatus.Rejected, IncomingInvoiceStatus.Label(IncomingInvoiceStatus.Rejected)),
                                                                        (IncomingInvoiceStatus.Booked, IncomingInvoiceStatus.Label(IncomingInvoiceStatus.Booked)),
                                                                        (IncomingInvoiceStatus.Paid, IncomingInvoiceStatus.Label(IncomingInvoiceStatus.Paid)),
                                                                        (IncomingInvoiceStatus.Duplicate, IncomingInvoiceStatus.Label(IncomingInvoiceStatus.Duplicate)),
                                                                        };
                                    }

                                    @foreach (var (val, label) in statuses)
                                    {
                                        <option value="@val"
                                                selected="@(val == Model.StatusId ? "selected" : null)">
                                            @label
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="mb-2">
                                <textarea name="notes" class="form-control form-control-sm"
                                          rows="2" placeholder="Optionele notitie...">@Model.Notes</textarea>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm w-100">
                                <i class="bx bx-save"></i> Status opslaan
                            </button>
                        </form>
                    </div>
                </div>

                @* Audit info *@
                <div class="card">
                    <div class="card-body text-muted small">
                        <div class="mb-1">
                            @if (Model.Source == "Octopus")
                            {
                                <span class="badge bg-primary">
                                    <i class="bx bx-import"></i> Geïmporteerd vanuit Octopus
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border">
                                    <i class="bx bx-edit"></i> Handmatig ingevoerd
                                </span>
                            }
                        </div>
                        <div><i class="bx bx-time me-1"></i> Aangemaakt: @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                        <div><i class="bx bx-edit me-1"></i> Bijgewerkt: @Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                        @if (Model.SyncedAt.HasValue)
                        {
                            <div><i class="bx bx-sync me-1"></i> Gesynchroniseerd: @Model.SyncedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@functions {
    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576.0:N1} MB";
        if (bytes >= 1024) return $"{bytes / 1024.0:N1} KB";
        return $"{bytes} B";
    }
}
