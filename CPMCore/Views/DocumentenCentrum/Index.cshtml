@model FacadeCore.IncomingInvoicePagedResultVm
@using DALCore.Models
@using BOCore
@using FacadeCore
@{
    ViewData["Title"] = "Documentencentrum";
    var filter = ViewBag.Filter as IncomingInvoiceFilterVm ?? new IncomingInvoiceFilterVm();
    var selectedIssuerCompanyId = ViewBag.SelectedIssuerCompanyId as int?;
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2 align-items-center">
            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="bx bx-file-blank me-2" aria-hidden="true"></i> Documentencentrum
                </h1>
            </div>
            <div class="col-sm-6 d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#syncModal">
                    <i class="bx bx-refresh"></i> Sync Octopus
                </button>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-@TempData["MessageType"] alert-dismissible fade show" role="alert">
                <strong>@TempData["MessageTitle"]</strong> @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @* ── Filter panel ── *@
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center gap-2" style="cursor:pointer"
                 data-bs-toggle="collapse" data-bs-target="#filterPanel">
                <i class="bx bx-filter-alt"></i>
                <span class="fw-semibold">Filters</span>
                <i class="bx bx-chevron-down ms-auto"></i>
            </div>
            <div class="collapse show" id="filterPanel">
                <div class="card-body">
                    <form method="get" asp-action="Index" asp-controller="DocumentenCentrum">
                        <div class="row g-2">
                            <div class="col-md-3">
                                <label class="form-label form-label-sm">Facturatiebedrijf</label>
                                @Html.DropDownList("issuerCompanyId", ViewBag.IssuerCompanies as SelectList,
                                    "Alle bedrijven", new { @class = "form-select form-select-sm" })
                            </div>
                            <div class="col-md-3">
                                <label class="form-label form-label-sm">Leverancier</label>
                                <input type="text" name="supplierName" value="@filter.SupplierName"
                                       class="form-control form-control-sm" placeholder="Naam leverancier..." />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label form-label-sm">Factuurnummer</label>
                                <input type="text" name="invoiceNumber" value="@filter.InvoiceNumber"
                                       class="form-control form-control-sm" placeholder="Nr..." />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label form-label-sm">Status</label>
                                @Html.DropDownList("statusId", ViewBag.StatusOptions as SelectList,
                                    null, new { @class = "form-select form-select-sm" })
                            </div>
                            <div class="col-md-2">
                                <label class="form-label form-label-sm">Type</label>
                                @Html.DropDownList("documentType", ViewBag.DocumentTypeOptions as SelectList,
                                    null, new { @class = "form-select form-select-sm" })
                            </div>
                            <div class="col-md-2">
                                <label class="form-label form-label-sm">Datum van</label>
                                <input type="date" name="dateFrom"
                                       value="@filter.DateFrom?.ToString("yyyy-MM-dd")"
                                       class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label form-label-sm">Datum t/m</label>
                                <input type="date" name="dateTo"
                                       value="@filter.DateTo?.ToString("yyyy-MM-dd")"
                                       class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end gap-1">
                                <button type="submit" class="btn btn-primary btn-sm flex-fill">
                                    <i class="bx bx-search"></i> Zoeken
                                </button>
                                <a href="@Url.Action("Index", "DocumentenCentrum")" class="btn btn-secondary btn-sm">
                                    <i class="bx bx-x"></i>
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @* ── Resultaat tabel ── *@
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span class="fw-semibold">
                    <i class="bx bx-list-ul me-1"></i>
                    Documenten
                    <span class="badge bg-secondary ms-1">@Model.TotalCount</span>
                </span>
                <small class="text-muted">Pagina @Model.Page van @Model.TotalPages</small>
            </div>

            <div class="card-body p-0">
                @if (!Model.Items.Any())
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bx bx-inbox" style="font-size:2rem;"></i>
                        <p class="mt-2">Geen documenten gevonden.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Datum</th>
                                    <th>Leverancier</th>
                                    <th>Factuurnummer</th>
                                    <th class="text-end">Totaal (incl. BTW)</th>
                                    <th>Status</th>
                                    <th>Werf</th>
                                    <th>Bijl.</th>
                                    <th>Bron</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="text-nowrap">
                                            <span>@item.InvoiceDate.ToString("dd/MM/yyyy")</span>
                                            @if (item.DueDate.HasValue && item.DueDate.Value < DateOnly.FromDateTime(DateTime.Today) &&
                                                item.StatusId < IncomingInvoiceStatus.Paid)
                                            {
                                                <br /><small class="text-danger" title="Vervaldatum overschreden">
                                                    <i class="bx bx-time-five"></i> @item.DueDate.Value.ToString("dd/MM/yyyy")
                                                </small>
                                            }
                                        </td>
                                        <td>
                                            <span class="fw-semibold">@item.SupplierName</span>
                                            @if (!string.IsNullOrEmpty(item.SupplierVatNumber))
                                            {
                                                <br /><small class="text-muted">@item.SupplierVatNumber</small>
                                            }
                                        </td>
                                        <td class="text-nowrap">@item.InvoiceNumber</td>
                                        <td class="text-end text-nowrap fw-semibold">
                                            @item.TotalAmountInclVat.ToString("N2") @item.CurrencyCode
                                        </td>
                                        <td>
                                            <span class="badge @item.StatusBadgeClass">@item.StatusLabel</span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.ProjectName))
                                            {
                                                <span class="badge bg-light text-dark border">@item.ProjectName</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (item.HasAttachments)
                                            {
                                                <i class="bx bx-paperclip text-muted" title="Bijlage aanwezig"></i>
                                            }
                                        </td>
                                        <td>
                                            @if (item.Source == "Octopus")
                                            {
                                                <span class="badge bg-primary" title="Geïmporteerd vanuit Octopus">
                                                    <i class="bx bx-import"></i> Octopus
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark border" title="Handmatig ingevoerd">
                                                    <i class="bx bx-edit"></i> Handmatig
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a href="@Url.Action("Detail", "DocumentenCentrum", new { id = item.Id })"
                                               class="btn btn-outline-secondary btn-sm">
                                                <i class="bx bx-show"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @* ── Paginering ── *@
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer d-flex justify-content-center">
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                var pageNum = p;
                                <li class="page-item @(pageNum == Model.Page ? "active" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("Index", "DocumentenCentrum", new {
                                           issuerCompanyId = filter.IssuerCompanyId,
                                           supplierName = filter.SupplierName,
                                           invoiceNumber = filter.InvoiceNumber,
                                           statusId = filter.StatusId,
                                           documentType = filter.DocumentType,
                                           dateFrom = filter.DateFrom?.ToString("yyyy-MM-dd"),
                                           dateTo = filter.DateTo?.ToString("yyyy-MM-dd"),
                                           page = pageNum
                                       })">
                                        @pageNum
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</section>

@* ── Sync-modal ────────────────────────────────────────────────────────────── *@
<div class="modal fade" id="syncModal" tabindex="-1" aria-labelledby="syncModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Sync" asp-controller="DocumentenCentrum">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="syncModalLabel"><i class="bx bx-refresh me-2"></i>Synchroniseren vanuit Octopus</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Facturatiebedrijf</label>
                        <select name="issuerCompanyId"
                                class="form-select"
                                asp-items="ViewBag.IssuerCompanies"
                                required>
                            <option value="">— Kies een bedrijf —</option>
                        </select>
                        <div class="form-text">Enkel facturen van dit bedrijf worden gesynchroniseerd.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Vanaf datum <span class="text-muted fw-normal">(optioneel)</span></label>
                        <input type="date" name="dateFrom" class="form-control" />
                        <div class="form-text">
                            Laat leeg om automatisch verder te synchroniseren vanaf de laatste sync.
                            Vul een datum in om enkel documenten vanaf die datum op te halen.
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bx bx-refresh"></i> Synchroniseren
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
