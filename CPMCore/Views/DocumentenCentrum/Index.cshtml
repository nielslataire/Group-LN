@model FacadeCore.IncomingInvoicePagedResultVm
@using DALCore.Models
@using BOCore
@using FacadeCore
@{
    ViewData["Title"] = "Documentencentrum";
    InvoiceReasonFlags Flags(long f) => (InvoiceReasonFlags)f;
    bool HasFlag(long f, InvoiceReasonFlags flag) => (Flags(f) & flag) != 0;

    var filter        = ViewBag.Filter as IncomingInvoiceFilterVm ?? new IncomingInvoiceFilterVm();
    int countNew      = (int)(ViewBag.CountNew      ?? 0);
    int countAttn     = (int)(ViewBag.CountAttention ?? 0);
    int countPending  = (int)(ViewBag.CountPending   ?? 0);
    int countApproved = (int)(ViewBag.CountApproved  ?? 0);

    // Tab URL helper — hergebruikt alle actieve filters
    string TabUrl(byte? sId, bool? warn = null) => Url.Action("Index", "DocumentenCentrum", new {
        issuerCompanyId = filter.IssuerCompanyId,
        supplierName    = filter.SupplierName,
        invoiceNumber   = filter.InvoiceNumber,
        documentType    = filter.DocumentType,
        projectId       = filter.ProjectId,
        dateFrom        = filter.DateFrom?.ToString("yyyy-MM-dd"),
        dateTo          = filter.DateTo?.ToString("yyyy-MM-dd"),
        statusId        = sId.HasValue ? (object)sId.Value : null,
        hasWarnings     = warn.HasValue ? (object)warn.Value : null,
        page            = 1
    });

    bool isTabAll      = filter.StatusId == null && filter.HasWarnings != true;
    bool isTabNew      = filter.StatusId == IncomingInvoiceStatus.New && filter.HasWarnings != true;
    bool isTabAttention= filter.HasWarnings == true;
    bool isTabPending  = filter.StatusId == IncomingInvoiceStatus.PendingApproval;
    bool isTabApproved = filter.StatusId == IncomingInvoiceStatus.Approved;

    // Paginering
    int firstItem = Model.TotalCount == 0 ? 0 : (filter.Page - 1) * filter.PageSize + 1;
    int lastItem  = Math.Min(filter.Page * filter.PageSize, Model.TotalCount);
}

@* ── Page header ──────────────────────────────────────────────────────────── *@
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2 align-items-center">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold">Documentencentrum</h1>
                <p class="text-muted mb-0 mt-1 small">Beheer en verwerk inkomende facturen en documenten</p>
            </div>
            <div class="col-sm-6 d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        data-bs-toggle="modal" data-bs-target="#syncModal">
                    <i class="bx bx-refresh me-1"></i>Sync Octopus
                </button>
                <button type="button" class="btn btn-primary btn-sm">
                    <i class="bx bx-plus me-1"></i>Document uploaden
                </button>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-@TempData["MessageType"] alert-dismissible fade show" role="alert">
                <strong>@TempData["MessageTitle"]</strong> @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @* ── Summary-kaarten ─────────────────────────────────────────────────── *@
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
                <a href="@TabUrl(IncomingInvoiceStatus.New)" class="text-decoration-none">
                <section class="card issue-status-widget mb-0">
                    <div class="card-body bg-primary">
                        <div class="widget-summary widget-summary-sm">
                            <div class="widget-summary-col">
                                <div class="summary align-content-center">
                                        <p class="text-uppercase small fw-semibold mb-0" style="color:#8fbc9f;letter-spacing:.06em;">Te verwerken</p>
                                        <h2 class="fw-bold mt-0 mb-0 text-white">@countNew</h2>
                                        <p class="small mb-0" style="color:#8fbc9f;">Wachten op administratie</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                </a>
            </div>
            <div class="col-sm-6 col-xl-3">
                <a href="@TabUrl(null,true)" class="text-decoration-none">
                    <section class="card issue-status-widget mb-0">
                        <div class="card-body bg-primary">
                            <div class="widget-summary widget-summary-sm">
                                <div class="widget-summary-col">
                                    <div class="summary align-content-center">
                                        <p class="text-uppercase small fw-semibold mb-0" style="color:#8fbc9f;letter-spacing:.06em;">Vraagt aandacht</p>
                                        <h2 class="fw-bold mb-0 mt-0 text-white">@countAttn</h2>
                                        <p class="small mb-0" style="color:#8fbc9f;">Actie vereist</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </a>
            </div>
            <div class="col-sm-6 col-xl-3">
                <a href="@TabUrl(IncomingInvoiceStatus.PendingApproval)" class="text-decoration-none">
                    <section class="card issue-status-widget mb-0">
                        <div class="card-body bg-primary">
                            <div class="widget-summary widget-summary-sm">
                                <div class="widget-summary-col">
                                    <div class="summary align-content-center">
                                        <p class="text-uppercase small fw-semibold mb-0" style="color:#8fbc9f;letter-spacing:.06em;">Toegewezen</p>
                                        <h2 class="fw-bold mb-0 mt-0 text-white">@countPending</h2>
                                        <p class="small mb-0" style="color:#8fbc9f;">Bij projectverantwoordelijke</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </a>
            </div>
            <div class="col-sm-6 col-xl-3">
                <a href="@TabUrl(IncomingInvoiceStatus.Approved)" class="text-decoration-none">
                    <section class="card issue-status-widget mb-0">
                        <div class="card-body bg-primary">
                            <div class="widget-summary widget-summary-sm">
                                <div class="widget-summary-col">
                                    <div class="summary align-content-center">
                                        <p class="text-uppercase small fw-semibold mb-0" style="color:#8fbc9f;letter-spacing:.06em;">Goedgekeurd</p>
                                        <h2 class="fw-bold mb-0 mt-0 text-white">@countApproved</h2>
                                        <p class="small mb-0" style="color:#8fbc9f;">Deze maand</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </a>
            </div>
        </div>

        @* ── Filters ──────────────────────────────────────────────────────────── *@
        <div class="card mb-3">
            <div class="card-body py-3">
                <form method="get" asp-action="Index" asp-controller="DocumentenCentrum">
                    <div class="row g-2 align-items-end">
                        <div class="col-sm-6 col-md-4 col-xl-2">
                            <label class="form-label form-label-sm fw-semibold small text-muted text-uppercase" style="letter-spacing:.04em;">Facturatiebedrijf</label>
                            @Html.DropDownList("issuerCompanyId", ViewBag.IssuerCompanies as SelectList,
                                "Alle bedrijven", new { @class = "form-select form-select-sm form-control-modern" })
                        </div>
                        <div class="col-sm-6 col-md-4 col-xl-2">
                            <label class="form-label form-label-sm fw-semibold small text-muted text-uppercase" style="letter-spacing:.04em;">Leverancier</label>
                            <input type="text" name="supplierName" value="@filter.SupplierName"
                                   class="form-control form-control-sm form-control-modern"
                                   placeholder="Naam leverancier..." />
                        </div>
                        <div class="col-sm-6 col-md-4 col-xl-2">
                            <label class="form-label form-label-sm fw-semibold small text-muted text-uppercase" style="letter-spacing:.04em;">Factuurnummer</label>
                            <input type="text" name="invoiceNumber" value="@filter.InvoiceNumber"
                                   class="form-control form-control-sm form-control-modern"
                                   placeholder="Nr..." />
                        </div>
                        <div class="col-sm-6 col-md-4 col-xl-2">
                            <label class="form-label form-label-sm fw-semibold small text-muted text-uppercase" style="letter-spacing:.04em;">Status</label>
                            @Html.DropDownList("statusId", ViewBag.StatusOptions as SelectList,
                                null, new { @class = "form-select form-select-sm form-control-modern" })
                        </div>
                        <div class="col-sm-6 col-md-4 col-xl-2">
                            <label class="form-label form-label-sm fw-semibold small text-muted text-uppercase" style="letter-spacing:.04em;">Type</label>
                            @Html.DropDownList("documentType", ViewBag.DocumentTypeOptions as SelectList,
                                null, new { @class = "form-select form-select-sm form-control-modern" })
                        </div>
                        <div class="col-sm-6 col-md-4 col-xl-2">
                            <label class="form-label form-label-sm fw-semibold small text-muted text-uppercase" style="letter-spacing:.04em;">Project</label>
                            @Html.DropDownList("projectId", ViewBag.Projects as SelectList,
                                "Alle projecten", new { @class = "form-select form-select-sm form-control-modern" })
                        </div>
                        <div class="col-sm-6 col-md-3 col-xl-2">
                            <label class="form-label form-label-sm fw-semibold small text-muted text-uppercase" style="letter-spacing:.04em;">Datum van</label>
                            <input type="date" name="dateFrom"
                                   value="@filter.DateFrom?.ToString("yyyy-MM-dd")"
                                   class="form-control form-control-sm form-control-modern" />
                        </div>
                        <div class="col-sm-6 col-md-3 col-xl-2">
                            <label class="form-label form-label-sm fw-semibold small text-muted text-uppercase" style="letter-spacing:.04em;">Datum t/m</label>
                            <input type="date" name="dateTo"
                                   value="@filter.DateTo?.ToString("yyyy-MM-dd")"
                                   class="form-control form-control-sm form-control-modern" />
                        </div>
                        <div class="col-auto d-flex gap-2 align-items-end">
                            <button type="submit" class="btn btn-primary btn-sm px-3">
                                <i class="bx bx-search me-1"></i>Zoeken
                            </button>
                            <a href="@Url.Action("Index", "DocumentenCentrum")" class="btn btn-outline-secondary btn-sm">
                                <i class="bx bx-x"></i>
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @* ── Tabbladen ────────────────────────────────────────────────────────── *@
        <div class="coord-tabs mb-3" role="tablist">
            <a href="@TabUrl(null)" class="coord-tab @(isTabAll ? "active" : "")">
                Alle documenten <span class="badge rounded-pill ms-1 @(isTabAll ? "bg-white text-dark" : "bg-secondary")">@Model.TotalCount</span>
            </a>
            <a href="@TabUrl(IncomingInvoiceStatus.New)" class="coord-tab @(isTabNew ? "active" : "")">
                Nieuw <span class="badge rounded-pill ms-1 @(isTabNew ? "bg-white text-dark" : "bg-secondary")">@countNew</span>
            </a>
            <a href="@TabUrl(null, true)" class="coord-tab @(isTabAttention ? "active" : "")">
                Vraagt aandacht <span class="badge rounded-pill ms-1 @(isTabAttention ? "bg-white text-dark" : "bg-secondary")">@countAttn</span>
            </a>
            <a href="@TabUrl(IncomingInvoiceStatus.PendingApproval)" class="coord-tab @(isTabPending ? "active" : "")">
                Toegewezen <span class="badge rounded-pill ms-1 @(isTabPending ? "bg-white text-dark" : "bg-secondary")">@countPending</span>
            </a>
            <a href="@TabUrl(IncomingInvoiceStatus.Approved)" class="coord-tab @(isTabApproved ? "active" : "")">
                Goedgekeurd
            </a>
        </div>

        @* ── Bulk-actiebalk (JS-gestuurd) ─────────────────────────────────────── *@
        <div id="bulkActionBar" class="d-none mb-3 px-4 py-2 rounded d-flex align-items-center justify-content-between gap-3"
             style="background:#1a3a2a;color:#fff;">
            <span id="bulkCountLabel" class="fw-semibold text-nowrap">0 geselecteerd</span>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-light">
                    <i class="bx bx-user me-1"></i>Toewijzen
                </button>
                <button type="button" class="btn btn-sm btn-outline-light">
                    <i class="bx bx-check me-1"></i>Goedkeuren
                </button>
                <button type="button" class="btn btn-sm" style="border-color:#f87171;color:#f87171;">
                    <i class="bx bx-x me-1"></i>Afwijzen
                </button>
            </div>
        </div>

        @* ── Documententabel ──────────────────────────────────────────────────── *@
        <div class="card card-modern">
            <div class="card-body p-0">

                @if (!Model.Items.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bx bx-inbox" style="font-size:2.5rem;"></i>
                        <p class="mt-2 mb-0">Geen documenten gevonden.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0 align-middle" id="documentsTable">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3" style="width:36px;">
                                        <input type="checkbox" id="checkAll" class="form-check-input" />
                                    </th>
                                    <th class="text-nowrap">Datum</th>
                                    <th>Type</th>
                                    <th>Leverancier</th>
                                    <th>Factuurnummer / Omschrijving</th>
                                    <th class="text-end text-nowrap">Totaal (incl. BTW)</th>
                                    <th>Status</th>
                                    <th>Project / Werf</th>
                                    <th>Toegewezen aan</th>
                                    <th>Bron</th>
                                    <th class="text-end pe-3">Acties</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr class="js-doc-row" data-id="@item.Id">
                                        <td class="ps-3">
                                            <input type="checkbox" class="form-check-input js-row-check" value="@item.Id" />
                                        </td>

                                        @* Datum *@
                                        <td class="text-nowrap">
                                            <span class="fw-semibold">@item.InvoiceDate.ToString("dd/MM/yyyy")</span>
                                            @if (item.DueDate.HasValue)
                                            {
                                                var overdue = item.DueDate.Value < DateOnly.FromDateTime(DateTime.Today)
                                                           && item.StatusId < IncomingInvoiceStatus.Paid;
                                                <br /><small class="@(overdue ? "text-danger" : "text-muted")">
                                                    @if (overdue) { <i class="bx bx-time-five"></i> }
                                                    @item.DueDate.Value.ToString("dd/MM/yyyy")
                                                </small>
                                            }
                                        </td>

                                        @* Type *@
                                        <td>
                                            @{
                                                var typeLabel = item.DocumentType switch {
                                                    "CreditNote" => "Creditnota",
                                                    "Invoice"    => "Factuur",
                                                    _            => item.DocumentType ?? "—"
                                                };
                                                var typeCls = item.DocumentType == "CreditNote"
                                                    ? "badge bg-danger bg-opacity-10 text-danger border border-danger-subtle"
                                                    : "badge bg-light text-dark border";
                                            }
                                            <span class="@typeCls">@typeLabel</span>
                                        </td>

                                        @* Leverancier *@
                                        <td>
                                            <span class="fw-semibold">@item.SupplierName</span>
                                            @if (!string.IsNullOrEmpty(item.SupplierVatNumber))
                                            {
                                                <br /><small class="text-muted">@item.SupplierVatNumber</small>
                                            }
                                        </td>

                                        @* Factuurnummer / Omschrijving *@
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.InvoiceNumber))
                                            {
                                                <span class="fw-semibold">@item.InvoiceNumber</span><br />
                                            }
                                            @if (item.FirstPdfAttachmentId.HasValue)
                                            {
                                                <small>
                                                    <a href="@Url.Action("ViewAttachment","DocumentenCentrum",new{attachmentId=item.FirstPdfAttachmentId.Value})"
                                                       target="_blank" class="text-muted text-decoration-none">
                                                        <i class="bx bxs-file-pdf text-danger me-1"></i>Factuur bekijken
                                                    </a>
                                                </small>
                                            }
                                        </td>

                                        @* Totaal *@
                                        <td class="text-end text-nowrap fw-semibold @(item.TotalAmountInclVat < 0 ? "text-danger" : "")">
                                            € @item.TotalAmountInclVat.ToString("N2")
                                        </td>

                                        @* Status *@
                                        <td>
                                            <span class="badge @item.StatusBadgeClass">@item.StatusLabel</span>
                                            @if (item.StatusId == IncomingInvoiceStatus.New && item.IsEnriched)
                                            {
                                                <br />
                                                @if (item.HasWarnings)
                                                {
                                                    <small class="text-warning fw-semibold">Vraagt aandacht</small>
                                                }
                                                else
                                                {
                                                    <small class="text-success fw-semibold">Verrijkt</small>
                                                }
                                            }
                                        </td>

                                        @* Project / Werf *@
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.ProjectName))
                                            {
                                                <span class="badge bg-light text-dark border">@item.ProjectName</span>
                                            }
                                            else if (!string.IsNullOrEmpty(item.SuggestedProjectName))
                                            {
                                                <span class="badge bg-opacity-25 bg-info text-dark border border-info"
                                                      title="Voorstel — nog niet bevestigd">
                                                    <i class="bx bx-bulb me-1"></i>@item.SuggestedProjectName
                                                </span>
                                            }
                                            else if (HasFlag(item.ReasonFlags, InvoiceReasonFlags.GeneralCostSuggested))
                                            {
                                                <span class="badge bg-secondary small">Algemene kost</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>

                                        @* Toegewezen aan *@
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.AssignedToName))
                                            {
                                                <span class="d-flex align-items-center gap-1">
                                                    <span class="rounded-circle bg-warning d-inline-block" style="width:8px;height:8px;"></span>
                                                    <small class="text-nowrap">@item.AssignedToName</small>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>

                                        @* Bron *@
                                        <td>
                                            @if (item.Source == "Octopus")
                                            {
                                                <span class="badge" style="background:#1a3a2a;">Octopus</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark border">Handmatig</span>
                                            }
                                        </td>

                                        @* Acties *@
                                        <td class="text-end pe-3 text-nowrap">
                                            <a href="@Url.Action("Detail","DocumentenCentrum",new{id=item.Id})"
                                               class="btn btn-sm btn-outline-secondary" title="Bekijken">
                                                <i class="bx bx-show"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-secondary ms-1" title="Toewijzen">
                                                <i class="bx bx-user"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-success ms-1" title="Goedkeuren">
                                                <i class="bx bx-check"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger ms-1" title="Afwijzen">
                                                <i class="bx bx-x"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @* ── Footer: telling + paginering ──────────────────────────────────── *@
            <div class="card-footer d-flex align-items-center justify-content-between flex-wrap gap-2 py-2 px-3">
                <small class="text-muted">
                    @if (Model.TotalCount == 0)
                    {
                        <span>Geen documenten gevonden</span>
                    }
                    else
                    {
                        <span>Document @firstItem tot @lastItem van @Model.TotalCount documenten</span>
                    }
                </small>

                @if (Model.TotalPages > 1)
                {
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index","DocumentenCentrum", new{ issuerCompanyId=filter.IssuerCompanyId, supplierName=filter.SupplierName, invoiceNumber=filter.InvoiceNumber, statusId=filter.StatusId, documentType=filter.DocumentType, projectId=filter.ProjectId, hasWarnings=filter.HasWarnings, dateFrom=filter.DateFrom?.ToString("yyyy-MM-dd"), dateTo=filter.DateTo?.ToString("yyyy-MM-dd"), page=1 })">«</a>
                            </li>
                            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index","DocumentenCentrum", new{ issuerCompanyId=filter.IssuerCompanyId, supplierName=filter.SupplierName, invoiceNumber=filter.InvoiceNumber, statusId=filter.StatusId, documentType=filter.DocumentType, projectId=filter.ProjectId, hasWarnings=filter.HasWarnings, dateFrom=filter.DateFrom?.ToString("yyyy-MM-dd"), dateTo=filter.DateTo?.ToString("yyyy-MM-dd"), page=Model.Page-1 })">‹</a>
                            </li>
                            @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                            {
                                var pageNum = p;
                                <li class="page-item @(pageNum == Model.Page ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index","DocumentenCentrum", new{ issuerCompanyId=filter.IssuerCompanyId, supplierName=filter.SupplierName, invoiceNumber=filter.InvoiceNumber, statusId=filter.StatusId, documentType=filter.DocumentType, projectId=filter.ProjectId, hasWarnings=filter.HasWarnings, dateFrom=filter.DateFrom?.ToString("yyyy-MM-dd"), dateTo=filter.DateTo?.ToString("yyyy-MM-dd"), page=pageNum })">@pageNum</a>
                                </li>
                            }
                            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index","DocumentenCentrum", new{ issuerCompanyId=filter.IssuerCompanyId, supplierName=filter.SupplierName, invoiceNumber=filter.InvoiceNumber, statusId=filter.StatusId, documentType=filter.DocumentType, projectId=filter.ProjectId, hasWarnings=filter.HasWarnings, dateFrom=filter.DateFrom?.ToString("yyyy-MM-dd"), dateTo=filter.DateTo?.ToString("yyyy-MM-dd"), page=Model.Page+1 })">›</a>
                            </li>
                            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index","DocumentenCentrum", new{ issuerCompanyId=filter.IssuerCompanyId, supplierName=filter.SupplierName, invoiceNumber=filter.InvoiceNumber, statusId=filter.StatusId, documentType=filter.DocumentType, projectId=filter.ProjectId, hasWarnings=filter.HasWarnings, dateFrom=filter.DateFrom?.ToString("yyyy-MM-dd"), dateTo=filter.DateTo?.ToString("yyyy-MM-dd"), page=Model.TotalPages })">»</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>

    </div>
</section>

@* ── Sync-modal ──────────────────────────────────────────────────────────────── *@
<div class="modal fade" id="syncModal" tabindex="-1" aria-labelledby="syncModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Sync" asp-controller="DocumentenCentrum">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="syncModalLabel"><i class="bx bx-refresh me-2"></i>Synchroniseren vanuit Octopus</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Facturatiebedrijf</label>
                        <select name="issuerCompanyId" class="form-select form-control-modern" asp-items="ViewBag.IssuerCompanies" required>
                            <option value="">— Kies een bedrijf —</option>
                        </select>
                        <div class="form-text">Enkel facturen van dit bedrijf worden gesynchroniseerd.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Vanaf datum <span class="text-muted fw-normal">(optioneel)</span></label>
                        <input type="date" name="dateFrom" class="form-control form-control-modern" />
                        <div class="form-text">Laat leeg om automatisch verder te synchroniseren vanaf de laatste sync.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="btn btn-primary"><i class="bx bx-refresh me-1"></i>Synchroniseren</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section PageScripts {
    <script>
    (function () {
        const checkAll  = document.getElementById('checkAll');
        const rowChecks = () => document.querySelectorAll('.js-row-check');
        const bar       = document.getElementById('bulkActionBar');
        const label     = document.getElementById('bulkCountLabel');

        function updateBar() {
            const checked = [...rowChecks()].filter(c => c.checked).length;
            if (checked > 0) {
                bar.classList.remove('d-none');
                bar.classList.add('d-flex');
                label.textContent = checked + ' geselecteerd';
            } else {
                bar.classList.add('d-none');
                bar.classList.remove('d-flex');
            }
            if (checkAll) {
                const total = rowChecks().length;
                checkAll.indeterminate = checked > 0 && checked < total;
                checkAll.checked       = checked === total && total > 0;
            }
        }

        if (checkAll) {
            checkAll.addEventListener('change', function () {
                rowChecks().forEach(c => c.checked = this.checked);
                updateBar();
            });
        }

        document.querySelectorAll('.js-row-check').forEach(c =>
            c.addEventListener('change', updateBar));
    })();
    </script>
}
