@model FacadeCore.IncomingInvoicePagedResultVm
@using DALCore.Models
@using BOCore
@using FacadeCore
@{
    ViewData["Title"] = "Documentencentrum";
    InvoiceReasonFlags Flags(long f) => (InvoiceReasonFlags)f;
    bool HasFlag(long f, InvoiceReasonFlags flag) => (Flags(f) & flag) != 0;

    var filter          = ViewBag.Filter as IncomingInvoiceFilterVm ?? new IncomingInvoiceFilterVm();
    bool assignedToMe   = (bool)(ViewBag.AssignedToMe ?? false);

    int countNew         = (int)(ViewBag.CountNew          ?? 0);
    int countAttn        = (int)(ViewBag.CountAttention    ?? 0);
    int countMine        = (int)(ViewBag.CountMine         ?? 0);
    int countBudget      = (int)(ViewBag.CountBudgetImpact ?? 0);
    int countPending     = (int)(ViewBag.CountPending      ?? 0);
    int countApproved    = (int)(ViewBag.CountApproved     ?? 0);

    bool isTabAll      = filter.StatusId == null && filter.HasWarnings != true && !assignedToMe;
    bool isTabNew      = filter.StatusId == IncomingInvoiceStatus.New && filter.HasWarnings != true && !assignedToMe;
    bool isTabAttn     = filter.HasWarnings == true;
    bool isTabMine     = assignedToMe;
    bool isTabPending  = filter.StatusId == IncomingInvoiceStatus.PendingApproval && !assignedToMe;
    bool isTabApproved = filter.StatusId == IncomingInvoiceStatus.Approved && !assignedToMe;
    bool isTabBooked   = filter.StatusId == IncomingInvoiceStatus.Booked && !assignedToMe;

    bool hasAdvancedFilters = filter.DocumentType != null || filter.ProjectId.HasValue
        || filter.DateFrom.HasValue || filter.DateTo.HasValue || !string.IsNullOrEmpty(filter.InvoiceNumber);

    string TabUrl(byte? sId, bool? warn = null, bool? myTasks = null) => Url.Action("Index", "DocumentenCentrum", new {
        issuerCompanyId = filter.IssuerCompanyId,
        costContextType = filter.CostContextType,
        statusId        = sId.HasValue ? (object)sId.Value : null,
        hasWarnings     = warn.HasValue ? (object)warn.Value : null,
        assignedToMe    = myTasks.HasValue && myTasks.Value ? (object)true : null,
        page = 1
    });

    string CtxUrl(string ctx) => Url.Action("Index", "DocumentenCentrum", new {
        issuerCompanyId = filter.IssuerCompanyId,
        supplierName    = filter.SupplierName,
        invoiceNumber   = filter.InvoiceNumber,
        documentType    = filter.DocumentType,
        projectId       = filter.ProjectId,
        statusId        = filter.StatusId,
        hasWarnings     = filter.HasWarnings,
        dateFrom        = filter.DateFrom?.ToString("yyyy-MM-dd"),
        dateTo          = filter.DateTo?.ToString("yyyy-MM-dd"),
        assignedToMe    = assignedToMe ? (object)true : null,
        costContextType = ctx,
        page = 1
    });

    string AssignUrl(bool? myTasks) => Url.Action("Index", "DocumentenCentrum", new {
        issuerCompanyId = filter.IssuerCompanyId,
        supplierName    = filter.SupplierName,
        invoiceNumber   = filter.InvoiceNumber,
        documentType    = filter.DocumentType,
        projectId       = filter.ProjectId,
        statusId        = filter.StatusId,
        hasWarnings     = filter.HasWarnings,
        dateFrom        = filter.DateFrom?.ToString("yyyy-MM-dd"),
        dateTo          = filter.DateTo?.ToString("yyyy-MM-dd"),
        costContextType = filter.CostContextType,
        assignedToMe    = myTasks.HasValue && myTasks.Value ? (object)true : null,
        page = 1
    });

    int firstItem = Model.TotalCount == 0 ? 0 : (filter.Page - 1) * filter.PageSize + 1;
    int lastItem  = Math.Min(filter.Page * filter.PageSize, Model.TotalCount);

    string PagUrl(int p) => Url.Action("Index", "DocumentenCentrum", new {
        issuerCompanyId = filter.IssuerCompanyId,
        supplierName    = filter.SupplierName,
        invoiceNumber   = filter.InvoiceNumber,
        statusId        = filter.StatusId,
        documentType    = filter.DocumentType,
        projectId       = filter.ProjectId,
        hasWarnings     = filter.HasWarnings,
        dateFrom        = filter.DateFrom?.ToString("yyyy-MM-dd"),
        dateTo          = filter.DateTo?.ToString("yyyy-MM-dd"),
        costContextType = filter.CostContextType,
        assignedToMe    = assignedToMe ? (object)true : null,
        page = p
    });
}

@section PageStyle {
    <link rel="stylesheet" href="~/css/admin/document-center.css" />
}

@* ── Page header ──────────────────────────────────────────────────────────── *@
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2 align-items-center">
            <div class="col-sm-6">
                <h1 class="m-0 fw-bold">Documentencentrum</h1>
                <p class="text-muted mb-0 mt-1 small">Beheer en verwerk inkomende facturen en documenten</p>
            </div>
            <div class="col-sm-6 d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        data-bs-toggle="modal" data-bs-target="#syncModal">
                    <i class="bx bx-refresh me-1"></i>Sync Octopus
                </button>
                <button type="button" class="btn btn-primary btn-sm"
                        data-bs-toggle="modal" data-bs-target="#uploadModal">
                    <i class="bx bx-plus me-1"></i>Document uploaden
                </button>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-@TempData["MessageType"] alert-dismissible fade show" role="alert">
                <strong>@TempData["MessageTitle"]</strong> @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @* ── KPI stat kaarten ──────────────────────────────────────────────────── *@
        <div class="stats-row mb-4">
            <a href="@TabUrl(IncomingInvoiceStatus.New)" class="stat-card @(isTabNew ? "active" : "")">
                <div class="stat-icon stat-new"><i class="bx bx-inbox"></i></div>
                <div class="stat-num">@countNew</div>
                <div class="stat-lbl">Te verwerken</div>
            </a>
            <a href="@TabUrl(null, true)" class="stat-card @(isTabAttn ? "active" : "")">
                <div class="stat-icon stat-attn"><i class="bx bx-error-circle"></i></div>
                <div class="stat-num">@countAttn</div>
                <div class="stat-lbl">Vraagt aandacht</div>
            </a>
            <a href="@TabUrl(null, null, true)" class="stat-card @(isTabMine ? "active" : "")">
                <div class="stat-icon stat-mine"><i class="bx bx-user-check"></i></div>
                <div class="stat-num">@countMine</div>
                <div class="stat-lbl">Mijn taken</div>
            </a>
            <a href="@TabUrl(IncomingInvoiceStatus.New)" class="stat-card">
                <div class="stat-icon stat-budget"><i class="bx bx-trending-up"></i></div>
                <div class="stat-num">@countBudget</div>
                <div class="stat-lbl">Budgetimpact</div>
            </a>
            <a href="@TabUrl(IncomingInvoiceStatus.Approved)" class="stat-card @(isTabApproved ? "active" : "")">
                <div class="stat-icon stat-appr"><i class="bx bx-check-circle"></i></div>
                <div class="stat-num">@countApproved</div>
                <div class="stat-lbl">Goedgekeurd</div>
            </a>
        </div>

        @* ── Tabs ──────────────────────────────────────────────────────────────── *@
        <div class="tabs-bar">
            <a href="@TabUrl(null)" class="tab @(isTabAll ? "active" : "")">
                Alle <span class="tab-count">@Model.TotalCount</span>
            </a>
            <a href="@TabUrl(IncomingInvoiceStatus.New)" class="tab @(isTabNew ? "active" : "")">
                Nieuw <span class="tab-count">@countNew</span>
            </a>
            <a href="@TabUrl(null, true)" class="tab @(isTabAttn ? "active" : "")">
                Vraagt aandacht <span class="tab-count">@countAttn</span>
            </a>
            <a href="@TabUrl(null, null, true)" class="tab @(isTabMine ? "active" : "")">
                Mijn taken <span class="tab-count">@countMine</span>
            </a>
            <a href="@TabUrl(IncomingInvoiceStatus.PendingApproval)" class="tab @(isTabPending ? "active" : "")">
                Toegewezen <span class="tab-count">@countPending</span>
            </a>
            <a href="@TabUrl(IncomingInvoiceStatus.Approved)" class="tab @(isTabApproved ? "active" : "")">Goedgekeurd</a>
            <a href="@TabUrl(IncomingInvoiceStatus.Booked)" class="tab @(isTabBooked ? "active" : "")">Geboekt</a>
        </div>

        @* ── Toolbar ───────────────────────────────────────────────────────────── *@
        <div class="dc-toolbar">
            <form method="get" asp-action="Index" asp-controller="DocumentenCentrum" class="dc-search-form">
                <input type="hidden" name="issuerCompanyId" value="@filter.IssuerCompanyId" />
                <input type="hidden" name="statusId" value="@filter.StatusId" />
                <input type="hidden" name="hasWarnings" value="@filter.HasWarnings" />
                <input type="hidden" name="documentType" value="@filter.DocumentType" />
                <input type="hidden" name="projectId" value="@filter.ProjectId" />
                <input type="hidden" name="dateFrom" value="@filter.DateFrom?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="dateTo" value="@filter.DateTo?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="costContextType" value="@filter.CostContextType" />
                <input type="hidden" name="invoiceNumber" value="@filter.InvoiceNumber" />
                @if (assignedToMe) { <input type="hidden" name="assignedToMe" value="true" /> }
                <div class="dc-search-wrap">
                    <i class="bx bx-search dc-search-icon"></i>
                    <input type="text" name="supplierName" value="@filter.SupplierName"
                           class="dc-search-input"
                           placeholder="Zoek leverancier, factuurnummer, project, bedrag..." />
                </div>
            </form>

            <div class="dc-toolbar-right">
                @* Type toggle *@
                <div class="dc-toggle-group">
                    <a href="@CtxUrl(null)" class="dc-toggle-btn @(string.IsNullOrEmpty(filter.CostContextType) ? "active" : "")">Alle types</a>
                    <a href="@CtxUrl(CostContextType.ProjectCost)" class="dc-toggle-btn @(filter.CostContextType == CostContextType.ProjectCost ? "active" : "")">
                        <i class="bx bx-building-house me-1"></i>Projectkost
                    </a>
                    <a href="@CtxUrl(CostContextType.GeneralCompanyCost)" class="dc-toggle-btn @(filter.CostContextType == CostContextType.GeneralCompanyCost ? "active" : "")">
                        <i class="bx bx-briefcase me-1"></i>Algemene kost
                    </a>
                    <a href="@CtxUrl(CostContextType.Unknown)" class="dc-toggle-btn @(filter.CostContextType == CostContextType.Unknown ? "active" : "")">
                        <i class="bx bx-help-circle me-1"></i>Onzeker
                    </a>
                </div>

                @* Assign toggle *@
                <div class="dc-toggle-group">
                    <a href="@AssignUrl(null)" class="dc-toggle-btn @(!assignedToMe ? "active" : "")">
                        <i class="bx bx-group me-1"></i>Iedereen
                    </a>
                    <a href="@AssignUrl(true)" class="dc-toggle-btn @(assignedToMe ? "active" : "")">
                        <i class="bx bx-user me-1"></i>Aan mij
                    </a>
                </div>

                @* Meer filters *@
                <button type="button" class="btn btn-light btn-sm dc-more-filters-btn"
                        data-bs-toggle="collapse" data-bs-target="#advancedFilters"
                        aria-expanded="@(hasAdvancedFilters ? "true" : "false")">
                    Meer filters@if (hasAdvancedFilters) {<span class="dc-filter-dot ms-1"></span>}
                </button>
            </div>
        </div>

        @* ── Legend ────────────────────────────────────────────────────────────── *@
        <div class="dc-legend">
            <div class="dc-legend-items">
                <span class="dc-legend-item">
                    <span class="dc-legend-dot" style="background:#0a5a3b;"></span>Binnen budget
                </span>
                <span class="dc-legend-item">
                    <span class="dc-legend-dot" style="background:#f59e0b;"></span>Bijna opgebruikt
                </span>
                <span class="dc-legend-item">
                    <span class="dc-legend-dot" style="background:#ef4444;"></span>Overschrijding
                </span>
                <span class="dc-legend-item">
                    <span class="dc-legend-dot dc-legend-dot-outline"></span>In goedkeuring
                </span>
            </div>
            <span class="dc-legend-hint">Klik op een rij voor detail</span>
        </div>

        @* ── Geavanceerde filters (uitklapbaar) ────────────────────────────────── *@
        <div class="collapse @(hasAdvancedFilters ? "show" : "")" id="advancedFilters">
            <div class="card card-body py-3 mb-0 border-top-0 rounded-top-0" style="background:#f8f9fa;border-radius:0 0 .5rem .5rem;">
                <form method="get" asp-action="Index" asp-controller="DocumentenCentrum">
                    <input type="hidden" name="issuerCompanyId" value="@filter.IssuerCompanyId" />
                    <input type="hidden" name="supplierName" value="@filter.SupplierName" />
                    <input type="hidden" name="statusId" value="@filter.StatusId" />
                    <input type="hidden" name="hasWarnings" value="@filter.HasWarnings" />
                    <input type="hidden" name="costContextType" value="@filter.CostContextType" />
                    @if (assignedToMe) { <input type="hidden" name="assignedToMe" value="true" /> }
                    <div class="row g-2 align-items-end">
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label form-label-sm fw-semibold small text-muted text-uppercase" style="letter-spacing:.04em;">Factuurnummer</label>
                            <input type="text" name="invoiceNumber" value="@filter.InvoiceNumber"
                                   class="form-control form-control-sm" placeholder="Nr..." />
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label form-label-sm fw-semibold small text-muted text-uppercase" style="letter-spacing:.04em;">Documenttype</label>
                            @Html.DropDownList("documentType", ViewBag.DocumentTypeOptions as SelectList,
                                null, new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label form-label-sm fw-semibold small text-muted text-uppercase" style="letter-spacing:.04em;">Project</label>
                            @Html.DropDownList("projectId", ViewBag.Projects as SelectList,
                                "Alle projecten", new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label form-label-sm fw-semibold small text-muted text-uppercase" style="letter-spacing:.04em;">Facturatiebedrijf</label>
                            @Html.DropDownList("issuerCompanyId", ViewBag.IssuerCompanies as SelectList,
                                "Alle bedrijven", new { @class = "form-select form-select-sm" })
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label form-label-sm fw-semibold small text-muted text-uppercase" style="letter-spacing:.04em;">Datum van</label>
                            <input type="date" name="dateFrom" value="@filter.DateFrom?.ToString("yyyy-MM-dd")"
                                   class="form-control form-control-sm" />
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label form-label-sm fw-semibold small text-muted text-uppercase" style="letter-spacing:.04em;">Datum t/m</label>
                            <input type="date" name="dateTo" value="@filter.DateTo?.ToString("yyyy-MM-dd")"
                                   class="form-control form-control-sm" />
                        </div>
                        <div class="col-auto d-flex gap-2 align-items-end">
                            <button type="submit" class="btn btn-primary btn-sm px-3">
                                <i class="bx bx-search me-1"></i>Zoeken
                            </button>
                            <a href="@Url.Action("Index", "DocumentenCentrum", new { issuerCompanyId = filter.IssuerCompanyId })"
                               class="btn btn-outline-secondary btn-sm"><i class="bx bx-x"></i></a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @* ── Bulk-actiebalk ───────────────────────────────────────────────────── *@
        <input type="hidden" id="bulkIds" value="" />
        <div id="bulkActionBar" class="bulk-bar d-none mb-2 mt-2">
            <span class="count-pill" id="bulkCountLabel">0 geselecteerd</span>
            <div class="d-flex gap-2 flex-wrap">
                <button type="button" id="btnBulkApprove" class="btn btn-sm btn-outline-light">
                    <i class="bx bx-check me-1"></i>Goedkeuren
                </button>
                <button type="button" id="btnBulkReject" class="btn btn-sm" style="border-color:#f87171;color:#f87171;">
                    <i class="bx bx-x me-1"></i>Afwijzen
                </button>
            </div>
        </div>

        <form id="formBulkApprove" method="post" asp-action="BulkApprove" asp-controller="DocumentenCentrum" class="d-none">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ids" id="bulkApproveIdsInput" />
            <input type="hidden" name="notes" id="bulkApproveNotesInput" />
        </form>
        <form id="formBulkReject" method="post" asp-action="BulkReject" asp-controller="DocumentenCentrum" class="d-none">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ids" id="bulkRejectIdsInput" />
            <input type="hidden" name="notes" id="bulkRejectNotesInput" />
        </form>

        @* ── Documententabel ──────────────────────────────────────────────────── *@
        <div class="card card-modern" style="border-top-left-radius:0;border-top-right-radius:0;border-top:none;">
            <div class="card-body p-0">

                @if (!Model.Items.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bx bx-inbox" style="font-size:2.5rem;"></i>
                        <p class="mt-2 mb-0">Geen documenten gevonden.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0 align-middle" id="documentsTable">
                            <thead class="table-light" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.04em;color:#6b7280;">
                                <tr>
                                    <th class="ps-3" style="width:36px;">
                                        <input type="checkbox" id="checkAll" class="form-check-input" />
                                    </th>
                                    <th>Leverancier / Factuur</th>
                                    <th class="dc-col-hide-sm">Type</th>
                                    <th class="text-end text-nowrap">Bedrag</th>
                                    <th class="text-nowrap">Datum / Vervalt</th>
                                    <th class="dc-col-hide-sm">Project / Contract / Categorie</th>
                                    <th class="dc-col-hide-sm">Budget impact</th>
                                    <th class="dc-col-hide-sm">Toegewezen</th>
                                    <th class="text-end pe-3">Acties</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    @* ── Type label / badge ── *@
                                    var typeLabel = item.DocumentType switch {
                                        "CreditNote" => "Creditnota",
                                        "Invoice"    => "Factuur",
                                        _            => item.DocumentType ?? "—"
                                    };
                                    var typeCls = item.DocumentType == "CreditNote"
                                        ? "badge bg-danger bg-opacity-10 text-danger border border-danger-subtle"
                                        : "badge bg-light text-dark border";

                                    @* ── Kostcontext badge ── *@
                                    var ctxBadgeCls = item.CostContextType switch {
                                        CostContextType.ProjectCost        => "tbadge tbadge-project",
                                        CostContextType.GeneralCompanyCost => "tbadge tbadge-company",
                                        _                                  => "tbadge tbadge-unsure"
                                    };
                                    var ctxIcon = item.CostContextType switch {
                                        CostContextType.ProjectCost        => "bx-building-house",
                                        CostContextType.GeneralCompanyCost => "bx-briefcase",
                                        _                                  => "bx-help-circle"
                                    };

                                    @* ── Budget impact berekening ── *@
                                    decimal pctBefore = 0, pctAfter = 0;
                                    string biLabel = null;
                                    string biFillCls = "bi-fill-ok";
                                    string biLabelCls = "text-success";

                                    if (item.ContractTotalAmount.HasValue && item.ContractTotalAmount.Value > 0
                                        && item.ContractInvoicedBefore.HasValue)
                                    {
                                        var before = item.ContractInvoicedBefore.Value;
                                        var after  = before + item.TotalAmountInclVat;
                                        var total  = item.ContractTotalAmount.Value;
                                        pctBefore = Math.Round(Math.Min(100, before / total * 100), 0);
                                        pctAfter  = Math.Round(after / total * 100, 0);

                                        if (pctAfter >= 100)
                                        {
                                            biFillCls  = "bi-fill-danger";
                                            biLabel    = "Budget overschreden";
                                            biLabelCls = "text-danger";
                                        }
                                        else if (pctAfter >= 90)
                                        {
                                            biFillCls  = "bi-fill-warn";
                                            biLabel    = "Contract bijna opgebruikt";
                                            biLabelCls = "text-warning";
                                        }
                                        else
                                        {
                                            biLabel    = "Binnen budget";
                                            biLabelCls = "text-success";
                                        }
                                    }

                                    @* ── Insight chip vanuit budget ── *@
                                    string budgetChipText  = null;
                                    string budgetChipClass = "ic ic-ok";
                                    if (item.ContractTotalAmount.HasValue && item.ContractInvoicedBefore.HasValue)
                                    {
                                        if (pctAfter >= 100)
                                        {
                                            var overshoot = (item.ContractInvoicedBefore.Value + item.TotalAmountInclVat) - item.ContractTotalAmount.Value;
                                            budgetChipText  = $"Budget overschreden met €{overshoot:N0}";
                                            budgetChipClass = "ic ic-danger";
                                        }
                                        else if (pctAfter >= 90)
                                        {
                                            budgetChipText  = $"Contract {pctAfter:N0}% na goedkeuring";
                                            budgetChipClass = "ic ic-warn";
                                        }
                                        else if (pctAfter > 0)
                                        {
                                            budgetChipText  = $"Binnen budget ({pctAfter:N0}% gebruikt)";
                                            budgetChipClass = "ic ic-ok";
                                        }
                                    }

                                    <tr class="js-doc-row" data-id="@item.Id"
                                        data-href="@Url.Action("Detail","DocumentenCentrum",new{id=item.Id})">

                                        @* Checkbox *@
                                        <td class="ps-3 js-no-row-click">
                                            <input type="checkbox" class="form-check-input js-row-check" value="@item.Id" />
                                        </td>

                                        @* Leverancier / Factuur *@
                                        <td>
                                            <div class="fw-semibold d-flex align-items-center" style="font-size:.85rem;">@item.SupplierName <span class="@typeCls ms-2 fw-light" style="font-size:.68rem;">@typeLabel</span></div>
                                            <div class="d-flex align-items-center gap-1 flex-wrap mt-1">
                                                @if (!string.IsNullOrEmpty(item.InvoiceNumber))
                                                {
                                                    <span class="text-muted" style="font-size:.75rem;">@item.InvoiceNumber</span>
                                                }
                                                
                                                @if (item.Source == "Octopus")
                                                {
                                                    <span class="badge" style="background:#0a5a3b;font-size:.65rem;">Octopus</span>
                                                }
                                            </div>
                                            @* Insight chips *@
                                            <div class="ic-row mt-1">
                                                @if (!string.IsNullOrEmpty(budgetChipText))
                                                {
                                                    <span class="@budgetChipClass">@budgetChipText</span>
                                                }
                                                @foreach (var chip in item.WarningChips)
                                                {
                                                    var chipCls = chip == "Vervallen"
                                                        ? "ic ic-danger"
                                                        : chip.StartsWith("Vervalt") ? "ic ic-warn"
                                                        : chip == "BTW afwijking" || chip == "Bedrag afwijkt" ? "ic ic-warn"
                                                        : "ic ic-muted";
                                                    <span class="@chipCls">@chip</span>
                                                }
                                            </div>
                                            @if (item.FirstPdfAttachmentId.HasValue)
                                            {
                                                <div class="mt-1">
                                                    <a href="@Url.Action("ViewAttachment","DocumentenCentrum",new{attachmentId=item.FirstPdfAttachmentId.Value})"
                                                       target="_blank" class="text-muted text-decoration-none js-no-row-click" style="font-size:.75rem;">
                                                        <i class="bx bxs-file-pdf text-danger me-1"></i>PDF
                                                    </a>
                                                </div>
                                            }
                                        </td>

                                        @* Type (kostcontext) + status *@
                                        <td class="dc-col-hide-sm">
                                            <span class="@ctxBadgeCls"><i class="bx @ctxIcon"></i>@item.CostContextLabel</span>
                                            <div class="mt-1">
                                                <span class="badge @item.StatusBadgeClass" style="font-size:.65rem;">@item.StatusLabel</span>
                                            </div>
                                        </td>

                                        @* Bedrag *@
                                        <td class="text-end text-nowrap fw-semibold @(item.TotalAmountInclVat < 0 ? "text-danger" : "")"
                                            style="font-size:.85rem;">
                                            € @item.TotalAmountInclVat.ToString("N2")
                                        </td>

                                        @* Datum / Vervalt *@
                                        <td class="text-nowrap">
                                            <div style="font-size:.82rem;">@item.InvoiceDate.ToString("dd/MM/yyyy")</div>
                                            @if (item.DueDate.HasValue)
                                            {
                                                var overdue = item.DueDate.Value < DateOnly.FromDateTime(DateTime.Today)
                                                           && item.StatusId < IncomingInvoiceStatus.Paid;
                                                <div class="@(overdue ? "text-danger" : "text-muted")" style="font-size:.75rem;">
                                                    @if (overdue) { <i class="bx bx-time-five"></i> }
                                                    vervalt @item.DueDate.Value.ToString("dd/MM/yyyy")
                                                </div>
                                            }
                                        </td>

                                        @* Project / Contract / Categorie *@
                                        <td class="dc-col-hide-sm">
                                            @if (!string.IsNullOrEmpty(item.ProjectName))
                                            {
                                                <div class="fw-semibold" style="font-size:.82rem;">@item.ProjectName</div>
                                            }
                                            else if (!string.IsNullOrEmpty(item.SuggestedProjectName))
                                            {
                                                <div style="font-size:.82rem;">
                                                    <i class="bx bx-bulb text-warning me-1"></i>
                                                    <span class="text-muted fst-italic">@item.SuggestedProjectName</span>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(item.ContractName))
                                            {
                                                <div class="text-muted" style="font-size:.72rem;">
                                                    <i class="bx bx-file-blank me-1"></i>@item.ContractName
                                                    @if (item.ContractTotalAmount.HasValue)
                                                    {
                                                        <span>→ €@item.ContractTotalAmount.Value.ToString("N0")</span>
                                                    }
                                                </div>
                                            }
                                            @if (string.IsNullOrEmpty(item.ProjectName) && string.IsNullOrEmpty(item.SuggestedProjectName))
                                            {
                                                if (HasFlag(item.ReasonFlags, InvoiceReasonFlags.GeneralCostSuggested))
                                                {
                                                    <span class="badge bg-secondary" style="font-size:.7rem;">Alg. kost</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                            }
                                        </td>

                                        @* Budget impact *@
                                        <td class="dc-col-hide-sm">
                                            @if (item.ContractTotalAmount.HasValue && item.ContractTotalAmount.Value > 0
                                                 && item.ContractInvoicedBefore.HasValue)
                                            {
                                                <div class="bi-wrap">
                                                    <div class="bi-header">
                                                        <span class="bi-pcts">@pctBefore% → @pctAfter%</span>
                                                        <span class="bi-amount">€ @((item.ContractTotalAmount.Value).ToString("N0"))</span>
                                                    </div>
                                                    <div class="bi-bar">
                                                        <div class="bi-bar-bg">
                                                            <div class="bi-bar-fill @biFillCls"
                                                                 style="width:@(Math.Min(100, pctAfter))%"></div>
                                                        </div>
                                                    </div>
                                                    <div class="bi-lbl @biLabelCls">@biLabel</div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>

                                        @* Toegewezen *@
                                        <td class="dc-col-hide-sm">
                                            @if (!string.IsNullOrEmpty(item.AssignedToName))
                                            {
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="dc-user-avatar" style="width:28px;height:28px;font-size:.6rem;flex-shrink:0;">
                                                        @string.Join("", (item.AssignedToName ?? "?").Split(' ').Take(2).Select(p => char.ToUpper(p[0])))
                                                    </span>
                                                    <small class="text-nowrap">@item.AssignedToName</small>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>

                                        @* Acties *@
                                        <td class="text-end pe-3 text-nowrap js-no-row-click">
                                            <form method="post"
                                                  asp-action="UpdateStatus"
                                                  asp-controller="DocumentenCentrum"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="incomingInvoiceId" value="@item.Id" />
                                                <input type="hidden" name="statusId" value="@IncomingInvoiceStatus.Approved" />
                                                <button type="submit" class="btn btn-sm btn-outline"
                                                        title="Goedkeuren"
                                                        onclick="return confirm('Document goedkeuren?')">
                                                    <i class="bx bx-check"></i>
                                                </button>
                                            </form>
                                            <form method="post"
                                                  asp-action="UpdateStatus"
                                                  asp-controller="DocumentenCentrum"
                                                  class="d-inline ms-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="incomingInvoiceId" value="@item.Id" />
                                                <input type="hidden" name="statusId" value="@IncomingInvoiceStatus.Rejected" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        title="Afwijzen"
                                                        onclick="return confirm('Document afwijzen?')">
                                                    <i class="bx bx-x"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @* ── Footer: telling + paginering ─────────────────────────────────── *@
            <div class="card-footer d-flex align-items-center justify-content-between flex-wrap gap-2 py-2 px-3">
                <small class="text-muted">
                    @if (Model.TotalCount == 0)
                    {
                        <span>Geen documenten gevonden</span>
                    }
                    else
                    {
                        <span>Document @firstItem tot @lastItem van @Model.TotalCount</span>
                    }
                </small>
                @if (Model.TotalPages > 1)
                {
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@PagUrl(1)">«</a>
                            </li>
                            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@PagUrl(Model.Page - 1)">‹</a>
                            </li>
                            @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                            {
                                var pageNum = p;
                                <li class="page-item @(pageNum == Model.Page ? "active" : "")">
                                    <a class="page-link" href="@PagUrl(pageNum)">@pageNum</a>
                                </li>
                            }
                            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@PagUrl(Model.Page + 1)">›</a>
                            </li>
                            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@PagUrl(Model.TotalPages)">»</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>

    </div>
</section>

@* ── Modals ────────────────────────────────────────────────────────────────── *@
@await Html.PartialAsync("_AssignModal")
@await Html.PartialAsync("_UploadModal")

<div class="modal fade" id="syncModal" tabindex="-1" aria-labelledby="syncModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Sync" asp-controller="DocumentenCentrum">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="syncModalLabel"><i class="bx bx-refresh me-2"></i>Synchroniseren vanuit Octopus</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Facturatiebedrijf</label>
                        <select name="issuerCompanyId" class="form-select form-control-modern" asp-items="ViewBag.IssuerCompanies" required>
                            <option value="">— Kies een bedrijf —</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Vanaf datum <span class="text-muted fw-normal">(optioneel)</span></label>
                        <input type="date" name="dateFrom" class="form-control form-control-modern" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="btn btn-primary"><i class="bx bx-refresh me-1"></i>Synchroniseren</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/js/document-center.js"></script>
}
