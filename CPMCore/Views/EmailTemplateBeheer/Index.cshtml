@model CPMCore.Models.Instellingen.EmailTemplateListVM
@{
    ViewData["Title"] = "E-mailtemplates";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <div>
                <h1 class="font-weight-bold mb-0">E-mailtemplates</h1>
                <p class="mb-0 text-muted">Beheer voorgedefinieerde e-mails (onderwerp + tekst) om te versturen naar projectcontacten.</p>
            </div>
            <a class="btn btn-primary" href="@Url.Action("Aanmaken")">
                Nieuwe template
            </a>
        </div>

        @if (TempData["Message"] != null)
        {
            var messageType = TempData["MessageType"]?.ToString() ?? "success";
            <div class="alert alert-@(messageType == "error" ? "danger" : messageType)">@TempData["Message"]</div>
        }

        <section class="card card-modern">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Naam</th>
                                <th>Onderwerp</th>
                                <th>Status</th>
                                <th class="text-end">Acties</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var template in Model.Templates)
                            {
                                <tr>
                                    <td><strong>@template.Naam</strong></td>
                                    <td>@template.Onderwerp</td>
                                    <td>
                                        <span class="badge @(template.IsActief ? "bg-success" : "bg-secondary")">
                                            @(template.IsActief ? "Actief" : "Inactief")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a class="btn btn-link p-0 me-2" href="@Url.Action("Bewerken", new { id = template.ID })" title="Bewerken">
                                            <i class="bx bx-edit"></i>
                                        </a>
                                        <form class="d-inline" method="post" action="@Url.Action("Verwijderen")">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@template.ID" />
                                            <button type="submit" class="btn btn-link p-0 text-danger" title="Verwijderen" onclick="return confirm('Template verwijderen?');">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Templates.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        Er zijn nog geen e-mailtemplates. Maak je eerste template aan.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>
</div>
