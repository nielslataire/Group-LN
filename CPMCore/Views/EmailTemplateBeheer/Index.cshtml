@model CPMCore.Models.Instellingen.EmailTemplateListVM
@{
    ViewData["Title"] = "E-mailtemplates";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">E-mailtemplates</h1>
        <p class="text-muted mb-0">Beheer voorgedefinieerde e-mails (onderwerp + tekst) om te versturen naar projectcontacten.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Instellingen")" class="btn btn-outline-secondary">
            <i class="bx bx-cog"></i> Instellingen
        </a>
        <a href="@Url.Action("Aanmaken")" class="btn btn-primary">
            <i class="bx bx-plus"></i> Nieuwe template
        </a>
    </div>
</div>

@if (!Model.Templates.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bx bx-envelope" style="font-size: 3rem; color: #adb5bd;"></i>
            <p class="mt-3 text-muted">Er zijn nog geen e-mailtemplates. Maak je eerste template aan.</p>
            <a href="@Url.Action("Aanmaken")" class="btn btn-primary mt-2">
                <i class="bx bx-plus"></i> Nieuwe template
            </a>
        </div>
    </div>
}
else
{
    <div class="card" style="border-radius:8px;border:1px solid #e9ecef;background-color:#fff;">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Naam</th>
                        <th>Onderwerp</th>
                        <th style="width:120px;">Status</th>
                        <th style="width:90px;">Acties</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var template in Model.Templates)
                    {
                        <tr>
                            <td class="fw-semibold">@template.Naam</td>
                            <td>@template.Onderwerp</td>
                            <td>
                                @if (template.IsActief)
                                {
                                    <span class="badge bg-success">Actief</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactief</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a href="@Url.Action("Bewerken", new { id = template.ID })" class="btn btn-sm btn-outline-secondary" title="Bewerken">
                                        <i class="bx bx-edit-alt"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Verwijderen" onclick="etVerwijder(@template.ID)">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                    <form id="del-@template.ID" method="post" action="@Url.Action("Verwijderen")" style="display:none;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@template.ID" />
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section PageScripts {
<script>
    function etVerwijder(id) {
        if (!confirm('Weet je zeker dat je deze template wil verwijderen?')) return;
        document.getElementById('del-' + id).submit();
    }
</script>
}
