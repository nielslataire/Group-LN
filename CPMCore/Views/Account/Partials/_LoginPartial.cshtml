@using CPMCore.Helpers

@if (User?.Identity?.IsAuthenticated == true)
{
    var displayName = User.GetCpmDisplayName() ?? "Gebruiker";
    <ul class="nav nav-pills">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">
                <i class="bx bx-user-circle"></i> @displayName
            </a>
            <div class="dropdown-menu dropdown-menu-end">
                <div class="dropdown-item-text text-muted small">@User.GetCpmEmail()</div>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="@Url.Action("SignOut", "Account")"><i class="bx bx-log-out"></i> Afmelden</a>
            </div>
        </li>
    </ul>
}
else
{
    <ul class="nav nav-pills">
        <li class="nav-item">
            <a class="nav-link" href="@Url.Action("Login", "Account")"><i class="bx bx-log-in"></i> Aanmelden</a>
        </li>
    </ul>
}