@model UpdateViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Mijn profiel";
}

<section role="main" class="content-body">
    <header class="page-header">
        <h2>@ViewData["Title"]</h2>
        <div class="right-wrapper text-end">
            <ol class="breadcrumbs">
                <li>
                    <a href="@Url.Action("Index", "Home")">
                        <i class="bx bx-home-alt"></i>
                    </a>
                </li>
                <li><span>Gebruikers</span></li>
                <li><span>Mijn profiel</span></li>
            </ol>
            <a class="sidebar-right-toggle" data-open="sidebar-right"><i class="fas fa-chevron-left"></i></a>
        </div>
    </header>

    <div class="row">
        <div class="col-lg-8">
            <section class="card">
                <header class="card-header">
                    <h2 class="card-title">Persoonlijke gegevens</h2>
                </header>
                <div class="card-body">
                    @using (Html.BeginForm("UserProfile", "Account", FormMethod.Post, new { @class = "form-horizontal" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                        @Html.HiddenFor(m => m.User.Id)

                        <div class="form-group row pb-3">
                            <label class="col-sm-3 col-form-label text-sm-end">@Html.DisplayNameFor(m => m.User.UserName)</label>
                            <div class="col-sm-9">
                                @Html.TextBoxFor(m => m.User.UserName, new { @class = "form-control", placeholder = "Gebruikersnaam" })
                                @Html.ValidationMessageFor(m => m.User.UserName, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group row pb-3">
                            <label class="col-sm-3 col-form-label text-sm-end">@Html.DisplayNameFor(m => m.User.Email)</label>
                            <div class="col-sm-9">
                                @Html.TextBoxFor(m => m.User.Email, new { @class = "form-control", type = "email", placeholder = "naam@bedrijf.be" })
                                @Html.ValidationMessageFor(m => m.User.Email, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group row pb-3">
                            <label class="col-sm-3 col-form-label text-sm-end">@Html.DisplayNameFor(m => m.User.Name)</label>
                            <div class="col-sm-9">
                                @Html.TextBoxFor(m => m.User.Name, new { @class = "form-control", placeholder = "Naam" })
                                @Html.ValidationMessageFor(m => m.User.Name, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group row pb-3">
                            <label class="col-sm-3 col-form-label text-sm-end">@Html.DisplayNameFor(m => m.User.Forename)</label>
                            <div class="col-sm-9">
                                @Html.TextBoxFor(m => m.User.Forename, new { @class = "form-control", placeholder = "Voornaam" })
                                @Html.ValidationMessageFor(m => m.User.Forename, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group row pb-3">
                            <label class="col-sm-3 col-form-label text-sm-end">@Html.DisplayNameFor(m => m.User.JobFunction)</label>
                            <div class="col-sm-9">
                                @Html.TextBoxFor(m => m.User.JobFunction, new { @class = "form-control", placeholder = "Functie" })
                                @Html.ValidationMessageFor(m => m.User.JobFunction, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group row pb-4">
                            <label class="col-sm-3 col-form-label text-sm-end">@Html.DisplayNameFor(m => m.User.Cellphone)</label>
                            <div class="col-sm-9">
                                @Html.TextBoxFor(m => m.User.Cellphone, new { @class = "form-control", placeholder = "+32 123 45 67 89" })
                                @Html.ValidationMessageFor(m => m.User.Cellphone, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="bx bx-save"></i> Wijzigingen opslaan
                            </button>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>
</section>