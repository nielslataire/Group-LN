@model CPMCore.Models.EntraLoginViewModel

@{
    ViewBag.Title = "Aanmelden";
    Layout = "_Base";
}

<section class="body-sign">
    <div class="center-sign">
        <a href="/" class="logo float-start">
            <img src="~/img/logo.png" height="54" alt="CPMCore" />
        </a>

        <div class="panel card-sign">
            <div class="card-title-sign mt-3 text-end">
                <h2 class="title text-uppercase font-weight-bold m-0">
                    <i class="bx bx-shield-quarter me-1 text-6 position-relative top-5"></i> Aanmelden
                </h2>
            </div>
            <div class="card-body">
                <p class="text-muted mb-4">
                    Meld je aan met je Microsoft-account om toegang te krijgen tot CPMCore.
                </p>
                <a class="btn btn-primary w-100" href="@Url.Action("SignIn", "Account", new { returnUrl = Model.ReturnUrl })">
                    <i class="bx bxl-microsoft me-2"></i> Aanmelden met Microsoft
                </a>
            </div>
        </div>

        <p class="text-center text-muted mt-3 mb-3">&copy; Copyright @DateTime.Now.Year. All Rights Reserved.</p>
    </div>
</section>