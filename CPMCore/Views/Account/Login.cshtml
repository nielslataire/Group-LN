@model CPMCore.Models.EntraLoginViewModel

@{
    ViewBag.Title = "Aanmelden – Group LN";
    Layout = "_Base";

    // ── Tekst per type ────────────────────────────────────────────
    var isContractor = Model.Type == CPMCore.Models.LoginType.Contractor;
    var isCustomer   = Model.Type == CPMCore.Models.LoginType.Customer;

    var platformLabel = isCustomer   ? "Klantenportaal"
                      : isContractor ? "Portaal"
                      :                "Intern Platform";

    var featuresLabel = (isContractor || isCustomer) ? "Wat u kunt doen" : "Platform mogelijkheden";

    var cardTitle = isCustomer   ? "Welkom bij uw portaal"
                  : isContractor ? "Welkom terug"
                  :                "Welkom terug";

    var showGoogle = Model.ShowGoogleLogin;
    var typeParam  = isContractor ? "contractor" : isCustomer ? "customer" : null;

    var cardSub = isCustomer
        ? "Volg uw project, bekijk documenten en communiceer rechtstreeks met het Group LN team."
        : isContractor
        ? (showGoogle
            ? "Meld u aan met uw Microsoft- of Google-account om toegang te krijgen tot het Group LN portaal."
            : "Meld u aan met uw Microsoft-account om toegang te krijgen tot het Group LN portaal.")
        : "Meld u aan met uw organisatie Microsoft-account om toegang te krijgen tot het interne platform.";

    var infoBox = isCustomer
        ? (showGoogle
            ? "Beveiligde toegang via Microsoft Entra ID of Google. Uw persoonlijke gegevens en projectinformatie zijn beschermd en alleen voor u zichtbaar."
            : "Beveiligde toegang via Microsoft Entra ID. Uw persoonlijke gegevens en projectinformatie zijn beschermd en alleen voor u zichtbaar.")
        : isContractor
        ? (showGoogle
            ? "Gebruik het account dat hoort bij het e-mailadres waarop u de uitnodiging ontving. Alleen uitgenodigde gebruikers hebben toegang."
            : "Uw gegevens worden beveiligd via Microsoft Entra ID. Alleen geautoriseerde gebruikers met een geldig gastaccount hebben toegang.")
        : "Beveiligd via Microsoft Entra ID. Alleen medewerkers met een actief organisatie-account hebben toegang.";

    var helpEmail = isCustomer   ? "klanten@groupln.be"
                  : isContractor ? "support@groupln.be"
                  :                "niels.lataire@groupln.be";

    var helpLabel = isCustomer   ? "Contacteer ons team"
                  : isContractor ? "Contacteer ons"
                  :                "IT-support";
}

@section styles {
    <link rel="stylesheet" href="~/css/account-custom.css" />
}

<div class="gl-login">

    <!-- Trage, gedempte kleurverloop-achtergrond achter het groene paneel — puur CSS
         (background-position-animatie, geen WebGL/canvas nodig), pauzeert via login.js
         zodra het tabblad niet zichtbaar is of prefers-reduced-motion aan staat. -->
    <div class="gl-aurora" aria-hidden="true"></div>

    <!-- ── Logo ──────────────────────────────────────────────────── -->
    <div class="gl-logo-bar">
        <a href="/" class="gl-logo">
            <img src="~/img/logo.png" alt="GROUP LN" />
            <div>
                <div class="gl-company">GROUP LN</div>
                <div class="gl-platform">@platformLabel</div>
            </div>
        </a>
    </div>

    <!-- ── Feature-tegels (enkel desktop) ────────────────────────── -->
    <div class="gl-features-bar">
        <div class="gl-features-label">@featuresLabel</div>
        <div class="gl-grid">
            @if (isCustomer)
            {
                <div class="gl-tile">
                    <div class="gl-tile-icon"><i class="bx bx-home-alt" aria-hidden="true"></i></div>
                    <div class="gl-tile-name">Uw woning volgen</div>
                    <div class="gl-tile-desc">Bekijk de voortgang van uw project, van fundering tot oplevering.</div>
                </div>
                <div class="gl-tile">
                    <div class="gl-tile-icon"><i class="bx bx-list-plus" aria-hidden="true"></i></div>
                    <div class="gl-tile-name">Meerwerken bekijken</div>
                    <div class="gl-tile-desc">Overzicht van alle aangevraagde en goedgekeurde meerwerken.</div>
                </div>
                <div class="gl-tile">
                    <div class="gl-tile-icon"><i class="bx bx-file" aria-hidden="true"></i></div>
                    <div class="gl-tile-name">Documenten raadplegen</div>
                    <div class="gl-tile-desc">Al uw contracten, plannen en facturen op één plek.</div>
                </div>
                <div class="gl-tile">
                    <div class="gl-tile-icon"><i class="bx bx-message" aria-hidden="true"></i></div>
                    <div class="gl-tile-name">Berichten ontvangen</div>
                    <div class="gl-tile-desc">Rechtstreeks communiceren met uw projectteam.</div>
                </div>
            }
            else if (isContractor)
            {
                <div class="gl-tile">
                    <div class="gl-tile-icon"><i class="bx bx-building-house" aria-hidden="true"></i></div>
                    <div class="gl-tile-name">Projecten volgen</div>
                    <div class="gl-tile-desc">Blijf op de hoogte van de voortgang van uw projecten in real-time.</div>
                </div>
                <div class="gl-tile">
                    <div class="gl-tile-icon"><i class="bx bx-task" aria-hidden="true"></i></div>
                    <div class="gl-tile-name">Punten beheren</div>
                    <div class="gl-tile-desc">Uw punten raadplegen en afvinken voor controle.</div>
                </div>
                <div class="gl-tile">
                    <div class="gl-tile-icon"><i class="bx bx-folder" aria-hidden="true"></i></div>
                    <div class="gl-tile-name">Documenten beheren</div>
                    <div class="gl-tile-desc">Veilig documenten delen en raadplegen op één centrale plek.</div>
                </div>
                <div class="gl-tile">
                    <div class="gl-tile-icon"><i class="bx bx-group" aria-hidden="true"></i></div>
                    <div class="gl-tile-name">Direct communiceren</div>
                    <div class="gl-tile-desc">Snel en efficiënt communiceren met het Group LN team.</div>
                </div>
            }
            else
            {
                <div class="gl-tile">
                    <div class="gl-tile-icon"><i class="bx bx-grid-alt" aria-hidden="true"></i></div>
                    <div class="gl-tile-name">Project dashboard</div>
                    <div class="gl-tile-desc">Volledig overzicht</div>
                </div>
                <div class="gl-tile">
                    <div class="gl-tile-icon"><i class="bx bx-bar-chart-alt-2" aria-hidden="true"></i></div>
                    <div class="gl-tile-name">Financieel beheer</div>
                    <div class="gl-tile-desc">Facturatie &amp; budget</div>
                </div>
                <div class="gl-tile">
                    <div class="gl-tile-icon"><i class="bx bx-group" aria-hidden="true"></i></div>
                    <div class="gl-tile-name">Relatiebeheer</div>
                    <div class="gl-tile-desc">Klanten &amp; leveranciers</div>
                </div>
                <div class="gl-tile">
                    <div class="gl-tile-icon"><i class="bx bx-cog" aria-hidden="true"></i></div>
                    <div class="gl-tile-name">Configuratie</div>
                    <div class="gl-tile-desc">Rollen &amp; rechten</div>
                </div>
            }
        </div>
    </div>

    <!-- ── Copyright ─────────────────────────────────────────────── -->
    <div class="gl-copy-bar">
        &copy; @DateTime.Now.Year Group LN. Alle rechten voorbehouden.
    </div>

    <!-- ── Witte kaart ────────────────────────────────────────────── -->
    <div class="gl-right">
        <div class="gl-card">

            <h1>@cardTitle</h1>
            <p class="gl-card-sub">@cardSub</p>

            @{
                var loginError = Context.Request.Query["error"].ToString();
            }
            @if (!string.IsNullOrWhiteSpace(loginError))
            {
                <div class="gl-error-box">
                    <i class="bx bx-error-circle gl-error-icon" aria-hidden="true"></i>
                    <span>@loginError</span>
                </div>
            }

            <a class="btn-gl-ms"
               href="@Url.Action("SignIn", "Account", new { returnUrl = Model.ReturnUrl, type = typeParam })">
                <i class="bx bxl-microsoft ms-icon" aria-hidden="true"></i>
                Aanmelden met Microsoft
                <i class="bx bx-chevron-right ms-arrow" aria-hidden="true"></i>
            </a>

            @if (showGoogle)
            {
                <div class="gl-or" aria-hidden="true"><span>of</span></div>

                <a class="btn-gl-google"
                   href="@Url.Action("SignIn", "Account", new { returnUrl = Model.ReturnUrl, provider = "google", type = typeParam })">
                    <svg class="google-icon" viewBox="0 0 48 48" width="18" height="18" aria-hidden="true" focusable="false">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                    </svg>
                    Aanmelden met Google
                    <i class="bx bx-chevron-right ms-arrow" aria-hidden="true"></i>
                </a>
            }

            <div class="gl-info-box">
                <i class="bx bx-shield info-icon" aria-hidden="true"></i>
                <span>@infoBox</span>
            </div>

            <div class="gl-help">
                Hulp nodig? <a href="mailto:@helpEmail">@helpLabel</a>
            </div>

            @if (isCustomer)
            {
@*                 <div class="gl-portal-links">
                    <span>Leverancier? <a href="/aannemer">Leveranciersportaal</a></span>
                    <span>Intern? <a href="/">Intern platform</a></span>
                </div> *@
            }
            else if (isContractor)
            {
                <div class="gl-portal-links">
                    <span>Interne medewerkers melden zich aan via het <a href="/">interne platform</a>.</span>
                </div>
            }

        </div>
    </div>

</div>

@section scripts {
    <script src="~/js/login.js" asp-append-version="true"></script>
}
