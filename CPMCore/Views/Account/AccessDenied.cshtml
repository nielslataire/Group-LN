@{
ViewData["Title"] = "Geen toegang";
Layout = null;
}

<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CPMCore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.css" />
    <link rel="stylesheet" href="~/lib/boxicons/css/boxicons.min.css" />
    <link rel="stylesheet" href="~/css/custom.css" />

    <link rel="stylesheet" href="~/css/theme.css" />
    <link rel="stylesheet" href="~/css/modern.css" />

    <!-- Skin CSS -->
    <link rel="stylesheet" href="~/css/skins/default.css" />
    <link rel="stylesheet" href="~/css/skins/test.css" />
    <link rel="stylesheet" href="~/css/skins/test-extension.css" />

    <!-- Account custom CSS -->
    <link rel="stylesheet" href="~/css/account-custom.css" />
</head>
<body>
    <main class="gl-access-page">
        <section class="gl-access-shell">
            <div class="gl-access-brand" aria-label="Group LN">
                <img class="gl-access-brand-logo" src="~/img/logo.png" alt="Group LN logo" />
                <div class="gl-access-brand-title mt-2">Group LN</div>
            </div>

            <article class="gl-access-card">
                <div class="gl-access-icon-wrap" aria-hidden="true">
                    <i class='bx bx-shield-x'></i>
                </div>
                <h2 class="mb-2 font-weight-semibold">Geen toegang</h2>
                <p>
                    U heeft geen toestemming om deze sectie te bekijken.
                    Neem contact op met uw beheerder als u denkt dat dit een fout is.
                </p>

                <a class="btn btn-primary btn-modern w-100 text-4 py-3 mb-3" href="@Url.Content("~/")">Naar dashboard</a>
                <a class="btn btn-link text-color-dark text-4 mb-3" href="@Url.Action("SignOut", "Account")">
                    <i class='bx bx-log-out me-1'></i> Uitloggen
                </a>

                <hr class="solid my-3" />
                <div class="gl-access-help">
                    Hulp nodig? <a href="mailto:info@groupln.be">Contacteer ons</a>
                </div>
            </article>

            <div class="gl-access-copyright">
                © @DateTime.Now.Year Group LN. Alle rechten voorbehouden.
            </div>
        </section>
    </main>
</body>
</html>
