﻿@{
ViewData["Title"] = "Geen toegang";
Layout = null;
}

<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CPMCore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.css" />
    <link rel="stylesheet" href="~/lib/boxicons/css/boxicons.min.css" />
    <link rel="stylesheet" href="~/css/custom.css" />

    <link rel="stylesheet" href="~/css/theme.css" />
    <link rel="stylesheet" href="~/css/modern.css" />

    <!-- Skin CSS -->
    <link rel="stylesheet" href="~/css/skins/default.css" />
    <link rel="stylesheet" href="~/css/skins/test.css" />
    <link rel="stylesheet" href="~/css/skins/test-extension.css" />
    <style>
        @@font-face {
            font-family: "Avenir-Black";
            src: url('/fonts/Avenir-Black.ttf') format('truetype');
            font-weight: 900;
            font-style: normal;
        }

        :root {
            --access-primary: var(--primary, #0a5a3b);
            --access-card: #f5f5f5;
            --access-text: #1e293b;
            --access-muted: #64748b;
            --access-line: #d5dce5;
            --access-danger: #e53935;
            --access-danger-soft: #f5e9e9;
        }

        html, body {
            height: 100%;
            margin: 0;
            font-family: "Open Sans", Arial, sans-serif;
            background: var(--access-primary);
        }

        .access-denied-page {
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            background: var(--access-primary);
            padding: 24px;
        }

        .access-shell {
            width: min(100%, 980px);
            min-height: min(95dvh, 760px);
            border-radius: 16px;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 34px 26px 26px;
            z-index: 2;
            background: transparent;
        }
        .btn{
            border-radius: 8px;
        }

        .brand-header {
            text-align: center;
            margin-top: 8px;
        }

        .brand-logo {
            width: 86px;
            height: auto;
            display: block;
            margin: 0 auto 10px;
        }

        .brand-title {
            color: #fff;
            font-family: "Avenir-Black", "Avenir Next", "Segoe UI", Arial, sans-serif;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
            font-size: 40px;
            line-height: 1;
        }

        .access-card {
            width: min(100%, 480px);
            margin: 32px auto 0;
            border-radius: 16px;
            background: var(--access-card);
            box-shadow: 0 12px 40px rgba(9, 30, 20, .18);
            padding: 30px 30px 26px;
            text-align: center;
        }

        .icon-wrap {
            width: 64px;
            height: 64px;
            border-radius: 14px;
            margin: 0 auto 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--access-danger-soft);
            color: var(--access-danger);
            font-size: 34px;
        }


        .access-card p {
            margin: 0 auto 26px;
            max-width: 360px;
            color: var(--access-muted);
            font-size: 14px;
            line-height: 1.55;
        }

        .help-text {
            font-size: 14px;
            color: #7b8698;
        }

            .help-text a {
                color: #0d2f4f;
                text-decoration: none;
                font-weight: 600;
            }

        .copyright {
            margin-top: 22px;
            text-align: center;
            color: rgba(220,231,224,.55);
            font-size: 14px;
        }

        @@media (max-width: 991.98px) {
            .access-shell {
                min-height: min(100dvh, 1080px);
                border-radius: 20px;
                padding: 28px 16px 20px;
            }

            .brand-title {
                font-size: 24px;
            }

            .access-card {
                width: min(100%, 540px);
                padding: 28px 22px 22px;
                border-radius: 18px;
            }
        }

        @@media (max-width: 575.98px) {
            .access-denied-page {
                padding: 18px 10px;
                align-items: stretch;
            }

            .access-shell {
                min-height: calc(100dvh - 36px);
                margin: auto;
                padding: 26px 12px 18px;
                border-radius: 16px;
            }

            .access-card {
                width: min(100%, 420px);
                margin-top: 24px;
                padding: 24px 18px 20px;
            }


                .access-card p {
                    font-size: 14px;
                }

            .help-text {
                font-size: 12px;
            }

            .copyright {
                font-size: 14px;
                margin-top: 18px;
            }
        }
    </style>
</head>
<body>
    <main class="access-denied-page">
        <section class="access-shell">
            <div class="brand-header" aria-label="Group LN">
                <img class="brand-logo" src="~/img/logo.png" alt="Group LN logo" />
                <div class="brand-title mt-2">Group LN</div>
            </div>

            <article class="access-card">
                <div class="icon-wrap" aria-hidden="true">
                    <i class='bx bx-shield-x'></i>
                </div>
                <h2 class="mb-2 font-weight-semibold">Geen toegang</h2>
                <p>
                    U heeft geen toestemming om deze sectie te bekijken.
                    Neem contact op met uw beheerder als u denkt dat dit een fout is.
                </p>

                <a class="btn btn-primary btn-modern w-100 text-4 py-3 mb-3" href="@Url.Content("~/")">Naar dashboard</a>
                <a class="btn btn-link text-color-dark text-4 mb-3" href="@Url.Action("SignOut", "Account")">
                    <i class='bx bx-log-out me-1'></i> Uitloggen
                </a>

                <hr class="solid my-3" />
                <div class="help-text">
                    Hulp nodig? <a href="mailto:info@groupln.be">Contacteer ons</a>
                </div>
            </article>

            <div class="copyright">
                © @DateTime.Now.Year Group LN. Alle rechten voorbehouden.
            </div>
        </section>
    </main>
</body>
</html>