@{
    ViewData["Title"] = "Wachtwoord reset aangevraagd";
}

<section class="body-sign">
    <div class="center-sign">
        <a href="/" class="logo float-start">
            <img src="~/img/logo.png" height="54" alt="CPM" />
        </a>

        <div class="panel card-sign">
            <div class="card-title-sign mt-3 text-end">
                <h2 class="title text-uppercase font-weight-bold m-0">
                    <i class="bx bx-mail-send me-1 text-6 position-relative top-5"></i> Controleer je mailbox
                </h2>
            </div>
            <div class="card-body">
                <div class="alert alert-success mb-3">
                    <p class="m-0">
                        Als het e-mailadres bij ons bekend is, ontvang je zo dadelijk een bericht met daarin de instructies om je
                        wachtwoord opnieuw in te stellen. Het bericht bevat ook een link die 24 uur geldig blijft.
                    </p>
                </div>
                <p class="text-center mb-3">Geen mail ontvangen? Controleer de spamfolder of probeer het opnieuw.</p>
                <div class="text-center">
                    <a class="btn btn-primary" href="@Url.Action("ForgotPassword", "Account")">
                        <i class="bx bx-undo"></i> Opnieuw proberen
                    </a>
                    <a class="btn btn-secondary" href="@Url.Action("Login", "Account")">
                        <i class="bx bx-log-in"></i> Terug naar login
                    </a>
                </div>
            </div>
        </div>

        <p class="text-center text-muted mt-3 mb-3">&copy; Copyright @DateTime.Now.Year. All Rights Reserved.</p>
    </div>
</section>