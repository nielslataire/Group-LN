@{
    ViewData["Title"] = "Afgemeld";
}

<section class="body-sign">
    <div class="center-sign">
        <a href="/" class="logo float-start">
            <img src="~/img/logo.png" height="54" alt="CPM" />
        </a>

        <div class="panel card-sign">
            <div class="card-title-sign mt-3 text-end">
                <h2 class="title text-uppercase font-weight-bold m-0">
                    <i class="bx bx-log-out me-1 text-6 position-relative top-5"></i> Je bent afgemeld
                </h2>
            </div>
            <div class="card-body text-center">
                <p class="lead mb-4">Bedankt voor je bezoek. Tot de volgende keer!</p>
                <a class="btn btn-primary" href="@Url.Action("Login", "Account")">
                    <i class="bx bx-log-in"></i> Opnieuw inloggen
                </a>
                <a class="btn btn-secondary ms-1" href="@Url.Action("Index", "Home")">
                    <i class="bx bx-home"></i> Terug naar start
                </a>
            </div>
        </div>

        <p class="text-center text-muted mt-3 mb-3">&copy; Copyright @DateTime.Now.Year. All Rights Reserved.</p>
    </div>
</section>
