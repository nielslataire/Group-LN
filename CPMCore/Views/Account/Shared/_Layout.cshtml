    <title>@ViewBag.Title</title>
    <link rel="icon" href="@Url.Content("~/Img/favicon.ico")" type="image/x-icon" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="@Url.Content("~/icons/icon-192.png")" />
    <link rel="icon" type="image/png" sizes="512x512" href="@Url.Content("~/icons/icon-512.png")" />
    <link rel="apple-touch-icon" href="@Url.Content("~/icons/icon-180.png")" />
	<!-- Vendor CSS -->
	<link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.css" />
	<link rel="stylesheet" href="~/lib/animate/animate.compat.css">
	<link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
	<link rel="stylesheet" href="~/lib/boxicons/css/boxicons.min.css" />
	<link rel="stylesheet" href="~/lib/jquery-ui/jquery-ui.css" />
	<link rel="stylesheet" href="~/lib/jquery-ui/jquery-ui.theme.css" />
	<link rel="icon" href="@Url.Content("~/img/favicon.ico")" type="image/x-icon" sizes="16x16 32x32 48x48" />

	<!-- GROUP LN CSS -->
	@* 	<link rel="stylesheet" href="css/groupln.css" />
	<link rel="stylesheet" href="css/skins/skin.css" /> *@

	<!-- Theme CSS -->
	<link rel="stylesheet" href="~/css/theme.css" />

	<!-- Skin CSS -->
	<link rel="stylesheet" href="~/css/skins/default.css" />

	<!-- Theme Custom CSS -->
	<link rel="stylesheet" href="~/css/custom.css">
	@* 	<link rel="stylesheet" href="css/groupln-custom.css" /> *@

