@model CPMCore.Models.Search.SearchViewModel

@{
    ViewData["Title"] = "Zoeken";
}

<section class="content-with-menu content-with-menu-has-toolbar">
    <div class="content-with-menu-container">
        <div class="content-with-menu-body">
            <div class="row mb-4">
                <div class="col-12">
                    <h2 class="font-weight-bold text-6">Zoekresultaten</h2>
                    <p class="text-muted mb-0">
                        @if (string.IsNullOrWhiteSpace(Model.Query))
                        {
                            @:Geef een zoekterm in om projecten, klanten of leveranciers te vinden.
                        }
                        else
                        {
                            @:Resultaten voor "<strong>@Model.Query</strong>"
                        }
                    </p>
                </div>
            </div>

            @if (Model.Sections.Count == 0 && !string.IsNullOrWhiteSpace(Model.Query))
            {
                <div class="alert alert-info">
                    Geen resultaten gevonden. Probeer een andere zoekterm.
                </div>
            }

            @foreach (var section2 in Model.Sections)
            {
                <div class="card card-modern mb-4">
                    <div class="card-header">
                        <h3 class="card-title">
                            @section2.Title
                            </h3>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-0">
                            @foreach (var item in section2.Items)
                            {
                                <li class="py-2 border-bottom">
                                    <a href="@item.Url" class="text-decoration-none fw-semibold">@item.Title</a>
                                    @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                    {
                                        <div class="text-muted small">@item.Subtitle</div>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>
</section>