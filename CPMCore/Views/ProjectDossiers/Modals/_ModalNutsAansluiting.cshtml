@using BOCore
@model CPMCore.Models.Traject.NutsAansluitingModalVm
@{
    var b = Model.Bestaand;
    var modalId = b == null ? "modalNuts" : $"modalNutsEdit{b.ProjectDossierId}";
    // Zie de doc-comment op BOCore.NutsType.Telecom = 4: legacy waarde, blijft enkel zichtbaar in
    // de keuzelijst wanneer een bestaand dossier ze al gebruikt (anders verdwijnt ze stil uit een
    // bewerk-formulier en lijkt het alsof de waarde niet meer bestaat).
    var nutsTypes = Enum.GetValues(typeof(NutsType)).Cast<NutsType>()
        .Where(t => t != NutsType.Telecom || (b != null && b.NutsType == (int)NutsType.Telecom)).ToList();
}

<div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true" data-meterdata-url-template="@Url.Action("UnitMeterdata", new { projectId = Model.ProjectId, unitId = 0 })">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <form method="post" asp-controller="ProjectDossiers" asp-action="NutsOpslaan" asp-route-projectId="@Model.ProjectId">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@(b?.ProjectDossierId)" />
                <div class="modal-header">
                    <h5 class="modal-title">@(b == null ? "Nieuwe nutsaansluiting" : "Nutsaansluiting bewerken")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
                </div>
                <div class="modal-body">
                    <div class="gl-mp-modal-section">
                        <div class="gl-mp-modal-section-title">Type &amp; locatie</div>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label">Titel</label>
                                <input type="text" name="Titel" class="form-control form-control-modern" required maxlength="200"
                                       value="@(b?.ProjectDossier?.Titel)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Type nutsvoorziening</label>
                                <select name="NutsType" class="form-control form-control-modern js-nuts-type">
                                    @foreach (var t in nutsTypes)
                                    {
                                        <option value="@((int)t)" selected="@(b != null && b.NutsType == (int)t)">@t.GetDisplayName()</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Eenheid <span class="text-muted">(optioneel)</span></label>
                                <select name="UnitId" class="form-control form-control-modern js-nuts-unit">
                                    <option value="">— projectniveau (algemene aansluiting) —</option>
                                    @foreach (var u in Model.ProjectUnits)
                                    {
                                        <option value="@u.Id" selected="@(b?.UnitId == u.Id)">@u.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Netbeheerder</label>
                                <select name="NetbeheerderCompanyId" class="form-control form-control-modern js-netbeheerder-select"
                                        style="width:100%" data-url="@Url.Action("GetCompanys", "Projecten")"
                                        data-selected-id="@(b?.NetbeheerderCompanyId)" data-selected-text="@(b?.NetbeheerderCompany?.BedrijfsNaam)"></select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">EAN</label>
                                <input type="text" name="Ean" class="form-control form-control-modern js-nuts-ean" maxlength="50" value="@(b?.Ean)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Meternummer</label>
                                <input type="text" name="Meternummer" class="form-control form-control-modern js-nuts-meter" maxlength="50" value="@(b?.Meternummer)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Gevraagd vermogen</label>
                                <input type="text" name="GevraagdVermogen" class="form-control form-control-modern" maxlength="50" value="@(b?.GevraagdVermogen)" />
                            </div>
                        </div>
                    </div>

                    <div class="gl-mp-modal-section">
                        <div class="gl-mp-modal-section-title">Werkstroom</div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Referentie</label>
                                <input type="text" name="Referentie" class="form-control form-control-modern" maxlength="100" value="@(b?.ProjectDossier?.Referentie)" />
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="Geannuleerd" id="@($"nuts-geannuleerd-{modalId}")" value="true" checked="@(b != null && b.ProjectDossier.Status == (int)DossierStatus.Geannuleerd)" />
                                    <input type="hidden" name="Geannuleerd" value="false" />
                                    <label class="form-check-label" for="@($"nuts-geannuleerd-{modalId}")">Dossier geannuleerd</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Aanvraagdatum</label>
                                <input type="date" name="AanvraagVerstuurdOp" class="form-control form-control-modern" value="@(b?.AanvraagVerstuurdOp?.ToString("yyyy-MM-dd"))" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Verwachte offertedatum</label>
                                <input type="date" name="VerwachteOfferteDatum" class="form-control form-control-modern" value="@(b?.VerwachteOfferteDatum?.ToString("yyyy-MM-dd"))" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Offertedatum</label>
                                <input type="date" name="OfferteOntvangenOp" class="form-control form-control-modern" value="@(b?.OfferteOntvangenOp?.ToString("yyyy-MM-dd"))" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Datum goedkeuring</label>
                                <input type="date" name="OfferteGoedgekeurdOp" class="form-control form-control-modern" value="@(b?.OfferteGoedgekeurdOp?.ToString("yyyy-MM-dd"))" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Datum uitvoering gevraagd</label>
                                <input type="date" name="UitvoeringGevraagdOp" class="form-control form-control-modern" value="@(b?.UitvoeringGevraagdOp?.ToString("yyyy-MM-dd"))" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Datum uitgevoerd</label>
                                <input type="date" name="UitgevoerdOp" class="form-control form-control-modern" value="@(b?.UitgevoerdOp?.ToString("yyyy-MM-dd"))" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Aansluitkost raming (€)</label>
                                <input type="number" step="0.01" name="AansluitkostRaming" class="form-control form-control-modern" value="@(b?.AansluitkostRaming)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Aansluitkost definitief (€)</label>
                                <input type="number" step="0.01" name="AansluitkostDefinitief" class="form-control form-control-modern" value="@(b?.AansluitkostDefinitief)" />
                            </div>
                        </div>
                        <p class="text-muted small mt-2 mb-0">
                            Status en de datum "Afgehandeld" worden automatisch bepaald op basis van de datums hierboven
                            (afgehandeld zodra "Datum uitgevoerd" ingevuld is) — enkel annuleren zet je hier zelf.
                            Keuring en overdracht volg je verder op via de checklist op de dossierpagina zodra dit dossier is aangemaakt.
                        </p>
                    </div>

                    <div class="gl-mp-modal-section">
                        <div class="gl-mp-modal-section-title">Contact &amp; omschrijving</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Extern contact — naam</label>
                                <input type="text" name="ExterneContactNaam" class="form-control form-control-modern" maxlength="150" value="@(b?.ProjectDossier?.ExterneContactNaam)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Extern contact — e-mail</label>
                                <input type="email" name="ExterneContactEmail" class="form-control form-control-modern" maxlength="254" value="@(b?.ProjectDossier?.ExterneContactEmail)" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Omschrijving</label>
                                <textarea name="Omschrijving" class="form-control form-control-modern" rows="2">@(b?.ProjectDossier?.Omschrijving)</textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="btn btn-primary">Opslaan</button>
                </div>
            </form>
        </div>
    </div>
</div>
