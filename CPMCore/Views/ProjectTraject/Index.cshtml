@using BOCore
@using DALCore.Models
@model CPMCore.Models.Traject.TrajectIndexVm
@{
    ViewData["Title"] ??= "Traject";
    var t = Model.Traject;

    // Icoon per MijlpaalStatus (0 Open .. 4 Geblokkeerd) — vervangt de tekstbadge (.gl-mijlpaal-
    // status-icon in traject.css draagt de kleur; hier enkel de vorm). "Bezig" = bx-time-five
    // (klok, universeel "in behandeling") i.p.v. de eerdere bx-loader-alt, die eerder "actief aan
    // het laden" suggereert dan een blijvende status. Zelfde mapping ook lokaal in
    // _Timeline.cshtml/_UnitMatrix.cshtml — 5 cases, geen gedeelde helper nodig hiervoor. Gebruikt
    // bewust geen enkel icoon dat ook als actie-icoon voorkomt (bx-check-circle stond hier eerst,
    // botste met de "status wijzigen"-knop ernaast, zie die knop hieronder — bx-repeat. bx-transfer
    // was het eerste alternatief maar rendert niet met dit project's boxicons-build (CDN "basic"
    // subset, zie _Layout.cshtml — niet de volledige set; enkel iconen die al elders in de app
    // bewezen renderen gebruiken, niet enkel "bestaat in boxicons").
    string StatusIcon(int status) => status switch
    {
        0 => "bx-circle",
        1 => "bx-time-five",
        2 => "bx-check-circle",
        3 => "bx-minus-circle",
        4 => "bx-block",
        _ => "bx-circle"
    };
}

@section PageStyle {
    @* Combined DataTables-bundel (core + Buttons + ColVis) — zelfde bron als Projecten/DetailClients,
       nodig voor de kolommenfilter-knop op de Mijlpalen-tabel. *@
    <link href="https://cdn.datatables.net/v/bs5/jszip-3.10.1/dt-2.2.2/b-3.2.2/b-colvis-3.2.2/b-html5-3.2.2/b-print-3.2.2/datatables.min.css" rel="stylesheet" integrity="sha384-W8PzvGseaJlM52wTjdPHNrEA9WHp36V+XpQyv1gCKz+1sbFfDo5MlMDT7awB3rAs" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/projecten-custom.css" />
    <link rel="stylesheet" href="~/css/traject.css" asp-append-version="true" />
}

@* Geen eigen titel/subtitel hier — de topbar (SetPageHeader in ProjectTrajectController.Index)
   toont icoon + "{project} - Traject" al; een lokale h1/h5 zou dat woordelijk herhalen
   (zelfde regel als TrajectSjabloonAdmin, zie DESIGN.md "Paginakop (gl-page-header)"). *@
@section PageActions {
    @if (t != null)
    {
        @await Html.PartialAsync("_TrajectActionButtons", Model)
    }
}

@if (t != null)
{
    @* Vervangt de kale browser-confirm() op "Traject verwijderen" (_TrajectActionButtons.cshtml) —
       zelfde patroon als TrajectSjabloonAdmin/Index.cshtml. *@
    @await Html.PartialAsync("_ConfirmModal")
}

<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", Model.ProjectId)
        <div class="inner-body">

            @if (t != null)
            {
                <!-- Topbar-acties (hierboven) verdwijnen < 768px — daar krijgen ze een eigen rij in de content-body. -->
                <div class="d-flex d-md-none justify-content-end gap-2 mb-3">
                    @await Html.PartialAsync("_TrajectActionButtons", Model)
                </div>
            }

            @if (t == null)
            {
                <div class="card card-modern">
                    <div class="card-body">
                        <div class="gl-traject-empty">
                            <i class="bx bx-git-branch" aria-hidden="true"></i>
                            <p class="gl-traject-empty-title">Nog geen traject</p>
                            <p class="gl-traject-empty-hint">
                                Maak een traject aan op basis van een sjabloon. Fases en mijlpalen worden gekopieerd
                                en de streefdata worden berekend uit de opgegeven startdatum.
                            </p>
                            <form method="post" asp-action="Aanmaken" asp-route-projectId="@Model.ProjectId" class="gl-traject-empty-form">
                                @Html.AntiForgeryToken()
                                <div class="gl-field" style="flex-grow:2">
                                    <label for="traject-sjabloon">Sjabloon</label>
                                    <select name="sjabloonId" id="traject-sjabloon" class="form-select form-control-modern">
                                        @foreach (var s in Model.Sjablonen)
                                        {
                                            <option value="@s.Id" selected="@(s.Id == Model.VoorgesteldSjabloonId)">
                                                @s.Naam @(s.IsStandaard ? "(standaard)" : "")
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="gl-field">
                                    <label for="traject-startdatum">Startdatum (anker)</label>
                                    <input type="date" name="startdatum" id="traject-startdatum" class="form-control form-control-modern" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                </div>
                                <button type="submit" class="btn btn-primary" style="height:46px" @(Model.Sjablonen.Count == 0 ? "disabled" : "")>
                                    <i class="bx bx-check me-1" aria-hidden="true"></i>Traject aanmaken
                                </button>
                            </form>
                            @if (Model.Sjablonen.Count == 0)
                            {
                                <p class="mt-3 mb-0" style="color:var(--danger,#b3452f);font-size:.85rem">Er zijn nog geen actieve sjablonen. Maak er eerst één aan onder Instellingen → Trajectsjablonen.</p>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                @* KPI's leven niet meer als een eigen strip boven de tabs — de tabbar hoort
                   rechtstreeks onder de topbar te staan. In plaats daarvan compacte, altijd
                   zichtbare statuspillen naast de tabs zelf (zelfde rij). < 992px vallen "Fase"
                   en "binnen 14d" weg (die details zitten toch al in de Mijlpalen-tab en de
                   Kalender) maar "bereikt"/"achterstallig" blijven zichtbaar — dat laatste is op
                   een werf-tablet net het cijfer waar een PM voor komt kijken, dus nooit volledig
                   verbergen (zie .gl-traject-stats / .gl-traject-stat--sec in traject.css). *@
                <div class="gl-traject-tabrow">
                    <div class="gl-form-shell__tabs gl-traject-tabs" role="tablist" aria-label="Traject" data-tabgroup="traject-index">
                        <button type="button" class="gl-form-shell__tab" role="tab" id="tabbtn-tijdlijn" data-tab="tijdlijn"
                                aria-controls="tab-tijdlijn" aria-selected="true" tabindex="0">
                            <i class="bx bx-timeline" aria-hidden="true"></i><span>Tijdlijn</span>
                        </button>
                        <button type="button" class="gl-form-shell__tab" role="tab" id="tabbtn-mijlpalen" data-tab="mijlpalen"
                                aria-controls="tab-mijlpalen" aria-selected="false" tabindex="-1">
                            <i class="bx bx-flag" aria-hidden="true"></i><span>Mijlpalen</span>
                        </button>
                        @if (Model.EenheidMijlpalen.Count > 0 || Model.ProjectUnits.Count > 0)
                        {
                            <button type="button" class="gl-form-shell__tab" role="tab" id="tabbtn-eenheden" data-tab="eenheden"
                                    aria-controls="tab-eenheden" aria-selected="false" tabindex="-1">
                                <i class="bx bx-grid-alt" aria-hidden="true"></i><span>Per eenheid</span>
                                <span class="gl-form-shell__tab-badge">@Model.EenheidMijlpalen.Count</span>
                            </button>
                        }
                        <button type="button" class="gl-form-shell__tab" role="tab" id="tabbtn-kalender" data-tab="kalender"
                                aria-controls="tab-kalender" aria-selected="false" tabindex="-1">
                            <i class="bx bx-calendar" aria-hidden="true"></i><span>Kalender</span>
                        </button>
                    </div>
                    <div class="gl-traject-stats" aria-label="Trajectstatus">
                        <span class="gl-traject-stat gl-traject-stat--sec">Fase: <strong>@(Model.HuidigeFase?.Naam ?? "—")</strong></span>
                        <span class="gl-traject-stat"><strong>@Model.AantalBereikt/@Model.AantalMijlpalen</strong> bereikt</span>
                        <span class="gl-traject-stat @(Model.AantalAchterstallig > 0 ? "is-severe" : "")"><strong>@Model.AantalAchterstallig</strong> achterstallig</span>
                        <span class="gl-traject-stat gl-traject-stat--sec"><strong>@Model.AantalBinnen14Dagen</strong> binnen 14d</span>
                    </div>
                </div>

                <div class="card card-modern">
                    <div class="card-body">
                        <div id="tab-tijdlijn" class="gl-form-shell__panel gl-tsa-panel" role="tabpanel" aria-labelledby="tabbtn-tijdlijn" tabindex="0">
                            @await Html.PartialAsync("_Timeline", Model)
                        </div>
                        <div id="tab-mijlpalen" class="gl-form-shell__panel gl-tsa-panel" role="tabpanel" aria-labelledby="tabbtn-mijlpalen" tabindex="0" hidden>
                            @* Zelfde zoekveld + kolommenfilter-patroon als Projecten/DetailClients (Clients.cshtml):
                               .dt-search van DataTables verborgen, eigen #mp-search-term i.p.v., colvis-knop
                               verplaatst naar #mp-colvis-container. Zoekveld neemt de volledige breedte in
                               (flex-grow:1) i.p.v. een vaste max-width, kolommenknop ernaast met echte gap
                               i.p.v. samengeklonken in dezelfde input-group-rand. Zie traject.index.js voor
                               de DataTable-init. *@
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <div class="input-group flex-grow-1">
                                    <span class="input-group-text"><i class="bx bx-search" aria-hidden="true"></i></span>
                                    <input type="text" class="form-control" id="mp-search-term" placeholder="Zoeken…" aria-label="Zoeken in mijlpalen" />
                                </div>
                                <div id="mp-colvis-container" class="flex-shrink-0"></div>
                            </div>
                            <table id="datatable-mijlpalen" class="table table-hover w-100">
                                <thead>
                                    <tr>
                                        <th>Status</th><th>Mijlpaal</th><th>Fase</th><th>Type</th><th class="text-end">Streefdatum</th>
                                        <th class="text-end">Werkelijk</th><th>Verantw.</th><th class="noVis" data-orderable="false"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var m in Model.ProjectMijlpalen)
                                {
                                    var eff = m.Doeldatum ?? m.DoeldatumBerekend;
                                    var overdue = eff is DateOnly d && d < DateOnly.FromDateTime(DateTime.Today)
                                                  && m.Status != (int)MijlpaalStatus.Bereikt && m.Status != (int)MijlpaalStatus.NietVanToepassing;
                                    <tr>
                                        <td data-order="@m.Status">
                                            @{ var statusLabel = ((MijlpaalStatus)m.Status).GetDisplayName(); }
                                            <span class="gl-mijlpaal-status-icon s-@m.Status" title="@statusLabel"><i class="bx @StatusIcon(m.Status)" aria-hidden="true"></i></span>
                                            <span class="visually-hidden">@statusLabel</span>
                                        </td>
                                        <td>
                                            <strong>@m.Naam</strong>
                                            @if (m.IsVerplicht)
                                            {
                                                <span class="badge bg-light text-dark ms-1">verplicht</span>
                                            }
                                            @if (Model.PuntenPerMijlpaal.TryGetValue(m.Id, out var puntenAantal) && puntenAantal > 0)
                                            {
                                                <span class="badge bg-light text-dark ms-1" title="Gekoppelde punten"><i class="bx bx-error-circle"></i> @puntenAantal</span>
                                            }
                                        </td>
                                        <td>@(m.ProjecttrajectFase?.Naam ?? "—")</td>
                                        <td>@(((MijlpaalType)m.MijlpaalType).GetDisplayName())</td>
                                        <td class="text-end @(overdue ? "gl-traject-overdue-text" : "")" data-order="@(eff?.ToString("yyyy-MM-dd") ?? "")">@(eff?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td class="text-end" data-order="@(m.WerkelijkeDatum?.ToString("yyyy-MM-dd") ?? "")">@(m.WerkelijkeDatum?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td>@(m.VerantwoordelijkeRol.HasValue ? ((InterneRol)m.VerantwoordelijkeRol.Value).GetDisplayName() : "—")</td>
                                        <td class="text-end text-nowrap">
                                            <span class="gl-row-actions">
                                                <button type="button" class="gl-row-action-btn js-mijlpaal-status" data-id="@m.Id" data-naam="@m.Naam" data-status="@m.Status" title="Status wijzigen" aria-label="Status wijzigen van @m.Naam"><i class="bx bx-repeat" aria-hidden="true"></i></button>
                                                <button type="button" class="gl-row-action-btn js-mijlpaal-edit" data-id="@m.Id" title="Bewerken" aria-label="@m.Naam bewerken"><i class="bx bx-edit" aria-hidden="true"></i></button>
                                            </span>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        @if (Model.EenheidMijlpalen.Count > 0 || Model.ProjectUnits.Count > 0)
                        {
                            <div id="tab-eenheden" class="gl-form-shell__panel gl-tsa-panel" role="tabpanel" aria-labelledby="tabbtn-eenheden" tabindex="0" hidden>
                                @await Html.PartialAsync("_UnitMatrix", Model)
                            </div>
                        }
                        <div id="tab-kalender" class="gl-form-shell__panel gl-tsa-panel gl-traject-kal-panel" role="tabpanel" aria-labelledby="tabbtn-kalender" tabindex="0" hidden>
                            @await Html.PartialAsync("_Kalender", Model)
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@if (t != null)
{
    @await Html.PartialAsync("Modals/_ModalMijlpaalUpsert", Model)
    @await Html.PartialAsync("Modals/_ModalMijlpaalStatus", Model)
    @await Html.PartialAsync("_ModalTaakQuickAdd", new CPMCore.Models.Traject.TaakQuickAddVm
    {
        ModalId = "modalTaakQuickAdd",
        ProjectId = Model.ProjectId
    })
}

@section PageScripts {
    <script src="https://cdn.datatables.net/v/bs5/jszip-3.10.1/dt-2.2.2/b-3.2.2/b-colvis-3.2.2/b-html5-3.2.2/b-print-3.2.2/datatables.min.js" integrity="sha384-GC9Im1BDtt06YOKSzkS553+5q43Nos2JSnLM31TjWFcFbzZrFhAtgCzrHDGM0iDy" crossorigin="anonymous"></script>
    <script src="~/js/confirm-modal.js" asp-append-version="true"></script>
    <script src="~/js/traject.index.js" asp-append-version="true"></script>
    <script>
        (function () {
            document.querySelectorAll(".gl-delete-traject-form").forEach(function (form) {
                form.addEventListener("submit", function (e) {
                    if (form.dataset.confirmed) return; // tweede, al-bevestigde submit: laten doorgaan
                    e.preventDefault();
                    window.confirmDialog(
                        "Traject verwijderen?",
                        "Het volledige traject en alle mijlpalen worden verwijderd. Deze actie kan niet ongedaan gemaakt worden.",
                        "Verwijderen"
                    ).then(function (ok) {
                        if (!ok) return;
                        form.dataset.confirmed = "1";
                        if (form.requestSubmit) form.requestSubmit();
                        else form.submit();
                    });
                });
            });
        })();
    </script>
    <script>
        (function () {
            var strip = document.querySelector('.gl-form-shell__tabs[data-tabgroup="traject-index"]');
            if (!strip) return;
            var tabs = Array.prototype.slice.call(strip.querySelectorAll('.gl-form-shell__tab'));
            var panels = tabs.map(function (t) { return document.getElementById(t.getAttribute('aria-controls')); });

            function activate(name) {
                tabs.forEach(function (t, i) {
                    var on = t.dataset.tab === name;
                    t.setAttribute('aria-selected', on ? 'true' : 'false');
                    t.tabIndex = on ? 0 : -1;
                    if (panels[i]) panels[i].hidden = !on;
                });
                window.dispatchEvent(new Event('resize'));
            }

            tabs.forEach(function (t) {
                t.addEventListener('click', function () { activate(t.dataset.tab); });
                t.addEventListener('keydown', function (e) {
                    var i = tabs.indexOf(t), next = null;
                    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = tabs[(i + 1) % tabs.length];
                    else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = tabs[(i - 1 + tabs.length) % tabs.length];
                    if (next) { e.preventDefault(); next.focus(); activate(next.dataset.tab); }
                });
            });
        })();
    </script>
}
