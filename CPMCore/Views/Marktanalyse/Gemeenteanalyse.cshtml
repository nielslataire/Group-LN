                $('#tblProjecten tbody').on('click', 'tr.project-row', function (e) {
                    if ($(e.target).closest('a').length) return;
                    var url = $(this).data('url');
                    if (url) window.location.href = url;
                });

                // ── Losse eenheden DataTable ──────────────────────────────────
                var dtE = $('#tblLosseEenheden').DataTable({
                    language: { url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/nl-NL.json' },
                    order: [[0, 'asc']],
                    pageLength: 10,
                    dom: domStr,
                    columnDefs: [{ orderable: false, targets: -1 }]
                });

                $('#eenhedenSearch').on('input', function () { dtE.search(this.value).draw(); });
                $('#eenhedenPageLength').on('change', function () { dtE.page.len(parseInt(this.value, 10)).draw(); });

                $('#tblLosseEenheden tbody').on('click', 'tr.eenheid-external', function () {
                    var url = $(this).data('url');
                    if (url) window.open(url, '_blank', 'noopener');
                });

                // ── Tabel-schakelaar (client-side toggle) ─────────────────────
                var LS_VIEW       = 'ma_tabelview';
                var sectieProject = document.getElementById('sectie-projecten');
                var sectieEenheid = document.getElementById('sectie-eenheden');
                var viewRadios    = document.querySelectorAll('input[name="tabelview"]');

                function setView(val) {
                    localStorage.setItem(LS_VIEW, val);
                    sectieProject.style.display = val === 'Projecten' ? '' : 'none';
                    sectieEenheid.style.display = val === 'Projecten' ? 'none' : '';
                    viewRadios.forEach(function (r) { r.checked = r.value === val; });
                }

                viewRadios.forEach(function (r) {
                    r.addEventListener('change', function () { setView(this.value); });
                });

                setView(localStorage.getItem(LS_VIEW) || 'Projecten');
            });
