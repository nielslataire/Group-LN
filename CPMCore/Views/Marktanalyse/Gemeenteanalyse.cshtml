@using System.Text.Json
@model CPMCore.Models.Marktanalyse.GemeenteAnalyseViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var locatiesJson = JsonSerializer.Serialize(
        Model.Locaties.Select(g => new {
            municipalityId = g.GeoMunicipalityId,
            naam           = g.GemeenteNaam,
            secties        = g.Secties.Select(s => new {
                sectionId      = s.GeoMunicipalSectionId,
                municipalityId = s.GeoMunicipalityId,
                naam           = s.DeelgemeenteNaam,
                zipCode        = s.ZipCode,
                label          = s.Label
            }).ToList()
        }).ToList());

    var kpi = Model.Kpi;
}

@section PageStyle {
    <link rel="stylesheet" href="~/lib/datatables/media/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/marktanalyse-custom.css" />
}

@await Html.PartialAsync("_Tabs", "Gemeenteanalyse")

<div class="ma-gemeenteanalyse">

<div class="page-intro">
    <div>
        <span class="page-intro-kicker"><i class="bx bx-map"></i> Marktanalyse per gemeente</span>
        <h1 class="page-intro-title">
            Gemeenteanalyse
            @if (Model.HeeftFilter)
            {
                <small class="text-muted">— @Model.FilterLabel</small>
            }
        </h1>
        <p class="page-intro-description">Bekijk vraag- en aanbodcijfers, prijsevoluties en marktindicatoren per gemeente of deelgemeente.</p>
    </div>
</div>


@*     <div class="container-fluid"> *@

        <!-- Filter -->
        <div class="card mb-4">
            <div class="card-body">
                <h4 class="text-primary font-weight-semibold">FILTER</h4>
                <form id="filterForm" method="get" action="@Url.Action("Gemeenteanalyse", "Marktanalyse")" class="row g-3 align-items-end">
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label fw-semibold text-muted" for="locatie-search">GEMEENTE / DEELGEMEENTE</label>
                        <div class="position-relative">
                            <input type="text"
                                   id="locatie-search"
                                   class="form-control"
                                   placeholder="Zoek op gemeente of postcode…"
                                   autocomplete="off" />
                            <input type="hidden" name="geoMunicipalityId"  id="hidden-municipality-id"  value="@(Model.GeselecteerdGeoMunicipalityId?.ToString() ?? "")" />
                            <input type="hidden" name="geoMunicipalSectionId" id="hidden-section-id" value="@(Model.GeselecteerdGeoMunicipalSectionId?.ToString() ?? "")" />
                            <div id="locatie-dropdown" class="locatie-dropdown d-none"></div>
                        </div>
                    </div>
            <div class="col-sm-4 col-md-3">
                <label class="form-label fw-semibold d-block text-muted">TYPE</label>

                <div class="btn-group btn-group-segmented" role="group">
                    @foreach (var t in new[] { "Alles", "Appartement", "Woning" })
                    {
                        <input type="radio"
                               class="btn-check"
                               name="type"
                               id="type-@t"
                               value="@t"
                               @(Model.GeselecteerdType == t ? "checked" : "") />

                        <label class="btn" for="type-@t">
                            @t
                        </label>
                    }
                </div>
            </div>
                    <div class="col-sm-auto d-none">
                        <button type="submit" class="btn btn-sm btn-primary">
                            <i class="fas fa-search me-1"></i>Toon markt
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.HeeftFilter && !Model.HeeftData)
        {
            <div class="alert alert-warning">
                Geen projectdata gevonden voor <strong>@Model.FilterLabel</strong>@if (Model.GeselecteerdType != "Alles"){ <text> — type <strong>@Model.GeselecteerdType</strong></text> }.
            </div>
        }

        @if (Model.HeeftData)
        {
            <!-- KPI cards rij 1: aanbodoverzicht -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="card dashboard-stat">
                        <div class="card-body">
                            <div class="dashboard-stat-title d-flex align-items-center">
                                <i class="bx bx-buildings"></i>
                                ACTIEVE PROJECTEN
                            </div>
                            <div class="dashboard-stat-value">@kpi!.ActieveProjecten</div>
                    <div class="dashboard-stat-subtitle">@kpi!.AantalLosseEenheden losse eenheden</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card dashboard-stat">
                        <div class="card-body">
                            <div class="dashboard-stat-title d-flex align-items-center">
                                <i class="bx bx-grid"></i>
                               ACTIEVE UNITS
                            </div>
                            <div class="dashboard-stat-value">@kpi!.TotaalAnalyseerbaar</div>
                            <div class="dashboard-stat-subtitle">projectunits + losse eenheden</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card dashboard-stat">
                        <div class="card-body">
                            <div class="dashboard-stat-title d-flex align-items-center">
                                <i class="bx bx-check-circle"></i>
                                VERKOCHTE UNITS
                            </div>
                            <div class="dashboard-stat-value">@kpi!.VerkochteUnits</div>
                            <div class="dashboard-stat-subtitle">
                                @if (kpi!.SoldConfirmedCount > 0 || kpi!.LikelySoldCount > 0)
                                {
                                    <text>@kpi!.SoldConfirmedCount bevestigd + @kpi!.LikelySoldCount vermoedelijk</text>
                                }
                                else
                                {
                                    <text>in projecten</text>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card dashboard-stat">
                        <div class="card-body">
                            <div class="dashboard-stat-title d-flex align-items-center">
                                <i class="bx bx-price-tag"></i>
                                BESCHIKBARE UNITS
                            </div>
                            <div class="dashboard-stat-value">@kpi!.BeschikbareUnits</div>
                            <div class="dashboard-stat-subtitle">te koop in projecten en losse eenheden</div>
                        </div>
                    </div>
                </div>
        <div class="col-6 col-md-3">
            <div class="card dashboard-stat">
                <div class="card-body">
                    <div class="dashboard-stat-title d-flex align-items-center">
                        <i class="bx bx-euro"></i>
                        GEMIDDELDE PRIJS
                    </div>
                    <div class="dashboard-stat-value">
                        @(kpi.GemiddeldePrijs.HasValue
                                            ? kpi.GemiddeldePrijs.Value.ToString("N0") + " €"
                                            : "—")
                    </div>
                    <div class="dashboard-stat-subtitle d-flex align-items-center">
                        vraagprijs gemiddeld
                    </div>
                </div>
            </div>
        </div>
                                  <div class="col-6 col-md-3">
                                      <div class="card dashboard-stat">
                                          <div class="card-body">
                                              <div class="dashboard-stat-title d-flex align-items-center">
                                                  <i class="bx bx-ruler"></i>
                                                  GEM. PRIJS PER M²
                                              </div>
                                              <div class="dashboard-stat-value">
                                                @(kpi.GemiddeldePrijsPerM2.HasValue
                                                                    ? kpi.GemiddeldePrijsPerM2.Value.ToString("N0") + " €/m²"
                                                                    : "—")
                                              </div>
                                              <div class="dashboard-stat-subtitle d-flex align-items-center">
                                                 per m² bewoonbaar
                                              </div>
                                          </div>
                                      </div>
                                  </div>
                                  <div class="col-6 col-md-3">
                                      <div class="card dashboard-stat">
                                          <div class="card-body">
                                              <div class="dashboard-stat-title d-flex align-items-center">
                                                  <i class="bx bx-arrow-out-down-left-stroke-square"></i>
                                                  GEM. OPPERVLAKTE
                                              </div>
                                              <div class="dashboard-stat-value">
                        @(kpi.GemiddeldeOppervlakte.HasValue
                                            ? kpi.GemiddeldeOppervlakte.Value.ToString("N0") + " m²"
                                            : "—")
                                              </div>
                                              <div class="dashboard-stat-subtitle d-flex align-items-center">
                                                  gemiddeld per unit
                                              </div>
                                          </div>
                                      </div>
                                  </div>
                                  <div class="col-6 col-md-3">
                                      <div class="card dashboard-stat">
                                          <div class="card-body">
                                              <div class="dashboard-stat-title d-flex align-items-center">
                                                  <i class="bx bx-arrow-out-down-left-stroke-square"></i>
                                                  VERKOCHT
                                              </div>
                                              <div class="dashboard-stat-value">
                                                  @kpi.Verkoopgraad.ToString("F1") %
                                              </div>
                                              <div class="dashboard-stat-subtitle d-flex align-items-center">
                                                  <i class="bx bx-check-circle"></i>@kpi!.VerkochteUnits van @kpi!.TotaalAnalyseerbaar verkocht
                                              </div>
                                          </div>
                                      </div>
                                  </div>
            </div>

            <!-- Grafieken -->
    <div class="row chart-row">
        <div class="col-md-4 mb-3">
            <div class="card chart-card h-100">
                <div class="card-body">
                    <h6 class="chart-title  d-flex align-items-center"> <i class="bx bx-chart-bar-columns me-1 text-primary "></i>Verdeling vraagprijzen</h6>
                    <div class="chart-subtitle">Aantal units per prijsrange</div>

                    <div class="chart-container">
                        <canvas id="chartVraagprijzen"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card chart-card h-100">
                <div class="card-body">
                    <h6 class="chart-title  d-flex align-items-center"><i class="bx bx-chart-bar-columns me-1 text-primary "></i>Verdeling prijs per m²</h6>
                    <div class="chart-subtitle">Aantal units per €/m²-range</div>

                    <div class="chart-container">
                        <canvas id="chartPrijsPerM2"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card chart-card h-100">
                <div class="card-body">
                    <h6 class="chart-title  d-flex align-items-center">
                        <i class="bx bx-trending-up me-1 text-primary g-3"></i>
                        Verkoopgraad per project
                    </h6>
                    <div class="chart-subtitle">% verkocht per project</div>

                    <div class="chart-container-h">
                        <canvas id="chartVerkoopgraad"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Tabel-schakelaar (client-side) -->
    <div class="row mb-3 g-3">
        <div class="col-auto">
            <div class="btn-group btn-group-segmented" role="group">
                <input type="radio" class="btn-check" name="tabelview" id="view-projecten"      value="Projecten"      />
                <label class="btn" for="view-projecten"><i class="bx bx-buildings me-1"></i>Projecten</label>

                <input type="radio" class="btn-check" name="tabelview" id="view-losse-eenheden" value="Losse eenheden" />
                <label class="btn" for="view-losse-eenheden"><i class="bx bx-home me-1"></i>Losse eenheden</label>
            </div>
        </div>
    </div>

    <!-- Projectentabel -->
    <div id="sectie-projecten">
    <div class="card table-card mb-4">
        <div class="card-header project-table-header">

            <div class="project-table-header-left">
                <div class="table-card-title">
                    <i class="bx bx-list-ul"></i>
                    <span>@Model.Projecten.Count() projecten</span>
                </div>

                <div class="table-card-subtitle">
                    Klik een rij voor projectdetail
                </div>
            </div>

            <div class="project-table-header-right">
                <div class="d-flex align-items-center gap-2">
                    <label for="projectPageLength" class="form-label mb-0 small text-muted">Toon</label>
                    <select id="projectPageLength"
                            class="form-select form-select-sm">
                        <option value="10">10</option>
                        <option value="25" selected>25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>

                <input id="projectSearch"
                       type="text"
                       class="form-control form-control-sm"
                       placeholder="Zoek project of ontwikkelaar">
            </div>

        </div>

        <div class="table-responsive">
            <table id="tblProjecten" class="table table-projecten mb-0 w-100 align-middle">
                <thead>
                    <tr>
                        <th>Project</th>
                        <th>Ontwikkelaar</th>
                        <th>Bronnen</th>
                        <th>Type</th>
                        <th class="text-end">Units</th>
                        <th class="text-end">Verkocht</th>
                        <th class="text-end">Beschikbaar</th>
                        <th>Verkoopgraad</th>
                        <th class="text-end">Gem. prijs</th>
                        <th class="text-end">Gem. €/m²</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                @foreach (var p in Model.Projecten)
                    {
                        var detailUrl = Url.Action("Projectdetail", "Marktanalyse", new { id = p.Id });

                        var vkgColor = p.Verkoopgraad >= 66
                        ? "var(--primary)"
                        : p.Verkoopgraad >= 40
                        ? "#f59e0b"
                        : "#0ea5e9";

                        <tr class="project-row" data-url="@detailUrl">
                            <td>
                                <div class="project-name">
                                    <i class="bx bx-buildings"></i>
                                    <a href="@detailUrl">@p.ProjectNaam</a>
                                    @if (p.HeeftDuplicaten)
                                    {
                                        <span class="dup-badge"><i class="bx bx-link"></i>@p.AantalBronnen</span>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(p.AdresRegel))
                                {
                                    <div class="project-address">@p.AdresRegel</div>
                                }
                            </td>

                            <td>
                                @p.Ontwikkelaar
                                @if (p.DeveloperConflict)
                                {
                                    <i class="bx bx-error-circle text-warning ms-1" title="Ontwikkelaar verschilt per bron"></i>
                                }
                            </td>

                            <td data-order="@p.AantalBronnen">
                                @foreach (var bron in p.BronNamen)
                                {
                                    var bronClass = bron.ToLowerInvariant() switch {
                                        "immoweb" => "bron-immoweb",
                                        "zimmo"   => "bron-zimmo",
                                        _         => "bron-other"
                                    };
                                    <span class="bron-badge @bronClass">@bron</span>
                                }
                                @if (!p.BronNamen.Any())
                                {
                                    <span class="text-muted bron-empty">—</span>
                                }
                            </td>

                            <td>
                                <span class="type-pill @(p.TypeLabel == "Woning" ? "type-house" : "type-apartment")">
                                    <i class="bx @(p.TypeLabel == "Woning" ? "bx-home" : "bx-building-house")"></i>
                                    @p.TypeLabel
                                </span>
                            </td>

                            <td class="text-end">@p.TotaalUnits</td>
                            <td class="text-end">@p.VerkochteUnits</td>
                            <td class="text-end">@p.BeschikbareUnits</td>

                            <td>
                                <div class="sales-cell">
                                    <div class="sales-track">
                                        <div class="sales-bar"
                                             style="width:@p.Verkoopgraad.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%; background:@vkgColor;">
                                        </div>
                                    </div>
                                    <strong>@p.Verkoopgraad.ToString("F0")%</strong>
                                </div>
                            </td>

                            <td class="text-end">
                                @(p.GemiddeldePrijs.HasValue ? "€ " + p.GemiddeldePrijs.Value.ToString("N0") : "—")
                            </td>

                            <td class="text-end">
                                @(p.GemiddeldePrijsPerM2.HasValue ? "€ " + p.GemiddeldePrijsPerM2.Value.ToString("N0") + "/m²" : "—")
                            </td>

                            <td class="text-end">
                                <i class="bx bx-chevron-right row-chevron"></i>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    </div>@* /sectie-projecten *@

    <!-- Losse eenheden tabel -->
    <div id="sectie-eenheden">
    <div class="card table-card mb-4">
        <div class="card-header project-table-header">
            <div class="project-table-header-left">
                <div class="table-card-title">
                    <i class="bx bx-home"></i>
                    <span>@Model.LosseEenheden.Count losse eenhe@(Model.LosseEenheden.Count == 1 ? "id" : "den")</span>
                </div>
                <div class="table-card-subtitle">
                    @if (Model.ToonGekoppeld)
                    {
                        <span>Alle losse eenheden, inclusief @Model.AantalGekoppeld gekoppeld aan project</span>
                    }
                    else
                    {
                        <span>Individuele aanbiedingen zonder projectkoppeling</span>
                        @if (Model.AantalGekoppeld > 0)
                        {
                            var toggleUrl = Url.Action("Gemeenteanalyse", "Marktanalyse", new {
                                geoMunicipalityId     = Model.GeselecteerdGeoMunicipalityId,
                                geoMunicipalSectionId = Model.GeselecteerdGeoMunicipalSectionId,
                                type                  = Model.GeselecteerdType,
                                aanbodtype            = Model.GeselecteerdAanbodtype,
                                toonGekoppeld         = true
                            });
                            <a href="@toggleUrl" class="ms-2 small text-muted text-decoration-underline">
                                + @Model.AantalGekoppeld gekoppeld aan project
                            </a>
                        }
                    }
                    @if (Model.ToonGekoppeld)
                    {
                        var toggleUrl = Url.Action("Gemeenteanalyse", "Marktanalyse", new {
                            geoMunicipalityId     = Model.GeselecteerdGeoMunicipalityId,
                            geoMunicipalSectionId = Model.GeselecteerdGeoMunicipalSectionId,
                            type                  = Model.GeselecteerdType,
                            aanbodtype            = Model.GeselecteerdAanbodtype,
                            toonGekoppeld         = false
                        });
                        <a href="@toggleUrl" class="ms-2 small text-muted text-decoration-underline">Verberg gekoppelde</a>
                    }
                </div>
            </div>
            <div class="project-table-header-right">
                <div class="d-flex align-items-center gap-2">
                    <label for="eenhedenPageLength" class="form-label mb-0 small text-muted">Toon</label>
                    <select id="eenhedenPageLength" class="form-select form-select-sm">
                        <option value="10">10</option>
                        <option value="25" selected>25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
                <input id="eenhedenSearch" type="text" class="form-control form-control-sm" placeholder="Zoek adres of gemeente">
            </div>
        </div>

        <div class="table-responsive">
            <table id="tblLosseEenheden" class="table table-projecten mb-0 w-100 align-middle">
                <thead>
                    <tr>
                        <th>Adres</th>
                        <th>Gemeente</th>
                        <th>Type</th>
                        <th class="text-end">Opp.</th>
                        <th class="text-end">Slaapk.</th>
                        <th class="text-end">Vraagprijs</th>
                        <th class="text-end">€/m²</th>
                        <th>Status</th>
                        <th>Aangeboden door</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.LosseEenheden)
                    {
                        var statusClass = e.Status == "Verkocht" ? "status-sold"
                            : e.Status == "Vermoedelijk verkocht" ? "status-likelysold"
                            : "status-available";
                        <tr class="project-row @(string.IsNullOrEmpty(e.SourceUrl) ? "" : "eenheid-external")"
                            data-url="@e.SourceUrl">
                            <td>
                                <div class="project-name">
                                    <i class="bx bx-map-pin"></i>
                                    @(e.Adres ?? "—")
                                </div>
                            </td>
                            <td>@($"{e.Postcode} {e.Gemeente}".Trim())</td>
                            <td>
                                <span class="type-pill @(e.TypeLabel == "Woning" ? "type-house" : "type-apartment")">
                                    <i class="bx @(e.TypeLabel == "Woning" ? "bx-home" : "bx-building-house")"></i>
                                    @e.TypeLabel
                                </span>
                            </td>
                            <td class="text-end">@(e.Oppervlakte.HasValue ? e.Oppervlakte.Value.ToString("N0") + " m²" : "—")</td>
                            <td class="text-end">@(e.Slaapkamers.HasValue ? e.Slaapkamers.Value.ToString() : "—")</td>
                            <td class="text-end">@(e.Vraagprijs.HasValue ? "€ " + e.Vraagprijs.Value.ToString("N0") : "—")</td>
                            <td class="text-end">@(e.PrijsPerM2.HasValue ? "€ " + e.PrijsPerM2.Value.ToString("N0") : "—")</td>
                            <td>
                                <span class="status-badge @statusClass">@e.Status</span>
                            </td>
                            <td>
                                @e.AangeboenDoor
                                @if (e.IsGekoppeld)
                                {
                                    <span class="badge ms-1 badge-gekoppeld"
                                          title="Gekoppeld aan @(e.GekoppeldProjectNaam ?? "project")">
                                        <i class="bx bx-link-alt me-1"></i>Project
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                @if (!string.IsNullOrEmpty(e.SourceUrl))
                                {
                                    <i class="bx bx-link-external row-chevron"></i>
                                }
                                else
                                {
                                    <i class="bx bx-chevron-right row-chevron text-muted"></i>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    </div>@* /sectie-eenheden *@
        }

    @* </div> *@

</div>@* /ma-gemeenteanalyse *@

@section PageScripts {
    <script src="~/lib/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/media/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@@4.4.4/dist/chart.umd.min.js"></script>

    <!-- Locatie autocomplete + auto-submit + localStorage -->
    <script>
        (function () {
            var LS_MUNI_ID    = 'ma_last_municipality_id';
            var LS_SECTION_ID = 'ma_last_section_id';
            var LS_LABEL      = 'ma_last_label';
            var LS_TYPE       = 'ma_last_type';

            // Gegroepeerde locaties-data vanuit server
            var gemeenteGroepen      = @Html.Raw(locatiesJson);
            var form                 = document.getElementById('filterForm');
            var searchInput          = document.getElementById('locatie-search');
            var hiddenMunicipalityId = document.getElementById('hidden-municipality-id');
            var hiddenSectionId      = document.getElementById('hidden-section-id');
            var dropdown             = document.getElementById('locatie-dropdown');
            var currentMunicipalityId = @Html.Raw(JsonSerializer.Serialize(Model.GeselecteerdGeoMunicipalityId));
            var currentSectionId      = @Html.Raw(JsonSerializer.Serialize(Model.GeselecteerdGeoMunicipalSectionId));
            var currentLabel          = @Html.Raw(JsonSerializer.Serialize(Model.FilterLabel));
            var currentType           = @Html.Raw(JsonSerializer.Serialize(Model.GeselecteerdType));
            var activeIndex           = -1;
            var selectableItems       = [];   // vlakke lijst met alle klikbare rijen in volgorde

            // ── Sla huidige selectie op in localStorage ───────────────────────
            if (currentMunicipalityId || currentSectionId) {
                if (currentMunicipalityId) localStorage.setItem(LS_MUNI_ID, currentMunicipalityId);
                else                       localStorage.removeItem(LS_MUNI_ID);
                if (currentSectionId) localStorage.setItem(LS_SECTION_ID, currentSectionId);
                else                  localStorage.removeItem(LS_SECTION_ID);
                if (currentLabel) localStorage.setItem(LS_LABEL, currentLabel);
                localStorage.setItem(LS_TYPE, currentType);
            }

            // ── Redirect naar laatste locatie als pagina zonder filter opent ─
            if (!currentMunicipalityId && !currentSectionId) {
                var lastMuniId    = localStorage.getItem(LS_MUNI_ID);
                var lastSectionId = localStorage.getItem(LS_SECTION_ID);
                var lastType      = localStorage.getItem(LS_TYPE) || 'Alles';
                if (lastMuniId || lastSectionId) {
                    var url = form.action + '?type=' + encodeURIComponent(lastType);
                    if (lastSectionId) url += '&geoMunicipalSectionId=' + encodeURIComponent(lastSectionId);
                    else               url += '&geoMunicipalityId='     + encodeURIComponent(lastMuniId);
                    window.location.replace(url);
                    return;
                }
            }

            // ── Stel zoekveld in op huidig label ─────────────────────────────
            if (currentLabel) {
                searchInput.value = currentLabel;
            }

            // ── Helpers ───────────────────────────────────────────────────────
            function escHtml(s) {
                return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
            }

            // Geeft gefilterde lijst van groepen terug (elke groep met matching secties)
            function filterGroepen(term) {
                var t = term.toLowerCase().trim();
                if (!t) return gemeenteGroepen;
                return gemeenteGroepen.reduce(function (acc, g) {
                    var gemeenteMatch = g.naam.toLowerCase().includes(t);
                    var matchingSecties = g.secties.filter(function (s) {
                        return s.naam.toLowerCase().includes(t) ||
                               (s.zipCode && s.zipCode.startsWith(t));
                    });
                    if (gemeenteMatch || matchingSecties.length > 0) {
                        acc.push({
                            municipalityId: g.municipalityId,
                            naam:           g.naam,
                            secties:        gemeenteMatch ? g.secties : matchingSecties
                        });
                    }
                    return acc;
                }, []);
            }

            function renderDropdown(groepen) {
                dropdown.innerHTML = '';
                selectableItems   = [];
                activeIndex       = -1;

                if (!groepen.length) {
                    dropdown.innerHTML = '<div class="locatie-item-empty">Geen resultaten</div>';
                    dropdown.classList.remove('d-none');
                    return;
                }

                groepen.forEach(function (g) {
                    // Gemeentekop (selecteert hele gemeente)
                    var header = document.createElement('div');
                    header.className = 'locatie-item locatie-gemeente-header';
                    header.dataset.municipalityId = g.municipalityId;
                    header.dataset.sectionId      = '';
                    header.dataset.label          = g.naam;
                    header.innerHTML =
                        '<span><strong>' + escHtml(g.naam) + '</strong></span>' +
                        '<span class="locatie-item-postcode">' + g.secties.length + ' deelgem.</span>';
                    header.addEventListener('mousedown', function (e) {
                        e.preventDefault();
                        selectEntry({ municipalityId: g.municipalityId, sectionId: null, label: g.naam });
                    });
                    dropdown.appendChild(header);
                    selectableItems.push({ municipalityId: g.municipalityId, sectionId: null, label: g.naam, el: header });

                    // Deelgemeenten (selecteren specifieke sectie)
                    g.secties.forEach(function (s) {
                        var row = document.createElement('div');
                        row.className = 'locatie-item locatie-sectie-row';
                        row.dataset.municipalityId = s.municipalityId;
                        row.dataset.sectionId      = s.sectionId;
                        row.dataset.label          = s.label;
                        row.innerHTML =
                            '<span class="ms-3">' + escHtml(s.naam) + '</span>' +
                            '<span class="locatie-item-postcode">' + escHtml(s.zipCode || '') + '</span>';
                        row.addEventListener('mousedown', function (e) {
                            e.preventDefault();
                            selectEntry({ municipalityId: s.municipalityId, sectionId: s.sectionId, label: s.label });
                        });
                        dropdown.appendChild(row);
                        selectableItems.push({ municipalityId: s.municipalityId, sectionId: s.sectionId, label: s.label, el: row });
                    });
                });

                dropdown.classList.remove('d-none');
            }

            function setActive(idx) {
                selectableItems.forEach(function (item, i) {
                    item.el.classList.toggle('active', i === idx);
                });
                if (idx >= 0 && selectableItems[idx]) {
                    selectableItems[idx].el.scrollIntoView({ block: 'nearest' });
                }
                activeIndex = idx;
            }

            function closeDropdown() {
                dropdown.classList.add('d-none');
                activeIndex     = -1;
                selectableItems = [];
            }

            function selectEntry(entry) {
                hiddenMunicipalityId.value = entry.municipalityId || '';
                hiddenSectionId.value      = entry.sectionId     || '';
                searchInput.value          = entry.label;
                closeDropdown();
                localStorage.setItem(LS_MUNI_ID, entry.municipalityId || '');
                localStorage.setItem(LS_SECTION_ID, entry.sectionId   || '');
                localStorage.setItem(LS_LABEL, entry.label);
                form.submit();
            }

            // ── Events ────────────────────────────────────────────────────────
            searchInput.addEventListener('focus', function () {
                this.select();
                renderDropdown(gemeenteGroepen);
            });

            searchInput.addEventListener('input', function () {
                hiddenMunicipalityId.value = '';
                hiddenSectionId.value      = '';
                renderDropdown(filterGroepen(this.value));
            });

            searchInput.addEventListener('blur', function () {
                setTimeout(function () {
                    closeDropdown();
                    // Herstel label als er al een locatie geselecteerd was
                    if (hiddenMunicipalityId.value || hiddenSectionId.value) {
                        searchInput.value = currentLabel || localStorage.getItem(LS_LABEL) || '';
                    } else {
                        searchInput.value = '';
                    }
                }, 160);
            });

            searchInput.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    setActive(Math.min(activeIndex + 1, selectableItems.length - 1));
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    setActive(Math.max(activeIndex - 1, 0));
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (activeIndex >= 0 && selectableItems[activeIndex]) {
                        selectEntry(selectableItems[activeIndex]);
                    }
                } else if (e.key === 'Escape') {
                    closeDropdown();
                }
            });

            document.querySelectorAll('input[name="type"]').forEach(function (radio) {
                radio.addEventListener('change', function () {
                    if (hiddenMunicipalityId.value || hiddenSectionId.value) form.submit();
                });
            });
        })();
    </script>

