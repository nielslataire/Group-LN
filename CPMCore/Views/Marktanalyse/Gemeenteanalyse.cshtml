@using System.Text.Json
@model CPMCore.Models.Marktanalyse.GemeenteAnalyseViewModel
@{
    ViewData["Title"] = "Gemeenteanalyse";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var gemeentes = Model.Locaties
        .GroupBy(l => l.Gemeente)
        .Select(g => g.Key)
        .OrderBy(g => g)
        .ToList();

    var locatiesJson = JsonSerializer.Serialize(
        Model.Locaties.Select(l => new { gemeente = l.Gemeente, postcode = l.Postcode }));

    var geselecteerdeGemeente = Model.Locaties
        .FirstOrDefault(l => l.Postcode == Model.GeselecteerdePostcode)?.Gemeente ?? "";

    var kpi = Model.Kpi;
}

@section PageStyle {
    <link rel="stylesheet" href="~/lib/datatables/media/css/dataTables.bootstrap5.min.css" />
    <style>
        .kpi-card { border-left: 4px solid #6c757d; }
        .kpi-card.accent-blue  { border-left-color: #0d6efd; }
        .kpi-card.accent-green { border-left-color: #198754; }
        .kpi-card.accent-red   { border-left-color: #dc3545; }
        .kpi-card.accent-teal  { border-left-color: #0dcaf0; }
        .kpi-value { font-size: 1.6rem; font-weight: 700; line-height: 1.1; }
        .kpi-label { font-size: .75rem; color: #6c757d; text-transform: uppercase; letter-spacing: .04em; }
        .chart-container   { position: relative; height: 260px; }
        .chart-container-h { position: relative; height: 320px; }

        .dashboard-stat {
            border: 0;
            border-radius: .75rem;
            box-shadow: 0 2px 8px rgba(0,0,0,.06);
            transition: all .2s ease;
            min-height: 100px;
        }

            .dashboard-stat:hover {
                box-shadow: 0 .25rem .75rem rgba(0,0,0,.10);
            }

            .dashboard-stat .card-body {
                padding: 1rem 1.25rem;
            }

        .dashboard-stat-title {
            color: #6c757d;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            margin-bottom: .2rem;
        }

            .dashboard-stat-title i {
                margin-right: .25rem;
                font-size: .9rem;
                color: var(--primary);
            }

        .dashboard-stat-value {
            font-size: 21px;
            font-weight: 700;
            line-height: 1;
            color: #212529;
            margin-bottom: .2rem;
        }

        .dashboard-stat-subtitle {
            color: #6c757d;
            font-size: 10.5px;
            margin-bottom:0;
        }

            .dashboard-stat-subtitle i {
                margin-right: .25rem;
                color: #adb5bd;
            }

        .btn-group-segmented {
            padding: 4px;
            background: #f3f5f7;
            border: 1px solid #dee2e6;
            border-radius: 10px;
            gap: 4px;
            display: inline-flex;
        }

            .btn-group-segmented .btn {
                border: 0;
                background: transparent;
                color: #6c757d;
                font-weight: 600;
                font-size: .875rem;
                padding: .4rem .85rem;
                border-radius: 7px;
                transition: all .2s ease;
                margin: 0;
            }

                .btn-group-segmented .btn:hover {
                    color: var(--primary);
                    background: rgba(0,0,0,.03);
                }

        /* geselecteerde knop */
        .btn-check:checked + .btn {
            background: #fff;
            color: var(--primary);
            box-shadow: 0 1px 3px rgba(0,0,0,.08);
        }

        /* Grafieken */
        .chart-row {
         padding-top:0 !important;
        }
        .chart-card {
            border: 1px solid #e1e7ef;
            border-radius: 10px;
            box-shadow: 0 2px 6px rgba(15, 23, 42, .06);
        }

            .chart-card .card-body {
                padding: 1rem 1.25rem .9rem;
            }

        .chart-title {
            margin: 0;
            font-size: 15px;
            font-weight: 700;
            color: #0f172a;
        }

        .chart-subtitle {
            font-size: 10.5px;
            color: #8a97a8;
            margin-bottom: .75rem;
        }

        .chart-container {
            height: 210px;
        }

        .chart-container-h {
            height: 210px;
        }
    </style>
}

<section class="content-header">
    <h1>
        Marktanalyse
        @if (!string.IsNullOrEmpty(Model.GeselecteerdeGemeente))
        {
            <small class="text-muted">— @Model.GeselecteerdeGemeente (@Model.GeselecteerdePostcode)</small>
        }
    </h1>
</section>


