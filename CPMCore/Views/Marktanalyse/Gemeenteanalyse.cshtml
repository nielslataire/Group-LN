@section PageScripts {
    <script src="~/lib/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/media/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@@4.4.4/dist/chart.umd.min.js"></script>

    <!-- Cascade + auto-submit + localStorage -->
    <script>
        (function () {
            var LS_POSTCODE = 'ma_last_postcode';
            var LS_TYPE     = 'ma_last_type';

            var locaties     = @Html.Raw(locatiesJson);
            var form         = document.getElementById('filterForm');
            var selGemeente  = document.getElementById('sel-gemeente');
            var selPostcode  = document.getElementById('sel-postcode');
            var currentPostcode = @Html.Raw(JsonSerializer.Serialize(Model.GeselecteerdePostcode ?? ""));
            var currentType     = @Html.Raw(JsonSerializer.Serialize(Model.GeselecteerdType));

            // ── Sla huidige selectie op als we data hebben ────────────────────
            if (currentPostcode) {
                localStorage.setItem(LS_POSTCODE, currentPostcode);
                localStorage.setItem(LS_TYPE, currentType);
            }

            // ── Redirect naar laatste gemeente als pagina zonder filter opent ─
            if (!currentPostcode) {
                var lastPostcode = localStorage.getItem(LS_POSTCODE);
                var lastType     = localStorage.getItem(LS_TYPE) || 'Alles';
                if (lastPostcode) {
                    window.location.replace(
                        form.action + '?postcode=' + encodeURIComponent(lastPostcode) +
                        '&type=' + encodeURIComponent(lastType)
                    );
                    return;
                }
            }

            // ── Postcode dropdown vullen ──────────────────────────────────────
            function fillPostcodes(gemeente, autoSubmit) {
                var filtered = locaties.filter(function (l) { return l.gemeente === gemeente; });
                selPostcode.innerHTML = '<option value="">—</option>';
                filtered.forEach(function (l) {
                    var opt = document.createElement('option');
                    opt.value = l.postcode;
                    opt.textContent = l.postcode;
                    if (l.postcode === currentPostcode) opt.selected = true;
                    selPostcode.appendChild(opt);
                });
                // Één postcode voor deze gemeente → meteen selecteren
                if (filtered.length === 1) selPostcode.selectedIndex = 1;
                // Direct submitten als gevraagd én postcode geselecteerd
                if (autoSubmit && selPostcode.value) form.submit();
            }

            // ── Gemeente wijzigt → postcodes vullen en direct submiten ────────
            selGemeente.addEventListener('change', function () {
                currentPostcode = '';
                fillPostcodes(this.value, true);
            });

            // ── Postcode wijzigt → direct submiten ───────────────────────────
            selPostcode.addEventListener('change', function () {
                if (this.value) form.submit();
            });

            // ── Type wijzigt → direct submiten (enkel als postcode bekend is) ─
            document.querySelectorAll('input[name="type"]').forEach(function (radio) {
                radio.addEventListener('change', function () {
                    if (selPostcode.value) form.submit();
                });
            });

            // ── Initieel vullen (pagina geladen met bestaande selectie) ───────
            if (selGemeente.value) fillPostcodes(selGemeente.value, false);
        })();
    </script>

    @if (Model.HeeftData)
    {
        <!-- Chart.js + DataTable initialisatie -->
        <script>


            var vraagprijsLabels = @Html.Raw(JsonSerializer.Serialize(Model.VraagprijsBuckets.Select(b => b.Label).ToList()));
            var vraagprijsData   = @Html.Raw(JsonSerializer.Serialize(Model.VraagprijsBuckets.Select(b => b.Aantal).ToList()));
            var ppSqmLabels      = @Html.Raw(JsonSerializer.Serialize(Model.PrijsPerM2Buckets.Select(b => b.Label).ToList()));
            var ppSqmData        = @Html.Raw(JsonSerializer.Serialize(Model.PrijsPerM2Buckets.Select(b => b.Aantal).ToList()));
            var vkgLabels        = @Html.Raw(JsonSerializer.Serialize(Model.VerkoopgraadPerProject.Select(p => p.ProjectNaam).ToList()));
            var vkgData          = @Html.Raw(JsonSerializer.Serialize(Model.VerkoopgraadPerProject.Select(p => p.Verkoopgraad).ToList()));

const primaryColor = getComputedStyle(document.documentElement)
    .getPropertyValue('--primary')
    .trim();

const mediumColor = '#f59e0b';   // amber
const lowColor = '#0ea5e9';      // sky blue

const gridColor = '#e9eef5';
const tickColor = '#8a97a8';

const defaultBarOptions = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
        legend: { display: false },
        tooltip: {
            backgroundColor: '#0f172a',
            padding: 10,
            displayColors: false
        }
    },
    scales: {
        x: {
            grid: { display: false },
            ticks: {
                color: tickColor,
                font: { size: 11 }
            }
        },
        y: {
            beginAtZero: true,
            grid: { color: gridColor },
            ticks: {
                color: tickColor,
                precision: 0,
                font: { size: 11 }
            },
            title: {
                display: true,
                text: 'Aantal units',
                color: '#64748b',
                font: { size: 12, weight: '600' }
            }
        }
    }
};
new Chart(document.getElementById('chartVraagprijzen'), {
    type: 'bar',
    data: {
        labels: vraagprijsLabels,
        datasets: [{
            data: vraagprijsData,
            backgroundColor: primaryColor,
            borderRadius: 5,
            barPercentage: .55,
            categoryPercentage: .7
        }]
    },
    options: defaultBarOptions
});

new Chart(document.getElementById('chartPrijsPerM2'), {
    type: 'bar',
    data: {
        labels: ppSqmLabels,
        datasets: [{
            data: ppSqmData,
            backgroundColor: primaryColor,
            borderRadius: 5,
            barPercentage: .55,
            categoryPercentage: .7
        }]
    },
    options: defaultBarOptions
});
new Chart(document.getElementById('chartVerkoopgraad'), {
    type: 'bar',
    data: {
        labels: vkgLabels,
        datasets: [{
            data: vkgData,
            backgroundColor: vkgData.map(function (v) {
                if (v >= 66) return primaryColor;
                if (v >= 40) return mediumColor; // oranje
                return lowColor;              // blauw
            }),
            borderRadius: 5,
            barPercentage: .65,
            categoryPercentage: .7
        }]
    },
    options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: { display: false },
            tooltip: {
                backgroundColor: '#0f172a',
                padding: 10,
                displayColors: false,
                callbacks: {
                    label: function (context) {
                        return context.raw + '% verkocht';
                    }
                }
            }
        },
        scales: {
            x: {
                beginAtZero: true,
                max: 100,
                grid: {
                    color: gridColor
                },
                ticks: {
                    color: tickColor,
                    callback: function (v) {
                        return v + '%';
                    }
                }
            },
            y: {
                grid: {
                    display: false
                },
                ticks: {
                    color: tickColor,
                    font: {
                        size: 11
                    }
                }
            }
        }
    }
});

            $(function () {
                $('#tblProjecten').DataTable({
                    language: { url: 'https://cdn.datatables.net/plug-ins/2.0.8/i18n/nl-NL.json' },
                    order: [[6, 'desc']],
                    pageLength: 25
                });
            });
        </script>
    }
