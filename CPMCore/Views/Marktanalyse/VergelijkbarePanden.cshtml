@model CPMCore.Models.Marktanalyse.VergelijkbarePandenViewModel
@using System.Text.Json
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var locatiesJson = JsonSerializer.Serialize(Model.Locaties.Select(g => new
    {
        id   = g.GeoMunicipalityId,
        naam = g.GemeenteNaam,
        aantal = Model.AantalPerGemeente.GetValueOrDefault(g.GeoMunicipalityId, 0)
    }));

    string Fmt(decimal? v, string prefix = "€") =>
        v.HasValue ? $"{prefix} {v.Value:N0}".Replace(",", ".") : "—";

    string FmtArea(decimal? v) => v.HasValue ? $"{v.Value:N0} m²" : "—";

    var huidigCriteriaJson = JsonSerializer.Serialize(new
    {
        ZoekgebiedTab     = Model.ZoekgebiedTab,
        GemeenteIds       = Model.GemeenteIds,
        RondAdresPostcode = Model.RondAdresPostcode,
        RondAdresLat      = Model.RondAdresLat,
        RondAdresLng      = Model.RondAdresLng,
        RondAdresStraal   = Model.RondAdresStraal,
        Type              = Model.Type,
        Oppervlakte       = Model.Oppervlakte,
        Tolerantie        = Model.Tolerantie,
        PrijsMin          = Model.PrijsMin,
        PrijsMax          = Model.PrijsMax,
        Slaapkamers       = Model.Slaapkamers,
        Status            = Model.Status
    });

    // Null = attribute omitted by Razor; "selected" = selected="selected"
    string? Sel(bool cond) => cond ? "selected" : null;
}

@section PageStyle {
<link rel="stylesheet" href="~/lib/datatables/media/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<style>
.split {
    display: grid;
    grid-template-columns: 288px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
}
/* Bootstrap's .container-fluid gutter geeft ongewenste links/rechts padding op deze pagina */
.container-fluid {
    padding-left: 0;
    padding-right: 0;
}
.vp-sidebar         { min-width:0; }

        .vp-content {
            min-width: 0;
            position: relative;
            background: #fff;
        }

/* Zoekknop in de echte thema-primary kleur (Bootstrap's .btn-primary is in
   dit thema overschreven naar grijs, dus hier expliciet op var(--primary)) */
.btn-vp-primary {
    background: var(--primary,#2c7a4b);
    border-color: var(--primary,#2c7a4b);
    color: #fff;
}
.btn-vp-primary:hover,
.btn-vp-primary:focus {
    background: var(--primary,#2c7a4b);
    border-color: var(--primary,#2c7a4b);
    color: #fff;
    filter: brightness(0.92);
}

/* Laad-overlay tijdens (automatisch) zoeken — dekt bestaande resultaten af
   totdat de nieuwe pagina met verse data geladen is. */
.vp-loading-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,.75);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 20;
    border-radius: 10px;
    min-height: 120px;
}
.vp-loading-overlay.show { display: flex; }
.vp-loading-overlay .spinner-border { color: var(--primary,#2c7a4b); width: 2.5rem; height: 2.5rem; }

        .vp-card {
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            background: #fff;
            overflow: hidden; /* laat de afronding doorlopen door header/body/tabel */
        }

        .vp-card .card-header {
            background: #fff;
                padding-top: 1rem !important;
                padding-bottom: 1rem !important;

        }

.vp-filter-card     { border:1px solid #e2e8f0; border-radius:10px; background:#fff; padding:1.25rem; }
.vp-filter-label    { font-size:.72rem; font-weight:600; color:#64748b; text-transform:uppercase; letter-spacing:.05em; margin-bottom:.35rem; }

        .vp-filter-card .vp-filter-card-head {
            padding-bottom: 13px;
            border-bottom: 1px solid #e3e7ee;
            display: flex;
            align-items: center;
            gap: 8px;
        }
.vp-seg-group       { display:flex; border:1px solid #d1d5db; border-radius:7px; overflow:hidden; }
.vp-seg-group input { display:none; }
.vp-seg-group label { flex:1; text-align:center; padding:.35rem .5rem; font-size:.8rem; font-weight:500; cursor:pointer; color:#374151; background:#fff; transition:background .15s,color .15s; border-right:1px solid #d1d5db; }
.vp-seg-group label:last-of-type { border-right:none; }
.vp-seg-group input:checked + label { background:var(--primary,#2c7a4b); color:#fff; }
.vp-seg-tab         { display:flex; border:1px solid #d1d5db; border-radius:7px; overflow:hidden; margin-bottom:.75rem; }
.vp-seg-tab button  { flex:1; border:none; background:#fff; padding:.4rem; font-size:.8rem; font-weight:500; cursor:pointer; color:#374151; transition:background .15s,color .15s; }
.vp-seg-tab button.active { background:var(--primary,#2c7a4b); color:#fff; }

/* Gemeente multiselect dropdown */
.vp-gem-wrap         { position:relative; }
.vp-gem-btn          { width:100%; text-align:left; border:1px solid #d1d5db; border-radius:7px; background:#fff; padding:.45rem .75rem; font-size:.85rem; color:#374151; cursor:pointer; display:flex; justify-content:space-between; align-items:center; }
.vp-gem-btn:hover    { border-color:var(--primary,#2c7a4b); }
.vp-gem-btn.open     { border-color:var(--primary,#2c7a4b); border-bottom-left-radius:0; border-bottom-right-radius:0; }
.vp-gem-dropdown     { display:none; position:absolute; top:100%; left:0; right:0; z-index:1050; border:1px solid var(--primary,#2c7a4b); border-top:none; border-radius:0 0 7px 7px; background:#fff; max-height:240px; overflow-y:auto; }
.vp-gem-dropdown.open { display:block; }
.vp-gem-search       { padding:.5rem .75rem; border-bottom:1px solid #e2e8f0; position:sticky; top:0; background:#fff; z-index:2; }
.vp-gem-search input { width:100%; border:1px solid #d1d5db; border-radius:5px; padding:.3rem .6rem; font-size:.8rem; outline:none; }
.vp-gem-header       { display:flex; justify-content:space-between; padding:.4rem .75rem .2rem; font-size:.68rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.06em; background:#f8fafc; }
.vp-gem-header a     { color:var(--primary,#2c7a4b); cursor:pointer; font-weight:600; text-decoration:none; }
.vp-gem-row          { display:flex; align-items:center; justify-content:space-between; padding:.4rem .75rem; font-size:.82rem; cursor:pointer; }
.vp-gem-row:hover    { background:#f1f5f9; }
.vp-gem-row label    { cursor:pointer; flex:1; margin:0; }
.vp-gem-count        { font-size:.75rem; color:#94a3b8; margin-left:.5rem; }

/* Rond adres — dropdown met kaart (middelpunt + straal) */
.vp-rond-wrap        { position:relative; }
.vp-rond-dropdown     { display:none; position:absolute; top:calc(100% + 6px); left:0; width:340px; z-index:1050; border:1px solid #e2e8f0; border-radius:10px; background:#fff; box-shadow:0 12px 32px rgba(15,23,42,.14); padding:.9rem; }
.vp-rond-dropdown.open { display:block; }
.vp-rond-dropdown-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:.65rem; }
.vp-rond-dropdown-title  { font-size:.68rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.06em; }
.vp-rond-count-badge     { background:#dcfce7; color:#166534; font-size:.68rem; font-weight:700; padding:.2rem .55rem; border-radius:20px; white-space:nowrap; }
.vp-rond-search          { position:relative; margin-bottom:.75rem; }
.vp-rond-search i        { position:absolute; left:.65rem; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:.9rem; }
.vp-rond-search input    { width:100%; border:1px solid #d1d5db; border-radius:7px; padding:.45rem .75rem .45rem 2rem; font-size:.85rem; }
.vp-rond-search input:focus { outline:none; border-color:var(--primary,#2c7a4b); }
.vp-rond-slider-row      { display:flex; align-items:center; gap:.6rem; margin-bottom:.75rem; }
.vp-rond-slider-row input[type="range"] { flex:1; }
.vp-rond-slider-row span { font-size:.8rem; font-weight:700; color:var(--primary,#2c7a4b); min-width:44px; text-align:right; }
.vp-rond-map             { height:200px; border-radius:7px; border:1px solid #e2e8f0; background:#eef2f7; }
.vp-rond-hint            { display:flex; align-items:flex-start; gap:.4rem; margin-top:.6rem; font-size:.72rem; color:#94a3b8; line-height:1.4; }
.vp-rond-hint i          { flex-shrink:0; margin-top:.1rem; }

/* KPI cards */
.vp-kpi-card         { border:1px solid #e2e8f0; border-radius:10px; background:#fff; padding:.9rem 1rem; }
.vp-kpi-label        { font-size:.68rem; font-weight:600; text-transform:uppercase; letter-spacing:.06em; color:#64748b; margin-bottom:.15rem; }
.vp-kpi-value        { font-size:1.35rem; font-weight:700; color:#1e293b; line-height:1.1; }
.vp-kpi-sub          { font-size:.75rem; color:#94a3b8; margin-top:.1rem; }
.vp-kpi-first        { background:#f0fdf4; border-color:#bbf7d0; }
.vp-kpi-first .vp-kpi-value { color:var(--primary,#2c7a4b); }

/* Table */
.table-vp thead th   { background:#f8fafc; font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:#64748b; border-bottom:2px solid #e2e8f0; white-space:nowrap; padding-left:20px; padding-right:20px; }
.table-vp tbody tr   { cursor:pointer; transition:background .1s; }
.table-vp tbody tr:hover { background:#f8fafc; }
.table-vp td         { font-size:.83rem; vertical-align:middle; padding-left:20px; padding-right:20px; }
.vp-adres-line1      { font-weight:600; color:#1e293b; }
.vp-adres-line2      { font-size:.75rem; color:#64748b; }
.type-pill           { display:inline-block; border-radius:20px; padding:.15rem .55rem; font-size:.72rem; font-weight:600; }
.type-pill.apt       { background:#e8f6ff; color:#0369a1; border:1px solid #bae6fd; }
.type-pill.won       { background:#e8f7ef; color:#166534; border:1px solid #bbf7d0; }
.status-badge        { display:inline-block; border-radius:20px; padding:.15rem .55rem; font-size:.72rem; font-weight:600; }
.status-beschikbaar  { background:#dcfce7; color:#166534; }
.status-verkocht     { background:#fee2e2; color:#dc2626; }
.status-mogelijk     { background:#fef9c3; color:#854d0e; }
.sales-cell          { display:flex; align-items:center; gap:.5rem; }
.sales-track         { flex:1; height:6px; background:#e2e8f0; border-radius:3px; min-width:50px; }
.sales-bar           { height:6px; border-radius:3px; background:var(--primary,#2c7a4b); }
.sales-pct           { font-size:.78rem; font-weight:600; color:#374151; min-width:32px; text-align:right; }
.badge-project       { background:#e8f7ef; border:1px solid #bbf7d0; color:#166534; font-size:.68rem; padding:.1rem .45rem; border-radius:20px; }
.badge-los           { background:#fff4e5; border:1px solid #ffd591; color:#b26a00; font-size:.68rem; padding:.1rem .45rem; border-radius:20px; }
.vp-empty            { text-align:center; padding:2.5rem 1rem 2rem; }
.vp-empty-icon        { width:64px; height:64px; margin:0 auto .9rem; border-radius:14px; background:#f1f5f9; color:#64748b; display:flex; align-items:center; justify-content:center; font-size:1.6rem; }
.vp-empty-title       { font-weight:700; font-size:1.05rem; color:#1e293b; margin-bottom:.4rem; }
.vp-empty-text        { font-size:.85rem; color:#94a3b8; max-width:480px; margin:0 auto; }

.vp-section           { margin-top:1.75rem; }
.vp-section-label     { font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#94a3b8; padding-bottom:.6rem; border-bottom:1px solid #e2e8f0; margin-bottom:.9rem; }

.vp-quickcard          { display:flex; align-items:center; gap:.7rem; border:1px solid #e2e8f0; border-radius:10px; padding:.85rem .9rem; text-decoration:none; height:100%; transition:border-color .15s,box-shadow .15s; }
.vp-quickcard:hover     { border-color:var(--primary,#2c7a4b); box-shadow:0 4px 14px rgba(15,23,42,.06); text-decoration:none; }
.vp-quickcard-icon      { width:36px; height:36px; flex-shrink:0; border-radius:8px; background:var(--lightgreen,#e8f0eb); color:var(--primary,#2c7a4b); display:flex; align-items:center; justify-content:center; font-size:1.05rem; }
.vp-quickcard-body      { min-width:0; display:flex; flex-direction:column; }
.vp-quickcard-title     { font-size:.85rem; font-weight:700; color:#1e293b; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.vp-quickcard-subtitle  { font-size:.74rem; color:#94a3b8; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

.vp-actielijst         { border:1px solid #e2e8f0; border-radius:10px; overflow:hidden; }
.vp-actie-row          { display:flex; align-items:center; gap:.75rem; padding:.7rem 1rem; text-decoration:none; border-bottom:1px solid #f1f5f9; transition:background .12s; }
.vp-actie-row:last-child { border-bottom:none; }
.vp-actie-row:hover    { background:#f8fafc; text-decoration:none; }
.vp-actie-icon         { width:32px; height:32px; flex-shrink:0; border-radius:8px; background:#f1f5f9; color:#64748b; display:flex; align-items:center; justify-content:center; font-size:.95rem; }
.vp-actie-body         { min-width:0; flex:1 1 auto; display:flex; flex-direction:column; }
.vp-actie-title        { font-size:.85rem; font-weight:600; color:#1e293b; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.vp-actie-subtitle     { font-size:.74rem; color:#94a3b8; }
.vp-actie-meta         { flex-shrink:0; display:flex; align-items:center; gap:.6rem; }
.vp-actie-count        { font-size:.72rem; font-weight:700; background:#dcfce7; color:#166534; padding:.15rem .55rem; border-radius:20px; white-space:nowrap; }
.vp-actie-time         { font-size:.72rem; color:#94a3b8; white-space:nowrap; }

.vp-hint-banner        { display:flex; align-items:flex-start; gap:.6rem; margin-top:1.75rem; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:10px; padding:.85rem 1rem; font-size:.82rem; color:#166534; }
.vp-hint-banner i      { font-size:1.1rem; flex-shrink:0; }
.vp-marktconclusie   { background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:1rem 1.25rem; font-size:.88rem; color:#374151; }
.vp-mc-header        { display:flex; align-items:center; gap:.65rem; margin-bottom:.75rem; }
.vp-mc-icon          { width:34px; height:34px; border-radius:8px; background:#dcfce7; color:#16a34a; display:flex; align-items:center; justify-content:center; font-size:1.1rem; flex-shrink:0; }
.vp-mc-title         { font-weight:700; font-size:.88rem; color:#1e293b; line-height:1.25; }
.vp-mc-subtitle      { font-size:.75rem; color:#94a3b8; line-height:1.25; margin-top:1px; }

/* theme.css (geladen ná deze PageStyle-sectie) zet .dataTables_wrapper .pagination
   op margin-top:20px!important — hier ongedaan gemaakt via een ID-selector zodat
   deze regel wint ondanks de latere laadvolgorde van theme.css. */
#tblVergelijkbaar_wrapper .pagination { margin-top: 0 !important; }
</style>
}

@await Html.PartialAsync("_Tabs", "VergelijkbarePanden")

<div class="page-intro">
    <div>
        <span class="page-intro-kicker"><i class="bx bx-file-report"></i> Vergelijkende marktanalyse (CMA)</span>
        <h1 class="page-intro-title">Vergelijkbare panden</h1>
        <p class="page-intro-description">Bepaal de marktwaarde van een pand door vergelijkbare units te zoeken op oppervlakte, type en prijs. Stel uw zoekprofiel links in en bekijk de marktconclusie.</p>
    </div>
    <div class="page-intro-actions">
        <a id="vpExportBtn" class="btn btn-secondary btn" href="#">
            <i class="bx bx-export me-1"></i>Exporteren
        </a>
        <button type="button" id="vpSaveProfileBtn" class="btn btn-primary btn"
                data-bs-toggle="modal" data-bs-target="#vpSaveProfileModal"
                @(Model.HeeftZoekparameters ? "" : "disabled")>
            <i class="bx bx-bookmark me-1"></i>Profiel opslaan
        </button>
    </div>
</div>

@Html.AntiForgeryToken()

<!-- Modal: profiel opslaan -->
<div class="modal fade" id="vpSaveProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bx bx-bookmark me-1"></i>Zoekprofiel opslaan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
            </div>
            <div class="modal-body">
                <label class="form-label fw-semibold" for="vpProfileNaam">Naam van dit profiel</label>
                <input type="text" id="vpProfileNaam" class="form-control" maxlength="200"
                       placeholder="bv. Appartementen Gent ±120m²" autocomplete="off" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Annuleren</button>
                <button type="button" id="vpProfileOpslaanConfirm" class="btn btn-vp-primary btn-sm">Opslaan</button>
            </div>
        </div>
    </div>
</div>


<div class="container-fluid">
<form id="vpForm" method="get" action="/Marktanalyse/VergelijkbarePanden">
<input type="hidden" name="zoekgebiedTab" id="hidZoekgebiedTab" value="@Model.ZoekgebiedTab" />

<div class="split">

    <!-- ── Sidebar ──────────────────────────────────────────────────────── -->
    <aside class="vp-sidebar">
        <div class="vp-filter-card">
                    <div class="d-flex justify-content-between align-items-center mb-3 vp-filter-card-head">
                <span style="font-weight:700;font-size:.92rem;color:#1e293b;"><i class="bx bx-slider-alt me-1"></i>Zoekprofiel</span>
                <a href="/Marktanalyse/VergelijkbarePanden" class="text-decoration-none" style="font-size:.78rem;color:#94a3b8;">Reset</a>
            </div>

            <!-- Zoekgebied tabs -->
            <div class="vp-filter-label">Zoekgebied</div>
            <div class="vp-seg-tab mb-2">
                <button type="button" id="tabGemeenten" class="@(Model.ZoekgebiedTab != "RondAdres" ? "active" : "")">Gemeenten</button>
                <button type="button" id="tabRondAdres" class="@(Model.ZoekgebiedTab == "RondAdres" ? "active" : "")">Rond adres</button>
            </div>

            <!-- Gemeente multiselect -->
            <div id="panelGemeenten" style="@(Model.ZoekgebiedTab == "RondAdres" ? "display:none" : "")">
                <div class="vp-gem-wrap mb-3">
                    <button type="button" id="gemBtn" class="vp-gem-btn">
                        <span id="gemBtnLabel">@Model.GemeenteDropdownLabel</span>
                        <i class="bx bx-chevron-down" id="gemChevron"></i>
                    </button>
                    <div class="vp-gem-dropdown" id="gemDropdown">
                        <div class="vp-gem-search">
                            <input type="text" id="gemSearch" placeholder="Zoek gemeente..." autocomplete="off" />
                        </div>
                        <div class="vp-gem-header">
                            <span>Gemeenten</span>
                            <a id="gemWissen">Wissen</a>
                        </div>
                        <div id="gemList">
                            <!-- Rendered by JS -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Rond adres -->
            <div id="panelRondAdres" style="@(Model.ZoekgebiedTab != "RondAdres" ? "display:none" : "")">
                <div class="vp-rond-wrap mb-3">
                    <button type="button" id="rondAdresBtn" class="vp-gem-btn">
                        <span id="rondAdresBtnLabel">@Model.RondAdresDropdownLabel</span>
                        <i class="bx bx-chevron-down" id="rondAdresChevron"></i>
                    </button>

                    <div class="vp-rond-dropdown" id="rondAdresDropdown">
                        <div class="vp-rond-dropdown-header">
                            <span class="vp-rond-dropdown-title">Middelpunt &amp; straal</span>
                            <span class="vp-rond-count-badge"><span id="rondAdresCount">0</span> panden in gebied</span>
                        </div>

                        <div class="vp-rond-search">
                            <i class="bx bx-search"></i>
                            <input type="text" id="rondAdresSearch" placeholder="Zoek adres..." autocomplete="off" />
                        </div>

                        <div class="vp-rond-slider-row">
                            <input type="range" id="rondAdresStraal" name="rondAdresStraal"
                                   min="250" max="25000" step="250" value="@Model.RondAdresStraal" class="form-range" />
                            <span id="straalLabel">@((Model.RondAdresStraal / 1000.0).ToString("0.#")) km</span>
                        </div>

                        <div id="rondAdresMap" class="vp-rond-map"></div>

                        <div class="vp-rond-hint">
                            <i class="bx bx-info-circle"></i>
                            <span>Klik of sleep op de kaart om het middelpunt te verplaatsen; sleep de greep om de straal aan te passen.</span>
                        </div>
                    </div>
                </div>
                <input type="hidden" name="rondAdresLat" id="rondAdresLat" value="@Model.RondAdresLat" />
                <input type="hidden" name="rondAdresLng" id="rondAdresLng" value="@Model.RondAdresLng" />
            </div>

            <!-- Type -->
            <div class="vp-filter-label">Type</div>
            <div class="vp-seg-group mb-3">
                <input type="radio" name="type" id="typeApt" value="Appartement" @(Model.Type == "Appartement" ? "checked" : "") />
                <label for="typeApt">Appartement</label>
                <input type="radio" name="type" id="typeWon" value="Woning" @(Model.Type == "Woning" ? "checked" : "") />
                <label for="typeWon">Woning</label>
            </div>

            <!-- Bewoonbare oppervlakte -->
            <div class="vp-filter-label">Bewoonbare oppervlakte</div>
            <div class="input-group input-group-sm mb-1">
                <input type="number" name="oppervlakte" id="oppervlakte" class="form-control"
                       value="@Model.Oppervlakte" min="10" max="500" step="1"
                       placeholder="bv. 120" />
                <span class="input-group-text">m²</span>
            </div>

            <!-- Tolerantie slider -->
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span style="font-size:.76rem;color:#64748b;">Tolerantie</span>
                    <span id="tolLabel" style="font-size:.76rem;font-weight:600;color:var(--primary,#2c7a4b);">± @(Model.Tolerantie) m²</span>
                </div>
                <input type="range" name="tolerantie" id="tolerantieSlider"
                       min="0" max="50" step="5" value="@Model.Tolerantie"
                       class="form-range" />
                @if (Model.Oppervlakte.HasValue)
                {
                    <div id="oppRangeLabel" class="text-muted mt-1" style="font-size:.75rem;">
                        Zoekt units tussen <strong>@((int)(Model.Oppervlakte.Value - Model.Tolerantie))</strong> en <strong>@((int)(Model.Oppervlakte.Value + Model.Tolerantie))</strong> m²
                    </div>
                }
                else
                {
                    <div id="oppRangeLabel" class="text-muted mt-1" style="font-size:.75rem;display:none;"></div>
                }
            </div>

            <!-- Prijs -->
            <div class="vp-filter-label">Prijs (€)</div>
            <div class="d-flex gap-2 mb-3">
                <input type="number" name="prijsMin" class="form-control form-control-sm"
                       value="@Model.PrijsMin" placeholder="€ min" min="0" step="10000" />
                <input type="number" name="prijsMax" class="form-control form-control-sm"
                       value="@Model.PrijsMax" placeholder="€ max" min="0" step="10000" />
            </div>

            <!-- Slaapkamers -->
            <div class="vp-filter-label">Slaapkamers</div>
            <select name="slaapkamers" class="form-select form-select-sm mb-3">
                <option value="">Alle</option>
                <option value="0" selected="@Sel(Model.Slaapkamers == 0)">Studio / 0</option>
                <option value="1" selected="@Sel(Model.Slaapkamers == 1)">1</option>
                <option value="2" selected="@Sel(Model.Slaapkamers == 2)">2</option>
                <option value="3" selected="@Sel(Model.Slaapkamers == 3)">3</option>
                <option value="4" selected="@Sel(Model.Slaapkamers >= 4)">4+</option>
            </select>

            <!-- Status -->
            <div class="vp-filter-label">Status</div>
            <div class="vp-seg-group mb-4" style="font-size:.76rem;">
                <input type="radio" name="status" id="stAlles"      value="Alles"       @(Model.Status == "Alles"      || string.IsNullOrEmpty(Model.Status) ? "checked" : "") />
                <label for="stAlles">Alles</label>
                <input type="radio" name="status" id="stBeschikbaar" value="Beschikbaar" @(Model.Status == "Beschikbaar" ? "checked" : "") />
                <label for="stBeschikbaar">Beschikbaar</label>
                <input type="radio" name="status" id="stVerkocht"   value="Verkocht"    @(Model.Status == "Verkocht"   ? "checked" : "") />
                <label for="stVerkocht">Verkocht</label>
            </div>

            <button type="submit" class="btn btn-vp-primary w-100 btn-sm">
                <i class="bx bx-search me-1"></i>Zoek vergelijkbare panden
            </button>
        </div>
    </aside>

    <!-- ── Resultaten ───────────────────────────────────────────────────── -->
    <div class="vp-content">
        <div id="vpLoadingOverlay" class="vp-loading-overlay">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Bezig met laden...</span>
            </div>
        </div>

        @if (!Model.HeeftZoekparameters)
        {
            <div class="vp-empty">
                <div class="vp-empty-icon"><i class="bx bx-search-alt"></i></div>
                <div class="vp-empty-title">Nog geen zoekprofiel actief</div>
                <div class="vp-empty-text">Stel links uw criteria in en klik op <strong>Zoek vergelijkbare panden</strong>, of start meteen met een veelgebruikt profiel hieronder.</div>
            </div>

            @if (Model.SnelStartPresets.Any())
            {
                <div class="vp-section">
                    <div class="vp-section-label">Snel starten</div>
                    <div class="row g-2">
                        @foreach (var preset in Model.SnelStartPresets)
                        {
                            <div class="col-md-4">
                                <a class="vp-quickcard" href="@preset.Url">
                                    <span class="vp-quickcard-icon"><i class="bx bx-bolt"></i></span>
                                    <span class="vp-quickcard-body">
                                        <span class="vp-quickcard-title">@preset.Titel</span>
                                        <span class="vp-quickcard-subtitle">@preset.Subtitel</span>
                                    </span>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Model.RecenteZoekActies.Any())
            {
                <div class="vp-section">
                    <div class="vp-section-label">Laatste zoekacties</div>
                    <div class="vp-actielijst">
                        @foreach (var actie in Model.RecenteZoekActies)
                        {
                            <a class="vp-actie-row" href="@actie.Url">
                                <span class="vp-actie-icon"><i class="bx bx-time-five"></i></span>
                                <span class="vp-actie-body">
                                    <span class="vp-actie-title">@actie.Titel</span>
                                    <span class="vp-actie-subtitle">@actie.Subtitel</span>
                                </span>
                                <span class="vp-actie-meta">
                                    <span class="vp-actie-count">@actie.AantalResultaten panden</span>
                                    <span class="vp-actie-time">@actie.RelatieveTijd</span>
                                </span>
                            </a>
                        }
                    </div>
                </div>
            }

            @if (Model.OpgeslagenProfielen.Any())
            {
                <div class="vp-section">
                    <div class="vp-section-label">Opgeslagen profielen</div>
                    <div class="vp-actielijst">
                        @foreach (var profiel in Model.OpgeslagenProfielen)
                        {
                            <a class="vp-actie-row" href="@profiel.Url">
                                <span class="vp-actie-icon"><i class="bx bx-bookmark"></i></span>
                                <span class="vp-actie-body">
                                    <span class="vp-actie-title">@profiel.Titel</span>
                                    <span class="vp-actie-subtitle">@profiel.Subtitel</span>
                                </span>
                            </a>
                        }
                    </div>
                </div>
            }

            <div class="vp-hint-banner">
                <i class="bx bx-map-alt"></i>
                <span>Zodra u zoekt, tonen we hier de <strong>kaart, kerncijfers en vergelijkbare panden</strong> — inclusief een automatische marktconclusie.</span>
            </div>
        }
        else
        {
            <!-- KPI cards -->
            <div class="row g-2 mb-3">
                <div class="col">
                    <div class="vp-kpi-card vp-kpi-first">
                        <div class="vp-kpi-label"><i class="bx bx-building-house me-1"></i>Panden</div>
                        <div class="vp-kpi-value">@(Model.Kpi?.Aantal ?? 0)</div>
                    </div>
                </div>
                <div class="col">
                    <div class="vp-kpi-card">
                        <div class="vp-kpi-label"><i class="bx bx-euro me-1"></i>Gem. prijs</div>
                        <div class="vp-kpi-value">@Fmt(Model.Kpi?.GemPrijs)</div>
                    </div>
                </div>
                <div class="col">
                    <div class="vp-kpi-card">
                        <div class="vp-kpi-label"><i class="bx bx-ruler me-1"></i>Gem. €/m²</div>
                        <div class="vp-kpi-value">@(Model.Kpi?.GemPrijsPerM2 != null ? $"€ {Model.Kpi!.GemPrijsPerM2:N0}/m²" : "—")</div>
                    </div>
                </div>
                <div class="col">
                    <div class="vp-kpi-card">
                        <div class="vp-kpi-label">Laagste</div>
                        <div class="vp-kpi-value">@Fmt(Model.Kpi?.LaagstePrijs)</div>
                    </div>
                </div>
                <div class="col">
                    <div class="vp-kpi-card">
                        <div class="vp-kpi-label">Hoogste</div>
                        <div class="vp-kpi-value">@Fmt(Model.Kpi?.HoogstePrijs)</div>
                    </div>
                </div>
                <div class="col">
                    <div class="vp-kpi-card">
                        <div class="vp-kpi-label"><i class="bx bx-area me-1"></i>Gem. opp.</div>
                        <div class="vp-kpi-value">@FmtArea(Model.Kpi?.GemOppervlakte)</div>
                    </div>
                </div>
            </div>

            @if (!Model.HeeftResultaten)
            {
                <div class="card">
                    <div class="card-body vp-empty">
                        <i class="bx bx-search-alt" style="font-size:2rem;opacity:.3;display:block;margin-bottom:.5rem;"></i>
                        <div>Geen vergelijkbare panden gevonden voor dit zoekprofiel.</div>
                    </div>
                </div>
            }
            else
            {
                <!-- Resultaten tabel -->
                <div class="vp-card">
                    <div class="card-header d-flex justify-content-between align-items-center py-2 px-3">
                        <span style="font-weight:600;font-size:.88rem;">
                            <i class="bx bx-list-ul me-1"></i>@Model.Panden.Count vergelijkbare panden
                        </span>
                        <div class="d-flex align-items-center gap-2">
                            <span style="font-size:.78rem;color:#64748b;">Toon</span>
                            <select id="vpPageLength" class="form-select form-select-sm" style="width:70px;">
                                <option value="10">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                            <input type="text" id="vpSearch" class="form-control form-control-sm"
                                   placeholder="Zoek project of adres..." style="width:200px;" />
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table id="tblVergelijkbaar" class="table table-vp table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Project</th>
                                        <th>Adres</th>
                                        <th>Type</th>
                                        <th class="text-end">Oppervlakte</th>
                                        <th class="text-center">Slpk.</th>
                                        <th class="text-end">Prijs</th>
                                        <th class="text-end">Prijs/m²</th>
                                        <th>Status</th>
                                        <th>Verkoopstatus</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model.Panden)
                                    {
                                        var adresLines = (p.AdresRegel ?? "").Split('\n');
                                        var statusCss = p.Status == "Verkocht" ? "status-verkocht"
                                                      : p.Status == "Vermoedelijk verkocht" ? "status-mogelijk"
                                                      : "status-beschikbaar";
                                        var typeCss = p.TypeLabel == "Appartement" ? "apt" : "won";
                                        var detailUrl = p.CanonicalProjectId.HasValue
                                            ? $"/Marktanalyse/Projectdetail/{p.ProjectAssetId}"
                                            : p.SourceUrl;
                                        <tr class="vp-row"
                                            data-url="@detailUrl"
                                            data-external="@(!p.IsProject ? "true" : "false")">
                                            <td>
                                                <div style="font-weight:600;font-size:.83rem;color:#1e293b;max-width:140px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="@p.ProjectNaam">
                                                    @p.ProjectNaam
                                                </div>
                                            </td>
                                            <td>
                                                <div class="vp-adres-line1">@adresLines.FirstOrDefault()</div>
                                                @if (adresLines.Length > 1)
                                                {
                                                    <div class="vp-adres-line2">@adresLines.LastOrDefault()</div>
                                                }
                                            </td>
                                            <td><span class="type-pill @typeCss">@p.TypeLabel</span></td>
                                            <td class="text-end">@(p.Oppervlakte.HasValue ? $"{p.Oppervlakte:N0} m²" : "—")</td>
                                            <td class="text-center">@(p.Slaapkamers?.ToString() ?? "—")</td>
                                            <td class="text-end" style="font-weight:600;">
                                                @(p.Vraagprijs.HasValue ? $"€ {p.Vraagprijs.Value:N0}".Replace(",",".") : "—")
                                            </td>
                                            <td class="text-end" style="color:#64748b;">
                                                @(p.PrijsPerM2.HasValue ? $"€ {p.PrijsPerM2.Value:N0}/m²".Replace(",",".") : "—")
                                            </td>
                                            <td><span class="status-badge @statusCss">@p.Status</span></td>
                                            <td>
                                                <div class="sales-cell">
                                                    @if (p.IsProject && p.Verkoopgraad.HasValue)
                                                    {
                                                        <div class="sales-track">
                                                            <div class="sales-bar" style="width:@(Math.Min(100, (int)p.Verkoopgraad.Value))%"></div>
                                                        </div>
                                                        <span class="sales-pct">@((int)Math.Round(p.Verkoopgraad.Value))%</span>
                                                    }
                                                    else if (!p.IsProject)
                                                    {
                                                        <span class="badge-los">Losse eenheid</span>
                                                    }
                                                    else
                                                    {
                                                        <span style="color:#94a3b8;font-size:.75rem;">—</span>
                                                        <span class="badge-project">Project</span>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Marktconclusie -->
                <div class="vp-marktconclusie mt-3">
                    <div class="vp-mc-header">
                        <div class="vp-mc-icon"><i class="bx bx-bar-chart"></i></div>
                        <div>
                            <div class="vp-mc-title">Marktconclusie</div>
                            <div class="vp-mc-subtitle">Automatisch samengevat uit het zoekprofiel</div>
                        </div>
                    </div>
                    @{
                        var typeOms = Model.Type == "Appartement" ? "appartementen" : Model.Type == "Woning" ? "woningen" : "panden";
                        var oppOms = Model.Oppervlakte.HasValue
                            ? $" tussen {Model.OppervlakteLaag:N0} en {Model.OppervlakteHoog:N0} m²"
                            : "";
                        var gemOms = Model.Kpi?.GemPrijs != null ? $"€ {Model.Kpi.GemPrijs:N0}".Replace(",", ".") : "—";
                        var ppSqmOms = Model.Kpi?.GemPrijsPerM2 != null ? $"€ {Model.Kpi.GemPrijsPerM2:N0}/m²".Replace(",", ".") : "—";
                        var beschikbaar = Model.Panden.Count(p => p.Status == "Beschikbaar");
                        var bPct = Model.Panden.Count > 0 ? (int)Math.Round((double)beschikbaar / Model.Panden.Count * 100) : 0;
                    }
                    <p style="margin:0;line-height:1.6;">
                        Voor @typeOms@oppOms werden <strong>@Model.Panden.Count vergelijkbare panden</strong> gevonden.
                        De gemiddelde vraagprijs bedraagt <strong>@gemOms</strong>, of <strong>@ppSqmOms</strong>.
                        @if (Model.Kpi?.LaagstePrijs != null && Model.Kpi?.HoogstePrijs != null)
                        {
                            <br /><span>Prijsvork: van <strong>@($"€ {Model.Kpi.LaagstePrijs:N0}".Replace(",","."))</strong> tot <strong>@($"€ {Model.Kpi.HoogstePrijs:N0}".Replace(",","."))</strong>.</span>
                        }
                        <br />
                        <strong>@beschikbaar</strong> van @Model.Panden.Count panden zijn nog beschikbaar (@bPct% van de selectie).
                    </p>
                </div>
            }
        }
    </div>
</div>
</form>
</div>


@section PageScripts {
<script src="~/lib/datatables/media/js/jquery.dataTables.min.js"></script>
<script src="~/lib/datatables/media/js/dataTables.bootstrap5.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
(function () {
    'use strict';

    // ── Data ──────────────────────────────────────────────────────────────────
    var gemeenten        = @Html.Raw(locatiesJson);
    var geselecteerd     = new Set(@Html.Raw(JsonSerializer.Serialize(Model.GemeenteIds)));
    var form             = document.getElementById('vpForm');
    var huidigeCriteria  = @Html.Raw(huidigCriteriaJson);

    // ── Exporteren (huidige resultaten als Excel) ──────────────────────────────
    var exportBtn = document.getElementById('vpExportBtn');
    if (exportBtn) {
        exportBtn.addEventListener('click', function (e) {
            e.preventDefault();
            window.location.href = '@Url.Action("ExportVergelijkbarePanden", "Marktanalyse")' + window.location.search;
        });
    }

    // ── Profiel opslaan (modal → AJAX) ──────────────────────────────────────────
    var saveBtn = document.getElementById('vpProfileOpslaanConfirm');
    if (saveBtn) {
        saveBtn.addEventListener('click', function () {
            var naamInput = document.getElementById('vpProfileNaam');
            var naam = (naamInput.value || '').trim();
            if (!naam) {
                naamInput.classList.add('is-invalid');
                naamInput.focus();
                return;
            }
            naamInput.classList.remove('is-invalid');

            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var body  = new URLSearchParams();
            body.append('__RequestVerificationToken', token);
            body.append('Naam', naam);
            body.append('ZoekgebiedTab', huidigeCriteria.ZoekgebiedTab || '');
            (huidigeCriteria.GemeenteIds || []).forEach(function (id) { body.append('GemeenteIds', id); });
            body.append('RondAdresPostcode', huidigeCriteria.RondAdresPostcode || '');
            if (huidigeCriteria.RondAdresLat != null) body.append('RondAdresLat', huidigeCriteria.RondAdresLat);
            if (huidigeCriteria.RondAdresLng != null) body.append('RondAdresLng', huidigeCriteria.RondAdresLng);
            body.append('RondAdresStraal', huidigeCriteria.RondAdresStraal);
            body.append('Type', huidigeCriteria.Type || '');
            if (huidigeCriteria.Oppervlakte != null) body.append('Oppervlakte', huidigeCriteria.Oppervlakte);
            body.append('Tolerantie', huidigeCriteria.Tolerantie);
            if (huidigeCriteria.PrijsMin != null) body.append('PrijsMin', huidigeCriteria.PrijsMin);
            if (huidigeCriteria.PrijsMax != null) body.append('PrijsMax', huidigeCriteria.PrijsMax);
            if (huidigeCriteria.Slaapkamers != null) body.append('Slaapkamers', huidigeCriteria.Slaapkamers);
            body.append('Status', huidigeCriteria.Status || '');

            saveBtn.disabled = true;
            fetch('@Url.Action("SaveZoekProfiel", "Marktanalyse")', {
                method: 'POST',
                body: body,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
                .then(function (resp) { return resp.json().then(function (data) { return { ok: resp.ok, data: data }; }); })
                .then(function (result) {
                    saveBtn.disabled = false;
                    var modalEl = document.getElementById('vpSaveProfileModal');
                    var modal   = bootstrap.Modal.getOrCreateInstance(modalEl);
                    if (result.ok && result.data && result.data.success) {
                        modal.hide();
                        naamInput.value = '';
                        new PNotify({
                            title: 'Opgeslagen',
                            text: 'Zoekprofiel "' + naam + '" is opgeslagen.',
                            type: 'success',
                            addclass: 'stack-bottomright'
                        });
                    } else {
                        naamInput.classList.add('is-invalid');
                        new PNotify({
                            title: 'Mislukt',
                            text: (result.data && result.data.message) || 'Profiel kon niet opgeslagen worden.',
                            type: 'error',
                            addclass: 'stack-bottomright'
                        });
                    }
                })
                .catch(function () {
                    saveBtn.disabled = false;
                    new PNotify({
                        title: 'Mislukt',
                        text: 'Profiel kon niet opgeslagen worden.',
                        type: 'error',
                        addclass: 'stack-bottomright'
                    });
                });
        });
    }

    // ── Laad-overlay bij elke zoekactie (knop of automatisch) ──────────────────
    var loadingOverlay = document.getElementById('vpLoadingOverlay');
    form.addEventListener('submit', function () {
        if (loadingOverlay) loadingOverlay.classList.add('show');
    });

    // ── Type en Status tonen automatisch resultaten (net als gemeente) ─────────
    document.querySelectorAll('input[name="type"], input[name="status"]').forEach(function (radio) {
        radio.addEventListener('change', function () {
            form.requestSubmit();
        });
    });

    // ── Zoekgebied tabs ───────────────────────────────────────────────────────
    var tabGem  = document.getElementById('tabGemeenten');
    var tabRond = document.getElementById('tabRondAdres');
    var panGem  = document.getElementById('panelGemeenten');
    var panRond = document.getElementById('panelRondAdres');
    var hidTab  = document.getElementById('hidZoekgebiedTab');

    tabGem.addEventListener('click', function () {
        tabGem.classList.add('active'); tabRond.classList.remove('active');
        panGem.style.display = ''; panRond.style.display = 'none';
        hidTab.value = 'Gemeenten';
    });
    tabRond.addEventListener('click', function () {
        tabRond.classList.add('active'); tabGem.classList.remove('active');
        panRond.style.display = ''; panGem.style.display = 'none';
        hidTab.value = 'RondAdres';
    });

    // ── Rond adres: dropdown met kaart (middelpunt + straal) ───────────────────
    (function () {
        var GEOCODE_URL = '@Url.Action("GeocodeAdres", "Marktanalyse")';
        var COUNT_URL   = '@Url.Action("TelPandenInStraal", "Marktanalyse")';
        var BELGIE_LAT  = 50.85, BELGIE_LNG = 4.35, BELGIE_ZOOM = 7;

        var btn        = document.getElementById('rondAdresBtn');
        var btnLabel   = document.getElementById('rondAdresBtnLabel');
        var chevron    = document.getElementById('rondAdresChevron');
        var dropdown   = document.getElementById('rondAdresDropdown');
        var searchInp  = document.getElementById('rondAdresSearch');
        var straalInp  = document.getElementById('rondAdresStraal');
        var straalLbl  = document.getElementById('straalLabel');
        var countBadge = document.getElementById('rondAdresCount');
        var mapDiv     = document.getElementById('rondAdresMap');
        var latHidden  = document.getElementById('rondAdresLat');
        var lngHidden  = document.getElementById('rondAdresLng');
        if (!btn || !mapDiv) return;

        var initieelLat = @Html.Raw(Model.RondAdresLat.HasValue ? Model.RondAdresLat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null");
        var initieelLng = @Html.Raw(Model.RondAdresLng.HasValue ? Model.RondAdresLng.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null");

        var map, circle, centerMarker, handleMarker;
        var huidigeLat  = initieelLat !== null ? initieelLat : BELGIE_LAT;
        var huidigeLng  = initieelLng !== null ? initieelLng : BELGIE_LNG;
        var puntGekozen = initieelLat !== null;
        var puntGewijzigdSindsSubmit = false;

        // ── Geo-helpers (spiegelen de server-side Haversine/VpGeoDistance) ─────
        function haversineMeters(lat1, lng1, lat2, lng2) {
            var R = 6371000;
            var dLat = (lat2 - lat1) * Math.PI / 180;
            var dLng = (lng2 - lng1) * Math.PI / 180;
            var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                    Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                    Math.sin(dLng / 2) * Math.sin(dLng / 2);
            return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        }
        function destinationPoint(lat, lng, distM, bearingDeg) {
            var R = 6371000;
            var brng = bearingDeg * Math.PI / 180;
            var lat1 = lat * Math.PI / 180, lng1 = lng * Math.PI / 180;
            var lat2 = Math.asin(Math.sin(lat1) * Math.cos(distM / R) +
                                  Math.cos(lat1) * Math.sin(distM / R) * Math.cos(brng));
            var lng2 = lng1 + Math.atan2(
                Math.sin(brng) * Math.sin(distM / R) * Math.cos(lat1),
                Math.cos(distM / R) - Math.sin(lat1) * Math.sin(lat2));
            return { lat: lat2 * 180 / Math.PI, lng: lng2 * 180 / Math.PI };
        }
        function dotIcon(size, fill, border) {
            return L.divIcon({
                className: '',
                html: '<div style="width:' + size + 'px;height:' + size + 'px;border-radius:50%;' +
                      'background:' + fill + ';border:2px solid ' + border + ';box-shadow:0 1px 4px rgba(0,0,0,.35);"></div>',
                iconSize: [size, size],
                iconAnchor: [size / 2, size / 2]
            });
        }

        function fmtKm(meters) {
            var km = meters / 1000;
            return (km < 1 ? km.toFixed(2) : km.toFixed(1)).replace(/\.?0+$/, '') + ' km';
        }

        function updateLabel() {
            straalLbl.textContent = fmtKm(parseInt(straalInp.value, 10));
            if (puntGekozen) {
                btnLabel.textContent = 'Eigen punt (' + huidigeLat.toFixed(3) + ', ' + huidigeLng.toFixed(3) + ') · ' + fmtKm(parseInt(straalInp.value, 10));
            }
        }

        function syncHidden() {
            latHidden.value = puntGekozen ? huidigeLat : '';
            lngHidden.value = puntGekozen ? huidigeLng : '';
        }

        // ── Live telling (gedebounced) ──────────────────────────────────────────
        var countTimer = null;
        function ververTelling() {
            if (countTimer) clearTimeout(countTimer);
            if (!puntGekozen) { countBadge.textContent = '0'; return; }
            countTimer = setTimeout(function () {
                var params = new URLSearchParams({
                    lat: huidigeLat, lng: huidigeLng, straal: straalInp.value,
                    type: (document.querySelector('input[name="type"]:checked') || {}).value || 'Appartement',
                    status: (document.querySelector('input[name="status"]:checked') || {}).value || 'Alles'
                });
                var oppEl = document.getElementById('oppervlakte');
                var tolEl = document.getElementById('tolerantieSlider');
                if (oppEl && oppEl.value) { params.set('oppervlakte', oppEl.value); params.set('tolerantie', tolEl.value); }
                var slaapEl = document.querySelector('select[name="slaapkamers"]');
                if (slaapEl && slaapEl.value) params.set('slaapkamers', slaapEl.value);
                var prijsMinEl = document.querySelector('input[name="prijsMin"]');
                var prijsMaxEl = document.querySelector('input[name="prijsMax"]');
                if (prijsMinEl && prijsMinEl.value) params.set('prijsMin', prijsMinEl.value);
                if (prijsMaxEl && prijsMaxEl.value) params.set('prijsMax', prijsMaxEl.value);

                fetch(COUNT_URL + '?' + params.toString())
                    .then(function (r) { return r.json(); })
                    .then(function (data) { countBadge.textContent = data.aantal; })
                    .catch(function () { /* stille fout: preview is best-effort */ });
            }, 300);
        }

        // ── Kaart lazy initialiseren (pas zodra dropdown zichtbaar is) ──────────
        function initMapIndienNodig() {
            if (map) { map.invalidateSize(); return; }

            map = L.map(mapDiv, { zoomControl: true }).setView([huidigeLat, huidigeLng], BELGIE_ZOOM);
            map.attributionControl.setPrefix(false);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap-bijdragers &copy; CARTO',
                subdomains: 'abcd',
                maxZoom: 19
            }).addTo(map);

            circle = L.circle([huidigeLat, huidigeLng], {
                radius: parseInt(straalInp.value, 10),
                color: '#16a34a', weight: 2, dashArray: '4 6',
                fillColor: '#16a34a', fillOpacity: 0.08
            }).addTo(map);

            centerMarker = L.marker([huidigeLat, huidigeLng], {
                draggable: true, icon: dotIcon(16, '#16a34a', '#fff')
            }).addTo(map);

            var handlePos = destinationPoint(huidigeLat, huidigeLng, parseInt(straalInp.value, 10), 90);
            handleMarker = L.marker([handlePos.lat, handlePos.lng], {
                draggable: true, icon: dotIcon(12, '#fff', '#16a34a')
            }).addTo(map);

            centerMarker.on('drag', function (e) {
                var p = e.target.getLatLng();
                circle.setLatLng(p);
                var hp = destinationPoint(p.lat, p.lng, circle.getRadius(), 90);
                handleMarker.setLatLng([hp.lat, hp.lng]);
            });
            centerMarker.on('dragend', function (e) {
                zetPunt(e.target.getLatLng().lat, e.target.getLatLng().lng, true);
            });

            handleMarker.on('drag', function (e) {
                var r = haversineMeters(huidigeLat, huidigeLng, e.target.getLatLng().lat, e.target.getLatLng().lng);
                r = Math.min(25000, Math.max(250, Math.round(r / 250) * 250));
                circle.setRadius(r);
                straalInp.value = r;
                updateLabel();
            });
            handleMarker.on('dragend', function () {
                syncHidden();
                ververTelling();
            });

            map.on('click', function (e) {
                zetPunt(e.latlng.lat, e.latlng.lng, true);
            });

            if (puntGekozen) map.fitBounds(circle.getBounds(), { padding: [24, 24] });
        }

        function zetPunt(lat, lng, kaartActie) {
            huidigeLat = lat; huidigeLng = lng; puntGekozen = true;
            puntGewijzigdSindsSubmit = true;

            if (map) {
                circle.setLatLng([lat, lng]);
                centerMarker.setLatLng([lat, lng]);
                var hp = destinationPoint(lat, lng, circle.getRadius(), 90);
                handleMarker.setLatLng([hp.lat, hp.lng]);
                if (kaartActie === 'fit') map.fitBounds(circle.getBounds(), { padding: [24, 24] });
                else if (kaartActie) map.panTo([lat, lng]);
            }

            updateLabel();
            syncHidden();
            ververTelling();
        }

        // ── Straal-slider ────────────────────────────────────────────────────────
        straalInp.addEventListener('input', function () {
            var r = parseInt(this.value, 10);
            if (circle) {
                circle.setRadius(r);
                var hp = destinationPoint(huidigeLat, huidigeLng, r, 90);
                if (handleMarker) handleMarker.setLatLng([hp.lat, hp.lng]);
            }
            updateLabel();
            syncHidden();
            ververTelling();
        });

        // ── Adres zoeken (gedebounced geocoding) ────────────────────────────────
        var geocodeTimer = null;
        searchInp.addEventListener('input', function () {
            var q = this.value.trim();
            if (geocodeTimer) clearTimeout(geocodeTimer);
            if (q.length < 3) return;
            geocodeTimer = setTimeout(function () {
                fetch(GEOCODE_URL + '?query=' + encodeURIComponent(q))
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data && data.success) {
                            zetPunt(data.lat, data.lng, 'fit');
                        }
                    })
                    .catch(function () { /* stille fout: gebruiker kan handmatig verslepen */ });
            }, 450);
        });
        searchInp.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') e.preventDefault();
        });

        // ── Dropdown open/close ──────────────────────────────────────────────────
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var open = dropdown.classList.toggle('open');
            btn.classList.toggle('open', open);
            chevron.className = open ? 'bx bx-chevron-up' : 'bx bx-chevron-down';
            if (open) {
                initMapIndienNodig();
                ververTelling();
            }
        });

        window.vpSluitRondAdresDropdown = function () {
            if (!dropdown.classList.contains('open')) return;
            dropdown.classList.remove('open');
            btn.classList.remove('open');
            chevron.className = 'bx bx-chevron-down';
            // Toont automatisch resultaten zodra het middelpunt gekozen/gewijzigd is
            // (net als bij gemeente-selectie) — geen aparte zoekknop nodig.
            if (puntGewijzigdSindsSubmit && puntGekozen) {
                puntGewijzigdSindsSubmit = false;
                form.requestSubmit();
            }
        };

        // Init
        updateLabel();
        syncHidden();
    })();

    // ── Oppervlakte & tolerantie ──────────────────────────────────────────────
    var oppInput   = document.getElementById('oppervlakte');
    var tolSlider  = document.getElementById('tolerantieSlider');
    var tolLabel   = document.getElementById('tolLabel');
    var oppRangeLbl = document.getElementById('oppRangeLabel');

    function updateOppRange() {
        var opp = parseFloat(oppInput.value) || 0;
        var tol = parseInt(tolSlider.value) || 0;
        tolLabel.textContent = '± ' + tol + ' m²';
        if (opp > 0) {
            oppRangeLbl.style.display = '';
            oppRangeLbl.innerHTML = 'Zoekt units tussen <strong>' + Math.max(0, opp - tol) + '</strong> en <strong>' + (opp + tol) + '</strong> m²';
        } else {
            oppRangeLbl.style.display = 'none';
        }
    }

    oppInput.addEventListener('input', updateOppRange);
    tolSlider.addEventListener('input', updateOppRange);

    // ── Gemeente dropdown ─────────────────────────────────────────────────────
    var gemBtn      = document.getElementById('gemBtn');
    var gemDropdown = document.getElementById('gemDropdown');
    var gemBtnLabel = document.getElementById('gemBtnLabel');
    var gemSearch   = document.getElementById('gemSearch');
    var gemList     = document.getElementById('gemList');
    var gemChevron  = document.getElementById('gemChevron');
    var gemWissen   = document.getElementById('gemWissen');
    var hiddenInputs = [];  // will hold <input type="hidden" name="gemeenteIds" />

    function renderGemeenteList(filter) {
        gemList.innerHTML = '';
        hiddenInputs.forEach(function (el) { if (el.parentNode) el.parentNode.removeChild(el); });
        hiddenInputs = [];

        var term = (filter || '').toLowerCase();
        gemeenten.forEach(function (g) {
            if (term && g.naam.toLowerCase().indexOf(term) === -1) return;
            var row = document.createElement('div');
            row.className = 'vp-gem-row';
            var checked = geselecteerd.has(g.id) ? 'checked' : '';
            row.innerHTML =
                '<input type="checkbox" id="gem_' + g.id + '" value="' + g.id + '" ' + checked + ' style="margin-right:.5rem;cursor:pointer;" />' +
                '<label for="gem_' + g.id + '">' + g.naam + '</label>' +
                '<span class="vp-gem-count">' + (g.aantal || 0) + '</span>';
            row.querySelector('input').addEventListener('change', function () {
                if (this.checked) geselecteerd.add(parseInt(this.value));
                else geselecteerd.delete(parseInt(this.value));
                updateGemLabel();
                syncHiddenInputs();
                // Gemeente-selectie toont automatisch resultaten (geen zoekknop nodig)
                form.requestSubmit();
            });
            gemList.appendChild(row);
        });

        syncHiddenInputs();
    }

    function syncHiddenInputs() {
        hiddenInputs.forEach(function (el) { if (el.parentNode) el.parentNode.removeChild(el); });
        hiddenInputs = [];
        var form = document.getElementById('vpForm');
        geselecteerd.forEach(function (id) {
            var inp = document.createElement('input');
            inp.type = 'hidden'; inp.name = 'gemeenteIds'; inp.value = id;
            form.appendChild(inp);
            hiddenInputs.push(inp);
        });
    }

    function updateGemLabel() {
        if (geselecteerd.size === 0) {
            gemBtnLabel.textContent = 'Alle gemeenten';
        } else if (geselecteerd.size === 1) {
            var id = Array.from(geselecteerd)[0];
            var g  = gemeenten.find(function (x) { return x.id === id; });
            gemBtnLabel.textContent = g ? g.naam : '1 gemeente';
        } else {
            gemBtnLabel.textContent = geselecteerd.size + ' gemeenten geselecteerd';
        }
    }

    gemBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = gemDropdown.classList.toggle('open');
        gemBtn.classList.toggle('open', open);
        gemChevron.className = open ? 'bx bx-chevron-up' : 'bx bx-chevron-down';
        if (open) { renderGemeenteList(''); gemSearch.focus(); }
    });

    gemSearch.addEventListener('input', function () { renderGemeenteList(this.value); });

    gemWissen.addEventListener('click', function () {
        var hadSelectie = geselecteerd.size > 0;
        geselecteerd.clear();
        renderGemeenteList(gemSearch.value);
        updateGemLabel();
        // Gemeente-selectie toont automatisch resultaten (geen zoekknop nodig)
        if (hadSelectie) form.requestSubmit();
    });

    document.addEventListener('click', function (e) {
        if (!gemBtn.contains(e.target) && !gemDropdown.contains(e.target)) {
            gemDropdown.classList.remove('open');
            gemBtn.classList.remove('open');
            gemChevron.className = 'bx bx-chevron-down';
        }

        var rondBtn = document.getElementById('rondAdresBtn');
        var rondDropdown = document.getElementById('rondAdresDropdown');
        if (rondBtn && rondDropdown && !rondBtn.contains(e.target) && !rondDropdown.contains(e.target)
            && typeof window.vpSluitRondAdresDropdown === 'function') {
            window.vpSluitRondAdresDropdown();
        }
    });

    // Init
    renderGemeenteList('');
    updateGemLabel();

})();
</script>
@if (Model.HeeftResultaten)
{
<script>
(function () {
    var table = $('#tblVergelijkbaar').DataTable({
        dom: 'rt<"row align-items-center px-3 py-3"<"col-md-6"i><"col-md-6 d-flex justify-content-end"p>>',
        pageLength: 10,
        language: {
            info:     'Resultaten _START_–_END_ van _TOTAL_',
            infoEmpty: 'Geen resultaten',
            paginate: { previous: '‹', next: '›' }
        },
        order: [[5, 'asc']],
        columnDefs: [
            { targets: [3, 5, 6], className: 'text-end' },
            { targets: [4], className: 'text-center' }
        ]
    });

    document.getElementById('vpSearch').addEventListener('input', function () {
        table.search(this.value).draw();
    });
    document.getElementById('vpPageLength').addEventListener('change', function () {
        table.page.len(parseInt(this.value)).draw();
    });

    document.getElementById('tblVergelijkbaar').addEventListener('click', function (e) {
        var tr = e.target.closest('tr.vp-row');
        if (!tr) return;
        var url = tr.dataset.url;
        if (!url) return;
        if (tr.dataset.external === 'true') window.open(url, '_blank');
        else window.location.href = url;
    });
})();
</script>
}
}
