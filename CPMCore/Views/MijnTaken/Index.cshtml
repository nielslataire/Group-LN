@using BOCore
@using DALCore.Models
@model CPMCore.Models.Traject.MijnTakenIndexVm
@{
    ViewData["Title"] ??= "Mijn taken";
    var vandaag = DateOnly.FromDateTime(DateTime.Today);
    var statussen = Enum.GetValues(typeof(TaakStatus)).Cast<TaakStatus>().ToList();
}

@section PageStyle {
    <link rel="stylesheet" href="~/css/traject.css" asp-append-version="true" />
}

<div class="row justify-content-between align-items-center pt-2 pe-0 mb-2">
    <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
        <h1 class="font-weight-bold mb-0 mt-0">Mijn taken</h1>
        <h5 class="mb-0 mt-0 text-muted">Persoonlijke opvolging over al je projecten heen</h5>
    </div>
    <div class="col-sm-auto px-0">
        <button type="button" class="btn btn-primary btn-md" data-bs-toggle="modal" data-bs-target="#modalTaakUpsert">
            <i class="bx bx-plus"></i> Nieuwe taak
        </button>
    </div>
</div>

<div class="gl-kpi2-strip mt-1 mb-3">
    <div class="gl-kpi2-tile">
        <span class="gl-kpi2-label">Open</span>
        <span class="gl-kpi2-value">@Model.AantalOpen</span>
    </div>
    <div class="gl-kpi2-tile @(Model.AantalAchterstallig > 0 ? "gl-kpi2-severe" : "")">
        <span class="gl-kpi2-label">Achterstallig</span>
        <span class="gl-kpi2-value">@Model.AantalAchterstallig</span>
    </div>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small mb-1">Status</label>
        <select name="Status" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">Alle (behalve afgerond/geannuleerd)</option>
            @foreach (var s in statussen)
            {
                <option value="@((int)s)" selected="@(Model.Filter.Status == (int)s)">@s.GetDisplayName()</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-1">Project</label>
        <select name="ProjectId" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">Alle projecten</option>
            @foreach (var p in Model.Projecten)
            {
                <option value="@p.ID" selected="@(Model.Filter.ProjectId == p.ID)">@p.Display</option>
            }
        </select>
    </div>
    <div class="col-auto form-check mt-4">
        <input type="checkbox" class="form-check-input" name="AlleenAchterstallig" value="true" id="chkAchterstallig"
               checked="@(Model.Filter.AlleenAchterstallig == true)" onchange="this.form.submit()" />
        <label class="form-check-label small" for="chkAchterstallig">Enkel achterstallig</label>
    </div>
</form>

<table class="table table-hover w-100">
    <thead>
        <tr>
            <th>Titel</th><th>Project</th><th>Prioriteit</th><th>Vervaldatum</th><th>Status</th><th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model.Taken)
        {
            var over = t.Vervaldatum != null && t.Vervaldatum.Value < vandaag
                       && t.Status != (int)TaakStatus.Afgerond && t.Status != (int)TaakStatus.Geannuleerd;
            <tr>
                <td>
                    <strong>@t.Titel</strong>
                    @if (!string.IsNullOrWhiteSpace(t.Omschrijving))
                    {
                        <div class="text-muted small">@t.Omschrijving</div>
                    }
                    @if (t.Herkomst == (int)TaakHerkomst.Trigger)
                    {
                        <span class="badge bg-light text-dark">Automatisch</span>
                    }
                </td>
                <td>
                    @if (t.Project != null)
                    {
                        <a href="@Url.Action("Detail", "Projecten", new { projectid = t.ProjectId })">@t.Project.ProjectName</a>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td>@(((TaakPrioriteit)t.Prioriteit).GetDisplayName())</td>
                <td class="@(over ? "text-danger fw-bold" : "")">@(t.Vervaldatum?.ToString("dd/MM/yyyy") ?? "—")</td>
                <td>
                    <form method="post" asp-action="Status" asp-route-id="@t.Id" class="d-flex gap-1">
                        @Html.AntiForgeryToken()
                        <select name="nieuweStatus" class="form-select form-select-sm">
                            @foreach (var s in statussen)
                            {
                                <option value="@((int)s)" selected="@(t.Status == (int)s)">@s.GetDisplayName()</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-xs btn-primary">Zet</button>
                    </form>
                </td>
                <td class="text-end">
                    <form method="post" asp-action="Verwijderen" asp-route-id="@t.Id" onsubmit="return confirm('Deze taak verwijderen?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-xs btn-outline-danger"><i class="bx bx-trash"></i></button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
@if (Model.Taken.Count == 0)
{
    <div class="text-muted text-center py-4">Geen taken gevonden.</div>
}

<div class="modal fade" id="modalTaakUpsert" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-action="Opslaan" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">Nieuwe taak</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label">Titel</label>
                    <input type="text" name="Titel" class="form-control" required />
                </div>
                <div class="mb-2">
                    <label class="form-label">Omschrijving</label>
                    <textarea name="Omschrijving" class="form-control" rows="2"></textarea>
                </div>
                <div class="mb-2">
                    <label class="form-label">Project</label>
                    <select name="ProjectId" class="form-select">
                        <option value="">— Geen project —</option>
                        @foreach (var p in Model.Projecten)
                        {
                            <option value="@p.ID">@p.Display</option>
                        }
                    </select>
                </div>
                <div class="row">
                    <div class="col-6 mb-2">
                        <label class="form-label">Prioriteit</label>
                        <select name="Prioriteit" class="form-select">
                            @foreach (TaakPrioriteit p in Enum.GetValues(typeof(TaakPrioriteit)))
                            {
                                <option value="@((int)p)" selected="@(p == TaakPrioriteit.Normaal)">@p.GetDisplayName()</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 mb-2">
                        <label class="form-label">Vervaldatum</label>
                        <input type="date" name="Vervaldatum" class="form-control" />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label">Toegewezen aan (gebruikers-id, leeg = mezelf)</label>
                    <input type="text" name="ToegewezenAanUserId" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-bs-dismiss="modal">Annuleren</button>
                <button type="submit" class="btn btn-primary">Opslaan</button>
            </div>
        </form>
    </div>
</div>
