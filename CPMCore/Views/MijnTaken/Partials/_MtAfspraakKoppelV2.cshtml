@model CPMCore.Models.MijnTaken.MtShell
@using CPMCore.Models.GlV2
@*
    Mijn taken › Vandaag en Week: kies het project voor een afspraak uit Outlook (opent vanuit de popover van een afspraak, gl-v2-mijntaken.js). De koppeling blijft onthouden;
    de afspraak zelf blijft in Outlook ongemoeid.
*@
<div class="modal fade gl-v2-modal-form" id="mt-afspraak-koppel-modal" tabindex="-1" aria-hidden="true" aria-labelledby="mt-afspraak-koppel-titel">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
        <form class="modal-content" novalidate>
            <div class="modal-header"><h2 class="modal-title" id="mt-afspraak-koppel-titel">Afspraak koppelen aan een project</h2><button type="button" class="gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button></div>
            <div class="modal-body">
                <p class="gl-v2-mt-muted" id="mt-afspraak-koppel-onderwerp"></p>
                @await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm { Name = "projectId", Id = "mt-afspraak-koppel-project", Label = "Project", Items = Model.Projecten.Select(p => new GlV2SelectItem { Value = p.Id.ToString(), Text = p.Naam }).ToList(), Placeholder = "Kies een project", EmptyText = "Kies een project" })
                <span class="gl-v2-field-help">CPM onthoudt de koppeling. De afspraak zelf blijft in Outlook ongewijzigd.</span>
            </div>
            <div class="modal-footer"><button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button><button type="submit" class="gl-v2-btn gl-v2-btn-primary">Koppelen</button></div>
        </form>
    </div>
</div>
