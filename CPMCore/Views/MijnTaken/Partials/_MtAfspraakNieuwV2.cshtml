@model CPMCore.Models.MijnTaken.MtShell
@using CPMCore.Models.GlV2
@using System.Text.Json
@*
    Mijn taken › Vandaag en Week: een nieuwe afspraak op een project maken (gl-v2-mijntaken.js). De afspraak komt in je Outlook-agenda en is meteen aan het project gekoppeld.
    Componenten: _GlV2Combo (project, deelnemers), _DateField (datum), _SelectList (van en tot, kwartierstappen). Uitnodigen staat standaard uit: enkel met het vinkje komen de gekozen
    deelnemers op de afspraak en stuurt Outlook de uitnodigingen. Het deelnemersveld toont altijd eerst de collega's; een getypt e-mailadres wordt een extern adres.
*@
@{
    var projecten = JsonSerializer.Serialize(Model.Projecten.Select(p => new { id = p.Id.ToString(), text = p.Naam }));
    var kwartieren = Enumerable.Range(0, 96).Select(i => new GlV2SelectItem { Value = $"{i / 4:00}:{i % 4 * 15:00}", Text = $"{i / 4:00}:{i % 4 * 15:00}" }).ToList();
    var vandaag = DateTime.Today;
}
<div class="modal fade gl-v2-modal-form" id="mt-afspraak-nieuw-modal" tabindex="-1" aria-hidden="true" aria-labelledby="mt-afspraak-nieuw-titel">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-md-down">
        <form class="modal-content" novalidate>
            <div class="modal-header"><h2 class="modal-title" id="mt-afspraak-nieuw-titel">Nieuwe afspraak op een project</h2><button type="button" class="gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button></div>
            <div class="modal-body gl-v2-mt-an">
                <div class="gl-v2-mt-an-rij gl-v2-mt-an-rij--2">
                    <div class="gl-v2-field">
                        <label class="gl-v2-field-label" for="mt-an-titel">Titel</label>
                        <div class="gl-v2-field-box"><input class="gl-v2-field-input" id="mt-an-titel" maxlength="200" placeholder="bv. Werfvergadering" /></div>
                    </div>
                    <div class="gl-v2-field">
                        <label class="gl-v2-field-label" for="mt-an-project_input">Project</label>
                        @await Html.PartialAsync("GlV2/_GlV2Combo", new GlV2ComboVm { Name = "projectId", Id = "mt-an-project", Placeholder = "Zoek een project", OptionsJson = projecten, Icon = "ph-buildings", ListLabel = "ALLE PROJECTEN" })
                    </div>
                </div>
                <div class="gl-v2-mt-an-rij gl-v2-mt-an-rij--3">
                    @await Html.PartialAsync("GlV2/_DateField", new GlV2DateFieldVm { Name = "datum", Id = "mt-an-datum", Label = "Datum", IsoValue = vandaag.ToString("yyyy-MM-dd"), DisplayValue = vandaag.ToString("dd/MM/yyyy") })
                    @await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm { Name = "van", Id = "mt-an-van", Label = "Van", Items = kwartieren, Placeholder = "Kies …" })
                    @await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm { Name = "tot", Id = "mt-an-tot", Label = "Tot", Items = kwartieren, Placeholder = "Kies …" })
                </div>
                <div class="gl-v2-field">
                    <label class="gl-v2-field-label" for="mt-an-plaats">Plaats</label>
                    <div class="gl-v2-field-box"><input class="gl-v2-field-input" id="mt-an-plaats" maxlength="200" /></div>
                </div>
                <label class="gl-v2-mt-an-vink"><span class="gl-v2-check"><input type="checkbox" id="mt-an-uitnodigen" /><label for="mt-an-uitnodigen"></label></span><span>Deelnemers uitnodigen</span></label>
                <span class="gl-v2-field-help" id="mt-an-nota">Er gaat geen uitnodiging uit. De afspraak staat enkel in je eigen agenda.</span>
                <div class="gl-v2-field" id="mt-an-deelnemers-rij" hidden>
                    <label class="gl-v2-field-label" for="mt-an-zoek_input">Deelnemers</label>
                    @await Html.PartialAsync("GlV2/_GlV2Combo", new GlV2ComboVm { Name = "deelnemerZoek", Id = "mt-an-zoek", Placeholder = "Kies een collega, zoek een contactpersoon of typ een e-mailadres", LookupUrl = Url.Content("~/MijnTaken/UitnodigingZoek"), MinChars = 0, ClearOnSelect = true, Avatar = true, Icon = "ph-user-plus" })
                    <div class="gl-v2-select-chips" id="mt-an-chips"></div>
                    <span class="gl-v2-field-help">Collega's staan bovenaan. Outlook stuurt de gekozen mensen meteen een uitnodiging.</span>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button><button type="submit" class="gl-v2-btn gl-v2-btn-primary">Afspraak maken</button></div>
        </form>
    </div>
</div>
