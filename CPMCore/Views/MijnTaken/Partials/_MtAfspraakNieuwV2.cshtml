@model CPMCore.Models.MijnTaken.MtShell
@using CPMCore.Models.GlV2
@*
    Mijn taken › Vandaag en Week: een nieuwe afspraak op een project maken (gl-v2-mijntaken.js). De afspraak komt in je Outlook-agenda en is meteen aan het project gekoppeld.
    Uitnodigen staat standaard uit: enkel met het vinkje komen de ingevulde e-mailadressen als deelnemers op de afspraak en stuurt Outlook de uitnodigingen.
*@
<div class="modal fade gl-v2-modal-form" id="mt-afspraak-nieuw-modal" tabindex="-1" aria-hidden="true" aria-labelledby="mt-afspraak-nieuw-titel">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
        <form class="modal-content" novalidate>
            <div class="modal-header"><h2 class="modal-title" id="mt-afspraak-nieuw-titel">Nieuwe afspraak op een project</h2><button type="button" class="gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button></div>
            <div class="modal-body">
                <div class="gl-v2-field">
                    <label class="gl-v2-field-label" for="mt-an-titel">Titel</label>
                    <div class="gl-v2-field-box"><input class="gl-v2-field-input" id="mt-an-titel" maxlength="200" placeholder="bv. Werfvergadering" /></div>
                </div>
                @await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm { Name = "projectId", Id = "mt-an-project", Label = "Project", Items = Model.Projecten.Select(p => new GlV2SelectItem { Value = p.Id.ToString(), Text = p.Naam }).ToList(), Placeholder = "Kies een project", EmptyText = "Kies een project" })
                <div class="gl-v2-mt-pop-tijden">
                    <div class="gl-v2-field"><label class="gl-v2-field-label" for="mt-an-datum">Datum</label><div class="gl-v2-field-box"><input type="date" class="gl-v2-field-input" id="mt-an-datum" /></div></div>
                    <div class="gl-v2-field"><label class="gl-v2-field-label" for="mt-an-van">Van</label><div class="gl-v2-field-box"><input type="time" step="300" class="gl-v2-field-input" id="mt-an-van" /></div></div>
                    <div class="gl-v2-field"><label class="gl-v2-field-label" for="mt-an-tot">Tot</label><div class="gl-v2-field-box"><input type="time" step="300" class="gl-v2-field-input" id="mt-an-tot" /></div></div>
                </div>
                <div class="gl-v2-field">
                    <label class="gl-v2-field-label" for="mt-an-plaats">Plaats</label>
                    <div class="gl-v2-field-box"><input class="gl-v2-field-input" id="mt-an-plaats" maxlength="200" /></div>
                </div>
                <label class="gl-v2-mp-check-row"><span class="gl-v2-check"><input type="checkbox" id="mt-an-uitnodigen" /><label for="mt-an-uitnodigen"></label></span><span>Deelnemers uitnodigen</span></label>
                <div class="gl-v2-field" id="mt-an-deelnemers-rij" hidden>
                    <label class="gl-v2-field-label" for="mt-an-deelnemers">E-mailadressen</label>
                    <div class="gl-v2-field-box"><input class="gl-v2-field-input" id="mt-an-deelnemers" placeholder="Gescheiden door een komma" /></div>
                    <span class="gl-v2-field-help">Outlook stuurt hen meteen een uitnodiging.</span>
                </div>
                <span class="gl-v2-field-help" id="mt-an-nota">Er gaat geen uitnodiging uit. De afspraak staat enkel in je eigen agenda.</span>
            </div>
            <div class="modal-footer"><button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button><button type="submit" class="gl-v2-btn gl-v2-btn-primary">Afspraak maken</button></div>
        </form>
    </div>
</div>
