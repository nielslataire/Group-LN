@section PageScripts {
<script>
    (function () {
        var toolbarOptions = [
            ['bold', 'italic', 'underline'],
            [{ 'list': 'ordered' }, { 'list': 'bullet' }],
            [{ 'header': [2, 3, 4, false] }],
            ['link'],
            ['clean']
        ];

        var container = document.getElementById('quill-beschrijving');
        var input = document.getElementById('quill-beschrijving-input');
        if (container && input) {
            var quill = new Quill(container, { theme: 'snow', modules: { toolbar: toolbarOptions } });
            if (input.value) quill.root.innerHTML = input.value;
            quill.on('text-change', function () { input.value = quill.root.innerHTML; });
            var form = document.getElementById('vacature-form');
            if (form) form.addEventListener('submit', function () { input.value = quill.root.innerHTML; });
        }
    })();
</script>
<script>
(function () {
    var VACATURE_ID = @Model.ID;

    function wireNieuwBtn(btnId, panelId) {
        var btn = document.getElementById(btnId);
        if (!btn) return;
        btn.addEventListener('click', function () {
            var panel = document.getElementById(panelId);
            if (panel) {
                var bsCollapse = bootstrap.Collapse.getOrCreateInstance(panel);
                bsCollapse.show();
                setTimeout(function () { panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }, 200);
            }
        });
    }

    function wireSortable(listId, volgordeUrl) {
        var lijst = document.getElementById(listId);
        if (!lijst || typeof Sortable === 'undefined') return;
        Sortable.create(lijst, {
            handle: '.bw-blok-grip',
            animation: 150,
            ghostClass: 'sortable-ghost',
            dragClass: 'sortable-drag',
            onEnd: function () {
                var wraps = lijst.querySelectorAll('.bw-blok-wrap[data-id]');
                var ids = Array.from(wraps).map(function (w) { return parseInt(w.dataset.id); });

                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                var fd = new FormData();
                if (token) fd.append('__RequestVerificationToken', token.value);
                fd.append('VacatureId', VACATURE_ID);
                ids.forEach(function (id) { fd.append('SortedIds', id); });

                fetch(volgordeUrl, { method: 'POST', body: fd })
                    .catch(function () { console.warn('Volgorde opslaan mislukt.'); });
            }
        });
    }

    wireNieuwBtn('taakNieuwBtn', 'nieuwTaakPanel');
    wireNieuwBtn('vereisteMustHaveNieuwBtn', 'nieuwVereisteMustHavePanel');
    wireNieuwBtn('vereisteMooiNieuwBtn', 'nieuwVereisteMooiPanel');
    wireNieuwBtn('voordeelNieuwBtn', 'nieuwVoordeelPanel');
    wireNieuwBtn('stapNieuwBtn', 'nieuwStapPanel');

    wireSortable('taakLijst', '@Url.Action("TaakVolgorde")');
    wireSortable('vereisteMustHaveLijst', '@Url.Action("VereisteVolgorde")');
    wireSortable('vereisteMooiLijst', '@Url.Action("VereisteVolgorde")');
    wireSortable('voordeelLijst', '@Url.Action("VoordeelVolgorde")');
    wireSortable('stapLijst', '@Url.Action("StapVolgorde")');

    // ── Validatiesamenvatting ──
    var summary = document.getElementById('val-summary');
    if (summary && summary.querySelector('.validation-summary-errors'))
        summary.classList.remove('d-none');
})();
</script>
}
