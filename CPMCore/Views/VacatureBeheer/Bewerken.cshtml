@model CPMCore.Models.Instellingen.VacatureEditVM
@{
    var isNieuw = Model.ID == 0;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section PageStyle {
<link href="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.snow.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1/Sortable.min.js"></script>
<style>
    .bw-card { border: 1px solid #e9ecef; border-radius: 10px; background: #fff; margin-bottom: 24px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.04); }
    .bw-card-inner { display: flex; }
    .bw-sidebar { width: 230px; min-width: 230px; padding: 28px 22px; border-right: 1px solid #e9ecef; display: flex; flex-direction: column; background: #fff; }
    .bw-content { flex: 1; padding: 28px; min-width: 0; }
    .bw-card-footer { display: flex; align-items: center; justify-content: space-between; padding: 14px 28px; border-top: 1px solid #e9ecef; background: #f9fafb; }
    .bw-icon { width: 44px; height: 44px; background: #ECF4E8; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; color: #00532D; margin-bottom: 14px; flex-shrink: 0; }
    .bw-sidebar-title { font-weight: 700; font-size: 14px; color: #212529; margin-bottom: 6px; }
    .bw-sidebar-desc { font-size: 12px; color: #6c757d; line-height: 1.55; }
    .bw-sidebar-note { font-size: 12px; color: #6c757d; line-height: 1.55; margin-top: auto; padding-top: 20px; }

    .bw-badge-pub { background: #d1fae5; color: #065f46; font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 20px; display: inline-flex; align-items: center; gap: 5px; }
    .bw-badge-pub::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #059669; flex-shrink: 0; }
    .bw-badge-concept { background: #fef3c7; color: #92400e; font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 20px; }

    .ql-container { border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; }
    .ql-toolbar { border-top-left-radius: 4px; border-top-right-radius: 4px; }
    .quill-wrap { height: 240px; }

    .bw-blok-wrap { margin-bottom: 8px; }
    .bw-blok-wrap:last-child { margin-bottom: 0; }
    .bw-blok-row { display: flex; align-items: center; gap: 10px; padding: 13px 14px; border: 1px solid #e9ecef; border-radius: 8px; background: #fff; }
    .bw-blok-grip { color: #c2ccd6; cursor: grab; font-size: 20px; flex-shrink: 0; touch-action: none; line-height: 1; }
    .bw-blok-grip:active { cursor: grabbing; }
    .bw-blok-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 700; letter-spacing: 1px; padding: 4px 8px; border-radius: 5px; flex-shrink: 0; white-space: nowrap; }
    .bw-blok-badge.musthave { background: #fee2e2; color: #991b1b; }
    .bw-blok-badge.mooi { background: #dbeafe; color: #1e40af; }
    .bw-blok-titel { flex: 1; font-size: 14px; font-weight: 500; color: #212529; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .bw-blok-acties { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
    .bw-blok-edit-panel { background: #f8fafb; border: 1px solid #e9ecef; border-radius: 8px; margin-top: 4px; padding: 20px 20px 16px; }
    .bw-sublijst-titel { font-size: 10px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; color: #9aabb8; }
</style>
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-1">@(isNieuw ? "Nieuwe vacature" : "Vacature bewerken")</h1>
        @if (!isNieuw)
        {
            <div class="d-flex align-items-center gap-2 mt-1 flex-wrap">
                <span class="text-muted" style="font-size:14px;">@Model.Titel</span>
                @if (Model.IsGepubliceerd)
                {
                    <span class="bw-badge-pub">Gepubliceerd</span>
                }
                else
                {
                    <span class="bw-badge-concept">Concept</span>
                }
            </div>
        }
    </div>
    <div class="d-flex gap-2">
        @if (!isNieuw)
        {
            <a href="@Url.Action("Sollicitaties", new { vacatureId = Model.ID })" class="btn btn-outline-secondary flex-shrink-0">
                <i class="bx bx-mail-send"></i> Sollicitaties
            </a>
        }
        <a href="@Url.Action("Index")" class="btn btn-default flex-shrink-0">
            <i class="bx bx-arrow-back"></i> Terug
        </a>
    </div>
</div>

<form id="vacature-form" method="post" action="@Url.Action("Bewerken")">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ID" />

    <div asp-validation-summary="All" class="alert alert-danger d-none mb-4" id="val-summary"></div>

    <div class="bw-card">
        <div class="bw-card-inner">
            <div class="bw-sidebar">
                <div class="bw-icon"><i class="bx bx-briefcase"></i></div>
                <div class="bw-sidebar-title">Vacature</div>
                <div class="bw-sidebar-desc">Gegevens voor de overzichts- en detailpagina op de website.</div>
                <div class="bw-sidebar-note">Velden met <span class="text-danger">*</span> zijn verplicht. Slug leeg laten = automatisch gegenereerd op basis van de titel.</div>
            </div>
            <div class="bw-content">
                <div class="row g-3">
                    <div class="col-md-4 col-lg-2 align-content-center text-end">
                        <label asp-for="Titel" class="form-label fw-semibold">Titel <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-md-8 col-lg-10">
                        <input asp-for="Titel" class="form-control" placeholder="Bv. Junior Projectleider Bouw" />
                        <span asp-validation-for="Titel" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 col-lg-2 align-content-center text-end">
                        <label asp-for="Slug" class="form-label fw-semibold">Slug</label>
                    </div>
                    <div class="col-md-8 col-lg-10">
                        <input asp-for="Slug" class="form-control" placeholder="wordt-automatisch-gegenereerd" />
                    </div>

                    <div class="col-md-4 col-lg-2 align-content-center text-end">
                        <label asp-for="Categorie" class="form-label fw-semibold">Categorie</label>
                    </div>
                    <div class="col-md-8 col-lg-10">
                        <input asp-for="Categorie" class="form-control" placeholder="Bv. Bouw &amp; Werfopvolging" />
                    </div>

                    <div class="col-md-4 col-lg-2 align-content-center text-end">
                        <label asp-for="Locatie" class="form-label fw-semibold">Locatie</label>
                    </div>
                    <div class="col-md-8 col-lg-10">
                        <input asp-for="Locatie" class="form-control" placeholder="Bv. Gent" />
                    </div>

                    <div class="col-md-4 col-lg-2 align-content-center text-end">
                        <label asp-for="Dienstverband" class="form-label fw-semibold">Dienstverband</label>
                    </div>
                    <div class="col-md-8 col-lg-10">
                        <input asp-for="Dienstverband" class="form-control" placeholder="Bv. Voltijds" />
                    </div>

                    <div class="col-md-4 col-lg-2 align-content-center text-end">
                        <label asp-for="Opleiding" class="form-label fw-semibold">Opleiding</label>
                    </div>
                    <div class="col-md-8 col-lg-10">
                        <input asp-for="Opleiding" class="form-control" placeholder="Bv. Bachelor Bouw of gelijkwaardig door ervaring" />
                    </div>

                    <div class="col-md-4 col-lg-2 align-content-center text-end">
                        <label asp-for="Start" class="form-label fw-semibold">Start</label>
                    </div>
                    <div class="col-md-8 col-lg-10">
                        <input asp-for="Start" class="form-control" placeholder="Bv. Zo snel mogelijk" />
                    </div>

                    <div class="col-md-4 col-lg-2 align-content-center text-end">
                        <label asp-for="KorteBeschrijving" class="form-label fw-semibold">Korte beschrijving</label>
                    </div>
                    <div class="col-md-8 col-lg-10">
                        <textarea asp-for="KorteBeschrijving" class="form-control" rows="2" placeholder="Verschijnt op de vacaturekaart in de lijst..."></textarea>
                    </div>

                    <div class="col-md-4 col-lg-2 text-end">
                        <label class="form-label fw-semibold">Lange beschrijving</label>
                    </div>
                    <div class="col-md-8 col-lg-10">
                        <div id="quill-beschrijving" class="quill-wrap"></div>
                        <textarea asp-for="Beschrijving" id="quill-beschrijving-input" style="display:none;"></textarea>
                    </div>

                    <div class="col-md-4 col-lg-2 align-content-center text-end">
                        <label asp-for="SortOrder" class="form-label fw-semibold">Volgorde</label>
                    </div>
                    <div class="col-md-8 col-lg-10">
                        <input asp-for="SortOrder" type="number" class="form-control" style="max-width:120px;" />
                    </div>

                    <div class="col-md-4 col-lg-2"></div>
                    <div class="col-md-8 col-lg-10">
                        <div class="form-check form-switch">
                            <input asp-for="IsGepubliceerd" class="form-check-input" role="switch" />
                            <label asp-for="IsGepubliceerd" class="form-check-label">Gepubliceerd (zichtbaar op de website)</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="bw-card-footer">
            <div></div>
            <button type="submit" class="btn btn-primary">
                <i class="bx bx-save"></i> Opslaan
            </button>
        </div>
    </div>
</form>

@if (!isNieuw)
{
    @* ── Takenpakket ──────────────────────────────────────────────── *@
    <div class="bw-card">
        <div class="bw-card-inner">
            <div class="bw-sidebar">
                <div class="bw-icon"><i class="bx bx-list-check"></i></div>
                <div class="bw-sidebar-title">Takenpakket</div>
                <div class="bw-sidebar-desc">Puntenlijst van taken voor de detailpagina.</div>
                @if (Model.TaakItems.Any())
                {
                    <div class="bw-sidebar-note">Sleep aan de greep <i class="bx bx-grid-vertical" style="font-size:15px;vertical-align:middle;"></i> om de volgorde te wijzigen.</div>
                }
            </div>
            <div class="bw-content">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="bw-sublijst-titel">Taken</span>
                    <button type="button" class="btn btn-primary btn-sm" id="taakNieuwBtn">
                        <i class="bx bx-plus"></i> Taak toevoegen
                    </button>
                </div>

                @if (!Model.TaakItems.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bx bx-list-check" style="font-size:2.2rem;"></i>
                        <p class="mt-2 mb-0" style="font-size:14px;">Nog geen taken. Voeg er een toe via de knop hierboven.</p>
                    </div>
                }

                <div id="taakLijst">
                    @foreach (var taak in Model.TaakItems.OrderBy(t => t.SortOrder))
                    {
                        <div class="bw-blok-wrap" data-id="@taak.ID">
                            <div class="bw-blok-row">
                                <div class="bw-blok-grip" title="Sleep om volgorde te wijzigen"><i class="bx bx-grid"></i></div>
                                <div class="bw-blok-titel">@taak.Tekst</div>
                                <div class="bw-blok-acties">
                                    <button type="button" class="btn btn-sm btn-default" data-bs-toggle="collapse" data-bs-target="#taak-panel-@taak.ID">
                                        <i class="bx bx-pencil"></i> Bewerken
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger"
                                            onclick="if(confirm('Taak verwijderen?')) document.getElementById('del-taak-@taak.ID').submit();">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="collapse" id="taak-panel-@taak.ID">
                                <div class="bw-blok-edit-panel">
                                    <form method="post" action="@Url.Action("TaakOpslaan")">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ID" value="@taak.ID" />
                                        <input type="hidden" name="VacatureId" value="@Model.ID" />
                                        <div class="row g-3">
                                            <div class="col-md-9">
                                                <label class="form-label fw-semibold">Tekst <span class="text-danger">*</span></label>
                                                <input type="text" name="Tekst" value="@taak.Tekst" class="form-control" maxlength="500" required />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label fw-semibold">Volgorde</label>
                                                <input type="number" name="SortOrder" value="@taak.SortOrder" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="d-flex gap-2 mt-3">
                                            <button type="submit" class="btn btn-sm btn-primary"><i class="bx bx-save"></i> Opslaan</button>
                                            <button type="button" class="btn btn-sm btn-default" data-bs-toggle="collapse" data-bs-target="#taak-panel-@taak.ID">Annuleren</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            <form id="del-taak-@taak.ID" method="post" action="@Url.Action("TaakVerwijderen")" style="display:none;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="taakId" value="@taak.ID" />
                                <input type="hidden" name="vacatureId" value="@Model.ID" />
                            </form>
                        </div>
                    }
                </div>

                <div class="collapse mt-3" id="nieuwTaakPanel">
                    <div class="bw-blok-edit-panel">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fw-semibold" style="font-size:14px;">Nieuwe taak</span>
                            <button type="button" class="btn-close" aria-label="Sluiten" data-bs-toggle="collapse" data-bs-target="#nieuwTaakPanel" style="font-size:12px;"></button>
                        </div>
                        <form method="post" action="@Url.Action("TaakOpslaan")">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ID" value="0" />
                            <input type="hidden" name="VacatureId" value="@Model.ID" />
                            <div class="row g-3">
                                <div class="col-md-9">
                                    <label class="form-label fw-semibold">Tekst <span class="text-danger">*</span></label>
                                    <input type="text" name="Tekst" class="form-control" placeholder="Typ het punt..." maxlength="500" required />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">Volgorde</label>
                                    <input type="number" name="SortOrder" value="@(Model.TaakItems.Any() ? Model.TaakItems.Max(t => t.SortOrder) + 10 : 0)" class="form-control" />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary mt-3"><i class="bx bx-plus"></i> Taak toevoegen</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Wie zoeken we: must-haves + mooi meegenomen ─────────────────── *@
    <div class="bw-card">
        <div class="bw-card-inner">
            <div class="bw-sidebar">
                <div class="bw-icon"><i class="bx bx-user-check"></i></div>
                <div class="bw-sidebar-title">Wie zoeken we</div>
                <div class="bw-sidebar-desc">Onderverdeeld in must-haves en mooi meegenomen.</div>
            </div>
            <div class="bw-content">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="bw-sublijst-titel">Must-haves</span>
                    <button type="button" class="btn btn-primary btn-sm" id="vereisteMustHaveNieuwBtn">
                        <i class="bx bx-plus"></i> Toevoegen
                    </button>
                </div>

                @{ var mustHaves = Model.VereisteItems.Where(v => v.Categorie == "MustHave").OrderBy(v => v.SortOrder).ToList(); }
                @if (!mustHaves.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <p class="mb-0" style="font-size:14px;">Nog geen must-haves.</p>
                    </div>
                }
                <div id="vereisteMustHaveLijst">
                    @foreach (var v in mustHaves)
                    {
                        <div class="bw-blok-wrap" data-id="@v.ID">
                            <div class="bw-blok-row">
                                <div class="bw-blok-grip" title="Sleep om volgorde te wijzigen"><i class="bx bx-grid"></i></div>
                                <div class="bw-blok-badge musthave">Must-have</div>
                                <div class="bw-blok-titel">@v.Tekst</div>
                                <div class="bw-blok-acties">
                                    <button type="button" class="btn btn-sm btn-default" data-bs-toggle="collapse" data-bs-target="#vereiste-panel-@v.ID">
                                        <i class="bx bx-pencil"></i> Bewerken
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger"
                                            onclick="if(confirm('Punt verwijderen?')) document.getElementById('del-vereiste-@v.ID').submit();">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="collapse" id="vereiste-panel-@v.ID">
                                <div class="bw-blok-edit-panel">
                                    <form method="post" action="@Url.Action("VereisteOpslaan")">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ID" value="@v.ID" />
                                        <input type="hidden" name="VacatureId" value="@Model.ID" />
                                        <input type="hidden" name="Categorie" value="@v.Categorie" />
                                        <div class="row g-3">
                                            <div class="col-md-9">
                                                <label class="form-label fw-semibold">Tekst <span class="text-danger">*</span></label>
                                                <input type="text" name="Tekst" value="@v.Tekst" class="form-control" maxlength="500" required />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label fw-semibold">Volgorde</label>
                                                <input type="number" name="SortOrder" value="@v.SortOrder" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="d-flex gap-2 mt-3">
                                            <button type="submit" class="btn btn-sm btn-primary"><i class="bx bx-save"></i> Opslaan</button>
                                            <button type="button" class="btn btn-sm btn-default" data-bs-toggle="collapse" data-bs-target="#vereiste-panel-@v.ID">Annuleren</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            <form id="del-vereiste-@v.ID" method="post" action="@Url.Action("VereisteVerwijderen")" style="display:none;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="vereisteId" value="@v.ID" />
                                <input type="hidden" name="vacatureId" value="@Model.ID" />
                            </form>
                        </div>
                    }
                </div>
                <div class="collapse mt-3" id="nieuwVereisteMustHavePanel">
                    <div class="bw-blok-edit-panel">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fw-semibold" style="font-size:14px;">Nieuwe must-have</span>
                            <button type="button" class="btn-close" aria-label="Sluiten" data-bs-toggle="collapse" data-bs-target="#nieuwVereisteMustHavePanel" style="font-size:12px;"></button>
                        </div>
                        <form method="post" action="@Url.Action("VereisteOpslaan")">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ID" value="0" />
                            <input type="hidden" name="VacatureId" value="@Model.ID" />
                            <input type="hidden" name="Categorie" value="MustHave" />
                            <div class="row g-3">
                                <div class="col-md-9">
                                    <label class="form-label fw-semibold">Tekst <span class="text-danger">*</span></label>
                                    <input type="text" name="Tekst" class="form-control" placeholder="Typ het punt..." maxlength="500" required />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">Volgorde</label>
                                    <input type="number" name="SortOrder" value="@(mustHaves.Any() ? mustHaves.Max(v => v.SortOrder) + 10 : 0)" class="form-control" />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary mt-3"><i class="bx bx-plus"></i> Toevoegen</button>
                        </form>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="bw-sublijst-titel">Mooi meegenomen</span>
                    <button type="button" class="btn btn-primary btn-sm" id="vereisteMooiNieuwBtn">
                        <i class="bx bx-plus"></i> Toevoegen
                    </button>
                </div>

                @{ var mooiItems = Model.VereisteItems.Where(v => v.Categorie == "MooiMeegenomen").OrderBy(v => v.SortOrder).ToList(); }
                @if (!mooiItems.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <p class="mb-0" style="font-size:14px;">Nog geen "mooi meegenomen"-punten.</p>
                    </div>
                }
                <div id="vereisteMooiLijst">
                    @foreach (var v in mooiItems)
                    {
                        <div class="bw-blok-wrap" data-id="@v.ID">
                            <div class="bw-blok-row">
                                <div class="bw-blok-grip" title="Sleep om volgorde te wijzigen"><i class="bx bx-grid"></i></div>
                                <div class="bw-blok-badge mooi">Mooi meegenomen</div>
                                <div class="bw-blok-titel">@v.Tekst</div>
                                <div class="bw-blok-acties">
                                    <button type="button" class="btn btn-sm btn-default" data-bs-toggle="collapse" data-bs-target="#vereiste-panel-@v.ID">
                                        <i class="bx bx-pencil"></i> Bewerken
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger"
                                            onclick="if(confirm('Punt verwijderen?')) document.getElementById('del-vereiste-@v.ID').submit();">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="collapse" id="vereiste-panel-@v.ID">
                                <div class="bw-blok-edit-panel">
                                    <form method="post" action="@Url.Action("VereisteOpslaan")">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ID" value="@v.ID" />
                                        <input type="hidden" name="VacatureId" value="@Model.ID" />
                                        <input type="hidden" name="Categorie" value="@v.Categorie" />
                                        <div class="row g-3">
                                            <div class="col-md-9">
                                                <label class="form-label fw-semibold">Tekst <span class="text-danger">*</span></label>
                                                <input type="text" name="Tekst" value="@v.Tekst" class="form-control" maxlength="500" required />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label fw-semibold">Volgorde</label>
                                                <input type="number" name="SortOrder" value="@v.SortOrder" class="form-control" />
