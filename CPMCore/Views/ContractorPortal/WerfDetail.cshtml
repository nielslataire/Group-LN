@model CPMCore.Models.ContractorPortal.ContractorWerfDetailVm
@using BOCore
@{
    ViewData["Title"] = Model.Name;
    var storageBase = Model.StorageBaseUrl?.TrimEnd('/');
    var totalAll = Model.OpenCount + Model.InProgressCount + Model.WaitingInspectionCount + Model.ResolvedCount;
    var resolvedPct = totalAll > 0 ? (int)Math.Round((decimal)Model.ResolvedCount / totalAll * 100) : 0;
}

<!-- ── Back + header ──────────────────────────────────────── -->
<a href="/Portaal/Werven" class="cp-detail-back">
    <i class="bx bx-arrow-back"></i> Mijn Werven
</a>
<h1 class="cp-detail-title">@Model.Name</h1>
@if (!string.IsNullOrWhiteSpace(Model.Address))
{
    <div class="cp-detail-addr"><i class="bx bx-map-pin"></i>@Model.Address</div>
}

<!-- ── Status KPIs ────────────────────────────────────────── -->
<div class="cp-status-grid">
    <div class="cp-status-box cp-status-box--red">
        <div class="cp-status-val">@Model.OpenCount</div>
        <div class="cp-status-lbl">Open</div>
    </div>
    <div class="cp-status-box cp-status-box--orange">
        <div class="cp-status-val">@Model.InProgressCount</div>
        <div class="cp-status-lbl">Bezig</div>
    </div>
    <div class="cp-status-box cp-status-box--blue">
        <div class="cp-status-val">@Model.WaitingInspectionCount</div>
        <div class="cp-status-lbl">Controle</div>
    </div>
    <div class="cp-status-box cp-status-box--green">
        <div class="cp-status-val">@Model.ResolvedCount</div>
        <div class="cp-status-lbl">Klaar</div>
    </div>
</div>

<!-- ── Progress bar ───────────────────────────────────────── -->
<div class="cp-prog-row">
    <div class="cp-prog-bar">
        <div class="cp-prog-fill" style="width:@resolvedPct%"></div>
    </div>
    <div class="cp-prog-pct">@Model.ResolvedCount/@totalAll</div>
</div>

<!-- ── Tabs (enkel punten zichtbaar) ─────────────────────── -->
<div class="cp-tabs">
    <a href="#punten" class="cp-tab active" data-tab="punten">
        <i class="bx bx-list-check"></i> Punten
        @{ var totalIssues = Model.IssueGroups.Sum(g => g.Issues.Count); }
        @if (totalIssues > 0)
        {
            <span class="cp-tab-badge">@totalIssues</span>
        }
    </a>
</div>

<!-- ── Issue list ────────────────────────────────────────── -->
<div id="tabPunten">
    @if (!Model.IssueGroups.Any())
    {
        <div class="cp-card" style="padding:2rem;text-align:center;">
            <i class="bx bx-check-circle" style="font-size:2.5rem;color:#3ecf8e;"></i>
            <p style="color:#6c757d;margin-top:.5rem;">Geen punten toegewezen aan u voor dit project.</p>
        </div>
    }
    else
    {
        @foreach (var group in Model.IssueGroups)
        {
            <div class="cp-issue-group">
                <div class="cp-issue-group-header" onclick="toggleGroup(this)">
                    <i class="bx bx-home-alt-2"></i>
                    @group.GroupName
                    <span class="cp-issue-count-badge">@group.Issues.Count</span>
                    <i class="bx bx-chevron-up cp-issue-group-chevron open"></i>
                </div>
                <div class="cp-issue-group-body">
                    @foreach (var issue in group.Issues)
                    {
                        var statusClass = issue.Status switch
                        {
                            (int)ConstructionIssueStatus.InProgress        => "cp-badge--prog",
                            (int)ConstructionIssueStatus.WaitingInspection => "cp-badge--check",
                            (int)ConstructionIssueStatus.Resolved          => "cp-badge--done",
                            (int)ConstructionIssueStatus.Rejected          => "cp-badge--reject",
                            (int)ConstructionIssueStatus.Reopened          => "cp-badge--reopen",
                            _                                               => "cp-badge--open"
                        };
                        var statusLabel = issue.Status switch
                        {
                            (int)ConstructionIssueStatus.InProgress        => "Gepland",
                            (int)ConstructionIssueStatus.WaitingInspection => "Controle",
                            (int)ConstructionIssueStatus.Resolved          => "Opgelost",
                            (int)ConstructionIssueStatus.Rejected          => "Afgekeurd",
                            (int)ConstructionIssueStatus.Reopened          => "Heropend",
                            _                                               => "Open"
                        };
                        var isHigh     = issue.Priority == (int)ConstructionIssuePriority.High;
                        var isPlanned  = issue.Status == (int)ConstructionIssueStatus.InProgress && issue.PlannedDate.HasValue;
                        var canResolve = issue.Status == (int)ConstructionIssueStatus.Open
                                      || issue.Status == (int)ConstructionIssueStatus.InProgress
                                      || issue.Status == (int)ConstructionIssueStatus.Reopened;

                        <div class="cp-issue" id="issue-@issue.Id">
                            <div class="cp-issue-summary" onclick="toggleIssue(@issue.Id)">
                                <div class="cp-issue-left">
                                    <div class="cp-issue-title">@issue.Title</div>

                                    @{
                                        var locParts = new List<string>();
                                        if (!string.IsNullOrWhiteSpace(issue.RoomOrZone)) locParts.Add(issue.RoomOrZone);
                                        if (!string.IsNullOrWhiteSpace(issue.LocationText)) locParts.Add(issue.LocationText);
                                        var locStr = string.Join(" – ", locParts);
                                    }
                                    @if (!string.IsNullOrWhiteSpace(locStr))
                                    {
                                        <div class="cp-issue-loc"><i class="bx bx-map-pin"></i>@locStr</div>
                                    }

                                    <div style="display:flex;flex-wrap:wrap;gap:.3rem;margin-top:.3rem;">
                                        @if (isPlanned)
                                        {
                                            <span class="cp-badge cp-badge--planned">
                                                <i class="bx bx-calendar" style="font-size:.8em;"></i>
                                                Gepland: @issue.PlannedDate!.Value.ToString("dd/MM/yyyy")
                                            </span>
                                        }
                                        @if (issue.DueDate.HasValue)
                                        {
                                            var deadlineClass = issue.IsOverdue ? "cp-badge--overdue" : "cp-badge--deadline";
                                            <span class="cp-badge @deadlineClass">
                                                <i class="bx bx-calendar-x" style="font-size:.8em;"></i>
                                                Deadline: @issue.DueDate.Value.ToString("dd/MM/yyyy")
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="cp-issue-right">
                                    <span class="cp-badge @statusClass">@statusLabel</span>
                                    @if (isHigh)
                                    {
                                        <span class="cp-badge cp-badge--urgent">Dringend</span>
                                    }
                                </div>
                            </div>

                            <div class="cp-issue-detail" id="detail-@issue.Id">
                                @if (!string.IsNullOrWhiteSpace(issue.Description))
                                {
                                    <div class="cp-issue-section-label" style="margin-top:.75rem;">Omschrijving</div>
                                    <p class="cp-issue-desc">@issue.Description</p>
                                }

                                <!-- Locatie details -->
                                @if (!string.IsNullOrWhiteSpace(locStr) || !string.IsNullOrWhiteSpace(issue.CategoryName))
                                {
                                    <div style="font-size:.8rem;color:#6c757d;margin-bottom:.5rem;display:flex;flex-wrap:wrap;gap:.75rem;">
                                        @if (!string.IsNullOrWhiteSpace(locStr))
                                        {
                                            <span><i class="bx bx-map-pin"></i> <strong>Locatie:</strong> @locStr</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(issue.CategoryName))
                                        {
                                            <span><i class="bx bx-category"></i> @issue.CategoryName</span>
                                        }
                                    </div>
                                }

                                <!-- Foto's -->
                                <div class="cp-issue-section-label">Foto's (@issue.MediaFileIds.Count)</div>
                                <div class="cp-photos-row" id="photos-@issue.Id">
                                    @if (!issue.MediaFileIds.Any())
                                    {
                                        <span class="cp-photo-empty" id="no-photos-@issue.Id">Geen foto's</span>
                                    }
                                    else
                                    {
                                        @foreach (var fileId in issue.MediaFileIds)
                                        {
                                            var safeFile = System.IO.Path.GetFileName(fileId);
                                            var url = $"{storageBase}/pictures/{Uri.EscapeDataString(safeFile)}";
                                            <img src="@url" class="cp-photo-thumb" alt="Foto"
                                                 onclick="openPhoto('@url')" loading="lazy" />
                                        }
                                    }
                                </div>

                                <!-- Locatie op plan -->
                                @if (issue.HasPlan)
                                {
                                    <div class="cp-issue-section-label">Locatie op plan</div>
                                    <div class="cp-plan-wrap" id="plan-wrap-@issue.Id">
                                        <img src="@issue.PlanImageUrl" class="cp-plan-img"
                                             id="plan-img-@issue.Id"
                                             onload="placePlanDot(@issue.Id, @issue.PlanXnormalized!.Value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture), @issue.PlanYnormalized!.Value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture))"
                                             alt="Plan" />
                                        <div class="cp-plan-dot" id="plan-dot-@issue.Id" style="display:none;"></div>
                                    </div>
                                }

                                <!-- Opmerkingen -->
                                <div class="cp-issue-section-label" style="margin-top:.75rem;">Opmerking toevoegen</div>
                                <div class="cp-comment-row">
                                    <textarea class="cp-comment-input" rows="2"
                                              placeholder="Schrijf een opmerking..."
                                              id="comment-@issue.Id"
                                              oninput="updateCommentBtn(@issue.Id)"></textarea>
                                    <button type="button" class="cp-photo-upload-btn"
                                            onclick="document.getElementById('photo-input-@issue.Id').click()"
                                            title="Foto toevoegen">
                                        <i class="bx bx-camera"></i>
                                    </button>
                                    <input type="file" id="photo-input-@issue.Id" accept="image/*"
                                           style="display:none"
                                           onchange="uploadPhoto(@issue.Id, @Model.ProjectId, this)" />
                                    <button type="button" class="cp-comment-send" disabled
                                            id="comment-btn-@issue.Id"
                                            onclick="sendComment(@issue.Id, @Model.ProjectId)"
                                            title="Versturen">
                                        <i class="bx bx-send"></i>
                                    </button>
                                </div>

                                @if (canResolve)
                                {
                                    <button type="button" class="cp-resolve-btn"
                                            id="resolve-btn-@issue.Id"
                                            onclick="resolveIssue(@issue.Id, @Model.ProjectId)">
                                        <i class="bx bx-check-circle"></i> Markeer als opgelost
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<!-- ── Lightbox ───────────────────────────────────────────── -->
<div id="cpLightbox" onclick="this.style.display='none'" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:9999;align-items:center;justify-content:center;">
    <img id="cpLightboxImg" src="" style="max-width:95vw;max-height:90vh;border-radius:8px;" />
</div>

@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<input type="hidden" id="cpAft" value="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

@section scripts {
<script>
    var antiforgeryToken = document.getElementById('cpAft')?.value ?? '';

    function toggleGroup(header) {
        var body = header.nextElementSibling;
        var chevron = header.querySelector('.cp-issue-group-chevron');
        var collapsed = body.style.display === 'none';
        body.style.display = collapsed ? '' : 'none';
        chevron.classList.toggle('open', collapsed);
    }

    function toggleIssue(id) {
        var detail = document.getElementById('detail-' + id);
        detail.classList.toggle('open');
    }

    function openPhoto(url) {
        var lb = document.getElementById('cpLightbox');
        document.getElementById('cpLightboxImg').src = url;
        lb.style.display = 'flex';
    }

    function updateCommentBtn(id) {
        var textarea = document.getElementById('comment-' + id);
        var btn = document.getElementById('comment-btn-' + id);
        if (btn) btn.disabled = !textarea || !textarea.value.trim();
    }

    function sendComment(issueId, projectId) {
        var textarea = document.getElementById('comment-' + issueId);
        var text = textarea ? textarea.value.trim() : '';
        if (!text) return;

        var btn = document.getElementById('comment-btn-' + issueId);
        if (btn) { btn.disabled = true; }

        fetch('/Portaal/Werven/' + projectId + '/Issues/' + issueId + '/Comment', {
            method: 'POST',
            headers: {
                'RequestVerificationToken': antiforgeryToken,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ comment: text })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.ok) {
                textarea.value = '';
                textarea.placeholder = 'Opmerking verstuurd ✓';
                setTimeout(function() { textarea.placeholder = 'Schrijf een opmerking...'; }, 2500);
            } else {
                alert(data.error || 'Versturen mislukt.');
                if (btn) btn.disabled = false;
            }
        })
        .catch(function() {
            if (btn) btn.disabled = false;
        });
    }

    function uploadPhoto(issueId, projectId, input) {
        if (!input.files || !input.files[0]) return;
        var file = input.files[0];
        var formData = new FormData();
        formData.append('file', file);

        var btn = document.querySelector('#detail-' + issueId + ' .cp-photo-upload-btn');
        if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i>'; }

        fetch('/Portaal/Werven/' + projectId + '/Issues/' + issueId + '/UploadPhoto', {
            method: 'POST',
            headers: { 'RequestVerificationToken': antiforgeryToken },
            body: formData
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.ok) {
                var row = document.getElementById('photos-' + issueId);
                var noPhotos = document.getElementById('no-photos-' + issueId);
                if (noPhotos) noPhotos.remove();
                var img = document.createElement('img');
                img.src = data.url;
                img.className = 'cp-photo-thumb';
                img.alt = 'Foto';
                img.loading = 'lazy';
                img.onclick = function() { openPhoto(data.url); };
                row.appendChild(img);
            } else {
                alert(data.error || 'Upload mislukt.');
            }
        })
        .catch(function() { alert('Upload mislukt.'); })
        .finally(function() {
            if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bx bx-camera"></i>'; }
            input.value = '';
        });
    }

    function resolveIssue(issueId, projectId) {
        var btn = document.getElementById('resolve-btn-' + issueId);
        if (!btn || btn.disabled) return;
        btn.disabled = true;
        btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Bezig…';

        fetch('/Portaal/Werven/' + projectId + '/Issues/' + issueId + '/Resolve', {
            method: 'POST',
            headers: { 'RequestVerificationToken': antiforgeryToken, 'Content-Type': 'application/json' }
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.ok) {
                btn.innerHTML = '<i class="bx bx-check-circle"></i> Klaar voor controle';
                btn.style.background = '#2563eb';
                var summary = document.querySelector('#issue-' + issueId + ' .cp-issue-right');
                if (summary) {
                    var badge = summary.querySelector('.cp-badge');
                    if (badge) { badge.className = 'cp-badge cp-badge--check'; badge.textContent = 'Controle'; }
                }
            } else {
                btn.disabled = false;
                btn.innerHTML = '<i class="bx bx-check-circle"></i> Markeer als opgelost';
                alert(data.error || 'Er is een fout opgetreden.');
            }
        })
        .catch(function() {
            btn.disabled = false;
            btn.innerHTML = '<i class="bx bx-check-circle"></i> Markeer als opgelost';
        });
    }

    function placePlanDot(issueId, xNorm, yNorm) {
        var img = document.getElementById('plan-img-' + issueId);
        var dot = document.getElementById('plan-dot-' + issueId);
        if (!img || !dot) return;
        dot.style.left = (xNorm * 100) + '%';
        dot.style.top  = (yNorm * 100) + '%';
        dot.style.display = 'block';
    }
</script>
}
