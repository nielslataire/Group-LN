@model CPMCore.Models.ContractorPortal.ContractorWerfDetailVm
@using BOCore
@{
    ViewData["Title"] = Model.Name;
    var storageBase = Model.StorageBaseUrl?.TrimEnd('/');
    var totalAll = Model.OpenCount + Model.InProgressCount + Model.WaitingInspectionCount + Model.ResolvedCount;
    var resolvedPct = totalAll > 0 ? (int)Math.Round((decimal)Model.ResolvedCount / totalAll * 100) : 0;
}

<!-- ── Back + header ──────────────────────────────────────── -->
<a href="/Werfportaal/Werven" class="gl-cp-detail-back">
    <i class="bx bx-arrow-back"></i> Mijn Werven
</a>
<h1 class="gl-cp-detail-title">@Model.Name</h1>
@if (!string.IsNullOrWhiteSpace(Model.Address))
{
    <div class="gl-cp-detail-addr"><i class="bx bx-map-pin"></i>@Model.Address</div>
}

<!-- ── Status KPIs ────────────────────────────────────────── -->
<div class="gl-cp-status-grid">
    <div class="gl-cp-status-box gl-cp-status-box--red">
        <div class="gl-cp-status-val" id="kpi-open">@Model.OpenCount</div>
        <div class="gl-cp-status-lbl">Open</div>
    </div>
    <div class="gl-cp-status-box gl-cp-status-box--orange">
        <div class="gl-cp-status-val" id="kpi-inprogress">@Model.InProgressCount</div>
        <div class="gl-cp-status-lbl">Bezig</div>
    </div>
    <div class="gl-cp-status-box gl-cp-status-box--blue">
        <div class="gl-cp-status-val" id="kpi-waiting">@Model.WaitingInspectionCount</div>
        <div class="gl-cp-status-lbl">Controle</div>
    </div>
    <div class="gl-cp-status-box gl-cp-status-box--green">
        <div class="gl-cp-status-val" id="kpi-resolved">@Model.ResolvedCount</div>
        <div class="gl-cp-status-lbl">Klaar</div>
    </div>
</div>

<!-- ── Progress bar ───────────────────────────────────────── -->
<div class="gl-cp-prog-row">
    <div class="gl-cp-prog-bar">
        <div class="gl-cp-prog-fill" id="prog-fill" style="--gl-fill-width:@resolvedPct%"></div>
    </div>
    <div class="gl-cp-prog-pct" id="prog-label">@Model.ResolvedCount/@totalAll</div>
</div>

<!-- ── Tabs (enkel punten zichtbaar) ─────────────────────── -->
<div class="gl-cp-tabs">
    <a href="#punten" class="gl-cp-tab active" data-tab="punten">
        <i class="bx bx-list-check"></i> Punten
        @{ var totalIssues = Model.IssueGroups.Sum(g => g.Issues.Count); }
        @if (totalIssues > 0)
        {
            <span class="gl-cp-tab-badge">@totalIssues</span>
        }
    </a>
</div>

<!-- ── Search + filter tabs ──────────────────────────────── -->
<div class="gl-cp-issue-toolbar">
    <div class="gl-cp-issue-search-wrap">
        <i class="bx bx-search gl-cp-issue-search-icon"></i>
        <input type="text" id="issueSearch" class="gl-cp-issue-search" placeholder="Zoek punt..." oninput="filterIssues()" />
    </div>
    <div class="gl-cp-issue-filter-tabs" id="issueFilterTabs">
        <button class="gl-cp-filter-tab active" data-filter="active" onclick="setFilter(this,'active')">Alle</button>
        <button class="gl-cp-filter-tab" data-filter="open"    onclick="setFilter(this,'open')">Open</button>
        <button class="gl-cp-filter-tab" data-filter="bezig"   onclick="setFilter(this,'bezig')">Bezig</button>
        <button class="gl-cp-filter-tab" data-filter="controle" onclick="setFilter(this,'controle')">Controle</button>
        <button class="gl-cp-filter-tab" data-filter="klaar"   onclick="setFilter(this,'klaar')">Klaar</button>
    </div>
</div>

<!-- ── Issue list ────────────────────────────────────────── -->
<div id="tabPunten">
    @if (!Model.IssueGroups.Any())
    {
        <div class="gl-cp-card gl-cp-empty-state">
            <i class="bx bx-check-circle gl-cp-empty-icon--done"></i>
            <p class="gl-cp-empty-text">Geen punten toegewezen aan u voor dit project.</p>
        </div>
    }
    else
    {
        @foreach (var group in Model.IssueGroups)
        {
            <div class="gl-cp-issue-group" data-group>
                <div class="gl-cp-issue-group-header" onclick="toggleGroup(this)">
                    <i class="bx bx-home-alt-2"></i>
                    @group.GroupName
                    <span class="gl-cp-issue-count-badge">@group.Issues.Count</span>
                    <i class="bx bx-chevron-up gl-cp-issue-group-chevron open"></i>
                </div>
                <div class="gl-cp-issue-group-body">
                    @foreach (var issue in group.Issues)
                    {
                        var statusClass = issue.Status switch
                        {
                            (int)ConstructionIssueStatus.InProgress        => "gl-cp-badge--prog",
                            (int)ConstructionIssueStatus.WaitingInspection => "gl-cp-badge--check",
                            (int)ConstructionIssueStatus.Resolved          => "gl-cp-badge--done",
                            (int)ConstructionIssueStatus.Rejected          => "gl-cp-badge--reject",
                            (int)ConstructionIssueStatus.Reopened          => "gl-cp-badge--reopen",
                            _                                               => "gl-cp-badge--open"
                        };
                        var statusLabel = issue.Status switch
                        {
                            (int)ConstructionIssueStatus.InProgress        => "Gepland",
                            (int)ConstructionIssueStatus.WaitingInspection => "Controle",
                            (int)ConstructionIssueStatus.Resolved          => "Opgelost",
                            (int)ConstructionIssueStatus.Rejected          => "Afgekeurd",
                            (int)ConstructionIssueStatus.Reopened          => "Heropend",
                            _                                               => "Open"
                        };
                        var isHigh     = issue.Priority == (int)ConstructionIssuePriority.High;
                        var isPlanned  = issue.Status == (int)ConstructionIssueStatus.InProgress && issue.PlannedDate.HasValue;
                        var canResolve = issue.Status == (int)ConstructionIssueStatus.Open
                                      || issue.Status == (int)ConstructionIssueStatus.InProgress
                                      || issue.Status == (int)ConstructionIssueStatus.Reopened;
                        var prevStatusIsOpen = issue.Status == (int)ConstructionIssueStatus.Open
                                           || issue.Status == (int)ConstructionIssueStatus.Reopened;

                        <div class="gl-cp-issue" id="issue-@issue.Id"
                             data-prev-status="@(prevStatusIsOpen ? "open" : "inprogress")"
                             data-status="@issue.Status"
                             data-title="@(issue.Title ?? "")">
                            <div class="gl-cp-issue-summary" onclick="toggleIssue(@issue.Id)">
                                <div class="gl-cp-issue-left">
                                    <div class="gl-cp-issue-title">@issue.Title</div>

                                    @{
                                        var locParts = new List<string>();
                                        if (!string.IsNullOrWhiteSpace(issue.RoomOrZone)) locParts.Add(issue.RoomOrZone);
                                        if (!string.IsNullOrWhiteSpace(issue.LocationText)) locParts.Add(issue.LocationText);
                                        var locStr = string.Join(" – ", locParts);
                                    }
                                    @if (!string.IsNullOrWhiteSpace(locStr))
                                    {
                                        <div class="gl-cp-issue-loc"><i class="bx bx-map-pin"></i>@locStr</div>
                                    }

                                    <div class="gl-cp-badges-row">
                                        @if (isPlanned)
                                        {
                                            <span class="gl-cp-badge gl-cp-badge--planned">
                                                <i class="bx bx-calendar gl-cp-icon-sm"></i>
                                                Gepland: @issue.PlannedDate!.Value.ToString("dd/MM/yyyy")
                                            </span>
                                        }
                                        @if (issue.DueDate.HasValue)
                                        {
                                            var deadlineClass = issue.IsOverdue ? "gl-cp-badge--overdue" : "gl-cp-badge--deadline";
                                            <span class="gl-cp-badge @deadlineClass">
                                                <i class="bx bx-calendar-x gl-cp-icon-sm"></i>
                                                Deadline: @issue.DueDate.Value.ToString("dd/MM/yyyy")
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="gl-cp-issue-right">
                                    <span class="gl-cp-badge @statusClass" id="status-badge-@issue.Id">@statusLabel</span>
                                    @if (isHigh)
                                    {
                                        <span class="gl-cp-badge gl-cp-badge--urgent">Dringend</span>
                                    }
                                </div>
                            </div>

                            <div class="gl-cp-issue-detail" id="detail-@issue.Id">
                                @if (!string.IsNullOrWhiteSpace(issue.Description))
                                {
                                    <p class="gl-cp-issue-desc">@issue.Description</p>
                                }

                                <!-- Locatie details -->
                                @if (!string.IsNullOrWhiteSpace(locStr) || !string.IsNullOrWhiteSpace(issue.CategoryName))
                                {
                                    <div class="gl-cp-meta-row">
                                        @if (!string.IsNullOrWhiteSpace(locStr))
                                        {
                                            <strong>Locatie:</strong> @locStr
                                        }
                                    </div>
                                }

                                <!-- Foto's -->

                                @if (!issue.MediaFileIds.Any())
                                {
                                    
                                }
                                else
                                {
                                <div class="gl-cp-issue-section-label">Foto's (@issue.MediaFileIds.Count)</div>
                                <div class="gl-cp-photos-row" id="photos-@issue.Id">
                                        @foreach (var fileId in issue.MediaFileIds)
                                        {
                                            var safeFile = System.IO.Path.GetFileName(fileId);
                                            var url = $"{storageBase}/pictures/{Uri.EscapeDataString(safeFile)}";
                                            <img src="@url" class="gl-cp-photo-thumb" alt="Foto"
                                                 onclick="openPhoto('@url')" loading="lazy" />
                                        }     
                                </div>
                                }

                                <!-- Locatie op plan -->
                                @if (issue.HasPlan)
                                {
                                    <div class="gl-cp-issue-section-label">Locatie op plan</div>
                                    <div class="gl-cp-plan-wrap" id="plan-wrap-@issue.Id"
                                         data-plan-url="@issue.PlanImageUrl"
                                         data-plan-x="@issue.PlanXnormalized!.Value.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)"
                                         data-plan-y="@issue.PlanYnormalized!.Value.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture)"
                                         data-plan-page="@(issue.PlanPageNumber ?? 1)">
                                        <canvas id="plan-canvas-@issue.Id" class="gl-cp-plan-canvas"></canvas>
                                        <div id="plan-marker-@issue.Id" class="gl-cp-plan-marker"><i class="fa fa-location-dot"></i></div>
                                    </div>
                                }

                                <!-- Communicatie -->
                                @if (!issue.Comments.Any())
                                {
                                }
                                else
                                {
                                <div class="gl-cp-issue-section-label gl-cp-mt-sm">Communicatie</div>
                                <div class="gl-cp-comm-list" id="comm-list-@issue.Id">

                                    @foreach (var comment in issue.Comments)
                                    {
                                        var entryClass = comment.IsContractor ? "gl-cp-comm-entry gl-cp-comm-entry--contractor" : "gl-cp-comm-entry gl-cp-comm-entry--internal";
                                        <div class="@entryClass">
                                            <div class="gl-cp-comm-meta">
                                                <span class="gl-cp-comm-author">@comment.AuthorName</span>
                                                <span class="gl-cp-comm-time">@comment.Timestamp.ToString("dd/MM/yyyy HH:mm")</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(comment.Text))
                                            {
                                                <div class="gl-cp-comm-text">@comment.Text</div>
                                            }
                                            @if (comment.PhotoUrls.Any())
                                            {
                                                <div class="gl-cp-photos-row gl-cp-photos-row--comment">
                                                    @foreach (var photoUrl in comment.PhotoUrls)
                                                    {
                                                        <img src="@photoUrl" class="gl-cp-photo-thumb"
                                                             onclick="openPhoto('@photoUrl')" loading="lazy" alt="Foto" />
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                                 }
                                <!-- Opmerking toevoegen -->
                                <div class="gl-cp-issue-section-label gl-cp-mt-sm">Opmerking toevoegen</div>
                                <div class="gl-cp-comment-row">
                                    <textarea class="gl-cp-comment-input" rows="3"
                                              placeholder="Schrijf een opmerking..."
                                              id="comment-@issue.Id"
                                              oninput="updateCommentBtn(@issue.Id)"></textarea>
                                    <div class="gl-cp-comment-photo-col">
                                        <input type="file" id="photo-input-@issue.Id" accept="image/*"
                                               multiple class="gl-cp-hidden"
                                               onchange="selectPhotos(@issue.Id, this)" />
                                        <button type="button" class="gl-cp-photo-add-tile"
                                                onclick="document.getElementById('photo-input-@issue.Id').click()"
                                                id="photo-tile-@issue.Id">
                                            <i class="bx bx-camera gl-cp-icon-lg"></i>
                                            <span class="gl-cp-icon-label">Toevoegen</span>
                                        </button>
                                        <div class="gl-cp-photo-thumbs-col" id="photo-thumbs-@issue.Id"></div>
                                    </div>
                                    <button type="button" class="gl-cp-comment-send" disabled
                                            id="comment-btn-@issue.Id"
                                            onclick="sendComment(@issue.Id, @Model.ProjectId)"
                                            title="Versturen">
                                        <i class="bx bx-send"></i>
                                    </button>
                                </div>

                                @if (canResolve)
                                {
                                    <button type="button" class="gl-cp-resolve-btn"
                                            id="resolve-btn-@issue.Id"
                                            onclick="resolveIssue(@issue.Id, @Model.ProjectId)">
                                        <i class="bx bx-check-circle"></i> Markeer als opgelost
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<!-- ── Lightbox ───────────────────────────────────────────── -->
<div id="cpLightbox" class="gl-cp-lightbox">
    <img id="cpLightboxImg" src="" class="gl-cp-lightbox-img" alt="Foto" />
</div>

@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<input type="hidden" id="cpAft" value="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

@section PageScripts {
<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script>
    var antiforgeryToken = document.getElementById('cpAft')?.value ?? '';

    // ── PDF.js setup ──────────────────────────────────────
    var pdfJsApi = window.pdfjsLib || window['pdfjs-dist/build/pdf'] || null;
    if (pdfJsApi) {
        pdfJsApi.GlobalWorkerOptions.workerSrc = 'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';
    }

    // Pending photos per issue (array of File objects, not yet uploaded)
    var pendingPhotos = {};   // issueId → File[]
    var pendingPreviews = {}; // issueId → dataURL[]

    function toggleGroup(header) {
        var body = header.nextElementSibling;
        var chevron = header.querySelector('.gl-cp-issue-group-chevron');
        var collapsed = body.style.display === 'none';
        body.style.display = collapsed ? '' : 'none';
        chevron.classList.toggle('open', collapsed);
    }

    function toggleIssue(id) {
        var detail = document.getElementById('detail-' + id);
        detail.classList.toggle('open');
        if (detail.classList.contains('open')) {
            // requestAnimationFrame zodat het element zichtbaar is vóór renderen
            requestAnimationFrame(function() { renderPlanForIssue(id); });
        }
    }

    document.getElementById('cpLightbox').addEventListener('click', function () {
        this.classList.remove('open');
    });

    function openPhoto(url) {
        var lb = document.getElementById('cpLightbox');
        document.getElementById('cpLightboxImg').src = url;
        lb.classList.add('open');
    }

    function escapeHtml(str) {
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // Called when user selects one or more photos
    function selectPhotos(issueId, input) {
        if (!input.files || !input.files.length) return;
        if (!pendingPhotos[issueId]) pendingPhotos[issueId] = [];
        if (!pendingPreviews[issueId]) pendingPreviews[issueId] = [];

        Array.from(input.files).forEach(function(file) {
            pendingPhotos[issueId].push(file);
            var reader = new FileReader();
            reader.onload = function(e) {
                pendingPreviews[issueId].push(e.target.result);
                renderPhotoThumbs(issueId);
            };
            reader.readAsDataURL(file);
        });
        input.value = ''; // allow re-selecting same file
        updateCommentBtn(issueId);
    }

    function renderPhotoThumbs(issueId) {
        var container = document.getElementById('photo-thumbs-' + issueId);
        if (!container) return;
        var previews = pendingPreviews[issueId] || [];
        container.innerHTML = previews.map(function(src, idx) {
            return '<div class="gl-cp-photo-wrap">'
                + '<img src="' + escapeHtml(src) + '" class="gl-cp-photo-thumb gl-cp-photo-thumb--preview" alt="preview" />'
                + '<button type="button" class="gl-cp-photo-remove-btn" onclick="removePhoto(' + issueId + ',' + idx + ')">✕</button>'
                + '</div>';
        }).join('');
    }

    function removePhoto(issueId, idx) {
        if (pendingPhotos[issueId]) pendingPhotos[issueId].splice(idx, 1);
        if (pendingPreviews[issueId]) pendingPreviews[issueId].splice(idx, 1);
        renderPhotoThumbs(issueId);
        updateCommentBtn(issueId);
    }

    function updateCommentBtn(id) {
        var textarea = document.getElementById('comment-' + id);
        var btn = document.getElementById('comment-btn-' + id);
        var hasPhotos = (pendingPhotos[id] || []).length > 0;
        if (btn) btn.disabled = !(textarea && textarea.value.trim()) && !hasPhotos;
    }

    async function sendComment(issueId, projectId) {
        var textarea = document.getElementById('comment-' + issueId);
        var text = textarea ? textarea.value.trim() : '';
        var files = pendingPhotos[issueId] || [];
        if (!text && !files.length) return;

        var btn = document.getElementById('comment-btn-' + issueId);
        if (btn) btn.disabled = true;

        // Upload all pending photos
        var uploadedUrls = [];
        for (var i = 0; i < files.length; i++) {
            var formData = new FormData();
            formData.append('file', files[i]);
            try {
                var uploadResp = await fetch('/Werfportaal/Werven/' + projectId + '/Issues/' + issueId + '/UploadPhoto', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': antiforgeryToken },
                    body: formData
                });
                var uploadData = await uploadResp.json();
                if (uploadData.ok) {
                    uploadedUrls.push(uploadData.url);
                } else {
                    alert(uploadData.error || 'Foto upload mislukt.');
                    if (btn) btn.disabled = false;
                    return;
                }
            } catch (e) {
                alert('Foto upload mislukt.');
                if (btn) btn.disabled = false;
                return;
            }
        }

        // Send comment with all photo URLs
        try {
            var resp = await fetch('/Werfportaal/Werven/' + projectId + '/Issues/' + issueId + '/Comment', {
                method: 'POST',
                headers: { 'RequestVerificationToken': antiforgeryToken, 'Content-Type': 'application/json' },
                body: JSON.stringify({ comment: text, photoUrls: uploadedUrls })
            });
            var data = await resp.json();
            if (data.ok) {
                // Clear form
                if (textarea) { textarea.value = ''; textarea.placeholder = 'Opmerking verstuurd ✓'; }
                setTimeout(function() { if (textarea) textarea.placeholder = 'Schrijf een opmerking...'; }, 2500);

                // Clear photos
                pendingPhotos[issueId] = [];
                pendingPreviews[issueId] = [];
                renderPhotoThumbs(issueId);

                // Add comment to communicatie list
                var commList = document.getElementById('comm-list-' + issueId);
                if (commList) {
                    var emptyMsg = commList.querySelector('.gl-cp-comm-empty');
                    if (emptyMsg) emptyMsg.remove();
                    var now = new Date();
                    var pad = function(n) { return n.toString().padStart(2, '0'); };
                    var dateStr = pad(now.getDate()) + '/' + pad(now.getMonth()+1) + '/' + now.getFullYear()
                                + ' ' + pad(now.getHours()) + ':' + pad(now.getMinutes());
                    var entry = document.createElement('div');
                    entry.className = 'gl-cp-comm-entry gl-cp-comm-entry--contractor';
                    var html = '<div class="gl-cp-comm-meta"><span class="gl-cp-comm-author">U</span><span class="gl-cp-comm-time">' + escapeHtml(dateStr) + '</span></div>';
                    if (text) html += '<div class="gl-cp-comm-text">' + escapeHtml(text) + '</div>';
                    if (uploadedUrls.length) {
                        html += '<div class="gl-cp-photos-row gl-cp-photos-row--comment">';
                        uploadedUrls.forEach(function(u) {
                            html += '<img src="' + escapeHtml(u) + '" class="gl-cp-photo-thumb" onclick="openPhoto(\'' + escapeHtml(u) + '\')" loading="lazy" alt="Foto" />';
                        });
                        html += '</div>';
                    }
                    entry.innerHTML = html;
                    commList.appendChild(entry);
                }

                if (btn) btn.disabled = false;
            } else {
                alert(data.error || 'Versturen mislukt.');
                if (btn) btn.disabled = false;
            }
        } catch (e) {
            if (btn) btn.disabled = false;
        }
    }

    function resolveIssue(issueId, projectId) {
        var btn = document.getElementById('resolve-btn-' + issueId);
        if (!btn || btn.disabled) return;
        btn.disabled = true;
        btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> Bezig…';

        fetch('/Werfportaal/Werven/' + projectId + '/Issues/' + issueId + '/Resolve', {
            method: 'POST',
            headers: { 'RequestVerificationToken': antiforgeryToken, 'Content-Type': 'application/json' }
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.ok) {
                // Update status badge
                var badge = document.getElementById('status-badge-' + issueId);
                if (badge) { badge.className = 'gl-cp-badge gl-cp-badge--check'; badge.textContent = 'Controle'; }

                // Update resolve button
                btn.innerHTML = '<i class="bx bx-check-circle"></i> Klaar voor controle';
                btn.classList.add('gl-cp-resolve-btn--done');

                // Update KPI boxes: decrement open or inprogress, increment waiting
                var issueEl = document.getElementById('issue-' + issueId);
                var prevStatus = issueEl ? issueEl.dataset.prevStatus : 'open';
                if (prevStatus === 'open') {
                    var openVal = document.getElementById('kpi-open');
                    if (openVal) { var n = parseInt(openVal.textContent) - 1; openVal.textContent = Math.max(0, isNaN(n) ? 0 : n); }
                } else {
                    var inprogVal = document.getElementById('kpi-inprogress');
                    if (inprogVal) { var m = parseInt(inprogVal.textContent) - 1; inprogVal.textContent = Math.max(0, isNaN(m) ? 0 : m); }
                }
                var waitingVal = document.getElementById('kpi-waiting');
                if (waitingVal) { var w = parseInt(waitingVal.textContent) + 1; if (!isNaN(w)) waitingVal.textContent = w; }
            } else {
                btn.disabled = false;
                btn.innerHTML = '<i class="bx bx-check-circle"></i> Markeer als opgelost';
                alert(data.error || 'Er is een fout opgetreden.');
            }
        })
        .catch(function() {
            btn.disabled = false;
            btn.innerHTML = '<i class="bx bx-check-circle"></i> Markeer als opgelost';
        });
    }

    async function renderPlanForIssue(issueId) {
        var wrap = document.getElementById('plan-wrap-' + issueId);
        var canvas = document.getElementById('plan-canvas-' + issueId);
        var marker = document.getElementById('plan-marker-' + issueId);
        if (!wrap || !canvas || !marker) return;
        if (canvas.dataset.rendered === '1') return;
        canvas.dataset.rendered = '1';

        var url = wrap.dataset.planUrl;
        var xNorm = parseFloat(wrap.dataset.planX);
        var yNorm = parseFloat(wrap.dataset.planY);
        var pageNumber = parseInt(wrap.dataset.planPage) || 1;
        if (!url || !pdfJsApi) return;

        try {
            var pdfDoc = await pdfJsApi.getDocument(url).promise;
            var safePage = Math.min(Math.max(1, pageNumber), pdfDoc.numPages || 1);
            var pdfPage = await pdfDoc.getPage(safePage);
            var baseViewport = pdfPage.getViewport({ scale: 1 });
            var containerWidth = wrap.clientWidth || 400;
            var maxHeight = 400;
            var scale = Math.min(containerWidth / baseViewport.width, maxHeight / baseViewport.height, 1);
            var viewport = pdfPage.getViewport({ scale: scale });

            canvas.width  = Math.floor(viewport.width);
            canvas.height = Math.floor(viewport.height);
            canvas.style.width  = Math.floor(viewport.width)  + 'px';
            canvas.style.height = Math.floor(viewport.height) + 'px';

            await pdfPage.render({ canvasContext: canvas.getContext('2d'), viewport: viewport }).promise;

            if (Number.isFinite(xNorm) && Number.isFinite(yNorm)) {
                var rect       = canvas.getBoundingClientRect();
                var parentRect = canvas.parentElement.getBoundingClientRect();
                marker.style.left    = ((rect.left - parentRect.left) + xNorm * rect.width)  + 'px';
                marker.style.top     = ((rect.top  - parentRect.top)  + yNorm * rect.height) + 'px';
                marker.style.display = 'block';
            }
        } catch(e) {
            console.warn('Plan renderen mislukt voor issue ' + issueId, e);
        }
    }

    // ── Search + filter ──────────────────────────────────────
    // Status mappings: 0=Open,2=InProgress/Bezig,3=WaitingInspection/Controle,
    //                  4=Resolved,6=Rejected,7=Reopened
    var activeFilter = 'active'; // default: all active (not resolved/rejected)

    function setFilter(btn, filter) {
        activeFilter = filter;
        document.querySelectorAll('.gl-cp-filter-tab').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        filterIssues();
    }

    function filterIssues() {
        var search = (document.getElementById('issueSearch')?.value || '').toLowerCase().trim();
        var groups = document.querySelectorAll('[data-group]');
        groups.forEach(function(group) {
            var issues = group.querySelectorAll('.gl-cp-issue');
            var anyVisible = false;
            issues.forEach(function(issue) {
                var status = parseInt(issue.dataset.status ?? '-1');
                var title  = (issue.dataset.title || '').toLowerCase();
                var passFilter = matchesFilter(status, activeFilter);
                var passSearch = !search || title.includes(search);
                var visible = passFilter && passSearch;
                issue.style.display = visible ? '' : 'none';
                if (visible) anyVisible = true;
            });
            group.style.display = anyVisible ? '' : 'none';
        });
    }

    function matchesFilter(status, filter) {
        switch (filter) {
            case 'active':   return status !== 4 && status !== 6; // hide resolved+rejected
            case 'open':     return status === 0 || status === 7;
            case 'bezig':    return status === 2;
            case 'controle': return status === 3;
            case 'klaar':    return status === 4 || status === 6;
            default:         return true;
        }
    }

    // Apply default filter on load
    filterIssues();
</script>
}
