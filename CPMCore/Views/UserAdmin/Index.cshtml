@model IEnumerable<CPMCore.Models.UserListItemViewModel>
@{
    ViewData["Title"] = "Gebruikers beheren";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="card">
    <header class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h2 class="card-title mb-0">Gebruikersbeheer</h2>
            <p class="card-subtitle">Bekijk en beheer accounts en hun rollen.</p>
        </div>
    </header>
    <div class="card-body">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">@TempData["Message"]</div>
        }
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th>Naam</th>
                        <th>Gebruikersnaam</th>
                        <th>Email</th>
                        <th>Rollen</th>
                        <th class="text-end">Acties</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.DisplayName</td>
                            <td>@user.UserName</td>
                            <td>@user.Email</td>
                            <td>
                                @if (user.Roles.Any())
                                {
                                    <span class="badge bg-secondary">@string.Join(", ", user.Roles)</span>
                                }
                                else
                                {
                                    <span class="text-muted">Geen rol</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-primary" href="@Url.Action("Edit", new { id = user.Id })"><i class="bx bx-edit"></i> Bewerken</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>