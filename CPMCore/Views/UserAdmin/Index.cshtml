@model CPMCore.Models.UserAdminIndexViewModel
@{
    ViewData["Title"] = "Gebruikers beheren";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .invoice-tab-nav {
        background-color: #f3f5f7;
        border-radius: 6px;
        padding: 6px;
        gap: 4px;
    }

        .invoice-tab-nav .nav-link {
            color: #6c757d;
            font-weight: 600;
            border-radius: 6px;
            border: 1px solid transparent;
            padding: 10px 16px;
        }

            .invoice-tab-nav .nav-link.active {
                background-color: #ffffff;
                color: #1f2d3d;
                border-color: #e3e6ea;
                box-shadow: 0 1px 1px rgba(0, 0, 0, 0.05);
            }
</style>

<div class="row">
    <div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
        <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
            <h1 class="font-weight-bold mb-0 mt-0">Gebruikersbeheer</h1>
            <h5 class="mb-4 mt-0">Beheer CPMCore-gebruikers, rollen en Entra-koppelingen.</h5>
        </div>
        <div class="col-sm-auto px-0">
            <a href="@Url.Action("Create", "UserAdmin")" class="btn btn-primary btn-md px-3" title="Gebruiker toevoegen">
                <i class="fa fa-user-plus me-2"></i>Gebruiker toevoegen
            </a>
        </div>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<ul class="nav nav-pills invoice-tab-nav mb-4" role="tablist">
    <li class="nav-item">
        <a class="nav-link active" href="#" data-useradmin-section="gebruikers">Gebruikers</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="#" data-useradmin-section="entra">Entra-gebruikers</a>
    </li>
</ul>

<div id="useradmin-gebruikers-section" class="useradmin-section">
    <section class="card">
        <header class="card-header">
            <h2 class="card-title mb-0">Gebruikers</h2>
        </header>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Naam</th>
                            <th>Gebruikersnaam</th>
                            <th>Email</th>
                            <th>Entra gekoppeld</th>
                            <th>Entra Object ID</th>
                            <th>Rollen</th>
                            <th>Status</th>
                            <th class="text-end">Acties</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.LocalUsers)
                        {
                            <tr>
                                <td>@user.DisplayName</td>
                                <td>@user.UserName</td>
                                <td>@user.Email</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(user.EntraObjectId))
                                    {
                                        <span class="badge bg-success">Ja</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Nee</span>
                                    }
                                </td>
                                <td class="small text-muted">@user.EntraObjectId</td>
                                <td>
                                    @if (user.Permissions.Any())
                                    {
                                        <span class="badge bg-secondary">@string.Join(", ", user.Permissions)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Geen rol</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Actief</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactief</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a class="ms-1 me-1" data-placement="top" title="Bewerken" data-original-title="Bewerken" href="@Url.Action("Edit", new { id = user.Id })">
                                        <i class="bx bx-pencil fs-5"></i>
                                        <span class="visually-hidden">Bewerken</span>
                                    </a>
                                    <a href="#modaldeleteuser" data-toggle="tooltip" data-placement="top" title="Verwijderen" data-original-title="Verwijderen" class="deleteUser ms-1 me-1" data-id="@user.Id">
                                        <i class="bx bx-trash fs-5 text-danger"></i>
                                        <span class="visually-hidden">Verwijderen</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

<div id="useradmin-entra-section" class="useradmin-section d-none">
    <section class="card">
        <header class="card-header">
            <h2 class="card-title mb-0">Entra gebruikers</h2>
            <p class="card-subtitle">Overzicht van accounts in Microsoft Entra ID.</p>
        </header>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Naam</th>
                            <th>Email</th>
                            <th>UPN</th>
                            <th>Object ID</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.EntraUsers)
                        {
                            <tr>
                                <td>@user.DisplayName</td>
                                <td>@user.Email</td>
                                <td>@user.UserPrincipalName</td>
                                <td class="small text-muted">@user.Id</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

<div id="modaldeleteuser" class="modal-block modal-block-warning mfp-hide">
    <div id="delete-user-container"></div>
</div>

@section PageScripts
{
    <script src="~/lib/magnific-popup/jquery.magnific-popup.js"></script>
    <script>
        (function () {
            const deleteUrl = '@Url.Action("ModalDelete", "UserAdmin")';
            const sectionLinks = document.querySelectorAll('[data-useradmin-section]');
            const sections = {
                gebruikers: document.getElementById('useradmin-gebruikers-section'),
                entra: document.getElementById('useradmin-entra-section')
            };

            function showSection(key) {
                Object.values(sections).forEach(section => section.classList.add('d-none'));
                sectionLinks.forEach(link => link.classList.remove('active'));

                if (sections[key]) {
                    sections[key].classList.remove('d-none');
                }

                const activeLink = document.querySelector(`[data-useradmin-section="${key}"]`);
                if (activeLink) {
                    activeLink.classList.add('active');
                }
            }

            function loadDeleteModal(id) {
                $.get(deleteUrl, { id })
                    .done(function (html) {
                        $("#delete-user-container").html(html);
                        $.magnificPopup.open({
                            items: {
                                src: "#modaldeleteuser",
                                type: "inline"
                            }
                        });
                    });
            }

            sectionLinks.forEach(link => {
                link.addEventListener('click', event => {
                    event.preventDefault();
                    showSection(link.dataset.useradminSection);
                });
            });

            $(document).on("click", ".deleteUser", function (event) {
                event.preventDefault();
                const id = $(this).data("id");
                loadDeleteModal(id);
            });
        })();
    </script>
}