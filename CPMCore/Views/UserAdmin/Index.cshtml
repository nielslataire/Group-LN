@model CPMCore.Models.UserAdminIndexViewModel
@using FacadeCore
@using BOCore;
@inject IPermissionService PermissionService
@{
    ViewData["Title"] = "Gebruikers beheren";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var roleNames = Model.Roles.Select(r => r.RoleName).Distinct().OrderBy(x => x).ToList();
    var permissionDefsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.PermissionDefinitions.OrderBy(x => x.SortOrder),
        new System.Text.Json.JsonSerializerOptions
        {
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
        });
    await PermissionService.EnsureLoadedAsync();
    var canWriteUsers = PermissionService.HasWrite(PermissionCodes.SettingsUsers);
    var canDeleteUsers = PermissionService.HasDelete(PermissionCodes.SettingsUsers);
    var canManageRoleRights = canWriteUsers && canDeleteUsers;
}

<style>
    .invoice-tab-nav {
        background-color: #f3f5f7;
        border-radius: 6px;
        padding: 6px;
        gap: 4px;
    }

        .invoice-tab-nav .nav-link {
            color: #6c757d;
            font-weight: 600;
            border-radius: 6px;
            border: 1px solid transparent;
            padding: 10px 16px;
        }

            .invoice-tab-nav .nav-link.active {
                background-color: #ffffff;
                color: #1f2d3d;
                border-color: #e3e6ea;
                box-shadow: 0 1px 1px rgba(0, 0, 0, 0.05);
            }

    .user-entry {
        border: 1px solid #d8e0e6;
        border-radius: 6px;
        margin-bottom: 10px;
        background: #fff;
    }

    .user-entry-header {
        padding: 14px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .user-entry-actions a {
        color: inherit !important;
        font-weight: 400;
        font-size: 1.25rem !important;
        line-height : 1 !important;
    }

    .toggle-rights {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        border-radius: 6px;
        padding: 2px 8px;
        transition: background-color .15s ease-in-out, color .15s ease-in-out;
    }

        .toggle-rights:hover {
            background-color: #d8f3dc;
            color: #1f7a3f;
        }

        .toggle-rights .toggle-arrow {
            font-size: 16px;
        }

    .permission-table .submenu-row td:first-child {
        padding-left: 2rem;
        color: #6c757d;
    }

    .permission-cell input.override {
        accent-color: #fd7e14;
    }

    .permission-cell .checkbox-custom {
        display: inline-block;
        margin: 0 auto;
    }

    .permission-header-vertical {
        display: inline-flex;
        flex-direction: column-reverse;
        align-items: center;
        justify-content: center;
        gap: .4rem;
    }

        .permission-header-vertical .header-text-vertical {
            writing-mode: vertical-rl;
            transform: rotate(180deg);
            line-height: 1;
            font-size: .8rem;
        }

    /* Enkel extra styling voor indeterminate / semi-checked */
    .checkbox-custom input[type="checkbox"]:indeterminate + label::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        width: 10px;
        height: 2px;
        background-color: #fff;
        border-radius: 999px;
        transform: translate(-50%, -50%);
        transform-origin: center;
        margin: 0;
    }

    .checkbox-custom.checkbox-default input[type="checkbox"]:indeterminate + label::before {
        background: #ccc;
        border-color: #ccc;
    }

    .checkbox-custom.checkbox-warning input[type="checkbox"]:indeterminate + label::before {
        background: #f7c65f;
        border-color: #f7c65f;
    }

    .checkbox-custom input[type="checkbox"]:indeterminate + label::after {
        left: calc(50% - 0.5px);
    }

</style>

<div class="row">
    <div class="row justify-content-center justify-content-sm-between pt-2 pr-0">
        <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
            <h1 class="font-weight-bold mb-0 mt-0">Gebruikersbeheer</h1>
            <h5 class="mb-4 mt-0">Interne en externe gebruikers + rolrechten beheer.</h5>
        </div>

    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<ul class="nav nav-pills invoice-tab-nav mb-4" role="tablist">
    <li class="nav-item"><a class="nav-link active" href="#" data-useradmin-section="intern">Interne Gebruikers</a></li>
    <li class="nav-item"><a class="nav-link" href="#" data-useradmin-section="extern">Externe Gebruikers</a></li>
    <li class="nav-item"><a class="nav-link" href="#" data-useradmin-section="rolrechten">Rolrechten</a></li>
</ul>

<div id="useradmin-intern-section" class="useradmin-section">
    <section class="card card-modern">
        <header class="card-header  d-flex justify-content-between align-items-center">
            <h2 class="card-title mb-0 d-flex align-items-center">
                <i class="bx bx-group me-2 fs-3"></i>
                Interne Gebruikers
            </h2>
            @if (canWriteUsers)
            {
                <div class="card-actions d-flex align-items-center">
                    <button type="button" class="btn btn-primary btn-md px-3" id="open-create-user-modal" title="Gebruiker toevoegen">
                        <i class="fa fa-user-plus me-2"></i>Nieuwe Gebruiker
                    </button>                
            </div>
            }             
        </header>
        <div class="card-body pt-5">
            @foreach (var user in Model.LocalUsers)
            {
                var role = user.Permissions.FirstOrDefault() ?? "Geen rol";
                var displayName = string.IsNullOrWhiteSpace(user.DisplayName) ? user.UserName : user.DisplayName;
                var inviteStatusBadge = user.GuestInvitationStatus switch {
                    "Draft"             => ("badge-secondary", "Draft"),
                    "Invited"           => ("badge-info",      "Uitgenodigd"),
                    "PendingAcceptance" => ("badge-warning",   "In afwachting"),
                    "Redeemed"          => ("badge-success",   "Ingewisseld"),
                    "Active"            => ("badge-success",   "Actief gast"),
                    "Failed"            => ("badge-danger",    "Mislukt"),
                    "Revoked"           => ("badge-dark",      "Ingetrokken"),
                    _                  => ((string?)null, (string?)null)
                };
                <div class="user-entry" data-user-id="@user.Id">
                    <div class="user-entry-header">
                        <div>
                            <div class="font-weight-bold">@displayName</div>
                            <div class="text-muted">@user.Email</div>
                            <span class="badge badge-light">@role</span>
                            @if (inviteStatusBadge.Item1 != null)
                            {
                                <span class="badge @inviteStatusBadge.Item1 ms-1" title="Gastuitnodiging status">
                                    <i class="fa fa-user-secret me-1"></i>@inviteStatusBadge.Item2
                                </span>
                            }
                            @if (user.GuestLastLoginAt.HasValue)
                            {
                                <span class="badge badge-light ms-1 small" title="Laatste login gast">
                                    <i class="fa fa-clock me-1"></i>@user.GuestLastLoginAt.Value.ToLocalTime().ToString("dd/MM/yy HH:mm")
                                </span>
                            }
                        </div>
                        <div class="user-entry-actions actions text-end align-content-center">
                            @if (canWriteUsers)
                            {
                                <div class="switch switch-sm switch-primary d-inline-block me-5" title="Actief / niet actief">
                                    <input type="checkbox" data-plugin-ios-switch class="js-user-active-switch" data-user-id="@user.Id" @(user.IsActive ? "checked" : null) />
                                </div>

                                @* ── Gastuitnodiging knoppen ── *@
                                @if (!user.HasGuestInvitation)
                                {
                                    <a href="#" class="invite-guest-btn me-1"
                                       data-id="@user.Id"
                                       data-name="@displayName"
                                       data-email="@user.Email"
                                       title="Uitnodigen als externe gebruiker">
                                        <i class="bx bx-user-plus fs-5"></i>
                                    </a>
                                }
                                else
                                {
                                    @if (user.GuestInvitationStatus is "Invited" or "PendingAcceptance" or "Redeemed" or "Active")
                                    {
                                        <a href="#" class="resend-invite-btn me-1"
                                           data-id="@user.Id"
                                           data-name="@displayName"
                                           title="Heruitnodigen">
                                            <i class="bx bx-send fs-5"></i>
                                        </a>
                                    }
                                    <a href="#" class="reset-invite-btn me-1"
                                       data-id="@user.Id"
                                       data-name="@displayName"
                                       title="Uitnodiging resetten">
                                        <i class="bx bx-repeat fs-5"></i>
                                    </a>
                                    <a href="#" class="unlink-guest-btn me-1"
                                       data-id="@user.Id"
                                       data-name="@displayName"
                                       title="Koppeling verbreken">
                                        <i class="bx bx-unlink fs-5"></i>
                                    </a>
                                }

                                <a href="#" class="edit-user me-1"
                                   data-toggle="tooltip"
                                   data-placement="top"
                                   data-original-title="Bewerken"
                                   data-id="@user.Id"
                                   data-forename="@user.DisplayName.Split(' ').FirstOrDefault()"
                                   data-name="@string.Join(' ', user.DisplayName.Split(' ').Skip(1))"
                                   data-email="@user.Email"
                                   data-active="@(user.IsActive ? "true" : "false")"
                                   data-job=""
                                   data-cellphone="@user.Cellphone"
                                   data-role-id="@(user.CurrentRoleId?.ToString() ?? string.Empty)"
                                   data-dashboard-type="@(user.DashboardType.HasValue ? ((int)user.DashboardType.Value).ToString() : string.Empty)"
                                   title="Bewerken">
                                    <i class="bx bx-edit fs-5"></i>
                                </a>
                            }

                            @if (canDeleteUsers)
                            {
                                <a href="#" class="delete-user me-1" data-placement="top" data-original-title="Verwijderen" data-id="@user.Id" data-name="@displayName" title="Verwijderen">
                                    <i class="bx bx-trash fs-5"></i>
                                </a>
                            }
                            <a href="#" class="toggle-rights" data-user-id="@user.Id" title="Gebruikersrechten">
                                <i class="bx bx-shield fs-5"></i>
                                <i class="bx bx-chevron-down toggle-arrow"></i>
                            </a>
                        </div>
                    </div>
                    <div class="card-body border-top d-none rights-panel" id="rights-user-@user.Id">
                        <p class="mb-2 small text-muted">Vinkjes tonen de effectieve rechten. <span class="text-warning">Oranje</span> = afwijking van standaard rolrechten.</p>
                        <div class="table-responsive">
                            <table class="table permission-table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Pagina / Functie</th>
                                        <th class="text-center">
                                            <div class="permission-header-vertical">
                                               
                                                <div class="checkbox-custom checkbox-default d-inline-block mb-0 ">
                                                    <input type="checkbox" data-header-toggle="read">
                                                    <label></label>
                                                </div>
                                                <span class="header-text-vertical">Lezen</span>
                                            </div>
                                        </th>
                                        <th class="text-center">
                                            <div class="permission-header-vertical">
                                                <div class="checkbox-custom checkbox-default d-inline-block mb-0">
                                                    <input type="checkbox" data-header-toggle="write">
                                                    <label></label>
                                                </div>
                                                <span class="header-text-vertical">Schrijven</span>
                                            </div>
                                        </th>
                                        <th class="text-center">
                                            <div class="permission-header-vertical">
                                                <div class="checkbox-custom checkbox-default d-inline-block mb-0">
                                                    <input type="checkbox" data-header-toggle="delete">
                                                    <label></label>
                                                </div>
                                                <span class="header-text-vertical">Verwijderen</span>
                                            </div>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody class="permission-body" data-role="@role"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

<div id="useradmin-extern-section" class="useradmin-section d-none">
    <section class="card card-modern">
        <header class="card-header"><h2 class="card-title mb-0">Externe Gebruikers</h2></header>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead><tr><th>Naam</th><th>Email</th><th>UPN</th><th>Object ID</th></tr></thead>
                    <tbody>
                        @foreach (var user in Model.EntraUsers)
                        {
                            <tr>
                                <td>@user.DisplayName</td>
                                <td>@user.Email</td>
                                <td>@user.UserPrincipalName</td>
                                <td class="small text-muted">@user.Id</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

<div id="useradmin-rolrechten-section" class="useradmin-section d-none">
    <section class="card card-modern">

        <header class="card-header d-flex justify-content-between align-items-center">

            <h2 class="card-title mb-0 d-flex align-items-center">
                <i class="bx bx-shield me-2 fs-3"></i>
                Rolrechten instellen
            </h2>

            @if (canWriteUsers)
            {
                <div class="card-actions d-flex align-items-center">
                    <select id="role-rights-role-select" class="form-control" style="max-width: 360px;">
                        @foreach (var role in Model.Roles.OrderBy(r => r.RoleName))
                        {
                            <option value="@role.RoleId">@role.RoleName</option>
                        }
                    </select>
                </div>
            }

        </header>
        <div class="card-body">
            @if (!roleNames.Any())
            {
                <div class="text-muted">Nog geen rollen geconfigureerd (SecurityRole).</div>
            }
            @if (roleNames.Any())
            {
                <div class="row g-3 mb-3">
                    <div class="col-lg-6">
                        <div class="border rounded p-3 h-100">
                            <h4 class="mb-3">Nieuwe rol</h4>
                            <div class="row">
                            <div class="col-md-6 mb-2">
                                <label for="new-role-name" class="font-weight-bold">Naam</label>
                                <input class="form-control" id="new-role-name" placeholder="bv. Werfleider" />
                            </div>
                            <div class="col-md-6  mb-3">
                                <label for="new-role-copy-source" class="font-weight-bold">Rechten overnemen van</label>
                                <select class="form-control" id="new-role-copy-source">
                                    <option value="">Geen kopie</option>
                                    @foreach (var role in Model.Roles.OrderBy(r => r.RoleName))
                                    {
                                        <option value="@role.RoleId">@role.RoleName</option>
                                    }
                                </select>
                            </div>
                               </div>
                            @if (canManageRoleRights)
                            {
                                <button type="button" class="btn btn-primary" id="create-role-btn">
                                    <i class="bx bx-plus me-1"></i>Rol toevoegen
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-primary" id="create-role-btn" disabled>
                                    <i class="bx bx-plus me-1"></i>Rol toevoegen
                                </button>
                            }
                        </div>

                    </div>
                    <div class="col-lg-6">
                        <div class="border rounded p-3 h-100">
                            <h4 class="mb-3">Geselecteerde rol</h4>
                            <div class="form-group mb-3">
                                <label for="selected-role-name" class="font-weight-bold">Weergavenaam</label>
                                <input class="form-control" id="selected-role-name" />
                            </div>
                            @if (canManageRoleRights)
                            {
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-primary" id="save-role-name-btn">
                                        <i class="bx bx-save me-1"></i>Naam opslaan
                                    </button>
                                    <button type="button" class="btn btn-outline-danger" id="delete-role-btn">
                                        <i class="bx bx-trash me-1"></i>Rol verwijderen
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="user-entry">
                    <div class="card-body border-top">
                        <div class="table-responsive">
                            <table class="table permission-table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Pagina / Functie</th>
                                        <th class="text-center">
                                            <div class="permission-header-vertical">
                                                <div class="checkbox-custom checkbox-default d-inline-block mb-0">
                                                    <input type="checkbox" data-header-toggle="read">
                                                    <label></label>
                                                </div>
                                                <span class="header-text-vertical">Lezen</span>
                                            </div>
                                        </th>
                                        <th class="text-center">
                                            <div class="permission-header-vertical">
                                                <div class="checkbox-custom checkbox-default d-inline-block mb-0">
                                                    <input type="checkbox" data-header-toggle="write">
                                                    <label></label>
                                                </div>
                                                <span class="header-text-vertical">Schrijven</span>
                                            </div>
                                        </th>
                                        <th class="text-center">
                                            <div class="permission-header-vertical">
                                                <div class="checkbox-custom checkbox-default d-inline-block mb-0">
                                                    <input type="checkbox" data-header-toggle="delete">
                                                    <label></label>
                                                </div>
                                                <span class="header-text-vertical">Verwijderen</span>
                                            </div>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody class="permission-body" id="role-rights-body"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

<partial name="_UserAdminModals" model="Model" />

@section PageScripts
{
    <script src="~/lib/ios7-switch/ios7-switch.js"></script>
    <script>
        (function () {
            const sectionLinks = document.querySelectorAll('[data-useradmin-section]');
            const sections = {
                intern: document.getElementById('useradmin-intern-section'),
                extern: document.getElementById('useradmin-extern-section'),
                rolrechten: document.getElementById('useradmin-rolrechten-section')
            };

            const permissionDefinitions = @Html.Raw(permissionDefsJson);
            const canManageRoleRights = @(canManageRoleRights ? "true" : "false");
            const canWriteUsers = @(canWriteUsers ? "true" : "false");
            const antiForgeryTokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const antiForgeryToken = antiForgeryTokenInput ? antiForgeryTokenInput.value : '';
            let checkboxIdCounter = 0;
              const permissionItems = permissionDefinitions.map(function (x) {
                return {
                    code: x.code ?? x.Code,
                    name: x.name ?? x.Name,
                    parentCode: x.parentCode ?? x.ParentCode,
                    children: []
                };
            });

            const permissionItemMap = {};
            permissionItems.forEach(function (item) {
                permissionItemMap[item.code] = item;
            });

            permissionItems.forEach(function (item) {
                if (!item.parentCode) return;
                const parent = permissionItemMap[item.parentCode];
                if (parent) {
                    parent.children.push(item);
                }
            });

            const menuStructure = permissionItems.filter(function (item) { return !item.parentCode; });

        function createPermissionRows(tbody, rightsMap, options) {
            tbody.innerHTML = '';

            menuStructure.forEach(function (item) {
                addRowRecursive(item, 0, null);
            });

            function addRowRecursive(item, level, parentCode) {
                addRow(item, level, parentCode);
                (item.children || []).forEach(function (child) {
                    addRowRecursive(child, level + 1, item.code);
                });
            }

            function addRow(item, level, parentCode) {
                const isSub = level > 0;
                const right = rightsMap[item.code] || {
                    read: false,
                    write: false,
                    delete: false,
                    baseRead: false,
                    baseWrite: false,
                    baseDelete: false
                };

                const tr = document.createElement('tr');
                tr.dataset.code = item.code;
                tr.dataset.isSubrow = isSub ? 'true' : 'false';

                if (item.children && item.children.length) {
                    tr.dataset.hasChildren = 'true';
                }

                if (isSub && parentCode) {
                    tr.dataset.parentCode = parentCode;
                    tr.classList.add('submenu-row');
                }

                const disabled = options.editable ? '' : 'disabled';
                const readId = 'perm_' + (++checkboxIdCounter);
                const writeId = 'perm_' + (++checkboxIdCounter);
                const deleteId = 'perm_' + (++checkboxIdCounter);

                const readWarning = options.markOverride && right.read !== (right.baseRead ?? false);
                const writeWarning = options.markOverride && right.write !== (right.baseWrite ?? false);
                const deleteWarning = options.markOverride && right.delete !== (right.baseDelete ?? false);
                const labelPadding = isSub ? ' style="padding-left: ' + (1 + (level * 1.25)) + 'rem"' : '';

                tr.innerHTML =
                    '<td' + labelPadding + '>' + item.name + '</td>' +
                    '<td class="text-center permission-cell">' +
                        '<div class="checkbox-custom ' + (readWarning ? 'checkbox-warning' : 'checkbox-default') + '">' +
                            '<input data-access="read" id="' + readId + '" type="checkbox" ' + (right.read ? 'checked' : '') + ' ' + disabled + ' />' +
                            '<label for="' + readId + '"></label>' +
                        '</div>' +
                    '</td>' +
                    '<td class="text-center permission-cell">' +
                        '<div class="checkbox-custom ' + (writeWarning ? 'checkbox-warning' : 'checkbox-default') + '">' +
                            '<input data-access="write" id="' + writeId + '" type="checkbox" ' + (right.write ? 'checked' : '') + ' ' + disabled + ' />' +
                            '<label for="' + writeId + '"></label>' +
                        '</div>' +
                    '</td>' +
                    '<td class="text-center permission-cell">' +
                        '<div class="checkbox-custom ' + (deleteWarning ? 'checkbox-warning' : 'checkbox-default') + '">' +
                            '<input data-access="delete" id="' + deleteId + '" type="checkbox" ' + (right.delete ? 'checked' : '') + ' ' + disabled + ' />' +
                            '<label for="' + deleteId + '"></label>' +
                        '</div>' +
                    '</td>';

                tbody.appendChild(tr);
            }

            attachColumnToggles(tbody, options.editable);
            attachParentRowToggles(tbody, options.editable);
        }

                    function updateHeaderToggleState(tbody, access) {
            const table = tbody.closest('table');
            if (!table) return;

            const headerCheckbox = table.querySelector('thead input[data-header-toggle="' + access + '"]');
            if (!headerCheckbox) return;

            const checkboxes = Array.from(tbody.querySelectorAll('input[data-access="' + access + '"]'));
            if (!checkboxes.length) {
                headerCheckbox.checked = false;
                headerCheckbox.indeterminate = false;
                return;
            }

            const checkedCount = checkboxes.filter(function (cb) { return cb.checked; }).length;

            if (checkedCount === 0) {
                headerCheckbox.checked = false;
                headerCheckbox.indeterminate = false;
            } else if (checkedCount === checkboxes.length) {
                headerCheckbox.checked = true;
                headerCheckbox.indeterminate = false;
            } else {
                headerCheckbox.checked = false;
                headerCheckbox.indeterminate = true;
            }
        }
        function getChildRows(tbody, parentCode) {
              return Array.from(tbody.querySelectorAll('tr[data-parent-code="' + parentCode + '"]'));
          }

          function getDescendantRows(tbody, parentCode) {
              const descendants = [];
              const queue = getChildRows(tbody, parentCode);

              while (queue.length) {
                  const row = queue.shift();
                  descendants.push(row);

                  const rowCode = row.dataset.code;
                  if (!rowCode) continue;

                  getChildRows(tbody, rowCode).forEach(function (child) {
                      queue.push(child);
                  });
              }

              return descendants;
          }

          function getAncestorRows(tbody, row) {
              const ancestors = [];
              let parentCode = row ? row.dataset.parentCode : null;

              while (parentCode) {
                  const parentRow = tbody.querySelector('tr[data-code="' + parentCode + '"]');
                  if (!parentRow) break;
                  ancestors.push(parentRow);
                  parentCode = parentRow.dataset.parentCode;
              }

              return ancestors;
          }

          function updateParentRowState(tbody, parentCode, access) {
              const parentRow = tbody.querySelector('tr[data-code="' + parentCode + '"]');
            if (!parentRow) return;

            const parentCheckbox = parentRow.querySelector('input[data-access="' + access + '"]');
            if (!parentCheckbox) return;

            const childRows = getChildRows(tbody, parentCode);
            if (!childRows.length) {
                parentCheckbox.indeterminate = false;
                return;
            }

            const childCheckboxes = childRows
                .map(function (row) { return row.querySelector('input[data-access="' + access + '"]'); })
                .filter(Boolean);

            const checkedCount = childCheckboxes.filter(function (cb) { return cb.checked; }).length;

            if (checkedCount === 0) {
                parentCheckbox.checked = false;
                parentCheckbox.indeterminate = false;
            } else if (checkedCount === childCheckboxes.length) {
                parentCheckbox.checked = true;
                parentCheckbox.indeterminate = false;
            } else {
                parentCheckbox.checked = false;
                parentCheckbox.indeterminate = true;
            }
        }

        function updateAllParentRows(tbody, access) {
            const parentRows = tbody.querySelectorAll('tr[data-has-children="true"]');
            parentRows.forEach(function (row) {
                updateParentRowState(tbody, row.dataset.code, access);
            });
        }

        function toggleChildRowsFromParent(tbody, parentCode, access, checked) {
           const childRows = getDescendantRows(tbody, parentCode);

            childRows.forEach(function (row) {
                const cb = row.querySelector('input[data-access="' + access + '"]');
                if (!cb) return;

                if (cb.checked !== checked) {
                    cb.checked = checked;
                    cb.dispatchEvent(new Event('change', { bubbles: true }));
                }
            });
        }

                function attachParentRowToggles(tbody, editable) {
            if (!editable) {
                updateAllParentRows(tbody, 'read');
                updateAllParentRows(tbody, 'write');
                updateAllParentRows(tbody, 'delete');
                return;
            }

            const parentRows = tbody.querySelectorAll('tr[data-has-children="true"]');

            parentRows.forEach(function (parentRow) {
                const parentCode = parentRow.dataset.code;

                ['read', 'write', 'delete'].forEach(function (access) {
                    const parentCheckbox = parentRow.querySelector('input[data-access="' + access + '"]');
                    if (!parentCheckbox) return;

                    parentCheckbox.addEventListener('change', function () {
                        if (parentCheckbox.indeterminate) {
                            parentCheckbox.indeterminate = false;
                        }

                        toggleChildRowsFromParent(tbody, parentCode, access, parentCheckbox.checked);
                    });
                });
            });

            tbody.querySelectorAll('tr[data-parent-code] input[type="checkbox"]').forEach(function (childCheckbox) {
                childCheckbox.addEventListener('change', function () {
                    const row = childCheckbox.closest('tr');
                    let parentCode = row.dataset.parentCode;
                    const access = childCheckbox.dataset.access;

                    while (parentCode && access) {
                        updateParentRowState(tbody, parentCode, access);
                        const parentRow = tbody.querySelector('tr[data-code="' + parentCode + '"]');
                        parentCode = parentRow ? parentRow.dataset.parentCode : null;
                    }
                });
            });


            updateAllParentRows(tbody, 'read');
            updateAllParentRows(tbody, 'write');
            updateAllParentRows(tbody, 'delete');
        }

        function enforceCascade(row, changedAccess) {
            const readCb = row.querySelector('input[data-access="read"]');
            const writeCb = row.querySelector('input[data-access="write"]');
            const deleteCb = row.querySelector('input[data-access="delete"]');
            if (!readCb || !writeCb || !deleteCb) return;

            if (changedAccess === 'delete' && deleteCb.checked) {
                writeCb.checked = true;
                readCb.checked = true;
            } else if (changedAccess === 'write' && writeCb.checked) {
                readCb.checked = true;
            } else if (changedAccess === 'write' && !writeCb.checked) {
                deleteCb.checked = false;
            } else if (changedAccess === 'read' && !readCb.checked) {
                writeCb.checked = false;
                deleteCb.checked = false;
            }
        }

        function updateAllAccessStates(tbody, row) {
            ['read', 'write', 'delete'].forEach(function (a) {
                let pCode = row ? row.dataset.parentCode : null;
                while (pCode) {
                    updateParentRowState(tbody, pCode, a);
                    const pRow = tbody.querySelector('tr[data-code="' + pCode + '"]');
                    pCode = pRow ? pRow.dataset.parentCode : null;
                }
                if (row && row.dataset.hasChildren === 'true') {
                    updateParentRowState(tbody, row.dataset.code, a);
                }
                updateHeaderToggleState(tbody, a);
            });
        }

              function attachColumnToggles(tbody, editable) {
            const table = tbody.closest('table');
            if (!table) return;

            ['read', 'write', 'delete'].forEach(function (access) {
                const headerCheckbox = table.querySelector('thead input[data-header-toggle="' + access + '"]');
                if (!headerCheckbox) return;

                const headerId = 'hdr_' + access + '_' + (++checkboxIdCounter);
                const label = headerCheckbox.parentElement.querySelector('label');
                headerCheckbox.id = headerId;
                if (label) label.setAttribute('for', headerId);

                if (!editable) {
                    updateHeaderToggleState(tbody, access);
                    headerCheckbox.disabled = true;
                    return;
                }

                headerCheckbox.disabled = false;

                headerCheckbox.addEventListener('change', function () {
                    tbody.querySelectorAll('input[data-access="' + access + '"]').forEach(function (cb) {
                        if (cb.checked !== headerCheckbox.checked) {
                            cb.checked = headerCheckbox.checked;
                            cb.indeterminate = false;
                            cb.dispatchEvent(new Event('change', { bubbles: true }));
                        }
                    });

                    headerCheckbox.indeterminate = false;
                    updateAllParentRows(tbody, access);
                    updateHeaderToggleState(tbody, access);
                });

                tbody.querySelectorAll('input[data-access="' + access + '"]').forEach(function (cb) {
                    cb.addEventListener('change', function () {
                        const row = cb.closest('tr');
                        if (row) enforceCascade(row, access);
                        updateAllAccessStates(tbody, row);
                    });
                });

                updateAllParentRows(tbody, access);
                updateHeaderToggleState(tbody, access);
            });
        }

            async function postJson(url, payload) {
                const body = new URLSearchParams();
                Object.keys(payload).forEach(function (key) {
                    if (payload[key] !== undefined && payload[key] !== null) body.append(key, payload[key]);
                });

                return fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: body.toString()
                });
            }

            function showSection(key) {
                Object.keys(sections).forEach(function (name) {
                    sections[name].classList.add('d-none');
                });
                sectionLinks.forEach(function (link) { link.classList.remove('active'); });
                if (sections[key]) sections[key].classList.remove('d-none');
                const activeLink = document.querySelector('[data-useradmin-section="' + key + '"]');
                if (activeLink) activeLink.classList.add('active');
            }

            sectionLinks.forEach(function (link) {
                link.addEventListener('click', function (event) {
                    event.preventDefault();
                    showSection(link.dataset.useradminSection);
                });
            });

            document.querySelectorAll('.toggle-rights').forEach(function (btn) {
                btn.addEventListener('click', async function (e) {
                    e.preventDefault();
                    const panel = document.getElementById('rights-user-' + btn.dataset.userId);
                 const isOpening = panel.classList.contains('d-none');

                    document.querySelectorAll('.rights-panel').forEach(function (otherPanel) {
                        if (otherPanel !== panel) {
                            otherPanel.classList.add('d-none');
                        }
                    });
                    document.querySelectorAll('.toggle-rights').forEach(function (otherBtn) {
                        if (otherBtn !== btn) {
                            const otherChevron = otherBtn.querySelector('.toggle-arrow');
                            if (otherChevron) {
                                otherChevron.classList.remove('bx-chevron-up');
                                otherChevron.classList.add('bx-chevron-down');
                            }
                        }
                    });

                    panel.classList.toggle('d-none', !isOpening);
                    const chevron = btn.querySelector('.toggle-arrow');
                    if (chevron) {
                        chevron.classList.toggle('bx-chevron-up', isOpening);
                        chevron.classList.toggle('bx-chevron-down', !isOpening);
                    }
                    if (!panel.dataset.loaded) {
                        const tbody = panel.querySelector('.permission-body');
                        const response = await fetch('@Url.Action("PermissionMatrix", "UserAdmin")?userId=' + encodeURIComponent(btn.dataset.userId));
                        const matrix = response.ok ? await response.json() : {};
                        const rightsMap = {};

                        menuStructure.forEach(function (item) {
                            rightsMap[item.code] = matrix[item.code] || { read: false, write: false, delete: false, baseRead: false, baseWrite: false, baseDelete: false, overridden: false };
                            (item.children || []).forEach(function (child) {
                                rightsMap[child.code] = matrix[child.code] || { read: false, write: false, delete: false, baseRead: false, baseWrite: false, baseDelete: false, overridden: false };
                            });
                        });

                        createPermissionRows(tbody, rightsMap, { editable: canWriteUsers, markOverride: true });

                        if (canWriteUsers) {
                            tbody.querySelectorAll('input[type="checkbox"]').forEach(function (checkbox) {
                                checkbox.addEventListener('change', async function () {
                                    const row = checkbox.closest('tr');
                                    const code = row.dataset.code;
                                    const read = row.querySelector('input[data-access="read"]').checked;
                                    const write = row.querySelector('input[data-access="write"]').checked;
                                    const del = row.querySelector('input[data-access="delete"]').checked;

                                    await postJson('@Url.Action("SaveUserPermissionOverride", "UserAdmin")', {
                                        userId: btn.dataset.userId,
                                        permissionCode: code,
                                        canRead: read,
                                        canWrite: write,
                                        canDelete: del,
                                        __RequestVerificationToken: antiForgeryToken
                                    });
                                     const ancestorRows = getAncestorRows(tbody, row);
                                    for (const ancestorRow of ancestorRows) {
                                        await postJson('@Url.Action("SaveUserPermissionOverride", "UserAdmin")', {
                                            userId: btn.dataset.userId,
                                            permissionCode: ancestorRow.dataset.code,
                                            canRead: ancestorRow.querySelector('input[data-access="read"]').checked,
                                            canWrite: ancestorRow.querySelector('input[data-access="write"]').checked,
                                            canDelete: ancestorRow.querySelector('input[data-access="delete"]').checked,
                                            __RequestVerificationToken: antiForgeryToken
                                        });
                                    }
                                });
                            });
                        }
                        panel.dataset.loaded = 'true';
                    }
                });
            });

            const roleSelect = document.getElementById('role-rights-role-select');
            const roleRightsBody = document.getElementById('role-rights-body');
            const deleteRoleBtn = document.getElementById('delete-role-btn');
            const createRoleBtn = document.getElementById('create-role-btn');
            const saveRoleNameBtn = document.getElementById('save-role-name-btn');
            const selectedRoleNameInput = document.getElementById('selected-role-name');
            const newRoleNameInput = document.getElementById('new-role-name');
            const newRoleCopySourceSelect = document.getElementById('new-role-copy-source');
            const confirmDeleteRoleBtn = document.getElementById('confirm-delete-role-btn');
            const deleteRoleNameEl = document.getElementById('delete-role-name');
            const openCreateUserModalBtn = document.getElementById('open-create-user-modal');

            async function loadRoleRights() {
                if (!roleSelect || !roleRightsBody) return;
                const roleId = roleSelect.value;
                if (!roleId) return;
                const roleName = roleSelect.options[roleSelect.selectedIndex].text;
                if (selectedRoleNameInput) selectedRoleNameInput.value = roleName;

                const response = await fetch('@Url.Action("RolePermissionMatrix", "UserAdmin")?roleId=' + encodeURIComponent(roleId));
                const matrix = response.ok ? await response.json() : {};

                const rightsMap = {};
                menuStructure.forEach(function (item) {
                    rightsMap[item.code] = matrix[item.code] || { read: false, write: false, delete: false };
                    (item.children || []).forEach(function (child) {
                        rightsMap[child.code] = matrix[child.code] || { read: false, write: false, delete: false };
                    });
                });

                createPermissionRows(roleRightsBody, rightsMap, { editable: canManageRoleRights, markOverride: false });

                if (canManageRoleRights) {
                    roleRightsBody.querySelectorAll('input[type="checkbox"]').forEach(function (checkbox) {
                        checkbox.addEventListener('change', async function () {
                            const row = checkbox.closest('tr');
                            const code = row.dataset.code;
                            const read = row.querySelector('input[data-access="read"]').checked;
                            const write = row.querySelector('input[data-access="write"]').checked;
                            const del = row.querySelector('input[data-access="delete"]').checked;

                            await postJson('@Url.Action("SaveRolePermission", "UserAdmin")', {
                                roleId: roleId,
                                permissionCode: code,
                                canRead: read,
                                canWrite: write,
                                canDelete: del,
                                __RequestVerificationToken: antiForgeryToken
                            });
                             const ancestorRows = getAncestorRows(roleRightsBody, row);
                            for (const ancestorRow of ancestorRows) {
                                await postJson('@Url.Action("SaveRolePermission", "UserAdmin")', {
                                    roleId: roleId,
                                    permissionCode: ancestorRow.dataset.code,
                                    canRead: ancestorRow.querySelector('input[data-access="read"]').checked,
                                    canWrite: ancestorRow.querySelector('input[data-access="write"]').checked,
                                    canDelete: ancestorRow.querySelector('input[data-access="delete"]').checked,
                                    __RequestVerificationToken: antiForgeryToken
                                });
                            }
                        });
                    });
                }
            }

            if (roleSelect) {
                roleSelect.addEventListener('change', loadRoleRights);
                loadRoleRights();
            }

            if (deleteRoleBtn) {
                deleteRoleBtn.addEventListener('click', function () {
                    if (!roleSelect || !roleSelect.value) return;
                    if (deleteRoleNameEl) deleteRoleNameEl.textContent = roleSelect.options[roleSelect.selectedIndex].text;
                    if (window.jQuery && $.magnificPopup) {
                        $.magnificPopup.open({
                            items: {
                                src: '#deleteRoleModal'
                            },
                            type: 'inline',
                            preloader: false
                        });
                    }
                });
            }

            if (confirmDeleteRoleBtn) {
                confirmDeleteRoleBtn.addEventListener('click', async function () {
                    if (!roleSelect || !roleSelect.value) return;
                    const deletedRoleId = roleSelect.value;
                    const response = await postJson('@Url.Action("DeleteRole", "UserAdmin")', {
                        roleId: deletedRoleId,
                        __RequestVerificationToken: antiForgeryToken
                    });

                    if (!response.ok) return;

                    const deletedRoleOption = roleSelect.querySelector('option[value="' + deletedRoleId + '"]');
                    if (deletedRoleOption) deletedRoleOption.remove();

                    if (newRoleCopySourceSelect) {
                        const deletedCopyOption = newRoleCopySourceSelect.querySelector('option[value="' + deletedRoleId + '"]');
                        if (deletedCopyOption) deletedCopyOption.remove();
                    }

                    if (roleSelect.options.length > 0) {
                        roleSelect.selectedIndex = 0;
                        await loadRoleRights();
                    } else {
                        if (selectedRoleNameInput) selectedRoleNameInput.value = '';
                        if (roleRightsBody) roleRightsBody.innerHTML = '';
                    }

                    if (window.jQuery && $.magnificPopup) {
                        $.magnificPopup.close();
                    }
                });
            }

            if (openCreateUserModalBtn) {
                openCreateUserModalBtn.addEventListener('click', function () {
                    if (window.jQuery && $.magnificPopup) {
                        $.magnificPopup.open({
                            items: {
                                src: '#createUserModal'
                            },
                            type: 'inline',
                            preloader: false
                        });
                    }
                });
            }

            if (createRoleBtn) {
                createRoleBtn.addEventListener('click', async function () {
                    const roleName = (newRoleNameInput ? newRoleNameInput.value : '').trim();
                    if (!roleName) {
                        alert('Rolnaam is verplicht.');
                        return;
                    }

                    const response = await postJson('@Url.Action("CreateRole", "UserAdmin")', {
                        roleName: roleName,
                        copyFromRoleId: newRoleCopySourceSelect ? (newRoleCopySourceSelect.value || null) : null,
                        __RequestVerificationToken: antiForgeryToken
                    });

                    if (!response.ok) {
                        const message = await response.text();
                        alert(message || 'Kon rol niet aanmaken.');
                        return;
                    }

                    const result = await response.json();
                    if (roleSelect) {
                        const option = document.createElement('option');
                        option.value = result.roleId;
                        option.textContent = result.roleName;
                        roleSelect.appendChild(option);
                        roleSelect.value = result.roleId;
                    }

                    if (newRoleCopySourceSelect) {
                        const optionCopy = document.createElement('option');
                        optionCopy.value = result.roleId;
                        optionCopy.textContent = result.roleName;
                        newRoleCopySourceSelect.appendChild(optionCopy);
                    }

                    if (newRoleNameInput) newRoleNameInput.value = '';
                    if (newRoleCopySourceSelect) newRoleCopySourceSelect.value = '';
                    await loadRoleRights();
                });
            }

            if (saveRoleNameBtn) {
                saveRoleNameBtn.addEventListener('click', async function () {
                    if (!roleSelect || !roleSelect.value || !selectedRoleNameInput) return;
                    const newName = (selectedRoleNameInput.value || '').trim();
                    if (!newName) {
                        alert('Rolnaam is verplicht.');
                        return;
                    }

                    const response = await postJson('@Url.Action("RenameRole", "UserAdmin")', {
                        roleId: roleSelect.value,
                        roleName: newName,
                        __RequestVerificationToken: antiForgeryToken
                    });

                    if (!response.ok) {
                        const message = await response.text();
                        alert(message || 'Kon rolnaam niet aanpassen.');
                        return;
                    }

                    const result = await response.json();
                    const selectedOption = roleSelect.options[roleSelect.selectedIndex];
                    if (selectedOption) selectedOption.text = result.roleName;

                    const copyOption = newRoleCopySourceSelect
                        ? newRoleCopySourceSelect.querySelector('option[value="' + result.roleId + '"]')
                        : null;
                    if (copyOption) copyOption.text = result.roleName;
                });
            }

            $('.js-user-active-switch').on('change', async function () {
                const checkbox = this;
                await postJson('@Url.Action("SetUserActive", "UserAdmin")', {
                    userId: checkbox.dataset.userId,
                    isActive: checkbox.checked,
                    __RequestVerificationToken: antiForgeryToken
                });
            });

            if (window.jQuery && $.fn && $.fn.themePluginIOS7Switch) {
                $('.js-user-active-switch').themePluginIOS7Switch();
            }

            $(document).on('click', '.edit-user', function (event) {
                event.preventDefault();
                const trigger = $(this);
                $('#edit-id').val(trigger.data('id'));
                $('#edit-forename').val(trigger.data('forename'));
                $('#edit-name').val(trigger.data('name'));
                $('#edit-email').val(trigger.data('email'));
                $('#edit-job').val(trigger.data('job'));
                $('#edit-cellphone').val(trigger.data('cellphone'));
                $('#edit-role-id').val(trigger.data('role-id'));
                $('#edit-dashboard-type').val(trigger.data('dashboard-type') || '');
                $('#edit-active').prop('checked', String(trigger.data('active')) === 'true');
                if ($.magnificPopup) {
                    $.magnificPopup.open({
                        items: {
                            src: '#editUserModal'
                        },
                        type: 'inline',
                        preloader: false
                    });
                }
            });

            $(document).on('click', '.delete-user', function (event) {
                event.preventDefault();
                const trigger = $(this);
                $('#delete-id').val(trigger.data('id'));
                $('#delete-name').text(trigger.data('name'));
                if ($.magnificPopup) {
                    $.magnificPopup.open({
                        items: { src: '#deleteUserModal' },
                        type: 'inline',
                        preloader: false
                    });
                }
            });

            // ── Gastuitnodiging modalen ────────────────────────────────────
            $(document).on('click', '.invite-guest-btn', function (event) {
                event.preventDefault();
                const t = $(this);
                $('#invite-guest-user-id').val(t.data('id'));
                $('#invite-guest-name').text(t.data('name'));
                $('#invite-guest-email').text(t.data('email'));
                if ($.magnificPopup) {
                    $.magnificPopup.open({ items: { src: '#inviteGuestModal' }, type: 'inline', preloader: false });
                }
            });

            $(document).on('click', '.resend-invite-btn', function (event) {
                event.preventDefault();
                const t = $(this);
                $('#resend-invite-user-id').val(t.data('id'));
                $('#resend-invite-name').text(t.data('name'));
                if ($.magnificPopup) {
                    $.magnificPopup.open({ items: { src: '#resendInviteModal' }, type: 'inline', preloader: false });
                }
            });

            $(document).on('click', '.reset-invite-btn', function (event) {
                event.preventDefault();
                const t = $(this);
                $('#reset-invite-user-id').val(t.data('id'));
                $('#reset-invite-name').text(t.data('name'));
                if ($.magnificPopup) {
                    $.magnificPopup.open({ items: { src: '#resetInviteModal' }, type: 'inline', preloader: false });
                }
            });

            $(document).on('click', '.unlink-guest-btn', function (event) {
                event.preventDefault();
                const t = $(this);
                $('#unlink-guest-user-id').val(t.data('id'));
                $('#unlink-guest-name').text(t.data('name'));
                if ($.magnificPopup) {
                    $.magnificPopup.open({ items: { src: '#unlinkGuestModal' }, type: 'inline', preloader: false });
                }
            });
        })();
    </script>
}
