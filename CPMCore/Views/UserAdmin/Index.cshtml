@model CPMCore.Models.UserAdminIndexViewModel
@{
    ViewData["Title"] = "Gebruikers beheren";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="card">
    <header class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h2 class="card-title mb-0">Gebruikersbeheer</h2>
            <p class="card-subtitle">Beheer CPMCore-gebruikers, rollen en Entra-koppelingen.</p>
        </div>
    </header>
    <div class="card-body">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">@TempData["Message"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th>Naam</th>
                        <th>Gebruikersnaam</th>
                        <th>Email</th>
                        <th>Entra gekoppeld</th>
                        <th>Entra Object ID</th>
                        <th>Rollen</th>
                        <th>Status</th>
                        <th class="text-end">Acties</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.LocalUsers)
                    {
                        <tr>
                            <td>@user.DisplayName</td>
                            <td>@user.UserName</td>
                            <td>@user.Email</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(user.EntraObjectId))
                                {
                                    <span class="badge bg-success">Ja</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Nee</span>
                                }
                            </td>
                            <td class="small text-muted">@user.EntraObjectId</td>
                            <td>
                                @if (user.Permissions.Any())
                                {
                                    <span class="badge bg-secondary">@string.Join(", ", user.Permissions)</span>
                                }
                                else
                                {
                                    <span class="text-muted">Geen rol</span>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Actief</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactief</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-primary" href="@Url.Action("Edit", new { id = user.Id })"><i class="bx bx-edit"></i> Bewerken</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<section class="card mt-4">
    <header class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h2 class="card-title mb-0">Entra gebruikers</h2>
            <p class="card-subtitle">Overzicht van accounts in Microsoft Entra ID.</p>
        </div>
    </header>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th>Naam</th>
                        <th>Email</th>
                        <th>UPN</th>
                        <th>Object ID</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.EntraUsers)
                    {
                        <tr>
                            <td>@user.DisplayName</td>
                            <td>@user.Email</td>
                            <td>@user.UserPrincipalName</td>
                            <td class="small text-muted">@user.Id</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>