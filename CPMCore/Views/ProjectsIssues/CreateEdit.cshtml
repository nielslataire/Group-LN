@using BOCore
@using Microsoft.AspNetCore.Mvc.Rendering
@using CPMCore.Models.Issues
@model ConstructionIssueFormVm
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Punt bewerken" : "Punt toevoegen";
}

<div class="row justify-content-between align-items-center pt-2 pe-0 mb-3">
    <div class="col-sm-auto mb-3 mb-sm-0">
        <div class="d-flex align-items-center">
            <a href="@Url.Action("Index", new { projectId = Model.ProjectId })" class="text-decoration-none text-reset d-flex align-items-center me-3">
                <i class="bx bx-chevron-left fs-1"></i>
            </a>
            <div>
                <h1 class="fw-bold mb-0">@(isEdit ? "Punt bewerken" : "Punt toevoegen")</h1>
                <h5 class="mb-0 text-muted">Project issue beheer</h5>
            </div>
        </div>
    </div>
</div>

<form method="post" class="ecommerce-form action-buttons-fixed" action="#" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })



    <section class="card card-modern card-big-info mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-lg-2-5 col-xl-1-5">
                    <i class="card-big-info-icon bx bx-map"></i>
                    <h2 class="card-big-info-title">Locatie</h2>
                    <p class="card-big-info-desc">Gestructureerde locatie-info.</p>
                </div>
                <div class="col-lg-3-5 col-xl-4-5">
                    <div class="form-group row align-items-center pb-3">
                        <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Eenheid</label>
                        <div class="col-lg-7 col-xl-6">
                            <select asp-for="Input.UnitId" class="form-control form-control-modern" asp-items="@(new SelectList(Model.Units, "Id", "Name"))">
                                <option value="">Algemeen</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group row align-items-center pb-3">
                        <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Ruimte</label>
                        <div class="col-lg-7 col-xl-6">
                            <input asp-for="Input.RoomOrZone" class="form-control form-control-modern" />
                        </div>
                    </div>
                    <div class="form-group row align-items-center pb-3">
                        <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Exacte locatie</label>
                        <div class="col-lg-7 col-xl-6">
                            <input asp-for="Input.LocationText" class="form-control form-control-modern" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="card card-modern card-big-info mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-lg-2-5 col-xl-1-5">
                    <i class="card-big-info-icon bx bx-note"></i>
                    <h2 class="card-big-info-title">Algemene info</h2>
                    <p class="card-big-info-desc">Basisgegevens van het punt.</p>
                </div>
                <div class="col-lg-3-5 col-xl-4-5">
                    <div class="form-group row align-items-center pb-3">
                        <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Titel</label>
                        <div class="col-lg-7 col-xl-6">
                            <input asp-for="Input.Title" class="form-control form-control-modern" />
                        </div>
                    </div>
                    <div class="form-group row align-items-center pb-3">
                        <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Beschrijving</label>
                        <div class="col-lg-7 col-xl-6">
                            <textarea asp-for="Input.Description" class="form-control form-control-modern" rows="4"></textarea>
                        </div>
                    </div>
                    <div class="form-group row align-items-center pb-3">
                        <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Categorie</label>
                        <div class="col-lg-7 col-xl-6">
                            <select asp-for="Input.CategoryId" class="form-control form-control-modern" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))"></select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="card card-modern card-big-info mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-lg-2-5 col-xl-1-5">
                    <i class="card-big-info-icon bx bx-slider"></i>
                    <h2 class="card-big-info-title">Workflow</h2>
                    <p class="card-big-info-desc">Type, fase, prioriteit en status.</p>
                </div>
                <div class="col-lg-3-5 col-xl-4-5">
                    <div class="form-group row align-items-center pb-3">
                        <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Type</label>
                        <div class="col-lg-7 col-xl-6">
                            <select asp-for="Input.IssueType" class="form-control form-control-modern" asp-items="Html.GetEnumSelectList<ConstructionIssueType>()"></select>
                        </div>
                    </div>
                    <div class="form-group row align-items-center pb-3">
                        <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Fase</label>
                        <div class="col-lg-7 col-xl-6">
                            <select asp-for="Input.IssuePhase" class="form-control form-control-modern" asp-items="Html.GetEnumSelectList<ConstructionIssuePhase>()"></select>
                        </div>
                    </div>
                    <div class="form-group row align-items-center pb-3">
                        <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Prioriteit</label>
                        <div class="col-lg-7 col-xl-6">
                            <select asp-for="Input.Priority" class="form-control form-control-modern" asp-items="Html.GetEnumSelectList<ConstructionIssuePriority>()"></select>
                        </div>
                    </div>
                    <div class="form-group row align-items-center pb-3">
                        <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Status</label>
                        <div class="col-lg-7 col-xl-6">
                            <select asp-for="Input.Status" class="form-control form-control-modern" asp-items="Html.GetEnumSelectList<ConstructionIssueStatus>()"></select>
                        </div>
                    </div>
                    <div class="form-group row align-items-center pb-3">
                        <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Vervaldatum</label>
                        <div class="col-lg-7 col-xl-6">
                            <input asp-for="Input.DueDate" type="date" class="form-control form-control-modern" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="card card-modern card-big-info mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-lg-2-5 col-xl-1-5">
                    <i class="card-big-info-icon bx bx-user"></i>
                    <h2 class="card-big-info-title">Verantwoordelijke</h2>
                    <p class="card-big-info-desc">Koppel aan partij of vul manueel in.</p>
                </div>
                <div class="col-lg-3-5 col-xl-4-5">
                    <div class="form-group row align-items-center pb-3">
                        <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Aannemer</label>
                        <div class="col-lg-7 col-xl-6">
                            <select asp-for="Input.ResponsiblePartyId" class="form-control form-control-modern" asp-items="@(new SelectList(Model.ResponsibleContractors, "ID", "Display"))">
                                <option value="">Selecteer...</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group row align-items-center pb-3">
                        <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Andere naam</label>
                        <div class="col-lg-7 col-xl-6">
                            <input asp-for="Input.ResponsibleOtherName" class="form-control form-control-modern" />
                        </div>
                    </div>
                    <div class="form-group row align-items-center pb-3">
                        <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Andere e-mail</label>
                        <div class="col-lg-7 col-xl-6">
                            <input asp-for="Input.ResponsibleOtherEmail" class="form-control form-control-modern" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="card card-modern card-big-info mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-lg-2-5 col-xl-1-5">
                    <i class="card-big-info-icon bx bx-image-add"></i>
                    <h2 class="card-big-info-title">Foto's</h2>
                    <p class="card-big-info-desc">Voeg meerdere foto's toe en beheer bestaande bijlagen.</p>
                </div>
                <div class="col-lg-3-5 col-xl-4-5">
                    <div class="form-group row align-items-start pb-3">
                        <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0 pt-2">Upload</label>
                        <div class="col-lg-7 col-xl-6">
                            <input id="mediaFilesInput" name="mediaFiles" type="file" accept="image/*" multiple class="form-control form-control-modern" />
                            <small class="text-muted">Je kan meerdere foto's tegelijk kiezen.</small>
                        </div>
                    </div>

                    <div class="form-group row align-items-start pb-3">
                        <label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0 pt-2">Preview</label>
                        <div class="col-lg-7 col-xl-9">
                            <div id="existingMediaPreview" class="d-flex flex-wrap gap-3">
                                @foreach (var media in Model.ExistingMedia)
                                {
                                    <div class="card p-2" style="width: 10rem;" data-existing-media-card="@media.Id">
                                        <img src="@(media.Url ?? "")" class="img-fluid rounded mb-2" style="height:120px;object-fit:cover;" alt="Issue foto" />
                                        <input type="hidden" name="deleteMediaIds" value="@media.Id" disabled data-delete-media-input="@media.Id" />
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-remove-existing-media="@media.Id">Verwijderen</button>
                                    </div>
                                }
                            </div>
                            <div id="newMediaPreview" class="d-flex flex-wrap gap-3 mt-3"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="row action-buttons">
        <div class="col-12 col-md-auto">
            <button type="submit" class="btn btn-primary btn-px-5 btn-py-2">Opslaan</button>
        </div>
        <div class="col-12 col-md-auto">
            <a class="btn btn-default btn-px-5 btn-py-2" href="@Url.Action("Index", new { projectId = Model.ProjectId })">Annuleren</a>
        </div>
    </div>
</form>


@section PageScripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const input = document.getElementById('mediaFilesInput');
            const newPreview = document.getElementById('newMediaPreview');
            const dt = new DataTransfer();

            const createNewPreviewCard = (file) => {
                const card = document.createElement('div');
                card.className = 'card p-2';
                card.style.width = '10rem';

                const image = document.createElement('img');
                image.className = 'img-fluid rounded mb-2';
                image.style.height = '120px';
                image.style.objectFit = 'cover';
                image.alt = file.name;

                const removeButton = document.createElement('button');
                removeButton.type = 'button';
                removeButton.className = 'btn btn-sm btn-outline-danger';
                removeButton.textContent = 'Verwijderen';
                removeButton.addEventListener('click', () => {
                    const index = Array.from(dt.files).findIndex(f => f.name === file.name && f.size === file.size && f.lastModified === file.lastModified);
                    if (index >= 0) {
                        dt.items.remove(index);
                        input.files = dt.files;
                    }
                    card.remove();
                });

                const reader = new FileReader();
                reader.onload = e => image.src = e.target?.result;
                reader.readAsDataURL(file);

                card.appendChild(image);
                card.appendChild(removeButton);
                newPreview.appendChild(card);
            };

            input?.addEventListener('change', (event) => {
                const files = Array.from(event.target.files || []);
                files.forEach(file => {
                    dt.items.add(file);
                    createNewPreviewCard(file);
                });
                input.files = dt.files;
            });

            document.querySelectorAll('[data-remove-existing-media]').forEach(button => {
                button.addEventListener('click', () => {
                    const id = button.getAttribute('data-remove-existing-media');
                    const hiddenInput = document.querySelector(`[data-delete-media-input="${id}"]`);
                    if (hiddenInput) hiddenInput.disabled = false;
                    const card = document.querySelector(`[data-existing-media-card="${id}"]`);
                    if (card) card.remove();
                });
            });
        })();
    </script>
}