            function clearMarker(){
                planMarker.style.display = 'none';
                planXNormalizedInput.value = '';
                planYNormalizedInput.value = '';
            }

            function hideMarker(){
                planMarker.style.display = 'none';
            }

            function setPickMode(enabled){
                isPickMode = enabled;
                planOverlay.classList.toggle('is-pick-mode', enabled);
                planPickToggle.textContent = enabled ? 'Klik op plan...' : 'Punt aanduiden';
                planPickToggle.classList.toggle('btn-primary', enabled);
                planPickToggle.classList.toggle('btn-outline-primary', !enabled);
            }

            function fillPageSelect(totalPages, selectedPage){
                planPageSelect.innerHTML = '';
                for(let page = 1; page <= totalPages; page++){
                    const option = document.createElement('option');
                    option.value = String(page);
                    option.textContent = `Pagina ${page}`;
                    planPageSelect.appendChild(option);
                }
                planPageSelect.value = String(selectedPage || 1);
                planPageSelect.disabled = totalPages <= 1;
            }

            function drawMarkerFromNormalized(xNorm, yNorm){
                if(xNorm === '' || yNorm === '' || xNorm == null || yNorm == null) { clearMarker(); return; }
                const width = planOverlay.clientWidth || planCanvas.clientWidth || 0;
                const height = planOverlay.clientHeight || planCanvas.clientHeight || 0;
                if (!width || !height) { return; }
                const x = Number(xNorm) * width;
                const y = Number(yNorm) * height;
                planMarker.style.left = `${x}px`;
                planMarker.style.top = `${y}px`;
                planMarker.style.display = 'block';
            }
                    function drawDetailMarkerFromNormalized(xNorm, yNorm) {
            if (!issueDetailPlanCanvas || !issueDetailPlanMarker) return;

            const rect = issueDetailPlanCanvas.getBoundingClientRect();
            const parentRect = issueDetailPlanCanvas.parentElement.getBoundingClientRect();

            if (!rect.width || !rect.height) {
                issueDetailPlanMarker.style.display = 'none';
                return;
            }

            const x = Number(xNorm) * rect.width;
            const y = Number(yNorm) * rect.height;

            issueDetailPlanMarker.style.left = `${(rect.left - parentRect.left) + x}px`;
            issueDetailPlanMarker.style.top = `${(rect.top - parentRect.top) + y}px`;
            issueDetailPlanMarker.style.display = 'block';
        }

            function resetPlanStage(){
                planSurface.style.display = 'none';
                planCanvas.style.display = 'none';
                planFrame.style.display = 'none';
                planFrame.src = 'about:blank';
                planOverlay.style.display = 'none';
                planEmpty.style.display = 'block';
                planCtx.clearRect(0, 0, planCanvas.width || 1, planCanvas.height || 1);
                hideMarker();
                setPickMode(false);
                planDocumentIdInput.value = '';
                planPageNumberInput.value = '1';
                planPageSelect.innerHTML = '<option value="1">Pagina 1</option>';
                planPageSelect.disabled = true;
                currentPdfDoc = null;
                currentPlanUrl = '';
            }

            function getZoomValueForIframe(){
                const zoom = planZoomSelect.value;
                if (zoom === 'fit') return 'page-fit';
                if (zoom === 'page-width') return 'page-width';
                return `${zoom}`;
            }

            function getScaleForCanvas(page){
                const baseViewport = page.getViewport({ scale: 1 });
                const maxWidth = Math.max((planContainer.clientWidth || 1000) - 16, 320);
                const maxHeight = Math.max((planContainer.clientHeight || 640) - 16, 320);
                const zoom = planZoomSelect.value;
                if (zoom === 'fit') return Math.min(maxWidth / baseViewport.width, maxHeight / baseViewport.height);
                if (zoom === 'page-width') return maxWidth / baseViewport.width;
                const numericZoom = Number(zoom);
                return Number.isFinite(numericZoom) ? (numericZoom / 100) : 1;
            }

            async function renderPdfPage(url, requestedPageNumber){
                const renderRequestId = ++planRenderRequestId;
                const pageNumber = Number(requestedPageNumber || planPageSelect.value || 1);
                hideMarker();
                setPickMode(false);
                planSurface.style.display = 'none';
                planCanvas.style.display = 'none';
                planFrame.style.display = 'none';
                planOverlay.style.display = 'none';
                planEmpty.style.display = 'block';
                planCtx.clearRect(0, 0, planCanvas.width || 1, planCanvas.height || 1);
                planPageNumberInput.value = String(pageNumber);

                if (!pdfJsApi || typeof pdfJsApi.getDocument !== 'function') {
                    planPageSelect.disabled = true;
                    planFrame.src = `${url}#page=${pageNumber}&zoom=${encodeURIComponent(getZoomValueForIframe())}&toolbar=0&navpanes=0&pagemode=none`;
                    planFrame.style.display = 'block';
                    planOverlay.style.display = 'none';
                    planSurface.style.display = 'none';
                    planEmpty.style.display = 'none';
                    return;
                }

                try {
                    if (!currentPdfDoc || currentPlanUrl !== url) {
                        const loadingTask = pdfJsApi.getDocument(url);
                        currentPdfDoc = await loadingTask.promise;
                        if (renderRequestId !== planRenderRequestId) return;
                        currentPlanUrl = url;
                        fillPageSelect(currentPdfDoc.numPages || 1, pageNumber);
                    }

                    const safePageNumber = Math.min(Math.max(1, pageNumber), currentPdfDoc.numPages || 1);
                    planPageSelect.value = String(safePageNumber);
                    planPageNumberInput.value = String(safePageNumber);
                    const page = await currentPdfDoc.getPage(safePageNumber);
                    if (renderRequestId !== planRenderRequestId) return;

                    const scale = getScaleForCanvas(page);
                    const viewport = page.getViewport({ scale });

                    planCanvas.width = Math.floor(viewport.width);
                    planCanvas.height = Math.floor(viewport.height);
                    planCanvas.style.width = `${Math.floor(viewport.width)}px`;
                    planCanvas.style.height = `${Math.floor(viewport.height)}px`;
                    planSurface.style.width = `${Math.floor(viewport.width)}px`;
                    planSurface.style.height = `${Math.floor(viewport.height)}px`;
                    await page.render({ canvasContext: planCtx, viewport }).promise;
                    if (renderRequestId !== planRenderRequestId) return;

                    planSurface.style.display = 'inline-block';
                    planCanvas.style.display = 'block';
                    planOverlay.style.display = 'block';
                    planEmpty.style.display = 'none';
                    if (planXNormalizedInput.value && planYNormalizedInput.value) {
                        drawMarkerFromNormalized(planXNormalizedInput.value, planYNormalizedInput.value);
                    }
                } catch (error) {
                    const isCancelled = String(error?.name || '').includes('RenderingCancelled')
                        || String(error?.message || '').toLowerCase().includes('rendering cancelled');
                    if (isCancelled || renderRequestId !== planRenderRequestId) {
                        return;
                    }

                    console.warn('PDF.js render failed, fallback to iframe preview.', error);
                    currentPdfDoc = null;
                    currentPlanUrl = '';
                    planPageSelect.disabled = true;
                    planFrame.src = `${url}#page=${pageNumber}&zoom=${encodeURIComponent(getZoomValueForIframe())}&toolbar=0&navpanes=0&pagemode=none`;
                    planFrame.style.display = 'block';
                    planOverlay.style.display = 'none';
                    planSurface.style.display = 'none';
                    planEmpty.style.display = 'none';
                }
            }

            async function loadPlansForUnit(unitId, selectedPlanId, selectedPageNumber){
                planSelect.innerHTML = '<option value="">Plan kiezen...</option>';
                planSelect.disabled = true;
                resetPlanStage();
                if(!unitId){
                    planSelect.innerHTML = '<option value="">Selecteer eerst een eenheid</option>';
                    return;
                }

                const response = await fetch(`/Projects/${projectId}/Issues/UnitPlans/${unitId}`);
                if(!response.ok) return;
                const plans = await response.json();
                currentPlans = plans || [];
                planSelect.innerHTML = '<option value="">Kies plan...</option>';

                currentPlans.forEach(plan => {
                    const opt = document.createElement('option');
                    opt.value = String(plan.id);
                    opt.textContent = plan.name;
                    opt.dataset.url = plan.url;
                    planSelect.appendChild(opt);
                });

                planSelect.disabled = currentPlans.length === 0;
                if (selectedPlanId != null && currentPlans.some(x => String(x.id) === String(selectedPlanId))) {
                    planSelect.value = String(selectedPlanId);
                    if (selectedPageNumber != null) {
                        planPageSelect.innerHTML = `<option value="${selectedPageNumber}">Pagina ${selectedPageNumber}</option>`;
                        planPageSelect.value = String(selectedPageNumber);
                    }
                    await onPlanChanged(false);
                    if (planXNormalizedInput.value && planYNormalizedInput.value) {
                        drawMarkerFromNormalized(planXNormalizedInput.value, planYNormalizedInput.value);
                    }
                }
            }

            async function onPlanChanged(clearPoint = true){
                if (clearPoint) {
                    clearMarker();
                } else {
                    hideMarker();
                }
                setPickMode(false);
                planEmpty.textContent = 'Selecteer eerst een eenheid en plan';
                const selectedOption = planSelect.options[planSelect.selectedIndex];
                if(!selectedOption || !selectedOption.dataset.url){
                    resetPlanStage();
                    return;
                }
                currentPdfDoc = null;
                currentPlanUrl = '';
                planDocumentIdInput.value = planSelect.value;
                await renderPdfPage(selectedOption.dataset.url, planPageSelect.value || 1);
            }

               async function syncResponsibleFromSelection(){
                const companyId = responsiblePartyField?.value;
                if (!responsibleNameField || !responsibleEmailField) return;

                if(!companyId){
                            responsibleNameField.value = '';
                            responsibleEmailField.value = '';
