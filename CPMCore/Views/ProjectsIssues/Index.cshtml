            async function openIssueModalFromExistingIssue(issueId, duplicateMode = false){
                resetForm();
                const response = await fetch(`/Projects/${projectId}/Issues/EditData/${issueId}`);
                if(!response.ok) return;

                const data = await response.json();
                const duplicateTitle = (data.title || '').trim();
                const duplicateTitleSuffix = duplicateTitle ? `${duplicateTitle} (kopie)` : '(kopie)';

                Object.entries({
                    'Input.Title': duplicateMode ? duplicateTitleSuffix : data.title,
                    'Input.Description': data.description,
                    'Input.LocationText': data.locationText,
                    'Input.CategoryId': data.categoryId,
                    'Input.RoomOrZone': data.roomOrZone,
                    'Input.UnitId': data.unitId,
                    'Input.IssueType': data.issueType,
                    'Input.IssuePhase': data.issuePhase,
                    'Input.Priority': data.priority,
                    'Input.Status': data.status,
                    'Input.ResponsiblePartyId': data.responsiblePartyId,
                    'Input.ResponsibleOtherName': data.responsibleOtherName,
                    'Input.ResponsibleOtherEmail': data.responsibleOtherEmail,
                    'Input.DueDate': data.dueDate,
                    'Input.PlanDocumentId': duplicateMode ? '' : data.planDocumentId,
                    'Input.PlanPageNumber': duplicateMode ? '' : data.planPageNumber,
                    'Input.PlanXNormalized': duplicateMode ? '' : data.planXnormalized,
                    'Input.PlanYNormalized': duplicateMode ? '' : data.planYnormalized
                }).forEach(([name,val]) => {
                    const el = issueForm.querySelector(`[name="${name}"]`);
                    if(el) el.value = val ?? '';
                });

                await loadPlansForUnit(data.unitId, duplicateMode ? null : data.planDocumentId, duplicateMode ? null : data.planPageNumber);
                await syncResponsibleFromSelection();
                    updatePrioritySwitchFromValue(data.priority);

                if (duplicateMode) {
                    issueForm.action = `/Projects/${projectId}/Issues/Create`;
                    titleEl.textContent = 'Punt dupliceren';
                    submitEl.textContent = 'Punt aanmaken';
                } else {
                    issueForm.action = `/Projects/${projectId}/Issues/Edit/${issueId}`;
                    titleEl.textContent = 'Punt bewerken';
                    submitEl.textContent = 'Punt opslaan';
                    (data.media || []).forEach(m => addPreview(m.url, m.id));
                }

                openBootstrapModal(issueModal, issueModalEl);
            }

            document.querySelectorAll('.open-edit-issue').forEach(btn => btn.addEventListener('click', async (event) => {
                event.preventDefault();
                await openIssueModalFromExistingIssue(btn.dataset.id, false);
            }));

            document.querySelectorAll('.open-duplicate-issue').forEach(btn => btn.addEventListener('click', async (event) => {
                event.preventDefault();
                await openIssueModalFromExistingIssue(btn.dataset.id, true);
            }));

               function setSelectAllVisualState(input, allChecked, isIndeterminate){
                  if (!input) return;
                  input.checked = allChecked;
                  input.indeterminate = isIndeterminate;
                  input.closest('.checkbox-custom')?.classList.toggle('is-indeterminate', isIndeterminate);
              }



        function setAllIssueChecks(checked){
                  const selectableChecks = getSelectableIssueCheckboxes();

                  document.querySelectorAll('.issue-check').forEach((checkbox) => {
                      checkbox.checked = false;
                  });

                  selectableChecks.forEach((checkbox) => {
                      checkbox.checked = checked;
                  });
                  setSelectAllVisualState(checkAllInput, checked, false);
                  setSelectAllVisualState(checkAllCardsInput, checked, false);
                  syncHidden();
                  updateFilterSelectionRow();
              }

          function bindSelectAllBehavior(input){
                  if (!input) return;

                  const rememberIndeterminateState = () => {
                      input.dataset.wasIndeterminate = input.indeterminate ? '1' : '0';
                  };

                  input.addEventListener('pointerdown', rememberIndeterminateState);
                  input.addEventListener('mousedown', rememberIndeterminateState);
                  input.closest('.checkbox-custom')?.querySelector(`label[for="${input.id}"]`)?.addEventListener('pointerdown', rememberIndeterminateState);
                  input.closest('.checkbox-custom')?.querySelector(`label[for="${input.id}"]`)?.addEventListener('mousedown', rememberIndeterminateState);

                  input.addEventListener('change', (e) => {
                      const fromIndeterminate = input.dataset.wasIndeterminate === '1';
                      input.dataset.wasIndeterminate = '0';
                      if (fromIndeterminate) {
                          setAllIssueChecks(false);
                          return;
                      }

                      setAllIssueChecks(!!e.target.checked);
                  });
              }

              bindSelectAllBehavior(checkAllInput);
              bindSelectAllBehavior(checkAllCardsInput);

              document.querySelectorAll('.issue-check').forEach((checkbox) => {
                  checkbox.addEventListener('change', () => {
                      document.querySelectorAll(`.issue-check[value="${checkbox.value}"]`).forEach((peer) => {
                          if (peer !== checkbox) {
                              peer.checked = checkbox.checked;
                          }
                      });
                      const allChecks = getSelectableIssueCheckboxes();
                      const checkedChecks = allChecks.filter((item) => item.checked).length;
                      const allChecked = allChecks.length > 0 && checkedChecks === allChecks.length;
                      const isIndeterminate = checkedChecks > 0 && checkedChecks < allChecks.length;
                      setSelectAllVisualState(checkAllInput, allChecked, isIndeterminate);
                      setSelectAllVisualState(checkAllCardsInput, allChecked, isIndeterminate);
                      syncHidden();
                      updateFilterSelectionRow();
                  });
              });
              [bulkStatusSelect, bulkDueDateInput, bulkResponsiblePartySelect, bulkResponsibleNameInput, bulkResponsibleEmailInput].forEach((input) => {
                  input?.addEventListener('input', updateFilterSelectionRow);
                  input?.addEventListener('change', updateFilterSelectionRow);
              });

              syncHidden();
              updateFilterSelectionRow();
              const initialChecks = getSelectableIssueCheckboxes();
              const initialCheckedCount = initialChecks.filter((item) => item.checked).length;
              const initialAllChecked = initialChecks.length > 0 && initialCheckedCount === initialChecks.length;
              const initialIndeterminate = initialCheckedCount > 0 && initialCheckedCount < initialChecks.length;
              setSelectAllVisualState(checkAllInput, initialAllChecked, initialIndeterminate);
              setSelectAllVisualState(checkAllCardsInput, initialAllChecked, initialIndeterminate);


              function updateFiltersChevron(){
                  if (!toggleFiltersChevron || !issuesFiltersPanel) return;
                  const isCollapsed = issuesFiltersPanel.classList.contains('is-collapsed');
                  toggleFiltersChevron.classList.toggle('bx-chevron-down', isCollapsed);
                  toggleFiltersChevron.classList.toggle('bx-chevron-up', !isCollapsed);
              }

              toggleFiltersButton?.addEventListener('click', () => {
                  issuesFiltersPanel?.classList.toggle('is-collapsed');
                  updateFiltersChevron();
              });

              if (!isMobileView) {
                  issuesFiltersPanel?.classList.remove('is-collapsed');
              }
              updateFiltersChevron();

            if (isMobileView || !window.jQuery || !window.jQuery.fn || !window.jQuery.fn.DataTable) {
                  filterSelects.forEach((el) => {
                      el.addEventListener('change', () => {
                          updateFilterSelectionRow();
                          filterForm?.submit();
                      });
                  });

                  let filterSearchTimer = null;
                  filterSearchInput?.addEventListener('input', () => {
                      clearTimeout(filterSearchTimer);
                      filterSearchTimer = setTimeout(() => filterForm?.submit(), 250);
                  });
              }

              initializeDataTableFilters();

              initializeIssueDetailModal();
              initializeIssueDeleteModal();
          })();
    </script>
}