               function updatePrioritySwitchFromValue(priorityValue){
                   if (!issuePriorityHighSwitch || !issuePriorityValue || !issuePriorityLabel) return;
                   const isHigh = String(priorityValue) === String(@((int)ConstructionIssuePriority.High));
                   issuePriorityHighSwitch.checked = isHigh;
                   issuePriorityValue.value = isHigh ? String(@((int)ConstructionIssuePriority.High)) : String(@((int)ConstructionIssuePriority.Normal));
                   issuePriorityLabel.textContent = isHigh ? 'Hoog' : 'Normaal';
               }

               function updateFilterSelectionRow(){
                if(!filterSelectionRow) return;
                const selectedCount = getSelectedIssueIds().length;
                const hasSelection = selectedCount > 0;
                filterSelectionRow.classList.toggle('d-none', !hasSelection);

                if (issuesSelectionCountLabel) {
                    issuesSelectionCountLabel.textContent = `${selectedCount} geselecteerd`;
                }

                if (bulkStatusButton) {
                    bulkStatusButton.disabled = !hasSelection || !bulkStatusSelect?.value;
                }

                if (bulkDueDateButton) {
                    bulkDueDateButton.disabled = !hasSelection || !bulkDueDateInput?.value;
                }

                if (bulkAssignButton) {
                    const hasAssignee = !!bulkResponsiblePartySelect?.value || !!bulkResponsibleNameInput?.value?.trim() || !!bulkResponsibleEmailInput?.value?.trim();
                    bulkAssignButton.disabled = !hasSelection || !hasAssignee;
                }
            }


           function initializeDataTableFilters(){
               if(isMobileView || !(window.jQuery && window.jQuery.fn && window.jQuery.fn.DataTable && issuesTable)) return;

                const getActiveFilters = () => ({
                    status: filterForm?.querySelector('[name="status"]')?.value || '',
                    responsiblePartyId: filterForm?.querySelector('[name="responsiblePartyId"]')?.value || '',
                    unitId: filterForm?.querySelector('[name="unitId"]')?.value || '',
                    overdue: filterForm?.querySelector('[name="overdue"]')?.value || '',
                    phase: filterForm?.querySelector('[name="phase"]')?.value || ''
                });

                const customFilter = (settings, _, dataIndex) => {
                    if (settings.nTable !== issuesTable) {
                        return true;
                    }

                    const filters = getActiveFilters();
                    const rowNode = settings.aoData?.[dataIndex]?.nTr;
                    if (!rowNode) {
                        return true;
                    }

                    const unitCell = rowNode.cells?.[2]?.textContent?.trim() || '';
                          const statusValue = rowNode.dataset.status || '';
                    const dueDateCell = rowNode.cells?.[7]?.textContent?.trim() || '';
                    const phaseCell = rowNode.cells?.[4]?.textContent?.trim() || '';
                    const responsiblePartyId = rowNode.dataset.responsiblePartyId || '';
                    const parseDueDateCell = (value) => {
                        if (!value || value === '-') {
                            return null;
                        }

                        const match = value.match(/^(\d{2})\/(\d{2})\/(\d{4})/);
                        if (!match) {
                            return null;
                        }

                        const day = Number(match[1]);
                        const monthIndex = Number(match[2]) - 1;
                        const year = Number(match[3]);
                        const date = new Date(year, monthIndex, day);

                        if (Number.isNaN(date.getTime())) {
                            return null;
                        }

                        date.setHours(0, 0, 0, 0);
                        return date;
                    };

                    const dueDate = parseDueDateCell(dueDateCell);
                    const today = new Date();
