        }

        #issuesFiltersPanel.is-collapsed {
            display: none;
        }

        #issuesFilterSelectionRow .d-flex {
            flex-direction: column;
            align-items: stretch !important;
            gap: 10px;
        }

        #issuesFilterSelectionRow form {
            width: 100%;
            flex-wrap: wrap !important;
        }

        .mobile-hide-filter {
            display: none !important;
        }

        .mobile-filter-action-row {
            display: flex;
            justify-content: flex-end;
            margin-top: 8px;
        }

        .issue-table-block {
            display: none;
        }

        .issues-mobile-cards {
            display: grid;
            gap: 12px;
        }

        .issue-item-card {
            border: 1px solid #d8dee4;
            border-radius: 8px;
            padding: 14px;
            background: #fff;
            width: 100%;
            max-width: 100%;
            overflow: hidden;
        }

        .issue-item-top {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            min-width: 0;
        }

        .issue-item-content {
            flex: 1;
            min-width: 0;
        }

        .issue-item-title {
            font-size: 1.05rem;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .issue-item-description {
            color: #6c757d;
            margin-bottom: 8px;
        }

        .issue-card-detail-trigger {
            color: inherit;
            text-decoration: none;
            display: block;
        }

        .issue-item-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

            .issue-item-meta .badge {
                font-size: .72rem;
                font-weight: 400;
                background: #eef2f6;
                color: #3c4a59;
                border: 1px solid #dde3ea;
                max-width: 100%;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

        #issueDetailModal {
            z-index: 200000 !important;
        }

        .issue-detail-mobile-actions {
            display: flex !important;
            justify-content: flex-end;
            gap: 8px;
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid #e3e6ea;
        }

            .issue-detail-mobile-actions .btn {
                width: 36px;
                height: 36px;
                padding: 0;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

        #issueDetailSendButton {
            display: none;
        }
    }
</style>
