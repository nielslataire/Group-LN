            margin-bottom: .5rem !important;
        }

        .project-issues-header-actions {
            display: none;
        }


        .project-issues-title-row {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .project-issues-back-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border: 1px solid #d8dee4;
            border-radius: 8px;
            color: #1f2d3d;
            text-decoration: none;
        }

        .project-issues-mobile-tab-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-bottom: 0;
        }

        .issues-mobile-nav-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        .project-issues-mobile-add {
            width: 38px;
            height: 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .issue-status-label-desktop {
            display: none;
        }

        .issue-status-label-mobile {
            display: inline;
        }

        .issue-status-widget .card-body {
            min-height: 70px;
            padding: 12px;
        }

        .issue-status-widget .summary {
            gap: 4px;
        }

            .issue-status-widget .summary h4 {
                margin: 0;
                font-size: 0.9rem;
            }

            .issue-status-widget .summary h2 {
                margin: 0;
                font-size: 1.5rem;
            }

        .issues-mobile-header,
        .issues-mobile-checkall,
        .issues-mobile-cards {
            display: block;
        }

        .issues-mobile-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        #toggleFiltersButton {
            display: inline-flex;
