                    const issueDetailPhotos = document.getElementById('issueDetailPhotos');
                    const issueDetailHistory = document.getElementById('issueDetailHistory');
                    const issueDetailNotifications = document.getElementById('issueDetailNotifications');
                    const issueDetailPlanBlock = document.getElementById('issueDetailPlanBlock');
                    const issueDetailPlanName = document.getElementById('issueDetailPlanName');
                    const issueDetailPlanCanvas = document.getElementById('issueDetailPlanCanvas');
                    const issueDetailPlanMarker = document.getElementById('issueDetailPlanMarker');
                    const issuePhotosTabButton = document.getElementById('issuePhotosTabButton');
                    const issueHistoryTabButton = document.getElementById('issueHistoryTabButton');
                    const issueNotificationTabButton = document.getElementById('issueNotificationTabButton');

            let dt = typeof DataTransfer !== 'undefined' ? new DataTransfer() : null;
            let dataTableInstance = null;
            let currentPdfDoc = null;
            let currentPlans = [];
            let currentPlanUrl = '';
            let planRenderRequestId = 0;
            const pdfJsApi = window.pdfjsLib || window['pdfjs-dist/build/pdf'] || null;
            let isPickMode = false;

            if (pdfJsApi) {
                pdfJsApi.GlobalWorkerOptions.workerSrc = 'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';
            }

            function syncHidden(){
                const ids = Array.from(document.querySelectorAll('.issue-check:checked')).map(x=>x.value);
                document.querySelectorAll('input.js-issue-id').forEach(x=>x.remove());
                document.querySelectorAll('form').forEach(f=>{
                    if(f.action.includes('BulkUpdate') || f.action.includes('SendSelected') || f.action.includes('DownloadPdf')){
                        ids.forEach(id=>{ const i=document.createElement('input'); i.type='hidden'; i.name=f.action.includes('DownloadPdf')?'issueIds':'IssueIds'; i.value=id; i.className='js-issue-id'; f.appendChild(i);});
                    }
                });
                 return ids.length;
            }

              function openBootstrapModal(modalInstance, modalElement){
                if(modalInstance){
                    modalInstance.show();
                    return;
                }

                if(window.jQuery && modalElement){
                    window.jQuery(modalElement).modal('show');
                }
            }
           function updateFilterSelectionRow(){
                if(!filterSelectionRow) return;
                const selectedCount = document.querySelectorAll('.issue-check:checked').length;
                const hasSelection = selectedCount > 0;
                filterSelectionRow.classList.toggle('d-none', !hasSelection);

                if (issuesSelectionCountLabel) {
                    issuesSelectionCountLabel.textContent = `${selectedCount} geselecteerd`;
                }

                if (bulkStatusButton) {
                    bulkStatusButton.disabled = !hasSelection || !bulkStatusSelect?.value;
                }

                if (bulkDueDateButton) {
                    bulkDueDateButton.disabled = !hasSelection || !bulkDueDateInput?.value;
                }

                if (bulkAssignButton) {
