            <ul class="nav nav-pills issues-tab-nav mb-2" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" type="button" data-bs-toggle="tab" data-bs-target="#issues-list-tab" aria-selected="true">
                        <i class="bx bx-list-ul me-1"></i>Lijst
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#issues-plan-tab" aria-selected="false">
                        <i class="bx bx-map-pin me-1"></i>Planoverzicht
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="issues-list-tab" role="tabpanel">
                    <section class="card card-modern issue-card">
                        <div class="card-body">

                    <form method="get" class="issues-filter-form mb-4" id="issuesFilterForm">
                        <div class="row g-3 align-items-end">
                            <div class="col-12 col-xl-4">
                                <label class="form-label">Zoeken</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bx bx-search"></i></span>
                                    <input class="form-control form-control-modern"
                                           name="text"
                                           value="@filters.Text"
                                           placeholder="Zoek op naam of locatie..." />
                                </div>
                            </div>

                            <div class="col-12 col-md-6 col-xl">
                                <label class="form-label">Status</label>
                                <select class="form-control form-control-modern js-auto-filter" name="status">
                                    <option value="">Alle statussen</option>
                                    @foreach (var s in Html.GetEnumSelectList<ConstructionIssueStatus>())
                                    {
                                        <option value="@s.Value" selected="@(filters.Status?.ToString() == s.Value)">@s.Text</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-md-6 col-xl">
                                <label class="form-label">Verantwoordelijke</label>
                                <select class="form-control form-control-modern js-auto-filter" name="responsiblePartyId">
                                    <option value="">Alle verantwoordelijken</option>
                                    @foreach (var c in Model.Form.ResponsibleContractors)
                                    {
                                        <option value="@c.ID" selected="@(filters.ResponsiblePartyId == c.ID)">@c.Display</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-md-6 col-xl">
                                <label class="form-label">Eenheid</label>
                                <select class="form-control form-control-modern js-auto-filter" name="unitId">
                                    <option value="">Alle eenheden</option>
                                    @foreach (var u in Model.Units)
                                    {
                                        <option value="@u.Id" selected="@(filters.UnitId == u.Id)">@u.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-md-6 col-xl">
                                <label class="form-label">Deadline</label>
                                <select class="form-control form-control-modern js-auto-filter" name="overdue">
                                    <option value="">Alle deadlines</option>
                                    <option value="true" selected="@(filters.Overdue == true)">Deadline vervallen</option>
                                    <option value="false" selected="@(filters.Overdue == false)">Niet vervallen</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-6 col-xl">
                                <label class="form-label">Verzending</label>
                                <select class="form-control form-control-modern js-auto-filter" name="sent">
                                    <option value="">Geen verzendstatus</option>
                                    <option value="true" selected="@(filters.Sent == true)">Verzonden</option>
                                    <option value="false" selected="@(filters.Sent == false)">Niet verzonden</option>
                                </select>
                            </div>
                        </div>
                    </form>
                            <div id="issuesFilterSelectionRow" class="py-2 px-3 mb-3 d-none issues-selection-toolbar" role="status">
                                <div class="d-flex align-items-center gap-2 flex-nowrap">
                                    <span id="issuesSelectionCountLabel" class="fw-semibold text-nowrap">0 geselecteerd</span>

                                    <span class="bulk-separatorms-2 me-2"></span>

                                    <form method="post" action="@Url.Action("BulkUpdate", new { projectId })" class="d-flex align-items-center gap-2 flex-nowrap mb-0">
                                        @Html.AntiForgeryToken()
                                        <select class="form-control form-control-modern" name="Status" id="bulkStatusSelect" style="min-width: 170px;">
                                            <option value="">Kies status</option>
                                            @foreach (var s in Html.GetEnumSelectList<ConstructionIssueStatus>())
                                            {
                                                <option value="@s.Value">@s.Text</option>
                                            }
                                        </select>
                                        <button type="submit" id="bulkStatusButton" class="btn btn-primary text-nowrap" disabled>
                                            <i class="bx bx-refresh me-1"></i>Status
                                        </button>
                                    </form>

                                    <span class="bulk-separator ms-2 me-2"></span>

                                    <form method="post" action="@Url.Action("BulkUpdate", new { projectId })" class="d-flex align-items-center gap-2 flex-nowrap mb-0">
                                        @Html.AntiForgeryToken()
                                        <input type="date" class="form-control form-control-modern" name="DueDate" id="bulkDueDateInput" style="min-width: 120px;" />
                                        <button type="submit" id="bulkDueDateButton" class="btn btn-primary text-nowrap" disabled>
                                            <i class="bx bx-calendar me-1"></i>Deadline
                                        </button>
                                    </form>

                                    <span class="bulk-separator ms-2 me-2"></span>

                                    <form method="post" action="@Url.Action("BulkUpdate", new { projectId })" class="d-flex align-items-center gap-2 flex-nowrap mb-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ResponsiblePartyType" value="@((int)ConstructionIssueResponsiblePartyType.Contractor)" />
                                        <select class="form-control form-control-modern" name="ResponsiblePartyId" id="bulkResponsiblePartySelect" style="min-width: 220px;">
                                            <option value="">Verantwoordelijke</option>
                                            @foreach (var c in Model.Form.ResponsibleContractors)
                                            {
                                                <option value="@c.ID">@c.Display</option>
                                            }
                                        </select>
                                        <input type="text" class="form-control form-control-modern" name="ResponsibleOtherName" id="bulkResponsibleNameInput" placeholder="Naam" style="min-width: 120px;" />
                                        <input type="email" class="form-control form-control-modern" name="ResponsibleOtherEmail" id="bulkResponsibleEmailInput" placeholder="E-mail" style="min-width: 220px;" />
                                        <button type="submit" id="bulkAssignButton" class="btn btn-primary text-nowrap" disabled>
                                            <i class="bx bx-user-plus me-1"></i>Toewijzen
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <div class="issue-table-block">
                        <div class="table-responsive issue-table-wrapper">
                            <table class="table issue-table mb-0" id="datatable-issues" style="min-width: 1100px;">
                                <thead>
                                    <tr>
                                        <th class="col-check">
                                            <div class="checkbox-custom checkbox-default d-inline-block">
                                                <input type="checkbox" id="checkAll" />
                                                <label for="checkAll"></label>
                                            </div>
                                        </th>
                                        <th>Titel</th>
                                        <th>Unit</th>
                                        <th>Categorie</th>
                                        <th>Locatie</th>
                                        <th>Status</th>
                                        <th>Prioriteit</th>
                                        <th>Vervaldatum</th>
                                        <th>Laatst verzonden</th>
                                        <th class="text-end noVis">Acties</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var i in Model.Issues)
                                    {
                                        <tr data-responsible-party-id="@(i.ResponsiblePartyId?.ToString() ?? string.Empty)">
                                            <td class="col-check">
                                                <div class="checkbox-custom checkbox-default d-inline-block">
                                                    <input type="checkbox" class="issue-check" value="@i.Id" id="issue_@i.Id" />
                                                    <label for="issue_@i.Id"></label>
                                                </div>
                                            </td>
                                            <td>@i.Title</td>
                                            <td>@(i.Unit?.Name ?? "-")</td>
                                            <td>@(i.Category?.Name ?? "-")</td>
                                            <td>@i.LocationText</td>
                                            <td>@((ConstructionIssueStatus)i.Status)</td>
                                            <td>@((ConstructionIssuePriority)i.Priority)</td>
                                            <td>@(i.DueDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                            <td>@(i.LastSentDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                            <td class="actions text-end">
                                                <a href="@Url.Action("DetailData", "ProjectsIssues", new { projectId, id = i.Id })"
                                                   class="btn ms-1 me-1 open-detail-issue"
                                                   title="Details"
                                                   data-id="@i.Id">
                                                    <i class="bx bx-show fs-5"></i>
                                                </a>
                                                <a href="@Url.Action("EditData", "ProjectsIssues", new { projectId, id = i.Id })"
                                                   class="btn ms-1 me-1 open-edit-issue"
                                                   title="Bewerken"
                                                   data-id="@i.Id">
                                                    <i class="bx bx-pencil fs-5"></i>
                                                </a>
                                                <a href="#modaldeleteissue"
                                                   title="Verwijderen"
                                                   class="deleteIssue ms-1 me-1"
                                                   data-id="@i.Id">
                                                    <i class="bx bx-trash fs-5 text-danger"></i>
                                                    <span class="visually-hidden">Verwijderen</span>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                                <div class="issue-table-footer">
                                    <div id="datatable-issues-external-footer"></div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
                <div class="tab-pane fade" id="issues-plan-tab" role="tabpanel">
                    <section class="card card-modern mb-4">
                        <div class="card-body">
                            Dit is later op te vullen.
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</section>
