@using BOCore
@using DALCore.Models
@using System.Text.Json

@model CPMCore.Models.Issues.ConstructionIssueIndexVm
@{
    var projectId = Model.ProjectId;
    var filters = Model.Filters;
    ViewData["Title"] = "Punten";
    var today = DateOnly.FromDateTime(DateTime.Today);
    var openCount = Model.Issues.Count(i => i.Status == (int)ConstructionIssueStatus.Open);
    var waitingInspectionCount = Model.Issues.Count(i => i.Status == (int)ConstructionIssueStatus.WaitingInspection);
    var resolvedCount = Model.Issues.Count(i => i.Status == (int)ConstructionIssueStatus.Resolved);
    var criticalCount = Model.Issues.Count(i => i.DueDate.HasValue && i.DueDate.Value < today);
}
<style>
    #issueModal .modal-content {
        max-height: 90vh;
    }

    #issueModal form {
        min-height: 0;
    }

    #issueModal .modal-body {
        overflow-y: auto;
        min-height: 0;
    }

    .issues-tab-nav {
        background-color: #f3f5f7;
        border-radius: 6px;
        padding: 6px;
        gap: 4px;
    }

        .issues-tab-nav .nav-link {
            color: #6c757d;
            font-weight: 600;
            border-radius: 6px;
            border: 1px solid transparent;
            padding: 10px 16px;
        }

            .issues-tab-nav .nav-link.active {
                background-color: #ffffff;
                color: #1f2d3d;
                border-color: #e3e6ea;
                box-shadow: 0 1px 1px rgba(0, 0, 0, 0.05);
            }

    .issue-status-widget {
        border: 1px solid var(--primary, #0088cc);
        border-radius: 6px;
    }

    .issues-selection-toolbar {
        overflow-x: auto;
        border-radius: 6px;
        padding: 6px;
        gap: 4px;
    }

        .issues-selection-toolbar .bulk-separator {
            width: 1px;
            align-self: stretch;
            background-color: rgba(0, 0, 0, 0.15);
        }

        .issue-status-widget .card-body {
            min-height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .issue-status-widget .summary {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
</style>
@section PageStyle {
    <link rel="stylesheet" href="~/lib/magnific-popup/magnific-popup.css" />
    <link rel="stylesheet" href="~/lib/datatables/media/css/dataTables.bootstrap5.css" />
    <link href="https://cdn.datatables.net/v/bs5/jszip-3.10.1/dt-2.2.2/b-3.2.2/b-colvis-3.2.2/b-html5-3.2.2/b-print-3.2.2/datatables.min.css" rel="stylesheet" integrity="sha384-W8PzvGseaJlM52wTjdPHNrEA9WHp36V+XpQyv1gCKz+1sbFfDo5MlMDT7awB3rAs" crossorigin="anonymous">
}

<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", projectId)
        <div class="inner-body">
            <div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
                <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
                    <h1 class="font-weight-bold mb-0 mt-0">Punten</h1>
                    <h5 class="mb-4 mt-0">Overzicht van projectissues</h5>
                </div>
                <div class="col-sm-auto px-0">
