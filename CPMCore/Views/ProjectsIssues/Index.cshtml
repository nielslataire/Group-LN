                   if (responsibleSelect) responsibleSelect.value = '';
                   if (unitSelect) unitSelect.value = '';
                   if (overdueSelect) overdueSelect.value = '';
                   if (phaseSelect) phaseSelect.value = '';

                   if (isMobileView) {
