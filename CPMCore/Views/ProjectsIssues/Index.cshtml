                    const bulkDueDateInput = document.getElementById('bulkDueDateInput');
                    const bulkDueDateButton = document.getElementById('bulkDueDateButton');
                    const bulkResponsiblePartySelect = document.getElementById('bulkResponsiblePartySelect');
                    const bulkResponsibleNameInput = document.getElementById('bulkResponsibleNameInput');
                    const bulkResponsibleEmailInput = document.getElementById('bulkResponsibleEmailInput');
                    const bulkAssignButton = document.getElementById('bulkAssignButton');
                    const checkAllInput = document.getElementById('checkAll');
                    const issueDetailModalEl = document.getElementById('issueDetailModal');
