            async function postIssueDetailUpdate(fields){
                if (!currentDetailIssueId) return false;

                const token = getRequestVerificationToken();
                if (!token) return false;

                const body = new URLSearchParams();
                body.append('__RequestVerificationToken', token);
                body.append('IssueIds', String(currentDetailIssueId));
                Object.entries(fields).forEach(([key, value]) => {
                    if (value === null || value === undefined) return;
                    body.append(key, String(value));
                });

                const response = await fetch(`/Projects/${projectId}/Issues/BulkUpdate`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: body.toString()
                });

                return response.ok;
            }

            async function refreshIssueDetailData(issueId){
                const response = await fetch(`/Projects/${projectId}/Issues/DetailData/${issueId}`);
                if (!response.ok) return null;
                return await response.json();
            }

            async function updateIssueDetailFields(fields){
                detailInlineState.isFieldSyncing = true;
                try {
                    const updated = await postIssueDetailUpdate(fields);
                    if (!updated || !currentDetailIssueId) return;

                    const refreshedData = await refreshIssueDetailData(currentDetailIssueId);
                    if (refreshedData) {
                        renderIssueDetailModal(refreshedData);
                    }
                } finally {
                    detailInlineState.isFieldSyncing = false;
                }
            }

