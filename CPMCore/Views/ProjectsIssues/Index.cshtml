                    const url = URL.createObjectURL(blob);
                    const printWindow = window.open(url, '_blank');
                    if (!printWindow) {
                        alert('Kon geen nieuw venster openen voor afdrukken.');
                        URL.revokeObjectURL(url);
                        return;
                    }

                    const revoke = () => setTimeout(() => URL.revokeObjectURL(url), 10000);
                    printWindow.addEventListener('load', () => {
                        printWindow.focus();
                        printWindow.print();
                        revoke();
