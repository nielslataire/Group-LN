                                </div>
                            </div>
                        </div>
                    </section>
</div>
                <div class="col">
                    <section class="card issue-status-widget mb-0">
                        <div class="card-body bg-primary">
                            <div class="widget-summary widget-summary-sm">
                                <div class="widget-summary-col">
                                    <div class="summary align-content-center">
                                        <h4 class="title">Wachten op controle</h4>
                                        <h2 class="mt-0 color-primary">@waitingInspectionCount</h2>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
                <div class="col">
                    <section class="card issue-status-widget mb-0">
                        <div class="card-body bg-primary">
                            <div class="widget-summary widget-summary-sm">
                                <div class="widget-summary-col">
                                    <div class="summary align-content-center">
                                        <h4 class="title">Opgelost</h4>
                                        <h2 class="mt-0 color-primary">@resolvedCount</h2>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
                <div class="col">
                    <section class="card issue-status-widget mb-0">
                        <div class="card-body bg-primary">
                            <div class="widget-summary widget-summary-sm">
                                <div class="widget-summary-col">
                                    <div class="summary align-content-center">
                                        <h4 class="title">Kritiek</h4>
                                        <h2 class="mt-0 color-primary">@criticalCount</h2>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
    
