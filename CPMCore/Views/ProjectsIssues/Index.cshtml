            const planEmpty = document.getElementById('planEmpty');
            const planSurface = document.getElementById('planSurface');
            const planCanvas = document.getElementById('planCanvas');
            const planFrame = document.getElementById('planFrame');
            const planOverlay = document.getElementById('planOverlay');
            const planMarker = document.getElementById('planMarker');
            const planDocumentIdInput = document.getElementById('planDocumentId');
            const planPageNumberInput = document.getElementById('planPageNumber');
            const planXNormalizedInput = document.getElementById('planXNormalized');
            const planYNormalizedInput = document.getElementById('planYNormalized');
            const planCtx = planCanvas.getContext('2d');
                      const responsiblePartyField = document.getElementById('issueResponsiblePartyId');
                    const responsibleNameField = document.getElementById('issueResponsibleOtherName');
                    const responsibleEmailField = document.getElementById('issueResponsibleOtherEmail');
                    const planUploadInput = document.getElementById('issuePlanUploadInput');
                    const planUploadName = document.getElementById('issuePlanUploadName');
                    const planUploadButton = document.getElementById('issuePlanUploadButton');
                    const deleteIssueModalSelector = '#modaldeleteissue';
                    const deleteIssueContainerSelector = '#delete-issue-container';
                    const filterForm = document.getElementById('issuesFilterForm');
         const filterSearchInput = filterForm?.querySelector('input[name="text"]');
                    const filterSelects = Array.from(filterForm?.querySelectorAll('.js-auto-filter') || []);
                    const filterSelectionRow = document.getElementById('issuesFilterSelectionRow');
