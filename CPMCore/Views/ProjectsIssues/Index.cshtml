@using BOCore
@using DALCore.Models
@using System.Text.Json

@model CPMCore.Models.Issues.ConstructionIssueIndexVm
@{
    var projectId = Model.ProjectId;
    var filters = Model.Filters;
    ViewData["Title"] = "Punten";
    var today = DateOnly.FromDateTime(DateTime.Today);
    var openCount = Model.Issues.Count(i => i.Status == (int)ConstructionIssueStatus.Open);
    var waitingInspectionCount = Model.Issues.Count(i => i.Status == (int)ConstructionIssueStatus.WaitingInspection);
    var resolvedCount = Model.Issues.Count(i => i.Status == (int)ConstructionIssueStatus.Resolved);
    var criticalCount = Model.Issues.Count(i => i.DueDate.HasValue && i.DueDate.Value < today);
    var visibleStatuses = new[]
    {
        ConstructionIssueStatus.Open,
        ConstructionIssueStatus.InProgress,
        ConstructionIssueStatus.WaitingInspection,
        ConstructionIssueStatus.Resolved,
        ConstructionIssueStatus.Rejected,
        ConstructionIssueStatus.Reopened
    };
}
<style>
    #issueModal .modal-content {
        max-height: 90vh;
    }

    #issueModal form {
        min-height: 0;
    }

    #issueModal .modal-body {
        overflow-y: auto;
        min-height: 0;
    }

    .issues-tab-nav {
        background-color: #f3f5f7;
        border-radius: 6px;
        padding: 6px;
        gap: 4px;
    }

        .issues-tab-nav .nav-link {
            color: #6c757d;
            font-weight: 600;
            border-radius: 6px;
            border: 1px solid transparent;
            padding: 10px 16px;
        }

            .issues-tab-nav .nav-link.active {
                background-color: #ffffff;
                color: #1f2d3d;
                border-color: #e3e6ea;
                box-shadow: 0 1px 1px rgba(0, 0, 0, 0.05);
            }

    .issue-status-widget {
        border: 1px solid var(--primary, #0088cc);
        border-radius: 6px;
    }

    .issues-selection-toolbar {
        overflow-x: auto;
        border: 1px solid #e3e6ea;
        border-radius: 6px;
        padding: 6px;
        gap: 4px;
        box-shadow: none;
    }

        .issues-selection-toolbar .form-control {
            min-height: 38px;
        }

        .issues-selection-toolbar .btn {
            min-height: 38px;
        }

    .issues-tab-nav-light {
        background-color: var(--bs-light, #f8f9fa);
    }

    #issueDetailTab .issue-plan-stage {
        position: relative;
        display: inline-block;
        max-width: 100%;
        line-height: 0;
    }

    #issueDetailTab .issue-plan-canvas {
        display: block;
        width: auto;
        height: auto;
        max-width: 100%;
    }

    .issue-plan-marker,
    #planMarker,
    #issueDetailPlanMarker {
        position: absolute;
        display: none;
        z-index: 10;
        pointer-events: none;
        line-height: 1;
        transform: translate(-50%, -100%);
    }

        .issue-plan-marker i,
        #planMarker i,
        #issueDetailPlanMarker i {
            font-size: 28px;
            color: red; /* rood */
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35), 0 0 2px rgba(255, 255, 255, 0.75);
        }

    .issue-detail-inline-edit .form-control {
        min-height: 38px;
    }

    .priority-alert-icon {
        color: #dc3545;
        margin-right: 6px;
        vertical-align: text-bottom;
    }

    .issue-priority-high-badge {
        background: #dc3545;
        color: #fff;
    }

    .issue-table .room-place-cell {
        white-space: nowrap;
    }

    .checkbox-custom.is-indeterminate label:before {
        background: #dde3e9;
        border-color: #b6c0ca;
    }

    .checkbox-custom.is-indeterminate label:after {
        display: none !important;
        content: none !important;
    }


        .issues-selection-toolbar .bulk-separator {
            width: 1px;
            align-self: stretch;
            background-color: rgba(0, 0, 0, 0.15);
        }

        .issue-status-widget .card-body {
            min-height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .issue-status-widget .summary {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

    .issues-mobile-header,
    .issues-mobile-checkall,
    .issues-mobile-cards,
    .issue-status-label-mobile,
    .project-issues-mobile-tab-actions,
    .issue-detail-mobile-actions,
    .project-issues-back-link {
        display: none;
    }

    @@media (min-width: 768px) {
        .project-issues-mobile-tab-actions,
        .issues-mobile-header,
        .issues-mobile-checkall,
        .issues-mobile-cards,
        .issue-detail-mobile-actions {
            display: none !important;
        }

        .issue-table-block {
            display: block !important;
        }

        .issue-table td.actions {
            white-space: nowrap;
        }

        .issue-table .actions .open-detail-issue,
        .issue-table .actions .open-edit-issue,
        .issue-table .actions .open-duplicate-issue,
        .issue-table .actions .deleteIssue {
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
            visibility: visible !important;
            opacity: 1 !important;
        }
    }

    @@media (max-width: 767.98px) {
        .project-issues-heading-row {
            padding-top: .25rem !important;
        }

        .project-issues-heading-col {
            margin-top: .25rem !important;
            margin-bottom: .5rem !important;
        }

