            function getSelectedIssueIds(){
                return Array.from(new Set(
                    Array.from(document.querySelectorAll('.issue-check:checked'))
                        .map(x => Number(x.value))
                        .filter(Number.isFinite)
                ));
            }

            function isElementVisible(el){
                if (!el) return false;
                if (el.closest('.d-none')) return false;
                const style = window.getComputedStyle(el);
                return style.display !== 'none' && style.visibility !== 'hidden';
            }

            function getSelectableIssueCheckboxes(){
                         if (dataTableInstance && typeof dataTableInstance.rows === 'function') {
                            const visibleIssueIds = new Set(
                                dataTableInstance
                                    .rows({ search: 'applied', page: 'current' })
                                    .nodes()
                                    .toArray()
                                    .map((row) => row?.querySelector('.issue-check')?.value)
                                    .filter((value) => value !== null && value !== undefined && value !== '')
                            );

                            if (visibleIssueIds.size > 0) {
                                return Array.from(document.querySelectorAll('.issue-check'))
                                    .filter((checkbox) => visibleIssueIds.has(checkbox.value))
                                    .filter(isElementVisible);
                            }
                        }
                return Array.from(document.querySelectorAll('.issue-check')).filter((checkbox) => {
                    const row = checkbox.closest('tr');
                    if (row) {
                        return isElementVisible(row);
                    }

                    const card = checkbox.closest('.issue-item-card');
                    if (card) {
                        return isElementVisible(card);
                    }

                    return isElementVisible(checkbox);
                });
