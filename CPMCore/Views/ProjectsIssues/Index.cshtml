           function initializeDataTableFilters(){
                if(!(window.jQuery && window.jQuery.fn && window.jQuery.fn.DataTable && issuesTable)) return;

                const getActiveFilters = () => ({
                    status: filterForm?.querySelector('[name="status"]')?.value || '',
                    responsiblePartyId: filterForm?.querySelector('[name="responsiblePartyId"]')?.value || '',
                    unitId: filterForm?.querySelector('[name="unitId"]')?.value || '',
                    overdue: filterForm?.querySelector('[name="overdue"]')?.value || '',
                    sent: filterForm?.querySelector('[name="sent"]')?.value || ''
                });

                const customFilter = (settings, _, dataIndex) => {
                    if (settings.nTable !== issuesTable) {
                        return true;
                    }

                    const filters = getActiveFilters();
                    const rowNode = settings.aoData?.[dataIndex]?.nTr;
                    if (!rowNode) {
                        return true;
                    }

                    const unitCell = rowNode.cells?.[2]?.textContent?.trim() || '';
                    const statusCell = rowNode.cells?.[5]?.textContent?.trim() || '';
                    const dueDateCell = rowNode.cells?.[7]?.textContent?.trim() || '';
                    const sentCell = rowNode.cells?.[8]?.textContent?.trim() || '';
                    const responsiblePartyId = rowNode.dataset.responsiblePartyId || '';
                    const parseDueDateCell = (value) => {
                        if (!value || value === '-') {
                            return null;
                        }

                        const match = value.match(/^(\d{2})\/(\d{2})\/(\d{4})/);
                        if (!match) {
                            return null;
                        }

                        const day = Number(match[1]);
                        const monthIndex = Number(match[2]) - 1;
                        const year = Number(match[3]);
                        const date = new Date(year, monthIndex, day);

                        if (Number.isNaN(date.getTime())) {
                            return null;
                        }

                        date.setHours(0, 0, 0, 0);
                        return date;
                    };

                    const dueDate = parseDueDateCell(dueDateCell);
                    const today = new Date();
                    today.setHours(0, 0, 0, 0);

                    if (filters.status) {
                        const selectedStatusText = filterForm?.querySelector(`[name="status"] option[value="${filters.status}"]`)?.textContent?.trim() || '';
                        if (!selectedStatusText || statusCell !== selectedStatusText) {
                            return false;
                        }
                    }

                    if (filters.unitId) {
                        const selectedUnitText = filterForm?.querySelector(`[name="unitId"] option[value="${filters.unitId}"]`)?.textContent?.trim() || '';
                        if (!selectedUnitText || unitCell !== selectedUnitText) {
                            return false;
                        }
                    }

                    if (filters.responsiblePartyId && responsiblePartyId !== filters.responsiblePartyId) {
                        return false;
                    }

                    if (filters.overdue === 'true' && (!dueDateCell || dueDateCell === '-')) {
                        return false;
                    }

                    if (filters.sent === 'true' && (!sentCell || sentCell === '-')) {
                        return false;
                    }

                    if (filters.sent === 'false' && sentCell !== '-') {
                        return false;
                    }

                    return true;
                };

                window.jQuery.fn.dataTable.ext.search.push(customFilter);

                dataTableInstance = window.jQuery(issuesTable).DataTable({
                    pageLength: 25,
                    searching: true,
                    lengthChange: false,
                    dom: 't<"dt-hidden-footer"ip>',
                    order: [[7, 'asc']],
                    columnDefs: [
                        { targets: [0, 9], orderable: false, searchable: false }
                    ],
                    language: {
                        processing: 'Bezig met verwerken…',
                        search: 'Zoeken:',
                        lengthMenu: 'Toon _MENU_',
                        info: 'Punten _START_ tot _END_ van _TOTAL_ punten',
                        infoEmpty: 'Punten 0 tot 0 van 0 punten',
                        infoFiltered: '(gefilterd uit _MAX_ totaal)',
                        loadingRecords: 'Bezig met laden…',
                        zeroRecords: 'Geen punten om weer te geven',
                        emptyTable: 'Er zijn geen punten om weer te geven'
                    }
                });

                     function moveIssueTableFooter() {
                        var $wrapper = $('#datatable-issues_wrapper');
                        var $footerHost = $('#datatable-issues-external-footer');

                        var $info = $wrapper.find('.dataTables_info, .dt-info');
                        var $paginate = $wrapper.find('.dataTables_paginate, .dt-paging');

                        if ($info.length || $paginate.length) {
                            $footerHost.html('');
                            $footerHost.append(
