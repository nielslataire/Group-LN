@model CPMCore.Models.Instellingen.BlogArtikelListVM
@{
    ViewData["Title"] = "Blog artikelen";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Blog artikelen</h1>
        <p class="text-muted mb-0">Beheer de artikelen die op de website verschijnen.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Instellingen")" class="btn btn-outline-secondary">
            <i class="bx bx-arrow-back"></i> Instellingen
        </a>
        <a href="@Url.Action("Aanmaken")" class="btn btn-primary">
            <i class="bx bx-plus"></i> Nieuw artikel
        </a>
    </div>
</div>

@if (!Model.Artikelen.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bx bx-news" style="font-size: 3rem; color: #adb5bd;"></i>
            <p class="mt-3 text-muted">Er zijn nog geen artikelen. Maak je eerste artikel aan.</p>
            <a href="@Url.Action("Aanmaken")" class="btn btn-primary mt-2">
                <i class="bx bx-plus"></i> Nieuw artikel
            </a>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;"></th>
                        <th>Titel</th>
                        <th>Datum</th>
                        <th>Status</th>
                        <th style="width: 120px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var artikel in Model.Artikelen)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(artikel.FotoBestand))
                                {
                                    <img src="@artikel.FotoBestand" alt="" class="rounded" style="width: 48px; height: 48px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="rounded bg-light d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        <i class="bx bx-image text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold">@artikel.Titel</div>
                                <div class="text-muted small">@artikel.Slug</div>
                            </td>
                            <td>@artikel.Datum.ToString("d-MM-yyyy")</td>
                            <td>
                                @if (artikel.IsGepubliceerd)
                                {
                                    <span class="badge bg-success">Gepubliceerd</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Concept</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="@Url.Action("Bewerken", new { id = artikel.ID })" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bx bx-edit"></i>
                                </a>
                                <form method="post" action="@Url.Action("Verwijderen")" class="d-inline"
                                      onsubmit="return confirm('Weet je zeker dat je dit artikel wil verwijderen?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@artikel.ID" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bx bx-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
