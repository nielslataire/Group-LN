@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@model CPMCore.Models.Home.HomeModel


@{
    var isRoleDashboard = Model.DashboardType is CPMCore.Models.DashboardType.Projectleider
        or CPMCore.Models.DashboardType.CeoCfo
        or CPMCore.Models.DashboardType.Boekhouding;
}

@section PageStyle
{
@if (isRoleDashboard)
{
    @* Gedeelde componentbibliotheek voor alle rol-dashboards: KPI-strip,
       urgentie-gegroepeerd meldingencentrum, sectiekop, werf-kaart-grid. *@
    <link rel="stylesheet" href="~/css/dashboard-projectleider.css" asp-append-version="true" />
}
else
{
    <link rel="stylesheet" href="~/css/home-custom.css" asp-append-version="true" />
}
}

@section PageScripts
{
@if (!isRoleDashboard)
{
    <script src="~/lib/isotope/isotope.js" asp-append-version="true"></script>
    <script>
        (function () {
            var grid = document.getElementById('project-grid');
            if (!grid || typeof jQuery === 'undefined' || !jQuery.fn.isotope) { return; }

            var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            var $grid = jQuery(grid).isotope({
                itemSelector: '.filteritem',
                percentPosition: true,
                layoutMode: 'fitRows',
                transitionDuration: reduceMotion ? 0 : '0.3s'
            });

            // Kaarten hebben een vaste aspect-ratio, maar herbereken de layout
            // zodra alle afbeeldingen geladen zijn (vangnet tegen late reflow).
            jQuery(window).on('load', function () { $grid.isotope('layout'); });

            jQuery('.filter-link').on('click', function (e) {
                e.preventDefault();
                $grid.isotope({ filter: this.getAttribute('data-filter') });
                jQuery('.filter-link').removeClass('active').attr('aria-pressed', 'false');
                jQuery(this).addClass('active').attr('aria-pressed', 'true');
            });
        })();
    </script>
}
}
@if (Model.DashboardType == CPMCore.Models.DashboardType.Projectleider)
{
    await Html.RenderPartialAsync("_DashboardProjectleider", Model);
}
else if (Model.DashboardType == CPMCore.Models.DashboardType.CeoCfo)
{
    await Html.RenderPartialAsync("_DashboardCeoCfo", Model);
}
else if (Model.DashboardType == CPMCore.Models.DashboardType.Boekhouding)
{
    await Html.RenderPartialAsync("_DashboardBoekhouding", Model);
}
else
{
	<h1 class="visually-hidden">Dashboard</h1>

	<div class="row row-gutter-sm mb-5">
		<div class="col-12 col-lg-8 col-xxl-9">

		@if (!Model.Projects.Any())
		{
			<div class="card card-modern">
				<div class="card-body bg-light text-center text-color-dark">
					<p class="mb-1"><strong>Geen projecten gevonden</strong></p>
					<p class="mb-0 text-2">Er zijn nog geen projecten aan je toegewezen. <a href="@Url.Action("Index", "Projecten")">Bekijk alle projecten</a>.</p>
				</div>
			</div>
		}
		else
		{
		<div class="row row-gutter-sm" id="project-grid">

				@foreach (var project in Model.Projects)
				{
					var detailUrl = Url.Action("Detail", "Projecten", new { projectid = project.Id });
					var hasPhoto = !string.IsNullOrEmpty(project.StandardFotoName) || project.DefaultPicture.Name is not null;
					string imgUrl;
					if (!string.IsNullOrEmpty(project.StandardFotoName)) { imgUrl = Configuration["URL:ImageWebUrl"] + "pictures/447/" + project.StandardFotoName; }
					else if (project.DefaultPicture.Name is not null) { imgUrl = Configuration["URL:ImageWebUrl"] + "pictures/447/" + project.DefaultPicture.Name; }
					else { imgUrl = Url.Content("~/img/no_image.jpg"); }

					<div class="col-12 col-sm-6 col-lg-4 col-xxl-3 mb-4 filteritem Status@(project.Status.Id)">
						<div class="card card-modern card-modern-alt-padding @(hasPhoto ? "" : "card-no-photo")">
							<a href="@detailUrl" tabindex="-1" aria-hidden="true">
								<img src="@imgUrl" class="card-img-top" alt="" loading="lazy" width="640" height="480" />
							</a>
							<div class="card-body bg-light">
								<small class="d-block dashboard-card-place">@project.Postalcode.Gemeente</small>
								<h2 class="text-4 line-height-2 mt-0 mb-0"><a href="@detailUrl" class="text-color-dark text-color-hover-primary text-decoration-none">@project.Name</a></h2>
							</div>
						</div>
					</div>
				}
		</div>
		}

		</div>
		<div class="col-12 col-lg-4 col-xxl-3 mt-4 mt-lg-0">

			<div class="card card-modern">
				<div class="card-header">
					<div class="card-actions">
						<button type="button" class="card-action card-action-toggle" data-card-toggle aria-label="Kaart in-/uitklappen"></button>
					</div>
					<h2 class="card-title">Filter status</h2>
				</div>
				<div class="card-body">
					<ul class="list list-unstyled mb-0 filters">
						<li><button type="button" class="filter-link active" data-filter="*" aria-pressed="true">Alle projecten</button></li>
						@foreach (var status in Model.Statuses)
						{
							<li><button type="button" class="filter-link" data-filter=".Status@(status.Id)" aria-pressed="false">@status.Name</button></li>
						}
					</ul>
				</div>
			</div>

		</div>
	</div>
} @* end else (non-projectleider dashboard) *@
