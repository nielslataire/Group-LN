    <div class="gl-mob-sheet-overlay" id="gl-pin-overlay"></div>
    <div class="gl-mob-sheet-panel">
        <div class="gl-mob-sheet-handle"></div>
        <div class="gl-mob-sheet-header">
            <span>Project vastzetten</span>
            <button type="button" id="gl-pin-close" aria-label="Sluiten">&times;</button>
        </div>
