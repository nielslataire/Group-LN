@model CPMCore.Models.Home.HomeModel
@using CPMCore.Helpers
@using CPMCore.Models
@using Microsoft.Extensions.Configuration
@using BOCore
@inject IConfiguration Configuration

@{
    var uitvoeringStatusId  = (int)ProjectStatusType.Uitvoering;
    var opgeleverdStatusId  = (int)ProjectStatusType.Opgeleverd;
    var ontwerpStatusId     = (int)ProjectStatusType.Ontwerp;
    var myProjects          = Model.Projects.ToList();
    var activeProjects      = myProjects.Where(p => p.Status.Id == uitvoeringStatusId || p.Status.Id == ontwerpStatusId).ToList();
    var nietOpgeleverd      = myProjects.Where(p => p.Status.Id != opgeleverdStatusId).ToList();
    var werfProjects        = activeProjects.Any() ? activeProjects : myProjects;
    var myProjectIds       = myProjects.Select(p => p.Id).ToHashSet();

    var displayName = User.GetCpmDisplayName() ?? string.Empty;
    var voornaam    = displayName.Split(' ').FirstOrDefault() ?? displayName;
    var imgBase     = Configuration["URL:ImageWebUrl"] ?? string.Empty;

    // Meldingen enkel voor eigen projecten, met category (enum) en bekijk-URL per bron
    var meldingen = new List<(string Tekst, int ProjectId, string Severity, string BekijkUrl, MeldingType Category)>();
    if (Model.InsuranceWarnings != null)
        meldingen.AddRange(Model.InsuranceWarnings
            .Where(w => myProjectIds.Contains(w.ProjectId))
            .Select(w => (w.Display ?? string.Empty, w.ProjectId, w.Type ?? "danger",
                Url.Action("DetailInsurances", "Projecten", new { projectid = w.ProjectId }) ?? "#",
                MeldingTypeHelper.FromString(w.Category))));
    if (Model.ProjectInfo != null)
        meldingen.AddRange(Model.ProjectInfo
            .Where(w => myProjectIds.Contains(w.ProjectId))
            .Select(w => (w.Display ?? string.Empty, w.ProjectId, w.Type ?? "warning",
                Url.Action("Detail", "Projecten", new { projectid = w.ProjectId }) ?? "#",
                MeldingTypeHelper.FromString(w.Category))));

    // Prioriteitsgroepen
    var urgentMeldingen  = meldingen.Where(m => m.Severity == "danger").ToList();
    var normaleMeldingen = meldingen.Where(m => m.Severity == "warning").ToList();
    var infoMeldingen    = meldingen.Where(m => m.Severity != "danger" && m.Severity != "warning").ToList();
}

<!-- ── KPI STRIP ──────────────────────────────────────────── -->
<div class="row gl-kpi-strip mb-2">
    <div class="col-12 col-md-6 col-xl-3 mb-3">
        <section class="card card-featured-left card-featured-primary h-100 mb-0">
            <div class="card-body d-flex align-items-center">
                <div class="widget-summary widget-summary-md w-100">
                    <div class="widget-summary-col widget-summary-col-icon">
                        <div class="summary-icon bg-primary">
                            <i class="bx bx-buildings"></i>
                        </div>
                    </div>
                    <div class="widget-summary-col">
                        <div class="summary">
                            <h4 class="title">Actieve projecten</h4>
                            <div class="info">
                                <strong class="amount">@nietOpgeleverd.Count</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    <div class="col-12 col-md-6 col-xl-3 mb-3">
        <section class="card card-featured-left card-featured-primary h-100 mb-0">
            <div class="card-body d-flex align-items-center">
                <div class="widget-summary widget-summary-md w-100">
                    <div class="widget-summary-col widget-summary-col-icon">
                        <div class="summary-icon bg-primary">
                            <i class="bx bx-task"></i>
                        </div>
                    </div>
                    <div class="widget-summary-col">
                        <div class="summary">
                            <h4 class="title">Open punten</h4>
                            <div class="info">
                                <strong class="amount">—</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    <div class="col-12 col-md-6 col-xl-3 mb-3">
        <section class="card card-featured-left card-featured-primary h-100 mb-0">
            <div class="card-body d-flex align-items-center">
                <div class="widget-summary widget-summary-md w-100">
                    <div class="widget-summary-col widget-summary-col-icon">
                        <div class="summary-icon bg-primary">
                            <i class="bx bx-alert-circle"></i>
                        </div>
                    </div>
                    <div class="widget-summary-col">
                        <div class="summary">
                            <h4 class="title">Urgent</h4>
                            <div class="info">
                                <strong class="amount">—</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    <div class="col-12 col-md-6 col-xl-3 mb-3">
        <section class="card card-featured-left card-featured-primary h-100 mb-0">
            <div class="card-body d-flex align-items-center">
                <div class="widget-summary widget-summary-md w-100">
                    <div class="widget-summary-col widget-summary-col-icon">
                        <div class="summary-icon bg-primary">
                            <i class="bx bx-timer"></i>
                        </div>
                    </div>
                    <div class="widget-summary-col">
                        <div class="summary">
                            <h4 class="title">Overdue</h4>
                            <div class="info">
                                <strong class="amount">—</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<!-- ── MAIN CONTENT ───────────────────────────────────────── -->
<div class="row pt-3 gl-dashboard">

    <!-- MELDINGSCENTRUM: 1/4 -->
    <div class="col-lg-3 gl-mc-col">
        <section class="card card-modern gl-mc-card">
            <header class="card-header">
                <div class="card-title">
                    <i class="bx bx-bell text-primary"></i>
                    Meldingen
                    @if (meldingen.Any())
                    {
                        <span class="gl-count-badge ms-2">@meldingen.Count</span>
                    }
                </div>
            </header>
            <div class="card-body p-0 gl-mc-body">

                @* ACTIE VEREIST *@
                @if (urgentMeldingen.Any())
                {
                    <div class="gl-mc-group gl-mc-urgent">
                        <div class="gl-mc-group-hdr">
                            <i class="bx bx-error-circle"></i> ACTIE VEREIST
                            <span class="gl-mc-cnt">@urgentMeldingen.Count</span>
                        </div>
                        <div class="gl-mc-group-body">
                            @foreach (var (tekst, projectId, severity, bekijkUrl, category) in urgentMeldingen)
                            {
                                var icon = MeldingTypeHelper.GetIcon(category);
                                <div class="gl-mc-item gl-mc-item-urgent">
                                    <i class="@icon gl-mc-item-icon"></i>
                                    <span class="gl-mc-item-text">@tekst</span>
                                    <div class="gl-mc-item-actions">
                                        <a href="@bekijkUrl" class="gl-mc-btn-bekijk">Bekijk <i class="bx bx-link-external"></i></a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* DEZE WEEK *@
                @if (normaleMeldingen.Any())
                {
                    <div class="gl-mc-group gl-mc-normal">
                        <div class="gl-mc-group-hdr">
                            <i class="bx bx-time"></i> OP TE LOSSEN
                            <span class="gl-mc-cnt">@normaleMeldingen.Count</span>
                            @if (normaleMeldingen.Count > 3)
                            {
                                <button type="button" class="gl-mc-toon-alles ms-auto" data-group="normal">toon alles</button>
                            }
                        </div>
                        <div class="gl-mc-group-body">
                            @{ int ni = 0; }
                            @foreach (var (tekst, projectId, severity, bekijkUrl, category) in normaleMeldingen)
                            {
                                var icon   = MeldingTypeHelper.GetIcon(category);
                                var snzKey = $"gl-snz-{Math.Abs(($"{projectId}|{(int)category}|{tekst}").GetHashCode())}";
                                <div class="gl-mc-item gl-mc-item-normal @(ni >= 3 ? "gl-mc-extra" : "")" data-snz="@snzKey">
                                    <i class="@icon gl-mc-item-icon"></i>
                                    <span class="gl-mc-item-text">@tekst</span>
                                    <div class="gl-mc-item-actions">
                                        <a href="@bekijkUrl" class="gl-mc-btn-bekijk">Bekijk <i class="bx bx-link-external"></i></a>
                                        <button type="button" class="gl-mc-btn-snooze" data-snz="@snzKey" title="Snooze 1 week"><i class="bx bx-alarm-snooze"></i></button>
                                    </div>
                                </div>
                                ni++;
                            }
                        </div>
                    </div>
                }

                @* TER INFO *@
                @if (infoMeldingen.Any())
                {
                    <div class="gl-mc-group gl-mc-info">
                        <div class="gl-mc-group-hdr gl-mc-info-toggle" role="button">
                            <i class="bx bx-info-circle"></i> TER INFO
                            <span class="gl-mc-cnt">@infoMeldingen.Count</span>
                            <i class="bx bx-chevron-down gl-mc-chevron ms-auto"></i>
                        </div>
                        <div class="gl-mc-group-body d-none">
                            @foreach (var (tekst, projectId, severity, bekijkUrl, category) in infoMeldingen)
                            {
                                var icon   = MeldingTypeHelper.GetIcon(category);
                                var snzKey = $"gl-snz-info-{Math.Abs(($"{projectId}|{(int)category}|{tekst}").GetHashCode())}";
                                <div class="gl-mc-item gl-mc-item-info" data-snz="@snzKey">
                                    <i class="@icon gl-mc-item-icon"></i>
                                    <span class="gl-mc-item-text">@tekst</span>
                                    <div class="gl-mc-item-actions">
                                        <a href="@bekijkUrl" class="gl-mc-btn-bekijk">Bekijk <i class="bx bx-link-external"></i></a>
                                        <button type="button" class="gl-mc-btn-snooze" data-snz="@snzKey" title="Snooze 1 week"><i class="bx bx-alarm-snooze"></i></button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (!meldingen.Any())
                {
                    <div class="gl-mc-empty">
                        <i class="bx bx-check-circle"></i>
                        <span>Geen meldingen</span>
                    </div>
                }

            </div>
        </section>
    </div>
    <!-- /MELDINGSCENTRUM -->

    <!-- MIJN WERVEN: 2/4 -->
    <div class="col-lg-6">

        <div class="gl-werven-section">
        <div class="gl-sectie-kop">Mijn Werven</div>

        @if (!werfProjects.Any())
        {
            <p class="text-muted mb-3">Geen projecten gevonden.</p>
        }
        else
        {
            <div class="row mb-3">
                @foreach (var project in werfProjects)
                {
                    int? daysLeft  = null;
                    bool isOverdue = false;
                    if (project.DeliveryDate.HasValue)
                    {
                        daysLeft  = (int)(project.DeliveryDate.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Today).TotalDays;
                        isOverdue = daysLeft < 0;
                    }

                    Model.ProjectVoortgang.TryGetValue(project.Id, out var vg);

                    // Bij opgeleverde projecten: bars altijd op 100%, ongeacht berekende waarde
                    var invCulture    = System.Globalization.CultureInfo.InvariantCulture;
                    var displayFysPct = isOverdue ? 100m : (vg?.FysiekeVoortgangPct  ?? 0m);
                    var displayFinPct = isOverdue ? 100m : (vg?.FinancieleVoortgangPct ?? 0m);
                    var showBars      = vg != null || isOverdue;

                    string chipClass, chipLabel;
                    if (vg != null)
                    {
                        if (vg.Fase == VoortgangFase.Afgewerkt)
                        {
                            chipClass = "sc-donker"; chipLabel = "Afgewerkt";
                        }
                        else if (vg.Fase == VoortgangFase.Eindfase)
                        {
                            chipClass = "sc-groen"; chipLabel = "Eindfase";
                        }
                        else if (vg.Fase == VoortgangFase.InUitvoering)
                        {
                            chipClass = "sc-groen"; chipLabel = "In uitvoering";
                        }
                        else if (vg.Fase == VoortgangFase.InVoorbereiding)
                        {
                            chipClass = "sc-geel"; chipLabel = "In voorbereiding";
                        }
                        else
                        {
                            chipClass = "sc-geel"; chipLabel = "Opstart";
                        }
                    }
                    else
                    {
                        chipClass = project.Status.Id == uitvoeringStatusId ? "sc-groen" : "sc-geel";
                        chipLabel = project.Status.Name;
                    }


                    var fotoUrl = project.DefaultPicture?.Name != null
                        ? imgBase + "pictures/447/" + project.DefaultPicture.Name
                        : string.Empty;

                    <div class="col-12 col-sm-6 col-lg-4 mb-4">
                        <a href="@Url.Action("Detail", "Projecten", new { projectid = project.Id })" class="gl-werf-kaart">
                            <div class="gl-werf-foto">
                                @if (!string.IsNullOrEmpty(fotoUrl))
                                {
                                    <img src="@fotoUrl" alt="@project.Name" />
                                }
                                else
                                {
                                    <div class="gl-werf-foto-placeholder"></div>
                                }
                                <div class="gl-werf-overlay"></div>
                                <span class="gl-status-chip @chipClass">@chipLabel</span>
                                @if (vg != null && !string.IsNullOrEmpty(vg.Warnings))
                                {
                                    <span class="gl-warn-badge" title="@string.Join(", ", vg.WarningList)">
                                        <i class="bx bx-error"></i>
                                    </span>
                                }
                            </div>
                            <div class="gl-werf-body">
                                <div>
                                    <p class="gl-werf-naam">@project.Name</p>
                                    @if (!string.IsNullOrWhiteSpace(project.Postalcode?.Gemeente))
                                    {
                                        <p class="gl-werf-gem">
                                            <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                            @project.Postalcode.Gemeente
                                        </p>
                                    }
                                </div>
                                @if (showBars)
                                {
                                    <div>
                                        <div class="pb-2">
                                            <div class="gl-pg-row">
                                                <span class="gl-pg-label">Fysiek</span>
                                                <span class="gl-pg-pct">@displayFysPct.ToString("0.#")%</span>
                                            </div>
                                            <div class="progress gl-pg-bar">
                                                <div class="progress-bar gl-pg-bar-fys" style="--gl-fill-width:@(displayFysPct.ToString("0.##", invCulture))%"></div>
                                            </div>
                                        </div>
                                        <div class="pb-2">
                                            <div class="gl-pg-row">
                                                <span class="gl-pg-label">Financieel</span>
                                                <span class="gl-pg-pct">@displayFinPct.ToString("0.#")%</span>
                                            </div>
                                            <div class="progress gl-pg-bar">
                                                <div class="progress-bar gl-pg-bar-hoog" style="--gl-fill-width:@(displayFinPct.ToString("0.##", invCulture))%"></div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                <div class="gl-werf-footer">
                                    <div class="gl-resterende">
                                        @if (isOverdue)
                                        {
                                            <i class="bx bx-check-circle gl-icon-opgeleverd"></i>
                                            <span class="text-success">Opgeleverd op @project.DeliveryDate!.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                            @if (daysLeft.HasValue)
                                            {
                                                <span class="@(daysLeft.Value < 14 ? "text-danger" : "")">@daysLeft.Value d resterend</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Geen opleverdatum</span>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }

        </div>
    </div>
    <!-- /MIJN WERVEN -->

    <!-- SNELACTIES: 1/4 -->
    <div class="col-lg-3 d-none d-lg-block">
        <section class="card card-modern">
            <header class="card-header">
                <div class="card-title">
                    <i class="bx bx-bolt text-primary"></i>
                    Snelacties
                </div>
            </header>
            <div class="card-body p-0 pb-3">

                @* Contract toevoegen *@
                <div class="gl-sa-item-wrap">
                    <a href="#" class="gl-snelactie js-sa-toggle" data-target="sa-contract">
                        <i class="bx bx-file"></i>
                        Contract toevoegen
                        <svg class="gl-sa-chevron" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                    </a>
                    <div id="sa-contract" class="gl-sa-submenu">
                        @if (!werfProjects.Any())
                        {
                            <span class="gl-sa-empty">Geen projecten beschikbaar</span>
                        }
                        else
                        {
                            @foreach (var p in werfProjects)
                            {
                                <a class="gl-sa-subitem" href="@Url.Action("AddContract", "Projecten", new { projectid = p.Id })">@p.Name</a>
                            }
                        }
                    </div>
                </div>

                @* Punt toevoegen *@
                <div class="gl-sa-item-wrap">
                    <a href="#" class="gl-snelactie js-sa-toggle" data-target="sa-punt">
                        <i class="bx bx-alert-circle"></i>
                        Punt toevoegen
                        <svg class="gl-sa-chevron" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                    </a>
                    <div id="sa-punt" class="gl-sa-submenu">
                        @if (!werfProjects.Any())
                        {
                            <span class="gl-sa-empty">Geen projecten beschikbaar</span>
                        }
                        else
                        {
                            @foreach (var p in werfProjects)
                            {
                                <a class="gl-sa-subitem" href="/Projects/@(p.Id)/Issues/Create">@p.Name</a>
                            }
                        }
                    </div>
                </div>

                @* Inkomende factuur *@
                <div class="gl-sa-item-wrap">
                    <a href="#" class="gl-snelactie js-sa-toggle" data-target="sa-factuur">
                        <i class="bx bx-receipt"></i>
                        Inkomende factuur toevoegen
                        <svg class="gl-sa-chevron" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                    </a>
                    <div id="sa-factuur" class="gl-sa-submenu">
                        @if (!werfProjects.Any())
                        {
                            <span class="gl-sa-empty">Geen projecten beschikbaar</span>
                        }
                        else
                        {
                            @foreach (var p in werfProjects)
                            {
                                <a class="gl-sa-subitem" href="@Url.Action("AddIncommingInvoice", "Projecten", new { projectid = p.Id, type = 0 })">@p.Name</a>
                            }
                        }
                    </div>
                </div>

                @* Wijzigingsopdracht *@
                <div class="gl-sa-item-wrap">
                    <a href="#" class="gl-snelactie js-sa-toggle" data-target="sa-wijziging">
                        <i class="bx bx-edit"></i>
                        Wijzigingsopdracht opmaken
                        <svg class="gl-sa-chevron" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                    </a>
                    <div id="sa-wijziging" class="gl-sa-submenu">
                        @if (!werfProjects.Any())
                        {
                            <span class="gl-sa-empty">Geen projecten beschikbaar</span>
                        }
                        else
                        {
                            @foreach (var p in werfProjects)
                            {
                                <a class="gl-sa-subitem" href="@Url.Action("AddChangeOrder", "Projecten", new { projectid = p.Id, type = 0 })">@p.Name</a>
                            }
                        }
                    </div>
                </div>

                @* Nacalculatie *@
                <div class="gl-sa-item-wrap">
                    <a href="#" class="gl-snelactie js-sa-toggle" data-target="sa-nacalc">
                        <i class="bx bx-chart-bar-big-columns"></i>
                        Nacalculatie bekijken
                        <svg class="gl-sa-chevron" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                    </a>
                    <div id="sa-nacalc" class="gl-sa-submenu">
                        @if (!werfProjects.Any())
                        {
                            <span class="gl-sa-empty">Geen projecten beschikbaar</span>
                        }
                        else
                        {
                            @foreach (var p in werfProjects)
                            {
                                <a class="gl-sa-subitem" href="@Url.Action("Recalculation", "Projecten", new { projectid = p.Id })">@p.Name</a>
                            }
                        }
                    </div>
                </div>

                @* Document uploaden *@
                <div class="gl-sa-item-wrap">
                    <a href="#" class="gl-snelactie js-sa-toggle" data-target="sa-document">
                        <i class="bx bx-arrow-in-up-square-half"></i>
                        Document uploaden
                        <svg class="gl-sa-chevron" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                    </a>
                    <div id="sa-document" class="gl-sa-submenu">
                        @if (!werfProjects.Any())
                        {
                            <span class="gl-sa-empty">Geen projecten beschikbaar</span>
                        }
                        else
                        {
                            @foreach (var p in werfProjects)
                            {
                                <a class="gl-sa-subitem" href="@Url.Action("DetailDocs", "Projecten", new { projectid = p.Id })">@p.Name</a>
                            }
                        }
                    </div>
                </div>

                @* Leverancier toevoegen – directe link, geen submenu *@
                <div class="gl-sa-item-wrap">
                    <a href="@Url.Action("Create", "Leveranciers")" class="gl-snelactie-direct">
                        <i class="bx bx-user-plus"></i>
                        Leverancier toevoegen
                    </a>
                </div>

            </div>
        </section>
    </div>
    <!-- /SNELACTIES -->

</div>

<!-- ── MOBIELE BOTTOM NAV ───────────────────────────────────────────── -->
<nav class="gl-mob-nav d-lg-none" aria-label="Snelle acties">
    <button class="gl-mob-nav-btn" id="mob-nav-punt" type="button" aria-label="Punt toevoegen">
        <i class="bx bx-alert-circle"></i>
        <span>Punt</span>
    </button>
    <button class="gl-mob-nav-btn" id="mob-nav-lev" type="button" aria-label="Leverancier zoeken">
        <i class="bx bx-hard-hat"></i>
        <span>Leverancier</span>
    </button>
    <button class="gl-mob-nav-btn" id="mob-nav-klant" type="button" aria-label="Klant zoeken">
        <i class="bx bx-group"></i>
        <span>Klant</span>
    </button>
</nav>

<!-- ── PUNT PROJECTKEUZE SHEET ──────────────────────────────────────── -->
<div id="gl-punt-sheet" class="gl-mob-sheet" role="dialog" aria-modal="true" aria-label="Punt toevoegen – kies project">
    <div class="gl-mob-sheet-overlay" id="gl-punt-overlay"></div>
    <div class="gl-mob-sheet-panel">
        <div class="gl-mob-sheet-handle"></div>
        <div class="gl-mob-sheet-header">
            <span>Kies een project</span>
            <button id="gl-punt-close" aria-label="Sluiten">&times;</button>
        </div>
        <div class="gl-mob-sheet-search">
            <input type="text" id="gl-punt-search" placeholder="Zoek project…" autocomplete="off" />
        </div>
        <div class="gl-mob-sheet-list" id="gl-punt-list">
            <div class="gl-mob-sheet-section-label" id="gl-punt-mijn-label">Mijn projecten</div>
            @if (!werfProjects.Any())
            {
                <div class="gl-mob-sheet-empty">Geen actieve projecten</div>
            }
            else
            {
                @foreach (var p in werfProjects)
                {
                    <button type="button" class="gl-mob-sheet-item gl-punt-mijn-item"
                            data-pid="@p.Id"
                            data-pname="@p.Name"
                            data-name="@p.Name.ToLower()">
                        <i class="bx bx-map-pin"></i>
                        @p.Name
                    </button>
                }
            }
            <div id="gl-punt-extra-label" class="gl-mob-sheet-section-label d-none">Andere projecten</div>
            <div id="gl-punt-extra"></div>
        </div>
    </div>
</div>

<!-- ── PUNT FULLSCREEN MODAL (iframe) ───────────────────────────────── -->
<div id="gl-issues-modal" class="gl-fs-modal" role="dialog" aria-modal="true">
    <iframe id="gl-issues-frame" src="about:blank" title="Punt toevoegen"></iframe>
</div>

<!-- ── LEVERANCIER ZOEK SHEET ───────────────────────────────────────── -->
<div id="gl-lev-sheet" class="gl-mob-sheet" role="dialog" aria-modal="true" aria-label="Leverancier zoeken">
    <div class="gl-mob-sheet-overlay" id="gl-lev-overlay"></div>
    <div class="gl-mob-sheet-panel">
        <div class="gl-mob-sheet-handle"></div>
        <div class="gl-mob-sheet-header">
            <span>Leverancier zoeken</span>
            <button id="gl-lev-close" aria-label="Sluiten">&times;</button>
        </div>
        <div class="gl-mob-sheet-search">
            <input type="text" id="gl-lev-search" placeholder="Naam leverancier…" autocomplete="off" />
            <button class="gl-mob-search-btn" id="gl-lev-btn">
                <i class="bx bx-search"></i> Zoeken
            </button>
        </div>
        <div class="gl-mob-sheet-list" id="gl-lev-list">
            <div class="gl-mob-sheet-empty" id="gl-lev-empty">Typ een naam en druk op Zoeken</div>
        </div>
    </div>
</div>

<!-- ── KLANT ZOEK SHEET ─────────────────────────────────────────────── -->
<div id="gl-klant-sheet" class="gl-mob-sheet" role="dialog" aria-modal="true" aria-label="Klant zoeken">
    <div class="gl-mob-sheet-overlay" id="gl-klant-overlay"></div>
    <div class="gl-mob-sheet-panel">
        <div class="gl-mob-sheet-handle"></div>
        <div class="gl-mob-sheet-header">
            <span>Klant zoeken</span>
            <button id="gl-klant-close" aria-label="Sluiten">&times;</button>
        </div>
        <div class="gl-mob-sheet-search">
            <input type="text" id="gl-klant-search" placeholder="Naam klant…" autocomplete="off" />
            <button class="gl-mob-search-btn" id="gl-klant-btn">
                <i class="bx bx-search"></i> Zoeken
            </button>
        </div>
        <div class="gl-mob-sheet-list" id="gl-klant-list">
            <div class="gl-mob-sheet-empty" id="gl-klant-empty">Typ een naam en druk op Zoeken</div>
        </div>
    </div>
</div>

@{ var werfIds = string.Join(",", werfProjects.Select(p => p.Id)); }
@section PageScripts {
<script>
window.addEventListener('load', function () {

    // ── Snelacties accordion ───────────────────────────────────────────
    $(document).on('click', '.js-sa-toggle', function (e) {
        e.preventDefault();
        var $btn     = $(this);
        var targetId = $btn.data('target');
        var $submenu = $('#' + targetId);
        var isOpen   = $submenu.is(':visible');
        $('.gl-sa-submenu').slideUp(150);
        $('.js-sa-toggle').removeClass('active');
        if (!isOpen) { $submenu.slideDown(150); $btn.addClass('active'); }
    });

    // ── Meldingscentrum ────────────────────────────────────────────────
    var SNOOZE_MS = 7 * 24 * 60 * 60 * 1000; // 1 week

    // Verberg gesnoozede items bij laden
    $('.gl-mc-item[data-snz]').each(function () {
        var key = $(this).data('snz');
        var exp = localStorage.getItem(key);
        if (exp && Date.now() < parseInt(exp, 10)) { $(this).hide(); }
    });

    // Snooze knop
    $(document).on('click', '.gl-mc-btn-snooze', function () {
        var key = $(this).data('snz');
        localStorage.setItem(key, Date.now() + SNOOZE_MS);
        $(this).closest('.gl-mc-item').slideUp(200);
    });

    // Toon alles knop (DEZE WEEK groep)
    $(document).on('click', '.gl-mc-toon-alles', function () {
        var $btn = $(this);
        $btn.closest('.gl-mc-group').find('.gl-mc-extra').slideDown(150);
        $btn.remove();
    });

    // TER INFO toggle
    $(document).on('click', '.gl-mc-info-toggle', function () {
        var $body = $(this).next('.gl-mc-group-body');
        var $chev = $(this).find('.gl-mc-chevron');
        if ($body.hasClass('d-none')) {
            $body.removeClass('d-none');
            $chev.addClass('gl-mc-chevron-open');
        } else {
            $body.addClass('d-none');
            $chev.removeClass('gl-mc-chevron-open');
        }
    });

    // ── Generieke sheet helpers ────────────────────────────────────────
    function openSheet(id) { $('#' + id).addClass('open'); }
    function closeSheet(id) { $('#' + id).removeClass('open'); }

    $(document).on('keydown', function (e) {
        if (e.key === 'Escape') { $('.gl-mob-sheet.open').each(function() { closeSheet($(this).attr('id')); }); }
    });

    // ── Punt: projectkeuze sheet ───────────────────────────────────────
    var $pSearch   = $('#gl-punt-search');
    var $pMijn     = $('.gl-punt-mijn-item');
    var $pMijnLbl  = $('#gl-punt-mijn-label');
    var $pExtraLbl = $('#gl-punt-extra-label');
    var $pExtra    = $('#gl-punt-extra');
    var pTimer     = null;

    function openPuntSheet() {
        openSheet('gl-punt-sheet');
        $pSearch.val('').trigger('input');
        setTimeout(function () { $pSearch.focus(); }, 250);
    }
    function closePuntSheet() {
        closeSheet('gl-punt-sheet');
        $pSearch.val(''); $pExtra.empty(); $pExtraLbl.addClass('d-none');
        $pMijn.removeClass('d-none'); $pMijnLbl.removeClass('d-none');
    }

    $('#mob-nav-punt').on('click', openPuntSheet);
    $('#gl-punt-overlay, #gl-punt-close').on('click', closePuntSheet);

    $pSearch.on('input', function () {
        var q = $(this).val().trim().toLowerCase();
        clearTimeout(pTimer);
        $pExtra.empty(); $pExtraLbl.addClass('d-none');
        if (q === '') { $pMijn.removeClass('d-none'); $pMijnLbl.removeClass('d-none'); return; }
        var anyVis = false;
        $pMijn.each(function () {
            var m = $(this).data('name').indexOf(q) !== -1;
            $(this).toggleClass('d-none', !m); if (m) anyVis = true;
        });
        $pMijnLbl.toggleClass('d-none', !anyVis);
        if (q.length < 2) return;
        pTimer = setTimeout(function () {
            $.getJSON('@Url.Action("QuickSearch", "Projecten")', { q: q }, function (data) {
                $pExtra.empty();
                if (!data || !data.length) return;
                var ids = [@werfIds];
                data = data.filter(function (p) { return ids.indexOf(p.id) === -1; });
                if (!data.length) return;
                $pExtraLbl.removeClass('d-none');
                $.each(data, function (_, p) {
                    $pExtra.append(
                        $('<button type="button">').addClass('gl-mob-sheet-item')
                            .attr('data-pid', p.id)
                            .attr('data-pname', p.name)
                            .html('<i class="bx bx-map-pin"></i> ' + $('<span>').text(p.name).html())
                    );
                });
            });
        }, 300);
    });

    // Klik op project → sluit sheet, open fullscreen Issues modal
    $(document).on('click', '.gl-punt-mijn-item, #gl-punt-extra button', function () {
        var pid   = $(this).data('pid');
        var pname = $(this).data('pname');
        closePuntSheet();
        openIssuesModal(pid, pname);
    });

    // ── Issues fullscreen modal ────────────────────────────────────────
    var $issModal  = $('#gl-issues-modal');
    var $issFrame  = $('#gl-issues-frame');

    function openIssuesModal(projectId, projectName) {
        $issFrame.attr('src', '/Projects/' + projectId + '/Issues/CreateForm');
        $issModal.addClass('open');
        $('html').addClass('gl-modal-open');
    }

    function closeIssuesModal() {
        $issModal.removeClass('open');
        $('html').removeClass('gl-modal-open');
        setTimeout(function () { $issFrame.attr('src', 'about:blank'); }, 300);
    }

    window.addEventListener('message', function (e) {
        if (e.data === 'gl-issue-modal-close') closeIssuesModal();
        if (e.data === 'gl-issue-saved') closeIssuesModal();
    });

    // ── Leverancier zoek sheet ─────────────────────────────────────────
    $('#mob-nav-lev').on('click', function () {
        openSheet('gl-lev-sheet');
        setTimeout(function () { $('#gl-lev-search').focus(); }, 250);
    });
    $('#gl-lev-overlay, #gl-lev-close').on('click', function () { closeSheet('gl-lev-sheet'); });

    function doLevSearch() {
        var q = $('#gl-lev-search').val().trim();
        var $list = $('#gl-lev-list');
        if (q.length < 1) return;
        $list.html('<div class="gl-mob-sheet-empty">Zoeken…</div>');
        $.getJSON('@Url.Action("Lookup", "Leveranciers")', { term: q, take: 15 }, function (data) {
            $list.empty();
            var items = data.results || data;
            if (!items || !items.length) {
                $list.html('<div class="gl-mob-sheet-empty">Geen leveranciers gevonden</div>'); return;
            }
            $.each(items, function (_, r) {
                $list.append(
                    $('<a>').addClass('gl-mob-sheet-item')
                        .attr('href', '/Leveranciers/Details/' + r.id)
                        .html('<i class="bx bx-hard-hat"></i> ' + $('<span>').text(r.text).html())
                );
            });
        });
    }

    $('#gl-lev-btn').on('click', doLevSearch);
    $('#gl-lev-search').on('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); doLevSearch(); } });

    // ── Klant zoek sheet ───────────────────────────────────────────────
    $('#mob-nav-klant').on('click', function () {
        openSheet('gl-klant-sheet');
        setTimeout(function () { $('#gl-klant-search').focus(); }, 250);
    });
    $('#gl-klant-overlay, #gl-klant-close').on('click', function () { closeSheet('gl-klant-sheet'); });

    function doKlantSearch() {
        var q = $('#gl-klant-search').val().trim();
        var $list = $('#gl-klant-list');
        if (q.length < 1) return;
        $list.html('<div class="gl-mob-sheet-empty">Zoeken…</div>');
        $.getJSON('@Url.Action("Lookup", "Klanten")', { term: q, take: 15 }, function (data) {
            $list.empty();
            var items = data.results || data;
            if (!items || !items.length) {
                $list.html('<div class="gl-mob-sheet-empty">Geen klanten gevonden</div>'); return;
            }
            $.each(items, function (_, r) {
                $list.append(
                    $('<a>').addClass('gl-mob-sheet-item')
                        .attr('href', '/Klanten/Details/' + r.id)
                        .html('<i class="bx bx-user"></i> ' + $('<span>').text(r.text).html())
                );
            });
        });
    }

    $('#gl-klant-btn').on('click', doKlantSearch);
    $('#gl-klant-search').on('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); doKlantSearch(); } });

});
</script>
}
