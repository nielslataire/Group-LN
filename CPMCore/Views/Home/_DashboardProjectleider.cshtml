<!-- Onzichtbare live-regio voor screenreader-aankondigingen (bv. snooze) -->
<div id="gl-sr-announce" class="visually-hidden" aria-live="polite" aria-atomic="true"></div>

@{
    var werfIds = string.Join(",", werfProjects.Select(p => p.Id));
    // Project-ID's die al toegewezen of vastgezet zijn — uitgesloten uit de "Project vastzetten"-zoekresultaten.
    var myProjectIdsJoined = string.Join(",", myProjectIds);
}
@* Bewust géén @section PageScripts hier: dit partial wordt gerenderd via
   Html.RenderPartialAsync, en Razor negeert @section-blokken in partials
   stilzwijgend (ze komen nooit bij een RenderSection-aanroep terecht). Een
   inline <script> op deze plek rendert wél gewoon mee in de pagina-body. *@
<script>
window.addEventListener('load', function () {

    // Kondig een tekst aan via de onzichtbare live-regio (bv. na snooze),
    // zodat een screenreader-gebruiker meekrijgt dat iets stil verdween.
    function gl_announce(text) {
        var $live = $('#gl-sr-announce');
        $live.text('');
        window.setTimeout(function () { $live.text(text); }, 50);
    }

    // ── Snelacties accordion ───────────────────────────────────────────
    $(document).on('click', '.js-sa-toggle', function (e) {
        e.preventDefault();
        var $btn     = $(this);
        var targetId = $btn.data('target');
        var $submenu = $('#' + targetId);
        var isOpen   = $submenu.is(':visible');
        $('.gl-sa-submenu').slideUp(150);
        $('.js-sa-toggle').removeClass('active').attr('aria-expanded', 'false');
        if (!isOpen) { $submenu.slideDown(150); $btn.addClass('active').attr('aria-expanded', 'true'); }
    });

    // ── Meldingscentrum ────────────────────────────────────────────────
    var SNOOZE_MS = 7 * 24 * 60 * 60 * 1000; // 1 week

    // Verberg gesnoozede items bij laden
    $('.gl-mc-item[data-snz]').each(function () {
        var key = $(this).data('snz');
        var exp = localStorage.getItem(key);
        if (exp && Date.now() < parseInt(exp, 10)) { $(this).hide(); }
    });

    // Snooze knop
    $(document).on('click', '.gl-mc-btn-snooze', function () {
        var key  = $(this).data('snz');
        var text = $(this).closest('.gl-mc-item').find('.gl-mc-item-text').text().trim();
        localStorage.setItem(key, Date.now() + SNOOZE_MS);
        $(this).closest('.gl-mc-item').slideUp(200);
        gl_announce('Melding gesnoozed voor 1 week: ' + text);
    });

    // Toon alles knop (DEZE WEEK groep)
    $(document).on('click', '.gl-mc-toon-alles', function () {
        var $btn = $(this);
        $btn.closest('.gl-mc-group').find('.gl-mc-extra').slideDown(150);
        $btn.remove();
    });

    // TER INFO toggle (div[role=button]: click + keyboard activation)
    function toggleInfoGroup($toggle) {
        var $body = $toggle.next('.gl-mc-group-body');
        var $chev = $toggle.find('.gl-mc-chevron');
        var opening = $body.hasClass('d-none');
        if (opening) {
            $body.removeClass('d-none');
            $chev.addClass('gl-mc-chevron-open');
        } else {
            $body.addClass('d-none');
            $chev.removeClass('gl-mc-chevron-open');
        }
        $toggle.attr('aria-expanded', opening ? 'true' : 'false');
    }
    $(document).on('click', '.gl-mc-info-toggle', function () { toggleInfoGroup($(this)); });
    $(document).on('keydown', '.gl-mc-info-toggle', function (e) {
        if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
            e.preventDefault();
            toggleInfoGroup($(this));
        }
    });

    // ── Generieke sheet helpers ──────────────────────────────────────────
    // Focus gaat bij openen naar het paneel (elders al per sheet geregeld via
    // een setTimeout-focus op het zoekveld), blijft er tijdens Tab in gevangen,
    // en keert bij sluiten terug naar het element dat de sheet opende.
    var gl_lastFocusedEl = null;

    function gl_getFocusable($container) {
        return $container
            .find('a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])')
            .filter(':visible');
    }

    function openSheet(id) {
        gl_lastFocusedEl = document.activeElement;
        $('#' + id).addClass('open');
    }
    function closeSheet(id) {
        $('#' + id).removeClass('open');
        if (gl_lastFocusedEl && typeof gl_lastFocusedEl.focus === 'function') { gl_lastFocusedEl.focus(); }
    }

    $(document).on('keydown', function (e) {
        var $open = $('.gl-mob-sheet.open');
        if (e.key === 'Escape') {
            $open.each(function () { closeSheet($(this).attr('id')); });
            return;
        }
        if (e.key === 'Tab' && $open.length) {
            var $focusable = gl_getFocusable($open.first().find('.gl-mob-sheet-panel'));
            if (!$focusable.length) return;
            var first = $focusable[0];
            var last  = $focusable[$focusable.length - 1];
            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault(); last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault(); first.focus();
            }
        }
    });

    // ── Punt: projectkeuze sheet ───────────────────────────────────────
    var $pSearch   = $('#gl-punt-search');
    var $pMijn     = $('.gl-punt-mijn-item');
    var $pMijnLbl  = $('#gl-punt-mijn-label');
    var $pExtraLbl = $('#gl-punt-extra-label');
    var $pExtra    = $('#gl-punt-extra');
    var pTimer     = null;

    function openPuntSheet() {
        openSheet('gl-punt-sheet');
        $pSearch.val('').trigger('input');
        setTimeout(function () { $pSearch.focus(); }, 250);
    }
    function closePuntSheet() {
        closeSheet('gl-punt-sheet');
        $pSearch.val(''); $pExtra.empty(); $pExtraLbl.addClass('d-none');
        $pMijn.removeClass('d-none'); $pMijnLbl.removeClass('d-none');
    }

    $('#mob-nav-punt').on('click', openPuntSheet);
    $('#gl-punt-overlay, #gl-punt-close').on('click', closePuntSheet);

    $pSearch.on('input', function () {
        var q = $(this).val().trim().toLowerCase();
        clearTimeout(pTimer);
        $pExtra.empty(); $pExtraLbl.addClass('d-none');
        if (q === '') { $pMijn.removeClass('d-none'); $pMijnLbl.removeClass('d-none'); return; }
        var anyVis = false;
        $pMijn.each(function () {
            var m = $(this).data('name').indexOf(q) !== -1;
            $(this).toggleClass('d-none', !m); if (m) anyVis = true;
        });
        $pMijnLbl.toggleClass('d-none', !anyVis);
        if (q.length < 2) return;
        pTimer = setTimeout(function () {
            $.getJSON('@Url.Action("QuickSearch", "Projecten")', { q: q }, function (data) {
                $pExtra.empty();
                if (!data || !data.length) return;
                var ids = [@werfIds];
                data = data.filter(function (p) { return ids.indexOf(p.id) === -1; });
                if (!data.length) return;
                $pExtraLbl.removeClass('d-none');
                $.each(data, function (_, p) {
                    $pExtra.append(
                        $('<button type="button">').addClass('gl-mob-sheet-item')
                            .attr('data-pid', p.id)
                            .attr('data-pname', p.name)
                            .html('<i class="bx bx-map-pin"></i> ' + $('<span>').text(p.name).html())
                    );
                });
            });
        }, 300);
    });

    // Klik op project → sluit sheet, open fullscreen Issues modal
    $(document).on('click', '.gl-punt-mijn-item, #gl-punt-extra button', function () {
        var pid   = $(this).data('pid');
        var pname = $(this).data('pname');
        closePuntSheet();
        openIssuesModal(pid, pname);
    });

    // ── Issues fullscreen modal ────────────────────────────────────────
    var $issModal  = $('#gl-issues-modal');
    var $issFrame  = $('#gl-issues-frame');

    function openIssuesModal(projectId, projectName) {
        $issModal.addClass('open loading');
        $('html').addClass('gl-modal-open');
        $issFrame.attr('src', '/Projects/' + projectId + '/Issues/CreateForm');
    }
    // Verbergt de laad-overlay zodra de CreateForm-pagina in de iframe klaar is.
    $issFrame.on('load', function () {
        if ($issFrame.attr('src') !== 'about:blank') { $issModal.removeClass('loading'); }
    });

    function closeIssuesModal() {
        $issModal.removeClass('open loading');
        $('html').removeClass('gl-modal-open');
        setTimeout(function () { $issFrame.attr('src', 'about:blank'); }, 300);
    }

    window.addEventListener('message', function (e) {
        if (e.data === 'gl-issue-modal-close') closeIssuesModal();
        if (e.data === 'gl-issue-saved') closeIssuesModal();
    });

    // ── Leverancier zoek sheet ─────────────────────────────────────────
    // #mob-nav-lev (mobiele bottom-nav) en #sa-lev-search (Snelacties,
    // desktop) delen hetzelfde paneel — enkel de trigger verschilt per context.
    $('#mob-nav-lev, #sa-lev-search').on('click', function () {
        openSheet('gl-lev-sheet');
        setTimeout(function () { $('#gl-lev-search').focus(); }, 250);
    });
    $('#gl-lev-overlay, #gl-lev-close').on('click', function () { closeSheet('gl-lev-sheet'); });

    function doLevSearch() {
        var q = $('#gl-lev-search').val().trim();
        var $list = $('#gl-lev-list');
        if (q.length < 1) return;
        $list.html('<div class="gl-mob-sheet-empty">Zoeken…</div>');
        $.getJSON('@Url.Action("Lookup", "Leveranciers")', { term: q, take: 15 })
            .done(function (data) {
                $list.empty();
                var items = data.results || data;
                if (!items || !items.length) {
                    $list.html('<div class="gl-mob-sheet-empty">Geen leveranciers gevonden</div>'); return;
                }
                $.each(items, function (_, r) {
                    $list.append(
                        $('<a>').addClass('gl-mob-sheet-item')
                            .attr('href', '/Leveranciers/Details/' + r.id)
                            .html('<i class="bx bx-hard-hat"></i> ' + $('<span>').text(r.text).html())
                    );
                });
            })
            .fail(function () {
                $list.html('<div class="gl-mob-sheet-empty">Zoeken mislukt. Probeer het opnieuw.</div>');
            });
    }

    $('#gl-lev-btn').on('click', doLevSearch);
    $('#gl-lev-search').on('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); doLevSearch(); } });

    // ── Klant zoek sheet ───────────────────────────────────────────────
    $('#mob-nav-klant, #sa-klant-search').on('click', function () {
        openSheet('gl-klant-sheet');
        setTimeout(function () { $('#gl-klant-search').focus(); }, 250);
    });
    $('#gl-klant-overlay, #gl-klant-close').on('click', function () { closeSheet('gl-klant-sheet'); });

    function doKlantSearch() {
        var q = $('#gl-klant-search').val().trim();
        var $list = $('#gl-klant-list');
        if (q.length < 1) return;
        $list.html('<div class="gl-mob-sheet-empty">Zoeken…</div>');
        $.getJSON('@Url.Action("Lookup", "Klanten")', { term: q, take: 15 })
            .done(function (data) {
                $list.empty();
                var items = data.results || data;
                if (!items || !items.length) {
                    $list.html('<div class="gl-mob-sheet-empty">Geen klanten gevonden</div>'); return;
                }
                $.each(items, function (_, r) {
                    $list.append(
                        $('<a>').addClass('gl-mob-sheet-item')
                            .attr('href', '/Klanten/Details/' + r.id)
                            .html('<i class="bx bx-user"></i> ' + $('<span>').text(r.text).html())
                    );
                });
            })
            .fail(function () {
                $list.html('<div class="gl-mob-sheet-empty">Zoeken mislukt. Probeer het opnieuw.</div>');
            });
    }

    $('#gl-klant-btn').on('click', doKlantSearch);
    $('#gl-klant-search').on('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); doKlantSearch(); } });

    // ── Project vastzetten sheet ─────────────────────────────────────────
    var antiForgery = $('input[name="__RequestVerificationToken"]').val() || '';

    function gl_postJson(url, data) {
        return $.ajax({
            url: url,
            method: 'POST',
            data: data,
            headers: { 'RequestVerificationToken': antiForgery }
        });
    }

    $('#mw-add-project, #sa-pin-search').on('click', function () {
        openSheet('gl-pin-sheet');
        setTimeout(function () { $('#gl-pin-search').focus(); }, 250);
    });
    $('#gl-pin-overlay, #gl-pin-close').on('click', function () { closeSheet('gl-pin-sheet'); });

    var pinTimer = null;
    $('#gl-pin-search').on('input', function () {
        var q = $(this).val().trim();
        var $list = $('#gl-pin-list');
        clearTimeout(pinTimer);
        if (q.length < 2) {
            $list.html('<div class="gl-mob-sheet-empty">Typ minstens 2 letters om te zoeken</div>');
            return;
        }
        pinTimer = setTimeout(function () {
            $list.html('<div class="gl-mob-sheet-empty">Zoeken…</div>');
            $.getJSON('@Url.Action("QuickSearch", "Projecten")', { q: q })
                .done(function (data) {
                    var mine = [@myProjectIdsJoined];
                    data = (data || []).filter(function (p) { return mine.indexOf(p.id) === -1; });
                    $list.empty();
                    if (!data.length) {
                        $list.html('<div class="gl-mob-sheet-empty">Geen (andere) projecten gevonden</div>');
                        return;
                    }
                    $.each(data, function (_, p) {
                        $list.append(
                            $('<button type="button">').addClass('gl-mob-sheet-item')
                                .attr('data-pid', p.id)
                                .html('<i class="bx bx-map-pin"></i> ' + $('<span>').text(p.name).html())
                        );
                    });
                })
                .fail(function () {
                    $list.html('<div class="gl-mob-sheet-empty">Zoeken mislukt. Probeer het opnieuw.</div>');
                });
        }, 300);
    });

    // Klik op een zoekresultaat → project vastzetten, dan pagina herladen
    // zodat de kaart met volledige voortgang/status meteen correct gerenderd wordt.
    $(document).on('click', '#gl-pin-list .gl-mob-sheet-item', function () {
        var $item = $(this).prop('disabled', true);
        gl_postJson('@Url.Action("PinProject", "Home")', { projectId: $item.data('pid') })
            .done(function (res) {
                if (res && res.success) { window.location.reload(); return; }
                $item.prop('disabled', false);
                gl_announce((res && res.message) || 'Vastzetten mislukt.');
            })
            .fail(function () {
                $item.prop('disabled', false);
                gl_announce('Vastzetten mislukt. Probeer het opnieuw.');
            });
    });

    // Loskoppelen (unpin) via de pin-knop op de kaart zelf
    $(document).on('click', '.gl-pin-toggle', function () {
        var $btn = $(this).prop('disabled', true);
        gl_postJson('@Url.Action("UnpinProject", "Home")', { projectId: $btn.data('project-id') })
            .done(function (res) {
                if (res && res.success) { window.location.reload(); return; }
                $btn.prop('disabled', false);
                gl_announce((res && res.message) || 'Losmaken mislukt.');
            })
            .fail(function () {
                $btn.prop('disabled', false);
                gl_announce('Losmaken mislukt. Probeer het opnieuw.');
            });
    });

});
</script>
