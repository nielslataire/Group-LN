@model CPMCore.Models.Home.HomeModel
@using BOCore
@using DALCore.Models
@using FacadeCore
@using Microsoft.EntityFrameworkCore
@inject IMijlpaalService MijlpaalService
@inject cpmRunningContext Db
@{
    var projectIds = Model.Projects.Select(p => p.Id).ToList();

    var vergunningDossiers = projectIds.Count > 0
        ? await Db.ProjectDossier.AsNoTracking()
            .Where(d => projectIds.Contains(d.ProjectId) && d.DossierKind == (int)DossierKind.Omgevingsvergunning)
            .OrderByDescending(d => d.CreatedDate)
            .Take(10)
            .ToListAsync()
        : new List<ProjectDossier>();

    var openVergunningen = vergunningDossiers.Count(d => d.Status != (int)DossierStatus.Afgehandeld && d.Status != (int)DossierStatus.Geannuleerd);
    var achterstalligeMijlpalen = projectIds.Count > 0 ? await MijlpaalService.CountOverdue(projectIds) : 0;
    var projectNamen = Model.Projects.ToDictionary(p => p.Id, p => p.Name);
}

<!-- ── KPI STRIP ──────────────────────────────────────────── -->
<div class="row gl-kpi-strip mb-2">
    <div class="col-12 col-md-6 col-xl-3 mb-3">
        <section class="card card-featured-left card-featured-primary h-100 mb-0" title="Projecten in je portfolio">
            <div class="card-body d-flex align-items-center">
                <div class="widget-summary widget-summary-md w-100">
                    <div class="widget-summary-col widget-summary-col-icon">
                        <div class="summary-icon bg-primary"><i class="bx bx-building-house"></i></div>
                    </div>
                    <div class="widget-summary-col">
                        <div class="summary">
                            <h4 class="title">Projecten</h4>
                            <div class="info"><strong class="amount">@Model.Projects.Count</strong></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    <div class="col-12 col-md-6 col-xl-3 mb-3">
        <section class="card card-featured-left card-featured-warning h-100 mb-0" title="Vergunningsdossiers die nog niet afgehandeld of geannuleerd zijn">
            <div class="card-body d-flex align-items-center">
                <div class="widget-summary widget-summary-md w-100">
                    <div class="widget-summary-col widget-summary-col-icon">
                        <div class="summary-icon gl-kpi-icon-warning"><i class="bx bx-file"></i></div>
                    </div>
                    <div class="widget-summary-col">
                        <div class="summary">
                            <h4 class="title">Vergunningen in opvolging</h4>
                            <div class="info"><strong class="amount gl-kpi-amount-warning">@openVergunningen</strong></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    <div class="col-12 col-md-6 col-xl-3 mb-3">
        <section class="card card-featured-left card-featured-danger h-100 mb-0" title="Mijlpalen waarvan de streefdatum voorbij is en die nog niet bereikt zijn">
            <div class="card-body d-flex align-items-center">
                <div class="widget-summary widget-summary-md w-100">
                    <div class="widget-summary-col widget-summary-col-icon">
                        <div class="summary-icon gl-kpi-icon-danger"><i class="bx bx-timer"></i></div>
                    </div>
                    <div class="widget-summary-col">
                        <div class="summary">
                            <h4 class="title">Achterstallige mijlpalen</h4>
                            <div class="info"><strong class="amount gl-kpi-amount-danger">@achterstalligeMijlpalen</strong></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    <div class="col-12 col-md-6 col-xl-3 mb-3">
        <section class="card card-featured-left card-featured-primary h-100 mb-0" title="Volledig portfolio-overzicht van mijlpalen en deadlines">
            <div class="card-body d-flex align-items-center">
                <a href="@Url.Action("Index", "Deadlines")" class="widget-summary widget-summary-md w-100 text-decoration-none">
                    <div class="widget-summary-col widget-summary-col-icon">
                        <div class="summary-icon bg-primary"><i class="bx bx-calendar-check"></i></div>
                    </div>
                    <div class="widget-summary-col">
                        <div class="summary">
                            <h4 class="title">Alle deadlines</h4>
                            <div class="info"><strong class="amount">Bekijk</strong></div>
                        </div>
                    </div>
                </a>
            </div>
        </section>
    </div>
</div>

<!-- ── MAIN CONTENT ───────────────────────────────────────── -->
<div class="row pt-3 gl-dashboard">
    <div class="col-lg-8">
        <section class="card card-modern gl-detail-card">
            <header class="card-header gl-detail-card-header">
                <h2 class="card-title mb-0">Vergunningen in opvolging</h2>
            </header>
            <div class="card-body p-0">
                @if (vergunningDossiers.Count == 0)
                {
                    <p class="text-muted mb-0 p-3">Geen vergunningsdossiers in je portfolio.</p>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr><th>Dossier</th><th>Project</th><th>Status</th><th>Verwachte afhandeling</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var d in vergunningDossiers)
                            {
                                <tr>
                                    <td><a href="@Url.Action("Details", "ProjectDossiers", new { projectId = d.ProjectId, id = d.Id })">@d.Titel</a></td>
                                    <td>@(projectNamen.TryGetValue(d.ProjectId, out var naam) ? naam : $"Project {d.ProjectId}")</td>
                                    <td><span class="badge gl-mijlpaal-status s-@d.Status">@(((DossierStatus)d.Status).GetDisplayName())</span></td>
                                    <td>@(d.VerwachteAfhandelingDatum?.ToString("dd/MM/yyyy") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </section>
    </div>
    <div class="col-lg-4">
        <div class="mb-3">
            @await Html.PartialAsync("_MijnKeypointsWidget")
        </div>
        <div>
            @await Html.PartialAsync("_MijnTakenWidget")
        </div>
    </div>
</div>
