@using CPMCore.Helpers
@using Microsoft.AspNetCore.Authorization
@using System.Linq

@{
	var userDisplayName = User.GetCpmDisplayName() ?? string.Empty;
	var userEmail = User.GetCpmEmail() ?? string.Empty;
	var userPhotoUrl = Url.Action("ProfilePhoto", "Account") ?? Url.Content("~/img/!logged-user.jpg");
	var userInitials = string.Join(
		string.Empty,
		userDisplayName
			.Split(' ', StringSplitOptions.RemoveEmptyEntries)
			.Select(part => char.ToUpperInvariant(part[0]))
			.Take(2));
	if (string.IsNullOrWhiteSpace(userInitials))
	{
		userInitials = "?";
	}
	var pageTitle = ViewData["Title"] as string ?? string.Empty;
	var pageIcon = ViewData["PageIcon"] as string ?? "bx bx-file";
	var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
	var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
	var isDashboard = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
		&& string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
}
