	<script>
		$(window).on('load', function () {
		@if (TempData["Message"] != null)
		{
			<text>
						new PNotify({
							title:      '@TempData["MessageTitle"]',
						text:       '@TempData["Message"]',
						type:       '@TempData["MessageType"]',
						addclass:    'stack-bottomright',
								   });
			</text>
		}
		});
	</script>
	<script>
		(function () {
			var $photo = $('.user-profile-photo');
			$photo.on('load', function () {
				$(this).siblings('.profile-picture-as-text').hide();
			});
			$photo.on('error', function () {
				$(this).hide();
				$(this).siblings('.profile-picture-as-text').show();
			});

			var $search = $('#header-search');
			if (!$search.length) {
				return;
			}

			$search.select2({
				theme: 'bootstrap',
				placeholder: $search.data('placeholder'),
				allowClear: true,
				minimumInputLength: 2,
				language: 'nl',
				ajax: {
					url: '@Url.Action("Lookup", "Search")',
					dataType: 'json',
					delay: 300,
					data: function (params) {
						return { term: params.term };
					},
					processResults: function (data) {
						return data;
					}
				},
				templateResult: function (item) {
					if (item.loading || item.children) {
						return item.text;
					}

					var $container = $('<div class="select2-result-item"></div>');
					$container.append($('<div class="fw-semibold"></div>').text(item.text));
					if (item.subtitle) {
						$container.append($('<div class="small text-muted"></div>').text(item.subtitle));
					}
					return $container;
				},
				templateSelection: function (item) {
					return item.text || item.id || '';
				},
				escapeMarkup: function (markup) {
					return markup;
				}
			});

			$search.on('select2:select', function (event) {
				var item = event.params.data;
				if (item && item.id) {
					window.location.href = item.id;
				}
			});
		})();
	</script>
	<script>
		 @if (User?.Identity?.IsAuthenticated ?? false)
		{
			<text>
					 (function () {
						const keepAliveUrl = '@Url.Action("KeepAlive", "Account")';
						if (!keepAliveUrl) {
							return;
						}

						const intervalMs = 5 * 60 * 1000; // 5 minuten
						let timeoutId = null;

						function queuePing() {
							if (timeoutId) {
								window.clearTimeout(timeoutId);
							}

							timeoutId = window.setTimeout(sendPing, intervalMs);
						}

						function sendPing() {
							fetch(keepAliveUrl, {
								method: 'GET',
								credentials: 'same-origin',
								cache: 'no-store',
								headers: {
									'X-Requested-With': 'XMLHttpRequest'
								}
							})
								.catch(function () { return null; })
								.then(queuePing);
						}

						document.addEventListener('visibilitychange', function () {
							if (document.visibilityState === 'visible') {
								queuePing();
							} else if (timeoutId) {
								window.clearTimeout(timeoutId);
								timeoutId = null;
							}
						});

						queuePing();
					})();
			
			</text>
			
		}
	</script>

