@using CPMCore.Helpers
@using FacadeCore
@using BOCore;
@using CPMCore.Services.Security
@using System.Collections.Generic
@using System.Linq
@inject IIssuerCompanyService IssuerCompanyService
@inject IPermissionService PermissionService
@inject ISecurityService SecurityService
@{
	var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
	var issuerCompanies = (await IssuerCompanyService.GetAllAsync())
		.OrderBy(i => i.Name)
		.ToList();
	var currentUserCode = User.GetCpmUserCode() ?? string.Empty;
	await PermissionService.EnsureLoadedAsync();
	var canSeeKlanten = PermissionService.HasRead(PermissionCodes.Customers);
	var canSeeLeveranciers = PermissionService.HasRead(PermissionCodes.Suppliers);
	var canSeeBoekhouding = PermissionService.HasRead(PermissionCodes.InvoicingByBillingCompany);
	var canSeeProjects = PermissionService.HasRead(PermissionCodes.ProjectsDetail);
	var canSeeAdmin = PermissionService.HasRead(PermissionCodes.SettingsUsers);
	var customerIssuerCompanyIds = new HashSet<int>();
	var supplierIssuerCompanyIds = new HashSet<int>();
	var invoicingIssuerCompanyIds = new HashSet<int>();
	if (canSeeKlanten)
	{
		foreach (var entry in PermissionService.EffectivePermissions)
		{
			var code = entry.Key ?? string.Empty;
			if (!code.StartsWith("Customers.Company.", StringComparison.OrdinalIgnoreCase))
			{
				continue;
			}

			if (!entry.Value.Read)
			{
				continue;
			}

			var suffix = code["Customers.Company.".Length..];
			if (int.TryParse(suffix, out var companyId))
			{
				customerIssuerCompanyIds.Add(companyId);
			}
		}

		if (customerIssuerCompanyIds.Count == 0)
		{
			customerIssuerCompanyIds = issuerCompanies.Select(i => i.Id).ToHashSet();
		}
	}

	var customerIssuerCompanies = issuerCompanies
		.Where(i => customerIssuerCompanyIds.Contains(i.Id))
		.ToList();
	if (canSeeLeveranciers)
	{
		foreach (var entry in PermissionService.EffectivePermissions)
		{
			var code = entry.Key ?? string.Empty;
			if (!code.StartsWith("Suppliers.Company.", StringComparison.OrdinalIgnoreCase))
			{
				continue;
			}

			if (!entry.Value.Read)
			{
				continue;
			}

			var suffix = code["Suppliers.Company.".Length..];
			if (int.TryParse(suffix, out var companyId))
			{
				supplierIssuerCompanyIds.Add(companyId);
			}
		}

		if (supplierIssuerCompanyIds.Count == 0)
		{
			supplierIssuerCompanyIds = issuerCompanies.Select(i => i.Id).ToHashSet();
		}
	}

	var supplierIssuerCompanies = issuerCompanies
		.Where(i => supplierIssuerCompanyIds.Contains(i.Id))
		.ToList();
	canSeeLeveranciers = canSeeLeveranciers && supplierIssuerCompanies.Any();
	if (canSeeBoekhouding)
	{
		foreach (var entry in PermissionService.EffectivePermissions)
		{
			var code = entry.Key ?? string.Empty;
			if (!code.StartsWith("InvoicingByBillingCompany.Company.", StringComparison.OrdinalIgnoreCase))
			{
				continue;
			}

			if (!entry.Value.Read)
			{
				continue;
			}

			var suffix = code["InvoicingByBillingCompany.Company.".Length..];
			if (int.TryParse(suffix, out var companyId))
			{
				invoicingIssuerCompanyIds.Add(companyId);
			}
		}

		if (invoicingIssuerCompanyIds.Count == 0)
		{
			invoicingIssuerCompanyIds = issuerCompanies.Select(i => i.Id).ToHashSet();
		}
	}
	var invoicingIssuerCompanies = issuerCompanies
		.Where(i => invoicingIssuerCompanyIds.Contains(i.Id))
		.ToList();
	canSeeBoekhouding = canSeeBoekhouding && invoicingIssuerCompanies.Any();
	var suppliersSubmenuClass = supplierIssuerCompanies.Count + 1 > 10 ? "nav nav-children flyout-menu submenu-two-columns" : "nav nav-children flyout-menu";
	var customersSubmenuClass = customerIssuerCompanies.Count + 1 > 10 ? "nav nav-children flyout-menu submenu-two-columns" : "nav nav-children flyout-menu";
	var invoicesSubmenuClass = invoicingIssuerCompanies.Count > 10 ? "nav nav-children flyout-menu submenu-two-columns" : "nav nav-children flyout-menu";
	var projectSubmenuClass = 3 > 10 ? "nav nav-children flyout-menu submenu-two-columns" : "nav nav-children flyout-menu";
	var settingsCount = canSeeAdmin ? 7 : 1;
	var settingsSubmenuClass = settingsCount > 10 ? "nav nav-children flyout-menu submenu-two-columns" : "nav nav-children flyout-menu";
	var linksSubmenuClass = 4 > 10 ? "nav nav-children flyout-menu submenu-two-columns" : "nav nav-children flyout-menu";
}

<!-- ============================================================
     DESKTOP SIDEBAR  (verborgen op max-width: 767px via CSS)
     ============================================================ -->
<aside id="sidebar-left" class="sidebar-left">

	<div class="sidebar-header">
		<div class="sidebar-title"></div>
		<div class="sidebar-toggle" data-toggle-class="sidebar-left-collapsed" data-target="html" data-fire-event="sidebar-left-toggle">
			<i class="fas fa-bars" aria-label="Toggle sidebar"></i>
		</div>
	</div>

	<div class="nano">
		<div class="nano-content">
			<nav id="menu" class="nav-main" role="navigation">
				<ul class="nav nav-main">

					<li class="@(currentController == "Home" ? "nav-active" : string.Empty)">
						<a class="main-nav-tile" href="@Url.Action("Index", "Home")">
							<i class="bx bx-home-alt" aria-hidden="true"></i>
							<span class="main-nav-label">Dashboard</span>
						</a>
					</li>

					@if (canSeeLeveranciers)
					{
						<li class="nav-parent @(currentController == "Leveranciers" ? "nav-active" : string.Empty)">
							<a class="main-nav-tile" href="#">
								<i class="bx bx-hard-hat" aria-hidden="true"></i>
								<span class="main-nav-label">Leveranciers</span>
							</a>
							<ul class="@suppliersSubmenuClass">
								<li>@Html.ActionLink("Alle leveranciers", "Index", "Leveranciers")</li>
								@foreach (var issuer in supplierIssuerCompanies)
								{
									<li>@Html.ActionLink(issuer.Name, "Index", "Leveranciers", new { issuerCompanyId = issuer.Id }, null)</li>
								}
							</ul>
						</li>
					}

					@if (canSeeKlanten)
					{
						<li class="nav-parent @(currentController == "Klanten" ? "nav-active" : string.Empty)">
							<a class="main-nav-tile" href="#">
								<i class="bx bx-group" aria-hidden="true"></i>
								<span class="main-nav-label">Klanten</span>
							</a>
							<ul class="@customersSubmenuClass">
								<li>@Html.ActionLink("Alle klanten", "Index", "Klanten")</li>
								@foreach (var issuer in customerIssuerCompanies)
								{
									<li>@Html.ActionLink(issuer.Name, "Index", "Klanten", new { issuerCompanyId = issuer.Id }, null)</li>
								}
							</ul>
						</li>
					}

					@if (canSeeProjects)
					{
						<li class="nav-parent">
							<a class="main-nav-tile" href="#">
								<i class="bx bx-building-house" aria-hidden="true"></i>
								<span class="main-nav-label">Projecten</span>
							</a>
							<ul class="@projectSubmenuClass">
								<li>
									<a href="@(Url.Action("ProjectsByUserId", "Projecten", new { UserId = currentUserCode }))">
										Mijn Projecten
									</a>
								</li>
								<li>@Html.ActionLink("Alle projecten", "Index", "Projecten")</li>
								<li>@Html.ActionLink("Weerverlet", "Weather", "Projecten")</li>
							</ul>
						</li>
					}

					@if (canSeeBoekhouding)
					{
						<li class="nav-parent">
							<a class="main-nav-tile" href="#">
								<i class="bx bx-receipt" aria-hidden="true"></i>
								<span class="main-nav-label">Facturatie</span>
							</a>
							<ul class="@invoicesSubmenuClass">
								@foreach (var issuer in invoicingIssuerCompanies)
								{
									<li>@Html.ActionLink(issuer.Name, "Index", "Invoices", new { issuerCompanyId = issuer.Id }, "")</li>
								}
							</ul>
						</li>
					}

					<li class="nav-parent @(currentController == "Instellingen" ? "nav-active" : string.Empty)">
						<a class="main-nav-tile" href="#">
							<i class="bx bx-cog" aria-hidden="true"></i>
							<span class="main-nav-label">Instellingen</span>
						</a>
						<ul class="@settingsSubmenuClass">
							@if (canSeeAdmin)
							{
								<li>@Html.ActionLink("Instellingen", "Index", "Instellingen")</li>
								<li>@Html.ActionLink("Vakantiedagen", "Vacationdays", "Instellingen")</li>
								<li>@Html.ActionLink("Mijn bedrijven", "IssuerCompanies", "Instellingen")</li>
								<li>@Html.ActionLink("Factuurtemplates", "InvoiceTemplates", "Instellingen")</li>
								<li>@Html.ActionLink("Gebruikers", "Index", "UserAdmin")</li>
								<li>@Html.ActionLink("Rollen", "Index", "AppRoles")</li>
							}
							<li>@Html.ActionLink("Activiteiten", "Activities", "Instellingen")</li>
						</ul>
					</li>

					<li class="nav-parent">
						<a class="main-nav-tile" href="#">
							<i class="bx bx-link-alt" aria-hidden="true"></i>
							<span class="main-nav-label">Links</span>
						</a>
						<ul class="@linksSubmenuClass">
							<li><a href="http://www.copro-bouwteam.be" target="_blank">www.copro-bouwteam.be</a></li>
							<li><a href="http://www.bouwenconstructie.be" target="_blank">www.bouwenconstructie.be</a></li>
							<li><a href="http://www.verspurten.be" target="_blank">www.verspurten.be</a></li>
							<li><a href="http://www.home-estate.be" target="_blank">www.home-estate.be</a></li>
						</ul>
					</li>

				</ul>
			</nav>

			<div class="sidebar-brand-footer" aria-hidden="true">
				<img src="~/img/logo.png" alt="CPM" />
			</div>

		</div>
	</div>

</aside>
