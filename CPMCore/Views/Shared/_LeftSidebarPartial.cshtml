@using CPMCore.Helpers
@using FacadeCore
@inject IIssuerCompanyService IssuerCompanyService
@{
	var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
	var issuerCompanies = (await IssuerCompanyService.GetAllAsync())
		.OrderBy(i => i.Name)
		.ToList();
	var currentUserCode = User.GetCpmUserCode() ?? string.Empty;
	var canSeeKlanten = User.IsInRole("Klanten");
	var canSeeLeveranciers = User.IsInRole("Leveranciers");
	var canSeeBoekhouding = User.IsInRole("Boekhouding");
	var canSeeProjects = User.IsInRole("Projecten");
	var canSeeAdmin = User.IsInRole("Admin") || User.IsInRole("Administrator");
}



<aside id="sidebar-left" class="sidebar-left">

	<div class="sidebar-header">
		<div class="sidebar-title">
			Navigatie
		</div>
		<div class="sidebar-toggle hidden-xs" data-toggle-class="sidebar-left-collapsed" data-target="html" data-fire-event="sidebar-left-toggle">
			<i class="fas fa-bars" aria-label="Toggle sidebar"></i>
		</div>
	</div>

	<div class="nano">
		<div class="nano-content">
			<nav id="menu" class="nav-main" role="navigation">

				<ul class="nav nav-main">
					<li class="@(currentController == "Home" ? "nav-active" : string.Empty)">
						<a href="@Url.Action("Index", "Home")">
							<i class="fa fa-house" aria-hidden="true"></i>
							<span>Dashboard</span>
						</a>
					</li>
										@if (canSeeLeveranciers)
					{
					<li class="nav-parent @(currentController == "Leveranciers" ? "nav-active nav-expanded" : string.Empty)">
						<a>
							<i class="fa fa-truck" aria-hidden="true"></i>
							<span>Leveranciers</span>
						</a>
						<ul class="nav nav-children">
							<li>@Html.ActionLink("Alle leveranciers", "Index", "Leveranciers")</li>
							@foreach (var issuer in issuerCompanies)
							{
								<li>@Html.ActionLink(issuer.Name, "Index", "Leveranciers", new { issuerCompanyId = issuer.Id }, null)</li>
							}
						</ul>
					</li>
					}
										@if (canSeeKlanten)
					{
					<li class="nav-parent @(currentController == "Klanten" ? "nav-active nav-expanded" : string.Empty)">
						<a>
							<i class="fa fa-users" aria-hidden="true"></i>
							<span>Klanten</span>
						</a>
						<ul class="nav nav-children">
							<li>@Html.ActionLink("Alle klanten", "Index", "Klanten")</li>
							@foreach (var issuer in issuerCompanies)
							{
								<li>@Html.ActionLink(issuer.Name, "Index", "Klanten", new { issuerCompanyId = issuer.Id }, null)</li>
							}
						</ul>
					</li>
					}
					@if (canSeeProjects)
					{
						<li class="nav-parent">
							<a>
								<i class="fa fa-city" aria-hidden="true"></i>
								<span>Projecten</span>
							</a>
							<ul class="nav nav-children">
								<li>
									@Html.ActionLink("Overzicht", "Index", "Projecten")
								</li>
								<li>
									<a href="@(Url.Action("ProjectsByUserId", "Projecten", new { UserId = currentUserCode }))">
										Eigen Projecten
									</a>
								</li>
								<li>
									@Html.ActionLink("Weerverlet", "Weather", "Projecten")
								</li>
							</ul>
						</li>
					}
					@if (canSeeBoekhouding)
					{
						<li class="nav-parent">
							<a>
								<i class="fa fa-file-invoice" aria-hidden="true"></i>
								<span>Facturatie</span>
							</a>
							<ul class="nav nav-children">
								@foreach (var issuer in issuerCompanies)
								{
									<li>@Html.ActionLink(issuer.Name, "Index", "Invoices", new { issuerCompanyId = issuer.Id }, "")</li>
								}
							</ul>
						</li>

					}
					<li class="nav-parent @(currentController == "Instellingen" ? "nav-active nav-expanded" : string.Empty)">
						<a>
							<i class="fa fa-gear" aria-hidden="true"></i>
							<span>Instellingen</span>
						</a>
						<ul class="nav nav-children">
							@if (canSeeAdmin)
							{
							<li>@Html.ActionLink("Instellingen", "Index", "Instellingen")</li>
							<li>@Html.ActionLink("Vakantiedagen", "Vacationdays", "Instellingen")</li>
							<li>@Html.ActionLink("Mijn bedrijven", "IssuerCompanies", "Instellingen")</li>
							<li>@Html.ActionLink("Gebruikers", "Index", "UserAdmin")</li>
							<li>@Html.ActionLink("Rollen", "Index", "AppRoles")</li>
							}
                        </ul>
                    </li>
					<li class="nav-parent">
						<a>
							<i class="fa fa-link" aria-hidden="true"></i>
							<span>Links</span>
						</a>
						<ul class="nav nav-children">
							<li>
								<a href="http://www.copro-bouwteam.be" target="_blank">
									www.copro-bouwteam.be
								</a>
							</li>
							<li>
								<a href="http://www.bouwenconstructie.be" target="_blank">
									www.bouwenconstructie.be
								</a>
							</li>
							<li>
								<a href="http://www.verspurten.be" target="_blank">

									www.verspurten.be
								</a>
							</li>
							<li>
								<a href="http://www.home-estate.be" target="_blank">

									www.home-estate.be
								</a>
							</li>
						</ul>
					</li>


				</ul>
			</nav>


		</div>

		<script>
			// Maintain Scroll Position
			if (typeof localStorage !== 'undefined') {
				if (localStorage.getItem('sidebar-left-position') !== null) {
					var initialPosition = localStorage.getItem('sidebar-left-position'),
						sidebarLeft = document.querySelector('#sidebar-left .nano-content');

					sidebarLeft.scrollTop = initialPosition;
				}
			}
		</script>

	</div>

</aside>