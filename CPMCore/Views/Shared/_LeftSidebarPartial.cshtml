		<script>
			document.addEventListener('DOMContentLoaded', function () {
				// Maintain Scroll Position
				if (typeof localStorage !== 'undefined') {
					var sidebarContent = document.querySelector('#sidebar-left .nano-content');
					if (sidebarContent && localStorage.getItem('sidebar-left-position') !== null) {
						sidebarContent.scrollTop = localStorage.getItem('sidebar-left-position');
					}
				}

				var sidebar = document.getElementById('sidebar-left');
				if (!sidebar) {
					return;
				}

				// Klik op hoofdmenu-item doet niets (submenu werkt enkel op hover/focus).
				sidebar.querySelectorAll('li.nav-parent > a.main-nav-tile').forEach(function (trigger) {
					trigger.addEventListener('click', function (e) {
						e.preventDefault();
					});
				});

				// Fallback zodat sidebar-toggle altijd werkt, ook als theme binding faalt.
				var sidebarToggle = sidebar.querySelector('.sidebar-header .sidebar-toggle');
				if (sidebarToggle) {
					sidebarToggle.addEventListener('click', function (e) {
						var root = document.documentElement;
						var hadCollapsed = root.classList.contains('sidebar-left-collapsed');

						window.setTimeout(function () {
							var stillSame = root.classList.contains('sidebar-left-collapsed') === hadCollapsed;
							if (stillSame) {
								root.classList.toggle('sidebar-left-collapsed');
								document.dispatchEvent(new CustomEvent('sidebar-left-toggle'));
							}
						}, 0);
					});
				}
			});
		</script>

