		<script>
			document.addEventListener('DOMContentLoaded', function () {
				// Maintain Scroll Position
				if (typeof localStorage !== 'undefined') {
					var sidebarContent = document.querySelector('#sidebar-left .nano-content');
					if (sidebarContent && localStorage.getItem('sidebar-left-position') !== null) {
						sidebarContent.scrollTop = localStorage.getItem('sidebar-left-position');
					}
				}

				var sidebar = document.getElementById('sidebar-left');
				if (!sidebar) {
					return;
				}

				// Mobile top hamburger fallback (open/close) if theme binding doesn't trigger.
				var mobileToggle = document.querySelector('.toggle-sidebar-left');
				if (mobileToggle) {
					mobileToggle.addEventListener('click', function () {
						var root = document.documentElement;
						var hadOpened = root.classList.contains('sidebar-left-opened');

						window.setTimeout(function () {
							var stillSame = root.classList.contains('sidebar-left-opened') === hadOpened;
							if (stillSame) {
								root.classList.toggle('sidebar-left-opened');
								document.dispatchEvent(new CustomEvent('sidebar-left-opened'));
							}
						}, 0);
					});
				}

				// Klik op hoofdmenu-item doet niets (submenu werkt enkel op hover/focus).
				sidebar.querySelectorAll('li.nav-parent > a.main-nav-tile').forEach(function (trigger) {
					trigger.addEventListener('click', function (e) {
						e.preventDefault();

						if (window.matchMedia('(max-width: 767px)').matches) {
							var parent = trigger.closest('li.nav-parent');
							if (!parent) {
								return;
							}

							var isExpanded = parent.classList.contains('nav-expanded');
							sidebar.querySelectorAll('li.nav-parent.nav-expanded').forEach(function (openItem) {
								openItem.classList.remove('nav-expanded');
							});

							if (!isExpanded) {
								parent.classList.add('nav-expanded');
							}
						}
					});
				});

				// Fallback zodat sidebar-toggle altijd werkt, ook als theme binding faalt.
				var sidebarToggle = sidebar.querySelector('.sidebar-header .sidebar-toggle');
				if (sidebarToggle) {
					sidebarToggle.addEventListener('click', function (e) {
						if (window.matchMedia('(max-width: 767px)').matches) {
							e.preventDefault();
							var mobileRoot = document.documentElement;
							mobileRoot.classList.toggle('sidebar-left-opened');
							return;
						}

						var root = document.documentElement;
						var hadCollapsed = root.classList.contains('sidebar-left-collapsed');

						window.setTimeout(function () {
							var stillSame = root.classList.contains('sidebar-left-collapsed') === hadCollapsed;
							if (stillSame) {
								root.classList.toggle('sidebar-left-collapsed');
								document.dispatchEvent(new CustomEvent('sidebar-left-toggle'));
							}
						}, 0);
					});
				}
			});
		</script>

