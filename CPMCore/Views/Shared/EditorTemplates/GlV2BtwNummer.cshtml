@model string
@*
    gl-v2 (design-handoff optie 8f·1, "BTW-NUMMER — MET KNOP"). Veld + "Controleren"-knop als één
    visueel blok (.gl-v2-field-attached). Optionele extra ViewData: Placeholder, CheckUrl (endpoint
    voor de nog-ongewired controleknop), IsVerified (bool, rendert meteen de "gecontroleerd"-staat),
    HelpText (neutrale hint onder het veld — bv. 8i's "staat ernaast omdat het doorgaans hetzelfde
    nummer is" — enkel getoond zolang er geen echte foutmelding is, die wint altijd).
    Enkel expliciete aanroep, zelfde reden als GlV2OndernemingsNummer hierboven — inclusief de spatie-
    als-placeholder-truc (zie die template se eigen toelichting): zonder placeholder-attribuut matcht
    :placeholder-shown nooit, dus zou dit veld altijd als "ingevuld" ogen.
*@
@{
    var name = ViewData.TemplateInfo.GetFullHtmlFieldName("");
    var id = name.Replace(".", "_");
    var label = ViewData.ModelMetadata.DisplayName ?? ViewData.ModelMetadata.PropertyName;
    var placeholder = ViewData["Placeholder"] as string ?? " ";
    var checkUrl = ViewData["CheckUrl"] as string;
    var helpText = ViewData["HelpText"] as string;
    var isVerified = ViewData["IsVerified"] as bool? ?? false;
    var hasError = ViewContext.ModelState.TryGetValue(name, out var entry) && entry.Errors.Count > 0;
}
<div class="gl-v2-field@(hasError ? " is-error" : "")">
    <label class="gl-v2-field-label" for="@id">
        @label
        @if (ViewData.ModelMetadata.IsRequired)
        {
            <span style="color:#8B2A2A">*</span>
        }
    </label>
    <div class="gl-v2-field-attached@(isVerified ? " is-checked" : "")" data-gl-v2-btw-check-url="@checkUrl">
        <div class="gl-v2-field-box">
            <span class="gl-v2-field-prefix">BE</span>
            <span class="gl-v2-field-divider"></span>
            <input type="text" id="@id" name="@name" class="gl-v2-field-input is-tabular"
                   value="@Model" placeholder="@placeholder" autocomplete="off" maxlength="12" />
            @if (isVerified)
            {
                <i class="ph ph-check-circle gl-v2-field-icon-trailing" aria-hidden="true"></i>
            }
            else if (hasError)
            {
                <i class="ph ph-warning-circle gl-v2-field-icon-trailing" aria-hidden="true"></i>
            }
        </div>
        <button type="button" class="gl-v2-field-attach-btn@(isVerified ? " is-outline" : "")" data-gl-v2-btw-check-btn>
            @if (isVerified)
            {
                <span>Opnieuw</span>
            }
            else
            {
                <i class="ph ph-check" aria-hidden="true"></i>
                <span>Controleren</span>
            }
        </button>
    </div>
    @if (hasError)
    {
        <span class="gl-v2-field-help">@entry!.Errors[0].ErrorMessage</span>
    }
    else if (!string.IsNullOrWhiteSpace(helpText))
    {
        <span class="gl-v2-field-help">@helpText</span>
    }
</div>
