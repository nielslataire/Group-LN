@model decimal?
@using System.Globalization

@{
    var culture = CultureInfo.CreateSpecificCulture("nl-BE");
    var formatted = Model.HasValue
        ? Model.Value.ToString("N2", culture).Replace('\u00A0', ' ')
        : string.Empty;
}

<div class="input-group mb-3">
    @Html.TextBox(
    "",
        formatted,
        new
        {
            @class = "form-control form-control-modern Currencymask",
            placeholder = ViewData.ModelMetadata.DisplayName,
            autocomplete = "off",
            inputmode = "decimal",
            data_val_number = ""
        })
    <span class="input-group-text">€</span>
</div>