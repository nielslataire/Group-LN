@model decimal?

<div class="input-group mb-3">
    @Html.TextBoxFor(
    m => m,
        Model.HasValue? Model.Value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "",
        new
        {
            @class = "form-control Currencymask",
            autocomplete = "off",
            type = "text",
            data_val=""
        })
    <span class="input-group-text">€</span>
</div>