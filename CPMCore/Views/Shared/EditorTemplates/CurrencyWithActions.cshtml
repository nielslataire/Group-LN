@model decimal?
@using System.Globalization

@{
    var name = ViewData.TemplateInfo.GetFullHtmlFieldName("");
    var value = Model.HasValue
        ? Model.Value.ToString("0.00", CultureInfo.InvariantCulture)
        : "";
}

<div class="input-group">
    <input type="text"
           name="@name"
           value="@value"
           autocomplete="off"
           data_val=""
           class="form-control Currencymask" />

    <span class="input-group-text">€</span>

    @* Actieknoppen *@
    @if (ViewData["ShowDelete"] as bool? == true)
    {
        <button class="btn btn-danger deleterow"
                type="button"
                data-id="@ViewData["DeleteId"]"
                title="Verwijderen">
            <i class="bx bx-trash"></i>
        </button>
    }

    @if (ViewData["ShowEdit"] as bool? == true)
    {
        <button class="btn btn-secondary editrow"
                type="button"
                data-id="@ViewData["EditId"]"
                title="Bewerken">
            <i class="bx bx-edit"></i>
        </button>
    }
</div>
