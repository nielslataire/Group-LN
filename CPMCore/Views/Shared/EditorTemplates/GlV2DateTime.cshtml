@model DateTime?
@*
    gl-v2 — DateTime?-editor van het gedeelde datumveld (zie GlV2/_DateField.cshtml en DESIGN.md
    "Datumveld"): vrij typen dd/mm/jjjj + kalender-dropdown. Enkel expliciete aanroep. Optioneel: Label.
*@
@{
    var name = ViewData.TemplateInfo.GetFullHtmlFieldName("");
    var vm = new CPMCore.Models.GlV2.GlV2DateFieldVm
    {
        Name = name,
        Id = name.Replace(".", "_"),
        Label = ViewData["Label"] as string ?? ViewData.ModelMetadata.DisplayName ?? ViewData.ModelMetadata.PropertyName,
        Required = ViewData.ModelMetadata.IsRequired,
        IsoValue = Model?.ToString("yyyy-MM-dd") ?? "",
        DisplayValue = Model?.ToString("dd/MM/yyyy") ?? "",
    };
    if (ViewContext.ModelState.TryGetValue(name, out var entry) && entry.Errors.Count > 0)
    {
        vm.HasError = true;
        vm.ErrorMessage = entry.Errors[0].ErrorMessage;
    }
}
@await Html.PartialAsync("GlV2/_DateField", vm)
