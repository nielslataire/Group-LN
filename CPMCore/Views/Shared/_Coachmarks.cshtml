@* Shared partial — automatisch ingeladen via _Layout.cshtml.
   Injecteert de actieve coachmark-config als window.GlCoachmarkFlow.
   Geen coachmarks? Dan rendert dit partial niets.

   Gebruik in een controller/view:
       ViewData["CoachmarkPageKey"] = "Projects.Detail.Issues";
*@
@using CPMCore.Helpers
@using System.Text.Json
@using System.Text.Json.Serialization
@inject FacadeCore.ICoachmarkService CoachmarkService

@{
    var pageKey = ViewData["CoachmarkPageKey"] as string;
    if (string.IsNullOrWhiteSpace(pageKey) || !(User?.Identity?.IsAuthenticated ?? false))
    {
        return;
    }

    var userId = User.GetCpmUserId();
    if (userId is null) { return; }

    var flow = await CoachmarkService.GetActiveForPageAsync(pageKey, userId.Value);
    if (flow is null) { return; }

    var options = new JsonSerializerOptions
    {
        PropertyNamingPolicy         = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition       = JsonIgnoreCondition.WhenWritingNull,
        WriteIndented                = false
    };
    var json = JsonSerializer.Serialize(flow, options);
}

<script>
    window.GlCoachmarkFlow = @Html.Raw(json);
</script>
