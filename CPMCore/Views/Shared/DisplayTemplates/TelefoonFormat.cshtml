@model string
@{
    if (!string.IsNullOrWhiteSpace(Model) && Model.Length >= 8)
    {
        var formatted = string.Format("{0:###/##.##.## x}{1}", Model.Substring(0, 8), Model.Length > 8 ? Model.Substring(8) : "");
        // Nummers uit de V2-formulieren staan internationaal opgeslagen (+32496733202 / 0032…): landcode en voorloopnul eraf,
        // anders wordt het landcodecijfer als deel van het nummer (en de rest als "extensie") gelezen.
        var rawDigits = new string(Model.Where(char.IsDigit).ToArray());
        if (Model.TrimStart().StartsWith("+32") || rawDigits.StartsWith("0032")) { rawDigits = rawDigits.StartsWith("0032") ? rawDigits.Substring(4) : rawDigits.Substring(2); rawDigits = rawDigits.TrimStart('0'); }
        else if (rawDigits.StartsWith("32") && rawDigits.Length >= 10 && rawDigits.Length <= 11) { rawDigits = rawDigits.Substring(2); }
        else if (rawDigits.StartsWith("0") && rawDigits.Length >= 9 && rawDigits.Length <= 10) { rawDigits = rawDigits.TrimStart('0'); }
        if (long.TryParse(rawDigits, out var phonedigits))
        {
            string cleanPhoneDigits = phonedigits.ToString();
            int digitCount = cleanPhoneDigits.Length;
            string display = "";
            string link = "tel:";

            if (digitCount == 8)
            {
                display = string.Format("+32 {0:## ## ## ##}", phonedigits);
                link += "+32" + cleanPhoneDigits;
            }
            else if (digitCount == 9)
            {
                display = string.Format("+32 {0:### ## ## ##}", phonedigits);
                link += "+32" + cleanPhoneDigits;
            }
            else if (digitCount > 9)
            {
                display = string.Format("+32 {0:## ## ## ##} x{1}", cleanPhoneDigits.Substring(0, 8), cleanPhoneDigits.Substring(8));
                link += "+32" + cleanPhoneDigits.Substring(0, 8);
            }
            else
            {
                display = cleanPhoneDigits;
                link += cleanPhoneDigits;
            }

            <a href="@link">@display</a>
        }
    }
}