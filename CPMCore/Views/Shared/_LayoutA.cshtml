@using CPMCore.Helpers
@using Microsoft.AspNetCore.Authorization
@using System.Linq

@{
	var userDisplayName = User.GetCpmDisplayName() ?? string.Empty;
	var userEmail = User.GetCpmEmail() ?? string.Empty;
	var userPhotoUrl = Url.Action("ProfilePhoto", "Account") ?? Url.Content("~/img/!logged-user.jpg");
	var userInitials = string.Join(
		string.Empty,
		userDisplayName
			.Split(' ', StringSplitOptions.RemoveEmptyEntries)
			.Select(part => char.ToUpperInvariant(part[0]))
			.Take(2));
	if (string.IsNullOrWhiteSpace(userInitials))
	{
		userInitials = "?";
	}
}
