@model ErrorViewModel
@{
    ViewData["Title"] = "Fout";
    Layout = "_Base";
}

<div class="container py-5 text-center">
    <div class="mb-4">
        <i class="bx bx-error-circle" style="font-size: 4rem; color: var(--gl-danger, #dc3545);"></i>
    </div>
    <h1 class="h3 mb-3">Er is iets misgegaan</h1>
    <p class="text-muted mb-4">
        Er is een onverwachte fout opgetreden. Probeer de pagina opnieuw te laden.<br />
        Blijft het probleem zich voordoen, neem dan contact op met de beheerder.
    </p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="text-muted small">Referentie: <code>@Model.RequestId</code></p>
    }
    <a href="/" class="btn btn-primary">Terug naar het dashboard</a>
</div>
