@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>
@{
    ViewData["Title"] = "Applicatierollen";
}


    <header class="page-header">
        <h2>@ViewData["Title"]</h2>
        <div class="right-wrapper text-end">
            <ol class="breadcrumbs">
                <li>
                    <a href="@Url.Action("Index", "Home")">
                        <i class="bx bx-home-alt"></i>
                    </a>
                </li>
                <li><span>Beheer</span></li>
                <li><span>Rollen</span></li>
            </ol>
            <a class="sidebar-right-toggle" data-open="sidebar-right"><i class="fas fa-chevron-left"></i></a>
        </div>
    </header>

    <div class="row">
        <div class="col">
            <section class="card">
                <header class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="card-title mb-0">Overzicht</h2>
                    <a class="btn btn-primary btn-sm" href="@Url.Action("Create")"><i class="bx bx-plus"></i> Nieuwe rol</a>
                </header>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered mb-0">
                            <thead>
                                <tr>
                                    <th class="text-uppercase text-muted">Id</th>
                                    <th class="text-uppercase text-muted">Naam</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="small text-muted">@item.Id</td>
                                        <td class="fw-semibold">@item.Name</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </div>
    </div>
