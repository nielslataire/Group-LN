@using Microsoft.AspNetCore.Identity
@model IdentityRole
@{
    ViewData["Title"] = "Rol aanmaken";
}


    <header class="page-header">
        <h2>@ViewData["Title"]</h2>
        <div class="right-wrapper text-end">
            <ol class="breadcrumbs">
                <li>
                    <a href="@Url.Action("Index", "Home")">
                        <i class="bx bx-home-alt"></i>
                    </a>
                </li>
                <li><span>Beheer</span></li>
                <li><span>Rollen</span></li>
            </ol>
            <a class="sidebar-right-toggle" data-open="sidebar-right"><i class="fas fa-chevron-left"></i></a>
        </div>
    </header>

    <div class="row">
        <div class="col-lg-6">
            <section class="card">
                <header class="card-header">
                    <h2 class="card-title">Nieuwe rol</h2>
                </header>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <div class="form-group mb-3">
                            <label class="form-label" asp-for="Name"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bx bx-id-card"></i></span>
                                <input asp-for="Name" class="form-control" aria-required="true" placeholder="bv. Admin" />
                            </div>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <a class="btn btn-link" href="@Url.Action("Index")">
                                <i class="bx bx-chevron-left"></i> Terug
                            </a>
                            <button type="submit" class="btn btn-primary"><i class="bx bx-save"></i> Opslaan</button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
