@model CPMCore.Models.Traject.TrajectSjabloonEditVm
@*
    Gedeeld tussen @section PageActions (topbar, ≥768px) en de mobiele d-md-none
    fallback-rij in de content-body (<768px) — zelfde patroon als
    Projecten/Partials/ProjectActionButtons.cshtml (zie Projecten/Detail.cshtml).
    Enkel Dupliceren: Opslaan/Annuleren leven in de vaste _FormShellActions-balk
    onderaan (position:fixed, dus sowieso al op elke schermbreedte zichtbaar — geen
    aparte mobiele kopie nodig). De "Niet-bewaarde wijzigingen"-indicator
    (id="tsaDirty") hoort hier bewust niet bij — die leeft enkel in de
    topbar-instantie om dubbele id's in de DOM te vermijden.
*@
@if (!Model.IsNieuw)
{
    <button type="submit" form="duplicerenForm" class="btn btn-default btn-md">
        <i class="bx bx-copy me-1" aria-hidden="true"></i>Dupliceren
    </button>
}
