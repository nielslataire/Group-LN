@using BOCore
@using System.Text.Json
@model CPMCore.Models.Traject.TrajectSjabloonEditVm
@{
    ViewData["Title"] ??= "Trajectsjabloon";
    var s = Model.Sjabloon;

    var initial = new
    {
        id = s?.Id ?? 0,
        naam = s?.Naam ?? "",
        projectType = s?.ProjectType,
        isStandaard = s?.IsStandaard ?? false,
        isActief = s?.IsActief ?? true,
        omschrijving = s?.Omschrijving ?? "",
        fases = (s?.Fases.OrderBy(f => f.Volgorde) ?? Enumerable.Empty<DALCore.Models.TrajectSjabloonFase>())
            .Select(f => new
            {
                naam = f.Naam,
                code = f.Code,
                volgorde = f.Volgorde,
                kleurCode = f.KleurCode,
                standaardProjectStatusId = f.StandaardProjectStatusId,
                mijlpalen = f.Mijlpalen.OrderBy(m => m.Volgorde).Select(m => new
                {
                    naam = m.Naam,
                    code = m.Code,
                    volgorde = m.Volgorde,
                    mijlpaalType = m.MijlpaalType,
                    scope = m.Scope,
                    verantwoordelijkeRol = m.VerantwoordelijkeRol,
                    doeldatumAnkerCode = m.DoeldatumAnkerCode,
                    doeldatumOffsetDagen = m.DoeldatumOffsetDagen,
                    isVerplicht = m.IsVerplicht,
                    bronBinding = m.BronBinding,
                    bronParam = m.BronParam,
                    dossierKind = m.DossierKind,
                    omschrijving = m.Omschrijving,
                    triggers = m.Triggers.Select(t => new
                    {
                        triggerEvent = t.TriggerEvent,
                        triggerActie = t.TriggerActie,
                        offsetDagen = t.OffsetDagen,
                        actieParametersJson = t.ActieParametersJson,
                        magProjectWijzigen = t.MagProjectWijzigen,
                        isActief = t.IsActief,
                        omschrijving = t.Omschrijving
                    })
                })
            })
    };

    var typeOpties = Enum.GetValues(typeof(MijlpaalType)).Cast<MijlpaalType>()
        .Select(x => new { v = (int)x, n = x.GetDisplayName() });
    var rolOpties = Enum.GetValues(typeof(InterneRol)).Cast<InterneRol>().Where(x => (int)x != 0)
        .Select(x => new { v = (int)x, n = x.GetDisplayName() });
    var bindingOpties = Enum.GetValues(typeof(ComputedBinding)).Cast<ComputedBinding>()
        .Select(x => new { v = (int)x, n = x.GetDisplayName() });
    var triggerEventOpties = Enum.GetValues(typeof(TriggerEvent)).Cast<TriggerEvent>()
        .Select(x => new { v = (int)x, n = x.GetDisplayName() });
    var triggerActieOpties = Enum.GetValues(typeof(TriggerActie)).Cast<TriggerActie>()
        .Select(x => new { v = (int)x, n = x.GetDisplayName() });
    var dossierKindOpties = Enum.GetValues(typeof(DossierKind)).Cast<DossierKind>()
        .Select(x => new { v = (int)x, n = x.GetDisplayName() });

    // Zelfde vaste 7 vlagnamen als hieronder bij ComputedBinding.ProjectVlag — ook nodig voor de
    // "Zet projectvlag"-triggeractie (ZetProjectVlagAction.cs) z'n eigen "vlag"-parameter, dus als
    // gedeelde variabele i.p.v. de lijst twee keer te definiëren.
    var projectVlagOpties = new[]
    {
        new { v = "DocPid", n = "PID aanwezig" },
        new { v = "DocElectricalInspection", n = "Elektrische keuring OK" },
        new { v = "DocWaterInspection", n = "Waterkeuring OK" },
        new { v = "DocSewerInspection", n = "Rioolkeuring OK" },
        new { v = "DocFireInspection", n = "Brandkeuring OK" },
        new { v = "DocDelivery", n = "Voorlopige oplevering OK" },
        new { v = "DocDefDelivery", n = "Definitieve oplevering OK" },
    };

    // Bron-parameter: per binding ofwel een vaste keuzelijst (leesbare labels i.p.v. vrije tekst),
    // ofwel "numeriek" (verwijst naar een record van één specifiek project — kan pas zinvol gekozen
    // worden ná instantiatie, op de mijlpaal zelf, niet hier in het projectonafhankelijke sjabloon),
    // ofwel "hidden" (binding heeft geen parameter nodig). Zie ook MijlpaalBindingResolver.cs — de
    // vaste stringwaarden hieronder moeten exact overeenkomen met de switch-cases daar.
    var bronParamOptiesByBinding = new Dictionary<int, object>
    {
        [(int)ComputedBinding.ProjectDoc] = Enum.GetValues(typeof(ProjectDocType)).Cast<ProjectDocType>()
            .Select(x => new { v = ((int)x).ToString(), n = x.GetDisplayName() })
            .OrderBy(x => x.n).ToList(),
        [(int)ComputedBinding.ProjectDatum] = new[]
        {
            new { v = "StartDateConstruction", n = "Startdatum bouw" },
            new { v = "DeliveryDate", n = "Opleverdatum (voorlopig)" },
            new { v = "DeliveryDateDef", n = "Opleverdatum (definitief)" },
            new { v = "WerfmeldingDate", n = "Werfmelding — startdatum" },
            new { v = "WerfmeldingEndDate", n = "Werfmelding — einddatum" },
        },
        [(int)ComputedBinding.ProjectVlag] = projectVlagOpties,
        [(int)ComputedBinding.ClientAccountDatum] = new[]
        {
            new { v = "DateSalesAgreement", n = "Compromis getekend" },
            new { v = "DateDeedOfSale", n = "Akte verleden" },
            new { v = "DeedOfSaleExpDate", n = "Uiterste aktedatum" },
            new { v = "DeliveryDate", n = "Oplevering (voorlopig)" },
            new { v = "DeliveryDateDef", n = "Oplevering (definitief)" },
        },
        [(int)ComputedBinding.ConstructionIssue] = Enum.GetValues(typeof(ConstructionIssuePhase)).Cast<ConstructionIssuePhase>()
            .Select(x => new { v = ((int)x).ToString(), n = x.GetDisplayName() }).ToList(),
        [(int)ComputedBinding.ProjectVoortgangFase] = Enum.GetValues(typeof(VoortgangFase)).Cast<VoortgangFase>()
            .Select(x => new { v = ((int)x).ToString(), n = x.GetDisplayName() }).ToList(),
        [(int)ComputedBinding.DossierSubstap] = VergunningChecklistDefaults.Stappen
            .OrderBy(x => x.Volgorde).Select(x => new { v = x.Code, n = x.Naam }).ToList(),
    };

    var bronParamModeByBinding = new Dictionary<int, string>
    {
        [(int)ComputedBinding.Handmatig] = "hidden",
        [(int)ComputedBinding.ProjectDoc] = "select",
        [(int)ComputedBinding.ProjectDatum] = "select",
        [(int)ComputedBinding.ProjectVlag] = "select",
        [(int)ComputedBinding.PlanningTaak] = "numeriek",
        [(int)ComputedBinding.PlanningSectie] = "numeriek",
        [(int)ComputedBinding.InvoicingPaymentStage] = "numeriek",
        [(int)ComputedBinding.ClientAccountDatum] = "select",
        [(int)ComputedBinding.ConnectionSettlement] = "hidden",
        [(int)ComputedBinding.ConstructionIssue] = "select",
        [(int)ComputedBinding.ProjectVoortgangFase] = "select",
        [(int)ComputedBinding.Dossier] = "hidden",
        [(int)ComputedBinding.DossierSubstap] = "select",
    };

    var bronParamHintByBinding = new Dictionary<int, string>
    {
        [(int)ComputedBinding.Handmatig] = "Geen bron-parameter nodig — de datum wordt manueel ingevuld op de mijlpaal.",
        [(int)ComputedBinding.PlanningTaak] = "Numeriek ID van een planningstaak van één specifiek project — pas zinvol in te vullen op de mijlpaal zelf ná instantiatie, niet hier in het sjabloon.",
        [(int)ComputedBinding.PlanningSectie] = "Numeriek ID van een planningssectie van één specifiek project — pas zinvol in te vullen op de mijlpaal zelf ná instantiatie, niet hier in het sjabloon.",
        [(int)ComputedBinding.InvoicingPaymentStage] = "Numeriek ID van een facturatieschijf van één specifiek project — pas zinvol in te vullen op de mijlpaal zelf ná instantiatie, niet hier in het sjabloon.",
        [(int)ComputedBinding.ConnectionSettlement] = "Geen bron-parameter nodig — bereikt zodra de nutsafrekening van het project is afgerond.",
        [(int)ComputedBinding.Dossier] = "Geen bron-parameter nodig — bereikt zodra het gekoppelde dossier is afgehandeld (koppeling gebeurt op de mijlpaal zelf).",
    };
}

@section PageStyle {
    <link rel="stylesheet" href="~/css/traject.css" asp-append-version="true" />
}

@section PageActions {
    <span class="gl-tsa-dirty" id="tsaDirty" role="status" hidden><i class="bx bx-alert-circle" aria-hidden="true"></i> Niet-bewaarde wijzigingen</span>
    @await Html.PartialAsync("_TrajectSjabloonActions", Model)
}

@if (!Model.IsNieuw)
{
    <form method="post" asp-action="Dupliceren" asp-route-id="@s!.Id" id="duplicerenForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>
}

<!-- Topbar-acties (hierboven) verdwijnen < 768px — daar krijgen ze een eigen rij in de content-body. -->
<div class="d-flex d-md-none justify-content-end gap-2 mb-3">
    @await Html.PartialAsync("_TrajectSjabloonActions", Model)
</div>

@* Vervangt de kale browser-confirm() op Dupliceren/fase- en mijlpaal-verwijderen — het enige moment
   waarop deze pagina voorheen buiten het "Grounded & Cultivated"-systeem (DESIGN.md) viel. Inhoud
   (titel/body/knoplabel) wordt per aanroep ingevuld door window.confirmDialog() (~/js/confirm-modal.js). *@
@await Html.PartialAsync("_ConfirmModal")

<div class="gl-form-shell__tabs" role="tablist" aria-label="Trajectsjabloon" data-tabgroup="tsa-edit">
    <button type="button" class="gl-form-shell__tab" role="tab" id="tabbtn-structuur" data-tab="structuur"
            aria-controls="tab-structuur" aria-selected="true" tabindex="0">
        <i class="bx bx-git-branch" aria-hidden="true"></i><span>Structuur</span>
    </button>
    <button type="button" class="gl-form-shell__tab" role="tab" id="tabbtn-tijdlijn" data-tab="tijdlijn"
            aria-controls="tab-tijdlijn" aria-selected="false" tabindex="-1">
        <i class="bx bx-timer" aria-hidden="true"></i><span>Tijdlijn &amp; simulatie</span>
    </button>
    <button type="button" class="gl-form-shell__tab" role="tab" id="tabbtn-controle" data-tab="controle"
            aria-controls="tab-controle" aria-selected="false" tabindex="-1">
        <i class="bx bx-shield-alt" aria-hidden="true"></i><span>Controle</span>
        <span class="gl-form-shell__tab-badge" id="tsaControleBadge" hidden>0</span>
    </button>
</div>

<form method="post" asp-action="Opslaan" id="sjabloonForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="payloadJson" id="payloadJson" />
</form>

<div class="card card-modern gl-fixed-actions-offset">
<div class="card-body">
<div id="tab-structuur" class="gl-form-shell__panel gl-tsa-panel" role="tabpanel" aria-labelledby="tabbtn-structuur" tabindex="0">
    <section class="gl-form-section">
        <div class="gl-form-section__body">
            <div class="gl-tsa-meta-row">
                <div class="gl-field" style="flex:2 1 220px">
                    <label for="sj-naam">Naam van het sjabloon</label>
                    <input type="text" id="sj-naam" class="form-control form-control-modern" value="@(s?.Naam)" required aria-describedby="sj-naam-error" />
                    <small id="sj-naam-error" class="text-danger" role="alert" hidden>Vul een naam in — dit is verplicht om het sjabloon te kunnen opslaan.</small>
                </div>
                <div class="gl-field" style="flex:1 1 160px">
                    <label for="sj-type">Projecttype</label>
                    <select id="sj-type" class="form-select form-control-modern">
                        <option value="">Alle</option>
                        <option value="1" selected="@(s?.ProjectType == 1)">Woonproject</option>
                        <option value="2" selected="@(s?.ProjectType == 2)">Commercieel</option>
                    </select>
                </div>
                <div class="gl-field" style="flex:2 1 220px">
                    <label for="sj-omschrijving">Korte omschrijving</label>
                    <input type="text" id="sj-omschrijving" class="form-control form-control-modern" value="@(s?.Omschrijving)" />
                </div>
                <div class="gl-switch-row">
                    <span class="gl-toggle"><input type="checkbox" id="sj-standaard" @(s?.IsStandaard == true ? "checked" : "") /><span></span></span>
                    <label for="sj-standaard">Standaard voor dit type</label>
                </div>
                <div class="gl-switch-row">
                    <span class="gl-toggle"><input type="checkbox" id="sj-actief" @(s == null || s.IsActief ? "checked" : "") /><span></span></span>
                    <label for="sj-actief">Actief</label>
                </div>
            </div>
        </div>
    </section>

    <div class="gl-tsa-split">
        <div class="gl-tsa-tree-col">
            <div class="gl-tsa-detail-head">
                <div class="gl-tsa-detail-head-left">
                    <div class="gl-tsa-detail-icon" aria-hidden="true"><i class="bx bx-git-branch"></i></div>
                    <div>
                        <h2 class="gl-tsa-detail-title">Fases &amp; mijlpalen</h2>
                        <p class="gl-tsa-detail-subtitle">sleep, of gebruik pijltjestoetsen + Alt om te verplaatsen</p>
                    </div>
                </div>
            </div>
            <div class="gl-tsa-tree-body">
                <div id="faseTree" class="gl-tsa-tree"></div>
                <div class="gl-tsa-tree-foot">
                    <button type="button" class="btn btn-sm btn-light border" id="btnAddFase"><i class="bx bx-plus" aria-hidden="true"></i> Fase toevoegen</button>
                    <button type="button" class="btn btn-sm btn-light border" id="btnToggleAll">Alles openen</button>
                </div>
            </div>
        </div>
        <div class="gl-tsa-detail-col" id="detailPane"></div>
    </div>
</div>

<div id="tab-tijdlijn" class="gl-form-shell__panel gl-tsa-panel" role="tabpanel" aria-labelledby="tabbtn-tijdlijn" tabindex="0" hidden>
    <div class="gl-tsa-tl-toolbar">
        <div class="gl-field" style="flex:0 0 auto">
            <label for="tsaSimStart">Fictieve projectstart</label>
            <input type="date" id="tsaSimStart" class="form-control form-control-modern" />
        </div>
        <div style="flex:0 0 auto">
            <span class="gl-tsa-field-label" id="tsaTlModeLabel" style="display:block;margin-bottom:.3rem">Weergave</span>
            <div class="gl-segmented" id="tsaTlMode" role="group" aria-labelledby="tsaTlModeLabel" style="height:38px">
                <button type="button" data-mode="dagen" aria-pressed="true" class="is-active">Dagen na start</button>
                <button type="button" data-mode="datums" aria-pressed="false">Datums</button>
            </div>
        </div>
        <p class="gl-tsa-tl-toolbar-hint">De streefdatums worden berekend door de ankerketen te volgen. Een mijlpaal zonder geldig anker valt terug op de projectstart en wordt rood gemarkeerd. Enkel een preview — er wordt niets bewaard.</p>
    </div>
    <div id="tijdlijnContainer"></div>
</div>

<div id="tab-controle" class="gl-form-shell__panel gl-tsa-panel" role="tabpanel" aria-labelledby="tabbtn-controle" tabindex="0" hidden>
    <div id="controleContainer"></div>
</div>
</div>
</div>

@* Opslaan hoort bij dit formulier, niet bij de generieke topbar (DESIGN.md Form-Shell Rule) — vaste
   balk onderaan i.p.v. de eerdere bespoke topbar-knop, en levert meteen ook de Annuleren-knop die
   deze pagina nog niet had. SubmitFormId="sjabloonForm": de knop leeft buiten dat <form> (de balk is
   position:fixed t.o.v. de viewport, geen DOM-afstammeling), dus posten via het form="..."-attribuut. *@
@await Html.PartialAsync("_FormShellActions", new CPMCore.Models.FormShellActionsModel
{
    SubmitLabel = "Sjabloon opslaan",
    SubmitFormId = "sjabloonForm",
    CancelUrl = Url.Action("Index")
})

@section PageScripts {
    <script id="sjabloonData" type="application/json">@Html.Raw(JsonSerializer.Serialize(initial))</script>
    <script id="typeOpties" type="application/json">@Html.Raw(JsonSerializer.Serialize(typeOpties))</script>
    <script id="rolOpties" type="application/json">@Html.Raw(JsonSerializer.Serialize(rolOpties))</script>
    <script id="bindingOpties" type="application/json">@Html.Raw(JsonSerializer.Serialize(bindingOpties))</script>
    <script id="triggerEventOpties" type="application/json">@Html.Raw(JsonSerializer.Serialize(triggerEventOpties))</script>
    <script id="triggerActieOpties" type="application/json">@Html.Raw(JsonSerializer.Serialize(triggerActieOpties))</script>
    <script id="dossierKindOpties" type="application/json">@Html.Raw(JsonSerializer.Serialize(dossierKindOpties))</script>
    <script id="projectVlagOpties" type="application/json">@Html.Raw(JsonSerializer.Serialize(projectVlagOpties))</script>
    <script id="bronParamOptiesByBinding" type="application/json">@Html.Raw(JsonSerializer.Serialize(bronParamOptiesByBinding))</script>
    <script id="bronParamModeByBinding" type="application/json">@Html.Raw(JsonSerializer.Serialize(bronParamModeByBinding))</script>
    <script id="bronParamHintByBinding" type="application/json">@Html.Raw(JsonSerializer.Serialize(bronParamHintByBinding))</script>
    <script>
        (function () {
            var strip = document.querySelector('.gl-form-shell__tabs[data-tabgroup="tsa-edit"]');
            if (!strip) return;
            var tabs = Array.prototype.slice.call(strip.querySelectorAll('.gl-form-shell__tab'));
            var panels = tabs.map(function (t) { return document.getElementById(t.getAttribute('aria-controls')); });

            function activate(name) {
                tabs.forEach(function (t, i) {
                    var on = t.dataset.tab === name;
                    t.setAttribute('aria-selected', on ? 'true' : 'false');
                    t.tabIndex = on ? 0 : -1;
                    if (panels[i]) panels[i].hidden = !on;
                });
                document.dispatchEvent(new CustomEvent('tsa:tab', { detail: { tab: name } }));
                window.dispatchEvent(new Event('resize'));
            }

            tabs.forEach(function (t) {
                t.addEventListener('click', function () { activate(t.dataset.tab); });
                t.addEventListener('keydown', function (e) {
                    var i = tabs.indexOf(t), next = null;
                    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = tabs[(i + 1) % tabs.length];
                    else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = tabs[(i - 1 + tabs.length) % tabs.length];
                    if (next) { e.preventDefault(); next.focus(); activate(next.dataset.tab); }
                });
            });
        })();
    </script>
    <script src="~/js/confirm-modal.js" asp-append-version="true"></script>
    <script src="~/js/trajectsjabloon.admin.js" asp-append-version="true"></script>
}
