@model CPMCore.Models.Invoicing.InvoiceDeleteConfirmVM
@* gl-v2 layout-pilot (design-handoff optie 4j, TYPE 1 "Bevestiging" — danger-variant). Vervangt
   dit fragment (voorheen geladen in een magnific-popup/.modal-block, zie Index.cshtml's eigen
   _ModalDeleteInvoice.cshtml) — enkel de tekst is hergebruikt, geen enkele klasse/opmaak. Rendert
   rechtstreeks in de #delete-invoice-container van het al aanwezige Bootstrap-modal-schild
   (IndexV2.cshtml), dus dit fragment IS de .modal-content-inhoud (body + footer), geen eigen
   .modal/.modal-dialog wrapper nodig. *@
<div class="modal-body">
    <span class="gl-v2-modal-icon is-danger"><i class="ph ph-trash" aria-hidden="true"></i></span>
    <div class="gl-v2-modal-text">
        <h2 class="gl-v2-modal-title">Factuur verwijderen?</h2>
        <p class="gl-v2-modal-desc">
            U staat op het punt om factuur <strong>@Model.DisplayId</strong> voor <strong>@Model.ClientName</strong>
            (datum @Model.InvoiceDate.ToString("dd/MM/yyyy"), status @Model.StatusLabel) te verwijderen.
            Weet u zeker dat u deze factuur wilt verwijderen?
        </p>
    </div>
</div>
<form asp-action="Delete" asp-controller="Invoices" method="post" id="delete-invoice-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="hidden" name="issuerCompanyId" value="@Model.IssuerCompanyId" />
    @if (Model.RecurringScheduleId.HasValue)
    {
        @* Concept uit een terugkerend schema: terugzetten in het schema of de periode definitief overslaan (keuzekaarten, DESIGN.md "Keuzerondjes"). *@
        <div class="gl-v2-radio-cards gl-v2-ri-deletechoice" role="radiogroup" aria-label="Wat gebeurt er met het schema?">
            <label class="gl-v2-radio-card">
                <input type="radio" name="scheduleChoice" value="restore" @(Model.CanRestoreToSchedule ? "checked" : null) @(Model.CanRestoreToSchedule ? null : "disabled") />
                <span><b>Terug in het schema plaatsen</b><small>@(Model.CanRestoreToSchedule ? "Deze factuurdatum" + (string.IsNullOrEmpty(Model.RecurringPeriod) ? "" : " (" + Model.RecurringPeriod!.ToLowerInvariant() + ")") + " komt opnieuw onder Komende facturen en wordt later opnieuw als concept klaargezet." : "Niet mogelijk: enkel de laatst aangemaakte factuur van een lopend schema kan terug.")</small></span>
            </label>
            <label class="gl-v2-radio-card">
                <input type="radio" name="scheduleChoice" value="discard" @(Model.CanRestoreToSchedule ? null : "checked") />
                <span><b>Definitief verwijderen</b><small>Deze periode wordt niet opnieuw aangemaakt. Het schema gaat gewoon door met de volgende factuurdatum.</small></span>
            </label>
        </div>
    }
    <div class="modal-footer">
        <button type="button" class="gl-v2-btn gl-v2-btn-text" data-bs-dismiss="modal">Annuleren</button>
        <button type="submit" class="gl-v2-btn gl-v2-btn-danger">Verwijderen</button>
    </div>
</form>
