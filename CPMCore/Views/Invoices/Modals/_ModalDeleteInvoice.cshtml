@model CPMCore.Models.Invoicing.InvoiceDeleteConfirmVM
<section class="card">
    <header class="card-header">
        <h2 class="card-title">Factuur verwijderen?</h2>
    </header>
    <div class="card-body">
        <div class="modal-wrapper">
            <div class="modal-icon">
                <i class="fas fa-question-circle"></i>
            </div>
            <div class="modal-text">
                <p>
                    U staat op het punt om factuur <strong>@Model.DisplayId</strong>
                    voor <strong>@Model.ClientName</strong> (datum @Model.InvoiceDate.ToString("dd/MM/yyyy"), status @Model.Status) te verwijderen.
                    Weet u zeker dat u deze factuur wilt verwijderen?
                </p>
            </div>
        </div>
    </div>
    <footer class="card-footer">
        <div class="row">
            <div class="col-md-12 text-end">
                <form asp-action="Delete" asp-controller="Invoices" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="issuerCompanyId" value="@Model.IssuerCompanyId" />
                    <button type="submit" class="btn btn-warning">Verwijderen</button>
                </form>
                <button type="button" class="btn btn-default modal-dismiss">Annuleren</button>
            </div>
        </div>
    </footer>
</section>
