@model CPMCore.Models.Invoicing.InvoiceDetailVM
@using System.Linq
@using System.Globalization
@using CPMCore.Models.Invoicing
@using BOCore
@{
    var culture = CultureInfo.GetCultureInfo("nl-BE");
    var issuerId = ViewBag.CompanyId as int?;
    var issuerName = (ViewBag.CompanyName as string) ?? Model.Issuer.LegalName ?? Model.Issuer.Name;
    var displayId = string.IsNullOrWhiteSpace(Model.PublicId) ? $"Factuur #{Model.Id}" : Model.PublicId;
    var isDraft = Model.Status == InvoiceStatus.Draft;
    var isIssued = Model.Status == InvoiceStatus.Issued;
    var isGenerating = Model.Status == InvoiceStatus.Generating;
    var canWriteInvoices = ViewBag.CanWriteInvoices as bool? ?? false;
    var canDeleteInvoices = ViewBag.CanDeleteInvoices as bool? ?? false;
    var hasDeliveryInfo = !string.IsNullOrWhiteSpace(Model.OctopusDeliveryState)
        || Model.OctopusDeliveryDateTime.HasValue
        || Model.OctopusDeliveryUpdatedAt.HasValue
        || !string.IsNullOrWhiteSpace(Model.OctopusDeliveryComment);
    ViewData["Title"] = string.IsNullOrWhiteSpace(issuerName) ? displayId : $"{issuerName} - {displayId}";
    var detailReturnUrl = Url.Action("Detail", "Invoices", new { id = Model.Id, issuerCompanyId = issuerId });
}
@functions {

string DocumentType(InvoiceStatus status, bool isCreditNote)
        => status == InvoiceStatus.Draft
            ? "Proforma factuur"
            : isCreditNote
                ? "Creditnota"
                : "Factuur";
    string BadgeClass(InvoiceStatus status) => status switch
    {
        InvoiceStatus.Draft => "badge bg-warning text-dark",
        InvoiceStatus.Issued => "badge bg-secondary",
        InvoiceStatus.Sent => "badge bg-primary",
        InvoiceStatus.PartiallyPaid => "badge bg-info",
        InvoiceStatus.Paid => "badge bg-success",
        InvoiceStatus.Overdue => "badge bg-danger",
        InvoiceStatus.Cancelled => "badge bg-dark",
        InvoiceStatus.Generating => "badge bg-info text-dark",
        _ => "badge bg-light text-dark"
    };
    string OctopusBadgeClass(string? state) => (state ?? string.Empty).ToUpperInvariant() switch
    {
        "EMAILED" or "PEPPOL_SEND_OK" => "badge bg-primary",
        "PRINTED" or "PRINTED_AND_EMAILED" or "PUBLISHED" or "EXPORTED" => "badge bg-info text-dark",
        "ERROR" or "PEPPOL_SEND_FAILED" => "badge bg-danger",
        "PEPPOL_SENDING_IN_PROGRESS" => "badge bg-warning text-dark",
        _ => "badge bg-secondary"
    };

    string FormatOctopusState(string? state)
    {
        if (string.IsNullOrWhiteSpace(state))
            return "Onbekend";

        return state.ToUpperInvariant() switch
        {
            "EMAILED" => "Verzonden per e-mail",
            "PRINTED" => "Afgedrukt",
            "PRINTED_AND_EMAILED" => "Afgedrukt en gemaild",
            "PUBLISHED" => "Gepubliceerd",
            "EXPORTED" => "Geëxporteerd",
            "ERROR" => "Fout opgetreden",
            "PEPPOL_SEND_OK" => "Verzonden via Peppol",
            "PEPPOL_SEND_FAILED" => "Peppol verzending mislukt",
            "PEPPOL_SENDING_IN_PROGRESS" => "Bezig met verzenden via Peppol",
            _ => "Onbekende status"
        };
    }
}
@section PageStyle
{
    <link rel="stylesheet" href="~/css/invoices-custom.css" />
}


<div class="row">
    <div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
        <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
            <div class="row align-items-center">
                <div class="col-sm-auto d-flex align-items-center">
                    <a asp-action="Index" asp-route-issuerCompanyId="@issuerId" class="text-decoration-none text-reset d-flex align-items-center">
                        <i class="bx bx-chevron-left fs-1"></i>
                    </a>
                </div>
                <div class="col">
                    <h1 class="fw-bold mb-0">@Model.PublicId</h1>
                    <h5 class="mb-4 mt-0">@DocumentType(Model.Status, Model.IsCreditNote) van @Model.Issuer.Name aan @Model.Client.Name </h5>
                  
                </div>
               
            </div>
        </div>
        <div class="col-auto align-self-start">
            <div class="btn-group" role="group">
                @if (canWriteInvoices && !isGenerating)
                {
                    <a class="btn btn-default btn-md px-3 me-1"
                       asp-action="Edit"
                       asp-route-id="@Model.Id"
                       asp-route-issuerCompanyId="@issuerId"
                       asp-route-returnUrl="@(detailReturnUrl ?? string.Empty)">
                        <i class="bx @(isDraft ? "bx-pencil" : "bx-lock") me-2"></i>
                        Bewerken
                    </a>
                }
                @if (canWriteInvoices && !isDraft && !isGenerating)
                {
                    <a class="btn btn-primary btn-md px-3 me-1"
                       asp-action="Send"
                       asp-route-id="@Model.Id"
                       asp-route-issuerCompanyId="@issuerId">
                        <i class="bx bx-send me-2"></i>
                        Verzenden
                    </a>
                }
                <a class="btn btn-default btn-md px-3" asp-action="Pdf" asp-route-id="@Model.Id" target="_blank"><i class="fas fa-file-pdf me-2"></i>Download</a>
               
            </div>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-lg-4 mb-3">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Factuurverstrekker</h5>
            </div>
            <div class="card-body">
                <strong>@(Model.Issuer.LegalName ?? Model.Issuer.Name)</strong><br />
                @if (!string.IsNullOrWhiteSpace(Model.Issuer.AddressLine1))
                {
                    @Model.Issuer.AddressLine1
                
                    <br />
                }
                @if (!string.IsNullOrWhiteSpace(Model.Issuer.AddressLine2))
                {
                    @Model.Issuer.AddressLine2
                
                    <br />
                }
                @if (!string.IsNullOrWhiteSpace(Model.Issuer.PostalCode) || !string.IsNullOrWhiteSpace(Model.Issuer.City))
                {
                    <text>@Model.Issuer.PostalCode @Model.Issuer.City</text>
                
                    <br />
                }
               
                @if (!string.IsNullOrWhiteSpace(Model.Issuer.VatNumber))
                {
                    <span>BTW: @Model.Issuer.VatNumber</span>
                
                    <br />
                }
                @if (!string.IsNullOrWhiteSpace(Model.Issuer.Email))
                {
                    <span>Email: @Model.Issuer.Email</span>
                
                    <br />
                }
                @if (!string.IsNullOrWhiteSpace(Model.Issuer.Phone))
                {
                    <span>Tel: @Model.Issuer.Phone</span>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4 mb-3">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Geadresseerde</h5>
            </div>
            <div class="card-body">
                <strong>@Model.Client.Name</strong><br />
                @if (!string.IsNullOrWhiteSpace(Model.Client.AddressLine1))
                {
                    @Model.Client.AddressLine1
                
                    <br />
                }
                @if (!string.IsNullOrWhiteSpace(Model.Client.PostalCode) || !string.IsNullOrWhiteSpace(Model.Client.City))
                {
                    <text>@Model.Client.PostalCode @Model.Client.City</text>
                
                    <br />
                }
                @if (!string.IsNullOrWhiteSpace(Model.Client.Country))
                {
                    @Model.Client.Country
                
                    <br />
                }
                @if (!string.IsNullOrWhiteSpace(Model.Client.VatNumber))
                {
                    <span>BTW: @Model.Client.VatNumber</span>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4 mb-3">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-0">@DocumentType(Model.Status, Model.IsCreditNote) Details</h5>
            </div>
            <div class="card-body">
                Documentnummer: <strong>@Model.PublicId</strong><br />
                Factuurdatum: @Model.InvoiceDate.ToString("dd/MM/yyyy")<br />
                @if (Model.PaymentTermDisplayMode == PaymentTermDisplayMode.Text && !string.IsNullOrWhiteSpace(Model.PaymentTermDisplayText))
                {
                    <span>Betaalvoorwaarden: @Model.PaymentTermDisplayText</span>
                
                    <br />
                }
                else if (Model.ExpirationDate.HasValue)
                {
                    <span>Vervaldatum: @Model.ExpirationDate.Value.ToString("dd/MM/yyyy")</span>
                
                    <br />
                }
                Status: <span class="@BadgeClass(Model.Status)">@Model.StatusLabel</span>
                <div class="mt-3">
                    @if (Model.OctopusDocumentSequenceNr.HasValue)
                    {
                        <div>Octopus doc.nr: <strong>@Model.OctopusDocumentSequenceNr</strong></div>
                        @if (!string.IsNullOrWhiteSpace(Model.OctopusJournalKey))
                        {
                            <div>Octopus dagboek: @Model.OctopusJournalKey</div>
                        }
                    }
                    else if (hasDeliveryInfo)
                    {
                        <div class="small text-muted">Octopus documentnummer ontbreekt; controleer de nummering om de leverstatus te kunnen ophalen.</div>
                    }
                    <div class="mt-1">Leverstatus: <span class="@OctopusBadgeClass(Model.OctopusDeliveryState)">@FormatOctopusState(Model.OctopusDeliveryState)</span></div>
                    @if (Model.OctopusDeliveryDateTime.HasValue)
                    {
                        <div>Leveringsmoment: @Model.OctopusDeliveryDateTime.Value.ToString("g")</div>
                    }
                    @if (Model.OctopusDeliveryUpdatedAt.HasValue)
                    {
                        <div>Laatst gecontroleerd: @Model.OctopusDeliveryUpdatedAt.Value.ToString("g")</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.OctopusDeliveryComment))
                    {
                        <div class="small text-muted">@Model.OctopusDeliveryComment</div>
                    }
                </div>
             
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.HeaderText) || !string.IsNullOrWhiteSpace(Model.DetailText))
{
    <div class="card mb-3">
        <div class="card-header">
            <h5 class="card-title mb-0">Omschrijving</h5>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.HeaderText))
            {
                <p class="mb-2">@Model.HeaderText</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.DetailText))
            {
                <p class="mb-0 gl-ws-preline">@Model.DetailText</p>
            }
        </div>
    </div>
}

<div class="card mb-4">
    <div class="card-header">
        <h5 class="card-title mb-0">Overzicht lijnen</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped mb-0 gl-invoice-lines-table">
                <thead class="table-light">
                    <tr>
                        <th>Omschrijving</th>
                        <th>Groep</th>
                        <th class="text-end">Excl. btw</th>
                        <th class="text-end">BTW %</th>
                        <th class="text-end">BTW bedrag</th>
                        <th class="text-end">Totaal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>@line.Text</td>
                            <td>@line.GroupName</td>
                            <td class="text-end">@line.NetAmount.ToString("C", culture)</td>
                            <td class="text-end">@line.VatRate.ToString("0.##", culture) %</td>
                            <td class="text-end">@line.VatAmount.ToString("C", culture)</td>
                            <td class="text-end">@line.GrossAmount.ToString("C", culture)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="p-3">
            <div class="row g-2 justify-content-end">
                <div class="col-auto text-end">
                    <div>Totaal excl. btw</div>
                    <div>BTW</div>
                    <div class="fw-bold">Totaal incl. btw</div>
                    @if (Model.PaidAmount.HasValue)
                    {
                        <div>Reeds betaald</div>
                    }
                    @if (Model.Balance.HasValue)
                    {
                        <div>Openstaand saldo</div>
                    }
                </div>
                <div class="col-auto text-end">
                    <div>@Model.TotalExclVat.ToString("C", culture)</div>
                    <div>@Model.TotalVat.ToString("C", culture)</div>
                    <div class="fw-bold">@Model.TotalInclVat.ToString("C", culture)</div>
                    @if (Model.PaidAmount.HasValue)
                    {
                        <div>@Model.PaidAmount.Value.ToString("C", culture)</div>
                    }
                    @if (Model.Balance.HasValue)
                    {
                        <div>@Model.Balance.Value.ToString("C", culture)</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.BankAccount) || !string.IsNullOrWhiteSpace(Model.ExtraInfo))
{
    <div class="card mb-4">
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.BankAccount))
            {
                <p class="mb-1"><strong>Rekeningnummer:</strong> @Model.BankAccount</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ExtraInfo))
            {
                <p class="mb-0 gl-ws-preline">@Model.ExtraInfo</p>
            }
        </div>
    </div>
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Verzendgeschiedenis</h5>
        @if (Model.LastEmailSentAt.HasValue)
        {
            <span class="badge bg-success-subtle text-success">Laatst op @Model.LastEmailSentAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
        }
        else
        {
            <span class="badge bg-light text-body-secondary">Nog geen e-mails</span>
        }
    </div>
    <div class="card-body p-0">
        @if (Model.EmailLogs.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="text-nowrap">Datum</th>
                            <th>Ontvanger</th>
                            <th>CC</th>
                            <th>Onderwerp</th>
                            <th class="text-nowrap">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.EmailLogs.OrderByDescending(l => l.SentAt))
                        {
                            <tr>
                                <td>@log.SentAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@log.To</td>
                                <td>@(string.IsNullOrWhiteSpace(log.Cc) ? "-" : log.Cc)</td>
                                <td class="text-break">@log.Subject</td>
                                <td><span class="badge bg-light text-body-secondary">@log.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-3 text-muted">Er zijn nog geen e-mailverzendingen geregistreerd voor deze factuur.</div>
        }
    </div>
</div>