@model CPMCore.Models.Invoicing.InvoiceComposeVM

<section class="card card-modern mt-4" id="freeLineBlock" style="display:none">
    <div class="card-body pb-2">
        <div class="row">
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="fw-bold mb-0">Vrije lijnen</h4>
        </div>
        </div>
        <div class="row">
        <div class="table-responsive mt-3 mb-0">
            <table id="freeLinesTable" class="table align-middle w-100">
                <thead>
                    <tr>
                        <th class="gl-col-drag"></th>   <!-- drag handle -->
                        <th>Volgorde</th>               <!-- WORDT VERBORGEN via DataTables -->
                        <th>Omschrijving</th>
                        <th class="text-end gl-col-80">Aantal</th>
                        <th class="text-end gl-col-140">Eenheidsprijs</th>
                        <th class="text-end gl-col-140">BTW&nbsp;%</th>
                        <th class="text-end gl-col-sm">Acties</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        </div>
        <div class="row text-end">
        <button type="button" class="btn btn-default mt-2 mb-0" id="addFreeLine">
            <i class="fas fa-plus me-1"></i> Regel toevoegen
        </button>
        </div>
    </div>
</section>

<!-- Template + Hidden -->
<template id="freeLineRowTpl">
    <tr class="gl-free-row">
        <td class="gl-reorder-handle" title="Sleep om te verplaatsen"><i class="fas fa-grip-vertical"></i></td>
        <td></td>
        <td><input class="form-control form-control-sm js-fl-text" data-col="Text" maxlength="200" /></td>
        <td class="text-end"><input class="form-control form-control-sm text-end js-fl-qty" data-col="Quantity" type="text" placeholder="1" /></td>
        <td class="text-end"><input class="form-control form-control-sm text-end js-fl-price" data-col="Price" type="text" /></td>
        <td class="text-end">
            <select class="form-select form-select-sm js-fl-vat-select" data-col="VatPercentage">
                @foreach (var v in Model.VatTypes)
                {
                    <option value="@v.Id" data-pct="@v.BasePercentage" data-code="@v.Code">
                        @v.Code - @v.Description (@v.BasePercentage.ToString("0.##")%)
                    </option>
                }
            </select>
        </td>
        <td class="text-end">
            <a data-toggle="tooltip" data-placement="top" title="Verwijderen" data-original-title="Verwijderen" class="js-fl-del" id="editAccount"><i class="fas fa-trash"></i></a>
        </td>
    </tr>
</template>

<select id="freeLineVatOptions" class="d-none">
    @foreach (var v in Model.VatTypes)
    {
        <option value="@v.Id" data-pct="@v.BasePercentage" data-code="@v.Code">
            @v.Code - @v.Description (@v.BasePercentage.ToString("0.##")%)
        </option>
    }
</select>
<div id="freeLinesHidden" class="d-none"></div>