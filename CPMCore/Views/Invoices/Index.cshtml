@model IReadOnlyList<CPMCore.Models.Invoicing.InvoiceListItemVM>
@using System.Globalization
@using CPMCore.Models.Invoicing
@using BOCore
@{
    var culture = CultureInfo.GetCultureInfo("nl-BE");
    ViewData["Title"] = "Facturen - " + @ViewBag.CompanyName;
    var currentPath = Context.Request.Path.ToString();
    var currentQuery = Context.Request.QueryString.ToString();
    var returnUrl = string.Concat(currentPath, currentQuery);
    var bookYears = Model.Select(r => r.BookyearLabel ?? r.InvoiceDate.Year.ToString())
        .Distinct()
        .OrderByDescending(y => y)
        .ToList();
    var defaultBookYear = ViewBag.DefaultBookyearLabel as string ?? bookYears.FirstOrDefault();
    var canWriteInvoices = ViewBag.CanWriteInvoices as bool? ?? false;
    var canDeleteInvoices = ViewBag.CanDeleteInvoices as bool? ?? false;
}
@functions {
    (string Icon, string Color) StatusIcon(InvoiceStatus status) => status switch
    {
        InvoiceStatus.Draft => ("bx bx-edit", "#6c757d"),
        InvoiceStatus.Issued => ("bx bx-export", "#0dcaf0"),
        InvoiceStatus.Sent => ("bx bx-paper-plane", "#ffc107"),
        InvoiceStatus.PartiallyPaid => ("bx bx-wallet-note", "#fd7e14"),
        InvoiceStatus.Paid => ("bx bx-check-circle", "#01532d"),
        InvoiceStatus.Overdue => ("bx bx-alert-circle", "#dc3545"),
        InvoiceStatus.Cancelled => ("bx bx-block", "#343a40"),
        InvoiceStatus.Booked => ("bx bx-book", "#6f42c1"),
        InvoiceStatus.Generating => ("bx bx-loader-alt bx-spin", "#0d6efd"),
        _ => ("bx bx-help-circle", "#6c757d")
    };
 string DocumentType(InvoiceStatus status, bool isCreditNote)
        => status == InvoiceStatus.Draft
            ? "Proforma factuur"
            : isCreditNote
                ? "Creditnota"
                : "Factuur";
    bool StatusIn(InvoiceStatus status, params InvoiceStatus[] codes)
    {
        
        foreach (var code in codes)
        {
            if (status == code)
                return true;
        }
        return false;
    }
}
@section PageStyle
{
    <link rel="stylesheet" href="~/lib/magnific-popup/magnific-popup.css" />
    <link href="https://cdn.datatables.net/v/bs5/jszip-3.10.1/dt-2.2.2/b-3.2.2/b-colvis-3.2.2/b-html5-3.2.2/b-print-3.2.2/datatables.min.css" rel="stylesheet" integrity="sha384-W8PzvGseaJlM52wTjdPHNrEA9WHp36V+XpQyv1gCKz+1sbFfDo5MlMDT7awB3rAs" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/invoices-custom.css" />
}
 <div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
        <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
            <h1 class="font-weight-bold mb-0 mt-0">Facturen</h1>
            <h5 class="mb-4 mt-0">Beheer de facturen van @ViewBag.CompanyName</h5>
        </div>
        <div class="col-sm-auto px-0">
        <div class="btn-group" role="group" aria-label="Project acties">
            @if (canWriteInvoices)
            {
                <button type="button" class="btn btn-primary btn-md px-3 me-1" id="btnExportExcel"><i class="fas fa-file-excel"></i></button>
            }
            <button type="button" class="btn btn-primary btn-md px-3 me-1" id="btnExportPdf"><i class="fas fa-file-pdf"></i></button>
            @if (canWriteInvoices)
            {
                <button type="submit" class="btn btn-primary btn-md px-3 me-1" id="btnBookInvoices" form="invoice-book-form" disabled>Boeken facturen</button>
                <a href="@Url.Action("Create", "Invoices", new { issuerId = ViewBag.CompanyId })" class="btn btn-primary btn-md">+ Nieuwe Factuur</a>
            }
            </div>
        </div>
    </div>
@if(Model.Any())
{
        <div class="card card-modern">
            <div class="card-body">
                <div class="row">
            <div class="col mb-4 mb-sm-0 mt-2 mt-sm-0">
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bx bx-search"></i>
                    </span>
                    <input type="text" class="form-control me-2" name="search-term" id="search-term" placeholder="Zoeken ...">
            </div>
            </div>
            <div class="col-sm-auto px-0">
                    <div class="input-group">
                    <span class="input-group-text">
                        <i class="bx bx-calendar"></i>
                    </span>
                    <select class="form-select me-2" name="bookyear" id="bookyear-filter-select">
                        <option value="">Alle boekjaren</option>
                        @foreach (var bookYear in bookYears)
                        {
                            <option value="@bookYear" selected="@(bookYear == defaultBookYear ? "selected" : null)">@bookYear</option>
                        }
                    </select>
                    </div>
                    </div>
            </div>
            </div>
        </div>
    <div class="card card-modern">
        <div class="card-body">
            <div class="datatables-header-footer-wrapper  mt-2">

                <form asp-action="BookInvoices" method="post" id="invoice-book-form" class="js-invoice-processing-form" data-processing-message="Facturen worden geboekt...">
                    <input type="hidden" name="issuerCompanyId" value="@ViewBag.CompanyId" />
            <div class="table-responsive-md">
                <table class="table table-hover mb-0 w-100 gl-dt-invoice" id="datatable-invoice-list">
                    <thead>
                        <tr>
                            <th class="gl-col-fit text-center">Boeken</th>
                            <th class="gl-col-fit">Type</th>
                            <th class="gl-col-fit">Factuurnr</th>
                            <th class="gl-col-fit">Datum</th>
                            <th class="gl-col-grow">Klant</th>
                            <th class="gl-col-fit text-end">Totaal</th>
                            <th class="gl-col-fit">Status</th>
                            <th class="gl-col-fit">Project</th>
                            <th class="gl-col-fit">Verzendwijze</th>
                            <th class="gl-col-fit text-end">Acties</th>
                                <th class="d-none">Boekjaar</th>
                        </tr>
                    </thead>

                    <tbody>
                    @foreach (var r in Model)
                    {
                        var isDraft = StatusIn(r.Status, InvoiceStatus.Draft);
                        var displayId = string.IsNullOrWhiteSpace(r.PublicId) ? $"[{r.Id}]" : r.PublicId;
                        var shownId = isDraft ? string.Empty : displayId;
                        var typeLabel = DocumentType(r.Status, r.IsCreditNote);
                        var statusDisplay = StatusIcon(r.Status);
                                    var isBooked = r.OctopusBookedAt.HasValue || r.Status == InvoiceStatus.Booked;
                                    var isBookable = r.OctopusDocumentSequenceNr.HasValue
                                    && r.OctopusBookyearId.HasValue
                                    && !string.IsNullOrWhiteSpace(r.OctopusJournalKey)
                                    && r.Status != InvoiceStatus.Generating;

                                    <tr>
                                        <td class="gl-col-fit text-center">
                                            <div class="checkbox-custom checkbox-default">
                                                <input type="checkbox"
                                                       class="form-check-input invoice-book-checkbox"
                                                       name="invoiceIds"
                                                       value="@r.Id"
                                                       data-seq="@r.OctopusDocumentSequenceNr"
                                                       data-booked="@(isBooked.ToString().ToLowerInvariant())"
                                                       data-bookable="@(isBookable.ToString().ToLowerInvariant())"
                                                       @((!canWriteInvoices || !isBookable || isBooked) ? "disabled" : null)
                                                       @(isBooked ? "checked" : null) />
                                                <label for="checkboxExample1"></label>
                                            </div>
                                           
                                        </td>
                            <td class="gl-col-fit">@typeLabel</td>

                            <td class="gl-col-fit" data-order="@r.InvoiceSortValue">
                                @(!string.IsNullOrEmpty(shownId) ? shownId : Html.Raw("&nbsp;"))
                            </td>

                            <td class="gl-col-fit text-nowrap">@r.InvoiceDate.ToString("dd/MM/yyyy", culture)</td>

                            <td class="gl-col-grow gl-td-ellipsis" title="@r.ClientName">@r.ClientName</td>

                            <td class="gl-col-fit text-end text-nowrap">
                                @(r.GrossTotal.HasValue ? r.GrossTotal.Value.ToString("C", culture) : "-")
                            </td>

                            <td class="gl-col-fit gl-status-col" data-order="@r.StatusLabel">
                                <span class="status-icon gl-color-dynamic" style="--gl-status-color:@statusDisplay.Color">
                                    <i class="@statusDisplay.Icon fs-5"></i>
                                </span>

                                @if (r.DigitallySent)
                                {
                                    <span class="status-icon gl-color-brown"
                                          data-bs-toggle="tooltip"
                                          data-bs-placement="top"
                                          title="Verzonden via peppol">
                                        <i class="bx bx-planet fs-5"></i>
                                    </span>
                                }
                            </td>

                            <td class="gl-col-fit gl-td-ellipsis" title="@(string.IsNullOrWhiteSpace(r.ProjectName) ? "-" : r.ProjectName)">
                                @(string.IsNullOrWhiteSpace(r.ProjectName) ? "-" : r.ProjectName)
                            </td>

                            <td class="gl-col-fit text-nowrap">@r.SendMethod</td>

                                        <td class="gl-col-fit actions">
                                            <div class="d-flex align-items-center justify-content-end gap-1 flex-nowrap">
                                            @if (canWriteInvoices)
                                            {
                                                <a data-placement="top" title="Dupliceren" data-original-title="Dupliceren"
                                                   asp-action="Create"
                                                   asp-route-issuerId="@ViewBag.CompanyId"
                                                   asp-route-duplicateInvoiceId="@r.Id">
                                                    <i class="bx bx-copy fs-5"></i>
                                                    <span class="visually-hidden">Dupliceren</span>
                                                </a>
                                            }

                                            @if (StatusIn(r.Status, InvoiceStatus.Draft))
                                            {
                                                @if (canWriteInvoices)
                                                {
                                                    <a data-placement="top" title="Bewerken" data-original-title="Bewerken"
                                                       asp-action="Edit"
                                                       asp-route-id="@r.Id"
                                                       asp-route-returnUrl="@returnUrl">
                                                        <i class="bx bx-pencil fs-5"></i>
                                                        <span class="visually-hidden">Bewerken</span>
                                                    </a>
                                                }
                                                <a data-placement="top" title="Details" data-original-title="Details"
                                                   asp-action="Detail"
                                                   asp-route-id="@r.Id"
                                                   asp-route-issuerCompanyId="@ViewBag.CompanyId">
                                                    <i class="bx bx-eye fs-5"></i>
                                                    <span class="visually-hidden">Details</span>
                                                </a>
                                                <a data-placement="top" title="PDF Export" data-original-title="PDF Export"
                                                   asp-action="Pdf"
                                                   asp-route-id="@r.Id"
                                                   target="_blank">
                                                    <i class="fa-regular fa-file-pdf fs-5"></i>
                                                </a>
                                                @if (r.ShowPrintButton)
                                                {
                                                    <a data-placement="top" title="Afdrukken" data-original-title="Afdrukken"
                                                       asp-action="Pdf"
                                                       asp-route-id="@r.Id"
                                                       target="_blank">
                                                        <i class="bx bx-printer fs-5"></i>
                                                    </a>
                                                }
                                                @if (canWriteInvoices)
                                                {
                                                    <a data-placement="top" title="Nummeren" data-original-title="Nummeren"
                                                       asp-action="Issue"
                                                       asp-route-id="@r.Id"
                                                       asp-route-issuerCompanyId="@ViewBag.CompanyId"
                                                       class="js-issue-invoice"
                                                       data-processing-message="Factuur wordt genummerd...">
                                                        <i class="bx bx-lock fs-5"></i>
                                                        <span class="visually-hidden">Nummeren</span>
                                                    </a>
                                                }
                                                @if (canDeleteInvoices)
                                                {
                                                    <a href="#ModalDeleteInvoice"
                                                       class="deleteInvoice"
                                                       data-id="@r.Id"
                                                       data-issuer="@ViewBag.CompanyId"
                                                       data-placement="top" title="Verwijderen" data-original-title="Verwijderen">
                                                        <i class="bx bx-trash fs-5"></i>
                                                    </a>
                                                }
                                            }
                                            else
                                            {
                                                <a data-placement="top" title="Details" data-original-title="Details"
                                                   asp-action="Detail"
                                                   asp-route-id="@r.Id"
                                                   asp-route-issuerCompanyId="@ViewBag.CompanyId">
                                                    <i class="bx bx-eye fs-5"></i>
                                                </a>
                                                <a data-placement="top" title="PDF Export" data-original-title="PDF Export"
                                                   asp-action="Pdf"
                                                   asp-route-id="@r.Id"
                                                   target="_blank">
                                                    <i class="fa fa-file-pdf fs-5"></i>
                                                </a>
                                                @if (r.ShowPrintButton)
                                                {
                                                    <a data-placement="top" title="Afdrukken" data-original-title="Afdrukken"
                                                       asp-action="Pdf"
                                                       asp-route-id="@r.Id"
                                                       target="_blank">
                                                        <i class="bx bx-printer fs-5"></i>
                                                    </a>
                                                }
                                                @if (canWriteInvoices && StatusIn(r.Status, InvoiceStatus.Issued))
                                                {
                                                    <a data-placement="top" title="Beperkt bewerken" data-original-title="Bewerken"
                                                       asp-action="Edit"
                                                       asp-route-id="@r.Id"
                                                       asp-route-issuerCompanyId="@ViewBag.CompanyId"
                                                       asp-route-returnUrl="@returnUrl">
                                                        <i class="bx bx-pencil fs-5"></i>
                                                        <span class="visually-hidden">Bewerken</span>
                                                    </a>
                                                }
                                                @if (canWriteInvoices && !StatusIn(r.Status, InvoiceStatus.Generating))
                                                {
                                                    <a data-placement="top" title="Verzenden" data-original-title="Verzenden"
                                                       asp-action="Send"
                                                       asp-route-id="@r.Id"
                                                       asp-route-issuerCompanyId="@ViewBag.CompanyId">
                                                        <i class="bx bx-send fs-5"></i>
                                                    </a>
                                                }
                                                @if (canDeleteInvoices)
                                                {
                                                    <a href="#ModalDeleteInvoice"
                                                       class="deleteInvoice"
                                                       data-id="@r.Id"
                                                       data-issuer="@ViewBag.CompanyId"
                                                       data-placement="top" title="Verwijderen" data-original-title="Verwijderen">
                                                        <i class="bx bx-trash fs-5"></i>
                                                    </a>
                                                }
                                            }
                                            </div>
                                        </td>

                                    <td class="d-none">@(r.BookyearLabel ?? r.InvoiceDate.Year.ToString())</td>
                                        </tr>
                                    }
                        
                    </tbody>
                    </table>
                </div>
                </form>
            </div>
        </div>

    </div> 
}
else
{
    <div class="card card-modern mb-4">
        <div class="card-body align-items-center text-center card-big-info">
            <div class="col-12 mb-3" style="font-size:83.2px; font-weight:400;color:#e7e7e7;">
                <i class="bx bx-file"></i>

            </div>
            <div class="col-12 text-muted mb-3"> 
                <h4>Er zijn geef facturen aangemaakt voor dit bedrijf. </h4>
            </div>
        </div>
    </div>
}



<div id="ModalDeleteInvoice" class="modal-block modal-block-warning mfp-hide">
    <div id="delete-invoice-container"></div>
</div>

<div class="modal fade" id="issueInvoiceConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Factuur nummeren</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Ben je zeker dat je deze factuur wil nummeren? Nadien kunnen er geen wijzigingen meer aangebracht worden aan de factuur.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuleren</button>
                <button type="button" class="btn btn-primary" id="confirmIssueInvoice">Nummeren</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="invoiceProcessingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary mb-3" role="status" aria-hidden="true"></div>
                <p class="mb-0 fw-semibold" id="invoiceProcessingMessage">Factuur wordt verwerkt...</p>
            </div>
        </div>
    </div>
</div>
        
@section PageScripts
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js" integrity="sha384-VFQrHzqBh5qiJIU0uGU5CIW3+OWpdGGJM9LBnGbuIH2mkICcFZ7lPd/AAtI7SNf7" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js" integrity="sha384-/RlQG9uf0M2vcTw3CX7fbqgbj/h8wKxw7C3zu9/GxcBPRKOEcESxaxufwRXqzq6n" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/v/bs5/jszip-3.10.1/dt-2.2.2/b-3.2.2/b-colvis-3.2.2/b-html5-3.2.2/b-print-3.2.2/datatables.min.js" integrity="sha384-GC9Im1BDtt06YOKSzkS553+5q43Nos2JSnLM31TjWFcFbzZrFhAtgCzrHDGM0iDy" crossorigin="anonymous"></script>
    <script>
          (function(){
            // delegated events vanuit de container die ALTIJD bestaat
            const $host = $('#stagesList');

            // Toggle alle rows in dezelfde groep
            $(document).on('change', '#stagesList .js-check-all', function(){
              const g = $(this).data('group');
              const checked = this.checked;
              $host.find(`.js-stage-row[data-group='${g}']`).prop('checked', checked).trigger('change');
            });

            // Sync master bij individuele toggles (en evt. totals herberekenen)
            $(document).on('change', '#stagesList .js-stage-row', function(){
              const g = $(this).data('group');
              const $rows   = $host.find(`.js-stage-row[data-group='${g}']`);
              const $master = $host.find(`.js-check-all[data-group='${g}']`);
              const allChecked = $rows.length > 0 && $rows.filter(':checked').length === $rows.length;
              $master.prop('checked', allChecked);

              // Als je subtotaal/totals hebt, herbereken hier:
              // recalcTotals();  // <- alleen als je earlier totals-code gebruikt
            });
          })();
          // ===== Naamgeving voor weergave =====
          // Pas deze 2 woorden aan en alle taalregels volgen mee
          const entity = {
            singular: 'factuur',
            plural: 'facturen'
          };

          // Modal verwijderen factuur laden

          $(document).on('click', '.deleteInvoice', function (ev) {
              ev.preventDefault();
              const id = $(this).data('id');
              const issuerId = $(this).data('issuer');
              const url = '@Url.Action("ModalDelete", "Invoices")';
              $('#delete-invoice-container').html('<div class="p-3 text-muted">Laden…</div>');
              $.get(url, { id: id, issuerCompanyId: issuerId })
                  .done(function (html) {
                      $('#delete-invoice-container').html(html);
                  })
                  .fail(function () {
                      $('#delete-invoice-container').html('<div class="p-3 text-danger">Kon factuur niet laden.</div>');
                  });

              $.magnificPopup.open({
                  items: {
                      src: '#ModalDeleteInvoice',
                      type: 'inline'
                  }
              });
          });
          const processingModalElement = document.getElementById('invoiceProcessingModal');
          const processingModal = processingModalElement
              ? new bootstrap.Modal(processingModalElement, { backdrop: 'static', keyboard: false })
              : null;
          const issueModalElement = document.getElementById('issueInvoiceConfirmModal');
          const issueModal = issueModalElement
              ? new bootstrap.Modal(issueModalElement, { backdrop: 'static', keyboard: false })
              : null;
          let issueTarget = null;

          function showProcessingModal(message) {
              if (!processingModal) {
                  return;
              }

              const text = message || 'Factuur wordt verwerkt...';
              $('#invoiceProcessingMessage').text(text);
              processingModal.show();
          }
           $(document).on('click', '.js-issue-invoice', function (ev) {
              ev.preventDefault();
              issueTarget = $(this);
              if (issueModal) {
                  issueModal.show();
              } else if (issueTarget) {
                  const href = issueTarget.attr('href');
                  if (href) {
                      showProcessingModal(issueTarget.data('processing-message'));
                      window.location = href;
                  }
              }
          });

          $('#confirmIssueInvoice').on('click', function () {
              if (!issueTarget) {
                  return;
              }

              const href = issueTarget.attr('href');
              const message = issueTarget.data('processing-message');
              if (issueModal) {
                  issueModal.hide();
              }
              showProcessingModal(message);
              if (href) {
                  window.location = href;
              }
          });


          $(document).on('click', '.js-invoice-processing-link', function (ev) {
              ev.preventDefault();
              const message = $(this).data('processing-message');
              const href = $(this).attr('href');
              showProcessingModal(message);
              if (href) {
                  window.location = href;
              }
          });

          $(document).on('submit', '.js-invoice-processing-form', function () {
              const message = $(this).data('processing-message');
              showProcessingModal(message);
          });


          function getBookingCheckboxes() {
            return $('.invoice-book-checkbox[data-bookable="true"]')
              .toArray()
              .sort((a, b) => {
                const seqA = parseInt($(a).data('seq') || 0, 10);
                const seqB = parseInt($(b).data('seq') || 0, 10);
                return seqA - seqB;
              })
              .map(cb => $(cb));
          }

          function syncBookButton() {
            const hasSelection = $('.invoice-book-checkbox[data-bookable="true"]:checked:enabled').length > 0;
            $('#btnBookInvoices').prop('disabled', !hasSelection);
          }

          function applyBookingRules() {
            const checkboxes = getBookingCheckboxes();

            checkboxes.forEach($cb => {
              if ($cb.data('booked')) {
                return;
              }
              $cb.prop('disabled', false);
            });
            syncBookButton();
          }

          $(document).on('change', '.invoice-book-checkbox', function () {
            const $current = $(this);
            if ($current.data('booked') || !$current.data('bookable')) {
              return;
            }

            const currentSeq = parseInt($current.data('seq') || 0, 10);
            const allBookable = getBookingCheckboxes();

            if (this.checked) {
              allBookable.forEach($cb => {
                const seq = parseInt($cb.data('seq') || 0, 10);
                if (seq <= currentSeq && !$cb.data('booked')) {
                  $cb.prop('checked', true);
                }
              });
            } else {
              allBookable.forEach($cb => {
                const seq = parseInt($cb.data('seq') || 0, 10);
                if (seq > currentSeq) {
                  $cb.prop('checked', false);
                }
              });
            }

            applyBookingRules();
          });
          // Bouw de DataTables language-teksten in NL met dynamische naamgeving
          function buildLanguage(e) {
            const capSing = e.singular.charAt(0).toUpperCase() + e.singular.slice(1);
            const capPlur = e.plural.charAt(0).toUpperCase() + e.plural.slice(1);

            return {
              processing:     "Bezig met verwerken…",
              search:         "Zoeken:",
              lengthMenu:     "Toon _MENU_",
              info:           `${capSing} _START_ tot _END_ van _TOTAL_ ${capPlur}`,
              infoEmpty:      `${capSing} 0 tot 0 van 0 ${capPlur}`,
              infoFiltered:   "(gefilterd uit _MAX_ totaal)",
              loadingRecords: "Bezig met laden…",
              zeroRecords:    `Geen ${e.plural} om weer te geven`,
              emptyTable:     `Er zijn geen ${e.plural} om weer te geven`,
              aria: {
                sortAscending:  ": activeer om oplopend te sorteren",
                sortDescending: ": activeer om aflopend te sorteren"
              }
            };
          }

          // ===== Init DataTable =====
               const table = new DataTable('#datatable-invoice-list', {
            order: [[2, 'desc']],
            autoWidth: false,          // <-- belangrijk
            language: buildLanguage(entity),

            layout: {
              topStart: { buttons: [ /* ... */ ] }
            },

            columnDefs: [
              // acties: niet sorteerbaar/zoekbaar
              { targets: 9, orderable: false, searchable: false, width: "1%" },
              { targets: 10, visible: false },

              // “fit” kolommen: forceer minimale breedte
              { targets: [0,1,2,4,5,6,7,8,9], width: "1%" },

              // klant = grow (rest)
              { targets: 4, width: "100%" }
            ]
          });
          table.on('draw', applyBookingRules);
          applyBookingRules();
          // ===== UI-aanpassingen / custom knoppen =====
          // Verberg standaard knoppen/search indien je eigen UI gebruikt
          $(".buttons-excel").hide();
          $(".buttons-pdf").hide();
          $(".dt-search").hide(); // DataTables v2 (v1: .dataTables_filter)

          // Koppel custom export-knoppen
          $("#btnExportExcel").on('click', function () {
            $(".buttons-excel").trigger("click");
          });
          $("#btnExportPdf").on('click', function () {
            $(".buttons-pdf").trigger("click");
          });

          // Verplaats knoppen naar een eigen container
          table.buttons(0, null).containers().appendTo('#colvis-container');

          // ===== Custom zoekveld =====
          $('#search-term').on('keyup', function () {
            table.search($(this).val()).draw();
          });

        const bookyearSelect = $('#bookyear-filter-select');
              const bookyearColumnIndex = 10;
              const defaultBookyear = '@defaultBookYear';

              function applyBookyearFilter(value) {
                table.column(bookyearColumnIndex).search(value || '').draw();
              }

              bookyearSelect.on('change', function () {
                applyBookyearFilter($(this).val());
              });

              if (defaultBookyear) {
                applyBookyearFilter(defaultBookyear);
              }

    </script>
}
