@model CPMCore.Models.Invoicing.InvoiceEditVM
@using System.Globalization
@using CPMCore.Models.Invoicing
@{
    var culture = CultureInfo.GetCultureInfo("nl-BE");
    var issuerName = (ViewBag.CompanyName as string) ?? Model.IssuerName;
    var isDraft = Model.IsDraft;
    var limitedEdit = Model.IsLimitedEdit;
    var vatTypes = ViewBag.VatTypes as List<VatTypeVM> ?? new List<VatTypeVM>();
    if (ViewData["Title"] == null)
    {
        ViewData["Title"] = string.IsNullOrWhiteSpace(issuerName)
            ? Model.DisplayId
            : $"{issuerName} - {Model.DisplayId}";
    }
}

@section PageStyle {
    <link rel="stylesheet" href="~/lib/bootstrap-datepicker/css/bootstrap-datepicker3.css" />
    <link rel="stylesheet" href="~/css/invoices-custom.css" />
}

<form asp-action="Edit" method="post" class="ecommerce-form action-buttons-fixed">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="InvoiceId" />
    <input type="hidden" asp-for="IssuerCompanyId" />
    <input type="hidden" asp-for="ReturnUrl" />

    @if (!isDraft)
    {
        <input type="hidden" asp-for="ExpirationDate" />
        <input type="hidden" asp-for="BankAccount" />
    }

    <div class="row">
        <div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
            <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
                <div class="row align-items-center">
                    <div class="col-sm-auto">
                        <h1 class="fw-bold mb-0">@ViewData["Title"]</h1>
                        <h5 class="mb-4 mt-0">
                            @(isDraft
                                                        ? "Werk de conceptfactuur af voordat je ze definitief maakt."
                                                        : "Pas de omschrijvingen van deze uitgegeven factuur aan.")
                        </h5>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (limitedEdit)
    {
        <div class="alert alert-warning d-flex align-items-center" role="alert">
            <i class="bx bx-info-circle text-4 me-2"></i>
            <div>
                Deze factuur is definitief. Enkel de algemene omschrijvingen en lijnomschrijvingen kunnen nog aangepast worden. 
            </div>
        </div>
    }

    <div class="row mt-2">
        <div class="col">
            <section class="card card-modern mb-4">
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-3 col-6">
                            <span class="gl-summary-label">Documenttype</span>
                            <div class="fw-semibold">@Model.DocumentType</div>
                        </div>
                        <div class="col-md-3 col-6">
                            <span class="gl-summary-label">Klant</span>
                            <div class="fw-semibold">@Model.ClientName</div>
                        </div>
                        <div class="col-md-3 col-6">
                            <span class="gl-summary-label">Status</span>
                            <div class="fw-semibold">@Model.StatusLabel</div>
                        </div>
                        <div class="col-md-3 col-6">
                            <span class="gl-summary-label">Factuurdatum</span>
                            <div class="fw-semibold">@Model.InvoiceDate.ToString("dd/MM/yyyy", culture)</div>
                        </div>
                    </div>
                    <div class="row g-4 mt-1">
                        <div class="col-md-3 col-6">
                            <span class="gl-summary-label">Totaal excl. btw</span>
                            <div class="fw-semibold">@Model.TotalExclVat.ToString("N2", culture)</div>
                        </div>
                        <div class="col-md-3 col-6">
                            <span class="gl-summary-label">BTW</span>
                            <div class="fw-semibold">@Model.TotalVat.ToString("N2", culture)</div>
                        </div>
                        <div class="col-md-3 col-6">
                            <span class="gl-summary-label">Te betalen</span>
                            <div class="fw-bold">@Model.TotalInclVat.ToString("N2", culture)</div>
                        </div>
                        <div class="col-md-3 col-6">
                            <span class="gl-summary-label">Vervaldatum</span>
                            <div class="fw-semibold">@(Model.ExpirationDate.HasValue? Model.ExpirationDate.Value.ToString("dd/MM/yyyy", culture) : "—")</div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col">
            <section class="card card-modern">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label" asp-for="HeaderDescription"></label>
                            <textarea asp-for="HeaderDescription" class="form-control form-control-modern gl-desc-textarea gl-desc-textarea--tall" rows="4"></textarea>
                            <span asp-validation-for="HeaderDescription" class="text-danger"> </span>
                        </div>
                        <div class="col-12">
                            <label class="form-label" asp-for="DetailDescription"></label>
                            <textarea asp-for="DetailDescription" class="form-control form-control-modern gl-desc-textarea gl-desc-textarea--tall" rows="5"></textarea>
                            <span asp-validation-for="DetailDescription" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label" asp-for="FooterDescription"></label>
                            <textarea asp-for="FooterDescription" class="form-control form-control-modern gl-desc-textarea gl-desc-textarea--tall" rows="4"></textarea>
                            <span asp-validation-for="FooterDescription" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col">
            <section class="card card-modern mt-4">
                <div class="card-body pb-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="fw-bold mb-0">Detaillijnen</h3>
                    </div>

                    @if (Model.Lines != null && Model.Lines.Count > 0)
                    {
                        <div class="table-responsive mt-3 mb-0">
                            <table class="table gl-table-lines align-middle mb-0 w-100">
                                <thead>
                                    <tr>
                                        <th>Omschrijving</th>
                                        <th class="text-end text-nowrap gl-col-140">Excl. BTW</th>
                                        <th class="text-end text-nowrap gl-col-120">BTW&nbsp;%</th>
                                        <th class="text-end text-nowrap gl-col-140">BTW</th>
                                        <th class="text-end text-nowrap gl-col-140">Incl. BTW</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < Model.Lines.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                <input type="hidden" asp-for="Lines[i].LineId" />
                                                <input asp-for="Lines[i].Text" class="form-control form-control-sm" />
                                                <span asp-validation-for="Lines[i].Text" class="text-danger"></span>
                                                @if (!string.IsNullOrWhiteSpace(Model.Lines[i].GroupName))
                                                {
                                                    <div class="text-muted small mt-1">@Model.Lines[i].GroupName</div>
                                                }
                                            </td>
                                            <td class="text-end">@Model.Lines[i].NetAmount.ToString("N2", culture)</td>
                                            <td class="text-end">@Model.Lines[i].VatRate.ToString("N2", culture)</td>
                                            <td class="text-end">@Model.Lines[i].VatAmount.ToString("N2", culture)</td>
                                            <td class="text-end">@Model.Lines[i].GrossAmount.ToString("N2", culture)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="mt-3 text-muted">Geen lijnen gevonden voor deze factuur.</div>
                    }
                </div>
            </section>
        </div>
    </div>
    @await Html.PartialAsync("Partials/_FreeLinesTable", new InvoiceComposeVM { VatTypes = vatTypes })
    <div class="row action-buttons mt-4">
        <div class="col-12 col-md-auto">
            <button type="submit" class="submit-button btn btn-primary btn-px-4 py-3 d-flex align-items-center font-weight-semibold line-height-1" data-loading-text="Laden...">
                <i class="bx bx-save text-4 me-2"></i> Opslaan
            </button>
        </div>
        <div class="col-12 col-md-auto px-md-0 mt-3 mt-md-0">
            @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
            {
                <a href="@Model.ReturnUrl"
                   class="cancel-button btn btn-light btn-px-4 py-3 border font-weight-semibold text-color-dark text-3">Annuleren</a>
            }
            else
            {
                <a asp-action="Detail"
                   asp-route-id="@Model.InvoiceId"
                   asp-route-issuerCompanyId="@(ViewBag.CompanyId ?? Model.IssuerCompanyId)"
                   class="cancel-button btn btn-light btn-px-4 py-3 border font-weight-semibold text-color-dark text-3">Annuleren</a>
            }
        </div>
    </div>
</form>

@section PageScripts {
    @if (isDraft)
    {
        <script src="~/lib/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
        <script>
            (function ($) {
                $('.js-datepicker').datepicker({
                    format: 'dd/mm/yyyy',
                    autoclose: true,
                    todayHighlight: true,
                    orientation: 'bottom'
                });
            })(jQuery);
        </script>
    }
}