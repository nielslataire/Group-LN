@model CPMCore.Models.Invoicing.InvoiceEditVM
@{
    ViewData["Title"] = Model.PublicId ?? $"Concept #{Model.InvoiceId}";
}
<h1 class="fw-bold mb-2">@ViewData["Title"]</h1>
<p class="text-muted">Factuur-ID: @Model.InvoiceId</p>

<div class="alert alert-info">
    Dit is een tijdelijke Edit-pagina. In stap 3 voegen we headerbewerkingen, lijnen en de “Nummeren” actie toe.
</div>

<div class="d-flex gap-2">
    <a asp-action="Create" class="btn btn-outline-secondary">Nieuwe factuur</a>
</div>
