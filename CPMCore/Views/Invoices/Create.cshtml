@model CPMCore.Models.Invoicing.InvoiceComposeVM
@using System.Linq

@{
    var hasIssuerBankAccounts = Model.IssuerBankAccounts?.Any() == true;
}

@section PageStyle {
    <link rel="stylesheet" href="~/lib/select2/css/select2.css" />
    <link rel="stylesheet" href="~/lib/select2-bootstrap-theme/select2-bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-datepicker/css/bootstrap-datepicker3.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/v/bs5/dt-2.2.2/b-3.2.2/rr-1.5.0/datatables.min.css" />
    <link rel="stylesheet" href="~/css/invoices-custom.css" />
}

<form id="invoiceForm" asp-action="Save" asp-controller="Invoices" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="invoice-compose-wrapper">

        @* ═══ LINKER PANEEL ═══ *@
        <aside class="invoice-panel-left">

            <div class="invoice-panel-header">
                <h5 class="mb-0 fw-bold">Nieuwe factuur</h5>
                <p class="text-muted mb-0 small">Vul de stappen in om een factuur op te maken</p>
            </div>

            <div class="invoice-step-indicator">
                <div class="d-flex align-items-center">
                    <div class="invoice-step-dot active" data-step="1" title="Partijen"><span>1</span></div>
                    <div class="invoice-step-line"></div>
                    <div class="invoice-step-dot" data-step="2" title="Instellingen"><span>2</span></div>
                    <div class="invoice-step-line"></div>
                    <div class="invoice-step-dot" data-step="3" title="Lijnen"><span>3</span></div>
                    <div class="invoice-step-line"></div>
                    <div class="invoice-step-dot" data-step="4" title="Tekst &amp; bijlage"><span>4</span></div>
                </div>
                <div class="invoice-step-labels">
                    <span class="invoice-step-label active" data-step="1">Partijen</span>
                    <span class="invoice-step-label" data-step="2">Instellingen</span>
                    <span class="invoice-step-label" data-step="3">Lijnen</span>
                    <span class="invoice-step-label" data-step="4">Tekst</span>
                </div>
            </div>

            <div class="invoice-panel-body">

                @* ─── STAP 1: Partijen ─── *@
                <div id="step-1" class="invoice-step-panel">

                    <div class="d-flex gap-4 mb-4">
                        <div class="d-flex align-items-center gap-2">
                            <div class="switch switch-sm switch-primary">
                                @Html.CheckBoxFor(m => m.IsCreditNote, new { data_plugin_ios_switch = "" })
                            </div>
                            <label class="mb-0 small" asp-for="IsCreditNote">Creditfactuur</label>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="switch switch-sm switch-primary">
                                @Html.CheckBoxFor(m => m.IsPrepaid, new { data_plugin_ios_switch = "" })
                            </div>
                            <label class="mb-0 small" asp-for="IsPrepaid">Al betaald</label>
                        </div>
                    </div>

                    <div class="invoice-section-label">Van</div>

                    <div class="mb-3">
                        <label class="form-label">Facturatiebedrijf</label>
                        <select asp-for="IssuerCompanyId" id="IssuerCompanyId" name="IssuerCompanyId" class="form-control gl-form-control-modern">
                            @foreach (var i in Model.Issuers)
                            {
                                if (i.Id == Model.IssuerCompanyId)
                                {
                                    <option value="@i.Id" data-defaultterm="@(i.DefaultPaymentTermId?.ToString() ?? "")" data-defaultvattype="@(i.DefaultVatTypeId?.ToString() ?? "")" selected="selected">@i.Name</option>
                                }
                                else
                                {
                                    <option value="@i.Id" data-defaultterm="@(i.DefaultPaymentTermId?.ToString() ?? "")" data-defaultvattype="@(i.DefaultVatTypeId?.ToString() ?? "")">@i.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Rekeningnummer</label>
                        <select asp-for="IssuerBankAccountId"
                                id="IssuerBankAccountId"
                                class="form-control gl-form-control-modern"
                                asp-items="Model.IssuerBankAccounts"
                                disabled="@(!hasIssuerBankAccounts)">
                            <option value="">-- Kies een rekening --</option>
                        </select>
                        <span asp-validation-for="IssuerBankAccountId" class="text-danger"></span>
                    </div>

                    <div class="invoice-section-label">Aan</div>

                    <div class="mb-3">
                        <label class="form-label">Klant / Leverancier</label>
                        <div class="d-flex gap-2 align-items-center">
                            <div class="flex-grow-1 min-w-0">
                                <select id="partySelect" class="form-control gl-form-control-modern w-100"></select>
                            </div>
                            <button type="button" id="btn-quick-create-client" class="btn btn-default btn-sm flex-shrink-0 btn-quick-create-client" title="Nieuwe klant toevoegen">
                                <i class="bx bx-plus fs-5"></i>
                            </button>
                        </div>
                    </div>

                    <div id="projectRow" class="mb-3" style="display:none">
                        <label class="form-label">Project (optioneel)</label>
                        <select id="projectSelect" class="form-control gl-form-control-modern w-100"></select>
                        <input type="hidden" asp-for="ProjectId" />
                    </div>

                    <div id="contractRow" class="mb-3" style="display:none">
                        <label class="form-label">Leverancierscontract (optioneel)</label>
                        <select id="contractSelect" class="form-control gl-form-control-modern w-100"></select>
                        <input type="hidden" asp-for="SupplierContractId" />
                    </div>

                </div>

                @* ─── STAP 2: Instellingen ─── *@
                <div id="step-2" class="invoice-step-panel d-none">

                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label">Factuurdatum</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                <input asp-for="InvoiceDate"
                                       class="form-control gl-form-control-modern js-datepicker"
                                       type="text"
                                       asp-format="{0:dd/MM/yyyy}" />
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Betaaltermijn</label>
                            <select asp-for="PaymentTermId" id="PaymentTermId" name="PaymentTermId" class="form-control gl-form-control-modern">
                                @foreach (var t in Model.PaymentTerms)
                                {
                                    if (Model.PaymentTermId == t.Id)
                                    {
                                        <option value="@t.Id" data-days="@t.Days" data-name="@t.Name" data-type="@((int)t.TermType)" data-display-mode="@((int)t.DisplayMode)" data-display-text="@t.DisplayText" selected="selected">@t.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@t.Id" data-days="@t.Days" data-name="@t.Name" data-type="@((int)t.TermType)" data-display-mode="@((int)t.DisplayMode)" data-display-text="@t.DisplayText">@t.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Start als</label>
                            <select asp-for="StartAs" class="form-control gl-form-control-modern">
                                <option value="0">Draft (later afwerken)</option>
                                <option value="1">Factuur (meteen uitgeven)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Factuurmodus</label>
                            <select asp-for="Mode" class="form-control gl-form-control-modern">
                                <option value="1">Vrije lijnen</option>
                                <option value="2">Schijven</option>
                                <option value="3">Wijzigingsopdrachten</option>
                                <option value="4">Nutsaansluitingen</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">BTW-tarief (standaard)</label>
                            <select asp-for="VatTypeId" id="VatTypeId" name="VatTypeId" class="form-control gl-form-control-modern">
                                @foreach (var v in Model.VatTypes)
                                {
                                    if (Model.VatTypeId == v.Id)
                                    {
                                        <option value="@v.Id" data-pct="@v.BasePercentage" data-code="@v.Code" selected="selected">@v.Code - @v.Description (@v.BasePercentage%)</option>
                                    }
                                    else
                                    {
                                        <option value="@v.Id" data-pct="@v.BasePercentage" data-code="@v.Code">@v.Code - @v.Description (@v.BasePercentage%)</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                </div>

                @* ─── STAP 3: Lijnen ─── *@
                <div id="step-3" class="invoice-step-panel d-none">

                    <section id="stagesBlock" style="display:none">
                        <div id="stagesList">
                            <div class="text-muted small">Kies eerst een klant en zet "Factuurmodus" op "Schijven".</div>
                        </div>
                    </section>

                    <section id="coBlock" style="display:none">
                        <div id="coList">
                            <div class="text-muted small">Kies eerst een klant en zet "Factuurmodus" op "Wijzigingsopdrachten".</div>
                        </div>
                    </section>

                    <section id="utlBlock" style="display:none">
                        <div id="utlList">
                            <div class="text-muted small">Kies eerst een klant en zet "Factuurmodus" op "Nutsaansluitingen".</div>
                        </div>
                    </section>

                    @await Html.PartialAsync("Partials/_FreeLinesTable", Model)

                </div>

                @* ─── STAP 4: Tekst & bijlage ─── *@
                <div id="step-4" class="invoice-step-panel d-none">

                    <div class="mb-3">
                        <label class="form-label">Omschrijving <span class="text-muted">(optioneel)</span></label>
                        <textarea asp-for="HeaderDescription" class="form-control gl-desc-textarea" rows="4"></textarea>
                        <span asp-validation-for="HeaderDescription" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Detailomschrijving</label>
                        <textarea asp-for="DetailDescription" class="form-control gl-desc-textarea" rows="4"></textarea>
                        <span asp-validation-for="DetailDescription" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Footer</label>
                        <textarea asp-for="FooterDescription" class="form-control gl-desc-textarea" rows="3"></textarea>
                        <span asp-validation-for="FooterDescription" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="PdfAppendix">PDF bijlage</label>
                        <input asp-for="PdfAppendix" type="file" class="form-control" accept="application/pdf,.pdf" />
                        <small class="text-muted">Deze PDF wordt als extra pagina('s) achter de factuur toegevoegd.</small>
                        <span asp-validation-for="PdfAppendix" class="text-danger"></span>
                    </div>

                </div>

            </div>@* /invoice-panel-body *@

            <div class="invoice-panel-footer">
                <a href="@Url.Action("Index", "Invoices", new { issuerCompanyId = Model.IssuerCompanyId })"
                   class="btn btn-light border text-muted invoice-cancel-link">
                    Annuleren
                </a>
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="btn btn-default" id="stepPrev" disabled>
                        <i class="bx bx-left-arrow-alt me-1"></i>Vorige
                    </button>
                    <span class="text-muted small text-nowrap">Stap <strong id="stepCurrent">1</strong> van 4</span>
                    <button type="button" class="btn btn-primary stepNext" id="stepNext">
                        Volgende<i class="bx bx-right-arrow-alt ms-1"></i>
                    </button>
                </div>
            </div>

        </aside>

        @* ═══ VERSLEEPBARE DIVIDER ═══ *@
        <div class="invoice-panel-divider" id="panelDivider">
            <div class="invoice-panel-divider-handle">
                <i class="bx bx-chevron-left"></i>
                <div class="invoice-divider-bars">
                    <span></span>
                    <span></span>
                </div>
                <i class="bx bx-chevron-right"></i>
            </div>
        </div>

        @* ═══ RECHTER PANEEL – Live preview ═══ *@
        <main class="invoice-panel-right" id="invoicePreviewPanel">

            <div id="previewCard" class="invoice-preview-sheet">

                @* Titel *@
                <div class="mb-4">
                    <h4 class="mb-0 fw-bold" id="pvStartAs">Proforma factuur</h4>
                </div>

                @* Partijen: facturatiebedrijf links, klant/leverancier rechts *@
                <div class="row mb-3">
                    <div class="col-6">
                        <div class="fw-semibold" id="pvIssuerName">—</div>
                        <div class="small" id="pvIssuerAddr"></div>
                        <div class="small text-muted" id="pvIssuerEnterprise"></div>
                    </div>
                    <div class="col-6 text-end">
                        <div class="fw-semibold" id="pvPartyName"></div>
                        <div class="small" id="pvPartyAddr"></div>
                        <div class="small text-muted" id="pvPartyVat"></div>
                    </div>
                </div>

                @* Datums *@
                <div class="d-flex gap-4 mb-4 pb-3 border-bottom small">
                    <div><span class="text-muted">Factuurdatum:</span> <strong id="pvIssueDate">—</strong></div>
                    <div><span class="text-muted">Vervaldatum:</span> <strong id="pvDueDate">—</strong></div>
                </div>

                @* Omschrijving + detailomschrijving *@
                <p id="pvHeaderText" class="gl-ws-prewrap mb-2"></p>
                <p id="pvDetailText" class="gl-ws-prewrap small text-muted mb-3"></p>

                @* Lijnen *@
                <div id="pvTables" class="gl-preview-tables"></div>

                @* Totalen *@
                <table class="table mb-0 table-borderless gl-min-w-400">
                    <tbody>
                        <tr>
                            <td class="text-end fw-semibold">Subtotaal</td>
                            <td class="text-end fw-semibold gl-col-160" id="pvSub">0,00</td>
                        </tr>
                        <tr>
                            <td class="text-end fw-semibold">BTW</td>
                            <td class="text-end fw-semibold" id="pvVat">0,00</td>
                        </tr>
                        <tr class="border-top">
                            <td class="text-end fw-bold pt-2">Te betalen</td>
                            <td class="text-end fw-bold pt-2" id="pvTotal">0,00</td>
                        </tr>
                    </tbody>
                </table>

                @* Footer + betaalvoorwaarden *@
                <div class="mt-4 pt-3 border-top">
                    <p id="pvFooterText" class="gl-ws-prewrap small text-muted mb-1"></p>
                    <p id="pvPayTermText" class="small text-muted mb-0"></p>
                </div>

            </div>

            <div id="pvEmpty" class="invoice-preview-empty">
                <i class="bx bx-file-blank"></i>
                <p class="mb-0">Vul het formulier in om de preview te zien.</p>
            </div>

        </main>

    </div>@* /invoice-compose-wrapper *@

    @* Hidden velden & submit *@
    <input type="hidden" asp-for="PartyId" />
    <input type="hidden" asp-for="PartyType" />
    <button type="submit" id="saveInvoiceBtn" class="d-none" disabled></button>
    <div id="quick-create-client-container"></div>

</form>

@section PageScripts {
    @if (ViewBag.DuplicateInvoiceJson != null)
    {
        <script>
            window.InvoiceIsEditing = true;
            window.InitialInvoice = @Html.Raw(ViewBag.DuplicateInvoiceJson);
        </script>
    }
    <script src="~/lib/select2/js/select2.js"></script>
    <script src="/lib/select2/js/i18n/nl.js"></script>
    <script src="~/lib/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src="https://cdn.datatables.net/v/bs5/dt-2.2.2/b-3.2.2/rr-1.5.0/datatables.min.js"></script>
    <script src="~/lib/ios7-switch/ios7-switch.js"></script>
    <script>
        window.InvoicesEndpoints = {
            partyLookup:               '@Url.Action("PartyLookup",               "Invoices")',
            projectLookup:             '@Url.Action("ProjectLookup",             "Invoices")',
            supplierContractLookup:    '@Url.Action("SupplierContractLookup",    "Invoices")',
            composeStageLines:         '@Url.Action("ComposeStageLines",         "Invoices")',
            composeChangeOrderLines:   '@Url.Action("ComposeChangeOrderLines",   "Invoices")',
            composeUtilityLines:       '@Url.Action("ComposeUtilityLines",       "Invoices")',
            issuerDefaults:            '@Url.Action("IssuerDefaults",            "Invoices")',
            issuerBankAccounts:        '@Url.Action("IssuerBankAccounts",        "Invoices")',
            issuerAddress:             '@Url.Action("IssuerAddress",             "Invoices")',
            partyDetails:              '@Url.Action("PartyDetails",              "Invoices")'
        };
    </script>

    <script src="~/js/invoices.util.js"></script>
    <script src="~/js/invoices.freelines.js"></script>
    <script src="~/js/invoices.co.js"></script>
    <script src="~/js/invoices.preview.js"></script>
    <script src="~/js/invoices.edit-draft.js"></script>
    <script src="~/js/invoices.core.js"></script>

    <script>
    (function () {
        // ── Quick create client ───────────────────────────────────────
        const quickCreateModalUrl = '@Url.Action("QuickCreateModal", "Klanten")';
        const issuerCompanyId = '@Model.IssuerCompanyId';

        window.onQuickCreateClientSuccess = function (data) {
            const option = new Option(data.display, data.id, true, true);
            $('#partySelect').append(option).trigger('change');
            $('#partySelect').trigger({
                type: 'select2:select',
                params: { data: { id: data.id, display: data.display, text: data.display, name: data.display, type: data.type } }
            });
        };

        document.getElementById('btn-quick-create-client')?.addEventListener('click', function () {
            $.get(quickCreateModalUrl + '?issuerCompanyId=' + encodeURIComponent(issuerCompanyId))
                .done(function (html) {
                    $('#quick-create-client-container').html(html);
                    const modalEl = document.getElementById('quickCreateClientModal');
                    if (modalEl) bootstrap.Modal.getOrCreateInstance(modalEl).show();
                });
        });

        // ── Preview: override toggle-gedrag voor split layout ────────
        const _origRebuild = window.rebuildInvoicePreview;
        window.rebuildInvoicePreview = function () {
            _origRebuild && _origRebuild();
            // In split layout: previewCard is altijd zichtbaar
            const $card = $('#previewCard');
            $card.show().removeClass('d-none');
            const hasContent = $('#pvTables').children().length > 0;
            $('#pvEmpty').toggle(!hasContent);
        };
        // Eerste keer uitvoeren
        window.rebuildInvoicePreview();

        // ── Stap-navigatie ────────────────────────────────────────────
        const TOTAL_STEPS = 4;
        let currentStep = 1;

        function showStep(n) {
            currentStep = Math.max(1, Math.min(TOTAL_STEPS, n));

            // Panelen tonen/verbergen
            for (let i = 1; i <= TOTAL_STEPS; i++) {
                const el = document.getElementById('step-' + i);
                if (el) el.classList.toggle('d-none', i !== currentStep);
            }

            // Step dots & labels
            document.querySelectorAll('.invoice-step-dot').forEach(function (dot) {
                const s = parseInt(dot.dataset.step, 10);
                const isCompleted = s < currentStep;
                dot.classList.toggle('active', s === currentStep);
                dot.classList.toggle('completed', isCompleted);
                const span = dot.querySelector('span');
                if (span) {
                    span.innerHTML = isCompleted ? '<i class="bx bx-check mt-2"></i>' : s;
                }
            });
            document.querySelectorAll('.invoice-step-label').forEach(function (lbl) {
                lbl.classList.toggle('active', parseInt(lbl.dataset.step, 10) === currentStep);
            });

            // Stapteller
            document.getElementById('stepCurrent').textContent = currentStep;

            // Vorige-knop
            document.getElementById('stepPrev').disabled = (currentStep === 1);

            // Volgende/Opslaan-knop
            const nextBtn = document.getElementById('stepNext');
            if (currentStep === TOTAL_STEPS) {
                nextBtn.innerHTML = '<i class="bx bx-save me-1"></i>Opslaan';
            } else {
                nextBtn.innerHTML = 'Volgende<i class="bx bx-right-arrow-alt ms-1"></i>';
            }

            // Body scrollt terug naar boven
            const body = document.querySelector('.invoice-panel-body');
            if (body) body.scrollTop = 0;
        }

        document.getElementById('stepPrev')?.addEventListener('click', function () {
            showStep(currentStep - 1);
        });

        document.getElementById('stepNext')?.addEventListener('click', function () {
            if (currentStep === TOTAL_STEPS) {
                const saveBtn = document.getElementById('saveInvoiceBtn');
                if (saveBtn && !saveBtn.disabled) {
                    saveBtn.click();
                } else {
                    // Geef visuele feedback dat er nog iets ontbreekt
                    saveBtn?.closest('form')?.reportValidity();
                }
            } else {
                showStep(currentStep + 1);
            }
        });

        // Klik op step-dot voor vrije navigatie
        document.querySelectorAll('.invoice-step-dot').forEach(function (dot) {
            dot.addEventListener('click', function () {
                showStep(parseInt(this.dataset.step, 10));
            });
        });

        // ── Mobile preview toggle ─────────────────────────────────────
        const previewPanel = document.getElementById('invoicePreviewPanel');
        document.getElementById('btnTogglePreview')?.addEventListener('click', function () {
            const hidden = previewPanel.classList.toggle('preview-hidden');
            this.innerHTML = hidden
                ? '<i class="bx bx-show me-1"></i> Toon voorbeeld'
                : '<i class="bx bx-hide me-1"></i> Verberg';
        });

        showStep(1);

        // Directe binding voor ios7-switch checkboxes (change-event kan in sommige Porto-versies niet bubbbelen)
        $('#IsCreditNote, #IsPrepaid').on('change', function () {
            if (window.rebuildInvoicePreview) window.rebuildInvoicePreview();
        });

        // ── Versleepbare paneel-divider met cookie-persistentie ───────
        (function () {
            const COOKIE_KEY = 'invoice_panel_left_width';
            const MIN_LEFT   = 280;
            const MIN_RIGHT  = 300;
            const DIVIDER_W  = 6;

            function getCookie(name) {
                const m = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/([.*+?^${}()|[\]\\])/g, '\\$1') + '=([^;]*)'));
                return m ? decodeURIComponent(m[1]) : null;
            }

            function setCookie(name, value, days) {
                const exp = new Date(Date.now() + days * 864e5).toUTCString();
                document.cookie = name + '=' + encodeURIComponent(value) + '; expires=' + exp + '; path=/; SameSite=Lax';
            }

            const wrapper   = document.querySelector('.invoice-compose-wrapper');
            const leftPanel = document.querySelector('.invoice-panel-left');
            const divider   = document.getElementById('panelDivider');

            if (!wrapper || !leftPanel || !divider) return;

            // Herstel breedte uit cookie
            const saved = parseInt(getCookie(COOKIE_KEY), 10);
            if (saved >= MIN_LEFT) {
                leftPanel.style.width = saved + 'px';
            }

            let dragging  = false;
            let startX    = 0;
            let startW    = 0;

            divider.addEventListener('mousedown', function (e) {
                e.preventDefault();
                dragging = true;
                startX   = e.clientX;
                startW   = leftPanel.offsetWidth;
                divider.classList.add('dragging');
                document.body.style.cursor     = 'col-resize';
                document.body.style.userSelect = 'none';
            });

            document.addEventListener('mousemove', function (e) {
                if (!dragging) return;
                const maxW  = wrapper.offsetWidth - MIN_RIGHT - DIVIDER_W;
                const newW  = Math.max(MIN_LEFT, Math.min(startW + (e.clientX - startX), maxW));
                leftPanel.style.width = newW + 'px';
            });

            document.addEventListener('mouseup', function () {
                if (!dragging) return;
                dragging = false;
                divider.classList.remove('dragging');
                document.body.style.cursor     = '';
                document.body.style.userSelect = '';
                setCookie(COOKIE_KEY, leftPanel.offsetWidth, 365);
            });
        })();
    })();
    </script>
}
