@* Octopus: bestaande relaties die lijken op een opgehaalde relatie — bevestigen of koppelen *@
@if (suggestions.Any())
{
    <div class="modal fade gl-v2-modal-form gl-v2-ice-modal gl-v2-ice-modal-wide" id="ice-relations-modal" tabindex="-1" aria-hidden="true" aria-labelledby="ice-relations-title" data-show-on-load="1">
        <div class="modal-dialog modal-dialog-centered modal-fullscreen-md-down">
            <div class="modal-content">
                <div class="modal-header"><div class="gl-v2-ice-modal-headtext"><h2 class="modal-title" id="ice-relations-title">Mogelijke bestaande relaties</h2><span>We vonden klanten of leveranciers die sterk lijken op een opgehaalde Octopus-relatie. Bevestig of we ze mogen koppelen.</span></div><button type="button" class="gl-v2-modal-close" data-bs-dismiss="modal" aria-label="Sluiten"><i class="ph ph-x" aria-hidden="true"></i></button></div>
                <div class="modal-body">
                    @foreach (var suggestion in suggestions)
                    {
                        <div class="gl-v2-ice-sugg">
                            <div class="gl-v2-ice-sugg-head"><b>@suggestion.RelationName</b><span class="gl-v2-badge is-neutral">@suggestion.RelationType.ToUpperInvariant()</span>@if (!string.IsNullOrWhiteSpace(suggestion.VatNumber)) { <small>btw @suggestion.VatNumber</small> }</div>
                            @foreach (var candidate in suggestion.Candidates)
                            {
                                <form method="post" action="@Url.Action("IssuerCompanyConfirmRelationLink", "Instellingen", new { issuerId = Model.Id })" class="gl-v2-ice-sugg-row">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="IssuerId" value="@Model.Id" />
                                    <input type="hidden" name="IsSupplier" value="@(suggestion.RelationType == "Leverancier")" />
                                    <input type="hidden" name="CandidateId" value="@candidate.Id" />
                                    <input type="hidden" name="OctopusRelationId" value="@suggestion.OctopusRelationId" />
                                    <span class="gl-v2-ice-list-t"><b>@candidate.Name</b><small>@candidate.CandidateType@(string.IsNullOrWhiteSpace(candidate.VatNumber) ? "" : " · btw " + candidate.VatNumber)</small></span>
                                    <button type="submit" class="gl-v2-btn gl-v2-btn-primary">Koppelen</button>
                                </form>
                            }
                            <p class="gl-v2-field-help">Niet de juiste match? Voeg dan handmatig een nieuwe @suggestion.RelationType.ToLowerInvariant() toe en synchroniseer opnieuw.</p>
                        </div>
                    }
                </div>
                <div class="modal-footer"><a class="gl-v2-btn gl-v2-btn-text" href="@Url.Action("IssuerCompaniesEdit", "Instellingen", new { id = Model.Id, tab = "boekhouding" })">Sluiten</a></div>
            </div>
        </div>
    </div>
}

