@model CPMCore.Models.Instellingen.IssuerCompanyVM
@{
}
@section PageStyle
{
    <link rel="stylesheet" href="~/css/detailmenuactionbuttons.css" />
    <link rel="stylesheet" href="~/lib/summernote/summernote-bs5.css" />
    <link rel="stylesheet" href="~/css/instellingen-custom.css" />
}
<div class="gl-body-padding">


    <form asp-route="Instellingen_IssuerCompanies_Edit" method="post" class="ecommerce-form action-buttons-fixed" asp-route-id="@Model.Id" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <partial name="_IssuerCompanyForm" model="Model" />
    <div class="row action-buttons">
        <div class="col-12 col-md-auto">
            <button type="submit" class="submit-button btn btn-primary btn-px-4 py-3 d-flex align-items-center font-weight-semibold line-height-1" data-loading-text="Laden...">
                <i class="bx bx-save text-4 me-2"></i> Bedrijf opslaan
            </button>
        </div>
        <div class="col-12 col-md-auto px-md-0 mt-3 mt-md-0">
            <a href="@TempData.Peek("Referrer")" class="cancel-button btn btn-light btn-px-4 py-3 border font-weight-semibold text-color-dark text-3">Annuleren</a>
        </div>

    </div>
</form>
</div>
@section PageScripts {
    <script src="~/lib/ios7-switch/ios7-switch.js"></script>
    <script src="~/lib/summernote/summernote-bs5.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <partial name="Partials/_IssuerLayoutScripts" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
           initIosSwitches();
           initBankAccountActions();
        });
        $(document).ready(function() {
          $('#summernote').summernote();
        });

        function initIosSwitches() {
               var $els = $('[data-plugin-ios-switch]');
               $els.each(function () {
                   var $el = $(this);
                   if (!$el.data('plugin-ios7Switch')) {
                       $el.themePluginIOS7Switch(); // Porto init
                   }
               });
           }

           function initBankAccountActions() {
               var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
               var tokenValue = tokenInput ? tokenInput.value : null;

               function postWithToken(url) {
                   if (!url) {
                       return;
                   }

                   var form = document.createElement('form');
                   form.method = 'post';
                   form.action = url;
                   form.style.display = 'none';

                   if (tokenValue) {
                       var tokenField = document.createElement('input');
                       tokenField.type = 'hidden';
                       tokenField.name = '__RequestVerificationToken';
                       tokenField.value = tokenValue;
                       form.appendChild(tokenField);
                   }

                   document.body.appendChild(form);
                   form.submit();
               }

               document.querySelectorAll('.js-bank-account-action').forEach(function (button) {
                   button.addEventListener('click', function (event) {
                       if (button.disabled) {
                           return;
                       }

                       var confirmMessage = button.getAttribute('data-confirm');
                       if (confirmMessage && !window.confirm(confirmMessage)) {
                           return;
                       }

                       var url = button.getAttribute('data-url');
                       postWithToken(url);
                   });
               });
           }
    </script>
}
