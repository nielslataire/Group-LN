@model CPMCore.Models.Instellingen.HomeHeroProjectVM
@{
}
@section PageStyle
{
    <link rel="stylesheet" href="~/css/instellingen-custom.css" />
}
<div class="gl-body-padding">

    <div class="row">
        <div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
            <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
                <div class="row align-items-center">
                    <div class="col-sm-auto d-flex align-items-center">
                        <a href="@Url.Action("Index", "Instellingen")" class="text-decoration-none text-reset d-flex align-items-center">
                            <i class="bx bx-chevron-left fs-1"></i>
                        </a>
                    </div>
                    <div class="col-sm-auto">
                        <h1 class="fw-bold mb-0">Home hero — uitgelicht project</h1>
                        <h5 class="mb-4 mt-0">Kies het project en de tekst voor de uitgelichte sectie op de home-hero van de publieke website</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <form method="post" asp-action="Index" asp-controller="HomeHeroProject" class="ecommerce-form action-buttons-fixed">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row mt-2">
            <div class="col">
                <section class="card card-modern card-big-info">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-2-5 col-xl-1-5">
                                <i class="card-big-info-icon bx bx-monitor-wallpaper"></i>
                                <h2 class="card-big-info-title">Uitgelicht project</h2>
                                <p class="card-big-info-desc">Enkel projecten die "Verkoop zichtbaar" staan, zijn hier te kiezen.</p>
                            </div>
                            <div class="col-lg-3-5 col-xl-4-5">
                                <div class="form-group">
                                    <div class="row align-items-center pb-3">
                                        <label asp-for="ProjectId" class="col-md-3 control-label text-lg-end mb-0"></label>
                                        <div class="col-md-9">
                                            <select asp-for="ProjectId" asp-items="Model.ProjectOpties" id="projectSelect" class="form-select form-control-modern">
                                                <option value="">-- Kies een project --</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row align-items-center pb-3">
                                        <div class="col-md-9 offset-md-3">
                                            <button type="button" id="btnVulOver" class="btn btn-light border">
                                                <i class="bx bx-download"></i> Vul over uit project
                                            </button>
                                        </div>
                                    </div>
                                    <div class="row align-items-center pb-3">
                                        <label asp-for="Kicker" class="col-md-3 control-label text-lg-end mb-0"></label>
                                        <div class="col-md-9">
                                            <input asp-for="Kicker" id="kickerInput" class="form-control form-control-modern" placeholder="Bv. Koksijde · Nu in verkoop" />
                                        </div>
                                    </div>
                                    <div class="row align-items-center pb-3">
                                        <label asp-for="Titel" class="col-md-3 control-label text-lg-end mb-0"></label>
                                        <div class="col-md-9">
                                            <input asp-for="Titel" id="titelInput" class="form-control form-control-modern" />
                                        </div>
                                    </div>
                                    <div class="row align-items-center pb-3">
                                        <label asp-for="Tekst" class="col-md-3 control-label text-lg-end mb-0"></label>
                                        <div class="col-md-9">
                                            <textarea asp-for="Tekst" id="tekstInput" rows="4" class="form-control form-control-modern"></textarea>
                                        </div>
                                    </div>
                                    <div class="row align-items-center pb-3">
                                        <label asp-for="ProjectTitelOverride" class="col-md-3 control-label text-lg-end mb-0"></label>
                                        <div class="col-md-9">
                                            <input asp-for="ProjectTitelOverride" id="projectTitelInput" class="form-control form-control-modern" placeholder="Weergavenaam voor de knop, bv. Villa Cauxyde" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <div class="row action-buttons">
            <div class="col-12 col-md-auto">
                <button type="submit" class="submit-button btn btn-primary btn-px-4 py-3 d-flex align-items-center font-weight-semibold line-height-1" data-loading-text="Laden...">
                    <i class="bx bx-save text-4 me-2"></i> Bewaren
                </button>
            </div>
            <div class="col-12 col-md-auto px-md-0 mt-3 mt-md-0">
                <a href="@Url.Action("Index", "Instellingen")" class="cancel-button btn btn-light btn-px-4 py-3 border font-weight-semibold text-color-dark text-3">Annuleren</a>
            </div>
        </div>
    </form>

</div>
@section PageScripts
{
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var btn = document.getElementById('btnVulOver');
            var select = document.getElementById('projectSelect');

            btn.addEventListener('click', function () {
                var projectId = select.value;
                if (!projectId) {
                    alert('Kies eerst een project.');
                    return;
                }

                var kicker = document.getElementById('kickerInput');
                var titel = document.getElementById('titelInput');
                var tekst = document.getElementById('tekstInput');
                var projectTitel = document.getElementById('projectTitelInput');

                var heeftAlTekst = titel.value || tekst.value || projectTitel.value;
                if (heeftAlTekst && !confirm('Titel/tekst/projecttitel overschrijven met de tekst van dit project?')) {
                    return;
                }

                fetch('@Url.Action("ProjectTekst", "HomeHeroProject")?projectId=' + encodeURIComponent(projectId))
                    .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
                    .then(function (data) {
                        titel.value = data.titel || '';
                        tekst.value = data.tekst || '';
                        projectTitel.value = data.projectTitel || '';
                    })
                    .catch(function () {
                        alert('Kon de tekst van dit project niet ophalen.');
                    });
            });
        });
    </script>
}
