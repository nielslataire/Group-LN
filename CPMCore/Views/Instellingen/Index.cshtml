@using BOCore
@using FacadeCore
@inject IPermissionService PermissionService
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    await PermissionService.EnsureLoadedAsync();
    var canBillingCompanies    = PermissionService.HasRead(PermissionCodes.SettingsBillingCompanies);
    var canInvoiceTemplates    = PermissionService.HasRead(PermissionCodes.SettingsInvoiceTemplates);
    var canBouwIndexen         = PermissionService.HasRead(PermissionCodes.SettingsBouwIndexen);
    var canUsers               = PermissionService.HasRead(PermissionCodes.SettingsUsers);
    var canHolidays            = PermissionService.HasRead(PermissionCodes.SettingsHolidays);
    var canActivities          = PermissionService.HasRead(PermissionCodes.SettingsActivities);
    var canKostprijs           = PermissionService.HasRead(PermissionCodes.SettingsKostprijsMaterialen);
    var canBlog                = PermissionService.HasRead(PermissionCodes.SettingsBlogBeheer);
    var canEmailTemplates      = PermissionService.HasRead(PermissionCodes.SettingsEmailTemplates);
    var canHomeHeroProject     = PermissionService.HasRead(PermissionCodes.SettingsHomeHeroProject);
    var canIssueNotifications  = PermissionService.HasRead(PermissionCodes.SettingsIssueNotifications);
    var canMarketDataStatus    = PermissionService.HasRead(PermissionCodes.SettingsMarketDataStatus);

    var countFacturatie    = (canBillingCompanies ? 1 : 0) + (canInvoiceTemplates ? 1 : 0) + (canBouwIndexen ? 1 : 0);
    var countTeam          = (canUsers ? 1 : 0) + (canHolidays ? 1 : 0);
    var countCalculatie    = (canActivities ? 1 : 0) + (canKostprijs ? 1 : 0);
    var countWebsite       = (canBlog ? 1 : 0) + (canEmailTemplates ? 1 : 0) + (canHomeHeroProject ? 1 : 0);
    var countAutomatisatie = (canIssueNotifications ? 1 : 0) + (canMarketDataStatus ? 1 : 0);
}

@section PageStyle {
<style>
    .settings-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 2rem;
    }
    .settings-page-header h1 {
        font-size: 1.6rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }
    .settings-page-header p {
        color: #6c757d;
        margin-bottom: 0;
    }
    .settings-search-wrap {
        position: relative;
        min-width: 240px;
    }
    .settings-search-wrap .bx {
        position: absolute;
        left: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        color: #adb5bd;
        font-size: 1.1rem;
        pointer-events: none;
    }
    #settings-search {
        padding-left: 2.25rem;
        border-radius: 8px;
        border: 1px solid #dee2e6;
        height: 38px;
        font-size: 0.875rem;
        width: 100%;
        outline: none;
    }
    #settings-search:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(var(--primary-rgb, 40,167,69), 0.12);
    }

    /* Section header */
    .settings-section { margin-bottom: 2.5rem; }
    .settings-section-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.85rem;
    }
    .settings-section-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }
    .dot-green  { background-color: var(--primary); }
    .dot-blue   { background-color: #2979ff; }
    .dot-orange { background-color: #ff9800; }
    .dot-purple { background-color: #9c27b0; }
    .settings-section-label {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #495057;
        text-transform: uppercase;
    }
    .settings-section-count {
        font-size: 0.72rem;
        color: #adb5bd;
    }

    /* Card */
    .card.settings-card {
        transition: background-color 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
        cursor: default;
    }
    .card.settings-card:hover {
        outline: 1px solid var(--primary) !important;
        outline-offset: -1px !important;
        background-color: #f0faf4 !important;
        box-shadow: inset 4px 0 0 var(--primary) !important;
        filter: drop-shadow(0 4px 4px rgba(0,0,0,0.18)) !important;
    }
    .card.settings-card .card-body {
        padding: 1.25rem;
    }

    /* Icon */
    .settings-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background-color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #fff;
        font-size: 1.35rem;
    }
    .settings-card-title {
        font-size: 0.975rem;
        font-weight: 700;
        color: #212529;
        margin: 0;
        line-height: 1.3;
    }
    .settings-card-desc {
        font-size: 0.82rem;
        color: #6c757d;
        line-height: 1.5;
        margin-bottom: 0;
    }

    /* Footer row */
    .settings-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 1rem;
    }
    .settings-card-footer .btn-primary {
        font-size: 0.8rem;
        padding: 0.3rem 0.85rem;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }
    .settings-card-footer .btn-outline-primary {
        font-size: 0.8rem;
        padding: 0.3rem 0.8rem;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }
    .settings-arrow {
        color: #adb5bd;
        font-size: 1.3rem;
        line-height: 1;
        transition: color 0.15s;
        text-decoration: none;
    }
    .settings-card:hover .settings-arrow { color: var(--primary); }

    /* Hidden by search */
    .settings-card-wrap.hidden { display: none !important; }
    .settings-section.section-empty .settings-section-header { display: none; }
</style>
}

<div class="settings-page-header">
    <div>
        <h1>Beheer &amp; instellingen</h1>
        <p>Kies een onderdeel om je administratie te beheren.</p>
    </div>
    <div class="settings-search-wrap mt-1">
        <i class="bx bx-search"></i>
        <input type="search" id="settings-search" placeholder="Zoek een instelling..." autocomplete="off" />
    </div>
</div>

@* ── FACTURATIE & BOEKHOUDING ── *@
