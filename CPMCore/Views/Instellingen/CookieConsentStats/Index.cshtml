@model CPMCore.Models.Instellingen.CookieConsentStatsVM
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section PageStyle {
    <style>
        .ccs-period-title { font-weight: 700; font-size: 1.05rem; color: var(--ink, #222); margin-bottom: .25rem; }
        .ccs-period-sub { font-size: .82rem; color: var(--text-muted, #8590a5); margin-bottom: 1rem; }
        .ccs-note {
            background: var(--mist-green, #e8f0eb);
            border-radius: var(--radius, 7px);
            padding: .85rem 1rem;
            font-size: .85rem;
            color: var(--ink, #222);
            margin-bottom: 1.75rem;
        }
    </style>
}

<div class="ccs-note">
    <i class="bx bx-info-circle me-1"></i>
    Deze telling loopt los van Google Analytics: die laadt pas ná toestemming en kan dus nooit
    meten wie weigert of geen keuze maakt. Hier telt de weergave van de banner, een klik op
    "Alles aanvaarden", een klik op "Alles weigeren" en het verlaten van de site zonder keuze
    apart mee — anoniem, zonder IP of bezoekers-id. Per browser telt de banner één keer als
    getoond, ook als de bezoeker pas bij een later bezoek kiest; wie al gekozen heeft, krijgt de
    banner niet meer en telt dus niet mee. Bots en crawlers worden op user-agent overgeslagen.
    "Verlaten" wordt sinds eind september 2026 gemeten (migratie 059); oudere periodes tonen
    daar 0. Wie eerst verlaat en later toch kiest, telt in beide kolommen, dus de som kan
    afwijken van "Getoond".
</div>

<section class="card mb-4">
    <div class="card-body">
        @await Html.PartialAsync("_Period", Model.Last30Days)
    </div>
</section>

<section class="card">
    <div class="card-body">
        @await Html.PartialAsync("_Period", Model.AllTime)
    </div>
</section>
