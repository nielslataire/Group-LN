<div class="row mt-4">
    <div class="col">
        <section class="card card-modern card-big-info mt-4">
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-2-5 col-xl-1-5">
                        <i class="card-big-info-icon bx bx-file"></i>
                        <h2 class="card-big-info-title">Factuurlay-out</h2>
                        <p class="card-big-info-desc">Beheer de JSON-gestuurde QuestPDF lay-out per bedrijf.</p>
                    </div>
                    <div class="col-lg-3-5 col-xl-4-5">

                    <div class="form-group">
                            <h5 class="fw-semibold text-muted letter-spacing-md mt-3" style="">KLEUREN</h5>
                            <div class="row align-items-center pb-3">
                                <label asp-for="BrandPrimaryColor" class="col-md-2 control-label text-lg-end mb-0"></label>
                                <div class="col-md-9">
                                <input type="color"
                                       id="BrandPrimaryColor"
                                       name="BrandPrimaryColor"
                                       class="border-0 mt-1 js-brand-primary" pattern="^#+([a-fA-F0-9]{6}|[a-fA-F0-9]{3})$"
                                       value="@(string.IsNullOrWhiteSpace(Model?.BrandPrimaryColor) ? "#01532d" : Model.BrandPrimaryColor)" />
                                </div>
                            </div>
                            <div class="row align-items-center pb-3">
                                <label asp-for="BrandSecondaryColor" class="col-md-2 control-label text-lg-end mb-0"></label>
                                <div class="col-md-9">
                                    <input type="color"
                                           id="BrandSecondaryColor"
                                           name="BrandSecondaryColor"
                                           class="border-0 mt-1 js-brand-secondary" pattern="^#+([a-fA-F0-9]{6}|[a-fA-F0-9]{3})$"
                                           value="@(string.IsNullOrWhiteSpace(Model?.BrandSecondaryColor) ? "#6b7280" : Model.BrandSecondaryColor)" />
                                </div>
                            </div>
                    </div>
                        <div class="form-group">
                            <h5 class="fw-semibold text-muted letter-spacing-md mt-3" style="">SJABLOON</h5>
                            <div class="row align-items-center pb-3">
                                <label asp-for="TemplateKey" class="col-md-2 control-label text-lg-end mb-0"></label>
                                <div class="col-md-9">
                                    <select asp-for="TemplateKey" class="form-control js-template-key">
                                        @foreach (var template in Model.InvoiceTemplates)
                                        {
                                            <option value="@template.Key">@template.Name</option>
                                        }
                                    </select>
                                    <small class="text-muted d-block mt-1">
                                        Beheer templates in <a href="@Url.Action("InvoiceTemplates", "Instellingen")">de templatemanager</a>.
                                    </small>
                                </div>
                            </div>
                            <div class="row align-items-center pb-3">
                                <label asp-for="TemplateJson" class="col-md-2 control-label text-lg-end mb-0"></label>
                                <div class="col-md-9">
                                    <textarea asp-for="TemplateJson" rows="16" class="form-control form-control-modern font-monospace js-template-json" placeholder="{&#x0a;  &quot;version&quot;: 1&#x0a;}"></textarea>
                                    <small class="text-muted">Wijzig de JSON en valideer lokaal met het schema. Voorbeeld: {{Invoice.PublicId}}.</small>
                                    <span asp-validation-for="TemplateJson" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <h5 class="fw-semibold text-muted letter-spacing-md mt-3" style="">FONT</h5>
                            <div class="row align-items-center pb-3">
                                <label asp-for="FontFamily" class="col-md-2 control-label text-lg-end mb-0"></label>
                                <div class="col-md-9">
                                    <input asp-for="FontFamily" class="form-control" placeholder="Inter" />
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <h5 class="fw-semibold text-muted letter-spacing-md mt-3" style="">FOOTER</h5>
                            <div class="row align-items-center pb-3">
                                <label asp-for="FooterLegalText" class="col-md-2 control-label text-lg-end mb-0"></label>
                                <div class="col-md-9">
                                    <textarea asp-for="FooterLegalText" rows="3" class="form-control"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <h5 class="fw-semibold text-muted letter-spacing-md mt-3" style="">PREVIEW</h5>
                            <div class="row align-items-center pb-3">
                                <label for="invoice-layout-preview-id" class="col-md-2 control-label text-lg-end mb-0">Factuur voor preview</label>
                                <div class="col-md-9">
                                    <input type="number" min="1" id="invoice-layout-preview-id" class="form-control js-preview-invoice" placeholder="Factuur ID" />
                                    <small class="text-muted">Gebruik een bestaande factuur-id om een voorbeeld te genereren.</small>
                                </div>
                            </div>
                            <div class="row align-items-center pb-3">
                                <label for="invoice-layout-preview-id" class="col-md-2 control-label text-lg-end mb-0"></label>
                                <div class="col-md-9">
                                    <button type="button" class="btn btn-secondary js-layout-preview" data-preview-url="@Url.Content("~/Admin/InvoiceLayout/Preview")">Preview PDF</button>
                                    <button type="button" class="btn btn-light border js-layout-reset">Reset naar standaard</button>
                                </div>
                            </div>
                        </div>
                        
                        <div id="invoice-layout-error" class="alert alert-danger d-none mt-3"></div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
<div class="row mt-4">
