@model CPMCore.Models.Instellingen.IssuerCompanyVM
@using CPMCore.Services.Octopus
@using FacadeCore
@{
    var terms = (System.Collections.Generic.IReadOnlyList<BOCore.PaymentTermOptionBO>)
                ViewBag.PaymentTerms ?? new List<BOCore.PaymentTermOptionBO>();
    var bank = (IReadOnlyList<BOCore.IssuerBankAccountBO>)ViewBag.BankAccounts ?? new List<BOCore.IssuerBankAccountBO>();
    var series = (IReadOnlyList<BOCore.InvoiceSeriesBO>)ViewBag.InvoiceSeries ?? new List<BOCore.InvoiceSeriesBO>();
    var legalForms = (IReadOnlyList<BOCore.CompanyLegalFormBO>)ViewBag.CompanyLegalForms ?? new List<BOCore.CompanyLegalFormBO>();
    var octopusDossiers = ViewBag.OctopusDossiers as IReadOnlyList<OctopusDossierItem> ?? new List<OctopusDossierItem>();
    var octopusMessage = ViewBag.OctopusMessage as string;
    var octopusMessageType = ViewBag.OctopusMessageType as string;
    var octopusBookyears = ViewBag.OctopusBookyears as IReadOnlyList<BOCore.OctopusBookyearBO> ?? new List<BOCore.OctopusBookyearBO>();
    var octopusVatCodes = ViewBag.OctopusVatCodes as IReadOnlyList<VatTypeBO> ?? new List<VatTypeBO>();
    var octopusCustomFields = Model.CustomFieldMappings ?? new List<CPMCore.Models.Instellingen.OctopusCustomFieldMappingVM>();
    var invoiceFieldOptions = ViewBag.InvoiceFieldOptions as IReadOnlyList<KeyValuePair<string, string>> ?? new List<KeyValuePair<string, string>>();
    var vatTypes = Model.VatTypes ?? new List<CPMCore.Models.Invoicing.VatTypeVM>();
    var paymentTerms = Model.PaymentTerms ?? new List<CPMCore.Models.Instellingen.PaymentTermVM>();
    var octopusRelationSuggestions = ViewBag.OctopusRelationSuggestions as IReadOnlyList<OctopusRelationSuggestion> ?? new List<OctopusRelationSuggestion>();
}
<div class="row mt-2">
	<div class="col">
		<section class="card card-modern card-big-info">
			<div class="card-body">
				<div class="row">
					<div class="col-lg-2-5 col-xl-1-5">
						<i class="card-big-info-icon bx bx-box"></i>
						<h2 class="card-big-info-title">Identiteit</h2>
						<p class="card-big-info-desc">Naam, rechtsvorm, BTW-nummer en ondernemingsnummer van het bedrijf.</p>
					</div>
					<div class="col-lg-3-5 col-xl-4-5">
                      <div class="form-group row align-items-center pb-3">
                            <label class="col-lg-2 control-label text-lg-end pt-2" asp-for="IsActive"></label>
                            <div class="col-lg-9">
                                <div class="switch switch-sm switch-primary">
                                    @Html.CheckBoxFor(m => m.IsActive, new { data_plugin_ios_switch = "" })
                                </div>

                            </div>
                        </div>
                        <div class="form-group">
						<div class="row align-items-center pb-3">
							<label class="col-md-2 control-label text-lg-end mb-0">@Html.LabelFor(m => m.Name)</label>
							<div class="col-md-9">
								@Html.TextBoxFor(m => m.Name, new {@class = "form-control", placeholder = "Weergave naam"})
                                <span asp-validation-for="Name" class="text-danger"></span>
							</div>
						</div>
                        <div class="row align-items-center pb-3">
                            <label class="col-md-2 control-label text-lg-end mb-0">@Html.LabelFor(m => m.LegalName)</label>
                            <div class="col-md-9">
                                @Html.TextBoxFor(m => m.LegalName, new { @class = "form-control", placeholder = "Wettelijke naam" })
                            </div>
                        </div>
                            <div class="row align-items-center pb-3">
                                <label class="col-md-2 control-label text-lg-end mb-0">@Html.LabelFor(m => m.CompanyLegalFormId)</label>
                                <div class="col-md-9">
                                    <select asp-for="CompanyLegalFormId" class="form-control">
                                        <option value="">— kies —</option>
                                        @foreach (var form in legalForms)
                                        {
                                            <option value="@form.Id">@form.Abbreviation - @form.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        <div class="row align-items-center pb-3">
                            <label class="col-md-2 control-label text-lg-end mb-0">@Html.LabelFor(m => m.VatNumber)</label>
                            <div class="col-md-9">
                                @Html.TextBoxFor(m => m.VatNumber, new { @class = "form-control", placeholder = "BTW-nummer" })
                            </div>
                        </div>
                        <div class="row align-items-center pb-3">
                            <label class="col-md-2 control-label text-lg-end mb-0">@Html.LabelFor(m => m.EnterpriseNumber)</label>
                            <div class="col-md-9">
                                @Html.TextBoxFor(m => m.EnterpriseNumber, new { @class = "form-control", placeholder = "Ondernemingsnummer" })
                            </div>
                        </div>
                        </div>
                       
                      
					</div>
                  
				</div>
			</div>
		</section>
	</div>
</div>
<div class="row mt-4">
    <div class="col">
        <section class="card card-modern card-big-info">
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-2-5 col-xl-1-5">
                        <i class="card-big-info-icon bx bx-location-plus"></i>
                        <h2 class="card-big-info-title">Contact & Adres</h2>
                        <p class="card-big-info-desc">Adresgegevens, contactinfo en website van het bedrijf.</p>
                    </div>
                    <div class="col-lg-3-5 col-xl-4-5">
                    <div class="form-group">
                             <h5 class="fw-semibold text-muted letter-spacing-md" style="">ADRES</h5>
                           <div class="row align-items-center pb-3">
                                <label asp-for="AddressLine1" class="col-md-2 control-label text-lg-end mb-0"></label>
                                <div class="col-md-9">
                                    <input asp-for="AddressLine1" class="form-control" placeholder="Adres" />
                                </div>
                            </div>
                            <div class="row align-items-center pb-3">
                                <label class="col-md-2 control-label text-lg-end mb-0">Postcode / Gemeente</label>
                                <div class="col-md-2">
                                    <input asp-for="PostalCode" class="form-control" placeholder="Postcode" />
                                </div>
                                <div class="col-md-6">
                                    <input asp-for="City" class="form-control" placeholder="Gemeente" />
                                </div>
                                <div class="col-md-1">
                                    <input asp-for="CountryCode" class="form-control" placeholder="BE" />
                                </div>
                            </div>
                     </div>
                    <div class="form-group">
                    <h5 class="fw-semibold text-muted letter-spacing-md" style="">CONTACTGEGEVENS</h5>
                        <div class="row align-items-center pb-3">
                            <label asp-for="Email" class="col-md-2 control-label text-lg-end mb-0"></label>
                            <div class="col-md-9">
                                <input asp-for="Email" class="form-control" placeholder="Email" />
                            </div>
                        </div>
                        <div class="row align-items-center pb-3">
                            <label asp-for="InvoiceSendEmail" class="col-md-2 control-label text-lg-end mb-0"></label>
                            <div class="col-md-9">
                                <input asp-for="InvoiceSendEmail" class="form-control" placeholder="Verzend e-mail adres" />
                            </div>
                        </div>
                        <div class="row align-items-center pb-3">
                            <label asp-for="Phone" class="col-md-2 control-label text-lg-end mb-0"></label>
                            <div class="col-md-9">
                                <input asp-for="Phone" class="form-control" placeholder="Telefoon" />
                            </div>
                        </div>
                        <div class="row align-items-center pb-3">
                            <label asp-for="Phone2" class="col-md-2 control-label text-lg-end mb-0"></label>
                            <div class="col-md-9">
                                <input asp-for="Phone2" class="form-control" placeholder="Tweede telefoon" />
                            </div>
                        </div>
                        <div class="row align-items-center pb-3">
                            <label asp-for="Website" class="col-md-2 control-label text-lg-end mb-0"></label>
                            <div class="col-md-9">
                                <input asp-for="Website" class="form-control" placeholder="Website" />
                            </div>
                        </div>
                        </div>

                    </div>

                </div>
            </div>
        </section>
    </div>
</div>
<div class="row mt-4">
    <div class="col">
        <section class="card card-modern card-big-info">
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-2-5 col-xl-1-5">
                        <i class="card-big-info-icon bx bx-image"></i>
                        <h2 class="card-big-info-title">Logo & Huisstijl</h2>
                        <p class="card-big-info-desc">Het logo verschijnt op facturen en documenten van dit bedrijf.</p>
                    </div>
                    <div class="col-lg-3-5 col-xl-4-5">

                        <div class="form-group row align-items-top pb-3">
                            <label asp-for="LogoUpload" class="col-md-2 control-label text-lg-end mb-0"></label>
                            <div class="col-md-9">
                                <div class="mb-3">
                                    <div class="issuer-logo-box">
                                        @if (Model.LogoBytes != null && Model.LogoBytes.Length > 0)
                                        {
                                            var base64 = System.Convert.ToBase64String(Model.LogoBytes);
                                            <img src="data:image/png;base64,@base64"
                                                 alt="Huidig logo"
                                                 class="issuer-logo-preview" />
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Geen logo</span>
                                        }
                                    </div>
                                </div>
                                <input asp-for="LogoUpload" class="form-control" type="file" accept="image/*" />
                                @Html.HiddenFor(m => m.LogoPath)
                                @if (!string.IsNullOrWhiteSpace(Model.LogoPath))
                                {
                                    <small class="text-muted d-block mt-1">Huidig bestand: @Model.LogoPath</small>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
<div class="row mt-4">
    <div class="col">
        <section class="card card-modern card-big-info">
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-2-5 col-xl-1-5">
                        <i class="card-big-info-icon bx bx-location-plus"></i>
                        <h2 class="card-big-info-title">Facturatie-instellingen</h2>
                        <p class="card-big-info-desc">Standaard betaaltermijn en BTW-type voor nieuwe facturen.</p>
                    </div>
                    <div class="col-lg-3-5 col-xl-4-5">
                    <div class="form-group">
                         <div class="row align-items-center pb-3">
                            <label asp-for="DefaultPaymentTermId" class="col-md-2 control-label text-lg-end mb-0"></label>
                            <div class="col-md-9">
                                <select asp-for="DefaultPaymentTermId" class="form-control">
                                    <option value="">— kies —</option>
                                    @foreach (var t in terms)
                                    {
                                        <option value="@t.Id">@t.Label</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row align-items-center pb-3">
                            <label asp-for="DefaultVatTypeId" class="col-md-2 control-label text-lg-end mb-0"></label>
                            <div class="col-md-9">
                                @if (octopusVatCodes.Any())
                                {
                                    <select asp-for="DefaultVatTypeId" class="form-control">
                                        <option value="">— kies —</option>
                                        @foreach (var vat in octopusVatCodes)
                                        {
                                            <option value="@vat.Id">@vat.Code - @vat.Description (@vat.BasePercentage.ToString("0.##")%)</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <select asp-for="DefaultVatTypeId" class="form-control" disabled="disabled">
                                        <option value="">— kies —</option>
                                    </select>
                                    <small class="text-muted">Synchroniseer het dossier om btw-codes op te halen.</small>
                                }
                            </div>
                        </div>
                     </div>
                </div>
            </div>
        </section>
    </div>
</div>

<div class="row mt-4">
    <div class="col">
        <section class="card card-modern card-big-info">
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-2-5 col-xl-1-5">
                        <i class="card-big-info-icon bx bx-bank"></i>
                        <h2 class="card-big-info-title">Bankrekeningen</h2>
                        <p class="card-big-info-desc">Beheer IBAN/BIC per bedrijf. Eén rekening kan standaard zijn.</p>
                    </div>
                    <div class="col-lg-3-5 col-xl-4-5">

                        <div class="d-flex justify-content-end mb-3">
                            <a class="btn btn-primary btn-sm"
                               href="@Url.Action("BankAccountCreate", "Instellingen", new { issuerId = Model.Id })">
                                <i class="fas fa-plus me-1"></i> Nieuwe rekening
                            </a>
                        </div>

                        <table class="table table align-middle">
                            <thead>
                                <tr class="background">
                                    <th>Omschrijving</th>
                                    <th>IBAN</th>
                                    <th>BIC</th>
                                    <th>Geldig</th>
                                    <th>Status</th>
                                    <th class="text-end">Acties</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var x in bank)
                                {
                                    <tr>
                                        <td>@(string.IsNullOrWhiteSpace(x.DisplayName) ? "—" : x.DisplayName)</td>
                                        <td>@x.Iban</td>
                                        <td>@(string.IsNullOrWhiteSpace(x.Bic) ? "—" : x.Bic)</td>
                                        <td>
                                            @((x.ValidFrom?.ToString("dd/MM/yyyy") ?? "—")) – @((x.ValidTo?.ToString("dd/MM/yyyy") ?? "—"))
                                        </td>
                                        <td>
                                            @if (x.IsDefault)
                                            {
                                                <span class="badge bg-primary">Standaard</span>
                                            }
                                            else
                                            {

                                                <span class="badge bg-light text-dark">—</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a data-toggle="tooltip" data-placement="top" class="btn btn-link p-0 d-inline" title="Bewerken" data-original-title="Bewerken" href="@Url.Action("BankAccountEdit", "Instellingen", new { issuerId = Model.Id, id = x.Id })"><i class="bx bx-edit"></i></a>
                                            <button type="button"
                                                    class="btn btn-link p-0 d-inline js-bank-account-action"
                                                    data-toggle="tooltip"
                                                    data-placement="top"
                                                    title="Standaard"
                                                    data-action="set-default"
                                                    data-url="@Url.Action("BankAccountSetDefault", "Instellingen", new { issuerId = Model.Id, id = x.Id })"
                                                    @(x.IsDefault ? "disabled" : "")>
                                                <i class="bx bx-check-circle"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-link p-0 d-inline js-bank-account-action"
                                                    data-toggle="tooltip"
                                                    data-placement="top"
                                                    title="Verwijderen"
                                                    data-action="delete"
                                                    data-confirm="Deze bankrekening verwijderen?"
                                                    data-url="@Url.Action("BankAccountDelete", "Instellingen", new { issuerId = Model.Id, id = x.Id })">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
<div class="row mt-4">
    <div class="col">
        <section class="card card-modern card-big-info">
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-2-5 col-xl-1-5">
                        <i class="card-big-info-icon bx bx-link"></i>
                        <h2 class="card-big-info-title">Octopus koppeling</h2>
                        <p class="card-big-info-desc">Verbind het bedrijf met een Octopus-dossier. Bewaar eerst het bedrijf om tokens op te halen.</p>
                    </div>
                    <div class="col-lg-3-5 col-xl-4-5">
                        @if (!string.IsNullOrWhiteSpace(octopusMessage))
                        {
                            var alertType = string.IsNullOrWhiteSpace(octopusMessageType) ? "info" : octopusMessageType;
                            <div class="alert alert-@alertType" role="alert">@octopusMessage</div>
                        }
                        <div class="form-group">
                         <h5 class="fw-semibold text-muted letter-spacing-md" style="">AUTHENTICATIE</h5>
                        <div class="row align-items-center pb-3">
                            <label asp-for="OctopusUsername" class="col-md-2 control-label text-lg-end mb-0"></label>
                            <div class="col-md-9">
                                <input asp-for="OctopusUsername" class="form-control" placeholder="Gebruikersnaam" autocomplete="off" />
                            </div>
                        </div>
                        <div class="row align-items-center pb-3">
                            <label asp-for="OctopusPassword" class="col-md-2 control-label text-lg-end mb-0"></label>
                            <div class="col-md-9">
                                <input asp-for="OctopusPassword" value="@Model.OctopusPassword" type="password" class="form-control" placeholder="Wachtwoord" autocomplete="current-password" />
                            </div>
                        </div>
                        <div class="row align-items-center pb-3">
                            <label asp-for="OctopusAuthenticateToken" class="col-md-2 control-label text-lg-end mb-0"></label>
                            <div class="col-md-9">
                                <div class="d-flex align-items-center gap-2">
                                    <button type="submit"
                                            class="btn btn-default btn-sm"
                                            formaction='@Url.Action("IssuerCompanyOctopusAuthenticate", "Instellingen", new { issuerId = Model.Id })'
                                            formmethod="post"
                                            formnovalidate
                                            @(Model.Id <= 0 ? "disabled" : null)>
                                        <i class="bx bx-key"></i> Token ophalen
                                    </button>

                                        @if (!string.IsNullOrWhiteSpace(Model.OctopusAuthenticateToken))
                                        {
                                            <small class="status-badge-sm status-badge-sm-success">
                                            <i class="fas fa-check-circle"></i>
                                            <text>Huidig tot @(Model.OctopusAuthenticateTokenValidUntil?.ToString("g") ?? "onbekend")</text>
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="status-badge-sm status-badge-sm-warning">
                                            <i class="fas fa-check-circle"></i>
                                            <text>Nog geen token</text>
                                            </small>
                                            
                                        }
                                    
                                </div>
                                <input type="hidden" asp-for="OctopusAuthenticateToken" />
                                <input type="hidden" asp-for="OctopusAuthenticateTokenValidUntil" />
                                <input type="hidden" asp-for="OctopusCustomFieldsJson" />
                                <input type="hidden" asp-for="OctopusCustomFieldMappingsJson" />
                            </div>
                        </div>
                        </div>
                                                <div class="form-group">
                                                                         <h5 class="fw-semibold text-muted letter-spacing-md" style="">DOSSIER</h5>
                        <div class="row align-items-center pb-3">
                            <label class="col-md-2 control-label text-lg-end mb-0">Dossier kiezen</label>
                            <div class="col-md-9">
                                <div class="d-flex flex-column gap-2">
                                    <div class="d-flex gap-2">
                                        <select class="form-control" name="DossierNumber" @(Model.Id <= 0 ? "disabled" : null)>
                                            <option value="">— kies dossier —</option>
                                            @if (!string.IsNullOrWhiteSpace(Model.OctopusDossierNumber) && !(octopusDossiers?.Any(d => d.Number == Model.OctopusDossierNumber) ?? false))
                                            {
                                                <option value="@Model.OctopusDossierNumber" selected>Huidig: @Model.OctopusDossierNumber</option>
                                            }
                                            @if (octopusDossiers != null)
                                            {
                                                foreach (var dossier in octopusDossiers)
                                                {
                                                    var selected = string.Equals(Model.OctopusDossierNumber, dossier.Number, StringComparison.OrdinalIgnoreCase);
                                                    <option value="@dossier.Number" selected="@(selected ? "selected" : null)">@dossier.Number - @dossier.Name</option>
                                                }
                                            }
                                        </select>
                                        <button type="submit"
                                                class="btn btn-default btn-sm"
                                                formaction='@Url.Action("IssuerCompanyOctopusDossiers", "Instellingen", new { issuerId = Model.Id })'
                                                formmethod="post"
                                                formnovalidate
                                                @(Model.Id <= 0 ? "disabled" : null)>
                                            <i class="bx bx-refresh-cw"></i>
                                        </button>
                                        <button type="submit"
                                                class="btn btn-primary btn-sm"
                                                formaction='@Url.Action("IssuerCompanyOctopusConnect", "Instellingen", new { issuerId = Model.Id })'
                                                formmethod="post"
                                                formnovalidate
                                                @(Model.Id <= 0 ? "disabled" : null)>
                                            <i class="bx bx-link-alt"></i> Koppelen
                                        </button>
                                    </div>
                                        @if (!string.IsNullOrWhiteSpace(Model.OctopusDossierNumber))
                                        {
                                            <small class="status-badge-sm status-badge-sm-success">
                                            <i class="fas fa-check-circle"></i>
                                             <text>Dossier gekoppeld: @Model.OctopusDossierNumber (token geldig tot @(Model.OctopusDossierTokenValidUntil?.ToString("g") ?? "onbekend"))</text>
                                            </small>
                                           
                                        }
                                        else
                                        {
                                            
                                            <small class="status-badge-sm status-badge-sm-warning">
                                            <i class="fas fa-check-circle"></i>
                                             <text>Geen dossier gekoppeld</text>
                                            </small>
                                           
                                        }
                                </div>
                                <input type="hidden" asp-for="OctopusDossierToken" />
                                <input type="hidden" asp-for="OctopusDossierTokenValidUntil" />
                                <input type="hidden" asp-for="OctopusDossierNumber" />
                            </div>
                        </div>
                        <div class="row align-items-center pb-3">
                            <label class="col-md-2 control-label text-lg-end mb-0" asp-for="OctopusPurchaseJournalKeyPrefix">Aankoopdagboek prefix</label>
                            <div class="col-md-9">
                                <input asp-for="OctopusPurchaseJournalKeyPrefix" class="form-control"
                                       placeholder="bv. A" maxlength="20" style="max-width:160px" />
                                <small class="text-muted">
                                  Enkel boekingen waarvan de dagboeksleutel begint met deze prefix worden geïmporteerd als inkomende factuur (bv. A voor A1, A2 ...). Leeg = alle boekingen.
                                </small>
                            </div>
                        </div>
                                                </div>

                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
<div class="row mt-4">
    <div class="col">
        <section class="card card-modern card-big-info">
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-2-5 col-xl-1-5">
                        <i class="card-big-info-icon bx bx-calendar"></i>
                        <h2 class="card-big-info-title">Boekjaren & BTW-codes</h2>
                        <p class="card-big-info-desc">Gesynchroniseerde gegevens vanuit het Octopus-dossier.</p>
                    </div>
                    <div class="col-lg-3-5 col-xl-4-5">

                                     <button type="submit"
                                            class="btn btn-default btn-sm mb-3"
                                            formaction='@Url.Action("IssuerCompanyOctopusSync", "Instellingen", new { issuerId = Model.Id })'
                                            formmethod="post"
                                            formnovalidate
                                            @(Model.Id <= 0 ? "disabled" : null)>
                                        <i class="bx bx-refresh-cw"></i> Dossier synchroniseren
                                    </button>
                                    <button type="submit"
                                            class="btn btn-default btn-sm mb-3"
                                            formaction='@Url.Action("IssuerCompanyOctopusRelations", "Instellingen", new { issuerId = Model.Id })'
                                            formmethod="post"
                                            formnovalidate
                                            @(Model.Id <= 0 ? "disabled" : null)>
                                        <i class="bx bx-user-voice"></i> Relaties ophalen
                                    </button>

                    <div class="row">
                        <h5 class="fw-semibold text-muted letter-spacing-md mt-3" style="">BOEKJAREN & DAGBOEKEN</h5>
                          <table class="table table-sm mb-3 m-2">
                                        <thead>
                                            <tr><th>Boekjaar</th><th>Periodes</th><th>Dagboeken</th><th>Status</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var bookyear in octopusBookyears)
                                            {
                                                <tr>
                                                    <td>
                                                        <div>@bookyear.BookyearDescription</div>
                                                        <div class="d-flex align-items-center gap-2">
                                                           <small class="text-muted">
                                                                @($"{bookyear.StartDate:dd/MM/yyyy} - {bookyear.EndDate:dd/MM/yyyy}")
                                                            </small>   
                                                        </div>
                                                    </td>
                                                    <td class="align-middle">@(bookyear.Periods?.Count ?? 0)</td>
                                                    <td class="align-middle">
                                                        @(bookyear.Journals?.Any() ?? false
                                                                                                            ? string.Join(", ", bookyear.Journals.Select(j => j.JournalKey))
                                                                                                            : "—")
                                                </td>
                                                <td><span class="badge @(bookyear.Closed ? "badge-danger" : "badge-success")">@(bookyear.Closed ? "Afgesloten" : "Open")</span></td>
                                            </tr>
                                                                                        }
                                        </tbody>
                                    </table>
                    </div>
                                        <div class="row">
                        <h5 class="fw-semibold text-muted letter-spacing-md mt-3" style="">VERKOOP-BTW-CODES</h5>
                        <div class="table-responsive mt-3">
                                    <table class="table table-sm mb-3 m-2">
                                        <thead>
                                            <tr><th>Code</th><th>Omschrijving</th><th>Type</th><th>Basis %</th><th>Standaard rekening</th><th>Factuurvermelding</th></tr>
                                        </thead>
                                        <tbody>
                                            @if (vatTypes.Any())
                                            {
                                                for (var i = 0; i < vatTypes.Count; i++)
                                                {
                                                    var code = vatTypes[i];
                                                    <tr>
                                                        <td class="align-middle">
                                                            @code.Code
                                                            <input type="hidden" name="VatTypes[@i].Id" value="@code.Id" />
                                                            <input type="hidden" name="VatTypes[@i].Code" value="@code.Code" />
                                                        </td>
                                                        <td class="align-middle">
                                                            @code.Description
                                                            <input type="hidden" name="VatTypes[@i].Description" value="@code.Description" />
                                                        </td>
                                                        <td class="align-middle">
                                                            @(code.Type == 2
                                                                                                                ? "Verkoop"
                                                                                                                : code.Type == 4
                                                                                                                ? "Verkoop credit"
                                                                                                                : $"Type {code.Type}")
                                                    <input type="hidden" name="VatTypes[@i].Type" value="@code.Type" />
                                                </td>
                                                <td class="align-middle">
                                                    @code.BasePercentage%
                                                    <input type="hidden" name="VatTypes[@i].BasePercentage" value="@code.BasePercentage" />
                                                </td>
                                                <td class="align-middle">
                                                    @(code.DefaultSellBookingAccountNr?.ToString() ?? "—")
                                                    <input type="hidden" name="VatTypes[@i].DefaultSellBookingAccountNr" value="@code.DefaultSellBookingAccountNr" />
                                                </td>
                                                <td class="align-middle">
                                                    <input class="form-control form-control-sm mt-2 mb-2" name="VatTypes[@i].InvoiceMention" value="@code.InvoiceMention" placeholder="Vermelding op factuur" />
                                                </td>
                                            </tr>
                                                                                        }
                                            }
                                            else
                                            {
                                                <tr><td colspan="6" class="text-muted">Geen verkoop-btw-codes gesynchroniseerd.</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                    </div>
                        <div class="row">
                            <h5 class="fw-semibold text-muted letter-spacing-md mt-3" style="">VERKOOP-BTW-CODES</h5>
                                        @if (octopusCustomFields.Any())
                                        {
                                            <table class="table table-sm">
                                                <thead>
                                                    <tr><th class="w-50">Octopus veld</th><th class="w-50">Invoice veld</th></tr>
                                                </thead>
                                                <tbody>
                                                    @for (var i = 0; i < octopusCustomFields.Count; i++)
                                                    {
                                                        <tr>
                                                            <td class="align-middle">
                                                                @octopusCustomFields[i].DisplayName
                                                                <input type="hidden" name="CustomFieldMappings[@i].CustomFieldKeyId" value="@octopusCustomFields[i].CustomFieldKeyId" />
                                                                <input type="hidden" name="CustomFieldMappings[@i].TemplateCode" value="@octopusCustomFields[i].TemplateCode" />
                                                                <input type="hidden" name="CustomFieldMappings[@i].DescriptionNl" value="@octopusCustomFields[i].DescriptionNl" />
                                                                <input type="hidden" name="CustomFieldMappings[@i].DescriptionFr" value="@octopusCustomFields[i].DescriptionFr" />
                                                                <input type="hidden" name="CustomFieldMappings[@i].DescriptionEn" value="@octopusCustomFields[i].DescriptionEn" />
                                                                <input type="hidden" name="CustomFieldMappings[@i].DescriptionDe" value="@octopusCustomFields[i].DescriptionDe" />
                                                            </td>
                                                            <td>
                                                                <select class="form-control form-control-modern" name="CustomFieldMappings[@i].InvoiceField">
                                                                    <option value="">— kies —</option>
                                                                    @foreach (var option in invoiceFieldOptions)
                                                                    {
                                                                        var selected = string.Equals(octopusCustomFields[i].InvoiceField, option.Key, StringComparison.OrdinalIgnoreCase);
                                                                        <option value="@option.Key" selected="@(selected ? "selected" : null)">@option.Value</option>
                                                                    }
                                                                </select>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                            <div class="form-group row align-items-center">
                                                <label class="col-md-4 col-lg-3 control-label text-lg-end mb-0">Downloadlink veld</label>
                                                <div class="col-md-8 col-lg-9">
                                                    <select asp-for="OctopusDownloadLinkCustomFieldKeyId" class="form-control form-control-modern">
                                                        <option value="">— kies —</option>
                                                        @foreach (var field in octopusCustomFields)
                                                        {
                                                            <option value="@field.CustomFieldKeyId">@field.DisplayName</option>
                                                        }
                                                    </select>
                                                    <small class="text-muted">Kies het Octopus custom veld dat de beveiligde downloadlink moet ontvangen.</small>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                        <small class="status-badge-sm status-badge-sm-warning">
                                            <i class="fas fa-check-circle"></i>
                                            <text>Geen custom fields geladen. Synchroniseer het dossier om ze op te halen.</text>
                                        </small>
                                        }
                                    
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
<div class="row mt-4">
    <div class="col">
        <section class="card card-modern card-big-info">
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-2-5 col-xl-1-5">
                        <i class="card-big-info-icon bx bx-clock"></i>
                        <h2 class="card-big-info-title">Betaaltermijnen</h2>
                        <p class="card-big-info-desc">Definieer de betaaltermijnen die beschikbaar zijn voor facturen van dit bedrijf.</p>
                    </div>
                    <div class="col-lg-3-5 col-xl-4-5">
                                    <button type="button" class="btn btn-sm btn-primary" id="addPaymentTermRow">
                                        <i class="bx bx-plus"></i> Betaaltermijn toevoegen
                                    </button>
                                <div class="table-responsive mt-3">
                                    <table class="table table-sm mb-0" id="paymentTermsTable">
                                        <thead>
                                            <tr>
                                                <th>Naam</th>
                                                <th>Type</th>
                                                <th>Dagen</th>
                                                <th>Weergave</th>
                                                <th>Tekst op factuur</th>
                                                <th>Omschrijving</th>
                                                <th>Verwijder</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (paymentTerms.Any())
                                            {
                                                for (var i = 0; i < paymentTerms.Count; i++)
                                                {
                                                    var term = paymentTerms[i];
                                                    <tr data-row="@i">
                                                        <td>
                                                            <input type="hidden" name="PaymentTerms[@i].Id" value="@term.Id" />
                                                            <input class="form-control form-control-sm mt-2 mb-2" name="PaymentTerms[@i].Name" value="@term.Name" placeholder="Naam" />
                                                        </td>
                                                        <td>
                                                            <select class="form-control form-control-sm mt-2 mb-2" name="PaymentTerms[@i].TermType">
                                                                <option value="0" selected="@(term.TermType == BOCore.PaymentTermType.Days ? "selected" : null)">Dagen</option>
                                                                <option value="1" selected="@(term.TermType == BOCore.PaymentTermType.DaysAfterEndOfMonth ? "selected" : null)">Dagen na einde maand</option>
                                                                <option value="2" selected="@(term.TermType == BOCore.PaymentTermType.Text ? "selected" : null)">Tekst</option>
                                                            </select>
                                                        </td>
                                                        <td>
                                                            <input class="form-control form-control-sm mt-2 mb-2" name="PaymentTerms[@i].Days" value="@term.Days" type="number" min="0" />
                                                        </td>
                                                        <td>
                                                            <select class="form-control form-control-sm mt-2 mb-2" name="PaymentTerms[@i].DisplayMode">
                                                                <option value="0" selected="@(term.DisplayMode == BOCore.PaymentTermDisplayMode.DueDate ? "selected" : null)">Vervaldatum</option>
                                                                <option value="1" selected="@(term.DisplayMode == BOCore.PaymentTermDisplayMode.Text ? "selected" : null)">Extra tekst</option>
                                                            </select>
                                                        </td>
                                                        <td>
                                                            <input class="form-control form-control-sm mt-2 mb-2" name="PaymentTerms[@i].DisplayText" value="@term.DisplayText" placeholder="Tekst op factuur" />
                                                        </td>
                                                        <td>
                                                            <input class="form-control form-control-sm mt-2 mb-2" name="PaymentTerms[@i].Description" value="@term.Description" placeholder="Omschrijving" />
                                                        </td>
                                                        <td class="text-center">
                                                            <input type="hidden" name="PaymentTerms[@i].IsDeleted" value="false" />
                                                            <input class="form-check-input js-paymentterm-delete" type="checkbox" data-index="@i" />
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr class="text-muted"><td colspan="7">Nog geen betaaltermijnen toegevoegd.</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
<div class="row mt-4">
    <div class="col">
        <section class="card card-modern card-big-info mt-4">
            <div class="card-body">
