@model List<CPMCore.Models.IssueNotification.RunRowVm>
@{
    ViewBag.BreadcrumbTitle = "Logs";
    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
}

@section PageStyle {
    <link rel="stylesheet" href="~/lib/datatables/media/css/dataTables.bootstrap5.css" />
}

<div class="row justify-content-between align-items-center pt-2 pe-0 mb-2">
    <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
        <h1 class="font-weight-bold mb-0 mt-0">Uitvoeringslogboek</h1>
        <h5 class="mb-4 mt-0">Overzicht van alle uitgevoerde meldingsbatches</h5>
    </div>
    <div class="col-sm-auto px-0">
        <a asp-action="Index" class="btn btn-default btn-md">← Terug naar schema's</a>
    </div>
</div>

<div class="card card-modern">
    <div class="card-body">
        <div class="datatables-header-footer-wrapper mt-2">
            <table class="table table-responsive-md table-hover mb-3" id="datatable-logs" style="min-width: 720px;">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Datum (UTC)</th>
                        <th>Type</th>
                        <th>Getriggerd door</th>
                        <th>Status</th>
                        <th>Mails</th>
                        <th>Duur</th>
                        <th>Foutmelding</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="text-muted">@r.Id</td>
                            <td>@r.StartedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>@r.RunTypeLabel</td>
                            <td><code>@r.TriggeredBy</code></td>
                            <td><span class="@r.StatusCssClass">@r.StatusLabel</span></td>
                            <td>@r.EmailsSent</td>
                            <td>
                                @if (r.FinishedDate.HasValue)
                                {
                                    <span>@((int)(r.FinishedDate.Value - r.StartedDate).TotalSeconds)s</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(r.ErrorMessage))
                                {
                                    <span class="text-danger" title="@r.ErrorMessage">
                                        @(r.ErrorMessage.Length > 80 ? r.ErrorMessage[..80] + "…" : r.ErrorMessage)
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Geen logs gevonden.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-footer d-flex justify-content-center">
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    @for (var p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == page ? "active" : "")">
                            <a asp-action="Logs" asp-route-page="@p" class="page-link">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>

@section PageScripts {
    @if (Model.Any())
    {
        <script src="~/lib/datatables/media/js/jquery.dataTables.min.js"></script>
        <script src="~/lib/datatables/media/js/dataTables.bootstrap5.min.js"></script>
        <script>
            (function () {
                $('#datatable-logs').DataTable({
                    paging: false,
                    ordering: true,
                    info: false,
                    searching: false,
                    language: {
                        zeroRecords: 'Geen logs gevonden',
                        emptyTable: 'Geen logs gevonden'
                    }
                });
            })();
        </script>
    }
}
