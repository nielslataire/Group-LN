@using BOCore
@using FacadeCore
@model ProjectSjabloonBewerk
@inject IPermissionService PermissionService
@*
    gl-v2 — Instellingen › Sjablonen › Projectsjablonen › bewerken (design-handoff 66d). Een gewoon formulier (POST Opslaan). Boven: naam, omschrijving en Actief in de kop. Daaronder de drie onderdelen
    (planning, traject, schijven) als kaarten met een keuzelijst, kerncijfers en "Openen", en een gouden melding als schijven en planning niet op elkaar passen. Dan het standaardgebouw met een stapper
    (verdiepingen) en keuzeknoppen (dak, kelder). Rechts "Zo wordt het toegepast" voor die antwoorden. De kerncijfers en het voorbeeld komen uit Overzicht (JSON, ProjectSjabloonService.Overzicht)
    en verversen bij elke keuze. De verborgen velden en selects zijn wat er gepost wordt; bij een fout komt dezelfde pagina terug (ViewData["Fouten"]).
*@
@{
    var isNieuw = Model.Id == 0;
    ViewData["Title"] = isNieuw ? "Nieuw sjabloon" : Model.Naam;
    ViewData["PageIcon"] = "ph ph-buildings";
    ViewData["HelpScreenId"] = "instellingen-projectsjablonen-bewerken";
    ViewData["BackUrl"] = Url.Action("Index");
    var canWrite = PermissionService.HasWrite(PermissionCodes.SettingsPlanningSjablonen);
    var opties = (ProjectSjabloonOpties)ViewData["Opties"]!;
    var fouten = ViewData["Fouten"] as List<string>;
    var dis = canWrite ? "" : "disabled";
    var verdiepingen = Math.Max(1, Model.StandaardVerdiepingen);
}
@section PageStyle
{
    <link rel="stylesheet" href="~/css/gl-v2-instellingen-automatisatie.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-instellingen-schijvensjabloon.css" asp-append-version="true" />
}
@section PageActions
{
    <a href="@Url.Action("Index")" class="gl-v2-btn gl-v2-btn-text">Annuleren</a>
    @if (canWrite)
    {
        <button type="submit" form="pjs-vorm" class="gl-v2-btn gl-v2-btn-primary"><i class="ph ph-floppy-disk" aria-hidden="true"></i>Sjabloon opslaan</button>
    }
}

<form method="post" action="@Url.Action("Opslaan")" id="pjs-vorm" class="gl-v2-sjs gl-v2-pjs" novalidate data-overzicht-url="@Url.Action("Overzicht")"
      data-planning-url="@Url.Action("Bewerken", "PlanningSjabloonAdmin", new { id = "__ID__" })" data-traject-url="@Url.Action("Bewerken", "TrajectSjabloonAdmin", new { id = "__ID__" })" data-schijven-url="@Url.Action("Bewerken", "SchijfSjabloonAdmin", new { id = "__ID__" })">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    @if (fouten != null && fouten.Count > 0)
    {
        <div class="gl-v2-inline-error gl-v2-sjs-fouten" role="alert">
            <span class="gl-v2-inline-error-icon"><i class="ph ph-warning-circle" aria-hidden="true"></i></span>
            <div class="gl-v2-inline-error-text">
                <div class="gl-v2-inline-error-title">Het sjabloon is nog niet bewaard</div>
                <ul class="gl-v2-inline-error-desc gl-v2-sjs-foutlijst">@foreach (var f in fouten) { <li>@f</li> }</ul>
            </div>
        </div>
    }

    <div class="gl-v2-sjs-grid">
        <div class="gl-v2-sjs-links">
            <section class="gl-v2-section-card gl-v2-pjs-kop">
                <div class="gl-v2-field">
                    <label class="gl-v2-field-label" for="pjs-naam">Naam <span class="gl-v2-field-req" aria-hidden="true">*</span></label>
                    <div class="gl-v2-field-box"><input type="text" id="pjs-naam" name="Naam" class="gl-v2-field-input" maxlength="200" value="@Model.Naam" @dis /></div>
                </div>
                <div class="gl-v2-field">
                    <label class="gl-v2-field-label" for="pjs-beschrijving">Korte omschrijving</label>
                    <div class="gl-v2-field-box"><input type="text" id="pjs-beschrijving" name="Beschrijving" class="gl-v2-field-input" maxlength="1000" value="@Model.Beschrijving" @dis /></div>
                </div>
                <label class="gl-v2-toggle-row gl-v2-sjs-actief" for="pjs-actief"><input type="checkbox" id="pjs-actief" name="IsActief" value="true" class="gl-v2-toggle-switch" checked="@(isNieuw ? true : Model.IsActief)" @dis /><span class="gl-v2-toggle-text"><span class="gl-v2-toggle-label">Actief</span><span class="gl-v2-toggle-desc">enkel actieve sjablonen kan je toepassen</span></span></label>
                <input type="hidden" name="IsActief" value="false" />
            </section>

            <section class="gl-v2-section-card gl-v2-pjs-kaart">
                <header class="gl-v2-sjs-schijven-kop"><h2 class="gl-v2-section-card-title">Onderdelen</h2><span class="gl-v2-sjs-sub">Kies minstens één. Een leeg onderdeel wordt bij het toepassen overgeslagen.</span></header>
                <div class="gl-v2-pjs-delen">
                    @{
                        var delen = new[]
                        {
                            (Sleutel: "projectplanning", Titel: "Planning van het project zelf", Icoon: "ph-road-horizon", Naam: "PlanningSjabloonProjectId", Gekozen: Model.PlanningSjabloonProjectId, Lijst: opties.Planning, Geen: "geen planning voor het project zelf"),
                            (Sleutel: "planning", Titel: "Planning van de woningen of eenheden", Icoon: "ph-calendar-check", Naam: "PlanningSjabloonId", Gekozen: Model.PlanningSjabloonId, Lijst: opties.Planning, Geen: "geen planning"),
                            (Sleutel: "traject", Titel: "Traject", Icoon: "ph-git-branch", Naam: "TrajectSjabloonId", Gekozen: Model.TrajectSjabloonId, Lijst: opties.Traject, Geen: "geen traject"),
                            (Sleutel: "schijven", Titel: "Schijven", Icoon: "ph-list-checks", Naam: "SchijfSjabloonId", Gekozen: Model.SchijfSjabloonId, Lijst: opties.Schijven, Geen: "geen schijven"),
                            (Sleutel: "bijgebouwen", Titel: "Schijven parkings en bergingen", Icoon: "ph-car", Naam: "SchijfSjabloonBijgebouwId", Gekozen: Model.SchijfSjabloonBijgebouwId, Lijst: opties.Schijven, Geen: "dezelfde schijven als hierboven"),
                        };
                    }
                    @foreach (var d in delen)
                    {
                        <div class="gl-v2-pjs-deel" data-deel="@d.Sleutel" data-geen="@d.Geen">
                            <div class="gl-v2-pjs-deelkop"><i class="ph @d.Icoon" aria-hidden="true"></i><b>@d.Titel</b><a href="#" class="gl-v2-pjs-open" hidden>Openen</a></div>
                            <div class="gl-v2-field-box"><select id="pjs-@d.Sleutel" name="@d.Naam" class="gl-v2-field-input js-pjs-sel" aria-label="@d.Titel" @dis><option value="">Geen</option>@foreach (var o in d.Lijst) { <option value="@o.Id" selected="@(d.Gekozen == o.Id)">@o.Naam</option> }</select></div>
                            <ul class="gl-v2-pjs-feiten" data-feiten>@if (d.Sleutel == "bijgebouwen") { <li>Voor betalingsgroepen met enkel parkings en bergingen. Een berging of parking die aan een appartement hangt, zet je in de groep van dat appartement en volgt dan diens schijven.</li> } else if (d.Sleutel == "projectplanning") { <li>Komt in de hoofdplanning, bv. de wegenis van een verkaveling. Enkel als de hoofdplanning nog leeg is.</li> }</ul>
                            @if (d.Sleutel == "projectplanning")
                            {
                                <div class="gl-v2-field" style="margin-top:8px">
                                    <label class="gl-v2-field-label" for="pjs-startna">Woningen starten</label>
                                    <div class="gl-v2-field-box"><select id="pjs-startna" name="WoningenStartNa" class="gl-v2-field-input" @dis>
                                        <option value="" selected="@string.IsNullOrEmpty(Model.WoningenStartNa)">onmiddellijk (aanvangsdatum bouwwerken)</option>
                                        <option value="WEGENIS_FUNDERING" selected="@(Model.WoningenStartNa == "WEGENIS_FUNDERING")">na de wegenfundering</option>
                                        <option value="WEGENIS_NUTSVOORZIENINGEN" selected="@(Model.WoningenStartNa == "WEGENIS_NUTSVOORZIENINGEN")">na de nutsvoorzieningen</option>
                                        <option value="WEGENIS_VERHARDING" selected="@(Model.WoningenStartNa == "WEGENIS_VERHARDING")">na de wegverharding</option>
                                        <option value="WEGENIS_VOORLOPIGE_OPLEVERING" selected="@(Model.WoningenStartNa == "WEGENIS_VOORLOPIGE_OPLEVERING")">na de voorlopige oplevering van de wegenis</option>
                                    </select></div>
                                    <span class="gl-v2-field-help">Standaard. Bij het toepassen krijgt de planning van de woningen die startdatum; je past ze per project nog aan in de planning.</span>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="gl-v2-sjs-iss is-gold gl-v2-pjs-mismatch" id="pjs-mismatch" role="status" hidden></div>
            </section>

            <section class="gl-v2-section-card gl-v2-pjs-kaart">
                <header class="gl-v2-sjs-schijven-kop"><h2 class="gl-v2-section-card-title">Standaard gebouw</h2><span class="gl-v2-sjs-sub">Staat vooraf ingevuld bij het toepassen. De projectleider past het aan, of laat de AI het invullen uit de beschrijving van het gebouw.</span></header>
                <div class="gl-v2-pjs-geb">
                    <div class="gl-v2-pjs-vraag">
                        <span class="gl-v2-field-label">Verdiepingen boven gelijkvloers</span>
                        <div class="gl-v2-pjs-stap" role="group" aria-label="Verdiepingen">
                            <button type="button" id="pjs-min" aria-label="Eén verdieping minder" @dis>−</button><b id="pjs-verd-tekst">@verdiepingen</b><button type="button" id="pjs-plus" aria-label="Eén verdieping meer" @dis>+</button>
                        </div>
                        <input type="hidden" name="StandaardVerdiepingen" id="pjs-verd" value="@verdiepingen" />
                    </div>
                    <div class="gl-v2-pjs-vraag">
                        <span class="gl-v2-field-label">Dak</span>
                        <div class="gl-v2-sjs-seg is-groot" id="pjs-dak" role="group" aria-label="Dak">
                            <button type="button" data-v="hellend" class="@(Model.StandaardDak == "hellend" ? "is-on" : "")" @dis>Hellend dak</button>
                            <button type="button" data-v="plat" class="@(Model.StandaardDak == "plat" ? "is-on" : "")" @dis>Plat dak</button>
                            <button type="button" data-v="" class="@(string.IsNullOrEmpty(Model.StandaardDak) ? "is-on" : "")" @dis>Beide</button>
                        </div>
                        <input type="hidden" name="StandaardDak" id="pjs-dak-waarde" value="@Model.StandaardDak" />
                    </div>
                    <div class="gl-v2-pjs-vraag">
                        <span class="gl-v2-field-label">Kelder</span>
                        <div class="gl-v2-sjs-seg is-groot" id="pjs-kelder" role="group" aria-label="Kelder">
                            <button type="button" data-v="true" class="@(Model.StandaardKelder ? "is-on" : "")" @dis>Met kelder</button>
                            <button type="button" data-v="false" class="@(Model.StandaardKelder ? "" : "is-on")" @dis>Zonder</button>
                        </div>
                        <input type="hidden" name="StandaardKelder" id="pjs-kelder-waarde" value="@(Model.StandaardKelder ? "true" : "false")" />
                    </div>
                </div>
                <div class="gl-v2-pjs-ai"><i class="ph ph-sparkle" aria-hidden="true"></i><span>Bij het toepassen kan je een beschrijving plakken (“halfopen woning, 2 bouwlagen, kelder, zadeldak”). De AI vult deze drie vragen in, jij bevestigt.</span></div>
            </section>
        </div>

        <aside class="gl-v2-sjs-rechts" aria-label="Zo wordt het toegepast">
            <section class="gl-v2-section-card gl-v2-sjs-paneel">
                <header class="gl-v2-sjs-paneelkop"><h2 class="gl-v2-section-card-title">Zo wordt het toegepast</h2><span class="gl-v2-sjs-sub" id="pjs-voor"></span></header>
                <div class="gl-v2-pjs-uitkomst" id="pjs-uitkomst"><p class="gl-v2-sjs-leeg">Kies een onderdeel om te zien wat er gebeurt.</p></div>
                <p class="gl-v2-pjs-voet">Op een project vult het sjabloon <b>enkel wat leeg is</b>. Een bestaande planning of schijven blijven staan; je krijgt eerst het voorstel te zien.</p>
            </section>
            <section class="gl-v2-section-card gl-v2-sjs-paneel">
                <header class="gl-v2-sjs-paneelkop"><h2 class="gl-v2-section-card-title">Gebruikt in</h2></header>
                <p class="gl-v2-sjs-leeg">CPM houdt nog niet per sjabloon bij op welke projecten het is toegepast.</p>
            </section>
        </aside>
    </div>
</form>

@section PageScripts
{
    <script src="~/js/gl-v2-instellingen-projectsjabloon.js" asp-append-version="true"></script>
}
