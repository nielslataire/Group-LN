@using System.Linq
@model CPMCore.Models.Instellingen.InvoiceSequencesPageVM
@{
    ViewData["Title"] = "Sequenties";
    var octopusBookyears = ViewBag.OctopusBookyears as IEnumerable<BOCore.OctopusBookyearBO> ?? Enumerable.Empty<BOCore.OctopusBookyearBO>();
    var octopusJournals = octopusBookyears.SelectMany(by => by.Journals.Select(j => new { Journal = j, Bookyear = by })).ToList();
    var bookyearLookup = octopusBookyears.ToDictionary(by => by.Id);

}
@section PageStyle
{
    <link rel="stylesheet" href="~/lib/bootstrap-datepicker/css/bootstrap-datepicker3.css">
    <link rel="stylesheet" href="~/css/instellingen-custom.css" />
}

<div class="gl-body-padding">

    <div class="row">
        <div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
            <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
                <div class="row align-items-center">
                    <div class="col-sm-auto d-flex align-items-center">
                        <a href="@Url.Action("IssuerCompaniesEdit", "Instellingen", new { id = Model.IssuerId })" class="text-decoration-none text-reset d-flex align-items-center">
                            <i class="bx bx-chevron-left fs-1"></i>
                        </a>
                    </div>
                    <div class="col-sm-auto">
                        <h1 class="fw-bold mb-0">Sequenties toevoegen</h1>
                        <h5 class="mb-4 mt-0">Voeg hier een sequentie toe aan een nummerreeks het bedrijf </h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <form method="post"
      asp-action="SequenceCreate"
      asp-route-seriesId="@Model.SeriesId"
          asp-route-issuerId="@Model.IssuerId"
          id="sequence-create-form">
    @Html.AntiForgeryToken()
    <div class="row mt-4">
        <div class="col">
            <section class="card card-modern mt-4">
                <div class="card-body">
                    <div class="row">
                    <div class="form-group">
                            <div class="row align-items-center pb-3">
                                <label class="col-md-2 control-label text-lg-end mb-0">Boekjaar</label>
                                <div class="col-md-3">
                                        <select name="bookyearId" class="form-control form-control-modern js-bookyear-select">
                                        <option value="">— kies boekjaar —</option>
                                        @foreach (var bookyear in octopusBookyears)
                                        {
                                            <option value="@bookyear.Id">@bookyear.BookyearDescription (@bookyear.StartDate.ToString("yyyy-MM-dd") - @bookyear.EndDate.ToString("yyyy-MM-dd"))</option>
                                        }
                                    </select>
                                </div>
                                <label class="col-md-2 control-label text-lg-end mb-0">Dagboek</label>
                                <div class="col-md-3">
                                        <select name="journalId" class="form-control form-control-modern js-journal-select">
                                        <option value="">— kies dagboek —</option>
                                        @foreach (var journal in octopusJournals)
                                        {
                                                <option value="@journal.Journal.Id" data-bookyear="@journal.Bookyear.Id" data-lastnumber="@journal.Journal.LastBookedDocumentNr">@journal.Journal.Name (@journal.Bookyear.BookyearDescription)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="row align-items-center pb-3">
                                <label class="col-md-2 control-label text-lg-end mb-0">Jaar</label>
                                <div class="col-md-3">
                                    <input type="number" name="fiscalYear" value="@DateTime.Now.Year" class="form-control form-control-modern" />
                                </div>
                                <label class="col-md-2 control-label text-lg-end mb-0">Start nummering</label>
                                <div class="col-md-3">
                                        <input type="number" name="startAt" value="1" class="form-control form-control-modern" />
                                </div>
                            </div>
                                <div class="row align-items-center">
                                    <div class="col-md-7">
                                    </div>
                                    <button class="btn btn-primary col-md-3">Toevoegen</button>
                                </div>
                            </div>
                    </div>
                </div>
            </section>


        </div>
    </div>
    </form>


    <div class="row mt-4">
        <div class="col">
            <section class="card card-modern card-big-info mt-4">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-2-5 col-xl-1-5">
                            <i class="card-big-info-icon bx bx-list-ol"></i>
                            <h2 class="card-big-info-title">Sequenties</h2>
                            <p class="card-big-info-desc">Beheer jaarsequenties.</p>
                        </div>
                        <div class="col-lg-3-5 col-xl-4-5">
                            <table class="table mt-3">
                                <thead><tr><th>Boekjaar</th><th>Dagboek</th><th>Periode</th><th>Huidig nummer</th><th class="text-end">Acties </th></tr></thead>
                                <tbody>
                                    @foreach (var s in Model.Items)
                                    {
                                        bookyearLookup.TryGetValue(s.BookyearId ?? 0, out var resolvedBookyear);
                                        var periodLabel = resolvedBookyear == null
                                        ? s.FiscalYear.ToString()
                                        : $"{resolvedBookyear.StartDate:yyyy-MM-dd} - {resolvedBookyear.EndDate:yyyy-MM-dd}";
                                        <tr>
                                            <form method="post"
                                                  asp-action="SequenceUpdate"
                                                  asp-route-id="@s.Id"
                                                  asp-route-seriesId="@Model.SeriesId"
                                                  asp-route-issuerId="@Model.IssuerId"
                                                  class="d-inline">
                                            <td>
                                                <select name="bookyearId" class="form-control form-control-sm js-bookyear-select">
                                                    <option value="">—</option>
                                                    @foreach (var bookyear in octopusBookyears)
                                                    {
                                                        <option value="@bookyear.Id" selected="@(bookyear.Id == s.BookyearId ? "selected" : null)">@bookyear.BookyearDescription</option>
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                <select name="journalId" class="form-control form-control-sm js-journal-select">
                                                    <option value="">—</option>
                                                    @foreach (var journal in octopusJournals)
                                                    {
                                                        var selected = journal.Journal.Id == s.JournalId;
                                                        <option value="@journal.Journal.Id" data-bookyear="@journal.Bookyear.Id" data-lastnumber="@journal.Journal.LastBookedDocumentNr" selected="@(selected ? "selected" : null)">@journal.Journal.Name (@journal.Bookyear.BookyearDescription)</option>
                                                    }
                                                </select>
                                            </td>
                                            <td>@periodLabel</td>
                                            <td>

                                                @Html.AntiForgeryToken()
                                                <input type="number" name="currentNumber" value="@s.CurrentNumber"
                                                       class="form-control form-control-sm d-inline-block gl-sequence-number-input" />

                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-link p-0 d-inline" data-toggle="tooltip" data-placement="top" title="Opslaan">
                                                    <i class="fa fa-save"></i>
                                                </button>
                                                <button type="submit"
                                                        onsubmit="return confirm('Deze sequentie verwijderen?');"
                                                        formmethod="post"
                                                        formaction="@Url.Action("SequenceDelete", "Instellingen", new { seriesId = Model.SeriesId, issuerId = Model.IssuerId, id = s.Id })"
                                                        class="btn btn-link p-0 d-inline" data-toggle="tooltip" data-placement="top" title="Verwijderen">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </td>
                                            </form>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>


        </div>
    </div>
@section PageScripts {
        <script>
            (function () {
                function getNextNumber($select) {
                    var lastNumber = $select.find('option:selected').data('lastnumber');
                    var parsed = parseInt(lastNumber);
                    return isNaN(parsed) ? null : parsed + 1;
                }

                function applyJournalFilter($bookyearSelect, $journalSelect) {
                    var selectedBookyear = $bookyearSelect.val();

                    $journalSelect.find('option').each(function () {
                        var $option = $(this);
                        var optionBookyear = $option.data('bookyear');
                        var isPlaceholder = $option.val() === '';
                        var visible = isPlaceholder || !selectedBookyear || (optionBookyear && optionBookyear.toString() === selectedBookyear.toString());

                        $option.prop('disabled', !visible);
                        $option.toggle(visible);
                    });

                    var selectedOption = $journalSelect.find('option:selected');
                    if (selectedOption.prop('disabled')) {
                        $journalSelect.val('');
                    }
                }

                function wireCreateForm() {
                    var $form = $('#sequence-create-form');
                    var $journal = $form.find('select[name="journalId"]');
                    var $startAt = $form.find('input[name="startAt"]');
                    var $bookyear = $form.find('select[name="bookyearId"]');

                    $bookyear.on('change', function () {
                        applyJournalFilter($bookyear, $journal);
                        $journal.trigger('change');
                    });

                    applyJournalFilter($bookyear, $journal);

                    $journal.on('change', function () {
                        var next = getNextNumber($(this));
                        if (next !== null) {
                            $startAt.val(next);
                        }
                    });
                }

                function wireExistingRows() {
                    var $table = $('table');

                    $table.find('tr').each(function () {
                        var $row = $(this);
                        var $bookyear = $row.find('select[name="bookyearId"]');
                        var $journal = $row.find('select[name="journalId"]');
                        if ($bookyear.length && $journal.length) {
                            applyJournalFilter($bookyear, $journal);
                        }
                    });

                    $table.on('change', 'select[name="bookyearId"]', function () {
                        var $row = $(this).closest('tr');
                        var $journal = $row.find('select[name="journalId"]');
                        applyJournalFilter($(this), $journal);
                        $journal.trigger('change');
                    });

                    $table.on('change', 'select[name="journalId"]', function () {
                        var next = getNextNumber($(this));
                        if (next === null) {
                            return;
                        }
                        var $row = $(this).closest('tr');
                        var $currentNumber = $row.find('input[name="currentNumber"]');
                        if ($currentNumber.length) {
                            $currentNumber.val(next);
                        }
                    });
                }

                $(function () {
                    wireCreateForm();
                    wireExistingRows();
                });
            })();
        </script>
}

