@model CPMCore.Models.Instellingen.BudgetPrijsReferentiesViewModel
@using BOCore.Budget
@using CPMCore.Models.GlV2
@*
    gl-v2 — Instellingen/Prijsreferenties verkoop (design-handoff punt 54a, "CRM Instellingen.dc.html"): tabbar Bouw/Grond met aantal; per tab één kaart met de codes gegroepeerd per
    project (Algemeen eerst), toevoegen als eerste rij van de tabel, en een ontbrekende bron gemarkeerd ("+ bron toevoegen"), want de bron maakt de prijs herleidbaar. Bewerken per rij
    (de rij wordt een formulier), archiveren of verwijderen (codes die in een budget gebruikt zijn kunnen enkel gearchiveerd worden, migratie 077).
    Dezelfde acties als voorheen (Create, Update, Archiveer, Delete, Export). Bewust anders dan het vorige ontwerp (38a): geen zoekveld, projectfilter of schakelaar "ouder dan
    12 maanden" meer; de groepering per project en de datum in goud (ouder dan 12 maanden) vervangen ze.
*@
@{
    ViewData["Title"] = "Prijsreferenties verkoop";
    ViewData["PageIcon"] = "ph ph-currency-eur";
    ViewData["GlV2FullHeightBody"] = true;
    ViewData["HelpScreenId"] = "instellingen-prijsreferenties";
    ViewData["BackUrl"] = Url.Action("Index", "Instellingen");
    var nlBE = new System.Globalization.CultureInfo("nl-BE");
    string Eur2(decimal v) => v.ToString("N2", nlBE);
    var projectItems = Model.Projecten.Select(p => new GlV2SelectItem { Value = p.ID.ToString(), Text = p.Display }).ToList();
    var startTab = Model.StartTab == "Grond" ? "Grond" : "Bouw";
    var tabs = new (string Key, string Label, string Noun, string Icon, string Basis, string Voorbeeld, int Count, int Volgende)[]
    {
        ("Bouw",  "Bouwprijscodes",  "bouwprijscode", "ph-buildings", "€/m² gereduceerde oppervlakte, volgens de wegingsconventie van tabblad Oppervlaktes", "Nieuwe bouwprijscode…", Model.Bouw.Count(),  Model.VolgendeCodeBouw),
        ("Grond", "Grondprijscodes", "grondprijscode", "ph-map-pin",   "€/m² grondoppervlakte van de eenheid",                                                    "Nieuwe grondprijscode…", Model.Grond.Count(), Model.VolgendeCodeGrond)
    };
}
@section PageStyle
{
    <link rel="stylesheet" href="~/css/gl-v2-instellingen-budgetreferenties.css" asp-append-version="true" />
}

<div class="gl-v2-bref" id="gl-v2-bref" data-start-tab="@startTab">
    <div class="gl-v2-tabbar" role="tablist">
        @foreach (var t in tabs)
        {
            <button type="button" class="gl-v2-tabbar-tab @(t.Key == startTab ? "is-active" : "")" role="tab" aria-selected="@(t.Key == startTab ? "true" : "false")" data-bref-tab="@t.Key">
                @t.Label <span class="gl-v2-tabbar-count" data-bref-count="@t.Key">@t.Count</span>
            </button>
        }
    </div>

    <div class="gl-v2-bref-scroll">
        @foreach (var t in tabs)
        {
            var letter = t.Key == "Grond" ? "G" : "B";
            var rows = (t.Key == "Grond" ? Model.Grond : Model.Bouw).ToList();
            var zonderBron = rows.Count(r => !r.Gearchiveerd && string.IsNullOrWhiteSpace(r.Bron));
            // Algemeen eerst, daarna de projecten op naam; binnen een groep blijft de volgorde van de lijst.
            var groepen = rows.GroupBy(r => r.ProjectId).OrderBy(g => g.Key.HasValue ? 1 : 0).ThenBy(g => g.First().ProjectNaam ?? "", StringComparer.CurrentCultureIgnoreCase).ToList();
            <div class="gl-v2-tab-panel" data-tab-panel="@t.Key" @(t.Key == startTab ? "" : "hidden")>
                <span class="gl-v2-bref-intro">Prijs per m² op stap 8 van de budgetwizard. Basis: @t.Basis. Algemene codes gelden voor elk project; een code met project is enkel daar zichtbaar.@if (zonderBron > 0) { <text> </text><span class="gl-v2-badge is-attention">@zonderBron zonder bron</span> }</span>

                <section class="gl-v2-section-card" data-bref-list="@t.Key">
                    <div class="gl-v2-section-card-header">
                        <span class="gl-v2-section-card-icon"><i class="ph @t.Icon" aria-hidden="true"></i></span>
                        <h2 class="gl-v2-section-card-title">@t.Label</h2>
                        <span class="gl-v2-field-divider"></span>
                        <span class="gl-v2-section-card-desc">@(rows.Count == 0 ? "nog geen codes" : $"{rows.Count} code{(rows.Count == 1 ? "" : "s")}")</span>
                        <span class="gl-v2-section-card-meta" style="margin-left:auto">
                            <a href="@Url.Action("BudgetPrijsReferentiesExport", "Instellingen", new { prijsType = t.Key })" class="gl-v2-btn gl-v2-btn-secondary"><i class="ph ph-download-simple" aria-hidden="true"></i>Exporteren</a>
                        </span>
                    </div>
                    <div class="gl-v2-list-head gl-v2-bref-head gl-v2-bref-grid--prijs">
                        <span>Code</span><span>Omschrijving</span><span class="gl-v2-bref-right">Prijs per m²</span><span>Datum</span><span>Bron</span><span>Project</span><span></span>
                    </div>

                    @* ── Toevoegen: de eerste rij van de tabel ── *@
                    <form method="post" asp-action="BudgetPrijsReferentieCreate" asp-controller="Instellingen" class="gl-v2-bref-row gl-v2-bref-grid--prijs is-add" autocomplete="off">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="PrijsType" value="@t.Key" />
                        <div class="gl-v2-field"><div class="gl-v2-field-box"><span class="gl-v2-bref-code-prefix">@letter-</span><span class="gl-v2-field-divider"></span><input type="text" inputmode="numeric" pattern="[0-9]*" id="bref-@t.Key-code" name="Code" class="gl-v2-field-input is-tabular" value="@t.Volgende" required aria-label="Code" /></div></div>
                        <div class="gl-v2-field"><div class="gl-v2-field-box"><input type="text" id="bref-@t.Key-oms" name="Omschrijving" class="gl-v2-field-input" placeholder="@t.Voorbeeld" maxlength="200" aria-label="Omschrijving" /></div></div>
                        <div class="gl-v2-field"><div class="gl-v2-field-box"><input type="text" inputmode="decimal" id="bref-@t.Key-prijs" name="PrijsPerM2" class="gl-v2-field-input is-tabular" placeholder="€ 0,00" required aria-label="Prijs per m²" /><span class="gl-v2-field-unit">€/m²</span></div></div>
                        <div class="gl-v2-field">@await Html.PartialAsync("GlV2/_DateField", new GlV2DateFieldVm { Name = "Datum", Id = "bref-" + t.Key + "-datum", Label = "Datum", IsoValue = DateTime.Today.ToString("yyyy-MM-dd"), DisplayValue = DateTime.Today.ToString("dd/MM/yyyy") })</div>
                        <div class="gl-v2-field"><div class="gl-v2-field-box"><input type="text" id="bref-@t.Key-bron" name="Bron" class="gl-v2-field-input" placeholder="verkoop, schatting, markt…" maxlength="200" aria-label="Bron" /></div></div>
                        <div class="gl-v2-field">@await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm { Name = "ProjectId", Id = "bref-" + t.Key + "-project", Value = "", EmptyText = "Algemeen", Bare = true, Items = projectItems, Placeholder = "Algemeen" })</div>
                        <div class="gl-v2-bref-actions"><button type="submit" class="gl-v2-btn gl-v2-btn-primary">Toevoegen</button></div>
                    </form>

                    @* ── Groepen: Algemeen eerst ── *@
                    <div data-bref-rows>
                        @if (!groepen.Any(g => !g.Key.HasValue))
                        {
                            <div class="gl-v2-bref-group"><span>Alle projecten</span><span class="c">0</span></div>
                            <div class="gl-v2-bref-nogroup">Nog geen algemene codes. Die gelden meteen voor elk nieuw project.</div>
                        }
                        @foreach (var g in groepen)
                        {
                            <div class="gl-v2-bref-group">
                                @if (g.Key.HasValue) { <span>Project</span><span class="n">@g.First().ProjectNaam</span> } else { <span>Alle projecten</span> }
                                <span class="c">@g.Count()</span>
                            </div>
                            @foreach (var r in g)
                            {
                                <div class="gl-v2-bref-row gl-v2-listrow gl-v2-bref-grid--prijs @(r.Gearchiveerd ? "is-archived" : "")" data-bref-row>
                                    <span class="gl-v2-bref-mono">@r.CodeLabel</span>
                                    <span class="gl-v2-bref-strong" title="@r.Omschrijving">@(string.IsNullOrWhiteSpace(r.Omschrijving) ? "—" : r.Omschrijving)</span>
                                    <span class="gl-v2-bref-num">€ @Eur2(r.PrijsPerM2) <small>/m²</small></span>
                                    <span class="gl-v2-bref-cell @(r.IsOuderDan12Maanden && !r.Gearchiveerd ? "gl-v2-bref-oud" : "")" title="@(r.IsOuderDan12Maanden ? (r.Datum.HasValue ? "Datum ouder dan 12 maanden" : "Geen datum") : "")">@(r.Datum?.ToString("dd/MM/yyyy") ?? "—")</span>
                                    @if (string.IsNullOrWhiteSpace(r.Bron))
                                    {
                                        <button type="button" class="gl-v2-bref-add-bron" data-bref-bron title="Zonder bron is de prijs niet te herleiden">+ bron toevoegen</button>
                                    }
                                    else
                                    {
                                        <span class="gl-v2-bref-cell is-muted" title="@r.Bron">@r.Bron</span>
                                    }
                                    @if (r.Gearchiveerd)
                                    {
                                        <span class="gl-v2-badge is-inactive" title="Niet meer kiesbaar op stap 8">Gearchiveerd</span>
                                    }
                                    else
                                    {
                                        <span></span>
                                    }
                                    <div class="gl-v2-bref-actions"><span class="gl-v2-rowact"><span class="gl-v2-rowact-btns">
                                        <button type="button" class="gl-v2-icon-btn" data-bref-edit title="Bewerken" aria-label="Bewerken"><i class="ph ph-pencil-simple" aria-hidden="true"></i></button>
                                        @if (r.IsInGebruik || r.Gearchiveerd)
                                        {
                                            <form method="post" asp-action="BudgetPrijsReferentieArchiveer" asp-controller="Instellingen">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@r.Id" /><input type="hidden" name="prijsType" value="@t.Key" /><input type="hidden" name="gearchiveerd" value="@(r.Gearchiveerd ? "false" : "true")" />
                                                <button type="submit" class="gl-v2-icon-btn" title="@(r.Gearchiveerd ? "Herstellen (opnieuw kiesbaar op stap 8)" : "Archiveren — in gebruik in een budget, dus niet verwijderbaar")" aria-label="@(r.Gearchiveerd ? "Herstellen" : "Archiveren")">
                                                    <i class="ph @(r.Gearchiveerd ? "ph-arrow-counter-clockwise" : "ph-archive")" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post" asp-action="BudgetPrijsReferentieDelete" asp-controller="Instellingen" data-bv-titel="Code @r.CodeLabel verwijderen?" data-bv-tekst="De €/m² die al op verkooplijnen staat, blijft daar staan." data-bv-ok="Verwijderen" data-bv-tone="danger" data-bv-icon="ph-trash">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@r.Id" /><input type="hidden" name="prijsType" value="@t.Key" />
                                                <button type="submit" class="gl-v2-icon-btn is-danger" title="Verwijderen" aria-label="Verwijderen"><i class="ph ph-trash" aria-hidden="true"></i></button>
                                            </form>
                                        }
                                    </span></span></div>
                                </div>
                                @* Dezelfde rij in bewerking: zelfde kolommen, velden i.p.v. tekst, opslaan/annuleren rechts. *@
                                <form method="post" asp-action="BudgetPrijsReferentieUpdate" asp-controller="Instellingen" class="gl-v2-bref-row gl-v2-bref-grid--prijs is-edit" data-bref-editrow hidden autocomplete="off">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@r.Id" /><input type="hidden" name="PrijsType" value="@t.Key" />
                                    <div class="gl-v2-field"><div class="gl-v2-field-box"><span class="gl-v2-bref-code-prefix">@letter-</span><span class="gl-v2-field-divider"></span><input type="text" inputmode="numeric" name="Code" class="gl-v2-field-input is-tabular" value="@r.Code" required aria-label="Code" /></div></div>
                                    <div class="gl-v2-field"><div class="gl-v2-field-box"><input type="text" name="Omschrijving" class="gl-v2-field-input" value="@r.Omschrijving" maxlength="200" aria-label="Omschrijving" /></div></div>
                                    <div class="gl-v2-field"><div class="gl-v2-field-box"><input type="text" inputmode="decimal" name="PrijsPerM2" class="gl-v2-field-input is-tabular" value="@r.PrijsPerM2.ToString("0.00", nlBE)" required aria-label="Prijs per m²" /><span class="gl-v2-field-unit">€/m²</span></div></div>
                                    <div class="gl-v2-field">@await Html.PartialAsync("GlV2/_DateField", new GlV2DateFieldVm { Name = "Datum", Id = "bref-edit-" + r.Id + "-datum", Label = "Datum", IsoValue = r.Datum?.ToString("yyyy-MM-dd") ?? "", DisplayValue = r.Datum?.ToString("dd/MM/yyyy") ?? "" })</div>
                                    <div class="gl-v2-field"><div class="gl-v2-field-box"><input type="text" name="Bron" class="gl-v2-field-input" value="@r.Bron" maxlength="200" placeholder="verkoop, schatting, markt…" aria-label="Bron" /></div></div>
                                    <div class="gl-v2-field">@await Html.PartialAsync("GlV2/_SelectList", new GlV2SelectListVm { Name = "ProjectId", Id = "bref-edit-" + r.Id + "-project", Value = r.ProjectId?.ToString() ?? "", EmptyText = "Algemeen", Bare = true, Items = projectItems })</div>
                                    <div class="gl-v2-bref-actions">
                                        <button type="submit" class="gl-v2-row-action gl-v2-row-action-primary" title="Opslaan" aria-label="Opslaan"><i class="ph ph-check" aria-hidden="true"></i><span class="gl-v2-row-action-label">Opslaan</span></button>
                                        <button type="button" class="gl-v2-row-action" data-bref-cancel title="Annuleren" aria-label="Annuleren"><i class="ph ph-x" aria-hidden="true"></i><span class="gl-v2-row-action-label">Annuleren</span></button>
                                    </div>
                                </form>
                            }
                        }
                    </div>
                    <div class="gl-v2-bref-foot">
                        <div class="gl-v2-notice gl-v2-notice-compact is-info">
                            <i class="ph ph-info" aria-hidden="true"></i>
                            <span>Archiveren verbergt een code in nieuwe budgetten; bestaande budgetten behouden hun prijs. Een code die in een budget gebruikt is, kan je enkel archiveren.</span>
                        </div>
                    </div>
                </section>
            </div>
        }
    </div>
</div>

@section PageScripts
{
<script>
(function () {
    var root = document.getElementById('gl-v2-bref');
    if (!root) return;

    // Tabs (zelfde gedrag als IssuerCompaniesEditV2: panelen tonen/verbergen, niets herladen)
    root.querySelectorAll('[data-bref-tab]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var key = btn.getAttribute('data-bref-tab');
            root.querySelectorAll('[data-bref-tab]').forEach(function (b) { var on = b === btn; b.classList.toggle('is-active', on); b.setAttribute('aria-selected', on ? 'true' : 'false'); });
            root.querySelectorAll('[data-tab-panel]').forEach(function (p) { p.hidden = p.getAttribute('data-tab-panel') !== key; });
            try { history.replaceState(null, '', '?tab=' + key); } catch (e) { }
        });
    });

    // Rij bewerken: de weergaverij wisselt met de formulierrij eronder; "+ bron toevoegen" opent dezelfde rij op het bronveld.
    root.querySelectorAll('[data-bref-list]').forEach(function (list) {
        function openRij(row, focusNaam) {
            var form = row.nextElementSibling;
            list.querySelectorAll('[data-bref-editrow]:not([hidden])').forEach(function (f) { f.hidden = true; f.previousElementSibling.hidden = false; });
            row.hidden = true; form.hidden = false;
            var first = form.querySelector('input[name="' + focusNaam + '"]'); if (first) first.focus();
        }
        list.addEventListener('click', function (e) {
            var edit = e.target.closest('[data-bref-edit]');
            if (edit) openRij(edit.closest('[data-bref-row]'), 'Omschrijving');
            var bron = e.target.closest('[data-bref-bron]');
            if (bron) openRij(bron.closest('[data-bref-row]'), 'Bron');
            var cancel = e.target.closest('[data-bref-cancel]');
            if (cancel) { var form2 = cancel.closest('[data-bref-editrow]'); form2.hidden = true; form2.previousElementSibling.hidden = false; }
        });
    });
})();
</script>
}

@await Html.PartialAsync("GlV2/_BevestigModal")
