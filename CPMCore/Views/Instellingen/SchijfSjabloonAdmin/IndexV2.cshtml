@using BOCore
@using FacadeCore
@model List<SchijfSjabloonBeheerRij>
@inject IPermissionService PermissionService
@*
    gl-v2 — Instellingen › Sjablonen › Schijven: de lijst (design-handoff 66a). Een sjabloon is een standaardlijst betalingsschijven. Toepassen doe je in het scherm van een betalingsgroep of via een
    projectsjabloon. Kolommen: naam + omschrijving, schijven (· per verdieping), vast, enkel bij (kelder, dak), gebruikt in (projectsjablonen), gewijzigd (datum · voornaam), status, ⋯.
    Het ⋯-menu is het gedeelde .gl-v2-menu#sj-lijst-menu, gevuld door gl-v2-instellingen-sjablonen-lijst.js; de acties sturen verborgen formulieren door met requestSubmit()
    zodat de bevestigingsmodal (data-bv-*) werkt. Verwijderen kan enkel als geen projectsjabloon het gebruikt.
*@
@{
    ViewData["Title"] = "Schijvensjablonen";
    ViewData["PageIcon"] = "ph ph-list-checks";
    ViewData["HelpScreenId"] = "instellingen-schijvensjablonen";
    ViewData["BackUrl"] = Url.Action("Index", "Instellingen");
    var canWrite = PermissionService.HasWrite(PermissionCodes.SettingsPlanningSjablonen);
    var canDelete = PermissionService.HasDelete(PermissionCodes.SettingsPlanningSjablonen);
    var nl = new System.Globalization.CultureInfo("nl-BE");
}
@section PageStyle
{
    <link rel="stylesheet" href="~/css/gl-v2-instellingen-automatisatie.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-instellingen-sjabloontabs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-instellingen-schijvensjabloon.css" asp-append-version="true" />
}
@section PageActions
{
    @if (canWrite)
    {
        <a href="@Url.Action("Nieuw")" class="gl-v2-btn gl-v2-btn-primary"><i class="ph ph-plus" aria-hidden="true"></i>Nieuw sjabloon</a>
    }
}

<div class="gl-v2-auto gl-v2-sjs-lijst">
    @await Html.PartialAsync("GlV2/_SjabloonTabs", "schijven")

    <div class="gl-v2-notice gl-v2-notice-compact">
        <i class="ph ph-info" aria-hidden="true"></i>
        <span>Een schijvensjabloon is een standaardlijst betalingsschijven. Je past het toe in <b>Projecten › Betalingsschijven › Groep bewerken › Sjabloon toepassen</b> of via een projectsjabloon. Je ziet eerst het voorstel en kan elk percentage nog aanpassen.</span>
    </div>

    <section class="gl-v2-section-card">
        @if (Model.Count == 0)
        {
            <div class="gl-v2-blank gl-v2-auto-none is-big">
                <i class="ph ph-list-checks" aria-hidden="true"></i><b>Nog geen schijvensjablonen</b>
                <span>Bouw je telkens dezelfde woning, maak dan een sjabloon met de schijven die je gewoon bent.</span>
            </div>
        }
        else
        {
            <div class="gl-v2-auto-head gl-v2-auto-grid--sjs"><span>Naam</span><span>Schijven</span><span>Vast</span><span>Enkel bij</span><span>Gebruikt in</span><span>Gewijzigd</span><span>Status</span><span></span></div>
            @foreach (var s in Model)
            {
                var gebruikt = s.GebruiktIn.Count;
                <div class="gl-v2-auto-row gl-v2-auto-grid--sjs gl-v2-listrow @(s.IsActief ? "" : "is-muted-row")" data-row-href="@Url.Action("Bewerken", new { id = s.Id })" data-id="@s.Id" data-naam="@s.Naam" data-actief="@(s.IsActief ? "1" : "0")" data-gebruikt="@gebruikt">
                    <a class="gl-v2-auto-who gl-v2-sjs-wie" href="@Url.Action("Bewerken", new { id = s.Id })"><span class="t">@s.Naam</span>@if (!string.IsNullOrWhiteSpace(s.Beschrijving)) { <span class="o">@s.Beschrijving</span> } else { <span class="o is-leeg">geen omschrijving</span> }</a>
                    <span class="gl-v2-auto-cell">@s.AantalSchijven@if (s.AantalPerVerdieping > 0) { <span class="gl-v2-sjs-verd"> · @s.AantalPerVerdieping per verdieping</span> }</span>
                    <span class="gl-v2-auto-cell is-muted gl-v2-sjs-meer">@(string.IsNullOrEmpty(s.VastSamenvatting) ? "—" : s.VastSamenvatting)</span>
                    <span class="gl-v2-auto-cell is-muted gl-v2-sjs-meer">@(string.IsNullOrEmpty(s.EnkelBij) ? "—" : s.EnkelBij)</span>
                    <span class="gl-v2-auto-cell is-muted gl-v2-sjs-meer">@if (gebruikt > 0) { <text>Projectsjabloon @string.Join(", ", s.GebruiktIn.Take(2))@(gebruikt > 2 ? $" +{gebruikt - 2}" : "")</text> } else { <text>—</text> }</span>
                    <span class="gl-v2-auto-cell is-muted">@(s.GewijzigdOp?.ToLocalTime().ToString("dd/MM/yyyy", nl))@(string.IsNullOrEmpty(s.GewijzigdDoor) ? "" : " · " + s.GewijzigdDoor)</span>
                    <span><span class="gl-v2-badge @(s.IsActief ? "is-positive" : "is-inactive")">@(s.IsActief ? "Actief" : "Inactief")</span></span>
                    <span class="gl-v2-auto-acts"><span class="gl-v2-rowact">
                        <i class="ph ph-caret-right gl-v2-rowact-chev" aria-hidden="true"></i>
                        <span class="gl-v2-rowact-btns">
                            <button type="button" class="gl-v2-icon-btn js-gl-v2-menu-trigger" aria-haspopup="true" aria-expanded="false" aria-controls="sj-lijst-menu" aria-label="Acties voor @s.Naam" title="Meer acties"><i class="ph ph-dots-three" aria-hidden="true"></i></button>
                        </span>
                    </span></span>
                    @if (canWrite)
                    {
                        <form method="post" action="@Url.Action("Dupliceren", new { id = s.Id })" class="gl-v2-sjs-vorm" data-actie="dupliceer">@Html.AntiForgeryToken()</form>
                        <form method="post" action="@Url.Action("Actief", new { id = s.Id, actief = !s.IsActief })" class="gl-v2-sjs-vorm" data-actie="actief">@Html.AntiForgeryToken()</form>
                    }
                    @if (canDelete && gebruikt == 0)
                    {
                        <form method="post" action="@Url.Action("Verwijderen", new { id = s.Id })" class="gl-v2-sjs-vorm" data-actie="verwijder" data-bv-titel="Sjabloon verwijderen?" data-bv-tekst="Sjabloon “@s.Naam” verwijderen? Betalingsgroepen die het al gebruikten houden hun schijven. Dit kan je niet ongedaan maken." data-bv-ok="Verwijderen" data-bv-tone="danger" data-bv-icon="ph-trash">@Html.AntiForgeryToken()</form>
                    }
                </div>
            }
            <div class="gl-v2-auto-foot">@Model.Count @(Model.Count == 1 ? "sjabloon" : "sjablonen") · ⋯ = bewerken, dupliceren, inactief zetten of verwijderen (enkel als het nergens gebruikt is)</div>
        }
    </section>
</div>

<div class="gl-v2-menu" id="sj-lijst-menu" role="menu" aria-label="Acties voor dit sjabloon"></div>

@await Html.PartialAsync("GlV2/_BevestigModal")

@section PageScripts
{
    <script>window.SjLijst = { canWrite: @(canWrite ? "true" : "false"), canDelete: @(canDelete ? "true" : "false") };</script>
    <script src="~/js/gl-v2-instellingen-sjablonen-lijst.js" asp-append-version="true"></script>
}
