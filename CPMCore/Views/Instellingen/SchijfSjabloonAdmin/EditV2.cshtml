@using System.Text.Json
@using BOCore
@using FacadeCore
@model SchijfSjabloonBewerk
@inject IPermissionService PermissionService
@inject IBouwstaatService Bouwstaten
@*
    gl-v2 — Instellingen › Sjablonen › Schijven › bewerken (design-handoff 66b, herwerkt 24/11/2026 naar "jouw scherm, werkend"). Tabs Sjablonen bovenaan. Links: de kop (naam, omschrijving, minimum, actief) en de schijven als rijen met per schijf Gewicht of Vast % (soort),
    de waarde, per verdieping, enkel bij (kelder, dak) en een kolom Voorbeeld; onder elke schijf een tweede regel "Wacht op" (bouwstaat + gestart/voltooid); bovenaan de regel die het uitrekent ("vast 5 % · 95 % over gewicht 7 = 13,57 % per gewicht").
    Rechts: een voorbeeldpaneel (bouwlagen, kelder, constructiewaarde → alle schijven met % en €), de controle en waar het sjabloon gebruikt wordt. "Code in planning" wordt gecontroleerd
    tegen de codes van de actieve planningssjablonen (ViewData["PlanningCodes"]). Volgorde = sleepgreep of ⋯-menu; verwijderen zit in ⋯. De laatste schijf is de eindafrekening.
    Het document gaat als één JSON naar Opslaan (SchijfSjabloonService.Bewaar valideert). Logica en het uitrekenen (zelfde regels als SchijfSjabloonUitrol): wwwroot/js/gl-v2-instellingen-schijvensjabloon.js.
*@
@{
    var isNieuw = Model.Id == 0;
    ViewData["Title"] = isNieuw ? "Nieuw sjabloon" : Model.Naam;
    ViewData["PageIcon"] = "ph ph-list-checks";
    ViewData["HelpScreenId"] = "instellingen-schijvensjablonen-bewerken";
    ViewData["BackUrl"] = Url.Action("Index");
    var canWrite = PermissionService.HasWrite(PermissionCodes.SettingsPlanningSjablonen);
    var codes = (ViewData["PlanningCodes"] as List<PlanningCodeInfo>) ?? new List<PlanningCodeInfo>();
    var gebruiktIn = (ViewData["GebruiktIn"] as List<string>) ?? new List<string>();
    var keuzes = await Bouwstaten.Keuzes();
    var data = new
    {
        id = Model.Id, naam = Model.Naam, beschrijving = Model.Beschrijving ?? "", minimum = Model.MinimumPercentage, isActief = isNieuw ? true : Model.IsActief,
        schijven = Model.Schijven.Select(s => new { naam = s.Naam, code = s.PlanningCode ?? "", vast = s.VastPercentage, gewicht = s.Gewicht, perVerdieping = s.PerVerdieping, bouwstaatId = s.BouwstaatId, bouwstaatRegel = s.BouwstaatRegel, voorwaarde = string.IsNullOrWhiteSpace(s.VoorwaardeVariabele) ? "" : s.VoorwaardeVariabele + ":" + s.VoorwaardeWaarde }),
        planningCodes = codes.Select(c => new { code = c.Code, naam = c.Naam, sjabloon = c.Sjabloon }),
        bouwstaten = keuzes.Bouwstaten.Select(b => new { id = b.Id, naam = b.Naam, groep = b.Groep, isActief = b.IsActief }),
    };
}
@section PageStyle
{
    <link rel="stylesheet" href="~/css/gl-v2-instellingen-automatisatie.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-instellingen-sjabloontabs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gl-v2-instellingen-schijvensjabloon.css" asp-append-version="true" />
}
@section PageTitleBadges
{
    <span class="gl-v2-badge is-attention" id="sjs-dirty" hidden>NIET-OPGESLAGEN WIJZIGINGEN</span>
}
@section PageActions
{
    <a href="@Url.Action("Index")" class="gl-v2-btn gl-v2-btn-text" id="sjs-annuleren">Annuleren</a>
    @if (canWrite)
    {
        <button type="button" class="gl-v2-btn gl-v2-btn-primary" id="sjs-opslaan"><i class="ph ph-floppy-disk" aria-hidden="true"></i>Sjabloon opslaan</button>
    }
}

@Html.AntiForgeryToken()
<div class="gl-v2-sjs" id="sjs-root" data-can-write="@(canWrite ? "1" : "0")" data-opslaan-url="@Url.Action("Opslaan")" data-lijst-url="@Url.Action("Index")">
    <div class="gl-v2-inline-error gl-v2-sjs-fouten" id="sjs-fouten" role="alert" hidden>
        <span class="gl-v2-inline-error-icon"><i class="ph ph-warning-circle" aria-hidden="true"></i></span>
        <div class="gl-v2-inline-error-text">
            <div class="gl-v2-inline-error-title">Het sjabloon is nog niet bewaard</div>
            <ul class="gl-v2-inline-error-desc gl-v2-sjs-foutlijst" id="sjs-fouten-lijst"></ul>
        </div>
        <button type="button" class="gl-v2-inline-error-close" id="sjs-fouten-close" aria-label="Melding sluiten"><i class="ph ph-x" aria-hidden="true"></i></button>
    </div>

    @await Html.PartialAsync("GlV2/_SjabloonTabs", "schijven")

    <div class="gl-v2-sjs-grid">
        <div class="gl-v2-sjs-links">
            <section class="gl-v2-section-card gl-v2-sjs-kopkaart">
                <div class="gl-v2-field">
                    <label class="gl-v2-field-label" for="sjs-naam">Naam <span class="gl-v2-field-req" aria-hidden="true">*</span></label>
                    <div class="gl-v2-field-box"><input type="text" id="sjs-naam" class="gl-v2-field-input" maxlength="200" /></div>
                </div>
                <div class="gl-v2-field">
                    <label class="gl-v2-field-label" for="sjs-beschrijving">Korte omschrijving</label>
                    <div class="gl-v2-field-box"><input type="text" id="sjs-beschrijving" class="gl-v2-field-input" maxlength="1000" /></div>
                </div>
                <div class="gl-v2-field">
                    <label class="gl-v2-field-label" for="sjs-minimum">Minimum per schijf</label>
                    <div class="gl-v2-field-box"><input type="text" id="sjs-minimum" class="gl-v2-field-input is-tabular" inputmode="decimal" autocomplete="off" /><span class="gl-v2-field-suffix">%</span></div>
                    <span class="gl-v2-field-help">lager = waarschuwing bij toepassen</span>
                </div>
                <label class="gl-v2-toggle-row gl-v2-sjs-actief" for="sjs-actief"><input type="checkbox" id="sjs-actief" class="gl-v2-toggle-switch" /><span class="gl-v2-toggle-text"><span class="gl-v2-toggle-label">Actief</span><span class="gl-v2-toggle-desc">enkel actieve sjablonen kan je toepassen</span></span></label>
            </section>

            <section class="gl-v2-section-card gl-v2-sjs-schijven">
                <header class="gl-v2-sjs-schijven-kop">
                    <h2 class="gl-v2-section-card-title">Schijven</h2>
                    <span class="gl-v2-sjs-sub">In volgorde van de werf. Elke schijf krijgt een vast percentage of een gewicht en wacht op een bouwstaat uit de planning.</span>
                </header>
                <div class="gl-v2-sjs-regel" id="sjs-regel" role="status" aria-live="polite"></div>

                <div class="gl-v2-sjs-tabelkop" aria-hidden="true">
                    <span></span><span>#</span><span>Omschrijving op factuur · Wacht op (bouwstaat)</span><span>Soort</span><span class="r">Waarde</span><span>Per verd.</span><span>Enkel bij</span><span class="r">Voorbeeld</span><span></span>
                </div>
                <ol class="gl-v2-sjs-rijen" id="sjs-rijen"></ol>
                <div class="gl-v2-sjs-toevoegbalk">
                    <button type="button" class="gl-v2-btn gl-v2-btn-secondary" id="sjs-toevoegen"><i class="ph ph-plus" aria-hidden="true"></i>Schijf toevoegen</button>
                    <span class="gl-v2-sjs-tip">Grijze rijen komen niet voor bij het voorbeeldgebouw rechts. Een variant (met/zonder kelder, plat/hellend dak) maak je met ⋯ › Dupliceren.</span>
                </div>
            </section>
        </div>

        <aside class="gl-v2-sjs-rechts" aria-label="Voorbeeld en controle">
            <section class="gl-v2-section-card gl-v2-sjs-paneel">
                <header class="gl-v2-sjs-paneelkop"><h2 class="gl-v2-section-card-title">Voorbeeld</h2><span class="gl-v2-sjs-sub">zo ziet het eruit op een gebouw</span></header>
                <div class="gl-v2-sjs-vragen">
                    <div class="gl-v2-sjs-vraag"><span>Bouwlagen</span><div class="gl-v2-segmented is-sm" id="sjs-verd" role="group" aria-label="Aantal bouwlagen"></div></div>
                    <div class="gl-v2-sjs-vraag"><span>Kelder</span><div class="gl-v2-segmented is-sm" id="sjs-kelder" role="group" aria-label="Kelder"><button type="button" data-v="ja">ja</button><button type="button" data-v="nee" class="is-active">nee</button></div></div>
                    <div class="gl-v2-sjs-vraag"><span>Dak</span><div class="gl-v2-segmented is-sm" id="sjs-dak" role="group" aria-label="Dak"><button type="button" data-v="" class="is-active">geen</button><button type="button" data-v="hellend">hellend</button><button type="button" data-v="plat">plat</button></div></div>
                    <div class="gl-v2-sjs-vraag"><span>Constructiewaarde</span><div class="gl-v2-field-box gl-v2-sjs-euro"><span class="gl-v2-field-prefix">€</span><input type="text" id="sjs-waarde" class="gl-v2-field-input is-tabular" inputmode="numeric" autocomplete="off" value="300.000" aria-label="Constructiewaarde in euro" /></div></div>
                </div>
                <ol class="gl-v2-sjs-uitrol" id="sjs-uitrol"></ol>
                <div class="gl-v2-sjs-totaal" id="sjs-totaal"></div>
            </section>

            <section class="gl-v2-section-card gl-v2-sjs-paneel">
                <header class="gl-v2-sjs-paneelkop"><h2 class="gl-v2-section-card-title">Controle</h2><span class="gl-v2-sjs-sub" id="sjs-controle-n"></span></header>
                <div class="gl-v2-sjs-controle" id="sjs-controle"></div>
            </section>

            <section class="gl-v2-section-card gl-v2-sjs-paneel">
                <header class="gl-v2-sjs-paneelkop"><h2 class="gl-v2-section-card-title">Gebruikt in</h2><span class="gl-v2-sjs-sub">wijzigen geldt enkel voor nieuwe toepassingen</span></header>
                @if (gebruiktIn.Count == 0)
                {
                    <p class="gl-v2-sjs-leeg">Nog op geen enkel project toegepast.</p>
                }
                else
                {
                    <ul class="gl-v2-sjs-gebruik">@foreach (var g in gebruiktIn) { <li><i class="ph ph-buildings" aria-hidden="true"></i>Projectsjabloon <b>@g</b></li> }</ul>
                }
            </section>
        </aside>
    </div>
</div>

<div class="gl-v2-menu" id="sjs-rijmenu" role="menu" aria-label="Acties voor deze schijf"></div>

@section PageScripts
{
    <script id="sjs-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(data, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
    <script src="~/js/gl-v2-instellingen-schijvensjabloon.js" asp-append-version="true"></script>
}
