@model CPMCore.Models.PermissionEditViewModel

<section class="card">
    <header class="card-header">
        <h2 class="card-title">@ViewData["Title"]</h2>
    </header>
    <div class="card-body">
        @using (Html.BeginForm("Create", "AppRoles", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="row mb-3">
                <label class="col-sm-3 col-form-label text-sm-end">@Html.DisplayNameFor(m => m.Name)</label>
                <div class="col-sm-9">
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="text-end">
                <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Annuleren</a>
                <button type="submit" class="btn btn-primary">Opslaan</button>
            </div>
        }
    </div>
</section>