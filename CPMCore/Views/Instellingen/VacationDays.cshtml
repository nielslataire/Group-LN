@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@model CPMCore.Models.Home.HomeModel

@{
	ViewData["Title"] = "Instellingen - Verlofdagen";
}

@section PageStyle
{
@* 	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.css"> *@
    <style>
        /* Weekend donkergrijs + dagnummer wit */
        .fc .fc-daygrid-day.fc-day-sat .fc-daygrid-day-frame,
        .fc .fc-daygrid-day.fc-day-sun .fc-daygrid-day-frame {
            background: #999999;
        }

        .fc .fc-daygrid-day.fc-day-sat .fc-daygrid-day-number,
        .fc .fc-daygrid-day.fc-day-sun .fc-daygrid-day-number {
            color: #CCCCCC;
        }

        /* Dagnummer op 'verlofdag' ook wit (2 opties) */

        /* Optie A: moderne browsers, werkt met :has() */
        .fc .fc-daygrid-day:has(.fc-bg-event) .fc-daygrid-day-number {
            color: #CCCCCC;
        }

        /* Optie B: fallback via JS-class .has-vacation (zie JS hieronder) */
        .fc .fc-daygrid-day.has-vacation .fc-daygrid-day-number {
            color: #CCCCCC;
        }
        /* Volledig klikgedrag uit voor weekendcellen */
        .fc .fc-daygrid-day.fc-day-sat,
        .fc .fc-daygrid-day.fc-day-sun {
            pointer-events: none;

        }

        .fc .fc-daygrid-event {
            border-radius: 6px;
            padding: 0 6px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    </style>
}

@section PageScripts
{
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar/core@6.1.19/locales-all.global.min.js"></script>
        <script>
        document.addEventListener('DOMContentLoaded', function () {
          const el = document.getElementById('vacationcalendar');
          const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

          const cal = new FullCalendar.Calendar(el, {
            initialView: 'multiMonthYear',
            locale: 'nl',
            firstDay: 1,
            height: 'auto',

            // 2 rijen × 6 kolommen
            monthCount: 12,
            multiMonthMaxColumns: 6,
            multiMonthMinWidth: 120, // verlaag indien je container smaller is

            // Header: alleen pijlen en titel (jaar) in het midden
            headerToolbar: { left: 'prev', center: 'title', right: 'next' },
            buttonText: { prev: '‹', next: '›' },

            // Weekends herkenbaar (class toegevoegd; styling via CSS hierboven)
            dayCellDidMount: (arg) => {
              const dow = arg.date.getDay();
              if (dow === 0 || dow === 6) arg.el.classList.add('fc-disabled-weekend');
            },

            // Klikken op weekends blokkeren (extra guard)
            dateClick: async (info) => {
              const dow = info.date.getDay();
              if (dow === 0 || dow === 6) return;

              const dateStr = info.dateStr; // 'YYYY-MM-DD' (allDay safe)
              const existing = cal.getEvents().find(ev =>
                ev.extendedProps.isVacation && ev.startStr === dateStr
              );

              try {
                if (existing) {
                  // Verwijderen
                  await $.post('@Url.Action("DeleteVacationDay", "Instellingen")', {
                    id: existing.id,
                    __RequestVerificationToken: token
                  });
                  existing.remove();
                } else {
                  // Toevoegen
                  const newId = await $.post('@Url.Action("AddVacationDay", "Instellingen")', {
                    dag: dateStr,
                    __RequestVerificationToken: token
                  });
                  cal.addEvent({
                    id: newId,                // server retourneert het nieuwe id
                    start: dateStr,
                    end: dateStr,
                    allDay: true,
                    color: '#009336',
                    title: 'V',
                    textColor: '#ffffff', // KLEUR van de tekst "verlofdag"
                    extendedProps: { isVacation: true }
                  });
                }
              } catch (e) {
                alert('Opslaan/verwijderen mislukt.');
              }
            },

            // Initieel laden van verlofdagen
            eventSources: [
              async (fetchInfo, success, failure) => {
                try {
                  const resp = await $.getJSON('@Url.Action("GetVacationDays", "Instellingen")');
                  const events = resp.map(d => {
                    const dstr = `${d.year}-${String(d.month).padStart(2,'0')}-${String(d.day).padStart(2,'0')}`;
                    return {
                      id: d.id,
                      start: dstr,
                      end: dstr,
                      allDay: true,
                    color: '#009336',
                    title: 'V',
                    textColor: '#ffffff', // KLEUR van de tekst "verlofdag"
                      extendedProps: { isVacation: true }
                    };
                  });
                  success(events);
                } catch (err) { failure(err); }
              }
            ]
          });

          cal.render();
        });
    </script>



}


<div class="row">
    <div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
        <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
            <div class="row align-items-center">
                <div class="col-sm-auto">
                    <h1 class="fw-bold mb-0">Verlofdagen</h1>
                    <h5 class="mb-4 mt-0">Selecteer hier de algemene verlofdagen voor de bouw</h5>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
<section class="card card-modern card-modern-alt-padding">
    <div class="card-body bg-light">
            <div id="vacationcalendar"></div>
            @Html.AntiForgeryToken() <!-- voor AJAX posts -->
    </div>
</section>
</div>

