@model CPMCore.Models.Klanten.ClientFormViewModel

@{
    var isReadOnly = ViewBag.ReadOnly as bool? ?? false;
    ViewData["Title"] = Model.Title;
}

@section PageStyle
{
    <link rel="stylesheet" href="~/lib/select2/css/select2.css" />
    <link rel="stylesheet" href="~/lib/select2-bootstrap-theme/select2-bootstrap.min.css" />
}

@await Html.PartialAsync("_ClientForm", Model)

@section PageScripts
{
    @await Html.PartialAsync("_ClientFormScripts", Model)
}