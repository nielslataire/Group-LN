@model BOCore.ClientContactBO
@using HtmlHelpers.BeginCollectionItemCore

<div class="contactRow">
    @using (Html.BeginCollectionItem("Client.Contacts")){
        <section class="card mb-4">
            <div class="card-body border p-4">
                <div class="d-flex justify-content-between align-items-start mb-1">
                    <div class=" fs-6">Contactinformatie</div>
                    <a href="" data-toggle="tooltip" data-placement="top" title="" data-original-title="Contact verwijderen" class="deleteContact"><i class="bx bx-trash fs-5"></i></a>
                </div>
                <div class="form-group">
                    <div class="row align-items-center pb-3">
                        <div class="col-lg-4 col-xl-4">
                            @Html.HiddenFor(m => m.Id)
                            @Html.HiddenFor(m => m.IsCoOwner)
                            @Html.DropDownListFor(m => m.Salutation, Html.GetEnumSelectList(Model.Salutation.GetType()), new { @class = "form-control form-control-modern", id = "lstSalutation", })
                        </div>
                        <div class="col-lg-4 col-xl-4">
                            @Html.TextBoxFor(m => m.Name, new { placeholder = "Naam", @class = "form-control form-control-modern", id = "txtName" })
                        </div>
                        <div class="col-lg-4 col-xl-4">
                            @Html.TextBoxFor(m => m.Firstname, new { placeholder = "Voornaam", @class = "form-control form-control-modern", id = "txtForeName" })
                        </div>
                    </div>
                    <div class="row align-items-center">
                        <div class="col-lg-4 col-xl-4">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bx bx-at"></i>
                                </span>
                                @Html.TextBoxFor(m => m.Email, new { placeholder = "Email", @class = "form-control form-control-modern", id = "txtName", Type = "email" })
                            </div>
                        </div>
                        <div class="col-lg-4 col-xl-4">
                            @Html.TextBoxFor(m => m.Phone, new
                                {
                                    placeholder = "Telefoon",
                                    @class = "form-control form-control-modern phone-input",
                                    type = "tel"
                                })
                        </div>
                        <div class="col-lg-4 col-xl-4">
                            @Html.TextBoxFor(m => m.Cellphone, new
                                {
                                    placeholder = "GSM",
                                    @class = "form-control form-control-modern cellphone-input",
                                    type = "tel"
                                })
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
    }
</div>

