@model CPMCore.Models.Klanten.ClientFormViewModel
@{
    var isReadOnly = ViewBag.ReadOnly as bool? ?? false;
    var formRouteValues = Model.Id.HasValue ? new { id = Model.Id } : null;
}

<div class="row">
    <div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
        <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
            <div class="row align-items-center">
                <div class="col-sm-auto d-flex align-items-center">
                    <a href="@Url.Action("Index", "Klanten")" class="text-decoration-none text-reset d-flex align-items-center">
                        <i class="bx bx-chevron-left fs-1"></i>
                    </a>
                </div>
                <div class="col-sm-auto">
                    <h1 class="fw-bold mb-0">@Model.Title</h1>
                    <h5 class="mb-4 mt-0">@Model.Subtitle</h5>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!isReadOnly)
{
    using (Html.BeginForm(Model.Id.HasValue ? "Edit" : "Create", "Klanten", formRouteValues, FormMethod.Post, antiforgery: null, htmlAttributes: new { @class = "ecommerce-form action-buttons-fixed", id = "client-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(m => m.Id)

        <partial name="_ClientFormFields" model="Model" />
    }
}
else
{
    <partial name="_ClientFormFields" model="Model" />
}