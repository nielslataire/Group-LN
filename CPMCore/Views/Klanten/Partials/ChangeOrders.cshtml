@using System.Text.Json
@using System.Text.Encodings.Web
@using BOCore
@model CPMCore.Models.Projecten.DetailChangeOrderModel



@{
    // JSON-serializer voor de per-CO detailsblokken
    var jsonOpts = new JsonSerializerOptions
            {
                Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
                WriteIndented = false
            };
}

@section PageStyle {
	<link rel="stylesheet" href="~/lib/magnific-popup/magnific-popup.css" />
	<link rel="stylesheet" href="~/lib/datatables/media/css/dataTables.bootstrap5.css" />
	<link rel="stylesheet" href="~/css/klanten-custom.css" />
}

@Html.HiddenFor(m => m.ProjectId, new {id = "txtProjectId"})
<div class="card card-modern">
    <div class="card-body">
        <div class="input-group">
            <span class="input-group-text">
                <i class="bx bx-search"></i>
            </span>
            <input type="text" class="form-control me-2" name="search-term" id="search-term" placeholder="Zoeken ...">
            <button type="button" class="btn btn-default btn-md me-2" id="btnToggleFilters" title="Filters">
                <i class="bx bx-filter"></i>
            </button>
            <div id="colvis-container"></div>
        </div>
        <div class="row g-2 mt-3 d-none" id="changeorderFilters">
            <div class="col-12 col-md-3">
                <label class="form-label mb-1" for="client-filter">Klantnaam</label>
                <select id="client-filter" class="form-control form-control-modern">
                    <option value="">Alle klanten</option>
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label mb-1" for="status-filter">Status</label>
                <select id="status-filter" class="form-control form-control-modern">
                    <option value="">Alle statussen</option>
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label mb-1" for="contract-filter">Leveranciers</label>
                <select id="contract-filter" class="form-control form-control-modern">
                    <option value="">Alle leveranciers</option>
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label mb-1" for="invoiceable-filter">Te factureren door</label>
                <select id="invoiceable-filter" class="form-control form-control-modern">
                    <option value="">Alles</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="card card-modern">
	<div class="card-body">
		<div class="datatables-header-footer-wrapper mt-2">
			<div class="datatable-header">
				
			</div>

            <table class="table table-ecommerce-simple table-striped mb-0 gl-table-min-550"
                   id="datatable-clients-list"
                   data-toggle="table" data-show-columns="true" data-toolbar="#toolbar" data-toolbar-align="right">

                <thead>
                    <tr>
                        <th class="noVis gl-details-control"></th> @* Toggler-kolom *@
                        <th data-sortable="true">Datum</th>
                        <th class="hidden-xs" data-visible="false" data-sortable="true">Datum verzonden</th>
                        <th class="hidden-xs" data-visible="false" data-sortable="true">Vervaldatum</th>
                        <th class="hidden-xs" data-visible="false" data-sortable="true">Datum akkoord</th>
                        <th data-sortable="true">Klantnaam</th>
                        <th data-sortable="true">Units</th>
                        <th data-sortable="true">Leverancier</th>
                        <th data-sortable="true">Omschrijving</th>
                        <th data-sortable="true">Bedrag excl. btw</th>
                        <th data-sortable="true" data-align="center">Factuur door bouwheer</th>
                        <th data-sortable="true" data-align="center">Gefactureerd</th>
                        <th data-sortable="true">Openstaand bedrag</th>
                        <th data-sortable="true">Status</th>
                        <th class="hidden-xs noVis" data-sortable="false">Acties</th>
                    </tr>
                </thead>

                <tbody>
            @foreach (var item in Model.CO)
            {
                var today = DateOnly.FromDateTime(DateTime.Today);

                bool hasAgreement = item.DateAgreement is not null;
                bool hasExpiration = item.ExpirationDate != default(DateOnly);
                bool sent = item.DateSendToClient is not null;
                        var detailLines = item.Details ?? new List<ChangeOrderDetailBO>();
                        var invoicableDetails = detailLines.Where(d => d.Invoicable != false).ToList();
                        var openAmount = invoicableDetails
                        .Where(d => d.Invoiced != true)
                        .Sum(d => d.Totaal);
                        var hasInvoicableDetails = invoicableDetails.Count > 0;
                        var allInvoiced = hasInvoicableDetails && invoicableDetails.All(d => d.Invoiced == true);
                        var anyInvoiced = invoicableDetails.Any(d => d.Invoiced == true);
                        var invoicedLabel = allInvoiced
                        ? "Ja"
                        : anyInvoiced
                        ? "Gedeeltelijk"
                        : "Nee";


                bool expired = item.ExpirationDate is DateOnly exp
                && exp < today
                && item.DateAgreement is null;

                string iconClass, title;
                if (hasAgreement) { iconClass = "bx bxs-circle text-success"; title = "Akkoord"; }
                else if (expired) { iconClass = "bx bxs-circle text-danger"; title = "Vervallen, geen akkoord"; }
                else if (sent) { iconClass = "bx bxs-circle text-warning"; title = "Verzonden, geen akkoord"; }
                else { iconClass = "bx bxs-circle text-muted"; title = "Open, nog niet vervallen"; }

                        <tr data-co-id="@item.Id" aria-expanded="false">
                            <td class="details-control text-center" role="button" aria-label="Toon details" tabindex="0">
                                <i class="bx bx-chevron-right"></i>
                            </td>
                            <td>@item.ChangeOrderDate</td>
                            <td class="hidden-xs">@Html.DisplayFor(m => item.DateSendToClient)</td>
                            <td class="hidden-xs">@Html.DisplayFor(m => item.ExpirationDate)</td>
                            <td class="hidden-xs">@Html.DisplayFor(m => item.DateAgreement)</td>
                            <td>@Html.DisplayFor(m => item.ClientName)</td>
                            <td>@(Model.ClientUnits.TryGetValue(item.ClientAccountID, out var units) ? units : string.Empty)</td>
                            <td>@Html.DisplayFor(m => item.ContractCompanyName)</td>
                            <td>@Html.DisplayFor(m => item.Description)</td>
                            <td>@item.Totaal.ToString("C")</td>
                            <td class="text-center">@((item.Invoiceable ? "Bouwheer" : "Aannemer"))</td>
                            <td class="text-center">@invoicedLabel</td>
                            <td>@openAmount.ToString("C")</td>
                            <td><i class="@iconClass" title="@title" aria-label="@title"></i> <span class="status-text">@title</span></td>
                            <td>
                                <a data-toggle="tooltip" data-placement="top" title="Afdrukken"
                                   class="js-print-changeorder"
                                   href="@Url.Action("ChangeOrderPDF", "Projecten", new { changeorderid = item.Id })">
                                    <i class="fa fa-print"></i>
                                </a>
                                <a data-toggle="tooltip" data-placement="top" title="Bewerken"
                                   href="@Url.Action("EditChangeOrder", "Projecten", new { projectid = Model.ProjectId, clientid = item.ClientAccountID, coid = item.Id })">
                                    <i class="fa fa-edit"></i>
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a href="#modaldeletechangeorder" data-toggle="tooltip" data-placement="top" title="Verwijderen"
                                       class="deleteChangeOrder" data-id="@item.Id"><i class="fa fa-trash"></i></a>
                                }
                            </td>
                        </tr>

            }
                </tbody>
            </table>
            <!-- JSON store buiten de DataTable (heel belangrijk) -->
            <div id="co-json-store" class="d-none">
            @foreach (var item in Model.CO)
            {
                    <script type="application/json" id="co-details-@item.Id">
                    @Html.Raw(JsonSerializer.Serialize(item.Details, jsonOpts))
                    </script>
            }
		</div>
	</div>

</div>
          
