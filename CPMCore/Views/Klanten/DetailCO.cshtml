@using CPMCore.Controllers
@using BOCore
@inject IConfiguration Configuration
@model CPMCore.Models.Projecten.DetailChangeOrderModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
	ViewData["Title"] = Model.ProjectName;
}
@* @{
	ViewBag.Breadcrumbs = new List<Breadcrumb>()
	{
		new Breadcrumb("Home", nameof(HomeController.Index), "Home", true),
		new Breadcrumb("Projecten", nameof(ProjectenController.Index), "Projecten", true),
		new Breadcrumb(Model.ProjectName, nameof(ProjectenController.Detail) + "?projectid=" + Model.ProjectId, "Projecten", true),
		new Breadcrumb("Klanten", nameof(ProjectenController.DetailClients), "Projecten", false)
	};
} *@
@{
	String urlTotal = "";
}
@section PageStyle
{
    <link rel="stylesheet" href="~/lib/magnific-popup/magnific-popup.css" />
    <link rel="stylesheet" href="~/lib/datatables/media/css/dataTables.bootstrap5.css" />
    <link href="https://cdn.datatables.net/v/bs5/jszip-3.10.1/dt-2.2.2/b-3.2.2/b-colvis-3.2.2/b-html5-3.2.2/b-print-3.2.2/datatables.min.css" rel="stylesheet" integrity="sha384-W8PzvGseaJlM52wTjdPHNrEA9WHp36V+XpQyv1gCKz+1sbFfDo5MlMDT7awB3rAs" crossorigin="anonymous">
    <style>
        div.dt-buttons .btn.buttons-colvis::after {
            font-family: "Font Awesome 6 Free";
            content: "\f078"; /* Unicode voor fa-chevron-down */
            font-weight: 900; /* Voor solid stijl */
            font-size: 0.85rem;
            vertical-align: middle;
            border: none;
            margin-left: 0.5rem;
            transition: transform 0.2s ease;
        }

        div.dt-buttons .dropdown.show .btn.buttons-colvis::after {
            transform: rotate(180deg);
        }
          td.details-control {
            cursor: pointer;
            width: 36px;
            text-align: center;
          }
          td.details-control i.bx {
            line-height: 1;
            transition: transform .15s ease;
            font-size: 1.1rem; /* optioneel */
          }

    </style>
}
<section class="content-with-menu">
    <div class="content-with-menu-container">
        @await Html.PartialAsync("DetailMenu", Model.ProjectId)
        <div class="inner-body">
            @Html.HiddenFor(m => m.ClientAccountId)
            <div class="row">
                <div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
                    <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
                        <div class="row align-items-center g-2">
                            <div class="col-sm-auto d-flex align-items-center">
                                <a href="@(TempData.Peek("Referrer") ?? Url.Action("Detail", "Klanten", new { clientid = Model.ClientAccountId, projectid = Model.ProjectId }))"
                                   class="text-decoration-none text-reset d-flex align-items-center">
                                    <i class="bx bx-chevron-left fs-1"></i>
                                </a>
                            </div>
                            <div class="col-sm-auto">
                                <h1 class="font-weight-bold mb-0 mt-0">Wijzigingsopdrachten</h1>
                                <h5 class="mb-4 mt-0">Beheer de wijzigingsopdrachten van de klant @Model.ClientName</h5>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-auto px-0">
                        <button type="button" class="btn btn-primary btn-md px-3 me-1" id="btnExportExcel">
                            <i class="fas fa-file-excel"></i>
                        </button>
                        <button type="button" class="btn btn-primary btn-md px-3 me-1" id="btnExportPdf">
                            <i class="fas fa-file-pdf"></i>
                        </button>
                        <a href="@Url.Action("AddChangeOrder", "Projecten", new { projectid = Model.ProjectId, clientaccountid = Model.ClientAccountId })"
                           class="btn btn-primary btn-md">+ Wijzigingsopdracht toevoegen</a>
                    </div>
                </div>

                @await Html.PartialAsync("ChangeOrders", Model)
            </div>
        </div>
    </div>
</section>
<div id="modaldeletechangeorder" class="modal-block modal-block-warning mfp-hide">
    <div id="delete-changeorder-container"></div>
</div>
@section PageScripts
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js" integrity="sha384-VFQrHzqBh5qiJIU0uGU5CIW3+OWpdGGJM9LBnGbuIH2mkICcFZ7lPd/AAtI7SNf7" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js" integrity="sha384-/RlQG9uf0M2vcTw3CX7fbqgbj/h8wKxw7C3zu9/GxcBPRKOEcESxaxufwRXqzq6n" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/v/bs5/jszip-3.10.1/dt-2.2.2/b-3.2.2/b-colvis-3.2.2/b-html5-3.2.2/b-print-3.2.2/datatables.min.js" integrity="sha384-GC9Im1BDtt06YOKSzkS553+5q43Nos2JSnLM31TjWFcFbzZrFhAtgCzrHDGM0iDy" crossorigin="anonymous"></script>

    <script>
        // ---------- Helpers ----------
        function escapeHtml(str) {
            return String(str ?? "")
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

        const coDetailMap = new Map();
        (function hydrateCoDetailMap() {
            const container = document.getElementById('co-json-store');
            if (!container) return;
            container.querySelectorAll('script[type="application/json"][id^="co-details-"]').forEach(sc => {
                const coId = sc.id.replace('co-details-', '');
                try {
                    const parsed = JSON.parse(sc.textContent || '[]');
                    coDetailMap.set(coId, Array.isArray(parsed) ? parsed : []);
                } catch {
                    coDetailMap.set(coId, []);
                }
            });
        })();

        function formatCoDetails(details) {
            if (!details || !details.length) {
                return '<div class="p-3 text-muted">Geen detailregels.</div>';
            }
            const rows = details.map(d => `
                <tr>
                    <td>${escapeHtml(d.description ?? d.Description ?? "")}</td>
                    <td class="text-end">${d.MeasurementTypeDisplay ?? d.measurementTypeDisplay ?? ""}</td>
                    <td class="text-end">${d.MeasurementUnitDisplay ?? d.measurementUnitDisplay ?? ""}</td>
                    <td class="text-end">${d.NumberFormatted ?? d.numberFormatted ?? ""}</td>
                    <td class="text-end">${d.PriceFormatted ?? d.priceFormatted ?? ""}</td>
                    <td class="text-end">${d.CommisionFormatted ?? d.commisionFormatted ?? ""}</td>
                    <td class="text-end">${d.TotaalFormatted ?? d.totaalFormatted ?? ""}</td>
                </tr>`).join('');

            return `
                <div class="p-3 bg-light rounded">
                    <div class="fw-bold mb-2">Details</div>
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="table-secondary">
                            <tr>
                                <th style="width:40%">Omschrijving</th>
                                <th class="text-end" style="width:10%">Meetmethode</th>
                                <th class="text-end" style="width:10%">Meeteenheid</th>
                                <th class="text-end" style="width:10%">Aantal</th>
                                <th class="text-end" style="width:10%">Eenheidsprijs</th>
                                <th class="text-end" style="width:10%">Commissie</th>
                                <th class="text-end" style="width:10%">Totaal</th>
                            </tr>
                        </thead>
                        <tbody>${rows}</tbody>
                    </table>
                </div>`;
        }
        // ----------------------------

        // Init DataTables v2
        var table = new DataTable('#datatable-clients-list', {
            layout: {
                topStart: {
                    buttons: [
                        {
                            extend: 'excel',
                            text: '<i class="fa fa-file-excel"></i>',
                            className: 'btn btn-default me-2',
                            titleAttr: 'Exporteer naar excel',
                            attr: { "data-bs-toggle": "tooltip" },
                            exportOptions: { columns: ':visible' }
                        },
                        {
                            extend: 'pdf',
                            text: '<i class="fa fa-file-pdf"></i>',
                            className: 'btn btn-default me-2',
                            titleAttr: 'Exporteer naar pdf',
                            attr: { "data-bs-toggle": "tooltip" },
                            orientation: 'landscape',
                            pageSize: 'A3',
                            exportOptions: { columns: ':visible' }
                        },
                        {
                            extend: 'colvis',
                            text: '<i class="bx bx-filter me-4"></i> <span class="me-3">Alle kolommen</span>',
                            className: '',
                            titleAttr: 'Selecteer kolommen',
                            attr: { "data-bs-toggle": "tooltip" },
                            columns: ':not(.noVis)',
                            init: function (api, node, config) {
                                $(node).removeClass('btn-secondary').addClass('btn btn-default');
                            }
                        }
                    ]
                }
            },
            language: {
                processing: "Bezig met verwerken...",
                search: "Zoeken&nbsp;:",
                lengthMenu: "Afficher _MENU_ &eacute;l&eacute;ments",
                info: "Wijzigingsopdracht _START_ tot _END_ van de _TOTAL_ wijzigingsopdrachten",
                infoEmpty: "Wijzigingsopdracht 0 van 0 tot 0 wijzigingsopdrachten",
                infoFiltered: "(filtr&eacute; de _MAX_ &eacute;l&eacute;ments au total)",
                loadingRecords: "Bezig met laden...",
                zeroRecords: "Geen wijzigingsopdrachten om weer te geven",
                emptyTable: "Er zijn geen wijzigingsopdrachten om weer te geven",
                aria: {
                    sortAscending: ": klikken om aflopend te sorteren",
                    sortDescending: ": klikken om oplopend te sorteren"
                }
            },
            columnDefs: [
                { targets: 0, orderable: false, className: 'details-control', width: 36 }
            ],
            order: [[1, 'asc']] // kolom 0 = toggler; datum staat op 1
        });

        // Buttons container naar custom plek
        table.buttons(0, null).containers().appendTo('#colvis-container');

        // Verberg standaard knoppen & zoek UI (je gebruikt custom knoppen/zoek)
        $(".buttons-excel").hide();
        $(".buttons-pdf").hide();
        $(".dt-search").hide();

        // Custom export triggers
        $("#btnExportExcel").on('click', function () { $(".buttons-excel").trigger("click"); });
        $("#btnExportPdf").on('click', function () { $(".buttons-pdf").trigger("click"); });

        // Custom zoekveld
        $('#search-term').on('keyup change', function () {
            table.search(this.value).draw();
        });

                // Keyboard support (Enter/Space)
        $('#datatable-clients-list tbody').on('keydown', 'td.details-control', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            $(this).click();
          }
        });

        // Subrows togglen + Boxicons wisselen
        $('#datatable-clients-list tbody').on('click', 'td.details-control', function () {
          const tr = $(this).closest('tr');
          const row = table.row(tr);
          const $icon = $(this).find('i.bx');

          if (row.child.isShown()) {
            // SLUITEN
            row.child.hide(); // <- belangrijk: hide i.p.v. show()
            tr.removeClass('shown').attr('aria-expanded', 'false');
            $icon.removeClass('bx-chevron-up').addClass('bx-chevron-right');
            return;
          }

          // OPENEN
          const coId = String(tr.data('co-id'));
          const details = coDetailMap.get(coId) || [];
          row.child(formatCoDetails(details)).show();
          tr.addClass('shown').attr('aria-expanded', 'true');
          $icon.removeClass('bx-chevron-right').addClass('bx-chevron-up');
        });



        // Open modal + laad partial
        $(document).on('click', '.deleteChangeOrder', function (e) {
            e.preventDefault();
            const id = $(this).data('id');

            $.get('/Projecten/ModalDeleteChangeOrder/' + id, function (html) {
                // laad partial in de inner-container
                $('#delete-changeorder-container').html(html);

                // open nu de outer wrapper, niet de inner div
                $.magnificPopup.open({
                    items: { src: '#modaldeletechangeorder' },
                    type: 'inline',
                    closeBtnInside: true,
                    fixedContentPos: true,
                    callbacks: {
                        close: function () {
                            if (window.__coDeleted) {
                                // herlaad volledige pagina
                                location.reload();

                                // of enkel de lijst, als je dat wil:
                                // $('#changeorders-container').load(location.href + ' #changeorders-container>*');
                            }
                        }
                    }
                });
            });
        });

        // Submit delete via AJAX
        window.__coDeleted = false;
        $(document).on('submit', '#frm-delete-co', function (e) {
            e.preventDefault();
            const $form = $(this);

            $.post($form.attr('action'), $form.serialize())
                .done(function (res) {
                    if (res && res.success) {
                        window.__coDeleted = true;
                        $.magnificPopup.close(); // triggert callbacks.close → reload
                    } else {
                        alert(res && res.message ? res.message : 'Verwijderen mislukt.');
                    }
                })
                .fail(function () {
                    alert('Er ging iets mis. Probeer opnieuw.');
                });
        });

        // // Bestaande delete/inline modal logica
        // $('.deleteChangeOrder').on('click', function () {
        //     var url = "/Projecten/ModalDeleteChangeOrder"; // controller
        //     var id = $(this).attr('data-id');
        //     $.get(url + '/' + id, function (data) {
        //         $('#delete-changeorder-container').html(data);
        //     });
        // });

        // $(document).ready(function () {
        //     $('.deleteChangeOrder').magnificPopup({
        //         type: 'inline',
        //         src: 'deleteChangeOrder'
        //     });
        // });
    </script>
}
