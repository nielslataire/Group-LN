@model CPMCore.Models.Klanten.ClientIndexViewModel
@using CPMCore.Helpers
@using BOCore

@section PageStyle
{
    <link rel="stylesheet" href="~/lib/datatables/media/css/dataTables.bootstrap5.css" />
    <link rel="stylesheet" href="~/lib/magnific-popup/magnific-popup.css" />
}

<div class="row justify-content-between align-items-center pt-2 pe-0 mb-2">
    <div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
        <h1 class="font-weight-bold mb-0 mt-0">Klanten</h1>
        <h5 class="mb-4 mt-0">Beheer en doorzoek alle klanten</h5>
    </div>
    <div class="col-sm-auto px-0">
        @if (Model.WritableIssuerCompanyIds.Any())
        {
            <a id="add-client-button" href="@Url.Action("Create", "Klanten", new { issuerCompanyId = Model.SelectedIssuerCompanyId })" class="btn btn-primary btn-md @(Model.CanCreateClient ? string.Empty : "d-none")">+ Klant toevoegen</a>
        }
    </div>
</div>

<div class="card card-modern mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-lg-6">
                <label class="form-label mb-1" for="search-term">Zoek klant</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bx bx-search"></i></span>
                    <input id="search-term" type="text" class="form-control form-control-modern me-2" placeholder="Zoek klant..." />
                </div>
            </div>
            <div class="col-lg-6">
                <label class="form-label mb-1" for="issuer-filter">Filter op facturatiebedrijf</label>
                <div class="input-group input-group-select-append">
                    <span class="input-group-text">
                        <i class="bx bx-filter"></i>
                    </span>
                    <select id="issuer-filter" class="form-control form-control-modern">
                        <option value="">Alle bedrijven</option>

                        @foreach (var issuer in Model.IssuerCompanies)
                        {
                            var selected = issuer.Id == Model.SelectedIssuerCompanyId ? "selected" : null;

                            <option value="@issuer.Id" selected="@selected">
                                @issuer.Name
                            </option>
                        }
                    </select>
                </div>
               


            </div>
        </div>
    </div>
</div>

<div class="card card-modern">
    <div class="card-body">
        <div class="datatables-header-footer-wrapper mt-2">
            <table class="table table-responsive-md table-hover mb-3" id="datatable-clients" style="min-width: 720px;">
                <thead>
                    <tr>
                        <th>Naam</th>
                        <th>Ondernemingsnummer</th>
                        <th>Locatie</th>
                        <th>Contact</th>
                        <th>Facturatiebedrijf</th>
                        <th class="text-end noVis">Acties</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model.Clients)
                    {
                        var issuerIds = string.Join(",", client.IssuerCompanyIds);
                        <tr data-issuer-ids="@issuerIds">
                            <td>
                                <a href="@Url.Action("Details", "Klanten", new { id = client.Id })" class="text-decoration-none text-reset fw-semibold">
                                    @client.DisplayName
                                </a>
                            </td>
                            <td>@(EnterpriseNumberFormatter.Format(client.EnterpriseNumber) ?? "-")</td>
                            <td>@(string.IsNullOrWhiteSpace(client.City) ? "-" : client.City)</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(client.Email))
                                {
                                    <a href="mailto:@client.Email">@client.Email</a>
                                }
                                else if (!string.IsNullOrWhiteSpace(client.Phone))
                                {
                                    @client.Phone
                                }
                                else
                                {
                                    @:-
                                }
                            </td>
                            <td>
                                @(client.IssuerCompanies.Any() ? string.Join(", ", client.IssuerCompanies) : "-")
                            </td>
                            <td class="actions text-end">
                                @if (client.CanEdit)
                                {
                                    <a class="ms-1 me-1" data-placement="top" title="Bewerken" href="@Url.Action("Edit", "Klanten", new { id = client.Id })">
                                        <i class="bx bx-pencil fs-5"></i>
                                        <span class="visually-hidden">Bewerken</span>
                                    </a>
                                }
                                @if (client.CanDelete)
                                {
                                    <a href="#modaldeleteclient" data-toggle="tooltip" data-placement="top" title="Verwijderen" class="deleteClient ms-1 me-1" data-id="@client.Id">
                                        <i class="bx bx-trash fs-5 text-danger"></i>
                                        <span class="visually-hidden">Verwijderen</span>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div id="modaldeleteclient" class="modal-block modal-block-warning mfp-hide">
    <div id="delete-client-container"></div>
</div>
@section PageScripts
{
    <script src="~/lib/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/media/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/lib/magnific-popup/jquery.magnific-popup.js"></script>
    <script>
        (function () {
             const writableIssuerIds = new Set([@string.Join(",", Model.WritableIssuerCompanyIds)]);
            const createBaseUrl = '@Url.Action("Create", "Klanten")';
            const table = $('#datatable-clients').DataTable({
                paging: true,
                ordering: true,
                info: true,
                searching: true,
                lengthChange: false,
                pageLength: 25,
                language: {
                    zeroRecords: 'Geen klanten om weer te geven',
                    emptyTable: 'Er zijn geen klanten om weer te geven',
                    search: 'Zoek:',
                    paginate: {
                        previous: 'Vorige',
                        next: 'Volgende'
                    }
                }
            });
             $('.dataTables_filter, .dt-search').hide();

            const searchTerm = document.getElementById('search-term');
            searchTerm?.addEventListener('input', function () {
                table.search(this.value).draw();
            });
            const issuerFilter = document.getElementById('issuer-filter');
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                if (settings.nTable.id !== 'datatable-clients') {
                    return true;
                }

                const selectedIssuer = issuerFilter?.value;
                if (!selectedIssuer) {
                    return true;
                }

                const rowIssuers = table.row(dataIndex).node().getAttribute('data-issuer-ids') || '';
                return rowIssuers.split(',').filter(Boolean).includes(selectedIssuer);
            });

            issuerFilter?.addEventListener('change', function () {
                table.draw();
            const addButton = document.getElementById('add-client-button');
                if (!addButton) {
                    return;
                }

                const selectedIssuer = this.value;
                const canCreate = !selectedIssuer || writableIssuerIds.has(Number(selectedIssuer));
                addButton.classList.toggle('d-none', !canCreate);
                addButton.href = selectedIssuer ? `${createBaseUrl}?issuerCompanyId=${encodeURIComponent(selectedIssuer)}` : createBaseUrl;
            });
            const deleteModalSelector = '#modaldeleteclient';
            const deleteContainerSelector = '#delete-client-container';
            const deleteUrl = '@Url.Action("PartialDeleteClientModal", "Klanten")';

            $(document).on('click', '.deleteClient', function (e) {
                e.preventDefault();
                const id = $(this).data('id');
                if (!id) {
                    return;
                }

                $.get(`${deleteUrl}/${id}`)
                    .done(function (data) {
                        $(deleteContainerSelector).html(data);

                        $.magnificPopup.open({
                            items: {
                                src: deleteModalSelector
                            },
                            type: 'inline',
                            preloader: false,
                            focus: deleteContainerSelector
                        });
                    })
                    .fail(function (xhr) {
                        if (xhr.status === 403 && xhr.responseJSON?.redirectUrl) {
                            window.location.href = xhr.responseJSON.redirectUrl;
                            return;
                        }

                        alert('Je hebt geen rechten om deze actie uit te voeren.');
                    });
            });
        })();
    </script>
}