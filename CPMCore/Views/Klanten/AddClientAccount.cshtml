@using CPMCore.Controllers
@using BOCore
@inject IConfiguration Configuration
@model CPMCore.Models.Klanten.AddClientAccountModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
	ViewData["Title"] = Model.ProjectName;
}
@{
	ViewBag.Breadcrumbs = new List<Breadcrumb>()
	{
		new Breadcrumb("Home", nameof(HomeController.Index), "Home", true),
		new Breadcrumb("Projecten", nameof(ProjectenController.Index), "Projecten", true),
		new Breadcrumb("Detail", nameof(ProjectenController.Detail), "Projecten", false)
	};
}
@section PageStyle
{
<link rel="stylesheet" href="~/lib/bootstrap-fileupload/bootstrap-fileupload.min.css" />
<link rel="stylesheet" href="~/lib/select2/css/select2.css" />
<link rel="stylesheet" href="~/lib/select2-bootstrap-theme/select2-bootstrap.min.css" />
<link rel="stylesheet" href="~/lib/bootstrap-tagsinput/bootstrap-tagsinput.css" />
<link rel="stylesheet" href="~/lib/dropzone/basic.css" />
<link rel="stylesheet" href="~/lib/dropzone/dropzone.css" />
	<style>
		.deleteContact {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			text-decoration: none;
			color: inherit; /* behoud standaard kleur */
			padding: 0.4rem;
			border-radius: 0.375rem;
			transition: background-color 0.2s ease;
		}

			.deleteContact:hover {
				background-color: #e6f4ea; /* lichtgroene achtergrond */
			}

			.deleteContact i {
				font-size: 1.25rem; /* grootte icoon */
			}
	</style>
}
<div class="row">
	<div class="row justify-content-center justify-content-sm-between pt-2 pe-0">
		<div class="col-sm-auto mb-4 mb-sm-0 mt-2 mt-sm-0">
			<div class="row align-items-center">
				<div class="col-sm-auto d-flex align-items-center">
					<a href="@TempData.Peek("Referrer")" class="text-decoration-none text-reset d-flex align-items-center">
						<i class="bx bx-chevron-left fs-1"></i>
					</a>
				</div>
				<div class="col-sm-auto">
					<h1 class="fw-bold mb-0">Klant toevoegen</h1>
					<h5 class="mb-4 mt-0">Voeg een klant aan het project toe</h5>
				</div>
			</div>
		</div>
	</div>
</div>
@using (Html.BeginForm("AddClientAccount", "Klanten", FormMethod.Post, new { @class = "ecommerce-form action-buttons-fixed", @id = "myForm", @action = "#" }))
{
	<div class="row mt-2">
		<div class="col">
			<section class="card card-modern card-big-info">
				<div class="card-body">
					<div class="row">
						<div class="col-lg-2-5 col-xl-1-5">
							<i class="card-big-info-icon bx bx-box"></i>
							<h2 class="card-big-info-title">Algemene info</h2>
							<p class="card-big-info-desc">Voeg hier de algemene info van de klant in.</p>
						</div>
						<div class="col-lg-3-5 col-xl-4-5">
							<div class="form-group">
							<div class="row align-items-center pb-3">
								@Html.HiddenFor(m => m.ProjectId)
								@Html.HiddenFor(m => m.ProjectName)
								<label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">@Html.LabelFor(m => m.ClientAccount.Name)</label>
								<div class="col-lg-2 col-xl-2">
									@Html.DropDownListFor(m => m.ClientAccount.Salutation, Html.GetEnumSelectList(Model.ClientAccount.Salutation.GetType()), new { @class = "form-control", @id = "lstSalutationAccount" })
								</div>
								<div class="col-lg-5 col-xl-6">
									@Html.TextBoxFor(m => m.ClientAccount.Name, new { placeholder = "Naam", @class = "form-control form-control-modern", id = "txtinputname", autocomplete = "name" })
								</div>

							</div>
							<div class="row align-items-center pb-3">
								<label class="col-lg-5 col-xl-3 control-label text-lg-end pt-2 mt-1 mb-0">Type eigenaar</label>
								<div class="col-lg-7 col-xl-8">
									@Html.DropDownListFor(m => m.ClientAccount.OwnerType.Id, new SelectList(Model.OwnerTypes, "ID", "Display", Model.ClientAccount.OwnerType.Id), new { @class = "form-control form-control-modern populate", id = "lstOwnerTypes" })
								</div>
							</div>
								<div class="row align-items-center pb-3">
									<div class="col-lg-5 col-xl-3"></div>
									<div class="col-lg-7 col-xl-6">
										<div class="checkbox-custom checkbox-default">
											<input type="checkbox" value="" id="checkboxCompany">
											<label for="checkboxCompany">Dit is een bedrijf</label>
										</div>
									</div>
								</div>
								<div class="form-group row align-items-center pb-3 bedrijfsgegevens d-none">
									<label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">Bedrijfsgegevens</label>
									<div class="col-lg-4 col-xl-4">
										@Html.TextBoxFor(m => m.ClientAccount.CompanyName, new { placeholder = "Bedrijfsnaam", @class = "form-control form-control-modern", id = "txtCompanyName", disabled = "disabled" })
									</div>
									<div class="col-lg-3 col-xl-4
											">
										@Html.TextBoxFor(m => m.ClientAccount.VATnumber, new { placeholder = "Ondernemingsnummer", @class = "form-control form-control-modern", id = "txtVatNumber", disabled = "disabled" })
									</div>
								</div>
							</div>
							<div class="form-group">
								<div class="row align-items-center pb-3">
									<label class="col-lg-5 col-xl-3 control-label text-lg-end mb-0">@Html.LabelFor(m => m.ClientAccount.Street)</label>
									<div class="col-lg-5 col-xl-6">
										@Html.TextBoxFor(m => m.ClientAccount.Street, new { placeholder = "Straat", @class = "form-control form-control-modern" })
									</div>
									<div class="col-lg-1 col-xl-1">
										@Html.TextBoxFor(m => m.ClientAccount.Housenumber, new { placeholder = "Nr", @class = "form-control form-control-modern", autocomplete = "off" })
									</div>
									<div class="col-lg-1 col-xl-1">
										@Html.TextBoxFor(m => m.ClientAccount.Busnumber, new { placeholder = "Bus", @class = "form-control form-control-modern" })
									</div>
								</div>
								<div class="row align-items-center pb-3">
									<label class="col-lg-5 col-xl-3 control-label text-lg-end pt-2 mt-1 mb-0">Land</label>
									<div class="col-lg-3 col-xl-2">
										@Html.DropDownListFor(m => m.SelectedCountry, new SelectList(Model.Countries, "ID", "Display", Model.SelectedCountry), new { @class = "form-control form-control-modern populate", id = "lstCompanyCountries" })
									</div>
									<div class="col-lg-6 col-xl-6">
										<select asp-for="SelectedPostalcode" id="txtPostalcode" class="form-control form-control-modern populate"></select>
									</div>
								</div>
							</div>
							<div class="form-group row align-items-center pb-3">
								<label class="col-lg-5 col-xl-3 control-label text-lg-end pt-2 mt-1 mb-0">@Html.LabelFor(m => m.ClientAccount.DateSalesAgreement)</label>
								<div class="col-lg-7 col-xl-8">
									@Html.EditorFor(m => m.ClientAccount.DateSalesAgreement)
								</div>
							</div>
							<div class="form-group">
								<div class="row align-items-center pb-3">
									<div class="col-lg-5 col-xl-3"></div>
									<div class="col-lg-7 col-xl-6">
										<div class="checkbox-custom checkbox-default">
											<i class="bx bx-location-plus"></i> @Html.CheckBoxFor(m => m.ClientAccount.InvoiceAddress, new { id = "checkboxInvoiceAddress" })
											<label for="checkboxInvoiceAddress">Afwijkend facturatieadres</label>
										</div>
									</div>
								</div>
								<div class="InvoiceAddress form-group" hidden="hidden">
									<div class=" row align-items-center pb-3">
										<label class="col-lg-5 col-xl-3 control-label text-lg-end pt-2 mt-1 mb-0">Facturatiegegevens</label>
										<div class="col-lg-5 col-xl-6">
											@Html.TextBoxFor(m => m.ClientAccount.InvoiceStreet, new { placeholder = "Straat", @class = "form-control form-control-modern" })
										</div>
										<div class="col-lg-1 col-xl-1">
											@Html.TextBoxFor(m => m.ClientAccount.InvoiceHousenumber, new { placeholder = "Nr", @class = "form-control form-control-modern" })
										</div>
										<div class="col-lg-1 col-xl-1">
											@Html.TextBoxFor(m => m.ClientAccount.InvoiceBusnumber, new { placeholder = "Bus", @class = "form-control form-control-modern" })
										</div>
									</div>
									<div class=" row align-items-center pb-3">
										<label class="col-lg-5 col-xl-3 control-label text-lg-end pt-2 mt-1 mb-0">Land</label>

										<div class="col-lg-3 col-xl-2">
											@Html.DropDownListFor(m => m.SelectedInvoiceCountry, new SelectList(Model.Countries, "ID", "Display", Model.SelectedInvoiceCountry), new { @class = "form-control form-control-modern populate", id = "lstClientInvoiceCountries" })
										</div>

										<div class="col-lg-6 col-xl-6">
											<select asp-for="SelectedInvoicePostalcode" id="txtInvoicePostalcode" class="form-control form-control-modern populate"></select>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div>
			</section>
		</div>
	</div>

	<div class="row mt-4">
		<div class="col">
			<section class="card card-modern card-big-info">
				<div class="card-body">
					<div class="row">
						<div class="col-lg-2-5 col-xl-1-5">
							<i class="card-big-info-icon bx bxs-contact"></i>
							<h2 class="card-big-info-title">Contactgegevens</h2>
							<p class="card-big-info-desc">Voeg hier extra contactgegevens voor de klant toe</p>
						</div>
						<div class="col-lg-3-5 col-xl-4-5 ">
							<div class="d-flex justify-content-end">
								<a href="@Url.Action("BlankContactRow", "Klanten", new { collectionName = "ClientAccount.Contacts" })" class="btn btn-default btn-md" id="addContact"><i class="fa fa-plus me-3"></i>Contactgegevens Toevoegen</a>
							</div>
							<div class="row mt-4">
								<div class="form-group">
									<div id="editorRows">
										@{
											ViewData["ContactCollectionName"] = "ClientAccount.Contacts";
										}
										@foreach (var item in Model.ClientAccount.Contacts)
										{
											@Html.Partial("_ContactRow", item)
										}
									</div>
								</div>
							</div>
							</div>
					</div>
				</div>
			</section>
		</div>
	</div>
	<div class="row mt-4 CoOwnersCard">
		<div class="col">
			<section class="card card-modern card-big-info">
				<div class="card-body">
					<div class="row">
						<div class="col-lg-2-5 col-xl-1-5">
							<i class="card-big-info-icon bx bxs-user-plus"></i>
							<h2 class="card-big-info-title">Mede-eigenaars</h2>
							<p class="card-big-info-desc">Voeg hier extra eigenaars toe</p>
						</div>
						<div class="col-lg-3-5 col-xl-4-5 ">
							@{
								var coOwnerCountries = Model.Countries.Select(c => new SelectListItem
								{
									Value = c.ID.ToString(),
									Text = c.Display
								}).ToList();
								var coOwnerOwnerTypes = Model.OwnerTypes.Where(o => o.ID != 1).Select(o => new SelectListItem
								{
									Value = o.ID.ToString(),
									Text = o.Display
								}).ToList();
								ViewData["Countries"] = coOwnerCountries;
								ViewData["OwnerTypes"] = coOwnerOwnerTypes;
								ViewData["CoOwnerCollectionName"] = "ClientAccount.CoOwners";
							}
							<div class="d-flex justify-content-end">
								<a href="@Url.Action("BlankCoOwnerRow", "Klanten", new { collectionName = "ClientAccount.CoOwners" })" class="btn btn-default btn-md" id="addCoOwner">
									<i class="fa fa-plus me-3"></i>Mede-eigenaar toevoegen
								</a>
							</div>
							<div class="row mt-4">
								<div class="form-group">
									<div id="coOwnerRows">
										@foreach (var item in Model.ClientAccount.CoOwners)
										{
											@Html.Partial("Partials/_CoOwnerRow", item)
										}
									</div>
								</div>
							</div>
						</div>
					</div>
			</section>
		</div>
	</div>
	<div class="row mt-4">
		<div class="col">
			<section class="card card-modern card-big-info">
				<div class="card-body">
					<div class="row">
						<div class="col-lg-2-5 col-xl-1-5">
							<i class="card-big-info-icon bx bxs-building-house"></i>
							<h2 class="card-big-info-title">Entiteiten</h2>
							<p class="card-big-info-desc">Voeg hier een entiteit aan de klant toe</p>
						</div>
						<div class="col-lg-3-5 col-xl-4-5 ">
							<div class="form-group row align-items-center pb-3">
								<label class="col-lg-4 col-xl-3 control-label text-lg-end mb-0">Eenheid toevoegen</label>
								<div class="col-lg-5 col-xl-6">

									@Html.ListBoxFor(m => m.SelectedUnits, new SelectList(Model.AvailableUnits, "ID", "Display", Model.SelectedUnits, "Group"), new { @class = "form-control populate", data_plugin_selecttwo = "", id = "lstUnits" })

								</div>
								<div class="col-lg-3 col-xl-3">
									<button class="btn btn-default btn-block btn-md" type="button" id="btnAddUnits"><i class="fa fa-plus me-3"></i>Entiteiten Toevoegen</button>
@* 									<a href="@Url.Action("BlankContactRow", "Klanten", null)" class="btn btn-default btn-md" id="btnAddUnits"><i class="fa fa-plus me-3"></i>Entiteiten Toevoegen</a> *@
								</div>
							</div>
							<div class="row mt-4">
								<div class="form-group">
									<div id="UnitRows">
										@foreach (var item in Model.AddedUnits)
										{
											@Html.Partial("_UnitRow", item)
										}
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
		</div>
	</div>

	<div class="row action-buttons">
		<div class="col-12 col-md-auto">
			<button type="submit" class="submit-button btn btn-primary btn-px-4 py-3 d-flex align-items-center font-weight-semibold line-height-1" data-loading-text="Laden...">
				<i class="bx bx-save text-4 me-2"></i> Klant opslaan
			</button>
		</div>
		<div class="col-12 col-md-auto px-md-0 mt-3 mt-md-0">
			<a href="@TempData.Peek("Referrer")" class="cancel-button btn btn-light btn-px-4 py-3 border font-weight-semibold text-color-dark text-3">Annuleren</a>
		</div>
		@if( Model.ClientAccount.Id!=0){
		<div class="col-12 col-md-auto ms-md-auto mt-3 mt-md-0 ms-auto">
			<a href="#" class="delete-button btn btn-danger btn-px-4 py-3 d-flex align-items-center font-weight-semibold line-height-1">
				<i class="bx bx-trash text-4 me-2"></i> Klant verwijderen
			</a>
		</div>
		}
	</div>
}


@section PageScripts
{
	<script src="~/lib/select2/js/select2.js"></script>
	<script src="~/lib/jquery-validation/jquery.validate.js"></script>
	<script src="~/lib/bootstrap-wizard/jquery.bootstrap.wizard.js"></script>
	<script src="~/lib/dropzone/dropzone.js"></script>
	<script src="~/lib/jquery-mask/jquery.mask.js"></script>

	<script>
		$(document).ready(function () {

			// --- Helper functies ---

			// Toggle bedrijfsgegevens afhankelijk van checkbox
			function toggleCompanyFields(checkboxId, salutationId, nameId, vatId, companyNameId, bedrijfsClass) {
				if ($(checkboxId).is(":checked")) {
					$(salutationId).attr("disabled", "disabled");
					$(nameId).attr("disabled", "disabled");
					$(vatId).removeAttr("disabled");
					$(companyNameId).removeAttr("disabled");
					$(bedrijfsClass).removeClass('d-none');
				} else {
					$(salutationId).removeAttr("disabled");
					$(nameId).removeAttr("disabled");
					$(vatId).attr("disabled", "disabled");
					$(companyNameId).attr("disabled", "disabled");
					$(bedrijfsClass).addClass('d-none');
				}
			}

			// Toggle facturatieadres zichtbaar
			function toggleInvoiceAddress(checkboxId, containerClass) {
				if ($(checkboxId).is(":checked")) {
					$(containerClass).removeAttr("hidden");
				} else {
					$(containerClass).attr("hidden", "hidden");
				}
			}

			// Select2 init functie met focus open dropdown en ajax
			function initSelect2(id, countryId, placeholder) {
				$(id).select2({
					minimumInputLength: 3,
					theme: 'bootstrap',
					dropdownAutoWidth: true,
					placeholder: placeholder,
					ajax: {
						url: '@Url.Action("GetPostcodesByCountry", "Shared")',
						cache: false,
						traditional: true,
						type: 'POST',
						data: function (params) {
							return {
								term: params.term,
								CountryId: countryId
							};
						},
						processResults: function (data) {
							return {
								results: $.map(data, function (item) {
									return { id: item.id, text: item.text };
								})
							};
						}
					}
				});

				// Open dropdown automatisch bij keyboard focus (tab)
				$('#select2-' + id.replace('#','') + '-container').parent().on('focus', function () {
					$(id).select2('open');
				});

				// Zorg dat dropdown sluit als je weg tabt
				$(id).on('select2:closing', function (e) {
					if ($(this).data('skipClose')) {
						e.preventDefault();
						$(this).data('skipClose', false);
					}
				});
			}


			// --- Event handlers ---

			// Checkbox bedrijfsgegevens klant
						$('#checkboxCompany').change(function () {
				toggleCompanyFields(
					'#checkboxCompany',
					'#lstSalutationAccount',
					'#txtinputname',
					'#txtVatNumber',
					'#txtCompanyName',
									'.bedrijfsgegevens'
								);
						});

						// Checkbox facturatieadres klant
						$('#checkboxInvoiceAddress').change(function () {
								toggleInvoiceAddress('#checkboxInvoiceAddress', '.InvoiceAddress');
						});

						// Land selecties bijhouden
						var iCountryId = $("#lstCompanyCountries").val();
						var iClientInvoiceCountryId = $("#lstClientInvoiceCountries").val();

						$("#lstCompanyCountries").change(function () { iCountryId = this.value; });
						$("#lstClientInvoiceCountries").change(function () { iClientInvoiceCountryId = this.value; });

			// Contacten toevoegen
			$("#addContact").click(function () {
				$.ajax({
					url: this.href,
					cache: false,
					success: function (html) { $("#editorRows").append(html); }
				});
				return false;
			});

			// Contact verwijderen
			$(document).on('click', 'a.deleteContact', function () {
				$(this).closest('.contactRow').remove();
				return false;
			});

			// Eenheden toevoegen
			$('#btnAddUnits').click(function () {
				var el = document.getElementById('lstUnits');
				var options = el && el.options;
				for (var i = 0; i < options.length; i++) {
					var opt = options[i];
					if (opt.selected) {
						$.ajax({
							url: '@Url.Action("AddSelectedUnits", "Klanten")',
							data: { UnitId: opt.value, UnitName: opt.text, UnitGroup: $(opt).parent().attr("label") },
							cache: false,
							traditional: true,
							type: 'POST',
							success: function (result) {
								$('#UnitRows').append(result);
								applyCurrencyMasks(); // opnieuw toepassen op nieuwe velden
							},
						});
					}
				}
				$("#lstUnits option:selected").attr('disabled', 'disabled');
				$("#lstUnits").val(null).trigger("change");
			});

			// Eenheid verwijderen
			$(document).on('click', 'a.deleterow', function () {
				var $row = $(this).closest('tr');
				var $id = $row.find('td').eq(0).text();
				$("#lstUnits option[value=" + $id + "]").removeAttr('disabled').change();
				$row.remove();
				return false;
			});


		// Mede-eigenaar toevoegen
		$("#addCoOwner").click(function () {
						$.ajax({
							url: this.href,
							cache: false,
							success: function (html) {
								var $row = $(html);
								$("#coOwnerRows").append($row);
								initCoOwnerRow($row);
							}
						});
						return false;
					});

		// Mede-eigenaar verwijderen
						$(document).on('click', 'a.deleteCoOwnerRow', function () {
								$(this).closest('.coOwnerRow').remove();
								return false;
						});

						function initCoOwnerRow($row) {
								toggleCoOwnerCompany($row.find('.toggle-CoOwnerCompany'));
								toggleCoOwnerInvoice($row.find('.toggle-CoOwnerInvoice'));

								$row.find('.toggle-CoOwnerCompany').on('change', function () {
										toggleCoOwnerCompany($(this));
								});

								$row.find('.toggle-CoOwnerInvoice').on('change', function () {
										toggleCoOwnerInvoice($(this));
								});
						}

						function toggleCoOwnerCompany($checkbox) {
								var $row = $checkbox.closest('.coOwnerRow');
								var isCompany = $checkbox.is(':checked');
								var $companyFields = $row.find('.CoOwnerBedrijfsgegevens');
								var $personFields = $row.find('select[name$="Salutation"], input[name$="Name"], input[name$="Firstname"]');

								if (isCompany) {
										$companyFields.removeClass('d-none');
										$personFields.attr('disabled', 'disabled');
								} else {
										$companyFields.addClass('d-none');
										$personFields.removeAttr('disabled');
								}
						}

						function toggleCoOwnerInvoice($checkbox) {
								var $row = $checkbox.closest('.coOwnerRow');
								var $invoice = $row.find('.CoOwnerInvoiceAddress');
								if ($checkbox.is(':checked')) {
										$invoice.removeClass('d-none');
								} else {
										$invoice.addClass('d-none');
								}
						}

						$('#coOwnerRows .coOwnerRow').each(function () {
								initCoOwnerRow($(this));
						});

						// Toggle mede-eigenaren kaart bij start
						function toggleCoOwnersCard() {
								if ($('#lstOwnerTypes').val() === "1") {
					$('.CoOwnersCard').hide();
				} else {
					$('.CoOwnersCard').show();
				}
						}
						toggleCoOwnersCard();

						// Bij wijziging eigenaar type
						$('#lstOwnerTypes').on('change', toggleCoOwnersCard);

						// --- Select2 initialisaties ---

						initSelect2("#txtPostalcode", iCountryId, "Selecteer uw gemeente");
						initSelect2("#txtInvoicePostalcode", iClientInvoiceCountryId, "Selecteer uw gemeente");

			// --- Masked input ---

			$('.Currencymask').mask("#.##0,00", { reverse: true });
			$('.Surfacemask').mask("#.##0,00", { reverse: true });

			// --- Form submission: currency clean up ---
			$('#myForm').on('submit', function (e) {
				$('.Currencymask').each(function () {
					var val = $(this).val();
					// Verwijder alle punten (duizendtallen), laat komma staan
					var cleanVal = val.replace(/\./g, '');
					$(this).val(cleanVal);
				});
			});

		});
	</script>
}
