@model CPMCore.Models.ContractorInvite.ContractorInviteVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-7">

        <div class="d-flex align-items-center mb-4 gap-3">
            <a href="@Url.Action("Overzicht", new { companyId = Model.CompanyId })"
               class="btn btn-outline-secondary btn-sm">
                <i class="bx bx-chevron-left"></i> Terug
            </a>
            <div>
                <h1 class="font-weight-bold mb-0">Verantwoordelijke uitnodigen</h1>
                <p class="text-muted mb-0">@Model.CompanyName</p>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <section class="card card-modern">
            <header class="card-header">
                <h2 class="card-title mb-0">
                    <i class="bx bx-user-plus me-2"></i>Nieuwe verantwoordelijke
                </h2>
            </header>
            <div class="card-body">
                <form method="post" asp-action="Aanmaken">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CompanyId" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label font-weight-bold"></label>
                            <input asp-for="FirstName" class="form-control" placeholder="Voornaam" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label font-weight-bold"></label>
                            <input asp-for="LastName" class="form-control" placeholder="Naam" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label font-weight-bold"></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="naam@bedrijf.be" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="JobFunction" class="form-label"></label>
                            <input asp-for="JobFunction" class="form-control" placeholder="bv. Werfleider" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" placeholder="bv. +32 ..." />
                        </div>

                        <div class="col-12">
                            <div class="border rounded p-3 bg-light-subtle">
                                <div class="switch switch-sm switch-primary d-flex align-items-center gap-3">
                                    <input type="checkbox" data-plugin-ios-switch asp-for="IsFullCompanyAdmin" id="chkFullAdmin" />
                                    <label for="chkFullAdmin" class="mb-0 font-weight-bold">
                                        @Html.DisplayNameFor(m => m.IsFullCompanyAdmin)
                                    </label>
                                </div>
                                <p class="text-muted small mb-0 mt-1">
                                    Aangevinkt: de gebruiker ziet alle puntmeldingen voor <strong>@Model.CompanyName</strong>
                                    in het aannemersportaal.<br />
                                    Uitgevinkt: enkel de punten van projecten waarvoor een contract loopt.
                                </p>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-send me-1"></i>Uitnodiging versturen
                        </button>
                        <a href="@Url.Action("Overzicht", new { companyId = Model.CompanyId })"
                           class="btn btn-outline-secondary">Annuleren</a>
                    </div>
                </form>
            </div>
        </section>

    </div>
</div>

@section PageScripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
