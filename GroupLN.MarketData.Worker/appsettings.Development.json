{
  "ConnectionStrings": {
    "MarketData": "Server=.;Database=CPM_MarketData_Dev;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "CrawlerSettings": {
    "EnableCrawler": false,
    "DryRun": true,
    "ApplyMigrationsOnStartup": true,
    "MaxListingsPerRun": 5,
    "MinListingsBeforeMarkInactive": 20,
    "AllowedPostalCodes": [ "8730", "8000", "8020", "8310" ],
    "AllowedCities": [ "Beernem", "Brugge", "Oostkamp", "Knokke-Heist" ],
    "MaxRequestsPerMinute": 5,
    "DelayBetweenRequestsSeconds": 6,
    "MarkInactiveAfterDays": 7,
    "HttpTimeoutSeconds": 45,
    "PlaywrightTimeoutMs": 45000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "GroupLN.MarketData": "Debug"
    }
  }
}
